{
	"name": "astra-language-tools",
	"displayName": "Astra Language Tools",
	"version": "0.1.0",
	"publisher": "astra-lang",
	"license": "Apache-2.0 WITH LLVM-exception",
	"engines": {"vscode": "^1.90.0"},
	"main": "./extension.js",
	"activationEvents": ["onLanguage:astra"],
	"contributes": {
		"languages": [{"id": "astra", "extensions": [".astra"], "aliases": ["Astra"]}],
		"configuration": {
			"title": "Astra",
			"properties": {
				"astra.compilerPath": {"type": "string", "default": "astrac", "scope": "machine", "description": "Installed Astra compiler executable."},
				"astra.serverPath": {"type": "string", "default": "astra-lsp", "scope": "machine", "description": "Installed Astra language server executable or Python source."},
				"astra.pythonPath": {"type": "string", "default": "python3", "scope": "machine", "description": "Python interpreter when serverPath is a .py file."},
				"astra.scratchDirectory": {"type": "string", "default": "", "scope": "machine", "description": "Optional existing directory for temporary compiler inputs."}
			}
		}
	}
}
