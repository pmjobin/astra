// Reconstruct each active variant's reverse field retirement from its source.
// Module-local helper handles are candidates, not proof of their bodies.
bool recover_enum_drop_call_verified(CheckedIndex checked, TypeId type, void* block, void* operation, void* address) throws Error {
	if (!enum_storage_owned(checked, type, 0) || operation == null || LLVMIsAInstruction(operation) == null || LLVMGetInstructionOpcode(operation) != 45 || LLVMGetInstructionParent(operation) != block) return false;
	var function = LLVMGetCalledValue(operation);
	var name = llvm_name("astra.enum.drop.", type.index);
	if (!recover_llvm_helper_signature(function, 1) || llvm13_named(function, name.text) != 1 || LLVMGetGlobalParent(function) != LLVMGetGlobalParent(LLVMGetBasicBlockParent(block)) || LLVMGetTypeKind(LLVMGetReturnType(LLVMGlobalGetValueType(function))) != 0 || LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, 0))) != 12) return false;
	return recover_llvm_call(operation, function, 1, 8) && LLVMGetArgOperand(operation, 0) == address;
}

bool recover_enum_slot_drop_verified(CheckedIndex checked, RecoverSlot slot, void* block, void* address, void* armed, void* operation) throws Error {
	var body = recover_llvm_body(block, 5);
	if (len(body) != 5 || LLVMGetInstructionOpcode(body[0]) != 27 || LLVMGetOperand(body[0], 0) != armed || LLVMGetTypeKind(LLVMTypeOf(body[0])) != 8 || LLVMGetIntTypeWidth(LLVMTypeOf(body[0])) != 1 || LLVMGetAlignment(body[0]) != 1 || LLVMGetVolatile(body[0]) != 0 || LLVMGetOrdering(body[0]) != 0 || LLVMHasMetadata(body[0]) != 0) return false;
	if (LLVMGetInstructionOpcode(body[1]) != 46 || LLVMGetOperand(body[1], 0) != body[0] || LLVMGetOperand(body[1], 1) != address || LLVMIsNull(LLVMGetOperand(body[1], 2)) == 0 || LLVMHasMetadata(body[1]) != 0 || LLVMGetInstructionOpcode(body[2]) != 28) return false;
	var zero = LLVMGetOperand(body[2], 0);
	return recover_llvm_bits(zero, 1, 0) && recover_enum_store_verified(body[2], zero, armed, 1) && operation == body[3] && recover_enum_drop_call_verified(checked, slot.type, block, operation, body[1]);
}

int recover_enum_binding_verified(RecoverSsa ssa, RecoverBlock block, void* physical, void* layout, void* operation, void*[] slots, void*[] locals, void*[] addresses, void*[] armed) {
	var row = ssa.cfg.core.nodes[block.origin - 1].value;
	var root = ssa.cfg.core.nodes[row.a - 1].value;
	var arm = ssa.cfg.core.nodes[row.c - 1].value;
	if (row.kind != 86 || !enum_scoped_binding(ssa.cfg.core.flow.checked, row.symbol)) return 0;
	int levels = enum_projection_depth(ssa.cfg.core.flow.checked, arm.source, row.source, 0);
	if (levels < 1 || levels > 32) return 0;
	bool owner = ssa.cfg.core.flow.checked.symbol_flags[row.symbol.index] == 4;
	int count = levels * 2 + 2; if (owner) count = count + 3;
	var body = recover_llvm_body(physical, count);
	if (len(body) != count) return 0;
	var loaded = body[levels * 2];
	var type = ssa.cfg.core.flow.checked.symbol_types[row.symbol.index];
	if (operation != loaded || locals[row.symbol.index] != loaded || LLVMGetInstructionOpcode(loaded) != 27 || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, type, LLVMTypeOf(loaded)) || LLVMGetAlignment(loaded) != LLVMABIAlignmentOfType(layout, LLVMTypeOf(loaded)) || LLVMGetVolatile(loaded) != 0 || LLVMGetOrdering(loaded) != 0 || LLVMHasMetadata(loaded) != 0) return 0;
	var address = LLVMGetOperand(loaded, 0);
	var captured = recover_enum_projection_root(ssa.cfg.core.flow.checked, arm.source, root.type, row.source, address, physical, 0);
	if (captured == null || captured != slots[row.a - 1] || LLVMGetNextInstruction(address) != loaded) return 0;
	void* current = address; void* first = address; int level = 0;
	while (level < levels) {
		first = LLVMGetOperand(current, 0); current = LLVMGetOperand(first, 0); level = level + 1;
	}
	if (current != captured || body[0] != first) return 0;
	if (owner) {
		if (LLVMGetInstructionOpcode(body[levels * 2 + 1]) != 28 || LLVMGetInstructionOpcode(body[levels * 2 + 3]) != 28) return 0;
		var zero = LLVMGetOperand(body[levels * 2 + 1], 0);
		if (LLVMIsNull(zero) == 0 || LLVMTypeOf(zero) != LLVMTypeOf(loaded) || !recover_enum_store_verified(body[levels * 2 + 1], zero, address, LLVMABIAlignmentOfType(layout, LLVMTypeOf(loaded))) || !recover_enum_store_verified(body[levels * 2 + 2], loaded, addresses[row.symbol.index], LLVMABIAlignmentOfType(layout, LLVMTypeOf(loaded)))) return 0;
		var flag = LLVMGetOperand(body[levels * 2 + 3], 0);
		if (!recover_llvm_bits(flag, 1, 1) || !recover_enum_store_verified(body[levels * 2 + 3], flag, armed[row.symbol.index], 1)) return 0;
	}
	return count;
}

bool recover_enum_drop_verified(CheckedIndex checked, TypeId type, void* function, void*[] drops, void* free_function, void* trap_function) throws Error {
	if (!enum_storage_owned(checked, type, 0) || !recover_llvm_helper_signature(function, 1) || LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, 0))) != 12 || LLVMGetTypeKind(LLVMGetReturnType(LLVMGlobalGetValueType(function))) != 0) return false;
	var name = llvm_name("astra.enum.drop.", type.index);
	if (llvm13_named(function, name.text) != 1) return false;
	var declaration = checked.bindings.symbol(checked.types.row(type).nominal);
	var variants = checked.bindings.program.arena.get_list_variants(declaration.node);
	int count = checked.bindings.program.arena.list_count(variants);
	var blocks = recover_llvm_helper_blocks(function, 4 + count * 2);
	if (len(blocks) != 4 + count * 2) return false;
	var entry = recover_llvm_body(blocks[0], 2);
	var tagged = recover_llvm_body(blocks[1], 3);
	var fatal = recover_llvm_body(blocks[2], 2);
	var done = recover_llvm_body(blocks[3], 1);
	if (len(entry) != 2 || len(tagged) != 3 || len(fatal) != 2 || len(done) != 1) return false;
	var address = LLVMGetParam(function, 0);
	if (LLVMGetInstructionOpcode(entry[0]) != 42 || LLVMGetICmpPredicate(entry[0]) != 33 || LLVMGetOperand(entry[0], 0) != address || LLVMIsNull(LLVMGetOperand(entry[0], 1)) == 0 || !recover_llvm_split(entry[1], entry[0], blocks[1], blocks[3])) return false;
	if (LLVMGetInstructionOpcode(tagged[0]) != 29) return false;
	var carrier = LLVMGetGEPSourceElementType(tagged[0]);
	if (!recover_enum_llvm_type(checked, type, carrier) || !recover_llvm_field(tagged[0], carrier, address, 0) || !recover_llvm_load_field(tagged[1], carrier, address, 0) || LLVMGetOperand(tagged[1], 0) != tagged[0] || LLVMGetAlignment(tagged[1]) != 4 || !recover_llvm_scalar_type(checked, type_id(1), LLVMTypeOf(tagged[1])) || !recover_llvm_jump(tagged[2], blocks[4])) return false;
	if (!recover_llvm_call(fatal[0], trap_function, 0, 0) || LLVMGetInstructionOpcode(fatal[1]) != 7 || !recover_llvm_void_return(done[0])) return false;
	int v = 0;
	while (v < count) {
		var test = recover_llvm_body(blocks[4 + v * 2], 2);
		void* next = blocks[2]; if (v + 1 < count) next = blocks[4 + (v + 1) * 2];
		if (len(test) != 2 || LLVMGetInstructionOpcode(test[0]) != 42 || LLVMGetICmpPredicate(test[0]) != 32 || LLVMGetOperand(test[0], 0) != tagged[1] || !recover_llvm_bits(LLVMGetOperand(test[0], 1), 32, v as u64) || !recover_llvm_split(test[1], test[0], blocks[5 + v * 2], next)) return false;
		var variant = checked.bindings.program.arena.node_at(variants, v);
		var fields = checked.bindings.program.arena.get_list_fields(variant);
		int f = 0; int instructions = 1;
		while (f < checked.bindings.program.arena.list_count(fields)) {
			var field = checked.bindings.program.arena.node_at(fields, f);
			var symbol = checked.node_symbols[field.index];
			if (enum_storage_owned(checked, checked.symbol_types[symbol.index], 0)) instructions = instructions + 3;
			else {
				if (checked.symbol_flags[symbol.index] == 4) instructions = instructions + 5;
			}
			f = f + 1;
		}
		var body = recover_llvm_body(blocks[5 + v * 2], instructions);
		if (len(body) != instructions) return false;
		int at = 0; f = checked.bindings.program.arena.list_count(fields) - 1;
		while (f >= 0) {
			var field = checked.bindings.program.arena.node_at(fields, f);
			var symbol = checked.node_symbols[field.index];
			var child = checked.symbol_types[symbol.index];
			bool nested = enum_storage_owned(checked, child, 0);
			if (nested || checked.symbol_flags[symbol.index] == 4) {
				if (!recover_llvm_field(body[at], carrier, address, 1) || LLVMGetInstructionOpcode(body[at + 1]) != 29) return false;
				var physical = LLVMGetGEPSourceElementType(body[at + 1]);
				if (!recover_enum_variant_type(checked, checked.node_symbols[variant.index], physical) || !recover_llvm_field(body[at + 1], physical, body[at], f)) return false;
				if (nested) {
					if (child.index < 1 || child.index >= len(drops) || drops[child.index] == null || !recover_llvm_call(body[at + 2], drops[child.index], 1, 8) || LLVMGetArgOperand(body[at + 2], 0) != body[at + 1]) return false;
					at = at + 3;
				} else {
					if (checked_kind(checked, child) != 22 || LLVMGetInstructionOpcode(body[at + 2]) != 27 || LLVMGetOperand(body[at + 2], 0) != body[at + 1] || LLVMGetAlignment(body[at + 2]) != 8 || !recover_storage_llvm_type(checked, child, LLVMTypeOf(body[at + 2])) || !recover_llvm_extract(body[at + 3], body[at + 2], 0) || !recover_llvm_call(body[at + 4], free_function, 1, 0) || LLVMGetArgOperand(body[at + 4], 0) != body[at + 3]) return false;
					at = at + 5;
				}
			}
			f = f - 1;
		}
		if (at != instructions - 1 || !recover_llvm_jump(body[at], blocks[3])) return false;
		v = v + 1;
	}
	int b = 0;
	while (b < len(blocks)) {
		var instruction = LLVMGetFirstInstruction(blocks[b]);
		while (instruction != null) {
			if (LLVMHasMetadata(instruction) != 0) return false;
			if (LLVMGetInstructionOpcode(instruction) == 27 && (LLVMGetVolatile(instruction) != 0 || LLVMGetOrdering(instruction) != 0)) return false;
			instruction = LLVMGetNextInstruction(instruction);
		}
		b = b + 1;
	}
	return true;
}
