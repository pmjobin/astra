// Range queries use private scalar helpers. Their dynamic parameters prevent
// constant folding from concealing the signedness or inclusive comparison.
bool recover_range_query_helper(void* function, int kind, int action, string name) {
	int count = 3; if (action == 2) count = 4;
	if (!type_integer(kind) || action < 1 || action > 2 || function == null || LLVMIsAFunction(function) == null || !recover_llvm_helper_signature(function, count) || llvm13_named(function, name) != 1) return false;
	var integer = LLVMTypeOf(LLVMGetParam(function, 0)); var boolean = LLVMTypeOf(LLVMGetParam(function, 2));
	if (LLVMGetTypeKind(integer) != 8 || LLVMGetIntTypeWidth(integer) != type_width(kind) || LLVMTypeOf(LLVMGetParam(function, 1)) != integer || LLVMGetTypeKind(boolean) != 8 || LLVMGetIntTypeWidth(boolean) != 1 || LLVMGetReturnType(LLVMGlobalGetValueType(function)) != boolean || action == 2 && LLVMTypeOf(LLVMGetParam(function, 3)) != integer) return false;
	var blocks = recover_llvm_helper_blocks(function, 1); if (len(blocks) != 1) return false;
	int instructions = 4; if (action == 2) instructions = 6;
	var body = recover_llvm_body(blocks[0], instructions); if (len(body) != instructions) return false;
	int at = 0;
	while (at < instructions) {
		if (LLVMHasMetadata(body[at]) != 0) return false;
		if (LLVMGetInstructionOpcode(body[at]) == 42 && (LLVMGetNumOperands(body[at]) != 2 || LLVMGetICmpSameSign(body[at]) != 0)) return false;
		at = at + 1;
	}
	var start = LLVMGetParam(function, 0); var end = LLVMGetParam(function, 1); var inclusive = LLVMGetParam(function, 2);
	int greater = 34; int at_least = 35; int less = 36; int at_most = 37;
	if (type_signed(kind)) {
		greater = 38;
		at_least = 39;
		less = 40;
		at_most = 41;
	}
	if (action == 1) {
		if (!recover_llvm_compare(body[0], greater, start, end) || !recover_llvm_compare(body[1], at_least, start, end)) return false;
		return LLVMGetInstructionOpcode(body[2]) == 46 && LLVMGetNumOperands(body[2]) == 3 && LLVMGetOperand(body[2], 0) == inclusive && LLVMGetOperand(body[2], 1) == body[0] && LLVMGetOperand(body[2], 2) == body[1] && recover_llvm_return(body[3], body[2]);
	}
	var item = LLVMGetParam(function, 3);
	if (!recover_llvm_compare(body[0], at_least, item, start) || !recover_llvm_compare(body[1], at_most, item, end) || !recover_llvm_compare(body[2], less, item, end)) return false;
	if (LLVMGetInstructionOpcode(body[3]) != 46 || LLVMGetNumOperands(body[3]) != 3 || LLVMGetOperand(body[3], 0) != inclusive || LLVMGetOperand(body[3], 1) != body[1] || LLVMGetOperand(body[3], 2) != body[2]) return false;
	return LLVMGetInstructionOpcode(body[4]) == 23 && LLVMGetNumOperands(body[4]) == 2 && LLVMGetOperand(body[4], 0) == body[0] && LLVMGetOperand(body[4], 1) == body[3] && recover_llvm_return(body[5], body[4]);
}

int recover_range_query_call(RecoverSsa ssa, RecoverNode row, void* call, void* aggregate, void* item, void* module) throws Error {
	var type = range_query_receiver(ssa.cfg.core.flow.checked, row.source); int action = range_query_action(ssa.cfg.core.flow.checked, row.source);
	return recover_range_call(ssa, type, action, call, aggregate, item, module);
}

int recover_range_call(RecoverSsa ssa, TypeId type, int action, void* call, void* aggregate, void* item, void* module) throws Error {
	if (!range_type_verified(ssa.cfg.core.flow.checked.types, type) || aggregate == null || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, type, LLVMTypeOf(aggregate)) || call == null || LLVMIsAInstruction(call) == null || LLVMGetInstructionOpcode(call) != 45) return 0;
	if (action < 1 || action > 2) return 0;
	int count = action + 2;
	var element = ssa.cfg.core.flow.checked.types.argument(ssa.cfg.core.flow.checked.types, type, 0).type;
	int kind = checked_kind(ssa.cfg.core.flow.checked, element);
	int index = (kind - 1) * 2 + action - 1; var name = llvm_name("astra.range.query.", index);
	var function = LLVMGetCalledValue(call);
	if (function == null || LLVMIsAFunction(function) == null || LLVMGetGlobalParent(function) != module || !recover_range_query_helper(function, kind, action, name.text) || !recover_llvm_call(call, function, count, 8) || !recover_llvm_native_attributes(call, count) || LLVMHasMetadata(call) != 0) return 0;
	int instructions = 2; int field = 0;
	while (field < 3) {
		var argument = LLVMGetArgOperand(call, field);
		if (!recover_llvm_extract(argument, aggregate, field)) return 0;
		if (LLVMIsAInstruction(aggregate) != null) {
			if (LLVMGetInstructionParent(argument) != LLVMGetInstructionParent(call) || LLVMHasMetadata(argument) != 0) return 0;
			instructions = instructions + 1;
		}
		field = field + 1;
	}
	if (action == 2 && LLVMGetArgOperand(call, 3) != item) return 0;
	return instructions;
}

bool recover_range_counter_load(CheckedIndex checked, TypeId element, void* value, void* address, void* layout, void* block) {
	return value != null && LLVMIsAInstruction(value) != null && LLVMGetInstructionOpcode(value) == 27 && LLVMGetInstructionParent(value) == block && LLVMGetNumOperands(value) == 1 && LLVMGetOperand(value, 0) == address && recover_llvm_scalar_type(checked, element, LLVMTypeOf(value)) && LLVMGetAlignment(value) == LLVMABIAlignmentOfType(layout, LLVMTypeOf(value)) && LLVMGetVolatile(value) == 0 && LLVMGetOrdering(value) == 0 && LLVMHasMetadata(value) == 0;
}

bool recover_range_counter_store(void* operation, void* address, void* layout, void* block) {
	if (operation == null || LLVMIsAInstruction(operation) == null || LLVMGetInstructionOpcode(operation) != 28 || LLVMGetNumOperands(operation) != 2 || LLVMGetInstructionParent(operation) != block || LLVMGetOperand(operation, 1) != address || LLVMGetVolatile(operation) != 0 || LLVMGetOrdering(operation) != 0 || LLVMHasMetadata(operation) != 0) return false;
	return LLVMGetAlignment(operation) == LLVMABIAlignmentOfType(layout, LLVMTypeOf(LLVMGetOperand(operation, 0)));
}

int recover_range_loop_instruction(RecoverSsa ssa, RecoverBlock block, void* layout, void* physical, void* operation, void* aggregate, void* address, void* initial, void* module) throws Error {
	var row = ssa.cfg.core.nodes[block.origin - 1].value; if (row.kind != 89 || !range_foreach_binding(ssa.cfg.core.flow.checked, row.symbol)) return 0;
	var type = ssa.cfg.core.nodes[row.a - 1].value.type;
	if (aggregate == null || address == null || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, type, LLVMTypeOf(aggregate))) return 0;
	var element = ssa.cfg.core.flow.checked.types.argument(ssa.cfg.core.flow.checked.types, type, 0).type;
	if (block.opcode == 89) {
		if (!recover_range_counter_store(operation, address, layout, physical) || LLVMGetOperand(operation, 0) != initial || !recover_llvm_extract(initial, aggregate, 0)) return 0;
		if (LLVMIsAInstruction(aggregate) == null) return 2;
		if (LLVMGetInstructionParent(initial) != physical || LLVMHasMetadata(initial) != 0) return 0;
		return 3;
	}
	var current = LLVMGetFirstInstruction(physical);
	if (!recover_range_counter_load(ssa.cfg.core.flow.checked, element, current, address, layout, physical)) return 0;
	if (block.opcode == 90) {
		int introduced = recover_range_call(ssa, type, 2, operation, aggregate, current, module);
		if (introduced == 0) return 0;
		return introduced + 1;
	}
	if (block.opcode == 91) {
		if (operation == null || LLVMIsAInstruction(operation) == null || LLVMGetInstructionOpcode(operation) != 42 || LLVMGetNumOperands(operation) != 2 || LLVMGetInstructionParent(operation) != physical || LLVMGetICmpSameSign(operation) != 0 || LLVMHasMetadata(operation) != 0) return 0;
		int predicate = 36; if (type_signed(checked_kind(ssa.cfg.core.flow.checked, element))) predicate = 40;
		var end = LLVMGetOperand(operation, 1);
		if (!recover_llvm_compare(operation, predicate, current, end) || !recover_llvm_extract(end, aggregate, 1)) return 0;
		if (LLVMIsAInstruction(aggregate) == null) return 3;
		if (LLVMGetInstructionParent(end) != physical || LLVMHasMetadata(end) != 0) return 0;
		return 4;
	}
	if (block.opcode != 92 || !recover_range_counter_store(operation, address, layout, physical)) return 0;
	var added = LLVMGetOperand(operation, 0);
	if (LLVMIsAInstruction(added) == null || LLVMGetInstructionOpcode(added) != 8 || LLVMGetNumOperands(added) != 2 || LLVMGetInstructionParent(added) != physical || LLVMGetOperand(added, 0) != current || !recover_llvm_bits(LLVMGetOperand(added, 1), type_width(checked_kind(ssa.cfg.core.flow.checked, element)), 1) || LLVMGetNUW(added) != 0 || LLVMGetNSW(added) != 0 || LLVMHasMetadata(added) != 0) return 0;
	return 4;
}
