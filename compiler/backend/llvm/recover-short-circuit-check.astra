// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
bool recover_short_llvm_phi(RecoverSsa ssa, int join, void* phi, void*[] values, void*[] blocks) {
	var block = ssa.cfg.blocks[join - 1];
	var row = ssa.cfg.core.nodes[block.origin - 1].value;
	if (phi == null || LLVMIsAInstruction(phi) == null || LLVMGetInstructionOpcode(phi) != 44 || LLVMGetInstructionParent(phi) != blocks[join - 1] || LLVMHasMetadata(phi) != 0) return false;
	if (row.kind == 80) {
		int at = 0;
		while (at < row.count) {
			int arm = ssa.cfg.core.flow.data.edges[row.first + at];
			int input = ssa.cfg.core.nodes[arm - 1].value.a;
			if (values[input] == null || LLVMTypeOf(phi) != LLVMTypeOf(values[input])) return false;
			at = at + 1;
		}
	} else { if (row.kind == 77) {
			if (values[row.b] == null || values[row.c] == null || LLVMTypeOf(phi) != LLVMTypeOf(values[row.b]) || LLVMTypeOf(phi) != LLVMTypeOf(values[row.c])) return false;
		} else {
			if (row.kind != 62 || LLVMGetTypeKind(LLVMTypeOf(phi)) != 8 || LLVMGetIntTypeWidth(LLVMTypeOf(phi)) != 1) return false;
		} }
	int incoming = 0;
	int e = 0;
	while (e < ssa.cfg.edge_count) {
		var edge = ssa.cfg.edges[e];
		if (edge.target == join && ssa.data.reachable[edge.source - 1]) {
			var source = ssa.cfg.blocks[edge.source - 1];
			void* expected = values[row.b];
			if (source.opcode == 63 && source.origin == block.origin) expected = values[row.a];
			if (row.kind == 77) {
				if (source.opcode != 78 || source.origin != block.origin || source.rank < 0 || source.rank > 1) return false;
				expected = values[row.b];
				if (source.rank == 1) expected = values[row.c];
			}
			if (row.kind == 80) {
				if (source.opcode != 78 || source.origin != block.origin || source.rank < 0 || source.rank >= row.count) return false;
				int arm = ssa.cfg.core.flow.data.edges[row.first + source.rank];
				int input = ssa.cfg.core.nodes[arm - 1].value.a;
				if (source.a != input) return false;
				expected = values[input];
			}
			if (incoming >= LLVMCountIncoming(phi) || LLVMGetIncomingBlock(phi, incoming) != blocks[edge.source - 1] || LLVMGetIncomingValue(phi, incoming) != expected) return false;
			incoming = incoming + 1;
		}
		e = e + 1;
	}
	int expected_count = 2;
	if (row.kind == 80) expected_count = row.count;
	return incoming == expected_count && LLVMCountIncoming(phi) == expected_count;
}
