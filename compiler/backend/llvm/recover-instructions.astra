// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Closed instruction inventories prevent an otherwise LLVM-valid extra load,
// call or store from escaping the source/ownership correspondence checks.
int recover_llvm_instruction_count(void* block) {
	int count = 0; var instruction = LLVMGetFirstInstruction(block);
	while (instruction != null && count <= 8192) {
		count = count + 1;
		instruction = LLVMGetNextInstruction(instruction);
	}
	if (instruction != null) return -1; return count;
}

bool recover_llvm_scalar_type(CheckedIndex checked, TypeId semantic, void* actual) {
	int kind = checked_kind(checked, semantic);
	if (recover_storage_pointer(checked, semantic)) return recover_shared_pointer(actual);
	if (kind == 14) return LLVMGetTypeKind(actual) == 0;
	if (kind == 11) return LLVMGetTypeKind(actual) == 2;
	if (kind == 12) return LLVMGetTypeKind(actual) == 3;
	int width = 1; if (type_integer(kind)) width = type_width(kind);
	return (kind == 13 || type_integer(kind)) && LLVMGetTypeKind(actual) == 8 && LLVMGetIntTypeWidth(actual) == width;
}

bool recover_llvm_native_attributes(void* call, int arguments) {
	int i = -1; while (i <= arguments) {
		if (LLVMGetCallSiteAttributeCount(call, i) != 0) return false;
		i = i + 1;
	} return true;
}

int recover_llvm_extract_instructions(void* aggregate) { if (LLVMIsAInstruction(aggregate) == null) return 0; return 2; }

bool recover_llvm_binary(RecoverSsa ssa, RecoverNode row, void* result, void* left, void* right, void* equal_function, void*[] integer_functions) throws Error {
	var token = ssa.cfg.core.flow.checked.bindings.program.arena.token_message(row.token); int kind = checked_kind(ssa.cfg.core.flow.checked, ssa.cfg.core.nodes[row.a - 1].value.type);
	if (kind == 15) {
		var call = result;
		if (token.text == "!=") {
			if (LLVMIsAInstruction(result) == null || LLVMGetInstructionOpcode(result) != 42 || LLVMGetICmpPredicate(result) != 32 || LLVMIsAConstantInt(LLVMGetOperand(result, 1)) == null || LLVMConstIntGetZExtValue(LLVMGetOperand(result, 1)) != 0) return false;
			call = LLVMGetOperand(result, 0);
		}
		if (!recover_llvm_call(call, equal_function, 4, 8) || !recover_llvm_native_attributes(call, 4)) return false;
		return recover_llvm_extract(LLVMGetArgOperand(call, 0), left, 0) && recover_llvm_extract(LLVMGetArgOperand(call, 1), left, 1) && recover_llvm_extract(LLVMGetArgOperand(call, 2), right, 0) && recover_llvm_extract(LLVMGetArgOperand(call, 3), right, 1);
	}
	if (!recover_llvm_scalar_type(ssa.cfg.core.flow.checked, row.type, LLVMTypeOf(result))) return false;
	if (kind >= 1 && kind <= 10 && (token.text == "/" || token.text == "%")) {
		if (len(integer_functions) != 20) return false;
		int index = (kind - 1) * 2;
		if (token.text == "%") index = index + 1;
		return integer_functions[index] != null && recover_llvm_call(result, integer_functions[index], 2, 8) && recover_llvm_native_attributes(result, 2) && LLVMGetArgOperand(result, 0) == left && LLVMGetArgOperand(result, 1) == right && LLVMHasMetadata(result) == 0;
	}
	if (kind == 27 || kind == 31 || recover_storage_pointer(ssa.cfg.core.flow.checked, ssa.cfg.core.nodes[row.a - 1].value.type)) {
		if ((token.text != "==" && token.text != "!=") || !recover_shared_pointer(LLVMTypeOf(left)) || LLVMTypeOf(right) != LLVMTypeOf(left)) return false;
		bool equal = token.text == "==";
		if (LLVMIsAConstantInt(result) != null) {
			if (left != right && !(LLVMIsNull(left) != 0 && LLVMIsNull(right) != 0)) return false;
			u64 expected = 0;
			if (equal) expected = 1;
			return recover_llvm_bits(result, 1, expected);
		}
		int predicate = 33;
		if (equal) predicate = 32;
		return recover_llvm_compare(result, predicate, left, right) && LLVMGetICmpSameSign(result) == 0 && LLVMHasMetadata(result) == 0;
	}
	if (kind == 11 || kind == 12) return recover_llvm_float_binary(token.text, kind, result, left, right);
	bool comparison = token.text == "==" || token.text == "!=" || token.text == "<" || token.text == ">" || token.text == "<=" || token.text == ">=";
	if (LLVMIsAConstantInt(result) != null) {
		if (LLVMIsAConstantInt(left) == null || LLVMIsAConstantInt(right) == null) return false;
		u64 a = LLVMConstIntGetZExtValue(left); u64 b = LLVMConstIntGetZExtValue(right); u64 expected = 0; int width = 1; if (kind != 13) width = type_width(kind);
		if (comparison) {
			if (type_signed(kind)) {
				u64 sign = 1 as u64 << (width - 1);
				a = a ^ sign;
				b = b ^ sign;
			}
			bool truth = false;
			if (token.text == "==") truth = a == b; if (token.text == "!=") truth = a != b; if (token.text == "<") truth = a < b; if (token.text == ">") truth = a > b; if (token.text == "<=") truth = a <= b; if (token.text == ">=") truth = a >= b;
			if (truth) expected = 1;
		} else {
			if (token.text == "+") expected = a + b; if (token.text == "-") expected = a - b; if (token.text == "*") expected = a * b;
			if (token.text == "&") expected = a & b; if (token.text == "|") expected = a | b; if (token.text == "^") expected = a ^ b;
			if (width < 64) expected = expected & ((1 as u64 << width) - 1);
		}
		return LLVMConstIntGetZExtValue(result) == expected;
	}
	if (LLVMIsAInstruction(result) == null || LLVMGetNumOperands(result) != 2 || LLVMGetOperand(result, 0) != left || LLVMGetOperand(result, 1) != right) return false;
	if (token.text == "&" || token.text == "|" || token.text == "^") {
		int opcode = 23;
		if (token.text == "|") opcode = 24;
		if (token.text == "^") opcode = 25;
		if (LLVMGetInstructionOpcode(result) != opcode || LLVMHasMetadata(result) != 0) return false;
		return opcode != 24 || LLVMGetIsDisjoint(result) == 0;
	}
	if (!comparison) {
		int opcode = 8;
		if (token.text == "-") opcode = 10;
		if (token.text == "*") opcode = 12;
		return LLVMGetInstructionOpcode(result) == opcode && LLVMGetNUW(result) == 0 && LLVMGetNSW(result) == 0;
	}
	int predicate = 32; if (token.text == "!=") predicate = 33;
	if (type_signed(kind)) {
		if (token.text == "<") predicate = 40;
		if (token.text == ">") predicate = 38;
		if (token.text == "<=") predicate = 41;
		if (token.text == ">=") predicate = 39;
	}
	else {
		if (token.text == "<") predicate = 36;
		if (token.text == ">") predicate = 34;
		if (token.text == "<=") predicate = 37;
		if (token.text == ">=") predicate = 35;
	}
	return LLVMGetInstructionOpcode(result) == 42 && LLVMGetICmpPredicate(result) == predicate;
}
