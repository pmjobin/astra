// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Source-site helper identities are owned by one LLVM module. No formatting
// plan, closure, scratch collection or borrowed text is retained at runtime.
class RecoverFormatRuntime {
	owned void*[] into;
	owned void*[] text;

	init(int nodes) { this.into = new void*[nodes]; this.text = new void*[nodes]; }
}

int recover_format_offset(RecoverNode row) { if (row.kind == 112) return 1; return 0; }

u64 recover_format_float_mask(int action) {
	if (action == 6) return 2139095040;
	return 9218868437227405312;
}
