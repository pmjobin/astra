	owned RecoverRecordStorage[] record_storage;
	owned void*[] enum_carriers;
	owned void*[] enum_drops;
	owned void*[] slot_functions;
	owned RecoverSharedRuntime shared_runtime;
	owned RecoverSharedRuntime intrinsic_shared;
	owned void*[] shared_drops;
	owned void*[] functions;
	owned void*[] foreign_functions;
	owned void*[] entries;
	owned void*[] blocks;
	owned void*[] values;
	owned void*[] slots;
	owned void*[] locals;
	owned void*[] owner_addresses;
	owned void*[] owner_armed;
	owned void*[] owner_initial_values;
	owned void*[] owner_initial_flags;
	owned void*[] descriptors;
	owned void*[] payloads;
	owned void*[] destroyers;
