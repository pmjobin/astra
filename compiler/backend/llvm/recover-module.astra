// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// The explicit stack preserves next-before-other depth-first emission.
// Each first visit can add at most two entries to the pending stack.
int recover_llvm_emission_order(RecoverBlock[] blocks, int count, int[] entries, bool[] reachable, int[] order) {
	if (count < 1 || count > 8000000 || count > len(blocks) || count != len(reachable) || count != len(order)) return 0;
	var pending = new int[count + 1]; var visited = new bool[count];
	int emitted = 0; int f = 0;
	while (f < len(entries)) {
		int depth = 1;
		pending[0] = entries[f];
		while (depth > 0) {
			depth = depth - 1;
			int node = pending[depth];
			if (node < 1 || node > count || !reachable[node - 1]) return 0;
			if (visited[node - 1]) continue;
			visited[node - 1] = true;
			order[emitted] = node;
			emitted = emitted + 1;
			var block = blocks[node - 1];
			if (block.other != 0) {
				if (depth == len(pending)) return 0;
				pending[depth] = block.other;
				depth = depth + 1;
			}
			if (block.next != 0) {
				if (depth == len(pending)) return 0;
				pending[depth] = block.next;
				depth = depth + 1;
			}
		}
		f = f + 1;
	}
	int b = 0;
	while (b < count) {
		if (visited[b] != reachable[b]) return 0;
		b = b + 1;
	}
	return emitted;
}

struct RecoverRecordStorage {
	void* memory;
	void* load_function;
	void* store_function;
	void* index_function;
}

// E25-A-v1 private module. All LLVM handles, descriptor/layout caches, source
