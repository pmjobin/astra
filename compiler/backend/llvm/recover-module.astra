	}

	void enum_drop_declare(CheckedIndex checked, TypeId type, int depth) throws Error {
		if (depth > 32 || !enum_storage_owned(checked, type, 0) || this.enum_drops[type.index] != null) return;
		var carrier = this.scalar(checked, type);
		assert_that(carrier != null);
		var name = llvm_name("astra.enum.drop.", type.index);
		var parameters = new void*[1]; parameters[0] = this.pointer;
		var function = this.function(name.text, LLVMVoidTypeInContext(this.context), parameters, true);
		this.enum_drops[type.index] = function;
		var declaration = checked.bindings.symbol(checked.types.row(type).nominal);
		var variants = checked.bindings.program.arena.get_list_variants(declaration.node); int at = 0;
		while (at < checked.bindings.program.arena.list_count(variants)) {
			var fields = checked.bindings.program.arena.get_list_fields(checked.bindings.program.arena.node_at(variants, at)); int f = 0;
			while (f < checked.bindings.program.arena.list_count(fields)) {
				var field = checked.bindings.program.arena.node_at(fields, f);
				var child = checked.symbol_types[checked.node_symbols[field.index].index];
				if (checked_kind(checked, child) == 32) this.enum_drop_declare(checked, child, depth + 1);
				f = f + 1;
			}
			at = at + 1;
		}
	}

	void enum_helpers(RecoverSsa ssa) throws Error {
		int t = 1;
		while (t < len(this.enum_carriers)) {
			if (this.enum_carriers[t] != null) this.enum_drop_declare(ssa.cfg.core.flow.checked, type_id(t), 0);
			t = t + 1;
		}
		t = 1;
		while (t < len(this.enum_drops)) {
			var function = this.enum_drops[t];
			if (function != null) {
				var type = type_id(t);
				var declaration = ssa.cfg.core.flow.checked.bindings.symbol(ssa.cfg.core.flow.checked.types.row(type).nominal);
				var variants = ssa.cfg.core.flow.checked.bindings.program.arena.get_list_variants(declaration.node);
				int count = ssa.cfg.core.flow.checked.bindings.program.arena.list_count(variants);
				var entry = llvm12_block(this.context, function, "entry");
				var tagged = llvm12_block(this.context, function, "tagged");
