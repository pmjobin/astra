		var snapshot_allocate = snapshot_runtime.build_helper();
		this.snapshot_allocate_function = snapshot_allocate;
		var pointer_type = new void*[1]; pointer_type[0] = this.pointer; this.message_function = this.function("astra.e25a.message", this.text, pointer_type, true);
		var entry = llvm12_block(this.context, this.message_function, "entry"); LLVMPositionBuilderAtEnd(this.builder, entry); var object = LLVMGetParam(this.message_function, 0);
