	deinit() {
		if (this.handles != null) llvm12_handles_dispose(this.handles);
		if (this.layout != null) LLVMDisposeTargetData(this.layout);
		if (this.machine != null) LLVMDisposeTargetMachine(this.machine);
		if (this.builder != null) LLVMDisposeBuilder(this.builder);
		if (this.module != null) LLVMDisposeModule(this.module);
		if (this.context != null) LLVMContextDispose(this.context);
