	void* structure(void*[] fields) { return LLVMStructTypeInContext(this.context, this.arguments(fields), len(fields), 0); }

	void* constant(void*[] fields) { return LLVMConstStructInContext(this.context, this.arguments(fields), len(fields), 0); }

