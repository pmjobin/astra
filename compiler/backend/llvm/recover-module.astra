	}

	void* scalar(CheckedIndex checked, TypeId type) {
		int kind = checked_kind(checked, type);
		if (kind == 32 && enum_storage_type_verified(checked, type)) {
			if (checked_payload_free_enum(checked, type)) return this.integer;
			if (type.index < 1 || type.index >= len(this.enum_carriers)) return null;
			if (this.enum_carriers[type.index] != null) return this.enum_carriers[type.index];
			int bytes = recover_enum_payload_shape(checked, type, 0, 0);
			int alignment = recover_enum_payload_shape(checked, type, 1, 0);
			if (bytes < 0 || alignment < 1 || alignment > 8 || bytes > 2147483647 - alignment + 1) return null;
			var unit = LLVMIntTypeInContext(this.context, alignment * 8);
			var fields = new void*[2]; fields[0] = this.integer;
			fields[1] = LLVMArrayType2(unit, ((bytes + alignment - 1) / alignment) as u64);
			var carrier = this.structure(fields);
			if (!recover_enum_llvm_type(checked, type, carrier) || LLVMABISizeOfType(this.layout, carrier) != recover_enum_type_bytes(checked, type, 0) as u64 || LLVMABIAlignmentOfType(this.layout, carrier) != recover_enum_type_alignment(checked, type, 0)) return null;
			this.enum_carriers[type.index] = carrier;
			return carrier;
		}
		if ((kind == 36 || kind == 37) && range_sequence_type_verified(checked.types, type)) {
			int count = 3; if (kind == 37) count = 4;
			var fields = new void*[count]; var element = this.scalar(checked, checked.types.argument(checked.types, type, 0).type);
			fields[0] = element; fields[1] = element; fields[2] = this.boolean; if (kind == 37) fields[3] = element;
			return this.structure(fields);
		}
		if (kind == 40 && checked.types.lazy_element(type, 0).index != 0) return this.text;
		if (kind == 38 && checked.types.inline_callable_type(type)) {
			int count = checked.types.row(type).count - 2; var fields = new void*[count]; int at = 0;
			while (at < count) {
				fields[at] = this.scalar(checked, checked.types.argument(checked.types, type, at + 2).type); at = at + 1;
			}
			return this.structure(fields);
		}
		if (kind == 39 && checked.types.lazy_element(type, 0).index != 0) {
			var fields = new void*[2]; fields[0] = this.scalar(checked, checked.types.argument(checked.types, type, 0).type); fields[1] = this.scalar(checked, checked.types.argument(checked.types, type, 1).type); return this.structure(fields);
		}
