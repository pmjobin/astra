		if (kind == 30) {
			var declaration = checked.bindings.symbol(checked.types.row(type).nominal);
			var source = checked.bindings.program.arena.get_list_fields(declaration.node);
			int count = checked.bindings.program.arena.list_count(source);
			var fields = new void*[count];
			int f = 0;
			while (f < count) {
				var node = checked.bindings.program.arena.node_at(source, f);
				var symbol = checked.node_symbols[node.index];
				if (checked_kind(checked, checked.symbol_types[symbol.index]) == 30) {
					var shape = recover_record_shape(checked, type);
					if (!recover_record_shape_verify(shape, checked)) return null;
					var flattened = new void*[shape.leaf_count]; int leaf = 0;
					while (leaf < shape.leaf_count) {
						flattened[leaf] = this.scalar(checked, shape.parts[shape.leaves[leaf] - 1].type);
						leaf = leaf + 1;
					}
					return this.structure(flattened);
				}
				fields[f] = this.scalar(checked, checked.symbol_types[symbol.index]);
				f = f + 1;
			}
			return this.structure(fields);
