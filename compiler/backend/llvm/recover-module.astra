	void* load(void* type, void* address) { return LLVMBuildLoad2(this.builder, type, address, this.empty); }

	void* int32(int value) { return LLVMConstInt(this.integer, value as u64, 0); }

	void* int64(int value) { return LLVMConstInt(this.wide, value as u64, 0); }

