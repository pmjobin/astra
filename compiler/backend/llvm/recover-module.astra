		this.context = null; this.module = null; this.builder = null; this.machine = null; this.layout = null; this.handles = null; this.empty = llvm12_empty();
		this.pointer = null; this.integer = null; this.wide = null; this.boolean = null; this.text = null; this.payload = null; this.descriptor = null; this.origin_type = null;
		this.free_function = null; this.calloc_function = null; this.memcpy_function = null; this.memcmp_function = null; this.trap_function = null; this.allocate_function = null; this.construct_function = null; this.message_function = null; this.destroy_function = null; this.subtype_function = null; this.equal_function = null; this.buffer_function = null;
		this.error_owner_function = null;
		this.snapshot_allocate_function = null;
		this.snapshot_initialize_function = null;
		this.class_snapshot = null;
		this.utf8_function = null;
		var lazy_runtime = new RecoverLazyRuntime(ssa.cfg.core.count); this.lazy_runtime = move lazy_runtime;
		this.range_steps = new void*[10];
		this.range_queries = new void*[20];
		this.range_counts = new void*[10];
		this.range_fills = new void*[10];
		this.integer_functions = new void*[20];
		this.shift_functions = new void*[200];
		this.float_integer_functions = new void*[20];
		this.index_functions = new void*[16];
		this.slice_functions = new void*[13];
		this.fixed_backings = new void*[ssa.cfg.core.count];
		var shared_runtime = new RecoverSharedRuntime(null, null, null, null, null, null, null);
		this.shared_runtime = move shared_runtime;
		var intrinsic_shared = new RecoverSharedRuntime(null, null, null, null, null, null, null);
		this.intrinsic_shared = move intrinsic_shared;
		this.shared_drops = new void*[ssa.cfg.core.flow.checked.types.count + 1];
		int functions = ssa.cfg.core.flow.data.function_count; int nodes = ssa.cfg.core.count; int symbols = ssa.cfg.core.flow.checked.bindings.symbol_count + 1;
		this.foreign_functions = new void*[symbols];
