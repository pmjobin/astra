		LLVMPositionBuilderAtEnd(this.builder, valid); var success = LLVMBuildRet(this.builder, pointer);
		LLVMPositionBuilderAtEnd(this.builder, fatal); var trap = this.call(this.trap_function, none, false); var end = LLVMBuildUnreachable(this.builder);
	}

	void object_helpers() {
