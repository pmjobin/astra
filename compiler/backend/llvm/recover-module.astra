		var pointer_type = new void*[1]; pointer_type[0] = this.pointer; this.free_function = this.function("free", LLVMVoidTypeInContext(this.context), pointer_type, false);
		var bytes_types = new void*[3]; bytes_types[0] = this.pointer; bytes_types[1] = this.pointer; bytes_types[2] = this.wide; this.memcpy_function = this.function("memcpy", this.pointer, bytes_types, false); this.memcmp_function = this.function("memcmp", this.integer, bytes_types, false);
