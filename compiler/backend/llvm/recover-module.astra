		var entry = llvm12_block(this.context, this.subtype_function, "entry"); var loop = llvm12_block(this.context, this.subtype_function, "ancestry"); var matching = llvm12_block(this.context, this.subtype_function, "matching"); var parent = llvm12_block(this.context, this.subtype_function, "parent"); var found = llvm12_block(this.context, this.subtype_function, "found"); var absent = llvm12_block(this.context, this.subtype_function, "absent");
