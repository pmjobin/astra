// LLVM 23 globals used only by the module-owned recoverable-error domain.
extern(C) void* LLVMAddGlobal(void* module, void* type, void* name);

extern(C) void LLVMSetInitializer(void* global, void* value);

extern(C) void* LLVMGetInitializer(void* global);

extern(C) void LLVMSetGlobalConstant(void* global, int constant);

extern(C) void* LLVMConstStructInContext(void* context, void* fields, int count, int packed);

extern(C) void* LLVMGetAllocatedType(void* instruction);

extern(C) int LLVMGetCallSiteAttributeCount(void* call, int index);

extern(C) int LLVMIsGlobalConstant(void* global);

extern(C) void* LLVMGetAggregateElement(void* constant, int index);

extern(C) u64 LLVMGetArrayLength2(void* type);

extern(C) void* llvm_recover_roots_alloc(int count);

extern(C) int llvm_recover_roots_set(void* roots, int index, void* entry);

extern(C) void* llvm_recover_roots_finish(void* module, void* roots);

extern(C) void* llvm_recover_roots_get(void* module);

extern(C) int llvm_recover_roots_section(void* global);
