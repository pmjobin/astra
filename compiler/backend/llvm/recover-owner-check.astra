// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Owner storage is a real slot plus an independent armed bit. A null Class
// value may be armed; an uninitialized successful result may not be read.
bool recover_llvm_owner_initial(RecoverSlot slot, CheckedIndex checked, void* entry, void* address, void* armed, void* value_store, void* flag_store, void* source) {
	if (!slot.owner || address == null || armed == null || value_store == null || flag_store == null || LLVMIsAInstruction(value_store) == null || LLVMIsAInstruction(flag_store) == null || LLVMIsAInstruction(address) == null || LLVMIsAInstruction(armed) == null || LLVMGetInstructionOpcode(address) != 26 || LLVMGetInstructionOpcode(armed) != 26 || LLVMGetInstructionParent(address) != entry || LLVMGetInstructionParent(armed) != entry || !recover_storage_llvm_type(checked, slot.type, LLVMGetAllocatedType(address)) || LLVMGetTypeKind(LLVMGetAllocatedType(armed)) != 8 || LLVMGetIntTypeWidth(LLVMGetAllocatedType(armed)) != 1) return false;
	if (LLVMGetInstructionOpcode(value_store) != 28 || LLVMGetOperand(value_store, 1) != address || LLVMGetInstructionParent(value_store) != entry || LLVMGetInstructionOpcode(flag_store) != 28 || LLVMGetOperand(flag_store, 1) != armed || LLVMGetInstructionParent(flag_store) != entry) return false;
	if (!recover_llvm_bits(LLVMGetOperand(flag_store, 0), 1, 0) && !slot.parameter || !recover_llvm_bits(LLVMGetOperand(flag_store, 0), 1, 1) && slot.parameter) return false;
	if (slot.parameter) return LLVMGetOperand(value_store, 0) == source; return LLVMIsNull(LLVMGetOperand(value_store, 0)) != 0;
}

bool recover_llvm_owner_drop(CheckedIndex checked, RecoverSlot slot, void* block, void* address, void* armed, void* free_function, void* operation) {
	int kind = checked_kind(checked, slot.type); int count = 6; if (kind == 22) count = 7; var body = recover_llvm_body(block, count); if (len(body) != count) return false;
	int convention = 0; if (recover_storage_error(checked, slot.type)) convention = 8;
	if (kind == 27 || kind == 28) convention = 8;
	if (kind == 31 && recover_storage_class(checked, slot.type)) {
		var declaration = checked.bindings.symbol(checked.types.row(slot.type).nominal);
		if (checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(declaration.node)) > 0 || class_storage_intrinsic_verified(checked, slot.type)) convention = 8;
	}
	if (LLVMGetInstructionOpcode(body[0]) != 27 || LLVMGetOperand(body[0], 0) != address || !recover_storage_llvm_type(checked, slot.type, LLVMTypeOf(body[0])) || LLVMGetInstructionOpcode(body[1]) != 27 || LLVMGetOperand(body[1], 0) != armed) return false;
	int at = 2; void* data = body[0]; if (kind == 22) {
		if (!recover_llvm_extract(body[2], body[0], 0)) return false;
		data = body[2];
		at = 3;
	}
	if (LLVMGetInstructionOpcode(body[at]) != 46 || LLVMGetOperand(body[at], 0) != body[1] || LLVMGetOperand(body[at], 1) != data || LLVMIsNull(LLVMGetOperand(body[at], 2)) == 0 || LLVMGetInstructionOpcode(body[at + 1]) != 28 || !recover_llvm_bits(LLVMGetOperand(body[at + 1], 0), 1, 0) || LLVMGetOperand(body[at + 1], 1) != armed || !recover_llvm_call(body[at + 2], free_function, 1, convention) || LLVMGetArgOperand(body[at + 2], 0) != body[at] || operation != body[at + 2]) return false;
	return LLVMGetVolatile(body[0]) == 0 && LLVMGetVolatile(body[1]) == 0 && LLVMGetVolatile(body[at + 1]) == 0;
}

bool recover_llvm_owner_write(void* block, void* address, void* armed, void* value, void* operation) {
	var body = recover_llvm_body(block, 3); return len(body) == 3 && operation == body[0] && LLVMGetInstructionOpcode(body[0]) == 28 && LLVMGetOperand(body[0], 0) == value && LLVMGetOperand(body[0], 1) == address && LLVMGetVolatile(body[0]) == 0 && LLVMGetInstructionOpcode(body[1]) == 28 && recover_llvm_bits(LLVMGetOperand(body[1], 0), 1, 1) && LLVMGetOperand(body[1], 1) == armed && LLVMGetVolatile(body[1]) == 0;
}

bool recover_llvm_temporary_drop(CheckedIndex checked, TypeId type, void* block, void* value, void* address, void* drop, void* operation) throws Error {
	int kind = checked_kind(checked, type);
	int count = 2;
	if (kind == 22 || kind == 32) count = 3;
	var body = recover_llvm_body(block, count);
	if (len(body) != count || value == null || !recover_storage_llvm_type(checked, type, LLVMTypeOf(value))) return false;
	int at = 0; int convention = 0; void* data = value; void* selected_drop = drop;
	if (kind == 22) {
		if (!recover_llvm_extract(body[0], value, 0)) return false;
		data = body[0]; at = 1;
	}
	if (kind == 32) {
		if (!enum_storage_owned(checked, type, 0) || address == null || LLVMGetInstructionOpcode(body[0]) != 28 || LLVMGetOperand(body[0], 0) != value || LLVMGetOperand(body[0], 1) != address || LLVMGetAlignment(body[0]) != recover_enum_type_alignment(checked, type, 0) || LLVMGetVolatile(body[0]) != 0 || LLVMGetOrdering(body[0]) != 0) return false;
		var name = llvm_name("astra.enum.drop.", type.index);
		selected_drop = LLVMGetCalledValue(body[1]);
		if (!recover_llvm_helper_signature(selected_drop, 1) || llvm13_named(selected_drop, name.text) != 1 || LLVMGetGlobalParent(selected_drop) != LLVMGetGlobalParent(LLVMGetBasicBlockParent(block)) || LLVMGetTypeKind(LLVMGetReturnType(LLVMGlobalGetValueType(selected_drop))) != 0) return false;
		data = address; at = 1; convention = 8;
	} else {
		if (recover_storage_error(checked, type) || kind == 27 || kind == 28) convention = 8;
		if (kind == 31 && recover_storage_class(checked, type)) {
			var declaration = checked.bindings.symbol(checked.types.row(type).nominal);
			if (checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(declaration.node)) > 0 || class_storage_intrinsic_verified(checked, type)) convention = 8;
		}
	}
	return operation == body[at] && recover_llvm_call(operation, selected_drop, 1, convention) && LLVMGetArgOperand(operation, 0) == data;
}
