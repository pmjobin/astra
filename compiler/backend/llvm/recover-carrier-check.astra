// Exact insert/extract correspondence for flattened native source groups.
bool recover_llvm_insert(void* value, void* previous, void* element, int ordinal) {
	if (LLVMIsAInstruction(value) == null || LLVMGetInstructionOpcode(value) != 54 || llvm13_index(value, 0, ordinal) != 1) return false;
	return LLVMGetOperand(value, 0) == previous && LLVMGetOperand(value, 1) == element;
}

// Inspect the actual bound inserts and inclusive bit, including LLVM's
// constant-folded prefix. No producer-side field plan is retained.
int recover_llvm_range(RecoverSsa ssa, RecoverNode row, void* value, void* left, void* right, void* block) {
	if (!range_type_verified(ssa.cfg.core.flow.checked.types, row.type) || value == null || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, row.type, LLVMTypeOf(value))) return -1;
	void* current = value; int instructions = 0; int field = 2; bool folded = false;
	while (field >= 0) {
		void* element = null;
		if (LLVMIsAInstruction(current) != null) {
			if (LLVMGetInstructionOpcode(current) != 54 || LLVMGetInstructionParent(current) != block || llvm13_index(current, 0, field) != 1 || LLVMHasMetadata(current) != 0) return -1;
			element = LLVMGetOperand(current, 1); current = LLVMGetOperand(current, 0); instructions = instructions + 1;
		} else {
			element = LLVMGetAggregateElement(current, field); folded = true;
		}
		if (field == 0 && element != left || field == 1 && element != right) return -1;
		if (field == 2) {
			u64 inclusive = 0;
			if (ssa.cfg.core.flow.checked.bindings.program.arena.token_is(row.token, "..=")) inclusive = 1;
			if (!recover_llvm_bits(element, 1, inclusive)) return -1;
		}
		field = field - 1;
	}
	if (!folded && LLVMIsNull(current) == 0) return -1;
	return instructions;
}

bool recover_llvm_group(CheckedIndex checked, TypeId type, void* value, void* function, int start) {
	int kind = checked_kind(checked, type); int count = recover_abi_group_count(checked, type, 0); if (kind == 22) count = 2;
	if (kind == 32) return enum_storage_type_verified(checked, type) && LLVMIsAInstruction(value) != null && LLVMGetInstructionOpcode(value) == 27 && LLVMGetOperand(value, 0) == LLVMGetParam(function, start) && LLVMGetAlignment(value) == recover_enum_type_alignment(checked, type, 0) && LLVMGetVolatile(value) == 0 && LLVMGetOrdering(value) == 0 && LLVMHasMetadata(value) == 0 && recover_llvm_scalar_type(checked, type, LLVMTypeOf(value));
	if (kind != 37 && kind != 36 && kind != 30 && kind != 22 && kind != 15) return value == LLVMGetParam(function, start);
	if (!recover_storage_llvm_type(checked, type, LLVMTypeOf(value))) return false;
	int i = count - 1; void* current = value;
	while (i >= 0) {
		if (LLVMIsAInstruction(current) == null || LLVMGetInstructionOpcode(current) != 54 || llvm13_index(current, 0, i) != 1 || LLVMGetOperand(current, 1) != LLVMGetParam(function, start + i)) return false;
		current = LLVMGetOperand(current, 0);
		i = i - 1;
	} return LLVMIsNull(current) != 0;
}

// Return the exact number of instructions introduced by this construction.
// Source field counts and leaf ordering are reconstructed without a shape plan.
int recover_llvm_record(RecoverSsa ssa, RecoverNode row, void* value, void*[] values, void* block) {
	if (value == null || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, row.type, LLVMTypeOf(value))) return -1;
	int total = recover_record_value_count(ssa.cfg.core.flow.checked, row.type, 0);
	if (total < 0) return -1;
	var seen = new bool[total]; int checked_leaves = 0;
	var fields = ssa.cfg.core.flow.checked.bindings.program.arena.get_list_fields(row.source);
	if (row.count != ssa.cfg.core.flow.checked.bindings.program.arena.list_count(fields)) return -1;
	int i = row.count - 1; int instructions = 0; bool folded = false; void* current = value;
	while (i >= 0) {
		var field = ssa.cfg.core.flow.checked.bindings.program.arena.node_at(fields, i);
		var token = ssa.cfg.core.flow.checked.bindings.program.arena.get_token_name(field);
		int ordinal = recover_record_field(ssa.cfg.core.flow.checked, row.type, token);
		int first = recover_record_value_first(ssa.cfg.core.flow.checked, row.type, ordinal);
		if (first < 0) return -1;
		int child = ssa.cfg.core.flow.data.edges[row.first + i]; var type = ssa.cfg.core.nodes[child - 1].value.type; bool record = checked_kind(ssa.cfg.core.flow.checked, type) == 30;
		int count = 1; if (record) count = recover_record_value_count(ssa.cfg.core.flow.checked, type, 0);
		if (count < 0) return -1; int leaf = count - 1;
		while (leaf >= 0) {
			int at = first + leaf;
			if (at < 0 || at >= total || seen[at]) return -1;
			seen[at] = true; checked_leaves = checked_leaves + 1;
			void* element = null;
			if (LLVMIsAInstruction(current) != null) {
				if (LLVMGetInstructionParent(current) != block || LLVMGetInstructionOpcode(current) != 54 || llvm13_index(current, 0, at) != 1 || LLVMHasMetadata(current) != 0) return -1;
				element = LLVMGetOperand(current, 1); current = LLVMGetOperand(current, 0); instructions = instructions + 1;
			} else {
				if (at < 0) return -1;
				element = LLVMGetAggregateElement(current, at); folded = true;
			}
			if (record) {
				if (!recover_llvm_extract(element, values[child], leaf)) return -1;
				if (LLVMIsAInstruction(values[child]) != null) {
					if (LLVMGetInstructionParent(element) != block || LLVMHasMetadata(element) != 0) return -1;
					instructions = instructions + 1;
				}
			} else {
				if (element != values[child]) return -1;
			}
			leaf = leaf - 1;
		}
		i = i - 1;
	}
	if (checked_leaves != total || !folded && LLVMIsNull(current) == 0) return -1;
	return instructions;
}

int recover_llvm_record_projection(RecoverSsa ssa, RecoverNode row, TypeId receiver, void* aggregate, void* value, void* block) {
	if (value == null || aggregate == null || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, receiver, LLVMTypeOf(aggregate))) return -1;
	int ordinal = recover_record_field(ssa.cfg.core.flow.checked, receiver, row.token); int first = recover_record_value_first(ssa.cfg.core.flow.checked, receiver, ordinal);
	if (range_type_verified(ssa.cfg.core.flow.checked.types, receiver)) {
		if (ordinal < 0 || ordinal > 1 || !recover_llvm_extract(value, aggregate, ordinal)) return -1;
		if (LLVMIsAInstruction(value) == null) return 0;
		if (LLVMGetInstructionParent(value) != block || LLVMHasMetadata(value) != 0) return -1;
		return 1;
	}
	if (first < 0) return -1;
	if (checked_kind(ssa.cfg.core.flow.checked, row.type) != 30) {
		if (!recover_llvm_extract(value, aggregate, first)) return -1;
		if (LLVMIsAInstruction(value) == null) return 0;
		if (LLVMGetInstructionParent(value) != block || LLVMHasMetadata(value) != 0) return -1;
		return 1;
	}
	if (!recover_storage_llvm_type(ssa.cfg.core.flow.checked, row.type, LLVMTypeOf(value))) return -1;
	int count = recover_record_value_count(ssa.cfg.core.flow.checked, row.type, 0); if (count < 0) return -1;
	int leaf = count - 1; int instructions = 0; bool folded = false; void* current = value;
	while (leaf >= 0) {
		void* element = null;
		if (LLVMIsAInstruction(current) != null) {
			if (LLVMGetInstructionParent(current) != block || LLVMGetInstructionOpcode(current) != 54 || llvm13_index(current, 0, leaf) != 1 || LLVMHasMetadata(current) != 0) return -1;
			element = LLVMGetOperand(current, 1); current = LLVMGetOperand(current, 0); instructions = instructions + 1;
		} else {
			element = LLVMGetAggregateElement(current, leaf); folded = true;
		}
		if (!recover_llvm_extract(element, aggregate, first + leaf)) return -1;
		if (LLVMIsAInstruction(aggregate) != null) {
			if (LLVMGetInstructionParent(element) != block || LLVMHasMetadata(element) != 0) return -1;
			instructions = instructions + 1;
		}
		leaf = leaf - 1;
	}
	if (!folded && LLVMIsNull(current) == 0) return -1;
	return instructions;
}
