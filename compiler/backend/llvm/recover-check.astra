// Physical consumer. No source reparse, scheduling or emission helpers.
bool recover_llvm_call(void* call, void* function, int count, int convention) {
	if (call == null || LLVMIsAInstruction(call) == null || LLVMGetInstructionOpcode(call) != 45 || LLVMGetCalledValue(call) != function || LLVMGetNumArgOperands(call) != count || LLVMGetInstructionCallConv(call) != convention) return false;
	int p = 0; while (p <= count) {
		if (LLVMGetCallSiteAttributeCount(call, p) != 0) return false;
		p = p + 1;
	}
	int attributes = LLVMGetCallSiteAttributeCount(call, -1);
	if (convention == 8) return attributes == 0;
	// The emitter's C calls either have no call-level attributes (trap) or
	// exactly nobuiltin. A forged memory effect can erase the real copy or
	// retirement while leaving every operand and LLVM type otherwise valid.
	return attributes == 0 || attributes == 1 && llvm13_attribute(call, -1, 1, "nobuiltin") == 1;
}

bool recover_llvm_extract(void* value, void* aggregate, int index) {
	if (value == null || aggregate == null) return false;
	if (LLVMIsAInstruction(aggregate) == null) return value == LLVMGetAggregateElement(aggregate, index);
	return LLVMIsAInstruction(value) != null && LLVMGetInstructionOpcode(value) == 53 && LLVMGetOperand(value, 0) == aggregate && llvm13_index(value, 0, index) == 1;
}

bool recover_llvm_field(void* address, void* type, void* object, int field) {
	return address != null && LLVMIsAInstruction(address) != null && LLVMGetInstructionOpcode(address) == 29 && LLVMGetGEPSourceElementType(address) == type && LLVMGetNumOperands(address) == 3 && LLVMGetOperand(address, 0) == object && LLVMIsAConstantInt(LLVMGetOperand(address, 1)) != null && LLVMConstIntGetZExtValue(LLVMGetOperand(address, 1)) == 0 && LLVMIsAConstantInt(LLVMGetOperand(address, 2)) != null && LLVMConstIntGetZExtValue(LLVMGetOperand(address, 2)) == field as u64 && LLVMGEPGetNoWrapFlags(address) == 0;
}

bool recover_llvm_literal(CheckedIndex checked, RecoverNode row, void* value) throws Error {
	if (value == null) return false;
	if (row.type.index == 15) {
		var text = checked.bindings.program.arena.payload_message(row.token);
		return llvm17_text_literal_matches(value, text.text) == 1;
	}
	if (row.type.index == 11 || row.type.index == 12) return recover_llvm_float_literal(checked, row, value);
	if (LLVMIsAConstantInt(value) == null) return false;
	var text = checked.bindings.program.arena.token_message(row.token); u64 bits = 0;
	if (row.type.index == 13) {
		if (text.text == "true") bits = 1;
	}
	else {
		int i = 0;
		while (i < text.text.byte_length) {
			int digit = astra_host_text_byte(text.text, i) - 48;
			if (digit < 0 || digit > 9) return false;
			bits = bits * 10 + digit as u64;
			i = i + 1;
		}
	}
	int width = 1; if (row.type.index != 13) width = type_width(checked_kind(checked, row.type)); if (width < 64) bits = bits & ((1 as u64 << width) - 1);
	return LLVMGetIntTypeWidth(LLVMTypeOf(value)) == width && LLVMConstIntGetZExtValue(value) == bits;
}

bool recover_library_llvm_roots(void* module, void*[] functions, bool library) {
	var table = llvm_recover_roots_get(module);
	if (!library) return table == null;
	if (table == null || llvm13_named(table, "llvm.used") != 1 || LLVMGetGlobalParent(table) != module || LLVMGetLinkage(table) != 7 || LLVMIsGlobalConstant(table) != 0 || llvm_recover_roots_section(table) != 1) return false;
