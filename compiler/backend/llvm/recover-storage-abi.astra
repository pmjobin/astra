// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// E25-A-v1 carrier groups, measured independently against native-v14 C0.
// Buffers use (data,count), copyable records use their ordered scalar fields,
// and Class owners/borrowed receivers use one pointer. Hidden success storage
// follows an admitted receiver and precedes every explicit source group.
int recover_abi_group_count(CheckedIndex checked, TypeId type, int flags) {
	if (!recover_storage_channel(checked, type, flags, false)) return 0;
	int kind = checked_kind(checked, type); if (kind == 22) return 2;
	if (kind == 30) {
		var declaration = checked.bindings.symbol(checked.types.row(type).nominal);
		return checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(declaration.node));
	}
	return 1;
}

class RecoverAbi {
	owned shared TypeOwner identity;
	SymbolId declaration;
	SignatureId signature;
	TypeId result;
	TypeId error;
	int result_flags;
	int receiver;
	int success;
	int parameters;
	owned int[] groups;

	init(CheckedIndex checked, SymbolId declaration) {
		var identity = shared_clone(checked.types.identity); this.identity = move identity; this.declaration = declaration; var id = checked.symbol_signatures[declaration.index]; this.signature = id; var signature = checked.signatures[id.index - 1]; var result = checked.types.argument(checked.types, signature.callable, 0); this.result = result.type; this.result_flags = result.flags; this.error = signature.error;
		int receiver = -1; int instance = generic_instance_for(checked, declaration); if (instance > 0 && checked.instances[instance - 1].enclosing.index != 0) receiver = 0; this.receiver = receiver;
		int success = -1; if ((signature.flags & 64) != 0 && result.type.index != 14) {
			success = 0;
			if (receiver == 0) success = 1;
		} this.success = success;
		int count = checked.types.row(signature.callable).count - 1; this.groups = new int[count]; int physical = 0; int p = 0;
		while (p < count) {
			if (physical == success) physical = physical + 1;
			this.groups[p] = physical;
			var channel = checked.types.argument(checked.types, signature.callable, p + 1);
			physical = physical + recover_abi_group_count(checked, channel.type, channel.flags);
			p = p + 1;
		}
		if (physical == success) physical = physical + 1; this.parameters = physical;
	}
}

bool recover_abi_verify(RecoverAbi plan, CheckedIndex checked) {
	if (!type_owner_same(plan.identity, checked.types.identity) || plan.declaration.index < 1 || plan.declaration.index > checked.bindings.symbol_count || !checked.validate()) return false;
	var symbol = checked.bindings.symbol(plan.declaration); var id = checked.symbol_signatures[plan.declaration.index]; if (symbol.kind != 1 || id.index < 1 || id.index > checked.signature_count || plan.signature.index != id.index) return false;
	var signature = checked.signatures[id.index - 1]; var result = checked.types.argument(checked.types, signature.callable, 0);
	if (plan.result.index != result.type.index || plan.error.index != signature.error.index || plan.result_flags != result.flags || !recover_storage_channel(checked, result.type, result.flags, true) || signature.dispatch != 0 || (signature.flags & ~(4 | 64)) != 0 || !checked_effect_signature_verified(checked, signature) || !recover_member_attributes(checked, symbol.node)) return false;
	int receiver = -1; int instance = generic_instance_for(checked, plan.declaration);
	if (instance > 0 && checked.instances[instance - 1].enclosing.index != 0) {
		var source = checked.instances[instance - 1]; var origin = checked.bindings.symbol(source.origin); if (origin.kind != 11 && origin.kind != 12 || !class_storage_class(checked, source.enclosing) || !generic_verify(checked)) return false; receiver = 0;
	}
	int success = -1; if ((signature.flags & 64) != 0 && result.type.index != 14) {
		success = 0;
		if (receiver == 0) success = 1;
	}
	if (plan.receiver != receiver || plan.success != success) return false;
	int count = checked.types.row(signature.callable).count - 1; if (count != len(plan.groups) || count < 0 || count > 256) return false;
	int physical = 0; int p = 0;
	while (p < count) {
		if (physical == success) physical = physical + 1; if (plan.groups[p] != physical) return false;
		var channel = checked.types.argument(checked.types, signature.callable, p + 1); if (!recover_storage_channel(checked, channel.type, channel.flags, false)) return false;
		if (p == 0 && receiver == 0 && (channel.flags != 2 || channel.type.index != checked.instances[instance - 1].enclosing.index)) return false;
		int kind = checked_kind(checked, channel.type); int groups = 1;
		if (kind == 22) groups = 2;
		if (kind == 30) {
			var declaration = checked.bindings.symbol(checked.types.row(channel.type).nominal);
			groups = checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(declaration.node));
		}
		physical = physical + groups; p = p + 1;
	}
	if (physical == success) physical = physical + 1;
	return plan.parameters == physical;
}

// Compare physical types against the original nominal table, independently
// of the module's layout cache. Records here contain only scalar fields.
bool recover_storage_llvm_type(CheckedIndex checked, TypeId type, void* actual) {
	if (actual == null) return false;
	int kind = checked_kind(checked, type);
	if (kind == 31) return recover_storage_class(checked, type) && LLVMGetTypeKind(actual) == 12;
	if (kind == 22) return LLVMGetTypeKind(actual) == 10 && LLVMIsPackedStruct(actual) == 0 && LLVMCountStructElementTypes(actual) == 2 && LLVMGetTypeKind(LLVMStructGetTypeAtIndex(actual, 0)) == 12 && LLVMGetTypeKind(LLVMStructGetTypeAtIndex(actual, 1)) == 8 && LLVMGetIntTypeWidth(LLVMStructGetTypeAtIndex(actual, 1)) == 32;
	if (kind == 30) {
		if (!recover_storage_record(checked, type) || LLVMGetTypeKind(actual) != 10 || LLVMIsPackedStruct(actual) != 0) return false;
		var declaration = checked.bindings.symbol(checked.types.row(type).nominal); var fields = checked.bindings.program.arena.get_list_fields(declaration.node); int count = checked.bindings.program.arena.list_count(fields); if (LLVMCountStructElementTypes(actual) != count) return false; int f = 0;
		while (f < count) {
			var node = checked.bindings.program.arena.node_at(fields, f);
			var symbol = checked.node_symbols[node.index];
			if (!recover_llvm_scalar_type(checked, checked.symbol_types[symbol.index], LLVMStructGetTypeAtIndex(actual, f))) return false;
			f = f + 1;
		} return true;
	}
	return recover_llvm_scalar_type(checked, type, actual);
}

bool recover_storage_llvm_abi(RecoverAbi plan, CheckedIndex checked, void* function) {
	if (!recover_abi_verify(plan, checked) || function == null || LLVMGetFunctionCallConv(function) != 8 || LLVMGetLinkage(function) != 8 || LLVMCountParams(function) != plan.parameters) return false;
	var physical = LLVMGlobalGetValueType(function); if (LLVMIsFunctionVarArg(physical) != 0) return false;
	var signature = checked.signatures[plan.signature.index - 1]; bool conditional = (signature.flags & 64) != 0; var result = LLVMGetReturnType(physical);
	if (conditional) {
		if (LLVMGetTypeKind(result) != 12) return false;
	} else {
		if (!recover_storage_llvm_type(checked, plan.result, result)) return false;
	}
	if (plan.success >= 0 && LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, plan.success))) != 12) return false;
	int p = 0; while (p < len(plan.groups)) {
		var channel = checked.types.argument(checked.types, signature.callable, p + 1); int at = plan.groups[p]; int kind = checked_kind(checked, channel.type);
		if (kind == 22) {
			if (LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, at))) != 12 || !recover_llvm_scalar_type(checked, type_id(1), LLVMTypeOf(LLVMGetParam(function, at + 1)))) return false;
		}
		else { if (kind == 30) {
				var declaration = checked.bindings.symbol(checked.types.row(channel.type).nominal); var fields = checked.bindings.program.arena.get_list_fields(declaration.node); int f = 0;
				while (f < checked.bindings.program.arena.list_count(fields)) {
					var node = checked.bindings.program.arena.node_at(fields, f);
					var symbol = checked.node_symbols[node.index];
					if (!recover_llvm_scalar_type(checked, checked.symbol_types[symbol.index], LLVMTypeOf(LLVMGetParam(function, at + f)))) return false;
					f = f + 1;
				}
			} else {
				if (!recover_storage_llvm_type(checked, channel.type, LLVMTypeOf(LLVMGetParam(function, at)))) return false;
			} }
		p = p + 1;
	}
	int attribute = -1; while (attribute <= plan.parameters) {
		if (LLVMGetAttributeCountAtIndex(function, attribute) != 0) return false;
		attribute = attribute + 1;
	} return true;
}
