// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// E25-A-v1 carrier groups, measured independently against native-v14 C0.
// Buffers use (data,count), copyable records use their ordered scalar fields,
// and Class owners/borrowed receivers use one pointer. Hidden success storage
// follows an admitted receiver and precedes every explicit source group.
int recover_abi_group_count(CheckedIndex checked, TypeId type, int flags) {
	if (!recover_storage_channel(checked, type, flags, false)) return 0;
	int kind = checked_kind(checked, type); if (kind == 22 || kind == 15) return 2;
	if (kind == 30) {
		var declaration = checked.bindings.symbol(checked.types.row(type).nominal);
		return checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(declaration.node));
	}
	return 1;
}

class RecoverAbi {
	owned shared TypeOwner identity;
	SymbolId declaration;
	SignatureId signature;
	TypeId result;
	TypeId error;
	int result_flags;
	int receiver;
	int success;
	int parameters;
	owned int[] groups;

	init(CheckedIndex checked, SymbolId declaration) {
		var identity = shared_clone(checked.types.identity); this.identity = move identity; this.declaration = declaration; var id = checked.symbol_signatures[declaration.index]; this.signature = id; var signature = checked.signatures[id.index - 1]; var result = checked.types.argument(checked.types, signature.callable, 0); this.result = result.type; this.result_flags = result.flags; this.error = signature.error;
		int receiver = -1; int instance = generic_instance_for(checked, declaration); if (instance > 0 && checked.instances[instance - 1].enclosing.index != 0) receiver = 0; this.receiver = receiver;
		int success = -1; if ((signature.flags & 64) != 0 && result.type.index != 14) {
			success = 0;
			if (receiver == 0) success = 1;
		} this.success = success;
		int count = checked.types.row(signature.callable).count - 1; this.groups = new int[count]; int physical = 0; int p = 0;
		while (p < count) {
			if (physical == success) physical = physical + 1;
			this.groups[p] = physical;
			var channel = checked.types.argument(checked.types, signature.callable, p + 1);
			physical = physical + recover_abi_group_count(checked, channel.type, channel.flags);
			p = p + 1;
		}
		if (physical == success) physical = physical + 1; this.parameters = physical;
	}
}

bool recover_abi_verify(RecoverAbi plan, CheckedIndex checked) {
	if (plan.parameters < 0 || plan.parameters > 1024 || !type_owner_same(plan.identity, checked.types.identity) || plan.declaration.index < 1 || plan.declaration.index > checked.bindings.symbol_count || !checked.validate()) return false;
	var symbol = checked.bindings.symbol(plan.declaration); var id = checked.symbol_signatures[plan.declaration.index]; if (symbol.kind != 1 || id.index < 1 || id.index > checked.signature_count || plan.signature.index != id.index) return false;
	var signature = checked.signatures[id.index - 1]; var result = checked.types.argument(checked.types, signature.callable, 0);
	if (plan.result.index != result.type.index || plan.error.index != signature.error.index || plan.result_flags != result.flags || !recover_storage_channel(checked, result.type, result.flags, true) || signature.dispatch != 0 || (signature.flags & ~(4 | 64)) != 0 || !checked_effect_signature_verified(checked, signature) || !recover_member_attributes(checked, symbol.node)) return false;
	int receiver = -1; int instance = generic_instance_for(checked, plan.declaration);
	if (instance > 0 && checked.instances[instance - 1].enclosing.index != 0) {
		var source = checked.instances[instance - 1]; var origin = checked.bindings.symbol(source.origin);
		bool error = error_storage_class(checked, source.enclosing);
		if (origin.kind != 11 && origin.kind != 12 || !class_storage_class(checked, source.enclosing) && !error || !generic_verify(checked)) return false;
		if (error) {
			// Error members use the same borrowed one-pointer group, with the
			// actual independently checked source copy and hidden parameter.
			if (source.concrete.index != plan.declaration.index || source.state != 2 || origin.owner.index != checked.types.row(source.enclosing).nominal.index) return false;
			int hidden = class_storage_receiver(checked, plan.declaration);
			if (hidden < 1 || checked.bindings.symbol(type_symbol(hidden)).kind != 7 || checked.bindings.symbol(type_symbol(hidden)).owner.index != plan.declaration.index || checked.symbol_types[hidden].index != source.enclosing.index || checked.symbol_flags[hidden] != 2) return false;
			if (origin.kind == 12 && !recover_error_constructor_source(checked, plan.declaration)) return false;
		}
		receiver = 0;
	}
	int success = -1; if ((signature.flags & 64) != 0 && result.type.index != 14) {
		success = 0;
		if (receiver == 0) success = 1;
	}
	if (plan.receiver != receiver || plan.success != success) return false;
	int count = checked.types.row(signature.callable).count - 1; if (count != len(plan.groups) || count < 0 || count > 256) return false;
	int physical = 0; int p = 0;
	while (p < count) {
		if (physical == success) physical = physical + 1; if (plan.groups[p] != physical) return false;
		var channel = checked.types.argument(checked.types, signature.callable, p + 1); if (!recover_storage_channel(checked, channel.type, channel.flags, false)) return false;
		if (p == 0 && receiver == 0 && (channel.flags != 2 || channel.type.index != checked.instances[instance - 1].enclosing.index)) return false;
		int kind = checked_kind(checked, channel.type); int groups = 1;
		if (kind == 22 || kind == 15) groups = 2;
		if (kind == 30) {
			var declaration = checked.bindings.symbol(checked.types.row(channel.type).nominal);
			groups = checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(declaration.node));
		}
		physical = physical + groups; p = p + 1;
	}
	if (physical == success) physical = physical + 1;
	return plan.parameters == physical && physical <= 1024;
}

// Compare physical types against the original nominal table, independently
// of the module's layout cache. Records here contain only scalar fields.
bool recover_storage_llvm_type(CheckedIndex checked, TypeId type, void* actual) {
	if (actual == null) return false;
	int kind = checked_kind(checked, type);
	if (kind == 27) return recover_storage_shared(checked, type) && LLVMGetTypeKind(actual) == 12 && LLVMGetPointerAddressSpace(actual) == 0;
	if (kind == 31) return (recover_storage_class(checked, type) || recover_storage_error(checked, type)) && LLVMGetTypeKind(actual) == 12;
	if (kind == 23) {
		if (!recover_storage_slots(checked, type, 0) || LLVMGetTypeKind(actual) != 10 || LLVMIsPackedStruct(actual) != 0 || LLVMCountStructElementTypes(actual) != 3) return false;
		var pointer = LLVMStructGetTypeAtIndex(actual, 0); var count = LLVMStructGetTypeAtIndex(actual, 1); var capacity = LLVMStructGetTypeAtIndex(actual, 2);
		return LLVMGetTypeKind(pointer) == 12 && LLVMGetPointerAddressSpace(pointer) == 0 && LLVMGetTypeKind(count) == 8 && LLVMGetIntTypeWidth(count) == 32 && capacity == count;
	}
	if (kind == 21 || kind == 22 || kind == 15) return LLVMGetTypeKind(actual) == 10 && LLVMIsPackedStruct(actual) == 0 && LLVMCountStructElementTypes(actual) == 2 && LLVMGetTypeKind(LLVMStructGetTypeAtIndex(actual, 0)) == 12 && LLVMGetTypeKind(LLVMStructGetTypeAtIndex(actual, 1)) == 8 && LLVMGetIntTypeWidth(LLVMStructGetTypeAtIndex(actual, 1)) == 32;
	if (kind == 30) {
		if (!recover_storage_record(checked, type) || LLVMGetTypeKind(actual) != 10 || LLVMIsPackedStruct(actual) != 0) return false;
		var declaration = checked.bindings.symbol(checked.types.row(type).nominal); var fields = checked.bindings.program.arena.get_list_fields(declaration.node); int count = checked.bindings.program.arena.list_count(fields); if (LLVMCountStructElementTypes(actual) != count) return false; int f = 0;
		while (f < count) {
			var node = checked.bindings.program.arena.node_at(fields, f);
			var symbol = checked.node_symbols[node.index];
			if (!recover_llvm_scalar_type(checked, checked.symbol_types[symbol.index], LLVMStructGetTypeAtIndex(actual, f))) return false;
			f = f + 1;
		} return true;
	}
	return recover_llvm_scalar_type(checked, type, actual);
}

bool recover_storage_llvm_abi(RecoverAbi plan, CheckedIndex checked, void* function) {
	if (!recover_abi_verify(plan, checked) || function == null || LLVMGetFunctionCallConv(function) != 8 || LLVMGetLinkage(function) != 8 || LLVMCountParams(function) != plan.parameters) return false;
	var physical = LLVMGlobalGetValueType(function); if (LLVMIsFunctionVarArg(physical) != 0) return false;
	var signature = checked.signatures[plan.signature.index - 1]; bool conditional = (signature.flags & 64) != 0; var result = LLVMGetReturnType(physical);
	if (conditional) {
		if (LLVMGetTypeKind(result) != 12) return false;
	} else {
		if (!recover_storage_llvm_type(checked, plan.result, result)) return false;
	}
	if (plan.success >= 0 && LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, plan.success))) != 12) return false;
	int p = 0; while (p < len(plan.groups)) {
		var channel = checked.types.argument(checked.types, signature.callable, p + 1); int at = plan.groups[p]; int kind = checked_kind(checked, channel.type);
		if (kind == 22 || kind == 15) {
			if (LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, at))) != 12 || !recover_llvm_scalar_type(checked, type_id(1), LLVMTypeOf(LLVMGetParam(function, at + 1)))) return false;
		}
		else { if (kind == 30) {
				var declaration = checked.bindings.symbol(checked.types.row(channel.type).nominal); var fields = checked.bindings.program.arena.get_list_fields(declaration.node); int f = 0;
				while (f < checked.bindings.program.arena.list_count(fields)) {
					var node = checked.bindings.program.arena.node_at(fields, f);
					var symbol = checked.node_symbols[node.index];
					if (!recover_llvm_scalar_type(checked, checked.symbol_types[symbol.index], LLVMTypeOf(LLVMGetParam(function, at + f)))) return false;
					f = f + 1;
				}
			} else {
				if (!recover_storage_llvm_type(checked, channel.type, LLVMTypeOf(LLVMGetParam(function, at)))) return false;
			} }
		p = p + 1;
	}
	int attribute = -1; while (attribute <= plan.parameters) {
		if (LLVMGetAttributeCountAtIndex(function, attribute) != 0) return false;
		attribute = attribute + 1;
	} return true;
}

// Independent physical-tree traversal. No emitter metadata or cached source
// leaf offsets are used to choose a path in the supplied memory descriptor.
int recover_record_memory_leaves(void* type, int depth) {
	if (type == null || depth > 32) return 0;
	int kind = LLVMGetTypeKind(type);
	if (kind == 2 || kind == 3) return 1;
	if (kind == 8) {
		int width = LLVMGetIntTypeWidth(type);
		if (width == 1 || width == 8 || width == 16 || width == 32 || width == 64) return 1;
		return 0;
	}
	if (kind != 10 || LLVMIsPackedStruct(type) != 0) return 0;
	int fields = LLVMCountStructElementTypes(type); if (fields < 1 || fields > 128) return 0;
	int result = 0; int i = 0;
	while (i < fields) {
		int leaves = recover_record_memory_leaves(LLVMStructGetTypeAtIndex(type, i), depth + 1);
		if (leaves < 1 || leaves > 1024 - result) return 0;
		result = result + leaves; i = i + 1;
	}
	return result;
}

owned int[] recover_record_memory_path(void* memory, int ordinal) {
	var path = new int[33]; path[0] = 0; int depth = 0; int remaining = ordinal; void* type = memory;
	while (type != null && LLVMGetTypeKind(type) == 10) {
		if (depth == 32 || LLVMIsPackedStruct(type) != 0) {
			var absent = new int[0];
			return move absent;
		}
		int fields = LLVMCountStructElementTypes(type); int i = 0; bool selected = false;
		while (i < fields && !selected) {
			var child = LLVMStructGetTypeAtIndex(type, i); int leaves = recover_record_memory_leaves(child, depth + 1);
			if (leaves < 1) {
				var absent = new int[0];
				return move absent;
			}
			if (remaining < leaves) {
				depth = depth + 1;
				path[depth] = i;
				type = child;
				selected = true;
			}
			else {
				remaining = remaining - leaves;
			}
			i = i + 1;
		}
		if (!selected) {
			var absent = new int[0];
			return move absent;
		}
	}
	if (remaining != 0 || recover_record_memory_leaves(type, depth) != 1) {
		var absent = new int[0];
		return move absent;
	}
	var result = new int[depth + 1]; int p = 0;
	while (p <= depth) {
		result[p] = path[p];
		p = p + 1;
	}
	return move result;
}

bool recover_record_helper_verified(void* function, void* memory, void* carrier, bool store) {
	if (function == null || memory == null || carrier == null || LLVMGetTypeKind(memory) != 10 || LLVMGetTypeKind(carrier) != 10 || LLVMIsPackedStruct(carrier) != 0) return false;
	int count = recover_record_memory_leaves(memory, 0); if (count < 1 || count != LLVMCountStructElementTypes(carrier)) return false;
	int parameters = 1; if (store) parameters = 2;
	var signature = LLVMGlobalGetValueType(function);
	if (LLVMGetFunctionCallConv(function) != 8 || LLVMGetLinkage(function) != 8 || LLVMCountParams(function) != parameters || LLVMIsFunctionVarArg(signature) != 0) return false;
	var first = LLVMGetFirstBasicBlock(function); if (first == null || LLVMGetNextBasicBlock(first) != null) return false;
	var pointer = LLVMTypeOf(LLVMGetParam(function, 0)); if (LLVMGetTypeKind(pointer) != 12 || LLVMGetPointerAddressSpace(pointer) != 0) return false;
	if (store) {
		if (LLVMGetTypeKind(LLVMGetReturnType(signature)) != 0 || LLVMTypeOf(LLVMGetParam(function, 1)) != carrier) return false;
	}
	else {
		if (LLVMGetReturnType(signature) != carrier) return false;
	}
	int attribute = -1; while (attribute <= parameters) {
		if (LLVMGetAttributeCountAtIndex(function, attribute) != 0) return false;
		attribute = attribute + 1;
	}
	var block = LLVMGetFirstBasicBlock(function); var instruction = LLVMGetFirstInstruction(block); void* previous = LLVMConstNull(carrier); int i = 0;
	while (i < count) {
		var path = recover_record_memory_path(memory, i); if (len(path) < 2) return false;
		if (instruction == null || LLVMGetInstructionOpcode(instruction) != 29 || LLVMGetGEPSourceElementType(instruction) != memory || LLVMGEPGetNoWrapFlags(instruction) != 0 || LLVMGetNumOperands(instruction) != len(path) + 1 || LLVMGetOperand(instruction, 0) != LLVMGetParam(function, 0) || LLVMHasMetadata(instruction) != 0) return false;
		void* leaf = memory; int p = 0;
		while (p < len(path)) {
			if (!recover_llvm_bits(LLVMGetOperand(instruction, p + 1), 32, path[p] as u64)) return false;
			if (p > 0) leaf = LLVMStructGetTypeAtIndex(leaf, path[p]);
			p = p + 1;
		}
		if (leaf != LLVMStructGetTypeAtIndex(carrier, i)) return false;
		var address = instruction; instruction = LLVMGetNextInstruction(instruction);
		if (instruction == null || LLVMHasMetadata(instruction) != 0) return false;
		if (store) {
			if (LLVMGetInstructionOpcode(instruction) != 53 || LLVMGetOperand(instruction, 0) != LLVMGetParam(function, 1) || llvm13_index(instruction, 0, i) != 1 || LLVMTypeOf(instruction) != leaf) return false;
			var element = instruction; instruction = LLVMGetNextInstruction(instruction);
			if (instruction == null || LLVMGetInstructionOpcode(instruction) != 28 || LLVMGetOperand(instruction, 0) != element || LLVMGetOperand(instruction, 1) != address || LLVMGetAlignment(instruction) != 1 || LLVMGetVolatile(instruction) != 0 || LLVMGetOrdering(instruction) != 0 || LLVMHasMetadata(instruction) != 0) return false;
		} else {
			if (LLVMGetInstructionOpcode(instruction) != 27 || LLVMGetOperand(instruction, 0) != address || LLVMTypeOf(instruction) != leaf || LLVMGetAlignment(instruction) != 1 || LLVMGetVolatile(instruction) != 0 || LLVMGetOrdering(instruction) != 0) return false;
			var element = instruction; instruction = LLVMGetNextInstruction(instruction);
			if (instruction == null || !recover_llvm_insert(instruction, previous, element, i) || LLVMHasMetadata(instruction) != 0) return false;
			previous = instruction;
		}
		instruction = LLVMGetNextInstruction(instruction); i = i + 1;
	}
	if (instruction == null || LLVMGetInstructionOpcode(instruction) != 1 || LLVMHasMetadata(instruction) != 0 || LLVMGetNextInstruction(instruction) != null || LLVMGetBasicBlockTerminator(block) != instruction) return false;
	if (store) return LLVMGetNumOperands(instruction) == 0;
	return LLVMGetNumOperands(instruction) == 1 && LLVMGetOperand(instruction, 0) == previous;
}
