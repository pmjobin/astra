	if (LLVMGetInstructionOpcode(entry[1]) != 42 || LLVMGetICmpPredicate(entry[1]) != 32 || LLVMGetOperand(entry[1], 0) != data || LLVMIsNull(LLVMGetOperand(entry[1], 1)) == 0) return false;
	if (LLVMGetInstructionOpcode(entry[2]) != 42 || LLVMGetICmpPredicate(entry[2]) != 33 || LLVMGetOperand(entry[2], 0) != count || !recover_llvm_bits(LLVMGetOperand(entry[2], 1), 32, 0)) return false;
	if (LLVMGetInstructionOpcode(entry[3]) != 23 || LLVMGetOperand(entry[3], 0) != entry[1] || LLVMGetOperand(entry[3], 1) != entry[2] || LLVMGetInstructionOpcode(entry[4]) != 24 || LLVMGetOperand(entry[4], 0) != entry[0] || LLVMGetOperand(entry[4], 1) != entry[3] || !recover_llvm_split(entry[5], entry[4], blocks[4], blocks[1])) return false;
	if (LLVMGetInstructionOpcode(size[0]) != 42 || LLVMGetICmpPredicate(size[0]) != 32 || LLVMGetOperand(size[0], 0) != count || !recover_llvm_bits(LLVMGetOperand(size[0], 1), 32, 0) || !recover_llvm_split(size[1], size[0], blocks[2], blocks[3]) || !recover_llvm_return(empty[0], LLVMGetOperand(empty[0], 0)) || LLVMIsNull(LLVMGetOperand(empty[0], 0)) == 0) return false;
	if (LLVMGetInstructionOpcode(body[0]) != 31 || LLVMGetOperand(body[0], 0) != count || LLVMGetIntTypeWidth(LLVMTypeOf(body[0])) != 64 || !recover_llvm_call(body[1], allocate, 2, 8) || LLVMGetArgOperand(body[1], 0) != body[0] || !recover_llvm_bits(LLVMGetArgOperand(body[1], 1), 64, 1)) return false;
	if (!recover_llvm_call(body[2], copy, 3, 0) || LLVMGetArgOperand(body[2], 0) != body[1] || LLVMGetArgOperand(body[2], 1) != data || LLVMGetArgOperand(body[2], 2) != body[0] || !recover_llvm_insert(body[3], LLVMGetOperand(body[3], 0), body[1], 0) || LLVMIsNull(LLVMGetOperand(body[3], 0)) == 0 || !recover_llvm_insert(body[4], body[3], count, 1) || !recover_llvm_return(body[5], body[4])) return false;
	return LLVMGetInstructionOpcode(fatal[0]) == 45 && LLVMGetNumArgOperands(fatal[0]) == 0 && llvm13_named(LLVMGetCalledValue(fatal[0]), "llvm.trap") == 1 && LLVMGetInstructionOpcode(fatal[1]) == 7;
