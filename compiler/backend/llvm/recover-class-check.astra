			}
			if (declaration.kind == 4 && recover_storage_class(ssa.cfg.core.flow.checked, type)) {
				fields = ssa.cfg.core.flow.checked.bindings.program.arena.get_list_fields(declaration.node); expected = ssa.cfg.core.flow.checked.bindings.program.arena.list_count(fields) > 0;
			}
		}
		if (!expected) {
			if (payloads[s] != null || destroyers[s] != null) return false;
		}
		else {
			var physical = payloads[s]; int count = ssa.cfg.core.flow.checked.bindings.program.arena.list_count(fields); var source = ssa.cfg.core.flow.fields.layout.types[type.index];
			if (physical == null || LLVMGetTypeKind(physical) != 10 || LLVMIsPackedStruct(physical) != 0 || LLVMCountStructElementTypes(physical) != count || LLVMABISizeOfType(layout, physical) != source.payload_size as u64 || LLVMABIAlignmentOfType(layout, physical) != source.payload_alignment) return false;
			int instructions = 2; int i = 0;
