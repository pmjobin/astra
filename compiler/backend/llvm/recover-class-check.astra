		return operation == values[block.origin] && recover_llvm_extract(operation, descriptor, ordinal);
	}
	if (block.opcode != 69) return false;
	int action = 1; if (ssa.cfg.core.flow.checked.bindings.program.arena.token_is(row.token, "append")) action = 2; if (ssa.cfg.core.flow.checked.bindings.program.arena.token_is(row.token, "take")) action = 3; if (ssa.cfg.core.flow.checked.bindings.program.arena.token_is(row.token, "replace")) action = 4;
	var type = ssa.cfg.core.nodes[receiver - 1].value.type;
	if (!recover_llvm_call(operation, slot_functions[type.index * 6 + action], row.count, 0) || !recover_llvm_native_attributes(operation, row.count) || LLVMGetArgOperand(operation, 0) != LLVMGetOperand(descriptor, 0)) return false;
	if (row.type.index != 14 && values[block.origin] != operation) return false;
