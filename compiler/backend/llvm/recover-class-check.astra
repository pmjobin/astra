int recover_class_field_instructions(RecoverSsa ssa, RecoverBlock block) {
	if (block.opcode == 17) return 3;
	if (block.opcode == 18) return 4;
	var row = ssa.cfg.core.nodes[block.origin - 1].value; var fact = ssa.cfg.core.flow.fields.facts[row.source.index]; int kind = checked_kind(ssa.cfg.core.flow.checked, ssa.cfg.core.flow.checked.symbol_types[fact.field.index]); int count = 3;
	if (kind == 15) count = count + 1;
	if (!fact.initializing && ((ssa.cfg.core.flow.checked.symbol_flags[fact.field.index] & 4) != 0 || kind == 15)) {
		count = count + 2;
		if (kind == 22 || kind == 15) count = count + 1;
	}
	return count;
}

bool recover_class_field_verified(RecoverSsa ssa, RecoverBlock block, void* physical, void* operation, void*[] values, void*[] locals, void*[] payloads, void*[] destroyers, void*[] shared_drops, void* snapshot, void* free, void*[] error_payloads) {
	var row = ssa.cfg.core.nodes[block.origin - 1].value; var fact = ssa.cfg.core.flow.fields.facts[row.source.index]; var type = ssa.cfg.core.flow.checked.symbol_types[fact.field.index]; int kind = checked_kind(ssa.cfg.core.flow.checked, type); var nominal = ssa.cfg.core.flow.checked.types.row(fact.aggregate).nominal;
	void* object = locals[fact.receiver.index];
	if (fact.parent > 0) object = values[fact.parent];
	void* aggregate = payloads[nominal.index]; int ordinal = fact.ordinal;
	if (error_storage_class(ssa.cfg.core.flow.checked, fact.aggregate)) {
		aggregate = error_payloads[nominal.index];
		ordinal = ordinal + 1;
	}
	int count = recover_class_field_instructions(ssa, block); if (block.opcode == 44 && kind == 15) count = count + recover_llvm_extract_instructions(values[row.a]);
	var body = recover_llvm_body(physical, count); if (len(body) != count || !recover_llvm_field(body[0], aggregate, object, ordinal)) return false;
	if (block.opcode == 17) return operation == body[1] && values[block.origin] == body[1] && recover_llvm_load_field(body[1], aggregate, object, ordinal) && recover_storage_llvm_type(ssa.cfg.core.flow.checked, type, LLVMTypeOf(body[1]));
	if (block.opcode == 18) return operation == body[2] && values[block.origin] == body[2] && recover_llvm_load_field(body[1], aggregate, object, ordinal) && recover_storage_llvm_type(ssa.cfg.core.flow.checked, type, LLVMTypeOf(body[1])) && recover_llvm_extract(body[2], body[1], 1) && recover_llvm_scalar_type(ssa.cfg.core.flow.checked, type_id(1), LLVMTypeOf(body[2]));
	int at = 1; void* value = values[row.a];
	if (kind == 15) {
		at = at + recover_llvm_extract_instructions(value); var call = body[at];
		if (!recover_llvm_call(call, snapshot, 2, 8) || !recover_llvm_extract(LLVMGetArgOperand(call, 0), value, 0) || !recover_llvm_extract(LLVMGetArgOperand(call, 1), value, 1)) return false; value = call; at = at + 1;
	}
	if (!fact.initializing && ((ssa.cfg.core.flow.checked.symbol_flags[fact.field.index] & 4) != 0 || kind == 15)) {
		if (!recover_llvm_load_field(body[at], aggregate, object, ordinal)) return false;
		void* data = body[at]; at = at + 1;
		if (kind == 22 || kind == 15) {
			if (!recover_llvm_extract(body[at], data, 0)) return false;
			data = body[at];
			at = at + 1;
		}
		void* drop = free; int convention = 0; if (kind == 31 && destroyers[ssa.cfg.core.flow.checked.types.row(type).nominal.index] != null) {
			drop = destroyers[ssa.cfg.core.flow.checked.types.row(type).nominal.index];
			convention = 8;
		}
		if (kind == 27) {
			drop = shared_drops[type.index];
			convention = 8;
		}
		if (!recover_llvm_call(body[at], drop, 1, convention) || LLVMGetArgOperand(body[at], 0) != data) return false; at = at + 1;
	}
	return at == count - 2 && body[at] == operation && LLVMGetInstructionOpcode(operation) == 28 && LLVMGetOperand(operation, 0) == value && LLVMGetOperand(operation, 1) == body[0] && LLVMGetVolatile(operation) == 0;
}
