				if (fact.ordinal != i || LLVMOffsetOfElement(layout, physical, i) != fact.offset as u64 || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, child, LLVMStructGetTypeAtIndex(physical, i))) return false;
				if (kind == 15) needs_snapshot = true;
				if ((ssa.cfg.core.flow.checked.symbol_flags[symbol.index] & 4) != 0 || kind == 15) {
					instructions = instructions + 3;
