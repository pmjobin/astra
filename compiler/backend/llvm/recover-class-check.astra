// Independent source/layout/physical consumer for ordinary fielded Classes.
// No emitter helper or pointer-shaped Error layout is used as authority.
bool recover_class_helpers_verified(RecoverSsa ssa, void* layout, void*[] payloads, void*[] destroyers, void*[] shared_drops, void* snapshot, void* allocate, void* free, void* copy) throws Error {
	if (!class_storage_verify(ssa.cfg.core.flow.fields.layout, ssa.cfg.core.flow.checked) || len(payloads) != ssa.cfg.core.flow.checked.bindings.symbol_count + 1 || len(destroyers) != len(payloads)) return false;
	bool needs_snapshot = false; int s = 0;
	while (s < len(payloads)) {
		bool expected = false; SyntaxListId fields = {index = 0}; TypeId type = {index = 0};
		if (s > 0) {
			var declaration = ssa.cfg.core.flow.checked.bindings.symbol(type_symbol(s)); type = ssa.cfg.core.flow.checked.symbol_types[s];
			if (declaration.kind == 4 && error_storage_class(ssa.cfg.core.flow.checked, type)) {
