	var entry = recover_llvm_body(blocks[0], 6); var size = recover_llvm_body(blocks[1], 2); var empty = recover_llvm_body(blocks[2], 1); var body = recover_llvm_body(blocks[3], 6); var fatal = recover_llvm_body(blocks[4], 2);
