			}
			var function = destroyers[s]; if (!recover_llvm_helper_signature(function, 1) || LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, 0))) != 12 || LLVMGetTypeKind(LLVMGetReturnType(LLVMGlobalGetValueType(function))) != 0) return false;
			var name_builder = new Utf8ByteBuilder(); source_append_text(name_builder, "astra.e25a.class.drop."); append_int(name_builder, s); var name = name_builder.snapshot(); if (llvm13_named(function, name.text) != 1) return false;
			var blocks = recover_llvm_helper_blocks(function, 3); if (len(blocks) != 3) return false;
			var entry = recover_llvm_body(blocks[0], 2); var body = recover_llvm_body(blocks[1], instructions); var exit = recover_llvm_body(blocks[2], 1); if (len(entry) != 2 || len(body) != instructions || len(exit) != 1) return false;
			var object = LLVMGetParam(function, 0);
			if (LLVMGetInstructionOpcode(entry[0]) != 42 || LLVMGetICmpPredicate(entry[0]) != 33 || LLVMGetOperand(entry[0], 0) != object || LLVMIsNull(LLVMGetOperand(entry[0], 1)) == 0 || !recover_llvm_split(entry[1], entry[0], blocks[1], blocks[2]) || !recover_llvm_void_return(exit[0])) return false;
			int at = 0; i = count - 1;
			while (i >= 0) {
				var node = ssa.cfg.core.flow.checked.bindings.program.arena.node_at(fields, i); var symbol = ssa.cfg.core.flow.checked.node_symbols[node.index]; var child = ssa.cfg.core.flow.checked.symbol_types[symbol.index]; int kind = checked_kind(ssa.cfg.core.flow.checked, child);
				if ((ssa.cfg.core.flow.checked.symbol_flags[symbol.index] & 4) != 0 || kind == 15) {
					if (!recover_llvm_field(body[at], physical, object, i) || !recover_llvm_load_field(body[at + 1], physical, object, i) || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, child, LLVMTypeOf(body[at + 1]))) return false;
					void* data = body[at + 1]; at = at + 2;
					if (kind == 22 || kind == 15) {
						if (!recover_llvm_extract(body[at], data, 0)) return false;
						data = body[at];
						at = at + 1;
					}
