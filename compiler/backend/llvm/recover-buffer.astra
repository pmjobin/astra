	if (LLVMGetInstructionOpcode(accepted[2]) != 46 || LLVMGetOperand(accepted[2], 0) != accepted[1] || LLVMGetOperand(accepted[2], 1) != accepted[0] || LLVMIsAConstantInt(LLVMGetOperand(accepted[2], 2)) == null || LLVMConstIntGetZExtValue(LLVMGetOperand(accepted[2], 2)) != 1 || !recover_llvm_call(accepted[3], allocate, 2, 8) || LLVMGetArgOperand(accepted[3], 0) != accepted[2] || LLVMGetArgOperand(accepted[3], 1) != LLVMGetParam(function, 1) || LLVMGetInstructionOpcode(accepted[4]) != 1 || LLVMGetOperand(accepted[4], 0) != accepted[3]) return false;
	var failed = recover_llvm_body(fatal, 2); return len(failed) == 2 && recover_llvm_call(failed[0], trap, 0, 0) && LLVMGetInstructionOpcode(failed[1]) == 7;
