// separate from the recoverable Error owner and have no unwind guarantee.
void* recover_buffer_helper(void* context, void* module, void* builder, void* handles, void* allocate, void* trap) {
	var pointer = LLVMPointerTypeInContext(context, 0); var integer = LLVMIntTypeInContext(context, 32); var wide = LLVMIntTypeInContext(context, 64); var empty = llvm12_empty();
	llvm12_handle_set(handles, 0, integer); llvm12_handle_set(handles, 1, wide); var signature = LLVMFunctionType(pointer, llvm12_handle_offset(handles, 0), 2, 0); var function = llvm12_function(module, signature, "astra.e25a.buffer.allocate"); LLVMSetLinkage(function, 8); LLVMSetFunctionCallConv(function, 8);
	var entry = llvm12_block(context, function, "entry"); var valid = llvm12_block(context, function, "count.valid"); var vacant = llvm12_block(context, function, "empty"); var allocated = llvm12_block(context, function, "nonempty"); var fatal = llvm12_block(context, function, "count.fatal"); LLVMPositionBuilderAtEnd(builder, entry);
	var count = LLVMGetParam(function, 0); var zero = LLVMConstInt(integer, 0, 0); var nonnegative = LLVMBuildICmp(builder, 39, count, zero, empty); var branch = LLVMBuildCondBr(builder, nonnegative, valid, fatal);
	LLVMPositionBuilderAtEnd(builder, valid); var zero_count = LLVMBuildICmp(builder, 32, count, zero, empty); var choose = LLVMBuildCondBr(builder, zero_count, vacant, allocated);
	LLVMPositionBuilderAtEnd(builder, vacant); var no_allocation = LLVMBuildRet(builder, LLVMConstNull(pointer));
	LLVMPositionBuilderAtEnd(builder, allocated); var extent = LLVMBuildZExt(builder, count, wide, empty);
	llvm12_handle_set(handles, 0, extent); llvm12_handle_set(handles, 1, LLVMGetParam(function, 1)); var call = LLVMBuildCall2(builder, LLVMGlobalGetValueType(allocate), allocate, llvm12_handle_offset(handles, 0), 2, empty); LLVMSetInstructionCallConv(call, 8); var result = LLVMBuildRet(builder, call);
	LLVMPositionBuilderAtEnd(builder, fatal); var failed = LLVMBuildCall2(builder, LLVMGlobalGetValueType(trap), trap, llvm12_handle_offset(handles, 0), 0, empty); var end = LLVMBuildUnreachable(builder); return function;
}

bool recover_buffer_helper_verified(void* function, void* allocate, void* trap) {
	if (!recover_llvm_helper_signature(function, 2) || llvm13_named(function, "astra.e25a.buffer.allocate") != 1) return false;
	var signature = LLVMGlobalGetValueType(function); if (LLVMGetTypeKind(LLVMGetReturnType(signature)) != 12 || LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, 0))) != 8 || LLVMGetIntTypeWidth(LLVMTypeOf(LLVMGetParam(function, 0))) != 32 || LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(function, 1))) != 8 || LLVMGetIntTypeWidth(LLVMTypeOf(LLVMGetParam(function, 1))) != 64) return false;
	var blocks = recover_llvm_helper_blocks(function, 5); if (len(blocks) != 5) return false; var entry = blocks[0]; var valid = blocks[1]; var vacant = blocks[2]; var allocated = blocks[3]; var fatal = blocks[4];
	var body = recover_llvm_body(entry, 2); if (len(body) != 2 || LLVMGetInstructionOpcode(body[0]) != 42 || LLVMGetICmpPredicate(body[0]) != 39 || LLVMGetOperand(body[0], 0) != LLVMGetParam(function, 0) || LLVMIsAConstantInt(LLVMGetOperand(body[0], 1)) == null || LLVMConstIntGetZExtValue(LLVMGetOperand(body[0], 1)) != 0 || !recover_llvm_split(body[1], body[0], valid, fatal)) return false;
	var accepted = recover_llvm_body(valid, 2); if (len(accepted) != 2 || LLVMGetInstructionOpcode(accepted[0]) != 42 || LLVMGetICmpPredicate(accepted[0]) != 32 || LLVMGetOperand(accepted[0], 0) != LLVMGetParam(function, 0) || !recover_llvm_bits(LLVMGetOperand(accepted[0], 1), 32, 0) || !recover_llvm_split(accepted[1], accepted[0], vacant, allocated)) return false;
	var empty = recover_llvm_body(vacant, 1); if (len(empty) != 1 || LLVMGetInstructionOpcode(empty[0]) != 1 || LLVMGetNumOperands(empty[0]) != 1 || LLVMIsNull(LLVMGetOperand(empty[0], 0)) == 0 || LLVMTypeOf(LLVMGetOperand(empty[0], 0)) != LLVMGetReturnType(signature)) return false;
	var nonempty = recover_llvm_body(allocated, 3); if (len(nonempty) != 3 || LLVMGetInstructionOpcode(nonempty[0]) != 31 || LLVMGetOperand(nonempty[0], 0) != LLVMGetParam(function, 0) || LLVMGetIntTypeWidth(LLVMTypeOf(nonempty[0])) != 64 || !recover_llvm_call(nonempty[1], allocate, 2, 8) || LLVMGetArgOperand(nonempty[1], 0) != nonempty[0] || LLVMGetArgOperand(nonempty[1], 1) != LLVMGetParam(function, 1) || !recover_llvm_return(nonempty[2], nonempty[1])) return false;
	var failed = recover_llvm_body(fatal, 2); return len(failed) == 2 && recover_llvm_call(failed[0], trap, 0, 0) && LLVMGetInstructionOpcode(failed[1]) == 7;
}
