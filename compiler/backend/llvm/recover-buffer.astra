	var empty = recover_llvm_body(vacant, 1); if (len(empty) != 1 || LLVMGetInstructionOpcode(empty[0]) != 1 || LLVMGetNumOperands(empty[0]) != 1 || LLVMIsNull(LLVMGetOperand(empty[0], 0)) == 0 || LLVMTypeOf(LLVMGetOperand(empty[0], 0)) != LLVMGetReturnType(signature)) return false;
	var nonempty = recover_llvm_body(allocated, 3); if (len(nonempty) != 3 || LLVMGetInstructionOpcode(nonempty[0]) != 31 || LLVMGetOperand(nonempty[0], 0) != LLVMGetParam(function, 0) || LLVMGetIntTypeWidth(LLVMTypeOf(nonempty[0])) != 64 || !recover_llvm_call(nonempty[1], allocate, 2, 8) || LLVMGetArgOperand(nonempty[1], 0) != nonempty[0] || LLVMGetArgOperand(nonempty[1], 1) != LLVMGetParam(function, 1) || !recover_llvm_return(nonempty[2], nonempty[1])) return false;
