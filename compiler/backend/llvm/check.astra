}
bool llvm_check_binary(CheckedIndex checked, CoreNode node, void* result, void* left, void* right) throws Error {
	var text = checked.bindings.program.arena.token_message(node.operation); var op = text.text;
	var left_node = checked.bindings.program.arena.get_node_left(node.source); var left_use = checked.uses[left_node.index]; int kind = checked_kind(checked, left_use.type);
	if (kind == 11 || kind == 12) { return llvm_check_fp_binary(op, kind, result, left, right); }
	int opcode = llvm_check_opcode(op); int predicate = llvm_check_predicate(op, kind);
	if (LLVMIsAInstruction(result) != null && (opcode != 0 || predicate != 0)) {
		if (predicate != 0) { return LLVMGetInstructionOpcode(result) == 42 && LLVMGetICmpPredicate(result) == predicate && LLVMGetOperand(result, 0) == left && LLVMGetOperand(result, 1) == right; }
		return LLVMGetInstructionOpcode(result) == opcode && LLVMGetOperand(result, 0) == left && LLVMGetOperand(result, 1) == right;
	}
	if (LLVMIsAConstantInt(result) != null && LLVMIsAConstantInt(left) != null && LLVMIsAConstantInt(right) != null && (opcode != 0 || predicate != 0)) {
		u64 a = LLVMConstIntGetZExtValue(left); u64 b = LLVMConstIntGetZExtValue(right); u64 expected = 0;
		if (op == "+") { expected = a + b; } if (op == "-") { expected = a - b; } if (op == "*") { expected = a * b; }
		if (op == "&") { expected = a & b; } if (op == "|") { expected = a | b; } if (op == "^") { expected = a ^ b; }
		if (predicate != 0) {
			bool less = a < b;
			if (type_signed(kind)) { u64 sign = 1 as u64 << (type_width(kind) - 1); if ((a & sign) != (b & sign)) { less = (a & sign) != 0; } }
			bool answer = false;
			if (op == "==") { answer = a == b; } if (op == "!=") { answer = a != b; }
			if (op == "<") { answer = less; } if (op == "<=") { answer = less || a == b; }
			if (op == ">") { answer = !less && a != b; } if (op == ">=") { answer = !less; }
			if (answer) { expected = 1; }
		} else { expected = expected & llvm_check_mask(type_width(kind)); }
		return LLVMConstIntGetZExtValue(result) == expected;
	}
	// Guarded division/shift recipes have several machine instructions. Their
	// exact sequence is sealed after construction; independent runtime and IR
	// guard inspection cover arithmetic domain/fatal behavior, not this shortcut.
	return op == "/" || op == "%" || op == "<<" || op == ">>";
