bool llvm_check_fp_binary(string op, int kind, void* result, void* left, void* right) {
	int code = 0; int predicate = 0;
	if (op == "+") { code = 9; } if (op == "-") { code = 11; }
	if (op == "*") { code = 13; } if (op == "/") { code = 16; }
	if (op == "==") { predicate = 1; } if (op == "!=") { predicate = 14; }
	if (op == ">") { predicate = 2; } if (op == ">=") { predicate = 3; }
	if (op == "<") { predicate = 4; } if (op == "<=") { predicate = 5; }
	if (LLVMIsAInstruction(result) != null) {
		if (predicate != 0) { return LLVMGetInstructionOpcode(result) == 43 && LLVMGetFCmpPredicate(result) == predicate && LLVMGetOperand(result, 0) == left && LLVMGetOperand(result, 1) == right; }
		return code != 0 && LLVMGetInstructionOpcode(result) == code && LLVMGetOperand(result, 0) == left && LLVMGetOperand(result, 1) == right;
	}
	if (LLVMIsAConstantFP(left) == null || LLVMIsAConstantFP(right) == null) { return false; }
	// This independent evaluator uses C0's strict scalar operations, not the
	// emitter's instruction builder. Narrow operands/results in the f32 domain.
	f64 a = llvm13_real_value(left); f64 b = llvm13_real_value(right);
	if (predicate != 0) {
		bool answer = false;
		if (op == "==") { answer = a == b; } if (op == "!=") { answer = a != b; }
		if (op == ">") { answer = a > b; } if (op == ">=") { answer = a >= b; }
		if (op == "<") { answer = a < b; } if (op == "<=") { answer = a <= b; }
		u64 expected = 0; if (answer) { expected = 1; }
		return LLVMIsAConstantInt(result) != null && LLVMConstIntGetZExtValue(result) == expected;
	}
	if (code == 0 || LLVMIsAConstantFP(result) == null) { return false; }
	f64 expected = 0.0d;
	if (kind == 11) {
		f32 x = a as f32; f32 y = b as f32; f32 value = 0.0f;
		if (op == "+") { value = x + y; } if (op == "-") { value = x - y; }
		if (op == "*") { value = x * y; } if (op == "/") { value = x / y; }
		expected = value as f64;
	} else {
		if (op == "+") { expected = a + b; } if (op == "-") { expected = a - b; }
		if (op == "*") { expected = a * b; } if (op == "/") { expected = a / b; }
