				if (store == null || LLVMGetInstructionOpcode(store) != 28 || LLVMGetVolatile(store) != observation || LLVMGetOperand(store, 1) != places[row.value.place - 1] || !llvm_check_operand(LLVMGetOperand(store, 0), values, a)) { return false; }
