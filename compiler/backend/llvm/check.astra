			if (imported) { if (LLVMGetFirstBasicBlock(physical) != null || wrappers[f] != null) { return false; } f = f + 1; continue; }
			var block = LLVMGetFirstBasicBlock(physical);
			if (block == null || LLVMGetNextBasicBlock(block) != null || physical == functions[f]) { return false; }
			var call = LLVMGetFirstInstruction(block); var end = LLVMGetBasicBlockTerminator(block);
			var signature = program.cfg.core.flow.checked.signatures[original.signature.index - 1]; int count = program.cfg.core.flow.checked.types.row(signature.callable).count - 1;
			if (call == null || LLVMGetInstructionOpcode(call) != 45 || LLVMGetCalledValue(call) != functions[f] || LLVMGetInstructionCallConv(call) != 0 || LLVMGetNumArgOperands(call) != count || LLVMGetNextInstruction(call) != end || end == null || LLVMGetInstructionOpcode(end) != 1) { return false; }
			int p = 0; while (p < count && budget.take(1)) { if (LLVMGetArgOperand(call, p) != LLVMGetParam(physical, p)) { return false; } p = p + 1; }
			if (original.result.index == 14) { if (LLVMGetNumOperands(end) != 0) { return false; } } else { if (LLVMGetNumOperands(end) != 1 || LLVMGetOperand(end, 0) != call) { return false; } }
		} else { if (wrappers[f] != null) { return false; } }
