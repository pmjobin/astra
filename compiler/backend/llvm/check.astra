				if (a < 1 || z < 1 || !llvm_check_binary(program.cfg.core.flow.checked, row.value, result, values[a - 1], values[z - 1])) { return false; }
			}
			if (op == 8) {
				var operand = program.cfg.core.flow.checked.bindings.program.arena.get_node_operand(row.value.source);
				int from = checked_kind(program.cfg.core.flow.checked, program.cfg.core.flow.checked.uses[operand.index].type); int to = checked_kind(program.cfg.core.flow.checked, row.value.type);
				if ((from == 11 || from == 12) && (to == 11 || to == 12)) {
