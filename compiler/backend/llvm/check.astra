bool llvm_check_operand(void* actual, void*[] values, int expected) {
	return expected > 0 && expected <= len(values) && actual == values[expected - 1];
}
int llvm_check_opcode(string op) {
	if (op == "+") { return 8; } if (op == "-") { return 10; } if (op == "*") { return 12; }
	if (op == "&") { return 23; } if (op == "|") { return 24; } if (op == "^") { return 25; }
	return 0;
}
int llvm_check_predicate(string op, int kind) {
	if (op == "==") { return 32; } if (op == "!=") { return 33; }
	if (type_signed(kind)) { if (op == ">") { return 38; } if (op == ">=") { return 39; } if (op == "<") { return 40; } if (op == "<=") { return 41; } }
	else { if (op == ">") { return 34; } if (op == ">=") { return 35; } if (op == "<") { return 36; } if (op == "<=") { return 37; } }
	return 0;
}
u64 llvm_check_mask(int width) { if (width == 64) { return 18446744073709551615; } return (1 as u64 << width) - 1; }
bool llvm_check_literal(CheckedIndex checked, CoreNode node, void* value, SsaBudget budget) throws Error {
	int kind = checked_kind(checked, node.type);
	if (kind == 11 || kind == 12) {
		if (LLVMIsAConstantFP(value) == null) { return false; }
		var source = checked.bindings.program.arena.token_message(node.token);
		int count = source.text.byte_length; int last = astra_host_text_byte(source.text, count - 1);
		if (last == 100 || last == 68 || last == 102 || last == 70) { count = count - 1; }
		var context = LLVMGetTypeContext(LLVMTypeOf(value));
		void* physical = LLVMFloatTypeInContext(context); if (kind == 12) { physical = LLVMDoubleTypeInContext(context); }
		var expected = llvm13_real(physical, source.text, count);
		if (node.kind == 2) {
			var sign = checked.bindings.program.arena.token_message(node.operation);
			if (sign.text == "-") { expected = LLVMConstReal(physical, -llvm13_real_value(expected)); }
			else { if (sign.text != "+") { return false; } }
		}
		return expected != null && value == expected && budget.take(count);
	}
	if (LLVMIsAConstantInt(value) == null) { return false; }
	var text = checked.bindings.program.arena.token_message(node.token); u64 bits = 0;
	if (node.type.index == 13) { if (text.text == "true") { bits = 1; } }
	else {
		int i = 0; while (i < text.text.byte_length && budget.take(1)) { bits = bits * 10 + (astra_host_text_byte(text.text, i) - 48) as u64; i = i + 1; }
		if (node.kind == 2) { var sign = checked.bindings.program.arena.token_message(node.operation); if (sign.text == "-") { bits = 0 as u64 - bits; } else { if (sign.text == "~") { bits = 18446744073709551615 - bits; } else { if (sign.text != "+") { return false; } } } }
		bits = bits & llvm_check_mask(type_width(node.type.index));
