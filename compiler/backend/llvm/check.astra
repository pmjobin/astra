				while (parameter_place < row.place - 1 && budget.take(1)) { var candidate = program.cfg.core.data.places[parameter_place]; if (candidate.parameter && candidate.parent == 0) { ordinal = ordinal + 1; } parameter_place = parameter_place + 1; }
				if (LLVMGetParam(functions[row.function - 1], ordinal) != actual) { return false; }
