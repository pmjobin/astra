// Independent read-only correspondence queries. These never invoke lowering,
// its scheduling, operand resolver or type constructor. LLVM's verifier follows.
int llvm_check_use(SsaData data, int instruction, int kind, int ordinal, SsaBudget budget) {
	int u = 0;
	while (u < data.use_count && budget.take(1)) { var use = data.uses[u]; if (use.instruction == instruction && use.kind == kind && use.ordinal == ordinal) { return use.value; } u = u + 1; }
	return 0;
}
void* llvm_check_borrow(SsaData data, void*[] places, int id, SsaBudget budget) {
	int steps = 0; int current = id;
	while (current > 0 && steps < 192 && budget.take(1)) {
		var value = data.values[current - 1]; if (value.kind != 1 || value.instruction == 0) { return null; }
		var operation = data.instructions[value.instruction - 1].origin;
		if (operation.opcode == 3 && operation.value.place > 0) { return places[operation.value.place - 1]; }
		if (operation.opcode != 12) { return null; }
		current = llvm_check_use(data, value.instruction, 1, 0, budget); steps = steps + 1;
	}
	return null;
}
bool llvm_check_operand(void* actual, void*[] values, int expected) {
	return expected > 0 && expected <= len(values) && actual == values[expected - 1];
}
int llvm_check_opcode(string op) {
	if (op == "+") { return 8; } if (op == "-") { return 10; } if (op == "*") { return 12; }
	if (op == "&") { return 23; } if (op == "|") { return 24; } if (op == "^") { return 25; }
	return 0;
}
int llvm_check_predicate(string op, int kind) {
	if (op == "==") { return 32; } if (op == "!=") { return 33; }
	if (type_signed(kind)) { if (op == ">") { return 38; } if (op == ">=") { return 39; } if (op == "<") { return 40; } if (op == "<=") { return 41; } }
	else { if (op == ">") { return 34; } if (op == ">=") { return 35; } if (op == "<") { return 36; } if (op == "<=") { return 37; } }
	return 0;
}
u64 llvm_check_mask(int width) { if (width == 64) { return 18446744073709551615; } return (1 as u64 << width) - 1; }
bool llvm_check_literal(CheckedIndex checked, CoreNode node, void* value, SsaBudget budget) throws Error {
	if (LLVMIsAConstantInt(value) == null) { return false; }
	var text = checked.bindings.program.arena.token_message(node.token); u64 bits = 0;
	if (node.type.index == 13) { if (text.text == "true") { bits = 1; } }
	else {
		int i = 0; while (i < text.text.byte_length && budget.take(1)) { bits = bits * 10 + (astra_host_text_byte(text.text, i) - 48) as u64; i = i + 1; }
		if (node.kind == 2) { var sign = checked.bindings.program.arena.token_message(node.operation); if (sign.text == "-") { bits = 0 as u64 - bits; } }
		bits = bits & llvm_check_mask(type_width(node.type.index));
	}
	return LLVMConstIntGetZExtValue(value) == bits && !budget.exhausted;
}
bool llvm_check_binary(CheckedIndex checked, CoreNode node, void* result, void* left, void* right) throws Error {
	var text = checked.bindings.program.arena.token_message(node.operation); var op = text.text;
	var left_node = checked.bindings.program.arena.get_node_left(node.source); var left_use = checked.uses[left_node.index]; int kind = checked_kind(checked, left_use.type);
	int opcode = llvm_check_opcode(op); int predicate = llvm_check_predicate(op, kind);
	if (LLVMIsAInstruction(result) != null && (opcode != 0 || predicate != 0)) {
		if (predicate != 0) { return LLVMGetInstructionOpcode(result) == 42 && LLVMGetICmpPredicate(result) == predicate && LLVMGetOperand(result, 0) == left && LLVMGetOperand(result, 1) == right; }
		return LLVMGetInstructionOpcode(result) == opcode && LLVMGetOperand(result, 0) == left && LLVMGetOperand(result, 1) == right;
	}
	if (LLVMIsAConstantInt(result) != null && LLVMIsAConstantInt(left) != null && LLVMIsAConstantInt(right) != null && (opcode != 0 || predicate != 0)) {
		u64 a = LLVMConstIntGetZExtValue(left); u64 b = LLVMConstIntGetZExtValue(right); u64 expected = 0;
		if (op == "+") { expected = a + b; } if (op == "-") { expected = a - b; } if (op == "*") { expected = a * b; }
		if (op == "&") { expected = a & b; } if (op == "|") { expected = a | b; } if (op == "^") { expected = a ^ b; }
		if (predicate != 0) {
			bool less = a < b;
			if (type_signed(kind)) { u64 sign = 1 as u64 << (type_width(kind) - 1); if ((a & sign) != (b & sign)) { less = (a & sign) != 0; } }
			bool answer = false;
			if (op == "==") { answer = a == b; } if (op == "!=") { answer = a != b; }
			if (op == "<") { answer = less; } if (op == "<=") { answer = less || a == b; }
			if (op == ">") { answer = !less && a != b; } if (op == ">=") { answer = !less; }
			if (answer) { expected = 1; }
		} else { expected = expected & llvm_check_mask(type_width(kind)); }
		return LLVMConstIntGetZExtValue(result) == expected;
	}
	// Guarded division/shift recipes have several machine instructions. Their
	// exact sequence is sealed after construction; independent runtime and IR
	// guard inspection cover arithmetic domain/fatal behavior, not this shortcut.
	return op == "/" || op == "%" || op == "<<" || op == ">>";
}
bool llvm_check(SsaProgram program, void*[] types, void*[] functions, void*[] signatures, void*[] blocks, void*[] ends, void*[] edges, void*[] values, void*[] places, void*[] effects, int limit) throws Error {
	var budget = new SsaBudget(limit);
	int f = 0;
	while (f < program.data.function_count && budget.take(1)) { if (LLVMGetEntryBasicBlock(functions[f]) != blocks[program.data.functions[f].entry - 1]) { return false; } f = f + 1; }
	int b = 0;
	while (b < program.data.block_count && budget.take(1)) {
		var block = program.data.blocks[b].origin;
		if (program.data.graph.reachable[b]) {
			if (blocks[b] == null || ends[b] == null || LLVMGetBasicBlockParent(blocks[b]) != functions[block.function - 1] || LLVMGetBasicBlockParent(ends[b]) != functions[block.function - 1]) { return false; }
			var term = LLVMGetBasicBlockTerminator(ends[b]); if (term == null) { return false; }
			if (block.term == 3) {
				int expected = 0; int u = 0;
				while (u < program.data.use_count && budget.take(1)) { var use = program.data.uses[u]; if (use.block == b + 1 && use.kind == 5) { expected = use.value; } u = u + 1; }
				if (LLVMGetInstructionOpcode(term) != 1 || LLVMGetNumOperands(term) != 0 && expected == 0) { return false; }
				if (expected != 0 && !llvm_check_operand(LLVMGetOperand(term, 0), values, expected)) { return false; }
			} else {
				if (block.term == 4) { if (LLVMGetInstructionOpcode(term) != 7) { return false; } }
				else {
					if (LLVMGetInstructionOpcode(term) != 2 || LLVMGetNumSuccessors(term) != block.term) { return false; }
					int e = 0;
					while (e < program.data.edge_count && budget.take(1)) {
						var edge = program.data.edges[e].origin;
						if (edge.source == b + 1) {
							int index = 0; if (edge.polarity == 2) { index = 1; }
							if (LLVMGetSuccessor(term, index) != edges[e]) { return false; }
							var jump = LLVMGetBasicBlockTerminator(edges[e]);
							if (jump == null || LLVMGetNumSuccessors(jump) != 1 || LLVMGetSuccessor(jump, 0) != blocks[edge.target - 1]) { return false; }
						}
						e = e + 1;
					}
				}
			}
		}
		b = b + 1;
	}
	int v = 0;
	while (v < program.data.value_count && budget.take(1)) {
		var row = program.data.values[v];
		if (program.data.graph.reachable[row.block - 1]) {
			var actual = values[v]; if (actual == null) { return false; }
			var expected_type = types[row.type.index];
			if ((row.flags & 2) != 0 && checked_kind(program.cfg.core.flow.checked, row.type) == 30) { expected_type = LLVMPointerTypeInContext(LLVMGetTypeContext(expected_type), 0); }
			if (LLVMTypeOf(actual) != expected_type) { return false; }
			if (row.kind == 3) {
				if (LLVMIsAInstruction(actual) == null || LLVMGetInstructionOpcode(actual) != 44 || LLVMGetInstructionParent(actual) != blocks[row.block - 1]) { return false; }
				int count = 0; int a = 0;
				while (a < program.data.argument_count && budget.take(1)) {
					var arg = program.data.arguments[a];
					if (arg.phi == v + 1 && arg.value != 0) { if (count >= LLVMCountIncoming(actual) || LLVMGetIncomingValue(actual, count) != values[arg.value - 1] || LLVMGetIncomingBlock(actual, count) != edges[arg.edge - 1]) { return false; } count = count + 1; }
					a = a + 1;
				}
				if (count != LLVMCountIncoming(actual)) { return false; }
			}
		}
		v = v + 1;
	}
	int i = 0;
	while (i < program.data.instruction_count && budget.take(1)) {
		var instruction = program.data.instructions[i]; var row = instruction.origin; int op = row.opcode;
		if (program.data.graph.reachable[row.block - 1]) {
			void* result = null; if (instruction.result > 0) { result = values[instruction.result - 1]; }
			if ((op == 1 || op == 2) && !llvm_check_literal(program.cfg.core.flow.checked, row.value, result, budget)) { return false; }
			if (op == 3 && instruction.promoted) { int use = llvm_check_use(program.data, i + 1, 4, 0, budget); if (!llvm_check_operand(result, values, use)) { return false; } }
			if ((op == 3 && !instruction.promoted || op == 4) && (row.value.flags & 2) == 0) { if (LLVMIsAInstruction(result) == null || LLVMGetInstructionOpcode(result) != 27 || LLVMGetOperand(result, 0) != places[row.value.place - 1]) { return false; } }
			if (op == 6) {
				int a = llvm_check_use(program.data, i + 1, 1, 0, budget); int z = llvm_check_use(program.data, i + 1, 2, 0, budget);
				if (a < 1 || z < 1 || !llvm_check_binary(program.cfg.core.flow.checked, row.value, result, values[a - 1], values[z - 1])) { return false; }
			}
			if (op == 12 || op == 44 || op == 21 || op == 22) { int a = llvm_check_use(program.data, i + 1, 1, 0, budget); if (!llvm_check_operand(result, values, a) && instruction.result != 0) { return false; } }
			if ((op == 21 || op == 22) && !instruction.promoted) {
				var store = effects[i]; int a = llvm_check_use(program.data, i + 1, 1, 0, budget);
				if (store == null || LLVMGetInstructionOpcode(store) != 28 || LLVMGetOperand(store, 1) != places[row.value.place - 1] || !llvm_check_operand(LLVMGetOperand(store, 0), values, a)) { return false; }
			}
			if (op == 9) {
				int target = -1; int c = 0; while (c < program.data.function_count && budget.take(1)) { if (program.cfg.core.data.functions[c].symbol.index == row.value.symbol.index) { target = c; } c = c + 1; }
				if (target < 0 || LLVMIsAInstruction(result) == null || LLVMGetInstructionOpcode(result) != 45 || LLVMGetCalledValue(result) != functions[target] || LLVMGetNumArgOperands(result) != row.value.count || LLVMGetInstructionCallConv(result) != 0) { return false; }
				int a = 0; var signature = program.cfg.core.flow.checked.signatures[row.value.signature.index - 1];
				while (a < row.value.count && budget.take(1)) {
					int use = llvm_check_use(program.data, i + 1, 3, a, budget); var parameter = program.cfg.core.flow.checked.types.argument(program.cfg.core.flow.checked.types, signature.callable, a + 1);
					if ((parameter.flags & 2) != 0) { var pointer = llvm_check_borrow(program.data, places, use, budget); if (pointer == null || LLVMGetArgOperand(result, a) != pointer) { return false; } }
					else { if (!llvm_check_operand(LLVMGetArgOperand(result, a), values, use)) { return false; } }
					a = a + 1;
				}
			}
		}
		i = i + 1;
	}
	return !budget.exhausted;
}
