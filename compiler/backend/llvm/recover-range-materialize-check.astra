// Independently consume the complete arithmetic and loop bodies. Cardinality
// and the final allocation are separate from the copied lazy source carrier.
bool recover_range_plain_binary(void* value, int opcode, void* left, void* right) {
	if (value == null || LLVMIsAInstruction(value) == null || LLVMGetInstructionOpcode(value) != opcode || LLVMGetNumOperands(value) != 2 || LLVMGetOperand(value, 0) != left || LLVMGetOperand(value, 1) != right || LLVMHasMetadata(value) != 0) return false;
	if (opcode == 8 || opcode == 10) return LLVMGetNUW(value) == 0 && LLVMGetNSW(value) == 0;
	if (opcode == 14) return LLVMGetExact(value) == 0;
	return opcode == 17;
}

bool recover_range_plain_cast(void* value, int opcode, void* input, int width) {
	if (value == null || LLVMIsAInstruction(value) == null || LLVMGetInstructionOpcode(value) != opcode || LLVMGetNumOperands(value) != 1 || LLVMGetOperand(value, 0) != input || LLVMGetTypeKind(LLVMTypeOf(value)) != 8 || LLVMGetIntTypeWidth(LLVMTypeOf(value)) != width || LLVMHasMetadata(value) != 0) return false;
	return opcode != 31 || LLVMGetNNeg(value) == 0;
}

bool recover_range_select(void* value, void* condition, void* yes, void* no) {
	return value != null && LLVMIsAInstruction(value) != null && LLVMGetInstructionOpcode(value) == 46 && LLVMGetNumOperands(value) == 3 && LLVMGetOperand(value, 0) == condition && LLVMGetOperand(value, 1) == yes && LLVMGetOperand(value, 2) == no && LLVMHasMetadata(value) == 0;
}

bool recover_range_count_verified(void* function, int kind, void* module) throws Error {
	if (!type_integer(kind) || !recover_llvm_helper_signature(function, 4) || LLVMGetGlobalParent(function) != module) return false;
	var name = llvm_name("astra.range.count.", kind - 1); if (llvm13_named(function, name.text) != 1) return false;
	var start = LLVMGetParam(function, 0); var end = LLVMGetParam(function, 1); var inclusive = LLVMGetParam(function, 2); var step = LLVMGetParam(function, 3); var integer = LLVMTypeOf(start);
	if (LLVMGetTypeKind(integer) != 8 || LLVMGetIntTypeWidth(integer) != type_width(kind) || LLVMTypeOf(end) != integer || LLVMTypeOf(step) != integer || LLVMGetTypeKind(LLVMTypeOf(inclusive)) != 8 || LLVMGetIntTypeWidth(LLVMTypeOf(inclusive)) != 1) return false;
	var result_type = LLVMGetReturnType(LLVMGlobalGetValueType(function)); if (LLVMGetTypeKind(result_type) != 8 || LLVMGetIntTypeWidth(result_type) != 32) return false;
	var blocks = recover_llvm_helper_blocks(function, 6); if (len(blocks) != 6) return false;
	var entry = recover_llvm_body(blocks[0], 2); var bounds = recover_llvm_body(blocks[1], 4); var vacant = recover_llvm_body(blocks[2], 1); var valid = recover_llvm_body(blocks[4], 3); var fatal = recover_llvm_body(blocks[5], 2);
	if (len(entry) != 2 || len(bounds) != 4 || len(vacant) != 1 || len(valid) != 3 || len(fatal) != 2) return false;
	int invalid = 32; int greater = 34; int at_least = 35; if (type_signed(kind)) {
		invalid = 41;
		greater = 38;
		at_least = 39;
	}
	if (LLVMGetInstructionOpcode(entry[0]) != 42 || !recover_llvm_compare(entry[0], invalid, step, LLVMConstNull(integer)) || !recover_llvm_split(entry[1], entry[0], blocks[5], blocks[1])) return false;
	if (LLVMGetInstructionOpcode(bounds[0]) != 42 || LLVMGetInstructionOpcode(bounds[1]) != 42 || !recover_llvm_compare(bounds[0], greater, start, end) || !recover_llvm_compare(bounds[1], at_least, start, end) || !recover_range_select(bounds[2], inclusive, bounds[0], bounds[1]) || !recover_llvm_split(bounds[3], bounds[2], blocks[2], blocks[3]) || !recover_llvm_return(vacant[0], LLVMConstNull(result_type))) return false;
	int count = 9; if (type_width(kind) < 64) count = count + 2;
	var body = recover_llvm_body(blocks[3], count); if (len(body) != count || !recover_range_plain_binary(body[0], 10, end, start)) return false;
	void* distance = body[0]; void* stride = step; int at = 1;
	if (type_width(kind) < 64) {
		if (!recover_range_plain_cast(body[1], 31, body[0], 64) || !recover_range_plain_cast(body[2], 31, step, 64)) return false;
		distance = body[1]; stride = body[2]; at = 3;
	}
	var quotient = body[at]; var remainder = body[at + 1]; var partial = body[at + 2]; var extra_bit = body[at + 3]; var extra = body[at + 4]; var limit = body[at + 5]; var fits = body[at + 6];
	if (!recover_range_plain_binary(quotient, 14, distance, stride) || !recover_range_plain_binary(remainder, 17, distance, stride) || LLVMGetInstructionOpcode(partial) != 42 || !recover_llvm_compare(partial, 33, remainder, LLVMConstNull(LLVMTypeOf(remainder))) || !recover_range_select(extra_bit, inclusive, LLVMConstInt(LLVMTypeOf(inclusive), 1, 0), partial) || !recover_range_plain_cast(extra, 31, extra_bit, 64)) return false;
	var wide = LLVMTypeOf(extra);
	if (!recover_range_plain_binary(limit, 10, LLVMConstInt(wide, 2147483647, 0), extra) || LLVMGetInstructionOpcode(fits) != 42 || !recover_llvm_compare(fits, 37, quotient, limit) || !recover_llvm_split(body[at + 7], fits, blocks[4], blocks[5])) return false;
	if (!recover_range_plain_binary(valid[0], 8, quotient, extra) || !recover_range_plain_cast(valid[1], 30, valid[0], 32) || !recover_llvm_return(valid[2], valid[1])) return false;
	if (LLVMGetInstructionOpcode(fatal[0]) != 45 || !recover_llvm_external_verified(LLVMGetCalledValue(fatal[0]), 4) || LLVMGetGlobalParent(LLVMGetCalledValue(fatal[0])) != module || !recover_llvm_call(fatal[0], LLVMGetCalledValue(fatal[0]), 0, 0) || LLVMGetInstructionOpcode(fatal[1]) != 7) return false;
	int b = 0;
	while (b < len(blocks)) {
		var instruction = LLVMGetFirstInstruction(blocks[b]);
		while (instruction != null) {
			if (LLVMHasMetadata(instruction) != 0 || LLVMGetInstructionOpcode(instruction) == 42 && LLVMGetICmpSameSign(instruction) != 0) return false;
			instruction = LLVMGetNextInstruction(instruction);
		}
