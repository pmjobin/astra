bool recover_range_fill_verified(void* function, int kind, void* module, void* layout) throws Error {
	if (!type_integer(kind) || !recover_llvm_helper_signature(function, 4) || LLVMGetGlobalParent(function) != module) return false;
	var name = llvm_name("astra.range.fill.", kind - 1); if (llvm13_named(function, name.text) != 1) return false;
	var pointer = LLVMGetParam(function, 0); var count = LLVMGetParam(function, 1); var start = LLVMGetParam(function, 2); var step = LLVMGetParam(function, 3); var integer = LLVMTypeOf(start);
	if (!recover_shared_pointer(LLVMTypeOf(pointer)) || LLVMGetTypeKind(LLVMTypeOf(count)) != 8 || LLVMGetIntTypeWidth(LLVMTypeOf(count)) != 32 || LLVMGetTypeKind(integer) != 8 || LLVMGetIntTypeWidth(integer) != type_width(kind) || LLVMTypeOf(step) != integer || LLVMGetTypeKind(LLVMGetReturnType(LLVMGlobalGetValueType(function))) != 0) return false;
	var blocks = recover_llvm_helper_blocks(function, 5); if (len(blocks) != 5) return false;
	var entry = recover_llvm_body(blocks[0], 1); var header = recover_llvm_body(blocks[1], 4); var body = recover_llvm_body(blocks[2], 5); var advance = recover_llvm_body(blocks[3], 2); var done = recover_llvm_body(blocks[4], 1);
	if (len(entry) != 1 || len(header) != 4 || len(body) != 5 || len(advance) != 2 || len(done) != 1 || !recover_llvm_jump(entry[0], blocks[1])) return false;
	var index = header[0]; var value = header[1];
	if (LLVMGetInstructionOpcode(index) != 44 || LLVMGetInstructionOpcode(value) != 44 || LLVMCountIncoming(index) != 2 || LLVMCountIncoming(value) != 2 || LLVMTypeOf(index) != LLVMTypeOf(count) || LLVMTypeOf(value) != integer) return false;
	if (!recover_llvm_bits(LLVMGetIncomingValue(index, 0), 32, 0) || LLVMGetIncomingBlock(index, 0) != blocks[0] || LLVMGetIncomingValue(index, 1) != body[2] || LLVMGetIncomingBlock(index, 1) != blocks[3] || LLVMGetIncomingValue(value, 0) != start || LLVMGetIncomingBlock(value, 0) != blocks[0] || LLVMGetIncomingValue(value, 1) != advance[0] || LLVMGetIncomingBlock(value, 1) != blocks[3]) return false;
	if (LLVMGetInstructionOpcode(header[2]) != 42 || !recover_llvm_compare(header[2], 40, index, count) || !recover_llvm_split(header[3], header[2], blocks[2], blocks[4])) return false;
	if (LLVMGetInstructionOpcode(body[0]) != 29 || LLVMGetGEPSourceElementType(body[0]) != integer || LLVMGEPGetNoWrapFlags(body[0]) != 0 || LLVMGetNumOperands(body[0]) != 2 || LLVMGetOperand(body[0], 0) != pointer || LLVMGetOperand(body[0], 1) != index || !recover_enum_store_verified(body[1], value, body[0], LLVMABIAlignmentOfType(layout, integer))) return false;
	if (!recover_range_plain_binary(body[2], 8, index, LLVMConstInt(LLVMTypeOf(count), 1, 0)) || LLVMGetInstructionOpcode(body[3]) != 42 || !recover_llvm_compare(body[3], 40, body[2], count) || !recover_llvm_split(body[4], body[3], blocks[3], blocks[4]) || !recover_range_plain_binary(advance[0], 8, value, step) || !recover_llvm_jump(advance[1], blocks[1]) || !recover_llvm_void_return(done[0])) return false;
	int b = 0;
	while (b < len(blocks)) {
		var instruction = LLVMGetFirstInstruction(blocks[b]);
		while (instruction != null) {
			if (LLVMHasMetadata(instruction) != 0 || LLVMGetInstructionOpcode(instruction) == 42 && LLVMGetICmpSameSign(instruction) != 0) return false;
			instruction = LLVMGetNextInstruction(instruction);
		}
		b = b + 1;
	}
	return true;
}

int recover_range_collection_instruction(RecoverSsa ssa, RecoverNode row, void* physical, void* operation, void* value, void* aggregate, void* buffer_function, void* module, void* layout) throws Error {
	if (row.kind != 94 || !range_collect_verified(ssa.cfg.core.flow.checked, row.source) || operation == null || LLVMIsAInstruction(operation) == null || LLVMGetInstructionOpcode(operation) != 45 || LLVMGetInstructionParent(operation) != physical || LLVMGetNumArgOperands(operation) != 4) return 0;
	var receiver = range_query_receiver(ssa.cfg.core.flow.checked, row.source);
	if (aggregate == null || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, receiver, LLVMTypeOf(aggregate))) return 0;
	var element = ssa.cfg.core.flow.checked.types.argument(ssa.cfg.core.flow.checked.types, receiver, 0).type; int kind = checked_kind(ssa.cfg.core.flow.checked, element);
	var fill = LLVMGetCalledValue(operation);
	if (!recover_range_fill_verified(fill, kind, module, layout) || !recover_llvm_call(operation, fill, 4, 8)) return 0;
	var allocation = LLVMGetArgOperand(operation, 0); var count = LLVMGetArgOperand(operation, 1);
	if (!recover_llvm_call(allocation, buffer_function, 2, 8) || LLVMGetInstructionParent(allocation) != physical || LLVMGetArgOperand(allocation, 0) != count || !recover_llvm_bits(LLVMGetArgOperand(allocation, 1), 64, (type_width(kind) / 8) as u64) || count == null || LLVMIsAInstruction(count) == null || LLVMGetInstructionOpcode(count) != 45 || LLVMGetInstructionParent(count) != physical || LLVMGetNumArgOperands(count) != 4) return 0;
	var measure = LLVMGetCalledValue(count);
	if (!recover_range_count_verified(measure, kind, module) || !recover_llvm_call(count, measure, 4, 8) || LLVMGetNextInstruction(count) != allocation || LLVMGetNextInstruction(allocation) != operation) return 0;
	int fields = 3; if (range_stride_type_verified(ssa.cfg.core.flow.checked.types, receiver)) fields = 4;
	int instructions = 6; int field = 0; void* previous = null;
	while (field < fields) {
		var actual = LLVMGetArgOperand(count, field);
		if (!recover_llvm_extract(actual, aggregate, field)) return 0;
		if (LLVMIsAInstruction(aggregate) != null) {
			if (LLVMIsAInstruction(actual) == null || LLVMGetInstructionParent(actual) != physical || LLVMHasMetadata(actual) != 0 || previous != null && LLVMGetNextInstruction(previous) != actual) return 0;
			previous = actual; instructions = instructions + 1;
		} else {
			if (LLVMIsAInstruction(actual) != null) return 0;
		}
		field = field + 1;
	}
	if (previous != null && LLVMGetNextInstruction(previous) != count) return 0;
	if (fields == 3 && !recover_llvm_bits(LLVMGetArgOperand(count, 3), type_width(kind), 1)) return 0;
	if (LLVMGetArgOperand(operation, 2) != LLVMGetArgOperand(count, 0) || LLVMGetArgOperand(operation, 3) != LLVMGetArgOperand(count, 3)) return 0;
	if (value == null || LLVMIsAInstruction(value) == null || LLVMGetInstructionOpcode(value) != 54 || LLVMGetInstructionParent(value) != physical || !recover_storage_llvm_type(ssa.cfg.core.flow.checked, row.type, LLVMTypeOf(value))) return 0;
	var initial = LLVMGetOperand(value, 0);
	if (initial == null || LLVMIsAInstruction(initial) == null || LLVMGetInstructionOpcode(initial) != 54 || LLVMGetInstructionParent(initial) != physical || !recover_llvm_insert(value, initial, count, 1) || !recover_llvm_insert(initial, LLVMGetOperand(initial, 0), allocation, 0) || LLVMIsNull(LLVMGetOperand(initial, 0)) == 0 || LLVMGetNextInstruction(operation) != initial || LLVMGetNextInstruction(initial) != value || LLVMGetNextInstruction(value) != LLVMGetBasicBlockTerminator(physical)) return 0;
	if (LLVMHasMetadata(count) != 0 || LLVMHasMetadata(allocation) != 0 || LLVMHasMetadata(operation) != 0 || LLVMHasMetadata(initial) != 0 || LLVMHasMetadata(value) != 0) return 0;
	return instructions;
