// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Independent physical bounds consumers: exact argument identities, guards,
// instruction inventories, and flag-free pointer arithmetic after validation.
bool recover_array_helper_signature(void* function, int parameters, string name, void* element, bool record) {
	if (!recover_llvm_helper_signature(function, parameters) || llvm13_named(function, name) != 1 || !recover_shared_pointer(LLVMTypeOf(LLVMGetParam(function, 0)))) return false;
	int p = 1;
	while (p < parameters) {
		var type = LLVMTypeOf(LLVMGetParam(function, p));
		if (LLVMGetTypeKind(type) != 8 || LLVMGetIntTypeWidth(type) != 32) return false;
		p = p + 1;
	}
	int kind = LLVMGetTypeKind(element);
	if (record) {
		if (kind != 10 || LLVMIsPackedStruct(element) != 0 || LLVMCountStructElementTypes(element) == 0) return false;
	} else {
		if (kind != 8 && kind != 2 && kind != 3) return false;
	}
	if (kind == 8) {
		int width = LLVMGetIntTypeWidth(element);
		if (width != 1 && width != 8 && width != 16 && width != 32 && width != 64) return false;
	}
	var block = LLVMGetFirstBasicBlock(function);
	int remaining = 64;
	while (block != null) {
		if (remaining == 0) return false;
		remaining = remaining - 1;
		var instruction = LLVMGetFirstInstruction(block);
		while (instruction != null) {
			if (remaining == 0 || LLVMHasMetadata(instruction) != 0 || LLVMGetInstructionOpcode(instruction) == 42 && LLVMGetICmpSameSign(instruction) != 0) return false;
			remaining = remaining - 1;
			instruction = LLVMGetNextInstruction(instruction);
		}
		block = LLVMGetNextBasicBlock(block);
	}
	return true;
}

bool recover_array_constant_compare(void* instruction, int predicate, void* input, int bits) {
	return LLVMGetInstructionOpcode(instruction) == 42 && LLVMGetICmpPredicate(instruction) == predicate && LLVMGetOperand(instruction, 0) == input && recover_llvm_bits(LLVMGetOperand(instruction, 1), 32, bits as u64);
}

bool recover_array_boolean(void* instruction, int opcode, void* left, void* right) {
	return LLVMGetInstructionOpcode(instruction) == opcode && LLVMGetOperand(instruction, 0) == left && LLVMGetOperand(instruction, 1) == right;
}

bool recover_array_address(void* address, void* element, void* backing, void* index) {
	return LLVMGetInstructionOpcode(address) == 29 && LLVMGetNumOperands(address) == 2 && LLVMGetGEPSourceElementType(address) == element && LLVMGetOperand(address, 0) == backing && LLVMGetOperand(address, 1) == index && LLVMGEPGetNoWrapFlags(address) == 0;
}

bool recover_array_fatal(void* block, void* trap) {
	var instructions = recover_llvm_body(block, 2);
	return len(instructions) == 2 && recover_llvm_call(instructions[0], trap, 0, 0) && recover_llvm_native_attributes(instructions[0], 0) && LLVMGetInstructionOpcode(instructions[1]) == 7;
}

bool recover_array_index_helper(void* function, void* element, string name, void* trap, bool record) {
	if (!recover_array_helper_signature(function, 3, name, element, record) || !recover_shared_pointer(LLVMGetReturnType(LLVMGlobalGetValueType(function)))) return false;
	var blocks = recover_llvm_helper_blocks(function, 3);
	if (len(blocks) != 3) return false;
	var entry = recover_llvm_body(blocks[0], 8);
	var valid = recover_llvm_body(blocks[2], 2);
	if (len(entry) != 8 || len(valid) != 2 || !recover_array_fatal(blocks[1], trap)) return false;
	var pointer = LLVMGetParam(function, 0);
	var count = LLVMGetParam(function, 1);
	var index = LLVMGetParam(function, 2);
	if (LLVMGetInstructionOpcode(entry[0]) != 42 || LLVMGetICmpPredicate(entry[0]) != 33 || LLVMGetOperand(entry[0], 0) != pointer || LLVMIsNull(LLVMGetOperand(entry[0], 1)) == 0) return false;
	return recover_array_constant_compare(entry[1], 39, count, 0) && recover_array_constant_compare(entry[2], 39, index, 0) && recover_llvm_compare(entry[3], 40, index, count) && recover_array_boolean(entry[4], 23, entry[0], entry[1]) && recover_array_boolean(entry[5], 23, entry[2], entry[3]) && recover_array_boolean(entry[6], 23, entry[4], entry[5]) && recover_llvm_split(entry[7], entry[6], blocks[2], blocks[1]) && recover_array_address(valid[0], element, pointer, index) && recover_llvm_return(valid[1], valid[0]);
}

bool recover_array_slice_helper(void* function, void* element, void* descriptor, string name, void* trap) {
	if (!recover_array_helper_signature(function, 4, name, element, false) || LLVMGetReturnType(LLVMGlobalGetValueType(function)) != descriptor || LLVMGetTypeKind(descriptor) != 10 || LLVMIsPackedStruct(descriptor) != 0 || LLVMCountStructElementTypes(descriptor) != 2 || !recover_shared_pointer(LLVMStructGetTypeAtIndex(descriptor, 0)) || LLVMGetTypeKind(LLVMStructGetTypeAtIndex(descriptor, 1)) != 8 || LLVMGetIntTypeWidth(LLVMStructGetTypeAtIndex(descriptor, 1)) != 32) return false;
	var blocks = recover_llvm_helper_blocks(function, 3);
	if (len(blocks) != 3) return false;
	var entry = recover_llvm_body(blocks[0], 15);
	var valid = recover_llvm_body(blocks[2], 4);
	if (len(entry) != 15 || len(valid) != 4 || !recover_array_fatal(blocks[1], trap)) return false;
	var pointer = LLVMGetParam(function, 0);
	var count = LLVMGetParam(function, 1);
	var start = LLVMGetParam(function, 2);
	var length = LLVMGetParam(function, 3);
	if (!recover_array_constant_compare(entry[0], 39, count, 0) || !recover_array_constant_compare(entry[1], 39, start, 0) || !recover_array_constant_compare(entry[2], 39, length, 0) || !recover_llvm_compare(entry[3], 41, start, count) || LLVMGetInstructionOpcode(entry[4]) != 10 || LLVMGetOperand(entry[4], 0) != count || LLVMGetOperand(entry[4], 1) != start || LLVMGetNSW(entry[4]) != 0 || LLVMGetNUW(entry[4]) != 0 || !recover_llvm_compare(entry[5], 41, length, entry[4])) return false;
	if (LLVMGetInstructionOpcode(entry[6]) != 42 || LLVMGetICmpPredicate(entry[6]) != 33 || LLVMGetOperand(entry[6], 0) != pointer || LLVMIsNull(LLVMGetOperand(entry[6], 1)) == 0 || !recover_array_constant_compare(entry[7], 32, count, 0) || !recover_array_boolean(entry[8], 24, entry[6], entry[7])) return false;
	if (!recover_array_boolean(entry[9], 23, entry[0], entry[1]) || !recover_array_boolean(entry[10], 23, entry[2], entry[3]) || !recover_array_boolean(entry[11], 23, entry[5], entry[8]) || !recover_array_boolean(entry[12], 23, entry[9], entry[10]) || !recover_array_boolean(entry[13], 23, entry[12], entry[11]) || !recover_llvm_split(entry[14], entry[13], blocks[2], blocks[1])) return false;
	return recover_array_address(valid[0], element, pointer, start) && recover_llvm_insert(valid[1], LLVMGetOperand(valid[1], 0), valid[0], 0) && LLVMIsNull(LLVMGetOperand(valid[1], 0)) != 0 && recover_llvm_insert(valid[2], valid[1], length, 1) && recover_llvm_return(valid[3], valid[2]);
}
