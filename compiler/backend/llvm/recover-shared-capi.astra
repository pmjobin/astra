// LLVM23 C APIs for the independently checked Shared control block.
extern(C) void LLVMSetOrdering(void* instruction, int ordering);

extern(C) int LLVMGetOrdering(void* instruction);

extern(C) void* LLVMBuildAtomicCmpXchg(void* builder, void* address, void* expected, void* replacement, int success, int failure, int single_thread);

extern(C) int LLVMGetCmpXchgSuccessOrdering(void* instruction);

extern(C) int LLVMGetCmpXchgFailureOrdering(void* instruction);

extern(C) int LLVMGetWeak(void* instruction);

extern(C) int LLVMIsAtomicSingleThread(void* instruction);

extern(C) int LLVMHasMetadata(void* instruction);

extern(C) int LLVMGetICmpSameSign(void* instruction);
