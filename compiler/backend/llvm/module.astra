					int caller = 0;
					while (caller < len(this.functions)) {
						var block = LLVMGetFirstBasicBlock(this.functions[caller]);
						while (block != null) {
							var instruction = LLVMGetFirstInstruction(block);
							while (instruction != null) {
								if (LLVMGetInstructionOpcode(instruction) == 45 && LLVMGetCalledValue(instruction) == this.functions[f]) {
									var receiver = LLVMGetArgOperand(instruction, 0); LLVMSetOperand(instruction, 0, LLVMConstNull(LLVMTypeOf(receiver))); return true;
								}
								instruction = LLVMGetNextInstruction(instruction);
							}
							block = LLVMGetNextBasicBlock(block);
						}
						caller = caller + 1;
					}
				}
				f = f + 1;
			}
		}
		if (category == 43) {
			int i = 0;
			while (i < len(this.retirements)) {
				var call = this.retirements[i];
				if (call != null && LLVMGetInstructionOpcode(LLVMGetArgOperand(call, 0)) == 27) {
					LLVMSetOperand(this.retirement_guards[i], 0, llvm_integer_constant(LLVMIntTypeInContext(this.context, 1), 0, 0)); return true;
				}
				i = i + 1;
			}
		}
		if (category == 33 && len(this.types) > 11 && this.types[11] != null) {
			this.types[11] = LLVMIntTypeInContext(this.context, 32);
			return true;
		}
		if (category == 38) {
			int i = 0; while (i < len(this.numeric_guards)) {
				var branch = this.numeric_guards[i];
				if (branch != null && LLVMIsAInstruction(LLVMGetOperand(branch, 0)) != null) {
					LLVMSetOperand(branch, 0, llvm_integer_constant(LLVMIntTypeInContext(this.context, 1), 0, 0));
					return true;
				}
				i = i + 1;
			}
			return false;
		}
		if (category == 27 || category == 28 || category == 35) {
			int i = 0;
			while (i < len(this.retirements)) {
				if (this.retirement_modes[i] == 22 && this.retirements[i] != null) {
					var call = this.retirements[i];
					if (category == 28) {
						LLVMInstructionEraseFromParent(call);
						return true;
