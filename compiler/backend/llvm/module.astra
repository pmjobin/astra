					var ordinal = LLVMGetOperand(count, 2);
					LLVMSetOperand(count, 2, llvm_integer_constant(LLVMTypeOf(ordinal), 2, 0));
					return true;
				}
				var block = entry;
				while (block != null) {
					var instruction = LLVMGetFirstInstruction(block);
					while (instruction != null) {
						int opcode = LLVMGetInstructionOpcode(instruction);
						if (action == 1 && opcode == 45 && llvm13_named(LLVMGetCalledValue(instruction), "calloc") == 1) {
							if (category == 70) {
								var stride = LLVMGetArgOperand(instruction, 1);
								LLVMSetOperand(instruction, 1, llvm_integer_constant(LLVMTypeOf(stride), 4, 0));
								return true;
							}
							if (category == 71) {
								var condition = LLVMGetNextInstruction(instruction);
								var branch = LLVMGetNextInstruction(condition);
								LLVMSetSuccessor(branch, 0, LLVMGetSuccessor(branch, 1));
								return true;
							}
						}
						if (action == 2 && category == 72 && opcode == 28 && LLVMGetTypeKind(LLVMTypeOf(LLVMGetOperand(instruction, 0))) == 8) {
							LLVMInstructionEraseFromParent(instruction);
							return true;
						}
