	void* slot_address(void* backing, void* index) throws Error {
		var indices = new void*[1]; indices[0] = index;
		var address = LLVMBuildGEP2(this.builder, LLVMPointerTypeInContext(this.context, 0), backing, this.handle_args(indices, 0), 1, this.empty); LLVMGEPSetNoWrapFlags(address, 0); return address;
