			var element = checked.types.argument(checked.types, id, 0);
			if (!type_numeric(checked_kind(checked, element.type)) && element.type.index != 13 && !(checked.class_storage && checked_kind(checked, element.type) == 30 && !checked_record_owned(checked, element.type, 0) && class_storage_record_verified(checked, element.type))) {
				throw new Error("LLVM_DEFERRED: buffer element");
			}
			var fields = new void*[2]; fields[0] = LLVMPointerTypeInContext(this.context, 0); fields[1] = LLVMIntTypeInContext(this.context, 32);
			result = LLVMStructTypeInContext(this.context, this.handle_args(fields, 0), 2, 0);
		}
