			t = t + 1;
		}
	}

	// Class projections must be materialized at the use, after the current
	// handle has been initialized or transferred. Entry-time payload loads
	// would cache an uninitialized or stale object address across loop rearm.
	void* address(SsaProgram program, int place, void* function, int depth) throws Error {
		this.take(1);
		if (place < 1 || place > len(this.places) || depth > 64) {
			throw new Error("LLVM_INVALID_IR: storage address");
		}
		if (!llvm_storage_projection(program.cfg.core.data, program.cfg.core.flow.checked, place)) return this.places[place - 1];
		var row = program.cfg.core.data.places[place - 1]; var parent = program.cfg.core.data.places[row.parent - 1];
		var base = this.address(program, row.parent, function, depth + 1); var physical = this.type(program.cfg.core.flow.checked, parent.type, 0);
		if (checked_kind(program.cfg.core.flow.checked, parent.type) == 31) {
			base = LLVMBuildLoad2(this.builder, physical, base, this.empty);
			var missing = LLVMBuildICmp(this.builder, 32, base, LLVMConstNull(physical), this.empty); this.guard(missing, function);
