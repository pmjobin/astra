	}

	void close() {
		this.complete = false; this.disposed = true;
		this.abi.close();
		if (this.seal != null) {
			LLVMDisposeMessage(this.seal);
			this.seal = null;
		}
		if (this.handles != null) {
			llvm12_handles_dispose(this.handles);
			this.handles = null;
		}
		if (this.layout != null) {
			LLVMDisposeTargetData(this.layout);
			this.layout = null;
		}
		if (this.builder != null) {
			LLVMDisposeBuilder(this.builder);
			this.builder = null;
		}
		if (this.machine != null) {
			LLVMDisposeTargetMachine(this.machine);
			this.machine = null;
		}
		if (this.module != null) {
			LLVMDisposeModule(this.module);
			this.module = null;
		}
		if (this.context != null) {
			LLVMContextDispose(this.context);
			this.context = null;
		}
	}

	deinit() { this.close(); }

	void* type(CheckedIndex checked, TypeId id, int depth) throws Error {
