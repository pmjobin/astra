			}
		}
		if (category == 41) {
			int i = 0;
			while (i < len(this.values)) {
				var value = this.values[i];
				if (value != null && LLVMIsAInstruction(value) != null && LLVMGetInstructionOpcode(value) == 45 && llvm13_named(LLVMGetCalledValue(value), "calloc") == 1 && LLVMGetTypeKind(LLVMTypeOf(value)) == 12) {
					var width = LLVMGetArgOperand(value, 1); LLVMSetOperand(value, 1, llvm_integer_constant(LLVMTypeOf(width), 2, 0)); return true;
				}
