	void storage_types(CheckedIndex checked) throws Error {
		if (!checked.class_storage) return;
		int t = 1;
		while (t < len(this.abi.storage.types)) {
			this.take(1); var row = this.abi.storage.types[t];
			if (row.state == 2 && row.kind == 31) {
				var descriptor = checked.types.row(type_id(t)); var declaration = checked.bindings.symbol(descriptor.nominal);
				var source_fields = checked.bindings.program.arena.get_list_fields(declaration.node); int count = checked.bindings.program.arena.list_count(source_fields);
				var name = llvm_storage_payload_name(checked, type_id(t));
				var payload = llvm15_struct(this.context, name.text);
				if (payload == null) {
					throw new Error("LLVM_RESOURCE_EXHAUSTED: Class payload type");
				}
