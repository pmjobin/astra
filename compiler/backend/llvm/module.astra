	bool check(SsaProgram program) throws Error {
		return native_abi_verify(this.abi, program, this.optimization, this.layout, this.types, this.functions) && llvm_check_retirements(program, this.functions, this.drops, this.blocks, this.places, this.armed, this.retirements, this.retirement_guards) && llvm_check_numeric(program, this.functions, this.blocks, this.ends, this.values, this.numeric_guards) && llvm_storage_layout_verify(this.abi.storage, program.cfg.core.flow.checked, this.layout, this.types, this.payloads) && llvm_storage_drops_verify(this.module, this.abi.storage, program.cfg.core.flow.checked, this.types, this.payloads, this.drops, this.slots) && llvm_storage_slots_verify(this.module, this.abi.storage, program.cfg.core.flow.checked, this.types, this.drops, this.slots) && llvm_check(program, this.layout, this.types, this.payloads, this.slots, this.functions, this.wrappers, this.signatures, this.blocks, this.ends, this.edges, this.values, this.places, this.accesses, this.effects, 8000000);
	}

	int audit(SsaProgram program) throws Error {
		if (!this.complete || this.disposed || this.module == null || !type_owner_same(this.source_owner, program.data.identity) || ssa_verify(program) != 0) return 5;
		if (!native_abi_verify(this.abi, program, this.optimization, this.layout, this.types, this.functions)) return 1;
		if (!llvm_check_retirements(program, this.functions, this.drops, this.blocks, this.places, this.armed, this.retirements, this.retirement_guards)) return 2;
		if (!llvm_check_numeric(program, this.functions, this.blocks, this.ends, this.values, this.numeric_guards)) return 3;
		if (!llvm_storage_layout_verify(this.abi.storage, program.cfg.core.flow.checked, this.layout, this.types, this.payloads)) return 3;
		if (!llvm_storage_drops_verify(this.module, this.abi.storage, program.cfg.core.flow.checked, this.types, this.payloads, this.drops, this.slots)) return 3;
		if (!llvm_storage_slots_verify(this.module, this.abi.storage, program.cfg.core.flow.checked, this.types, this.drops, this.slots)) return 3;
		if (!llvm_check(program, this.layout, this.types, this.payloads, this.slots, this.functions, this.wrappers, this.signatures, this.blocks, this.ends, this.edges, this.values, this.places, this.accesses, this.effects, 8000000)) return 3;
		if (llvm12_verify(this.module) != 0) return 4; return 0;
	}

	void abi_snapshot() throws Error {
		var text = native_abi_snapshot(this.abi); var payload = new Utf8ByteBuilder(); source_append_text(payload, text.text);
		if (this.disposed || this.context == null || this.layout == null) {
			source_append_text(payload, "CACHE CLOSED\n");
		}
		else {
			int t = 1;
			while (t < len(this.types)) {
				if (this.types[t] != null) {
					int kind = LLVMGetTypeKind(this.types[t]); source_append_text(payload, "CACHE"); flow_number(payload, t); flow_number(payload, kind);
					int width = 0; if (kind == 8) width = LLVMGetIntTypeWidth(this.types[t]); flow_number(payload, width);
					int owner = 0; if (LLVMGetTypeContext(this.types[t]) == this.context) owner = 1; flow_number(payload, owner); source_append_text(payload, "\n");
				}
				t = t + 1;
			}
		}
		var snapshot = payload.snapshot(); var out = new Utf8ByteBuilder(); syntax_write_hex(out, snapshot.text); var encoded = out.snapshot(); print(encoded.text);
	}

	void storage_snapshot(SsaProgram program) throws Error {
		if (!this.complete || this.disposed || !type_owner_same(this.source_owner, program.data.identity) || !this.check(program) || !program.cfg.core.flow.checked.class_storage) {
			throw new Error("LLVM_INVALID_IR: Class storage observation");
		}
		var output = new Utf8ByteBuilder(); source_append_text(output, "\nastra-classstorage-physical/1\nTARGET x86_64-linux-p64"); flow_number(output, LLVMPointerSize(this.layout)); source_append_text(output, "\n");
		int t = 1;
		while (t < len(this.abi.storage.types)) {
			var row = this.abi.storage.types[t];
			if (row.state == 2 && (row.kind == 30 || row.kind == 31)) {
				var type = this.types[t]; if (row.kind == 31) type = this.payloads[t];
				if (type == null) {
					throw new Error("LLVM_INVALID_IR: unobserved Class storage child");
				}
				var descriptor = program.cfg.core.flow.checked.types.row(type_id(t)); var declaration = program.cfg.core.flow.checked.bindings.symbol(descriptor.nominal); var name = program.cfg.core.flow.checked.bindings.names.text(declaration.name);
				source_append_text(output, "PAYLOAD"); flow_number(output, t); flow_number(output, descriptor.nominal.index); flow_number(output, row.kind);
				source_append_text(output, " "); syntax_write_hex(output, name.text);
				flow_number(output, row.payload_size); flow_number(output, row.payload_alignment); flow_number(output, row.fields); flow_number(output, LLVMABISizeOfType(this.layout, type) as int); flow_number(output, LLVMABIAlignmentOfType(this.layout, type));
				source_append_text(output, " "); binding_write_span(program.cfg.core.flow.checked.bindings, declaration.span, output); source_append_text(output, "\n");
				var fields = program.cfg.core.flow.checked.bindings.program.arena.get_list_fields(declaration.node); int f = 0;
				while (f < program.cfg.core.flow.checked.bindings.program.arena.list_count(fields)) {
					var node = program.cfg.core.flow.checked.bindings.program.arena.node_at(fields, f); var symbol = program.cfg.core.flow.checked.node_symbols[node.index]; var field = this.abi.storage.fields[symbol.index]; var member = program.cfg.core.flow.checked.bindings.symbol(symbol); var field_name = program.cfg.core.flow.checked.bindings.names.text(member.name);
					source_append_text(output, "PAYLOAD_FIELD"); flow_number(output, t); flow_number(output, f); flow_number(output, symbol.index); flow_number(output, field.semantic); flow_number(output, field.flags); flow_number(output, field.offset); flow_number(output, LLVMOffsetOfElement(this.layout, type, f) as int);
					source_append_text(output, " "); syntax_write_hex(output, field_name.text); source_append_text(output, "\n"); f = f + 1;
				}
			}
			t = t + 1;
		}
		var text = output.snapshot(); print(text.text);
	}

	void raw(SsaProgram program, string path) throws Error {
		if (!this.complete || this.module == null || !type_owner_same(this.source_owner, program.data.identity) || ssa_verify(program) != 0 || llvm12_matches(this.module, this.seal) != 1 || !this.check(program) || llvm12_verify(this.module) != 0) {
			throw new Error("LLVM_INVALID_IR: raw");
		}
		if (llvm12_write(this.module, this.machine, 0, this.output_limit, path) != 0) {
			throw new Error("LLVM_OUTPUT_FAILURE: raw");
		}
	}

	// Fault injection is exercised only by the separate component test consumer.
	// Every attempt starts from freshly verified SSA and a sealed native module.
	bool storage_fault_change(int category) throws Error {
		int i = 0;
		while (i < len(this.accesses)) {
			var address = this.accesses[i];
			if (address != null && LLVMIsAInstruction(address) != null && LLVMGetInstructionOpcode(address) == 29 && LLVMGetNumOperands(address) == 3) {
				int t = 1;
				while (t < len(this.payloads)) {
					if (this.payloads[t] != null && LLVMGetGEPSourceElementType(address) == this.payloads[t]) {
						if (category == 61) {
							int earlier = 0;
							while (earlier < len(this.accesses)) {
								var prior = this.accesses[earlier];
								if (prior != null && prior != address && LLVMIsAInstruction(prior) != null && LLVMGetInstructionOpcode(prior) == 29 && LLVMGetNumOperands(prior) == 3 && LLVMGetGEPSourceElementType(prior) == this.payloads[t] && LLVMGetOperand(prior, 2) == LLVMGetOperand(address, 2) && LLVMGetInstructionParent(prior) != LLVMGetInstructionParent(address) && LLVMGetBasicBlockParent(LLVMGetInstructionParent(prior)) == LLVMGetBasicBlockParent(LLVMGetInstructionParent(address))) {
									var current = LLVMGetOperand(address, 0); var previous = LLVMGetOperand(prior, 0);
									if (LLVMIsAInstruction(current) != null && LLVMIsAInstruction(previous) != null && LLVMGetInstructionOpcode(current) == 27 && LLVMGetInstructionOpcode(previous) == 27 && LLVMGetOperand(current, 0) == LLVMGetOperand(previous, 0)) {
										LLVMReplaceAllUsesWith(address, prior); this.accesses[i] = prior; return true;
									}
								}
								earlier = earlier + 1;
							}
						}
						if (category == 60 && LLVMCountStructElementTypes(this.payloads[t]) > 1) {
							var ordinal = LLVMGetOperand(address, 2); u64 next = (LLVMConstIntGetZExtValue(ordinal) + 1) % LLVMCountStructElementTypes(this.payloads[t]) as u64; LLVMSetOperand(address, 2, llvm_integer_constant(LLVMTypeOf(ordinal), next, 0)); return true;
						}
						var object = LLVMGetOperand(address, 0);
						if (LLVMIsAInstruction(object) != null && LLVMGetInstructionOpcode(object) == 27) {
							if (category == 63) {
								LLVMSetOperand(address, 0, LLVMGetOperand(object, 0));
								return true;
							}
							if (category == 64) {
								var compare = LLVMGetNextInstruction(object);
								var branch = LLVMGetNextInstruction(compare);
								LLVMSetOperand(branch, 0, LLVMConstNull(LLVMIntTypeInContext(this.context, 1)));
								return true;
							}
						}
					}
					t = t + 1;
				}
			}
			i = i + 1;
		}
		i = 0;
		while (i < len(this.effects)) {
			var call = this.effects[i];
			if (call != null && LLVMGetInstructionOpcode(call) == 45 && LLVMGetNumArgOperands(call) > 0) {
				var first = LLVMGetArgOperand(call, 0);
				if (LLVMIsAInstruction(first) != null && LLVMGetInstructionOpcode(first) == 45 && llvm13_named(LLVMGetCalledValue(first), "calloc") == 1) {
					if (category == 65) {
						this.effects[i] = null;
						LLVMInstructionEraseFromParent(call);
						return true;
					}
					if (category == 66) {
						LLVMSetOperand(call, 0, LLVMConstNull(LLVMTypeOf(first)));
						return true;
					}
					if (category == 67) {
						var extent = LLVMGetArgOperand(first, 1);
						u64 bytes = LLVMConstIntGetZExtValue(extent);
						if (bytes > 1) {
							LLVMSetOperand(first, 1, llvm_integer_constant(LLVMTypeOf(extent), bytes - 1, 0));
							return true;
						}
					}
				}
				if (category == 77) {
					int slot = 0;
					while (slot < len(this.slots)) {
						if (this.slots[slot] != null && LLVMGetCalledValue(call) == this.slots[slot]) {
							int type = slot / 6; LLVMPositionBuilderBefore(this.builder, call); var copy = LLVMBuildAlloca(this.builder, this.types[type], this.empty); var value = LLVMBuildLoad2(this.builder, this.types[type], first, this.empty); var stored = LLVMBuildStore(this.builder, value, copy); LLVMSetOperand(call, 0, copy); return true;
						}
						slot = slot + 1;
					}
				}
			}
			i = i + 1;
		}
		int t = 1;
		while (t < len(this.drops)) {
			var function = this.drops[t];
			if (function != null) {
				var block = LLVMGetFirstBasicBlock(function);
				while (block != null) {
					var instruction = LLVMGetFirstInstruction(block);
					while (instruction != null) {
						if (LLVMGetInstructionOpcode(instruction) == 45) {
							var callee = LLVMGetCalledValue(instruction);
							if (category == 68) {
								int child = 1; while (child < len(this.drops)) {
									if (this.drops[child] != null && callee == this.drops[child]) {
										LLVMInstructionEraseFromParent(instruction);
										return true;
									}
									child = child + 1;
								}
							}
							if (category == 69 && llvm13_named(callee, "free") == 1 && LLVMGetArgOperand(instruction, 0) == LLVMGetParam(function, 0)) {
								LLVMPositionBuilderBefore(this.builder, instruction);
								var extra = this.free_pointer(LLVMGetParam(function, 0));
								return true;
							}
						}
						instruction = LLVMGetNextInstruction(instruction);
					}
					block = LLVMGetNextBasicBlock(block);
				}
			}
			t = t + 1;
		}
		int slot = 0;
		while (slot < len(this.slots)) {
			var function = this.slots[slot]; int action = slot % 6;
			if (function != null) {
