		var signature = LLVMFunctionType(LLVMVoidTypeInContext(this.context), this.handle_args(parameters, 0), 1, 0); var callee = llvm12_function(this.module, signature, "free");
		var args = new void*[1]; args[0] = pointer;
		var call = LLVMBuildCall2(this.builder, signature, callee, this.handle_args(args, 0), 1, this.empty); llvm12_nobuiltin(this.context, call); return call;
	}

	void* storage_call(void* callee, void*[] arguments) throws Error {
		if (callee == null) {
			throw new Error("LLVM_INVALID_IR: private storage helper");
		}
		return LLVMBuildCall2(this.builder, LLVMGlobalGetValueType(callee), callee, this.handle_args(arguments, 0), len(arguments), this.empty);
	}

	void* slot_signature(int action) throws Error {
		var pointer = LLVMPointerTypeInContext(this.context, 0); var i32 = LLVMIntTypeInContext(this.context, 32);
