			}
			var fields = new void*[3]; fields[0] = LLVMPointerTypeInContext(this.context, 0); fields[1] = LLVMIntTypeInContext(this.context, 32); fields[2] = fields[1];
			result = LLVMStructTypeInContext(this.context, this.handle_args(fields, 0), 3, 0);
