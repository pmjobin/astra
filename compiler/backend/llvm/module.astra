								if (this.drops[child] != null && LLVMGetCalledValue(instruction) == this.drops[child]) {
									if (category == 74) {
										LLVMSetOperand(instruction, 0, LLVMGetParam(function, 2));
										return true;
									}
									LLVMInstructionEraseFromParent(instruction); return true;
								}
								child = child + 1;
							}
						}
						instruction = LLVMGetNextInstruction(instruction);
					}
					block = LLVMGetNextBasicBlock(block);
				}
			}
			slot = slot + 1;
		}
		return false;
	}

	bool storage_fault(int category) throws Error {
		if (!this.complete || this.disposed || !this.abi.storage.active) return false;
		if (!this.storage_fault_change(category)) return false;
		// Reseal deliberately: the test must be rejected by the independent
		// consumers even when the producer's byte seal matches the mutant.
		LLVMDisposeMessage(this.seal); this.seal = llvm12_seal(this.module, this.output_limit); return true;
	}

	bool fault(int category) throws Error {
		if (!this.complete || this.module == null) {
			throw new Error("LLVM_INVALID_IR: fault input");
		}
		if (native_abi_fault(this.abi, category)) return true;
		if (category == 44) {
			int i = 0;
			while (i < len(this.values)) {
				var value = this.values[i];
				if (value != null && LLVMIsAInstruction(value) != null && LLVMGetInstructionOpcode(value) == 54 && llvm13_index(value, 0, 1) == 1) {
					var aggregate = LLVMGetOperand(value, 0);
					if (LLVMIsAInstruction(aggregate) != null && LLVMGetInstructionOpcode(aggregate) == 54 && llvm13_index(aggregate, 0, 0) == 1) {
						var pointer = LLVMGetOperand(aggregate, 1);
						if (LLVMIsAInstruction(pointer) != null && LLVMGetInstructionOpcode(pointer) == 44 && LLVMCountIncoming(pointer) == 2) {
							var allocation = LLVMGetIncomingValue(pointer, 1);
							if (LLVMIsAInstruction(allocation) != null && LLVMGetInstructionOpcode(allocation) == 45 && llvm13_named(LLVMGetCalledValue(allocation), "calloc") == 1) {
								var width = LLVMGetArgOperand(allocation, 1); LLVMSetOperand(allocation, 1, llvm_integer_constant(LLVMTypeOf(width), 0, 0)); return true;
							}
						}
					}
