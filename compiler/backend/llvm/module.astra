		if (category == 29 || category == 30 || category == 31 || category == 36) {
			int f = 0;
			while (f < len(this.functions)) {
				if (category == 30 && LLVMGetFirstBasicBlock(this.functions[f]) == null) {
					llvm13_rename(this.functions[f], "forged_foreign_symbol");
					return true;
				}
				if (category == 29 && (this.wrappers[f] != null || LLVMGetFirstBasicBlock(this.functions[f]) == null)) {
					int p = 0;
					while (p < LLVMCountParams(this.functions[f])) {
						if (LLVMGetTypeKind(LLVMTypeOf(LLVMGetParam(this.functions[f], p))) == 12) {
							llvm13_false_align(this.context, this.functions[f], p);
							return true;
						}
						p = p + 1;
					}
				}
				if (this.wrappers[f] != null) {
					if (category == 36) {
						LLVMSetFunctionCallConv(this.wrappers[f], 8);
						return true;
					}
					if (category == 31) {
						int other = 0;
						while (other < len(this.functions)) {
							if (other != f && this.signatures[other] == this.signatures[f] && LLVMGetFirstBasicBlock(this.functions[other]) != null) {
								var call = LLVMGetFirstInstruction(LLVMGetFirstBasicBlock(this.wrappers[f]));
								LLVMSetOperand(call, LLVMGetNumOperands(call) - 1, this.functions[other]);
								return true;
							}
							other = other + 1;
						}
					}
				}
				f = f + 1;
			}
			return false;
		}
		if (category == 17) {
			llvm12_bad_target(this.module, 1);
			return true;
		}
		if (category == 18) {
			llvm12_bad_layout(this.module, this.machine, 1);
			return true;
		}
		if (category == 19) {
			var extra = llvm12_block(this.context, this.functions[0], "forged_success");
			LLVMDisposeMessage(this.seal); this.seal = llvm12_seal(this.module, this.output_limit); this.complete = true; return true;
		}
		void* function = LLVMGetFirstFunction(this.module);
		while (function != null) {
			void* block = LLVMGetFirstBasicBlock(function);
			while (block != null) {
				void* instruction = LLVMGetFirstInstruction(block);
				while (instruction != null) {
					int op = LLVMGetInstructionOpcode(instruction);
					if (category == 37 && op == 66) {
						LLVMSetOperand(instruction, 0, LLVMConstNull(LLVMTypeOf(LLVMGetOperand(instruction, 0))));
						return true;
					}
					if (category == 23 && LLVMCanValueUseFastMathFlags(instruction) != 0) {
						LLVMSetFastMathFlags(instruction, 1);
						return true;
					}
					if (category == 24 && op == 45 && LLVMGetNumArgOperands(instruction) > 1 && LLVMGetFirstBasicBlock(LLVMGetCalledValue(instruction)) == null) {
						var a = LLVMGetArgOperand(instruction, 0);
						var b = LLVMGetArgOperand(instruction, 1);
						if (LLVMTypeOf(a) != LLVMTypeOf(b)) {
							LLVMSetOperand(instruction, 0, b);
							LLVMSetOperand(instruction, 1, a);
							return true;
						}
					}
					if (category == 26 && op == 29 && LLVMCountStructElementTypes(LLVMGetGEPSourceElementType(instruction)) > 1 && LLVMIsAConstantInt(LLVMGetOperand(instruction, 2)) != null) {
						u64 index = LLVMConstIntGetZExtValue(LLVMGetOperand(instruction, 2));
						u64 replacement = 0;
						if (index == 0) replacement = 1;
						LLVMSetOperand(instruction, 2, llvm_integer_constant(LLVMTypeOf(LLVMGetOperand(instruction, 2)), replacement, 0));
						return true;
					}
					if (category == 34 && op == 43) {
						int predicate = 14;
						if (LLVMGetFCmpPredicate(instruction) == 14) predicate = 6;
						LLVMPositionBuilderBefore(this.builder, instruction);
						var replacement = LLVMBuildFCmp(this.builder, predicate, LLVMGetOperand(instruction, 0), LLVMGetOperand(instruction, 1), this.empty);
						LLVMReplaceAllUsesWith(instruction, replacement);
						return true;
					}
					if (category == 20 && op == 28 && LLVMGetVolatile(instruction) != 0) {
						LLVMSetVolatile(instruction, 0);
						return true;
					}
					if (category == 0 && op == 44 && LLVMCountIncoming(instruction) > 1) {
						var old = LLVMGetIncomingValue(instruction, 0);
						var other = LLVMGetIncomingValue(instruction, 1);
						if (old != other) {
							LLVMSetOperand(instruction, 0, other);
							return true;
						}
					}
					if (category == 1 && op == 44 && LLVMCountIncoming(instruction) > 1) {
						var args = new void*[1];
						args[0] = LLVMGetIncomingValue(instruction, 0);
						var source = new void*[1];
						source[0] = LLVMGetIncomingBlock(instruction, 1);
						var raw_args = this.handle_args(args, 0);
						var raw_sources = this.handle_args(source, 512);
						LLVMAddIncoming(instruction, raw_args, raw_sources, 1);
						return true;
					}
					if (category == 2 && op == 42) {
						int predicate = LLVMGetICmpPredicate(instruction);
						LLVMPositionBuilderBefore(this.builder, instruction);
						var replacement = LLVMBuildICmp(this.builder, predicate ^ 1, LLVMGetOperand(instruction, 0), LLVMGetOperand(instruction, 1), this.empty);
						LLVMReplaceAllUsesWith(instruction, replacement);
						return true;
					}
					if (category == 3 && op == 32) {
						LLVMPositionBuilderBefore(this.builder, instruction);
						var replacement = LLVMBuildZExt(this.builder, LLVMGetOperand(instruction, 0), LLVMTypeOf(instruction), this.empty);
						LLVMReplaceAllUsesWith(instruction, replacement);
						return true;
					}
					if (category == 4 && (op == 8 || op == 10 || op == 12)) {
						var operand = LLVMGetOperand(instruction, 1);
						var replacement = llvm_integer_constant(LLVMTypeOf(operand), 73, 0);
						if (operand != replacement) {
							LLVMSetOperand(instruction, 1, replacement);
							return true;
						}
					}
					if (category == 5 && op == 8) {
						LLVMSetNSW(instruction, 1);
						return true;
					}
					if (category == 6 && op == 8) {
						LLVMSetNUW(instruction, 1);
						return true;
					}
					if (category == 7 && op == 29) {
						LLVMSetIsInBounds(instruction, 1);
						return true;
					}
					if (category == 8 && op == 71 && LLVMGetNumSuccessors(instruction) == 2) {
						var yes = LLVMGetSuccessor(instruction, 0);
						var no = LLVMGetSuccessor(instruction, 1);
						LLVMSetSuccessor(instruction, 0, no);
						LLVMSetSuccessor(instruction, 1, yes);
						return true;
					}
					if (category == 9 && op == 1 && LLVMGetNumOperands(instruction) == 1 && LLVMIsAConstantInt(LLVMGetOperand(instruction, 0)) == null) {
						var original = LLVMGetOperand(instruction, 0);
						if (LLVMGetTypeKind(LLVMTypeOf(original)) == 8) {
							LLVMSetOperand(instruction, 0, llvm_integer_constant(LLVMTypeOf(original), 1, 0));
							return true;
						}
					}
					if (category == 10 && op == 45 && LLVMGetNumArgOperands(instruction) == 2) {
						var a = LLVMGetArgOperand(instruction, 0);
						var b = LLVMGetArgOperand(instruction, 1);
						if (LLVMTypeOf(a) == LLVMTypeOf(b) && a != b) {
							LLVMSetOperand(instruction, 0, b);
							LLVMSetOperand(instruction, 1, a);
							return true;
						}
					}
					if (category == 11 && op == 1 && LLVMGetNumOperands(instruction) == 1 && LLVMGetTypeKind(LLVMTypeOf(LLVMGetOperand(instruction, 0))) == 8) {
						LLVMSetOperand(instruction, 0, llvm_integer_constant(LLVMIntTypeInContext(this.context, 128), 1, 0));
						return true;
					}
					if (category == 12 && op == 45 && LLVMGetNumArgOperands(instruction) > 0) {
						llvm12_false_noalias(this.context, LLVMGetCalledValue(instruction));
						return true;
					}
					if ((category == 13 || category == 14 || category == 15) && op == 45 && LLVMGetNumArgOperands(instruction) == 1 && LLVMGetTypeKind(LLVMTypeOf(LLVMGetArgOperand(instruction, 0))) == 12 && LLVMGetTypeKind(LLVMTypeOf(instruction)) == 0) {
						if (category == 13) {
							LLVMInstructionEraseFromParent(instruction);
							return true;
						}
						if (category == 15) {
							LLVMSetOperand(instruction, 0, LLVMConstNull(LLVMTypeOf(LLVMGetArgOperand(instruction, 0))));
							return true;
						}
						LLVMPositionBuilderBefore(this.builder, instruction); var args = new void*[1]; args[0] = LLVMGetArgOperand(instruction, 0); var raw_args = this.handle_args(args, 0); var callee = LLVMGetCalledValue(instruction); var call = LLVMBuildCall2(this.builder, LLVMGlobalGetValueType(callee), callee, raw_args, 1, this.empty); return true;
					}
					if (category == 16 && op == 27) {
						int p = 0;
						while (p < len(this.places)) {
							if (this.places[p] != null && this.places[p] != LLVMGetOperand(instruction, 0)) {
								LLVMSetOperand(instruction, 0, this.places[p]);
								return true;
							}
							p = p + 1;
						}
					}
					instruction = LLVMGetNextInstruction(instruction);
				}
				block = LLVMGetNextBasicBlock(block);
			}
			function = LLVMGetNextFunction(function);
		}
		return false;
	}

	void snapshot() throws Error { if (this.module == null) {
			throw new Error("LLVM_INVALID_IR: disposed snapshot");
		} llvm12_print_hex(this.module); }

	void build(SsaProgram program) throws Error {
		if (!this.input_valid || this.disposed || this.context != null || this.module != null || this.complete) {
			throw new Error("LLVM_INVALID_IR: module state");
		}
		if (!type_owner_same(this.source_owner, program.data.identity) || ssa_verify(program) != 0) {
			throw new Error("LLVM_INVALID_UPSTREAM: build owner");
		}
		var plan = native_abi_plan(program, this.optimization); this.abi = move plan;
		this.open(); this.declarations(program); this.storage_types(program.cfg.core.flow.checked); this.storage_declarations(program.cfg.core.flow.checked); this.storage(program); this.storage_bodies(program.cfg.core.flow.checked); this.body(program); this.foreign_wrappers(program);
		if (!this.check(program)) {
			if (!native_abi_verify(this.abi, program, this.optimization, this.layout, this.types, this.functions)) {
				throw new Error("LLVM_INVALID_IR: ABI correspondence");
			}
			if (!llvm_check_retirements(program, this.functions, this.drops, this.blocks, this.places, this.armed, this.retirements, this.retirement_guards)) {
				throw new Error("LLVM_INVALID_IR: retirement correspondence");
			}
			if (!llvm_check_numeric(program, this.functions, this.blocks, this.ends, this.values, this.numeric_guards)) {
				throw new Error("LLVM_INVALID_IR: numeric correspondence");
			}
			if (!llvm_storage_layout_verify(this.abi.storage, program.cfg.core.flow.checked, this.layout, this.types, this.payloads)) {
				throw new Error("LLVM_INVALID_IR: Class payload layout correspondence");
			}
			if (!llvm_storage_drops_verify(this.module, this.abi.storage, program.cfg.core.flow.checked, this.types, this.payloads, this.drops, this.slots)) {
				throw new Error("LLVM_INVALID_IR: Class retirement correspondence");
			}
			if (!llvm_storage_slots_verify(this.module, this.abi.storage, program.cfg.core.flow.checked, this.types, this.drops, this.slots)) {
				throw new Error("LLVM_INVALID_IR: owner-slot correspondence");
			}
			throw new Error("LLVM_INVALID_IR: instruction correspondence");
		}
		if (llvm12_verify(this.module) != 0) {
			throw new Error("LLVM_INVALID_IR");
		}
		this.seal = llvm12_seal(this.module, this.output_limit);
		if (this.seal == null) {
			throw new Error("LLVM_RESOURCE_EXHAUSTED: IR");
		}
		this.complete = true;
	}
}

// The supported artifact interface never returns an implementation object or
// raw LLVM reference. C0 currently permits privacy on fields only.
class LlvmArtifact {
	private owned LlvmModule implementation;

	init(owned LlvmModule implementation) { this.implementation = move implementation; }

	void write(SsaProgram program, borrowed SsaProgram origin, LlvmProfile profile, string path, bool object) throws Error { this.implementation.write(program, origin, profile, path, object); }

	void raw(SsaProgram program, string path) throws Error { this.implementation.raw(program, path); }

	void close() { this.implementation.close(); }

	bool fault(int category) throws Error { return this.implementation.fault(category); }

	bool storage_fault(int category) throws Error { return this.implementation.storage_fault(category); }

	void snapshot() throws Error { this.implementation.snapshot(); }

	void abi_snapshot() throws Error { this.implementation.abi_snapshot(); }

	void storage_snapshot(SsaProgram program) throws Error { this.implementation.storage_snapshot(program); }

	int audit(SsaProgram program) throws Error { return this.implementation.audit(program); }
}

owned LlvmArtifact llvm_lower(SsaProgram program, borrowed SsaProgram origin, LlvmProfile profile) throws Error {
	if (!profile.valid()) {
		throw new Error("LLVM_RESOURCE_EXHAUSTED: profile");
	}
	if (!program.same_owner(origin) || ssa_verify(program) != 0) {
		throw new Error("LLVM_INVALID_UPSTREAM");
	}
	if (program.data.block_count > 1024 || program.data.value_count > 65536 || program.cfg.core.data.place_count > 65536) {
		throw new Error("LLVM_RESOURCE_EXHAUSTED: tables");
	}
	var module = new LlvmModule(program, profile); module.build(program); var artifact = new LlvmArtifact(move module); return move artifact;
}
