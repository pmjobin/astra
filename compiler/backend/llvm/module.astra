		var inconsistent = LLVMBuildXor(this.builder, no_backing, empty_capacity, this.empty); var bad_range = LLVMBuildOr(this.builder, negative, short_capacity, this.empty); var invalid = LLVMBuildOr(this.builder, bad_range, inconsistent, this.empty); this.guard(invalid, function);
		var element = checked.types.argument(checked.types, type, 0);
		if (action == 1) {
			var requested = LLVMGetParam(function, 1); var rejected = llvm12_block(this.context, function, "rejected"); var extent = llvm12_block(this.context, function, "extent"); var noop = llvm12_block(this.context, function, "noop"); var allocate = llvm12_block(this.context, function, "allocate"); var header = llvm12_block(this.context, function, "transfer"); var copy = llvm12_block(this.context, function, "copy"); var commit = llvm12_block(this.context, function, "commit");
			var below_zero = LLVMBuildICmp(this.builder, 40, requested, LLVMConstNull(i32), this.empty); var branch = LLVMBuildCondBr(this.builder, below_zero, rejected, extent);
			LLVMPositionBuilderAtEnd(this.builder, rejected); var rejected_end = LLVMBuildRet(this.builder, LLVMConstNull(bit));
			LLVMPositionBuilderAtEnd(this.builder, extent); var sufficient = LLVMBuildICmp(this.builder, 41, requested, capacity, this.empty); var extent_branch = LLVMBuildCondBr(this.builder, sufficient, noop, allocate);
