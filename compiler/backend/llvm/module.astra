// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// LLVM 23 requires canonical input bits, including negative/all-ones values.
// This is a physical C API boundary; source semantics select every input.
void* llvm_integer_constant(void* type, u64 bits, int extend) {
	int width = LLVMGetIntTypeWidth(type);
	u64 canonical = bits;
	if (width < 64) canonical = bits & ((1 as u64 << width) - 1);
	return LLVMConstInt(type, canonical, extend);
}

class LlvmProfile {
	int optimization;
	int work;
	int output;

	init(int optimization, int work, int output) { this.optimization = optimization; this.work = work; this.output = output; }

	bool valid() { return (this.optimization == 0 || this.optimization == 2) && this.work > 0 && this.work <= 8000000 && this.output > 0 && this.output <= 16777216; }
}

owned Utf8Message llvm_name(string prefix, int index) throws Error {
	var out = new Utf8ByteBuilder(); source_append_text(out, prefix); append_int(out, index); return out.snapshot();
}

owned Utf8Message llvm_native_name(CheckedIndex checked, SymbolId symbol, int ordinal) throws Error {
	if (generic_instance_for(checked, symbol) > 0) {
		if (checked.class_storage) return generic_backend_name(checked, symbol, "x86_64-linux-p64", "classstorage15");
		return generic_backend_name(checked, symbol, "x86_64-linux-p64", "nativeabi13");
	}
	return llvm_name("astra.f", ordinal);
}

owned Utf8Message llvm_storage_payload_name(CheckedIndex checked, TypeId type) throws Error {
	var descriptor = checked.types.row(type);
	if (generic_instance_for(checked, descriptor.nominal) > 0) return generic_backend_name(checked, descriptor.nominal, "x86_64-linux-p64", "classstorage15.payload");
	return llvm_name("astra.classstorage.t", type.index);
}

bool llvm_imported(SsaProgram program, int function) {
	var symbol = program.cfg.core.flow.checked.bindings.symbol(program.cfg.core.data.functions[function - 1].symbol);
	return program.cfg.core.flow.checked.bindings.program.arena.computed_is_c_import(symbol.node);
}

bool llvm_exported(SsaProgram program, int function) {
	var symbol = program.cfg.core.flow.checked.bindings.symbol(program.cfg.core.data.functions[function - 1].symbol);
	return program.cfg.core.flow.checked.bindings.program.arena.computed_is_c_export(symbol.node);
}

// Raw LLVM handles never escape this owner. The retained SSA must be supplied
// again at output, including exact instance identity, not just identical bytes.
class LlvmModule {
	private owned shared TypeOwner source_owner;
	private void* context;
	private void* module;
	private void* builder;
	private void* machine;
	private void* layout;
	private void* empty;
	private void* handles;
	private void* seal;
	private owned void*[] effects;
	private owned void*[] retirements;
	private owned void*[] retirement_guards;
	private owned void*[] numeric_guards;
	private owned int[] retirement_modes;
	private owned void*[] types;
	private owned void*[] payloads;
	private owned void*[] functions;
	private owned void*[] wrappers;
	private owned void*[] signatures;
	private owned void*[] blocks;
	private owned void*[] ends;
	private owned void*[] edges;
	private owned void*[] values;
	private owned void*[] places;
	private owned void*[] accesses;
	private owned void*[] drops;
	private owned void*[] slots;
	private owned void*[] armed;
	private owned NativeAbiPlan abi;
	private int optimization;
	private int output_limit;
	private int remaining;
	private bool complete;
	private bool disposed;
	private bool input_valid;

	init(SsaProgram program, LlvmProfile profile) {
		// C0 constructors cannot throw. Invalid direct construction is inert and
		// allocates empty tables; the supported factory reports the exact stage.
		bool valid = false;
		try { valid = profile.valid() && ssa_verify(program) == 0 && program.data.block_count <= 1024 && program.data.value_count <= 65536 && program.cfg.core.data.place_count <= 65536; } catch (Error error) { valid = false; }
		int functions = 0; int blocks = 0; int edges = 0; int values = 0; int places = 0; int instructions = 0; int types = 0;
		if (valid) {
			functions = program.data.function_count;
			blocks = program.data.block_count;
			edges = program.data.edge_count;
			values = program.data.value_count;
			places = program.cfg.core.data.place_count;
			instructions = program.data.instruction_count;
			types = program.cfg.core.flow.checked.types.count + 1;
		}
		this.input_valid = valid;
		var identity = shared_clone(program.data.identity); this.source_owner = move identity;
		this.context = null; this.module = null; this.builder = null; this.machine = null; this.layout = null;
		this.seal = null; this.effects = new void*[instructions]; this.handles = null; this.empty = llvm12_empty(); this.optimization = profile.optimization; this.output_limit = profile.output; this.remaining = profile.work; this.complete = false; this.disposed = false;
		this.retirements = new void*[instructions]; this.retirement_guards = new void*[instructions];
		this.numeric_guards = new void*[instructions];
		this.retirement_modes = new int[instructions];
		this.types = new void*[types];
		this.payloads = new void*[types];
		this.functions = new void*[functions]; this.wrappers = new void*[functions]; this.signatures = new void*[functions];
		this.blocks = new void*[blocks]; this.ends = new void*[blocks]; this.edges = new void*[edges];
		this.values = new void*[values]; this.places = new void*[places]; this.armed = new void*[places];
		this.accesses = new void*[instructions]; this.drops = new void*[types]; this.slots = new void*[types * 6];
		var empty_plan = new NativeAbiPlan(0, 0, 0, 0, profile.optimization); this.abi = move empty_plan;
	}

	void* handle_args(void*[] values, int offset) throws Error {
		if (len(values) > 512 || (offset != 0 && offset != 512)) {
			throw new Error("LLVM_RESOURCE_EXHAUSTED: handle vector");
		}
		int i = 0; while (i < len(values)) {
			this.take(1);
			llvm12_handle_set(this.handles, offset + i, values[i]);
			i = i + 1;
		} return llvm12_handle_offset(this.handles, offset);
	}

	void take(int count) throws Error {
		if (count < 0 || count > this.remaining) {
			throw new Error("LLVM_RESOURCE_EXHAUSTED: work");
		} this.remaining = this.remaining - count;
	}

	void open() throws Error {
		this.handles = llvm12_handles();
		if (this.handles == null) {
			throw new Error("LLVM_RESOURCE_EXHAUSTED: handles");
		}
		this.context = LLVMContextCreate();
		if (this.context == null) {
			throw new Error("LLVM_RESOURCE_EXHAUSTED: context");
		}
		this.module = LLVMModuleCreateWithNameInContext(this.empty, this.context); this.builder = LLVMCreateBuilderInContext(this.context); this.machine = llvm12_machine(this.optimization);
		if (this.module == null || this.builder == null || this.machine == null) {
			throw new Error("LLVM_TARGET_UNAVAILABLE");
		}
		this.layout = LLVMCreateTargetDataLayout(this.machine);
		if (this.layout == null || LLVMPointerSize(this.layout) != 8 || llvm12_target(this.module, this.machine) != 0) {
			throw new Error("LLVM_TARGET_UNAVAILABLE: layout");
