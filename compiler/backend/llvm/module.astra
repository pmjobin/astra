	}

	void storage_declarations(CheckedIndex checked) throws Error {
		if (!checked.class_storage) return;
		int t = 1;
		while (t < len(this.abi.storage.types)) {
			this.take(1); var row = this.abi.storage.types[t];
			if (row.state == 2 && row.kind == 31) {
				var parameters = new void*[1]; parameters[0] = LLVMPointerTypeInContext(this.context, 0);
				var signature = LLVMFunctionType(LLVMVoidTypeInContext(this.context), this.handle_args(parameters, 0), 1, 0); var name = llvm_name("astra.classstorage.drop.", t);
				var function = llvm12_function(this.module, signature, name.text); LLVMSetLinkage(function, 8); this.drops[t] = function;
			}
