// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Bounded production GNU/Linux compiler driver over the independent passes.
extern(C) void LLVMShutdown();

/// Checks one explicit source program and optionally emits native products.
/// Documentation extraction has its own semantic-only entry point.
/// @param paths Source names retained by the shared source-set owner.
/// @param output Explicit destination; empty for check and syntax modes.
/// @param mode Existing check, syntax, IR or object emission mode.
/// @param level Native optimization level, independently qualified at O0/O2.
/// @return Zero on success or one for diagnosed source failures.
/// @throws Error A compiler verification or emission boundary failed.
int astrac_compile(Vector<Utf8Message> paths, Utf8Message output, int mode, int level) throws Error {
	var program = astrac_load(paths, output);
	if (mode == 3 || mode == 4) {
		if (program.failed()) {
			var message = program.arena.text_message(program.error_message); println_stderr(message.text); return 1;
		}
		if (mode == 3) {
			var dump = syntax_program_dump(program);
			print(dump.text);
			return 0;
		}
		var formatted = syntax_source_format(program); print(formatted.text); return 0;
	}
	var bindings = binding_index(move program, 0);
	var checked = checked_build_effects_profile(move bindings, 0);
	if (checked.failed()) {
		astrac_diagnostic(checked);
		return 1;
	}
	var flow = recover_flow_lower(move checked, 8192);
	if (flow.data.status != 0 || !recover_flow_verify(flow)) {
		throw new Error("astrac: Flow rejected this program");
	}
	var core = recover_core_lower(move flow);
	if (core.status != 0 || !recover_core_verify(core)) {
		throw new Error("astrac: Core verification failed");
	}
	var cfg = recover_cfg_lower(move core, 8192);
	if (cfg.status != 0) {
		throw new Error("astrac: CFG verification failed");
	}
	var ssa = recover_ssa_lower(move cfg, 8000000);
	var detail = new int[4]; detail[0] = ssa.data.failure_phase; detail[1] = ssa.data.failure_item; detail[2] = ssa.data.failure_remaining; detail[3] = ssa.data.failure_exhausted;
	if (ssa.data.status != 0 || !recover_ssa_verify_details(ssa, detail)) {
		var diagnostic = new Utf8ByteBuilder(); source_append_text(diagnostic, "astrac: SSA verification failed status="); append_int(diagnostic, ssa.data.status);
		source_append_text(diagnostic, " phase="); append_int(diagnostic, detail[0]); source_append_text(diagnostic, " item="); append_int(diagnostic, detail[1]);
		source_append_text(diagnostic, " remaining="); append_int(diagnostic, detail[2]); source_append_text(diagnostic, " exhausted="); append_int(diagnostic, detail[3]);
		var message = diagnostic.snapshot(); throw new Error(message.text);
	}
	if (mode == 0) return 0;
	var module = new RecoverLlvm(ssa);
	module.build(ssa);
	if (!module.check(ssa) || llvm12_verify(module.module) != 0) {
		throw new Error("astrac: LLVM verification failed");
	}
	if (mode == 1 && level == 0) {
		module.write(ssa, output.text);
		return 0;
	}
	// Physical source correspondence is checked before optimization. LLVM's
	// verifier independently checks the optimized module and object emission.
	var machine = llvm12_machine(level);
	if (machine == null) {
		throw new Error("astrac: target machine unavailable");
	}
	int status = llvm12_optimize(module.module, machine, level);
	if (status == 0) {
		if (mode == 1) {
			status = llvm26_write_ir(module.module, 134217728, output.text);
		} else {
			status = llvm12_write(module.module, machine, 1, 16777216, output.text);
		}
	}
	LLVMDisposeTargetMachine(machine);
	if (status != 0) {
		throw new Error("astrac: output generation failed");
	}
	return 0;
}

owned Utf8Message astrac_output(int index) throws Error {
	if (index > 0) {
		var result = astrac_argument(index);
		return move result;
	}
	var empty = syntax_text("");
	return move empty;
}

int astrac_run() {
	try {
		int count = astrac_argument_count();
		if (count < 1) {
			throw new Error("astrac: process argument transport unavailable");
		}
		var paths = new Vector<Utf8Message>(count);
		int output_index = 0;
		int mode = 1;
		int level = 0;
		bool positional = false;
		int i = 1;
		while (i < count) {
			var argument = astrac_argument(i);
			bool handled = false;
			if (!positional && argument.text == "--") {
				handled = true;
				positional = true;
			}
			if (!handled && !positional && argument.text == "--version") {
				if (count != 2) {
					throw new Error("astrac: --version must be used alone");
				}
				println("astrac 0.0.3-dev28c1 (GNU/Linux x86-64, E25-A-v1, LLVM 23.1.4)");
				return 0;
			}
			if (!handled && !positional && argument.text == "--help") {
				if (count != 2) {
					throw new Error("astrac: --help must be used alone");
				}
				println("Usage: astrac [--emit-llvm|-c|--check|--dump-syntax|--format] [-O0|-O2] [-o OUTPUT] [--] FILE...\nExplicit sources form one program. --check and syntax modes need no output; --format accepts one source and uses formatter version 2. Link emitted objects with approved C providers and libraries. Unsupported options are errors. Diagnostics use UTF-8 byte offsets. API documentation: astrac doc --help.");
				return 0;
			}
			if (!handled && !positional && argument.text == "--check") {
				handled = true;
				mode = 0;
			}
			if (!handled && !positional && argument.text == "--dump-syntax") {
				handled = true;
				mode = 3;
			}
			if (!handled && !positional && argument.text == "--format") {
				handled = true;
				mode = 4;
			}
			if (!handled && !positional && argument.text == "--emit-llvm") {
				handled = true;
				mode = 1;
			}
			if (!handled && !positional && argument.text == "-c") {
				handled = true;
				mode = 2;
			}
			if (!handled && !positional && argument.text == "-O0") {
				handled = true;
				level = 0;
			}
			if (!handled && !positional && argument.text == "-O2") {
				handled = true;
				level = 2;
			}
			if (!handled && !positional && argument.text == "-o") {
				if (output_index != 0 || i + 1 >= count) {
					throw new Error("astrac: -o requires one output path");
				}
				i = i + 1;
				var destination = astrac_argument(i);
				if (destination.text.byte_length == 0) {
					throw new Error("astrac: empty output path");
				}
				handled = true;
				output_index = i;
			}
			if (!handled) {
				if (!positional && argument.text.byte_length > 0 && astra_host_text_byte(argument.text, 0) == 45) {
					throw new Error("astrac: unsupported option; use --help");
				}
				if (argument.text.byte_length == 0) {
					throw new Error("astrac: empty source path");
				}
				assert_that(paths.append(move argument));
			}
			i = i + 1;
		}
		var output = astrac_output(output_index);
		if (paths.count() == 0) {
			throw new Error("astrac: source input required; use --help");
		}
		if ((mode == 1 || mode == 2) && output.text.byte_length == 0) {
			throw new Error("astrac: output path required; use -o");
		}
		if ((mode == 0 || mode == 3 || mode == 4) && output.text.byte_length != 0) {
			throw new Error("astrac: check and syntax modes do not publish output");
		}
		return astrac_compile(paths, output, mode, level);
	} catch (Error error) {
		println_stderr(error.message);
		return 1;
	}
}

int main() {
	if (astrac_argument_count() > 1 && astrac_argument_length(1) == 3 && astrac_argument_byte(1, 0) == 100 && astrac_argument_byte(1, 1) == 111 && astrac_argument_byte(1, 2) == 99) return astrac_doc_run();
	int result = astrac_run();
	// All per-compilation owners have been destroyed before LLVM global cleanup.
	LLVMShutdown();
	return result;
}
