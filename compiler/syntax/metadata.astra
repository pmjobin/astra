// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Typed metadata access; copied records store scalar codes for C0 compatibility.
enum SyntaxPolicy {
	INVALID,
	SHARED,
	MONITOR,
	SINGLETON,
	THREAD_BOUND,
	ACTOR,
	ALLOCATOR,
	ALIGN,
	REPR,
	EXCEPTION_ROOT,
	C_CODE,
	FLOATING_POINT,
	UTF8_MESSAGE_FACTORY,
	CALLER_FILE,
	CALLER_LINE,
	CALLER_ARGUMENT,
	C_IMPORT,
	C_EXPORT,
	COM_IMPORT,
	COM_EXPORT,
	GOBJECT_IMPORT,
	GOBJECT_EXPORT,
	REFLECT,
	PURE,
	LAZY,
	NO_ESCAPE,
	MUST_USE,
	DERIVE,
	DEPRECATED,
	TRACKED,
	OBSERVABLE,
	MEMOIZED,
	FOREIGN,
	FOREIGN_CHANNEL,
}
enum SyntaxDispatch {
	DIRECT, VIRTUAL, OVERRIDE
}
SyntaxPolicy syntax_policy_from_code(int code) {
	if (code == 0) {
		return SyntaxPolicy.INVALID();
	}
	if (code == 1) {
		return SyntaxPolicy.SHARED();
	}
	if (code == 2) {
		return SyntaxPolicy.MONITOR();
	}
	if (code == 3) {
		return SyntaxPolicy.SINGLETON();
	}
	if (code == 4) {
		return SyntaxPolicy.THREAD_BOUND();
	}
	if (code == 5) {
		return SyntaxPolicy.ACTOR();
	}
	if (code == 6) {
		return SyntaxPolicy.ALLOCATOR();
	}
	if (code == 7) {
		return SyntaxPolicy.ALIGN();
	}
	if (code == 8) {
		return SyntaxPolicy.REPR();
	}
	if (code == 9) {
		return SyntaxPolicy.EXCEPTION_ROOT();
	}
	if (code == 10) {
		return SyntaxPolicy.C_CODE();
	}
	if (code == 11) {
		return SyntaxPolicy.FLOATING_POINT();
	}
	if (code == 12) {
		return SyntaxPolicy.UTF8_MESSAGE_FACTORY();
	}
	if (code == 13) {
		return SyntaxPolicy.CALLER_FILE();
	}
	if (code == 14) {
		return SyntaxPolicy.CALLER_LINE();
	}
	if (code == 15) {
		return SyntaxPolicy.CALLER_ARGUMENT();
	}
	if (code == 16) {
		return SyntaxPolicy.C_IMPORT();
	}
	if (code == 17) {
		return SyntaxPolicy.C_EXPORT();
	}
	if (code == 18) {
		return SyntaxPolicy.COM_IMPORT();
	}
	if (code == 19) {
		return SyntaxPolicy.COM_EXPORT();
	}
	if (code == 20) {
		return SyntaxPolicy.GOBJECT_IMPORT();
	}
	if (code == 21) {
		return SyntaxPolicy.GOBJECT_EXPORT();
	}
	if (code == 22) {
		return SyntaxPolicy.REFLECT();
	}
	if (code == 23) {
		return SyntaxPolicy.PURE();
	}
	if (code == 24) {
		return SyntaxPolicy.LAZY();
	}
	if (code == 25) {
		return SyntaxPolicy.NO_ESCAPE();
	}
	if (code == 26) {
		return SyntaxPolicy.MUST_USE();
	}
	if (code == 27) {
		return SyntaxPolicy.DERIVE();
	}
	if (code == 28) {
		return SyntaxPolicy.DEPRECATED();
	}
	if (code == 29) {
		return SyntaxPolicy.TRACKED();
	}
	if (code == 30) {
		return SyntaxPolicy.OBSERVABLE();
	}
	if (code == 31) {
		return SyntaxPolicy.MEMOIZED();
	}
	if (code == 32) {
		return SyntaxPolicy.FOREIGN();
	}
	if (code == 33) {
		return SyntaxPolicy.FOREIGN_CHANNEL();
	}
	assert_that(false);
	return SyntaxPolicy.INVALID();
}
SyntaxDispatch syntax_dispatch_from_code(int code) {
	if (code == 0) {
		return SyntaxDispatch.DIRECT();
	}
	if (code == 1) {
		return SyntaxDispatch.VIRTUAL();
	}
	assert_that(code == 2);
	return SyntaxDispatch.OVERRIDE();
}
