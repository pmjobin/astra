TokenKind keyword_kind(string text) {
	if (text == "async") { return TokenKind.ASYNC(); }
	if (text == "await") { return TokenKind.AWAIT(); }
	if (text == "throws") { return TokenKind.THROWS(); }
	if (text == "throw") { return TokenKind.THROW(); }
	if (text == "try") { return TokenKind.TRY(); }
	if (text == "catch") { return TokenKind.CATCH(); }
	if (text == "enum") { return TokenKind.ENUM(); }
	if (text == "match") { return TokenKind.MATCH(); }
	if (text == "case") { return TokenKind.CASE(); }
	if (text == "struct") { return TokenKind.STRUCT(); }
	if (text == "class") { return TokenKind.CLASS(); }
	if (text == "this") { return TokenKind.THIS(); }
	if (text == "extern") { return TokenKind.EXTERN(); }
	if (text == "export") { return TokenKind.EXPORT(); }
	if (text == "return") { return TokenKind.RETURN(); }
	if (text == "true") { return TokenKind.TRUE(); }
	if (text == "false") { return TokenKind.FALSE(); }
	if (text == "null") { return TokenKind.NULL(); }
	if (text == "if") { return TokenKind.IF(); }
	if (text == "else") { return TokenKind.ELSE(); }
	if (text == "while") { return TokenKind.WHILE(); }
	if (text == "for") { return TokenKind.FOR(); }
	if (text == "foreach") { return TokenKind.FOREACH(); }
	if (text == "with") { return TokenKind.WITH(); }
	if (text == "nonnull") { return TokenKind.NONNULL(); }
	if (text == "break") { return TokenKind.BREAK(); }
	if (text == "all") { return TokenKind.ALL(); }
	if (text == "as") { return TokenKind.AS(); }
	if (text == "any") { return TokenKind.ANY(); }
	if (text == "dot_wrap") { return TokenKind.DOT_WRAP(); }
	if (text == "mac_wrap") { return TokenKind.MAC_WRAP(); }
	if (text == "sat_add") { return TokenKind.SAT_ADD(); }
	if (text == "sat_sub") { return TokenKind.SAT_SUB(); }
	if (text == "widen_low") { return TokenKind.WIDEN_LOW(); }
	if (text == "widen_high") { return TokenKind.WIDEN_HIGH(); }
	if (text == "pack_wrap") { return TokenKind.PACK_WRAP(); }
	if (text == "pack_sat") { return TokenKind.PACK_SAT(); }
	if (text == "interleave_low") { return TokenKind.INTERLEAVE_LOW(); }
	if (text == "interleave_high") { return TokenKind.INTERLEAVE_HIGH(); }
	if (text == "slice") { return TokenKind.SLICE(); }
	if (text == "len") { return TokenKind.LEN(); }
	if (text == "splat") { return TokenKind.SPLAT(); }
	if (text == "insert") { return TokenKind.INSERT(); }
	if (text == "shuffle") { return TokenKind.SHUFFLE(); }
	if (text == "select") { return TokenKind.SELECT(); }
	if (text == "borrowed") { return TokenKind.BORROWED(); }
	if (text == "owned") { return TokenKind.OWNED(); }
	if (text == "const") { return TokenKind.CONST(); }
	if (text == "var") { return TokenKind.VAR(); }
	if (text == "move") { return TokenKind.MOVE(); }
	if (text == "release") { return TokenKind.RELEASE(); }
	if (text == "swap") { return TokenKind.SWAP(); }
	if (text == "continue") { return TokenKind.CONTINUE(); }
	if (text == "dot") { return TokenKind.DOT_F32(); }
	if (text == "mac") { return TokenKind.MAC_F32(); }
	return TokenKind.IDENTIFIER();
}
