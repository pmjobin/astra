	SyntaxTokenId get_token_abi_identifier(SyntaxNodeId id) {
		var kind = this.kind(id);
		if (kind == SyntaxKind.FunctionDeclarationSyntax()) {
			var data = this.function_declaration(id);
			return data.f_abi_identifier;
		}
		if (kind == SyntaxKind.LifecycleDeclarationSyntax()) {
			var data = this.lifecycle_declaration(id);
			return data.f_abi_identifier;
		}
		assert_that(false);
		SyntaxTokenId absent = {index = 0};
		return absent;
	}
	void set_token_abi_identifier(SyntaxNodeId id, SyntaxTokenId value) {
		var kind = this.kind(id);
		if (kind == SyntaxKind.FunctionDeclarationSyntax()) {
			var data = this.function_declaration(id);
			data.f_abi_identifier = value;
			this.replace_function_declaration(id, data);
			return;
		}
		if (kind == SyntaxKind.LifecycleDeclarationSyntax()) {
			var data = this.lifecycle_declaration(id);
			data.f_abi_identifier = value;
			this.replace_lifecycle_declaration(id, data);
			return;
		}
		assert_that(false);
	}
