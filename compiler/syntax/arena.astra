	}
	SyntaxSourceId add_source_text(string path, string text, bool native_interface) throws Error {
		var bytes = new u8[text.byte_length];
		int i = 0;
		while (i < len(bytes)) {
			bytes[i] = astra_host_text_byte(text, i) as u8;
			i = i + 1;
		}
		var buffer = source_buffer(path, move bytes, native_interface);
		var shared = shared_acquire(move buffer);
		return this.add_generated_source(move shared);
	}
