	void append_node(SyntaxListId list, SyntaxNodeId node) {
		assert_that(list.index > 0 && list.index <= this.lists.count() && node.index > 0);
		int expected = syntax_list_element(this.lists.entries[list.index - 1]);
		assert_that(expected > 0);
		this.check_node(node, syntax_kind_from_code(expected));
		syntax_list_append(this.lists.entries[list.index - 1], node.index);
	}
	void append_token(SyntaxListId list, SyntaxTokenId token) {
		this.check_list(list, -1);
