		this.text_literal_expression_used = checkpoint.text_literal_expression_used;
		assert_that(checkpoint.text_member_expression_used <= this.text_member_expression_used);
		this.text_member_expression_used = checkpoint.text_member_expression_used;
		assert_that(checkpoint.throw_statement_used <= this.throw_statement_used);
		this.throw_statement_used = checkpoint.throw_statement_used;
		assert_that(checkpoint.try_statement_used <= this.try_statement_used);
		this.try_statement_used = checkpoint.try_statement_used;
		assert_that(checkpoint.type_name_used <= this.type_name_used);
		this.type_name_used = checkpoint.type_name_used;
		assert_that(checkpoint.utf8_factory_expression_used <= this.utf8_factory_expression_used);
		this.utf8_factory_expression_used = checkpoint.utf8_factory_expression_used;
		assert_that(checkpoint.vector_dot_expression_used <= this.vector_dot_expression_used);
		this.vector_dot_expression_used = checkpoint.vector_dot_expression_used;
		assert_that(checkpoint.vector_extract_expression_used <= this.vector_extract_expression_used);
		this.vector_extract_expression_used = checkpoint.vector_extract_expression_used;
		assert_that(checkpoint.vector_initializer_used <= this.vector_initializer_used);
		this.vector_initializer_used = checkpoint.vector_initializer_used;
		assert_that(checkpoint.vector_primitive_expression_used <= this.vector_primitive_expression_used);
		this.vector_primitive_expression_used = checkpoint.vector_primitive_expression_used;
		assert_that(checkpoint.vector_reduction_expression_used <= this.vector_reduction_expression_used);
		this.vector_reduction_expression_used = checkpoint.vector_reduction_expression_used;
		assert_that(checkpoint.vector_type_used <= this.vector_type_used);
		this.vector_type_used = checkpoint.vector_type_used;
		assert_that(checkpoint.where_clause_used <= this.where_clause_used);
		this.where_clause_used = checkpoint.where_clause_used;
		assert_that(checkpoint.while_statement_used <= this.while_statement_used);
		this.while_statement_used = checkpoint.while_statement_used;
		assert_that(checkpoint.with_statement_used <= this.with_statement_used);
		this.with_statement_used = checkpoint.with_statement_used;
		while (this.tokens.count() > checkpoint.tokens) {
			var retired = this.tokens.take(this.tokens.count() - 1);
		}
		while (this.texts.count() > checkpoint.texts) {
			var retired = this.texts.take(this.texts.count() - 1);
		}
		while (this.lists.count() > checkpoint.lists) {
			var retired = this.lists.take(this.lists.count() - 1);
		}
		while (this.generated_sources.count() > checkpoint.generated_sources) {
			var retired = this.generated_sources.take(this.generated_sources.count() - 1);
		}
	}
	owned Utf8Message type_message(SyntaxNodeId type) throws Error {
		this.check_node(type, SyntaxKind.TypeNameSyntax());
		assert_that(type.index > 0);
		var output = new Utf8ByteBuilder();
		var stack = new SyntaxTypeWalk();
		stack.node(type);
		int visits = 0;
		while (stack.count > 0) {
			var task = stack.pop();
			if (task.phase == 1) {
				source_append_text(output, "*");
				continue;
			}
			if (task.phase == 2) {
				source_append_text(output, "<");
				continue;
			}
			if (task.phase == 3) {
				source_append_text(output, ">");
				continue;
			}
			if (task.phase == 4) {
				source_append_text(output, ",");
				continue;
			}
			if (task.phase == 5) {
				source_append_text(output, "[");
				continue;
			}
			if (task.phase == 6) {
				source_append_text(output, "]");
				continue;
			}
			if (task.phase == 7) {
				source_append_text(output, "[]");
				continue;
			}
			if (task.phase == 8) {
				source_append_text(output, "[slots]");
				continue;
			}
			if (task.phase == 10) {
				this.write_token(task.token, output);
				continue;
			}
			if (task.phase == 11) {
				var header = this.header(task.node);
				var source = this.source(header.span.source);
				var bytes = source_bytes(shared_borrow(source), header.span.start, header.span.end);
				output.append_bytes(bytes);
				continue;
			}
			visits = visits + 1;
			assert_that(visits <= this.node_count);
			var kind = this.kind(task.node);
			if (kind == SyntaxKind.PointerTypeSyntax()) {
				stack.text(1);
				stack.node(this.get_node_pointee(task.node));
				continue;
			}
			if (kind == SyntaxKind.NonNullTypeSyntax()) {
				source_append_text(output, "nonnull ");
				stack.node(this.get_node_underlying(task.node));
				continue;
			}
			if (kind == SyntaxKind.SharedTypeSyntax()) {
				source_append_text(output, "shared ");
				stack.node(this.get_node_payload(task.node));
				continue;
			}
			if (kind == SyntaxKind.CallableChannelTypeSyntax()) {
				this.write_token(this.get_token_keyword(task.node), output);
				source_append_text(output, " ");
				stack.node(this.get_node_underlying(task.node));
				continue;
			}
			if (kind == SyntaxKind.VectorTypeSyntax()) {
				stack.text(3);
				stack.token(this.get_token_lane_count(task.node));
				stack.text(2);
				stack.node(this.get_node_element_type(task.node));
				continue;
			}
			if (kind == SyntaxKind.ArrayTypeSyntax()) {
				stack.text(6);
				stack.raw(this.get_node_extent(task.node));
				stack.text(5);
				stack.node(this.get_node_element_type(task.node));
				continue;
			}
			if (kind == SyntaxKind.SliceTypeSyntax()) {
				stack.text(7);
				stack.node(this.get_node_element_type(task.node));
				continue;
			}
			if (kind == SyntaxKind.OwnerSlotsTypeSyntax()) {
				stack.text(8);
				stack.node(this.get_node_element(task.node));
				continue;
			}
			var qualifier = this.get_token_namespace_qualifier(task.node);
			if (qualifier.index != 0) {
				this.write_token(qualifier, output);
				source_append_text(output, ".");
			}
			this.write_token(this.get_token_identifier(task.node), output);
			if (kind == SyntaxKind.GenericTypeApplicationSyntax()) {
				source_append_text(output, "<");
				stack.text(3);
				var arguments = this.get_list_type_arguments(task.node);
				int i = this.list_count(arguments);
				while (i > 0) {
					i = i - 1;
					stack.node(this.node_at(arguments, i));
					if (i > 0) {
						stack.text(4);
					}
				}
				continue;
			}
			var stars = this.get_list_stars(task.node);
			int i = 0;
			while (i < this.list_count(stars)) {
				source_append_text(output, "*");
				i = i + 1;
			}
		}
		var result = output.snapshot();
		return move result;
	}
	int payload_length(SyntaxTokenId token) {
		assert_that(token.index > 0);
		this.check_token(token);
		return syntax_token_payload_length(this.tokens.entries[token.index - 1]);
	}
	owned Utf8Message payload_hex(SyntaxTokenId token) throws Error {
		assert_that(token.index > 0);
		this.check_token(token);
		var output = new Utf8ByteBuilder();
		syntax_token_payload_hex(this.tokens.entries[token.index - 1], output);
		var result = output.snapshot();
		return move result;
	}
	bool computed_is_async(SyntaxNodeId node) {
		var token = this.get_token_async_keyword(node);
		return token.index != 0;
	}
	bool computed_is_lazy(SyntaxNodeId node) {
		var token = this.get_token_lazy_keyword(node);
		return token.index != 0;
	}
	bool computed_is_constructor(SyntaxNodeId node) {
		var name = this.get_token_name(node);
		return this.token_is(name, "init");
	}
	bool computed_is_rethrow(SyntaxNodeId node) {
		var expression = this.get_node_expression(node);
		return expression.index == 0;
	}
	bool computed_is_c_import(SyntaxNodeId node) {
		var introducer = this.get_token_extern_keyword(node);
		if (introducer.index != 0) {
			return true;
		}
		var policy = this.get_node_foreign_policy(node);
		if (policy.index == 0) {
			return false;
		}
		int code = this.get_int_kind(policy);
		return code == syntax_policy_lookup("CImport") || code == syntax_policy_lookup("GObjectImport");
	}
	bool computed_is_c_export(SyntaxNodeId node) {
		var introducer = this.get_token_export_keyword(node);
		if (introducer.index != 0) {
			return true;
		}
		var policy = this.get_node_foreign_policy(node);
		if (policy.index == 0) {
			return false;
		}
		return this.get_int_kind(policy) == syntax_policy_lookup("CExport");
	}
	property int generated_source_count {
		get {
			return this.generated_sources.count();
		}
	}
	SyntaxPolicy policy(SyntaxNodeId node) {
		return syntax_policy_from_code(this.get_int_kind(node));
	}
	SyntaxDispatch dispatch(SyntaxNodeId node) {
		return syntax_dispatch_from_code(this.get_int_dispatch(node));
	}
	SyntaxNodeId get_node_foreign_member(SyntaxNodeId id) { var header = this.header(id); return header.foreign_member; }
	void set_node_foreign_member(SyntaxNodeId id, SyntaxNodeId value) { this.check_node(value, SyntaxKind.ForeignPolicySyntax()); assert_that(id.index > 0 && id.index < this.used); this.headers[id.index].foreign_member = value; }
	bool get_bool_module_internal(SyntaxNodeId id) { var header = this.header(id); return header.module_internal; }
	void set_bool_module_internal(SyntaxNodeId id, bool value) { assert_that(id.index > 0 && id.index < this.used); this.headers[id.index].module_internal = value; }
	SyntaxListId get_list_foreign_channels(SyntaxNodeId id) { var header = this.header(id); return header.foreign_channels; }
	void set_list_foreign_channels(SyntaxNodeId id, SyntaxListId value) { this.check_list(value, syntax_kind_code(SyntaxKind.ForeignPolicySyntax())); assert_that(id.index > 0 && id.index < this.used); this.headers[id.index].foreign_channels = value; }
}
