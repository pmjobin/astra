	void set_node_allocation_context(SyntaxNodeId id, SyntaxNodeId value) {
		var kind = this.kind(id);
		if (kind == SyntaxKind.BufferAllocationSyntax()) {
			var data = this.buffer_allocation(id);
			data.f_allocation_context = value;
			this.replace_buffer_allocation(id, data);
			return;
		}
		if (kind == SyntaxKind.HeapObjectConstructionSyntax()) {
