		this.check_token(data.f_name);
		this.check_token(data.f_open_brace);
		this.check_list(data.f_fields, syntax_kind_code(SyntaxKind.StructFieldDeclarationSyntax()));
		this.check_token(data.f_close_brace);
		this.check_list(data.f_where_clauses, syntax_kind_code(SyntaxKind.WhereClauseSyntax()));
		this.check_node(data.f_foreign_import, SyntaxKind.ForeignPolicySyntax());
		this.check_node(data.f_foreign_export, SyntaxKind.ForeignPolicySyntax());
		this.check_node(data.f_com_export, SyntaxKind.ForeignPolicySyntax());
		this.check_node(data.f_gobject_export, SyntaxKind.ForeignPolicySyntax());
		this.check_list(data.f_type_parameters, -1);
		this.check_node(data.f_parent_class, SyntaxKind.TypeNameSyntax());
		this.check_token(data.f_exception_root);
