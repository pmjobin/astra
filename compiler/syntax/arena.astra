	void validate_class_declaration(ClassDeclarationSyntaxData data) {
		assert_that(data.f_concurrency_policy.kinds >= 0 && data.f_concurrency_policy.kinds <= 31 && data.f_concurrency_policy.admitted >= 0 && data.f_concurrency_policy.admitted <= 31);
