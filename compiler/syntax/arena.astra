	property int node_count {
		get {
			return this.used - 1;
		}
	}
	property int source_count {
		get {
			return this.sources.count;
		}
	}
	owned shared SourceBuffer source(SyntaxSourceId id) {
		if (id.index > 0) {
			var result = this.sources.source(id.index - 1);
			return move result;
		}
		assert_that(id.index < 0 && id.index >= -this.generated_sources.count());
		var selection = new SourceSelection();
		source_entry_select(this.generated_sources.entries[-id.index - 1], selection);
		var result = selection.take();
		return move result;
	}
	SyntaxSourceId add_generated_source(owned shared SourceBuffer source) {
		assert_that(this.generated_sources.count() < 2147483647);
		if (this.generated_sources.count() == this.generated_sources.capacity()) {
			assert_that(this.generated_sources.reserve(syntax_grown_capacity(this.generated_sources.capacity(), this.generated_sources.count() + 1)));
		}
		var entry = new SourceEntry(move source);
		assert_that(this.generated_sources.append(move entry));
		SyntaxSourceId result = {index = -this.generated_sources.count()};
		return result;
	}
	bool valid_span(SyntaxSpan span) {
		if (span.source.index > 0) {
			return this.sources.valid_span(span.source.index - 1, span.start, span.end);
		}
		if (span.source.index == 0 || span.source.index < -this.generated_sources.count()) {
			return false;
		}
		return source_entry_valid_span(this.generated_sources.entries[-span.source.index - 1], span.start, span.end);
	}
	owned SourceSpan source_span(SyntaxSpan span) {
		assert_that(this.valid_span(span));
		var source = this.source(span.source);
		var result = new SourceSpan(move source, span.start, span.end);
		return move result;
	}
	SyntaxHeader header(SyntaxNodeId id) {
		assert_that(id.index > 0 && id.index < this.used);
		return this.headers[id.index];
	}
	SyntaxKind kind(SyntaxNodeId id) {
		var header = this.header(id);
		return syntax_kind_from_code(header.kind_code);
	}
	void check_node(SyntaxNodeId id, SyntaxKind expected) {
		if (id.index == 0) {
			return;
		}
		assert_that(syntax_kind_accepts(this.kind(id), expected));
	}
	void check_token(SyntaxTokenId id) {
		assert_that(id.index >= 0 && id.index <= this.tokens.count());
	}
	void check_text(SyntaxTextId id) {
		assert_that(id.index >= 0 && id.index <= this.texts.count());
	}
	void check_list(SyntaxListId id, int expected) {
		assert_that(id.index >= 0 && id.index <= this.lists.count());
		if (id.index == 0) {
			return;
		}
		assert_that(syntax_list_element(this.lists.entries[id.index - 1]) == expected);
	}
	SyntaxNodeId add_header(SyntaxKind kind, int slot, SyntaxSpan span, int depth) {
		assert_that(this.valid_span(span) && depth >= 0 && this.used < 2147483647);
		if (this.used == len(this.headers)) {
			var replacement = new SyntaxHeader[syntax_grown_capacity(len(this.headers), this.used + 1)];
			int i = 0;
			while (i < this.used) {
				replacement[i] = this.headers[i];
				i = i + 1;
			}
			swap(this.headers, replacement);
		}
		SyntaxNodeId no_member = {index = 0};
		SyntaxListId no_channels = {index = 0};
		SyntaxHeader header = {kind_code = syntax_kind_code(kind), slot = slot, span = span, depth = depth, foreign_member = no_member, module_internal = false, foreign_channels = no_channels};
		this.headers[this.used] = header;
		SyntaxNodeId result = {index = this.used};
		this.used = this.used + 1;
		return result;
	}
	SyntaxTokenId add_token(SyntaxSourceId source, owned Token token) {
		SyntaxSpan span = {source = source, start = token.span.start, end = token.span.end};
		var backing = this.source_span(span);
		assert_that(token.span.same_source(backing));
		assert_that(this.tokens.count() < 2147483647);
		if (this.tokens.count() == this.tokens.capacity()) {
			assert_that(this.tokens.reserve(syntax_grown_capacity(this.tokens.capacity(), this.tokens.count() + 1)));
		}
		if (this.tokens.count() == len(this.token_sources)) {
			var replacement = new int[syntax_grown_capacity(len(this.token_sources), this.tokens.count() + 1)];
			int i = 0;
			while (i < this.tokens.count()) {
				replacement[i] = this.token_sources[i];
				i = i + 1;
			}
			swap(this.token_sources, replacement);
		}
		this.token_sources[this.tokens.count()] = source.index;
		assert_that(this.tokens.append(move token));
		SyntaxTokenId result = {index = this.tokens.count()};
		return result;
	}
	TokenKind token_kind(SyntaxTokenId id) {
		assert_that(id.index > 0);
		this.check_token(id);
		return token_kind_from_code(syntax_token_code(this.tokens.entries[id.index - 1]));
	}
	bool token_is(SyntaxTokenId id, string text) {
		assert_that(id.index > 0);
		this.check_token(id);
		return syntax_token_spelling_is(this.tokens.entries[id.index - 1], text);
	}
	void write_token(SyntaxTokenId id, Utf8ByteBuilder output) {
		assert_that(id.index > 0);
		this.check_token(id);
		syntax_token_write_spelling(this.tokens.entries[id.index - 1], output);
	}
	void write_payload(SyntaxTokenId id, Utf8ByteBuilder output) {
		assert_that(id.index > 0);
		this.check_token(id);
		syntax_token_write_payload(this.tokens.entries[id.index - 1], output);
	}
