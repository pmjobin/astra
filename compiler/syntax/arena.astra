		var bytes = backing.bytes();
		var spelling = utf8_message(bytes);
		var empty = syntax_text("");
		var token = new Token(kind, move backing, false, move spelling, move empty);
		return this.add_token(span.source, move token);
	}
	SyntaxTokenId generated_token(TokenKind kind, SyntaxSpan span, string spelling) throws Error {
		var backing = this.source_span(span);
