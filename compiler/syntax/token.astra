language astra27b;
// Semantic names follow the bootstrap contract; representation is component-local.
enum TokenKind {
	EOF,
	IDENTIFIER,
	SLICE,
	LEN,
	ALL,
	ANY,
	AS,
	DOT_WRAP,
	MAC_WRAP,
	DOT_F32,
	MAC_F32,
	SAT_ADD,
	SAT_SUB,
	WIDEN_LOW,
	WIDEN_HIGH,
	PACK_WRAP,
	PACK_SAT,
	INTERLEAVE_LOW,
	INTERLEAVE_HIGH,
	SPLAT,
	INSERT,
	SHUFFLE,
	SELECT,
	BORROWED,
	INTEGER,
	FLOAT,
	TEXT,
	ENUM,
	MATCH,
	CASE,
	STRUCT,
	CLASS,
	THIS,
	OWNED,
	VAR,
	CONST,
	MOVE,
	RELEASE,
	SWAP,
	DOT,
	EXTERN,
	EXPORT,
	RETURN,
	ASYNC,
	AWAIT,
	THROWS,
	THROW,
	TRY,
	CATCH,
	TRUE,
	FALSE,
	NULL,
	IF,
	ELSE,
	WHILE,
	FOR,
	FOREACH,
	WITH,
	NONNULL,
	BREAK,
	CONTINUE,
	OPEN_PAREN,
	CLOSE_PAREN,
	OPEN_BRACKET,
	CLOSE_BRACKET,
	OPEN_BRACE,
	CLOSE_BRACE,
	COMMA,
	COLON,
	SEMICOLON,
	EQUAL,
	EQUAL_EQUAL,
	BANG,
	BANG_EQUAL,
	AMPERSAND,
	PIPE,
	CARET,
	TILDE,
	SHIFT_LEFT,
	SHIFT_RIGHT,
	ARROW,
	AMPERSAND_AMPERSAND,
	PIPE_PIPE,
	LESS,
	LESS_EQUAL,
	GREATER,
	GREATER_EQUAL,
	PLUS,
	MINUS,
	STAR,
	SLASH,
	PERCENT,
	FAT_ARROW,
	QUESTION,
	COMPOUND_ASSIGNMENT,
	RANGE,
	RANGE_INCLUSIVE,
	INTERPOLATION_START,
	INTERPOLATION_PART,
	INTERPOLATION_END
}

