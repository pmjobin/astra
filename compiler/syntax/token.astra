// Semantic names follow the bootstrap contract; representation is component-local.
enum TokenKind {
	EOF,
	IDENTIFIER,
	SLICE,
	LEN,
	ALL,
	ANY,
	AS,
	DOT_WRAP,
	MAC_WRAP,
	DOT_F32,
	MAC_F32,
	SAT_ADD,
	SAT_SUB,
	WIDEN_LOW,
	WIDEN_HIGH,
	PACK_WRAP,
	PACK_SAT,
	INTERLEAVE_LOW,
	INTERLEAVE_HIGH,
	SPLAT,
	INSERT,
	SHUFFLE,
	SELECT,
	BORROWED,
	INTEGER,
	FLOAT,
	TEXT,
	ENUM,
	MATCH,
	CASE,
	STRUCT,
	CLASS,
	THIS,
	OWNED,
	VAR,
	CONST,
	MOVE,
	RELEASE,
	SWAP,
	DOT,
	EXTERN,
	EXPORT,
	RETURN,
	ASYNC,
	AWAIT,
	THROWS,
	THROW,
	TRY,
	CATCH,
	TRUE,
	FALSE,
	NULL,
	IF,
	ELSE,
	WHILE,
	FOR,
	FOREACH,
	WITH,
	NONNULL,
	BREAK,
	CONTINUE,
	OPEN_PAREN,
	CLOSE_PAREN,
	OPEN_BRACKET,
	CLOSE_BRACKET,
	OPEN_BRACE,
	CLOSE_BRACE,
	COMMA,
	COLON,
	SEMICOLON,
	EQUAL,
	EQUAL_EQUAL,
	BANG,
	BANG_EQUAL,
	AMPERSAND,
	PIPE,
	CARET,
	TILDE,
	SHIFT_LEFT,
	SHIFT_RIGHT,
	ARROW,
	AMPERSAND_AMPERSAND,
	PIPE_PIPE,
	LESS,
	LESS_EQUAL,
	GREATER,
	GREATER_EQUAL,
	PLUS,
	MINUS,
	STAR,
	SLASH,
	PERCENT
}

string token_kind_name(TokenKind kind) {
	match (kind) {
		case TokenKind.EOF(): { return "EOF"; }
		case TokenKind.IDENTIFIER(): { return "IDENTIFIER"; }
		case TokenKind.SLICE(): { return "SLICE"; }
		case TokenKind.LEN(): { return "LEN"; }
		case TokenKind.ALL(): { return "ALL"; }
		case TokenKind.ANY(): { return "ANY"; }
		case TokenKind.AS(): { return "AS"; }
		case TokenKind.DOT_WRAP(): { return "DOT_WRAP"; }
		case TokenKind.MAC_WRAP(): { return "MAC_WRAP"; }
		case TokenKind.DOT_F32(): { return "DOT_F32"; }
		case TokenKind.MAC_F32(): { return "MAC_F32"; }
		case TokenKind.SAT_ADD(): { return "SAT_ADD"; }
		case TokenKind.SAT_SUB(): { return "SAT_SUB"; }
		case TokenKind.WIDEN_LOW(): { return "WIDEN_LOW"; }
		case TokenKind.WIDEN_HIGH(): { return "WIDEN_HIGH"; }
		case TokenKind.PACK_WRAP(): { return "PACK_WRAP"; }
		case TokenKind.PACK_SAT(): { return "PACK_SAT"; }
		case TokenKind.INTERLEAVE_LOW(): { return "INTERLEAVE_LOW"; }
		case TokenKind.INTERLEAVE_HIGH(): { return "INTERLEAVE_HIGH"; }
		case TokenKind.SPLAT(): { return "SPLAT"; }
		case TokenKind.INSERT(): { return "INSERT"; }
		case TokenKind.SHUFFLE(): { return "SHUFFLE"; }
		case TokenKind.SELECT(): { return "SELECT"; }
		case TokenKind.BORROWED(): { return "BORROWED"; }
		case TokenKind.INTEGER(): { return "INTEGER"; }
		case TokenKind.FLOAT(): { return "FLOAT"; }
		case TokenKind.TEXT(): { return "TEXT"; }
		case TokenKind.ENUM(): { return "ENUM"; }
		case TokenKind.MATCH(): { return "MATCH"; }
		case TokenKind.CASE(): { return "CASE"; }
		case TokenKind.STRUCT(): { return "STRUCT"; }
		case TokenKind.CLASS(): { return "CLASS"; }
		case TokenKind.THIS(): { return "THIS"; }
		case TokenKind.OWNED(): { return "OWNED"; }
		case TokenKind.VAR(): { return "VAR"; }
		case TokenKind.CONST(): { return "CONST"; }
		case TokenKind.MOVE(): { return "MOVE"; }
		case TokenKind.RELEASE(): { return "RELEASE"; }
		case TokenKind.SWAP(): { return "SWAP"; }
		case TokenKind.DOT(): { return "DOT"; }
		case TokenKind.EXTERN(): { return "EXTERN"; }
		case TokenKind.EXPORT(): { return "EXPORT"; }
		case TokenKind.RETURN(): { return "RETURN"; }
		case TokenKind.ASYNC(): { return "ASYNC"; }
		case TokenKind.AWAIT(): { return "AWAIT"; }
		case TokenKind.THROWS(): { return "THROWS"; }
		case TokenKind.THROW(): { return "THROW"; }
		case TokenKind.TRY(): { return "TRY"; }
		case TokenKind.CATCH(): { return "CATCH"; }
		case TokenKind.TRUE(): { return "TRUE"; }
		case TokenKind.FALSE(): { return "FALSE"; }
		case TokenKind.NULL(): { return "NULL"; }
		case TokenKind.IF(): { return "IF"; }
		case TokenKind.ELSE(): { return "ELSE"; }
		case TokenKind.WHILE(): { return "WHILE"; }
		case TokenKind.FOR(): { return "FOR"; }
		case TokenKind.FOREACH(): { return "FOREACH"; }
		case TokenKind.WITH(): { return "WITH"; }
		case TokenKind.NONNULL(): { return "NONNULL"; }
		case TokenKind.BREAK(): { return "BREAK"; }
		case TokenKind.CONTINUE(): { return "CONTINUE"; }
		case TokenKind.OPEN_PAREN(): { return "OPEN_PAREN"; }
		case TokenKind.CLOSE_PAREN(): { return "CLOSE_PAREN"; }
		case TokenKind.OPEN_BRACKET(): { return "OPEN_BRACKET"; }
