	int inferred_local_declaration_used;
	int integer_literal_expression_used;
	int lifecycle_declaration_used;
	int local_declaration_used;
	int match_statement_used;
	int move_expression_used;
	int name_expression_used;
	int non_null_type_used;
	int null_pointer_expression_used;
	int owner_slots_type_used;
	int parameter_used;
	int parenthesized_expression_used;
	int pointer_type_used;
	int prefix_expression_used;
	int property_accessor_used;
