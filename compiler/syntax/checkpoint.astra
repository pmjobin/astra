	int throw_statement_used;
	int try_statement_used;
	int type_name_used;
	int utf8_factory_expression_used;
	int vector_dot_expression_used;
	int vector_extract_expression_used;
	int vector_initializer_used;
	int vector_primitive_expression_used;
