// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Development observation v1: a breadth-first walk of typed AST edges.
class SyntaxProjection {
	private owned int[] numbers;
	private owned SyntaxNodeId[] queue;
	private int used;
	private owned int[] source_numbers;
	private int next_source;
	owned Utf8ByteBuilder output;
	init(int nodes, int sources, int generated) {
		this.numbers = new int[nodes + 1];
		this.queue = new SyntaxNodeId[nodes + 1];
		this.source_numbers = new int[sources + generated + 1];
		this.next_source = sources;
		this.used = 0;
		int i = 1;
		while (i <= sources) {
			this.source_numbers[i] = i;
			i = i + 1;
		}
		var output = new Utf8ByteBuilder();
		this.output = move output;
	}
	int reference(SyntaxNodeId node) {
		assert_that(node.index >= 0 && node.index < len(this.numbers));
		if (node.index == 0) {
			return 0;
		}
		if (this.numbers[node.index] == 0) {
			this.queue[this.used] = node;
			this.used = this.used + 1;
			this.numbers[node.index] = this.used;
		}
		return this.numbers[node.index];
	}
	void source_line(SyntaxArena arena, SyntaxSourceId source, int ordinal) throws Error {
		var backing = arena.source(source);
		var path = source_path(shared_borrow(backing));
		source_append_text(this.output, "S ");
		append_int(this.output, ordinal);
		source_append_text(this.output, " ");
		syntax_write_hex(this.output, path.text);
		source_append_text(this.output, " ");
		append_int(this.output, arena.source_length(source));
		source_append_text(this.output, " ");
		if (arena.source_native_interface(source)) {
			source_append_text(this.output, "1");
		} else {
			source_append_text(this.output, "0");
		}
		source_append_text(this.output, "\n");
	}
	int source_number(SyntaxArena arena, SyntaxSourceId source) throws Error {
		int slot = source.index;
		if (slot < 0) {
			slot = arena.source_count - slot;
		}
		assert_that(slot > 0 && slot < len(this.source_numbers));
		if (this.source_numbers[slot] == 0) {
			this.next_source = this.next_source + 1;
			this.source_numbers[slot] = this.next_source;
			this.source_line(arena, source, this.next_source);
		}
		return this.source_numbers[slot];
	}
	void edge(string name, string expected, SyntaxNodeId value) {
		int ordinal = this.reference(value);
		source_append_text(this.output, "E ");
		source_append_text(this.output, name);
		source_append_text(this.output, " ");
		source_append_text(this.output, expected);
		source_append_text(this.output, " ");
		append_int(this.output, ordinal);
		source_append_text(this.output, "\n");
	}
	void boolean(string name, bool value) {
		source_append_text(this.output, "B ");
		source_append_text(this.output, name);
		if (value) {
			source_append_text(this.output, " 1\n");
		} else {
			source_append_text(this.output, " 0\n");
		}
	}
	void integer(string name, int value) {
		source_append_text(this.output, "I ");
		source_append_text(this.output, name);
		source_append_text(this.output, " ");
		append_int(this.output, value);
		source_append_text(this.output, "\n");
	}
	void token(SyntaxArena arena, string name, SyntaxTokenId value) throws Error {
		if (value.index == 0) {
			source_append_text(this.output, "T ");
			source_append_text(this.output, name);
			source_append_text(this.output, " -\n");
			return;
		}
		var span = arena.token_span(value);
		int source = this.source_number(arena, span.source);
		source_append_text(this.output, "T ");
		source_append_text(this.output, name);
		source_append_text(this.output, " ");
		source_append_text(this.output, token_kind_name(arena.token_kind(value)));
		source_append_text(this.output, " ");
		append_int(this.output, source);
		source_append_text(this.output, " ");
		append_int(this.output, span.start);
		source_append_text(this.output, " ");
		append_int(this.output, span.end);
		source_append_text(this.output, " ");
		var spelling = arena.token_message(value);
		syntax_write_hex(this.output, spelling.text);
		source_append_text(this.output, " ");
		var payload = arena.payload_hex(value);
		source_append_text(this.output, payload.text);
		source_append_text(this.output, "\n");
	}
	void text(SyntaxArena arena, string name, SyntaxTextId value) throws Error {
		var text = arena.text_message(value);
		source_append_text(this.output, "X ");
		source_append_text(this.output, name);
		source_append_text(this.output, " ");
		syntax_write_hex(this.output, text.text);
		source_append_text(this.output, "\n");
	}
	void concurrency(string name, SyntaxConcurrency value) {
		source_append_text(this.output, "C ");
		source_append_text(this.output, name);
		source_append_text(this.output, " ");
		if (!value.present) {
			source_append_text(this.output, "-\n");
			return;
		}
		append_int(this.output, value.kinds);
		source_append_text(this.output, " ");
		append_int(this.output, value.admitted);
		source_append_text(this.output, "\n");
	}
	void nodes(SyntaxArena arena, string name, string expected, SyntaxListId list, bool nullable) throws Error {
		source_append_text(this.output, "L ");
		source_append_text(this.output, name);
		source_append_text(this.output, " ");
		if (nullable && list.index == 0) {
			source_append_text(this.output, "-1\n");
			return;
		}
		append_int(this.output, arena.list_count(list));
		source_append_text(this.output, "\n");
		int i = 0;
		while (i < arena.list_count(list)) {
			this.edge(name, expected, arena.node_at(list, i));
			i = i + 1;
		}
	}
	void tokens(SyntaxArena arena, string name, SyntaxListId list, bool nullable) throws Error {
		source_append_text(this.output, "L ");
		source_append_text(this.output, name);
		source_append_text(this.output, " ");
		if (nullable && list.index == 0) {
			source_append_text(this.output, "-1\n");
			return;
		}
		append_int(this.output, arena.list_count(list));
		source_append_text(this.output, "\n");
		int i = 0;
		while (i < arena.list_count(list)) {
			this.token(arena, name, arena.token_at(list, i));
			i = i + 1;
		}
	}
	void fields(SyntaxArena arena, SyntaxNodeId node) throws Error {
		var kind = arena.kind(node);
		if (kind == SyntaxKind.AddressOfExpressionSyntax()) {
			var data = arena.address_of_expression(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "ampersand", data.f_ampersand);
			this.token(arena, "identifier", data.f_identifier);
			return;
		}
		if (kind == SyntaxKind.ArrayInitializerSyntax()) {
			var data = arena.array_initializer(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.nodes(arena, "elements", "ExpressionSyntax", data.f_elements, false);
			return;
		}
		if (kind == SyntaxKind.ArrayStructInitializerSyntax()) {
			var data = arena.array_struct_initializer(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.edge("initializer", "StructInitializerSyntax", data.f_initializer);
			return;
		}
		if (kind == SyntaxKind.ArrayTypeSyntax()) {
			var data = arena.array_type(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "namespace_qualifier", data.f_namespace_qualifier);
			this.token(arena, "identifier", data.f_identifier);
			this.tokens(arena, "stars", data.f_stars, false);
			this.edge("element_type", "TypeNameSyntax", data.f_element_type);
			this.edge("extent", "ExpressionSyntax", data.f_extent);
			return;
		}
		if (kind == SyntaxKind.AssignmentStatementSyntax()) {
			var data = arena.assignment_statement(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "name", data.f_name);
			this.token(arena, "equals_token", data.f_equals_token);
			this.edge("expression", "ExpressionSyntax", data.f_expression);
			this.token(arena, "semicolon", data.f_semicolon);
			return;
		}
		if (kind == SyntaxKind.AsyncRuntimeSyntax()) {
			var data = arena.async_runtime(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "provider", data.f_provider);
			this.token(arena, "name", data.f_name);
			this.edge("error", "TypeNameSyntax", data.f_error);
			this.edge("status", "TypeNameSyntax", data.f_status);
			return;
		}
		if (kind == SyntaxKind.AwaitExpressionSyntax()) {
			var data = arena.await_expression(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "keyword", data.f_keyword);
			this.edge("operation", "ExpressionSyntax", data.f_operation);
			return;
		}
		if (kind == SyntaxKind.AwaitStatementSyntax()) {
			var data = arena.await_statement(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.edge("expression", "AwaitExpressionSyntax", data.f_expression);
			return;
		}
		if (kind == SyntaxKind.BinaryExpressionSyntax()) {
			var data = arena.binary_expression(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.edge("left", "ExpressionSyntax", data.f_left);
			this.token(arena, "operator_token", data.f_operator_token);
			this.edge("right", "ExpressionSyntax", data.f_right);
			return;
		}
		if (kind == SyntaxKind.BlockStatementSyntax()) {
			var data = arena.block_statement(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "open_brace", data.f_open_brace);
			this.nodes(arena, "statements", "StatementSyntax", data.f_statements, false);
			this.token(arena, "close_brace", data.f_close_brace);
			return;
		}
		if (kind == SyntaxKind.BooleanLiteralExpressionSyntax()) {
			var data = arena.boolean_literal_expression(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "literal", data.f_literal);
			return;
		}
		if (kind == SyntaxKind.BreakStatementSyntax()) {
			var data = arena.break_statement(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "keyword", data.f_keyword);
			this.token(arena, "semicolon", data.f_semicolon);
			return;
		}
		if (kind == SyntaxKind.BufferAllocationSyntax()) {
			var data = arena.buffer_allocation(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.edge("allocation_context", "ExpressionSyntax", data.f_allocation_context);
			this.edge("element_type", "TypeNameSyntax", data.f_element_type);
			this.edge("count", "ExpressionSyntax", data.f_count);
			this.edge("failure_call", "ExpressionSyntax", data.f_failure_call);
			return;
		}
		if (kind == SyntaxKind.CCodeEntrySyntax()) {
			var data = arena.c_code_entry(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "key", data.f_key);
			this.token(arena, "value", data.f_value);
			this.text(arena, "decoded_value", data.f_decoded_value);
			return;
		}
		if (kind == SyntaxKind.CallExpressionSyntax()) {
			var data = arena.call_expression(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.boolean("signal_emission", data.f_signal_emission);
			this.nodes(arena, "qualifier_arguments", "TypeNameSyntax", data.f_qualifier_arguments, false);
			this.nodes(arena, "type_arguments", "TypeNameSyntax", data.f_type_arguments, false);
			this.edge("receiver_place", "ExpressionSyntax", data.f_receiver_place);
			this.token(arena, "receiver", data.f_receiver);
			this.token(arena, "member_operator", data.f_member_operator);
			this.token(arena, "identifier", data.f_identifier);
			this.token(arena, "open_paren", data.f_open_paren);
			this.nodes(arena, "arguments", "ExpressionSyntax", data.f_arguments, false);
			this.tokens(arena, "commas", data.f_commas, false);
			this.token(arena, "close_paren", data.f_close_paren);
			return;
		}
		if (kind == SyntaxKind.CallStatementSyntax()) {
			var data = arena.call_statement(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.edge("call", "CallExpressionSyntax", data.f_call);
			this.token(arena, "semicolon", data.f_semicolon);
			return;
		}
		if (kind == SyntaxKind.CallableChannelTypeSyntax()) {
			var data = arena.callable_channel_type(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "namespace_qualifier", data.f_namespace_qualifier);
			this.token(arena, "identifier", data.f_identifier);
			this.tokens(arena, "stars", data.f_stars, false);
			this.token(arena, "keyword", data.f_keyword);
			this.edge("underlying", "TypeNameSyntax", data.f_underlying);
			return;
		}
		if (kind == SyntaxKind.CallerInformationSyntax()) {
			var data = arena.caller_information(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.token(arena, "name", data.f_name);
			this.token(arena, "target", data.f_target);
			return;
		}
		if (kind == SyntaxKind.CatchClauseSyntax()) {
			var data = arena.catch_clause(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.edge("class_name", "TypeNameSyntax", data.f_class_name);
			this.token(arena, "binding", data.f_binding);
			this.edge("body", "BlockStatementSyntax", data.f_body);
			return;
		}
		if (kind == SyntaxKind.ClassDeclarationSyntax()) {
			var data = arena.class_declaration(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.concurrency("concurrency_policy", data.f_concurrency_policy);
			this.nodes(arena, "allocator", "CCodeEntrySyntax", data.f_allocator, true);
			this.nodes(arena, "alignment", "CCodeEntrySyntax", data.f_alignment, true);
			this.nodes(arena, "representation", "CCodeEntrySyntax", data.f_representation, true);
			this.nodes(arena, "members", "SyntaxNode", data.f_members, false);
			this.nodes(arena, "methods", "FunctionDeclarationSyntax", data.f_methods, false);
			this.token(arena, "keyword", data.f_keyword);
			this.token(arena, "name", data.f_name);
			this.token(arena, "open_brace", data.f_open_brace);
			this.nodes(arena, "fields", "StructFieldDeclarationSyntax", data.f_fields, false);
			this.token(arena, "close_brace", data.f_close_brace);
			this.nodes(arena, "where_clauses", "WhereClauseSyntax", data.f_where_clauses, false);
			this.edge("foreign_import", "ForeignPolicySyntax", data.f_foreign_import);
			this.edge("foreign_export", "ForeignPolicySyntax", data.f_foreign_export);
			this.edge("com_export", "ForeignPolicySyntax", data.f_com_export);
			this.edge("gobject_export", "ForeignPolicySyntax", data.f_gobject_export);
			this.boolean("is_interface", data.f_is_interface);
			this.tokens(arena, "type_parameters", data.f_type_parameters, false);
			this.boolean("exact_heap_class", data.f_exact_heap_class);
			this.edge("parent_class", "TypeNameSyntax", data.f_parent_class);
			this.token(arena, "exception_root", data.f_exception_root);
			return;
		}
		if (kind == SyntaxKind.ComImportSyntax()) {
			var data = arena.com_import(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.edge("declaration", "ClassDeclarationSyntax", data.f_declaration);
			this.token(arena, "name", data.f_name);
			this.edge("policy", "ForeignPolicySyntax", data.f_policy);
			return;
		}
		if (kind == SyntaxKind.ComparisonChainSyntax()) {
			var data = arena.comparison_chain(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.nodes(arena, "operands", "ExpressionSyntax", data.f_operands, false);
			this.tokens(arena, "operators", data.f_operators, false);
			return;
		}
		if (kind == SyntaxKind.CompilationUnitSyntax()) {
			var data = arena.compilation_unit(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.nodes(arena, "c_classes", "ClassDeclarationSyntax", data.f_c_classes, false);
			this.nodes(arena, "com_interfaces", "ComImportSyntax", data.f_com_interfaces, false);
			this.token(arena, "namespace_name", data.f_namespace_name);
			this.tokens(arena, "imports", data.f_imports, false);
			this.nodes(arena, "type_applications", "GenericTypeApplicationSyntax", data.f_type_applications, false);
			this.nodes(arena, "async_runtimes", "AsyncRuntimeSyntax", data.f_async_runtimes, false);
			this.nodes(arena, "enums", "EnumDeclarationSyntax", data.f_enums, false);
			this.nodes(arena, "constants", "ConstantDeclarationSyntax", data.f_constants, false);
			this.nodes(arena, "classes", "ClassDeclarationSyntax", data.f_classes, false);
			this.nodes(arena, "functions", "FunctionDeclarationSyntax", data.f_functions, false);
			this.nodes(arena, "structs", "StructDeclarationSyntax", data.f_structs, false);
			this.token(arena, "end_of_file", data.f_end_of_file);
			return;
		}
		if (kind == SyntaxKind.ConstantDeclarationSyntax()) {
			var data = arena.constant_declaration(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
			this.nodes(arena, "foreign_channels", "ForeignPolicySyntax", arena.get_list_foreign_channels(node), false);
			this.edge("type_name", "TypeNameSyntax", data.f_type_name);
			this.token(arena, "name", data.f_name);
			this.edge("initializer", "ExpressionSyntax", data.f_initializer);
			return;
		}
		if (kind == SyntaxKind.ConstructorInitializerSyntax()) {
			var data = arena.constructor_initializer(node);
			this.edge("foreign_member", "ForeignPolicySyntax", arena.get_node_foreign_member(node));
			this.boolean("module_internal", arena.get_bool_module_internal(node));
