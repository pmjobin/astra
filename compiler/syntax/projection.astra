	void walk(SyntaxProgram program) throws Error {
		source_append_text(this.output, "astra-ast-projection/1\n");
		int i = 1;
		while (i <= program.arena.source_count) {
			SyntaxSourceId source = {index = i};
			this.source_line(program.arena, source, i);
			i = i + 1;
		}
		i = 0;
		while (i < program.arena.list_count(program.units)) {
			var root = program.arena.node_at(program.units, i);
			this.edge("unit", "CompilationUnitSyntax", root);
			i = i + 1;
		}
		i = 0;
		while (i < this.used) {
			var node = this.queue[i];
			var header = program.arena.header(node);
			int source = this.source_number(program.arena, header.span.source);
			source_append_text(this.output, "N ");
			append_int(this.output, i + 1);
			source_append_text(this.output, " ");
			source_append_text(this.output, syntax_kind_name(program.arena.kind(node)));
			source_append_text(this.output, " ");
			append_int(this.output, source);
			source_append_text(this.output, " ");
			append_int(this.output, header.span.start);
			source_append_text(this.output, " ");
			append_int(this.output, header.span.end);
			source_append_text(this.output, " ");
			append_int(this.output, header.depth);
			source_append_text(this.output, "\n");
			this.fields(program.arena, node);
			i = i + 1;
		}
	}
}
owned Utf8Message syntax_projection(SyntaxProgram program) throws Error {
	assert_that(!program.failed());
	var visitor = new SyntaxProjection(program.arena.node_count, program.arena.source_count, program.arena.generated_source_count);
	visitor.walk(program);
	var result = visitor.output.snapshot();
	return move result;
}
string syntax_kind_name(SyntaxKind kind) {
	match (kind) {
		case SyntaxKind.AddressOfExpressionSyntax(): {
			return "AddressOfExpressionSyntax";
		}
		case SyntaxKind.ArrayInitializerSyntax(): {
			return "ArrayInitializerSyntax";
		}
		case SyntaxKind.ArrayStructInitializerSyntax(): {
			return "ArrayStructInitializerSyntax";
		}
		case SyntaxKind.ArrayTypeSyntax(): {
			return "ArrayTypeSyntax";
		}
		case SyntaxKind.AssignmentStatementSyntax(): {
			return "AssignmentStatementSyntax";
		}
		case SyntaxKind.AsyncRuntimeSyntax(): {
			return "AsyncRuntimeSyntax";
		}
		case SyntaxKind.AwaitExpressionSyntax(): {
