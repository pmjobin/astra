struct SyntaxInitializerFrame {
	SyntaxTokenId open;
	SyntaxListId fields;
	SyntaxListId commas;
	SyntaxTokenId name;
	SyntaxTokenId equals_token;
	int state;
}

struct SyntaxDumpTask {
	int phase;
	SyntaxNodeId node;
	int indentation;
}

class SyntaxDumpWalk {
	private owned SyntaxDumpTask[] tasks;
	private int used;

	init() {
		this.tasks = new SyntaxDumpTask[0];
		this.used = 0;
	}

	property int count {
		get {
			return this.used;
		}
	}

	void push(int phase, SyntaxNodeId node, int indentation) {
		assert_that(this.used < 2147483647);
		if (this.used == len(this.tasks)) {
			var replacement = new SyntaxDumpTask[syntax_grown_capacity(len(this.tasks), this.used + 1)];
			int i = 0;
			while (i < this.used) {
				replacement[i] = this.tasks[i];
				i = i + 1;
			}
			swap(this.tasks, replacement);
		}
		SyntaxDumpTask task = {phase = phase, node = node, indentation = indentation};
		this.tasks[this.used] = task;
		this.used = this.used + 1;
	}

	SyntaxDumpTask pop() {
		assert_that(this.used > 0);
		this.used = this.used - 1;
		return this.tasks[this.used];
	}
}
