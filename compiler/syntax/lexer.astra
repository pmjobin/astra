// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
bool syntax_identifier_start(int value) {
	return (value >= 97 && value <= 122) || (value >= 65 && value <= 90) || value == 95;
}

bool syntax_digit(int value) { return value >= 48 && value <= 57; }

class Lexer {
	private owned shared SourceBuffer source;
	private int offset;
	private owned int[] comments;
	private int comments_used;
	int error_start;
	int error_end;
	owned Utf8Message error_message;

	init(owned shared SourceBuffer source, owned Utf8Message empty) {
		this.source = move source;
		this.offset = 0;
		this.comments = new int[0];
		this.comments_used = 0;
		this.error_start = 0;
		this.error_end = 0;
		this.error_message = move empty;
	}

	property int cursor { get { return this.offset; } }

	property bool failed { get { return this.error_message.text.byte_length != 0; } }

	property int comment_count { get { return this.comments_used / 2; } }

	owned SourceSpan span(int start, int end) {
		var retained = shared_clone(this.source);
		var result = new SourceSpan(move retained, start, end);
		return move result;
	}

	owned SourceSpan comment(int index) {
		assert_that(index >= 0 && index < this.comment_count);
		var result = this.span(this.comments[index * 2], this.comments[index * 2 + 1]);
		return move result;
	}

	void add_comment(int start, int end) {
		if (this.comments_used + 2 > len(this.comments)) {
			var replacement = new int[len(this.comments) * 2 + 2];
			int i = 0;
			while (i < this.comments_used) {
				replacement[i] = this.comments[i];
				i = i + 1;
			}
			swap(this.comments, replacement);
		}
		this.comments[this.comments_used] = start;
		this.comments[this.comments_used + 1] = end;
		this.comments_used = this.comments_used + 2;
	}

	void fail(int start, int end, string message) throws Error {
		this.error_start = start;
		this.error_end = end;
		var text = syntax_text(message);
		this.error_message = move text;
	}

	void validate() throws Error {
		var backing = shared_clone(this.source);
		int at = syntax_encoding_error(shared_borrow(backing));
		if (at >= 0) this.fail(at, at + 1, syntax_encoding_message(shared_borrow(backing), at));
	}

	owned Lexer fork() throws Error {
		var retained = shared_clone(this.source);
		var message = syntax_text(this.error_message.text);
		var result = new Lexer(move retained, move message);
		result.offset = this.offset;
		result.error_start = this.error_start;
		result.error_end = this.error_end;
		return move result;
	}

	int byte_at(int at) throws Error { var backing = shared_clone(this.source); return syntax_byte(shared_borrow(backing), at); }

	bool skip_trivia() throws Error {
		var backing = shared_clone(this.source);
		int length = syntax_length(shared_borrow(backing));
		while (this.offset < length) {
			int value = this.byte_at(this.offset);
			if (value == 32 || (value >= 9 && value <= 13)) {
				this.offset = this.offset + 1;
				continue;
			}
			if (value != 47 || this.offset + 1 == length) break;
			int next = this.byte_at(this.offset + 1);
			int start = this.offset;
			if (next == 47) {
				this.offset = this.offset + 2;
				while (this.offset < length && this.byte_at(this.offset) != 10 && this.byte_at(this.offset) != 13) this.offset = this.offset + 1;
				this.add_comment(start, this.offset);
			} else {
				if (next != 42) break;
				this.offset = this.offset + 2;
				while (this.offset + 1 < length && !(this.byte_at(this.offset) == 42 && this.byte_at(this.offset + 1) == 47)) this.offset = this.offset + 1;
				if (this.offset + 1 >= length) {
					this.fail(start, start + 2, "unterminated block comment");
					return false;
				}
				this.offset = this.offset + 2;
				this.add_comment(start, this.offset);
			}
		}
		return true;
	}

	owned Token token(TokenKind kind, int start, owned Utf8Message payload) throws Error {
		var span = this.span(start, this.offset);
		var bytes = span.bytes();
		var spelling = utf8_message(bytes);
		var result = new Token(kind, move span, false, move spelling, move payload);
		return move result;
	}

	// After failure the returned placeholder is ignored; failed and diagnostic
	// fields are authoritative. No further cursor/trivia changes occur.
	owned Token stopped() throws Error {
		var empty = syntax_text("");
		var result = this.token(TokenKind.EOF(), this.offset, move empty);
		return move result;
	}

	owned Token next_token() throws Error {
		if (this.failed || !this.skip_trivia()) {
			var result = this.stopped();
			return move result;
		}
		int start = this.offset;
		int value = this.byte_at(this.offset);
		if (value < 0) {
			var result = this.stopped();
			return move result;
		}
		this.offset = this.offset + 1;
		if (value == 34) {
			var retained = shared_clone(this.source);
			var initial = syntax_text("");
			var decoder = new TextLiteralDecoder(move retained, this.offset, move initial);
			var payload = decoder.decode(start);
			this.offset = decoder.offset;
			if (decoder.error_message.text != "") {
				this.fail(decoder.error_start, decoder.error_end, decoder.error_message.text);
				var result = this.stopped(); return move result;
			}
			var result = this.token(TokenKind.TEXT(), start, move payload); return move result;
		}
		TokenKind kind = TokenKind.IDENTIFIER();
		if (syntax_identifier_start(value)) {
			while (syntax_identifier_start(this.byte_at(this.offset)) || syntax_digit(this.byte_at(this.offset))) this.offset = this.offset + 1;
			var span = this.span(start, this.offset);
			var bytes = span.bytes();
			var spelling = utf8_message(bytes);
			kind = keyword_kind(spelling.text);
		} else {
			if (syntax_digit(value)) {
				kind = TokenKind.INTEGER();
				while (syntax_digit(this.byte_at(this.offset))) this.offset = this.offset + 1;
				if (this.byte_at(this.offset) == 46 && syntax_digit(this.byte_at(this.offset + 1))) {
					kind = TokenKind.FLOAT();
					this.offset = this.offset + 2;
					while (syntax_digit(this.byte_at(this.offset))) this.offset = this.offset + 1;
				}
				if (this.byte_at(this.offset) == 101 || this.byte_at(this.offset) == 69) {
					kind = TokenKind.FLOAT();
					this.offset = this.offset + 1;
					if (this.byte_at(this.offset) == 43 || this.byte_at(this.offset) == 45) this.offset = this.offset + 1;
					int exponent_start = this.offset;
					while (syntax_digit(this.byte_at(this.offset))) this.offset = this.offset + 1;
					if (this.offset == exponent_start) {
						this.fail(start, this.offset, "floating literal exponent requires digits");
						var result = this.stopped(); return move result;
					}
				}
				if (kind == TokenKind.FLOAT()) {
					int suffix = this.byte_at(this.offset);
					if (suffix == 102 || suffix == 70 || suffix == 100 || suffix == 68) this.offset = this.offset + 1;
				}
			} else {
				kind = this.operator_kind(value);
				if (this.failed) {
					var result = this.stopped();
					return move result;
				}
			}
		}
		var empty = syntax_text("");
		var result = this.token(kind, start, move empty);
		return move result;
	}

	TokenKind operator_kind(int value) throws Error {
		int next = this.byte_at(this.offset);
		if (value == 38 && next == 38) {
			this.offset = this.offset + 1;
			return TokenKind.AMPERSAND_AMPERSAND();
		}
		if (value == 124 && next == 124) {
			this.offset = this.offset + 1;
			return TokenKind.PIPE_PIPE();
		}
		if (value == 60 && next == 60) {
			this.offset = this.offset + 1;
			return TokenKind.SHIFT_LEFT();
		}
		if (value == 62 && next == 62) {
			this.offset = this.offset + 1;
			return TokenKind.SHIFT_RIGHT();
		}
		if (value == 61 && next == 61) {
			this.offset = this.offset + 1;
			return TokenKind.EQUAL_EQUAL();
		}
		if (value == 33 && next == 61) {
			this.offset = this.offset + 1;
			return TokenKind.BANG_EQUAL();
		}
		if (value == 60 && next == 61) {
			this.offset = this.offset + 1;
			return TokenKind.LESS_EQUAL();
		}
		if (value == 62 && next == 61) {
			this.offset = this.offset + 1;
			return TokenKind.GREATER_EQUAL();
		}
		if (value == 45 && next == 62) {
			this.offset = this.offset + 1;
			return TokenKind.ARROW();
		}
		if (value == 58) return TokenKind.COLON();
		if (value == 40) return TokenKind.OPEN_PAREN();
		if (value == 41) return TokenKind.CLOSE_PAREN();
		if (value == 91) return TokenKind.OPEN_BRACKET();
		if (value == 93) return TokenKind.CLOSE_BRACKET();
		if (value == 123) return TokenKind.OPEN_BRACE();
		if (value == 125) return TokenKind.CLOSE_BRACE();
		if (value == 46) return TokenKind.DOT();
		if (value == 44) return TokenKind.COMMA();
		if (value == 59) return TokenKind.SEMICOLON();
		if (value == 61) return TokenKind.EQUAL();
		if (value == 33) return TokenKind.BANG();
		if (value == 60) return TokenKind.LESS();
		if (value == 62) return TokenKind.GREATER();
		if (value == 43) return TokenKind.PLUS();
		if (value == 38) return TokenKind.AMPERSAND();
		if (value == 124) return TokenKind.PIPE();
		if (value == 94) return TokenKind.CARET();
		if (value == 126) return TokenKind.TILDE();
		if (value == 45) return TokenKind.MINUS();
		if (value == 42) return TokenKind.STAR();
		if (value == 47) return TokenKind.SLASH();
		if (value == 37) return TokenKind.PERCENT();
		int width = 1;
		if (value >= 128) {
			width = 2;
			if (value >= 224) width = 3;
			if (value >= 240) width = 4;
			this.fail(this.offset - 1, this.offset - 1 + width, "non-ASCII character is not supported outside comments");
		} else {
			var message = new Utf8ByteBuilder();
			source_append_text(message, "unexpected character '");
			if (value == 92) {
				source_append_text(message, "\\\\");
			}
			else {
				if (value == 8) {
					source_append_text(message, "\\b");
				}
				else { if (value < 32 || value == 127) {
						u8[4] octal = {92, (48 + value / 64) as u8, (48 + (value / 8) % 8) as u8, (48 + value % 8) as u8};
						message.append_bytes(slice(octal));
					} else {
						u8[1] byte = {value as u8};
						message.append_bytes(slice(byte));
					} }
			}
			source_append_text(message, "'");
			var text = message.snapshot();
			this.fail(this.offset - 1, this.offset, text.text);
		}
		return TokenKind.EOF();
	}
}

owned Lexer lexer(owned shared SourceBuffer source) throws Error {
	var empty = syntax_text("");
	var result = new Lexer(move source, move empty);
	result.validate();
	return move result;
}
