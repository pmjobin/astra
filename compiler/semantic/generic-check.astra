// Independent consumer reconstructs substitution from declaration/argument
// edges. Any reuse of checked root proofs is local to this invocation.
bool generic_checked_instance_verified(CheckedIndex index, GenericInstance plan) {
	var origin = index.bindings.symbol(plan.origin); var concrete = index.bindings.symbol(plan.concrete); var node = origin.node;
	if (origin.kind == 18) return class_getter_signature_verified(index, plan);
	int ordinal = index.symbol_signatures[plan.concrete.index].index;
	if (ordinal < 1 || ordinal > index.signature_count) return false;
	var result = index.signatures[ordinal - 1]; var bound_node = index.bindings.program.arena.get_node_throws_class(node); int source_flags = index.symbol_flags[plan.origin.index];
	if (result.declaration.index != plan.concrete.index || result.callable.index != index.symbol_types[plan.concrete.index].index) return false;
	if (bound_node.index == 0) return (source_flags & 64) == 0 && (result.flags & 64) == 0 && result.error.index == 0;
	// A template has a typed callable and source bound, never an executable
	// signature row. Compare the actual concrete signature to those facts.
	if (!index.native_abi || !index.semantic_admission || !index.class_storage || index.symbol_signatures[plan.origin.index].index != 0 || (source_flags & (8 | 16 | 32 | 64)) != 64 || !checked_effect_signature_verified(index, result) || result.dispatch != 0) return false;
	var pattern = index.symbol_types[plan.origin.index];
	if (!index.types.valid_id(pattern) || !index.types.valid_id(result.callable) || index.types.row(pattern).kind != 25 || index.types.row(result.callable).kind != 25 || index.types.row(pattern).count < 1 || index.types.row(result.callable).count < 1) return false;
	if (generic_channel_flags(index, index.types.argument(index.types, pattern, 0).type, index.types.argument(index.types, result.callable, 0).type, source_flags) != result.flags) return false;
	var bound = checked_effect_class(index, bound_node); if (bound.index == 0) return false;
	var bound_class = index.bindings.symbol(bound); var parameters = index.bindings.program.arena.get_list_type_parameters(bound_class.node); var error = index.symbol_types[bound.index];
	if (index.bindings.program.arena.list_count(parameters) != 0 || result.error.index != error.index || !checked_effect_bound(index, bound_node, error)) return false;
	if (origin.kind != 1 && origin.kind != 11 || concrete.kind != 1) return false;
	if (origin.kind == 1 && (origin.owner.index != 0 || plan.enclosing.index != 0)) return false;
	if (origin.kind == 11) {
		if (plan.enclosing.index == 0 || !class_storage_source_verified(index, plan.enclosing, false, 0) || origin.owner.index != class_storage_origin(index, plan.enclosing).index) return false;
		var owner = index.bindings.symbol(origin.owner); var fields = index.bindings.program.arena.get_list_fields(owner.node);
		if (!index.field_effects && index.bindings.program.arena.list_count(fields) != 0) return false;
		if (!class_storage_fields_verified(index, plan.enclosing, 0)) return false;
	}
	if (index.bindings.program.arena.kind(node) != SyntaxKind.FunctionDeclarationSyntax() || index.bindings.program.arena.get_node_body(node).index == 0 || index.bindings.program.arena.get_int_dispatch(node) != 0 || index.bindings.program.arena.get_token_extern_keyword(node).index != 0 || index.bindings.program.arena.get_token_export_keyword(node).index != 0 || index.bindings.program.arena.get_token_async_keyword(node).index != 0 || index.bindings.program.arena.get_bool_is_signal(node) || index.bindings.program.arena.get_bool_utf8_factory(node) || index.bindings.program.arena.get_node_foreign_policy(node).index != 0 || index.bindings.program.arena.get_node_foreign_member(node).index != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_foreign_channels(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_ccode(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_floating_point(node)) != 0) return false;
	return checked_effect_bound(index, index.bindings.program.arena.get_node_throws_class(concrete.node), result.error);
}

bool source_type_matches(CheckedIndex index, GenericInstance plan, TypeId pattern, TypeId actual, int depth) {
	if (!index.types.valid_id(pattern) || !index.types.valid_id(actual) || depth > 128) return false;
	var p = index.types.row(pattern); var a = index.types.row(actual);
	if (p.kind == 33) {
		var symbol = index.bindings.symbol(p.nominal);
		if (symbol.owner.index != plan.origin.index) {
			var enclosing = plan.enclosing;
			if (enclosing.index == 0) return false;
			int outer = generic_instance_for(index, index.types.row(enclosing).nominal);
			if (outer == 0) return false;
			return source_type_matches(index, index.instances[outer - 1], pattern, actual, depth + 1);
		}
		var declaration = index.bindings.symbol(plan.origin);
		var params = index.bindings.program.arena.get_list_type_parameters(declaration.node); int i = 0;
		while (i < plan.argument_count) {
			if (index.bindings.program.arena.token_at(params, i).index == symbol.token.index) return generic_argument(index, plan, i).type.index == actual.index;
			i = i + 1;
		}
		return false;
	}
	if (p.kind == 34 && (a.kind == 30 || a.kind == 31)) {
		int instance = generic_instance_for(index, a.nominal);
		if (instance == 0 || generic_origin(index.instances[instance - 1]).index != p.nominal.index || generic_argument_count(index, index.instances[instance - 1]) != p.count) return false;
		int i = 0;
		while (i < p.count) {
			if (!source_type_matches(index, plan, index.types.argument(index.types, pattern, i).type, generic_argument(index, index.instances[instance - 1], i).type, depth + 1)) return false;
			i = i + 1;
		}
		return true;
	}
	if (p.kind != a.kind || p.nominal.index != a.nominal.index || p.extent != a.extent || p.count != a.count) return false;
	int i = 0;
	while (i < p.count) {
		var pe = index.types.argument(index.types, pattern, i); var ae = index.types.argument(index.types, actual, i);
		if (generic_channel_flags(index, pe.type, ae.type, pe.flags) != ae.flags || !source_type_matches(index, plan, pe.type, ae.type, depth + 1)) return false;
		i = i + 1;
	}
	return true;
}

bool generic_type_matches(CheckedIndex index, int ordinal, TypeId pattern, TypeId actual, int depth) {
	if (ordinal < 0 || ordinal >= index.instance_count) return false;
	return source_type_matches(index, index.instances[ordinal], pattern, actual, depth);
}

GenericInstance checked_copy_plan(CheckedIndex index, int ordinal) {
	if (ordinal < index.instance_count) return index.instances[ordinal];
	return index.direct_methods[ordinal - index.instance_count];
}

bool direct_method_declaration_verified(CheckedIndex index, GenericInstance plan) {
	if (!index.native_abi || !index.class_storage || !index.field_effects || plan.origin.index < 1 || plan.origin.index > index.generic_symbols || plan.argument_count != 0 || !index.types.valid_id(plan.enclosing)) return false;
	var source = index.bindings.symbol(plan.origin); var owner = index.types.row(plan.enclosing);
	if (source.kind == 18) return class_getter_plan_verified(index, plan);
	if (source.kind != 11 && source.kind != 12 || owner.kind != 31 || owner.nominal.index != source.owner.index || source.owner.index < 1 || source.owner.index > index.generic_symbols) return false;
	var declaration = index.bindings.symbol(source.owner);
	if (declaration.kind != 4 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_parameters(declaration.node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_parameters(source.node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_where_clauses(source.node)) != 0 || index.bindings.program.arena.get_int_dispatch(source.node) != 0 || index.bindings.program.arena.get_node_body(source.node).index == 0) return false;
	return true;
}

bool direct_method_source_verified(CheckedIndex index, GenericInstance plan) {
	return direct_method_declaration_verified(index, plan) && (class_storage_source_verified(index, plan.enclosing, false, 0) || error_storage_class(index, plan.enclosing));
}

// Inclusive consumer bound: the last permitted node may already be present.
// This consumer does not call the producer's allocation predicate.
bool generic_syntax_count_valid(int originals, int total) {
	if (originals < 0 || total < originals) return false;
	return total - originals <= 262144;
}

int generic_verify_failure(CheckedIndex index) {
	if (!generic_syntax_count_valid(index.generic_nodes, index.bindings.program.arena.node_count)) return 32;
	if (!index.native_abi) {
		if (index.instance_count != 0) return 1;
		int source = 0;
		while (source < len(index.direct_methods)) {
			if (index.direct_methods[source].state != 0 || index.direct_methods[source].concrete.index != 0) return 1;
			source = source + 1;
		}
		return 0;
	}
	if (index.instance_count < 0 || index.instance_count > 256 || index.instance_count > len(index.instances)) return 2;
	var source_classes = new bool[index.types.count + 1];
	int node_slots = 0; int symbol_slots = 0; int scope_slots = 0;
	if (len(index.direct_methods) != index.generic_symbols + 1 || len(index.direct_method_symbols) != len(index.symbol_types) || index.direct_method_symbols[0] != 0) return 33;
	int ordinal = 0;
	while (ordinal < index.instance_count + len(index.direct_methods)) {
		var storage = checked_copy_plan(index, ordinal);
		bool direct = ordinal >= index.instance_count;
		if (direct && storage.state == 0) {
			if (storage.origin.index != 0 || storage.concrete.index != 0 || storage.enclosing.index != 0) return 33;
			ordinal = ordinal + 1;
			continue;
		}
		if (direct && (storage.origin.index != ordinal - index.instance_count || !direct_method_declaration_verified(index, storage) || storage.concrete.index < 1 || storage.concrete.index >= len(index.direct_method_symbols) || index.direct_method_symbols[storage.concrete.index] != storage.origin.index)) return 33;
		if (direct) {
			if (!index.types.valid_id(storage.enclosing)) return 33;
			if (!source_classes[storage.enclosing.index]) {
				if (!class_storage_source_verified(index, storage.enclosing, false, 0) && !error_storage_class(index, storage.enclosing)) return 33;
				source_classes[storage.enclosing.index] = true;
			}
		}
		if (storage.sparse_bindings != direct || !generic_plan_bounds(index, storage) || !generic_symbol_keys_verified(index, storage) || !generic_scope_keys_verified(index, storage)) return 3;
		if (index.generic_node_map[storage.nodes] != 0 || index.generic_symbol_map[storage.symbols] != 0 || index.generic_scope_map[storage.scopes] != 0) return 28;
		if (node_slots > index.generic_node_used - storage.node_count - 1 || symbol_slots > index.generic_symbol_used - storage.symbol_count - 1 || scope_slots > index.generic_scope_used - storage.scope_count - 1) return 29;
		node_slots = node_slots + storage.node_count + 1; symbol_slots = symbol_slots + storage.symbol_count + 1; scope_slots = scope_slots + storage.scope_count + 1;
		int previous = 0;
		while (previous < ordinal) {
			var first = checked_copy_plan(index, previous); var current = storage;
			if (previous >= index.instance_count && first.state == 0) {
				previous = previous + 1;
				continue;
			}
			if (first.concrete.index == current.concrete.index) return 4;
			if (!(first.nodes + first.node_count < current.nodes || current.nodes + current.node_count < first.nodes) || !(first.symbols + first.symbol_count < current.symbols || current.symbols + current.symbol_count < first.symbols) || !(first.scopes + first.scope_count < current.scopes || current.scopes + current.scope_count < first.scopes)) return 27;
			bool same = first.origin.index == current.origin.index && first.enclosing.index == current.enclosing.index && first.argument_count == current.argument_count;
			int argument = 0;
			while (same && argument < first.argument_count) {
				var a = index.generic_arguments[first.arguments + argument]; var b = index.generic_arguments[current.arguments + argument];
				same = a.type.index == b.type.index && a.flags == b.flags; argument = argument + 1;
			}
			if (same) return 5;
			previous = previous + 1;
		}
		var plan_origin = generic_origin(storage);
		var concrete = generic_declaration(storage);
		if (plan_origin.index < 1 || plan_origin.index > index.generic_symbols || concrete.index <= index.generic_symbols || concrete.index > index.bindings.symbol_count || generic_state(storage) != 2) return 6;
		if (!generic_scopes_verified(index, storage)) return 34;
		if (!generic_references_verified(index, storage)) return 7;
		var original = index.bindings.symbol(plan_origin); var clone = index.bindings.symbol(concrete);
		if (generic_symbol(index, storage, plan_origin.index) != concrete.index) return 30;
		bool getter = direct && original.kind == 18;
		bool method = (original.kind == 11 || index.class_storage && (original.kind == 12 || getter)) && clone.kind == 1;
		if (generic_node(index, storage, original.node.index) != clone.node.index || !source_copy_node_verified(index, storage, original.node)) return 26;
		if ((!method && original.kind != clone.kind) || (original.kind != 1 && original.kind != 3 && original.kind != 4 && !method)) return 8;
		if (original.kind == 4 && !generic_class_source(index, plan_origin) && !class_storage_template_verified(index, plan_origin)) return 9;
		SyntaxListId parameters = {index = 0};
		if (!getter) parameters = index.bindings.program.arena.get_list_type_parameters(original.node);
		if (index.bindings.program.arena.list_count(parameters) != generic_argument_count(index, storage) || (generic_argument_count(index, storage) == 0 && !method) || (method != (generic_enclosing(storage).index != 0))) return 10;
		if (!getter && !generic_constraints_verified(index, storage)) return 11;
		int p = 0;
		while (p < generic_argument_count(index, storage)) {
			var argument = generic_argument(index, storage, p);
			if (argument.flags != 0 || !generic_closed(index, argument.type, 0)) return 12;
			p = p + 1;
		}
		// The independently bounded map has no slots outside this window.
		// Check every stored slot and reconstruct each mapped source edge.
		int n = storage.node_first;
		while (n - storage.node_first < storage.node_count) {
			if (generic_node(index, storage, n) != 0) {
				SyntaxNodeId node = {index = n};
				if (!source_copy_node_verified(index, storage, node)) return 13;
				int mapped = generic_node(index, storage, n);
				SyntaxNodeId target_node = {index = mapped};
				var scope = index.bindings.scope_for_node(node);
				if (generic_scope(index, storage, scope.index) != 0) scope.index = generic_scope(index, storage, scope.index);
				if (index.bindings.scope_for_node(target_node).index != scope.index) return 34;
				var pattern = index.uses[n].type;
				if (index.class_storage && pattern.index == 0 && index.bindings.program.arena.kind(node) == SyntaxKind.TypeNameSyntax()) {
					var reference = checked_target(index, node, index.bindings.program.arena.get_token_identifier(node));
					if (reference.index > 0 && index.bindings.symbol(reference).kind == 9) {
						pattern = index.symbol_types[reference.index];
						if (checked_kind(index, pattern) != 33 || index.uses[mapped].flags != 0) return 14;
					}
				}
				if (syntax_kind_accepts(index.bindings.program.arena.kind(node), SyntaxKind.TypeNameSyntax()) && pattern.index != 0 && !source_type_matches(index, storage, pattern, index.uses[mapped].type, 0)) return 15;
			}
			n = n + 1;
		}
		int symbol_at = 0;
		while (symbol_at < storage.symbol_count) {
			n = generic_symbol_source(index, storage, symbol_at);
			int mapped = generic_symbol(index, storage, n);
			if (mapped != 0) {
				if (mapped <= index.generic_symbols || mapped > index.bindings.symbol_count) return 16;
				var source = index.bindings.symbol(type_symbol(n)); var target = index.bindings.symbol(type_symbol(mapped));
				if ((source.kind != target.kind && !((source.kind == 11 || index.class_storage && (source.kind == 12 || getter && source.kind == 18)) && target.kind == 1 && n == plan_origin.index)) || source.token.index != target.token.index || source.name != target.name || source.canonical != target.canonical || source.restricted != target.restricted || generic_node(index, storage, source.node.index) != target.node.index) return 17;
				int owner = source.owner.index;
				if (owner > 0 && generic_symbol(index, storage, owner) != 0) owner = generic_symbol(index, storage, owner);
				if (owner != target.owner.index) return 18;
				int scope = source.scope.index;
				if (generic_scope(index, storage, scope) != 0) scope = generic_scope(index, storage, scope);
				if (target.scope.index != scope) return 34;
				if ((source.kind == 6 || source.kind == 7) && (!source_type_matches(index, storage, index.symbol_types[n], index.symbol_types[mapped], 0) || generic_channel_flags(index, index.symbol_types[n], index.symbol_types[mapped], index.symbol_flags[n]) != index.symbol_flags[mapped])) return 19;
			}
			symbol_at = symbol_at + 1;
		}
		if (original.kind == 1 || method) {
			if (!generic_checked_instance_verified(index, storage)) return 32;
			int signature = index.symbol_signatures[concrete.index].index;
			if (signature < 1 || signature > index.signature_count) return 20;
			var pattern = index.symbol_types[plan_origin.index]; var actual = index.signatures[signature - 1].callable;
			if (getter) {
				if (!class_getter_signature_verified(index, storage)) return 24;
			} else { if (!method) {
					if (!source_type_matches(index, storage, pattern, actual, 0)) return 21;
				} else {
					var actual_shape = index.types.row(actual); var pattern_shape = index.types.row(pattern);
					if (actual_shape.count != pattern_shape.count + 1) return 22;
					var hidden = index.types.argument(index.types, actual, 1);
					if (hidden.type.index != storage.enclosing.index || hidden.flags != 2) return 23;
					int channel = 0;
					while (channel < pattern_shape.count) {
						int position = channel; if (channel > 0) position = position + 1;
						var pe = index.types.argument(index.types, pattern, channel); var ae = index.types.argument(index.types, actual, position);
						if (generic_channel_flags(index, pe.type, ae.type, pe.flags) != ae.flags || !source_type_matches(index, storage, pe.type, ae.type, 0)) return 24;
						channel = channel + 1;
					}
				}
			}
		}
		ordinal = ordinal + 1;
	}
	int concrete = 1;
	while (concrete < len(index.direct_method_symbols)) {
		int origin = index.direct_method_symbols[concrete];
		if (origin != 0) {
			if (origin < 1 || origin >= len(index.direct_methods) || index.direct_methods[origin].state != 2 || index.direct_methods[origin].concrete.index != concrete) return 33;
		}
		concrete = concrete + 1;
	}
	if (node_slots != index.generic_node_used || symbol_slots != index.generic_symbol_used || scope_slots != index.generic_scope_used) return 31;
	if (!generic_calls_verified(index)) return 25;
	return 0;
}

bool generic_verify(CheckedIndex index) {
	return generic_verify_failure(index) == 0;
}

bool generic_capability_verified(CheckedIndex index, TypeId argument, SyntaxTokenId capability) {
	int kind = checked_kind(index, argument);
	if (index.bindings.program.arena.token_is(capability, "Numeric") || index.bindings.program.arena.token_is(capability, "Ordered")) return type_numeric(kind);
	if (index.bindings.program.arena.token_is(capability, "Eq")) return type_numeric(kind) || kind == 13 || kind == 16;
	if (index.bindings.program.arena.token_is(capability, "Bitwise")) return type_integer(kind);
	if (index.bindings.program.arena.token_is(capability, "Shift")) return type_integer(kind);
	if (index.bindings.program.arena.token_is(capability, "Ownable")) return kind == 31;
	if (index.bindings.program.arena.token_is(capability, "ExactHeapClass")) return index.class_storage && class_storage_source_verified(index, argument, true, 0);
	return false;
}

bool generic_constraints_verified(CheckedIndex index, GenericInstance plan) {
	var declaration = index.bindings.symbol(plan.origin);
	var parameters = index.bindings.program.arena.get_list_type_parameters(declaration.node);
	var clauses = index.bindings.program.arena.get_list_where_clauses(declaration.node); int c = 0;
	while (c < index.bindings.program.arena.list_count(clauses)) {
		var clause = index.bindings.program.arena.node_at(clauses, c);
		var subject = index.bindings.program.arena.get_token_type_parameter(clause); int position = -1; int p = 0;
		while (p < plan.argument_count) {
			// Bound source tokens have distinct spans; spelling comparison is only
			// for the declaration's own constraint clause, never type identity.
			var parameter = index.bindings.program.arena.token_at(parameters, p);
			if (generic_token_equal(index, subject, parameter)) position = p;
			p = p + 1;
		}
		if (position < 0) return false;
		var capabilities = index.bindings.program.arena.get_list_capabilities(clause); int a = 0;
		while (a < index.bindings.program.arena.list_count(capabilities)) {
			if (!generic_capability_verified(index, index.generic_arguments[plan.arguments + position].type, index.bindings.program.arena.token_at(capabilities, a))) return false;
			a = a + 1;
		}
		c = c + 1;
	}
	return true;
}

bool generic_calls_verified(CheckedIndex index) {
	// Checked source rows remain immutable throughout this consumer. Rebuild
	// this table on every invocation, after each actual root-depth proof.
	var receiver_classes = new bool[index.types.count + 1];
	int n = 1;
	while (n < len(index.generic_calls)) {
		var target = index.generic_calls[n];
		if (target.index == 0 && index.uses[n].type.index != 0) {
			SyntaxNodeId source = {index = n};
			if (index.bindings.program.arena.kind(source) == SyntaxKind.FieldAccessExpressionSyntax()) {
				var property = checked_target(index, source, index.bindings.program.arena.get_token_field_name(source));
				if (property.index > 0 && class_getter_source_verified(index, property)) {
					var projection = class_property_verified(index, property);
					if (projection.field.index == 0) return false;
				}
			}
		}
		if (target.index != 0) {
			SyntaxNodeId node = {index = n};
			if (index.bindings.program.arena.kind(node) == SyntaxKind.FieldAccessExpressionSyntax()) {
				if (!class_getter_call_verified(index, node, target)) return false;
				n = n + 1;
				continue;
			}
			if (index.bindings.program.arena.kind(node) != SyntaxKind.CallExpressionSyntax()) return false;
			var plan = checked_source_plan(index, target);
			if (plan.state != 2 || plan.concrete.index != target.index) return false;

			var token = index.bindings.program.arena.get_token_identifier(node);
			int r = index.node_references[n]; bool bound = false;
			while (r != 0) {
				var reference = index.bindings.reference(r);
				if (reference.token.index == token.index && reference.state_code == 1 && reference.target.index == plan.origin.index) bound = true;
				r = index.reference_next[r];
			}
			if (plan.enclosing.index != 0) {
				var receiver_token = index.bindings.program.arena.get_token_receiver(node);
				SymbolId receiver = {index = 0};
				if (receiver_token.index != 0) receiver = checked_target(index, node, receiver_token);
				var place = index.bindings.program.arena.get_node_receiver_place(node);
				if (place.index != 0) {
					if (index.uses[place.index].type.index != plan.enclosing.index) return false;
				} else {
					if (receiver.index == 0 || index.symbol_types[receiver.index].index != plan.enclosing.index) return false;
				}
				if (!index.types.valid_id(plan.enclosing)) return false;
				if (!receiver_classes[plan.enclosing.index]) {
					if (!generic_empty_class(index, plan.enclosing) && !class_storage_source_verified(index, plan.enclosing, false, 0) && !error_storage_class(index, plan.enclosing)) return false;
					receiver_classes[plan.enclosing.index] = true;
				}
				int outer_number = generic_instance_for(index, index.types.row(plan.enclosing).nominal);
				var owner = index.types.row(plan.enclosing).nominal;
				if (outer_number > 0) owner = index.instances[outer_number - 1].origin;
				var declaration = index.bindings.symbol(plan.origin);
				if (declaration.kind != 11 || declaration.owner.index != owner.index || !generic_token_equal(index, declaration.token, token)) return false;
				var normalized = checked_call_arguments(index, node);
				var source_arguments = index.bindings.program.arena.get_list_arguments(node);
				int a = 0;
				while (a < index.bindings.program.arena.list_count(source_arguments)) {
					if (index.bindings.program.arena.node_at(source_arguments, a).index != index.bindings.program.arena.node_at(normalized, a + 1).index) return false;
					a = a + 1;
				}
				var hidden = index.bindings.program.arena.node_at(normalized, 0);
				if (index.bindings.program.arena.list_count(normalized) != index.bindings.program.arena.list_count(source_arguments) + 1) return false;
				if (place.index != 0) {
					if (hidden.index != place.index) return false;
				} else {
					if (index.bindings.program.arena.kind(hidden) != SyntaxKind.NameExpressionSyntax() || index.bindings.program.arena.get_token_identifier(hidden).index != receiver_token.index || checked_target(index, hidden, receiver_token).index != receiver.index) return false;
				}
			} else {
				if (!bound) return false;
			}
			var arguments = index.bindings.program.arena.get_list_arguments(node);
			var signature = index.symbol_types[plan.origin.index];
			if (signature.index == 0 || index.types.row(signature).count != index.bindings.program.arena.list_count(arguments) + 1) return false;
			int i = 0;
			while (i < index.bindings.program.arena.list_count(arguments)) {
				var argument = index.bindings.program.arena.node_at(arguments, i);
				if (!source_type_matches(index, plan, index.types.argument(index.types, signature, i + 1).type, index.uses[argument.index].type, 0)) return false;
				i = i + 1;
			}
			var explicit = index.bindings.program.arena.get_list_type_arguments(node);
			if (index.bindings.program.arena.list_count(explicit) != 0) {
				if (index.bindings.program.arena.list_count(explicit) != plan.argument_count) return false;
				i = 0;
				while (i < plan.argument_count) {
					var argument = index.bindings.program.arena.node_at(explicit, i);
					if (index.uses[argument.index].type.index != index.generic_arguments[plan.arguments + i].type.index) return false;
					i = i + 1;
				}
			}
			var result = index.types.argument(index.types, index.symbol_types[target.index], 0);
			if (index.uses[n].type.index != result.type.index || index.uses[n].flags != result.flags) return false;
		}
		n = n + 1;
	}
	return true;
}

bool generic_token_equal(CheckedIndex index, SyntaxTokenId first, SyntaxTokenId second) {
	return index.bindings.program.arena.token_text_equal(first, second);
}

// Reconstruct lexical member authority from the actual receiver and original
// declaration. Do not consult the builder's remapping decision or callable ID.
bool generic_lexical_method_verified(CheckedIndex index, BindingReference original, BindingReference actual) {
	if (original.target.index < 1 || original.target.index > index.generic_symbols || original.domain != 4 || actual.domain != 4 || index.bindings.program.arena.kind(original.node) != SyntaxKind.CallExpressionSyntax() || index.bindings.program.arena.kind(actual.node) != SyntaxKind.CallExpressionSyntax()) return false;
	var method = index.bindings.symbol(original.target);
	if (method.kind != 11 || method.owner.index < 1 || method.owner.index > index.generic_symbols || index.bindings.symbol(method.owner).kind != 4 || index.bindings.program.arena.get_token_identifier(original.node).index != original.token.index || index.bindings.program.arena.get_token_identifier(actual.node).index != actual.token.index || !index.bindings.program.arena.token_text_equal(actual.token, method.token)) return false;
	var receiver = no_type(); var place = index.bindings.program.arena.get_node_receiver_place(actual.node);
	if (place.index > 0) {
		if (place.index > index.bindings.program.arena.node_count || place.index >= len(index.uses)) return false;
		receiver = index.uses[place.index].type;
	} else {
		var token = index.bindings.program.arena.get_token_receiver(actual.node);
		var symbol = checked_target(index, actual.node, token);
		if (symbol.index < 0 || symbol.index > index.bindings.symbol_count || symbol.index >= len(index.symbol_types)) return false;
		if (symbol.index > 0) receiver = index.symbol_types[symbol.index];
		if (receiver.index == 0) receiver = checked_this_type(index, actual.node, token);
	}
	if (!index.types.valid_id(receiver) || checked_kind(index, receiver) != 31) return false;
	var owner = index.types.row(receiver).nominal;
	int enclosing = generic_instance_for(index, owner);
	if (enclosing > 0) owner = index.instances[enclosing - 1].origin;
	return owner.index == method.owner.index && index.bindings.accessible(original.target, actual.scope);
}

bool generic_reference_linked(CheckedIndex index, int number, BindingReference edge) {
	if (edge.node.index < 1 || edge.node.index >= len(index.node_references) || number < 1 || number >= len(index.reference_next)) return false;
	int current = index.node_references[edge.node.index]; int remaining = index.bindings.reference_count; int found = 0;
	while (current != 0 && remaining > 0) {
		if (current < 1 || current > index.bindings.reference_count || current >= len(index.reference_next) || index.bindings.reference(current).node.index != edge.node.index) return false;
		if (current == number) found = found + 1;
		current = index.reference_next[current]; remaining = remaining - 1;
	}
	if (current != 0 || found != 1) return false;
	if (edge.state_code != 1) return edge.next_reference == 0;
	if (edge.target.index < 1 || edge.target.index > index.bindings.symbol_count) return false;
	current = index.bindings.symbol(edge.target).first_reference; remaining = index.bindings.reference_count; found = 0;
	while (current != 0 && remaining > 0) {
		if (current < 1 || current > index.bindings.reference_count) return false;
		var next = index.bindings.reference(current);
		if (next.state_code != 1 || next.target.index != edge.target.index) return false;
		if (current == number) found = found + 1;
		current = next.next_reference; remaining = remaining - 1;
	}
	return current == 0 && found == 1;
}

// A completed deferred edge needs the same source-domain authority as an
// originally bound edge. Reconstruct member identity, never a completion bit.
bool generic_deferred_reference_verified(CheckedIndex index, GenericInstance plan, BindingReference original, BindingReference actual) {
	if (original.state_code != 5 || (original.reason != 1 && original.reason != 3 && original.reason != 4) || original.domain != 4 || original.target.index != 0 || actual.state_code != 1 || actual.reason != 0 || actual.target.index < 1 || actual.target.index > index.bindings.symbol_count || actual.node.index < 1 || actual.node.index >= len(index.uses)) return false;
	var member = index.bindings.symbol(actual.target); var kind = index.bindings.program.arena.kind(actual.node);
	if (member.kind == 13 && original.reason == 1 && kind == SyntaxKind.CallExpressionSyntax()) return actual.token.index == index.bindings.program.arena.get_token_identifier(actual.node).index && enum_constructor_verified(index, actual.node, actual.target, index.uses[actual.node.index].type);
	if (member.kind == 13 && original.reason == 4 && kind == SyntaxKind.EnumArmSyntax()) return actual.token.index == index.bindings.program.arena.get_token_variant(actual.node).index && enum_arm_variant_verified(index, actual.node, actual.target, index.uses[actual.node.index].type);
	if (original.reason == 4) return false;
	if (kind == SyntaxKind.CallExpressionSyntax()) {
		var candidate = original; candidate.target = actual.target;
		return generic_lexical_method_verified(index, candidate, actual);
	}
	if (member.kind != 6 && !(member.kind == 14 && original.reason == 1 && kind == SyntaxKind.FieldAccessExpressionSyntax())) return false;
	if (!index.bindings.program.arena.token_text_equal(actual.token, member.token) || !index.bindings.accessible(actual.target, actual.scope)) return false;
	var receiver = no_type();
	if (kind == SyntaxKind.FieldAccessExpressionSyntax()) {
		if (index.bindings.program.arena.get_token_field_name(actual.node).index != actual.token.index) return false;
		var place = index.bindings.program.arena.get_node_aggregate(actual.node);
		if (place.index > 0) {
			if (place.index > index.bindings.program.arena.node_count || place.index >= len(index.uses)) return false;
			receiver = index.uses[place.index].type;
		} else {
			var token = index.bindings.program.arena.get_token_identifier(actual.node);
			var symbol = checked_target(index, actual.node, token);
			if (symbol.index < 0 || symbol.index > index.bindings.symbol_count || symbol.index >= len(index.symbol_types)) return false;
			if (symbol.index > 0) receiver = index.symbol_types[symbol.index];
			if (receiver.index == 0) receiver = checked_this_type(index, actual.node, token);
		}
	} else {
		if (kind != SyntaxKind.FieldInitializerSyntax() || index.bindings.program.arena.get_token_name(actual.node).index != actual.token.index) return false;
		int parents = 0; int n = plan.node_first;
		while (n - plan.node_first < plan.node_count) {
			SyntaxNodeId node = {index = n};
			if (index.bindings.program.arena.kind(node) == SyntaxKind.StructInitializerSyntax()) {
				var fields = index.bindings.program.arena.get_list_fields(node); int f = 0;
				while (f < index.bindings.program.arena.list_count(fields)) {
					if (index.bindings.program.arena.node_at(fields, f).index == original.node.index) {
						int mapped = generic_node(index, plan, n);
						if (mapped <= index.generic_nodes || mapped > index.bindings.program.arena.node_count || mapped >= len(index.uses)) return false;
						receiver = index.uses[mapped].type; parents = parents + 1;
					}
					f = f + 1;
				}
			}
			n = n + 1;
		}
		if (parents != 1) return false;
	}
	if (!index.types.valid_id(receiver) || checked_kind(index, receiver) != 30 && checked_kind(index, receiver) != 31) return false;
	return index.types.row(receiver).nominal.index == member.owner.index;
}

bool generic_references_verified(CheckedIndex index, GenericInstance plan) {
	if (plan.first_reference < 1 || plan.reference_count < 0 || plan.first_reference > index.bindings.reference_count + 1 - plan.reference_count) return false;
	int source = 1; int offset = 0;
	while (source <= index.generic_references) {
		var original = index.bindings.reference(source);
		int node = generic_node(index, plan, original.node.index);
		if (node != 0) {
			if (node <= index.generic_nodes || node > index.bindings.program.arena.node_count || node >= len(index.uses)) return false;
			if (offset >= plan.reference_count) return false;
			var actual = index.bindings.reference(plan.first_reference + offset);
			if (actual.node.index != node || actual.token.index != original.token.index || actual.span.source.index != original.span.source.index || actual.span.start != original.span.start || actual.span.end != original.span.end || actual.domain != original.domain) return false;
			if (!generic_reference_linked(index, source, original) || !generic_reference_linked(index, plan.first_reference + offset, actual)) return false;
			int scope = original.scope.index;
			if (scope > 0 && generic_scope(index, plan, scope) != 0) scope = generic_scope(index, plan, scope);
			if (actual.scope.index != scope) return false;
			int alternative = original.alternative.index;
			if (generic_symbol(index, plan, alternative) != 0) alternative = generic_symbol(index, plan, alternative);
			if (actual.alternative.index != alternative) return false;
			if (original.state_code == 1) {
				int target = original.target.index;
				if (target < 1 || target > index.bindings.symbol_count) return false;
				bool member = original.domain == 4 && index.bindings.symbol(original.target).kind == 11;
				if (member) {
					if (!generic_lexical_method_verified(index, original, actual)) return false;
				} else {
					if (generic_symbol(index, plan, target) != 0) {
						target = generic_symbol(index, plan, target);
					} else {
						if (index.class_storage && plan.enclosing.index != 0) {
							int owner = generic_instance_for(index, index.types.row(plan.enclosing).nominal);
							if (owner > 0 && generic_symbol(index, index.instances[owner - 1], target) != 0) target = generic_symbol(index, index.instances[owner - 1], target);
						}
					}
				}
				if (actual.state_code != 1 || actual.target.index != target || actual.reason != original.reason) return false;
			} else {
				if (actual.state_code != original.state_code && !(original.state_code == 5 && actual.state_code == 1 && (original.reason == 1 || original.reason == 3 || original.reason == 4))) return false;
				if (actual.state_code == original.state_code) {
					if (actual.reason != original.reason || actual.target.index != original.target.index) return false;
				} else {
					if (actual.reason != 0 || actual.target.index < 1 || actual.target.index > index.bindings.symbol_count) return false;
					if (!generic_deferred_reference_verified(index, plan, original, actual)) return false;
				}
			}
			offset = offset + 1;
		}
		source = source + 1;
	}
	return offset == plan.reference_count;
}

// Independent storage-bound checks precede any map consumption. Windows are
// allowed to contain zeros; edge correspondence never follows span containment.
bool generic_window_bounds(int first, int count, int originals, int base, int used, int capacity) {
	return first >= 1 && first <= originals + 1 && count >= 0 && count <= originals + 1 - first && base >= 0 && used >= 0 && used <= capacity && count < used && base <= used - count - 1;
}

bool generic_plan_bounds(CheckedIndex index, GenericInstance plan) {
	return plan.arguments >= 0 && plan.argument_count >= 0 && plan.argument_count <= 257 && plan.arguments <= len(index.generic_arguments) - plan.argument_count && index.generic_node_used <= 8000000 && index.generic_symbol_used <= 8000000 && len(index.generic_symbol_keys) == len(index.generic_symbol_map) && len(index.generic_scope_keys) == len(index.generic_scope_map) && generic_window_bounds(plan.node_first, plan.node_count, index.generic_nodes, plan.nodes, index.generic_node_used, len(index.generic_node_map)) && generic_window_bounds(plan.symbol_first, plan.symbol_count, index.generic_symbols, plan.symbols, index.generic_symbol_used, len(index.generic_symbol_map)) && generic_window_bounds(plan.scope_first, plan.scope_count, index.generic_scopes, plan.scopes, index.generic_scope_used, len(index.generic_scope_map));
}

// Reconstruct the complete ordered source-key domain independently of the
// allocator and binary-search lookup. Missing, extra and duplicate keys fail.
bool generic_symbol_keys_verified(CheckedIndex index, GenericInstance plan) {
	if (!generic_plan_bounds(index, plan) || index.generic_symbol_keys[plan.symbols] != 0) return false;
	if (!plan.sparse_bindings) {
		int at = 1;
		while (at <= plan.symbol_count) {
			if (index.generic_symbol_keys[plan.symbols + at] != 0) return false;
			at = at + 1;
		}
		return true;
	}
	int expected = 0; int first = index.generic_symbols + 1; int source = 1;
	while (source <= index.generic_symbols) {
		int node = index.bindings.symbol(type_symbol(source)).node.index;
		if (node >= plan.node_first && node - plan.node_first < plan.node_count) {
			if (expected == plan.symbol_count || index.generic_symbol_keys[plan.symbols + expected + 1] != source) return false;
			if (expected == 0) first = source;
			expected = expected + 1;
		}
		source = source + 1;
	}
	return expected == plan.symbol_count && first == plan.symbol_first;
}

// Scope keys are reconstructed from original Binder scopes, independently of
// the producer and its lookup. Genuine generic plans keep their dense domain.
bool generic_scope_keys_verified(CheckedIndex index, GenericInstance plan) {
	if (!generic_plan_bounds(index, plan) || index.generic_scope_keys[plan.scopes] != 0) return false;
	if (!plan.sparse_bindings) {
		int at = 1;
		while (at <= plan.scope_count) {
			if (index.generic_scope_keys[plan.scopes + at] != 0) return false;
			at = at + 1;
		}
		return true;
	}
	int expected = 0; int first = index.generic_scopes + 1; int source = 1;
	while (source <= index.generic_scopes) {
		ScopeId id = {index = source}; int node = index.bindings.scope(id).node.index;
		if (node >= plan.node_first && node - plan.node_first < plan.node_count) {
			if (expected == plan.scope_count || index.generic_scope_keys[plan.scopes + expected + 1] != source) return false;
			if (expected == 0) first = source;
			expected = expected + 1;
		}
		source = source + 1;
	}
	return expected == plan.scope_count && first == plan.scope_first;
}

bool generic_scopes_verified(CheckedIndex index, GenericInstance plan) {
	if (!generic_scope_keys_verified(index, plan) || plan.origin.index < 1 || plan.origin.index > index.generic_symbols) return false;
	var origin = index.bindings.symbol(plan.origin);
	int ordinal = 0;
	while (ordinal < plan.scope_count) {
		ScopeId id = {index = generic_scope_source(index, plan, ordinal)};
		var source = index.bindings.scope(id);
		int node = generic_node(index, plan, source.node.index);
		int mapped = index.generic_scope_map[plan.scopes + ordinal + 1];
		if (node == 0) {
			if (mapped != 0) return false;
		} else {
			if (mapped <= index.generic_scopes || mapped > index.bindings.scope_count) return false;
			ScopeId target_id = {index = mapped}; var target = index.bindings.scope(target_id);
			int parent = source.parent.index;
			if (generic_scope(index, plan, parent) != 0) parent = generic_scope(index, plan, parent);
			int owner = source.owner.index;
			if (generic_symbol(index, plan, owner) != 0) owner = generic_symbol(index, plan, owner);
			int kind = source.kind;
			if (origin.kind == 18 && source.node.index == origin.node.index) {
				if (kind != 5) return false;
				kind = 4;
			}
			if (target.node.index != node || target.parent.index != parent || target.owner.index != owner || target.unit.index != source.unit.index || target.kind != kind || target.namespace_name != source.namespace_name) return false;
		}
		ordinal = ordinal + 1;
	}
	return true;
}
