}

bool recover_template_constructor(CheckedIndex checked, SymbolId owner, SyntaxNodeId member, int[] work) {
	if (!checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_name(member), "init") || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_parameters(member)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_base_arguments(member)) != 0) return false;
	var body = checked.bindings.program.arena.get_node_body(member);
	if (body.index == 0 || checked.bindings.program.arena.kind(body) != SyntaxKind.BlockStatementSyntax()) return false;
	var declaration = checked.bindings.symbol(owner); var statements = checked.bindings.program.arena.get_list_statements(body); var fields = checked.bindings.program.arena.get_list_fields(declaration.node);
	if (checked.bindings.program.arena.list_count(statements) != checked.bindings.program.arena.list_count(fields)) return false;
	var initialized = new bool[checked.bindings.symbol_count + 1]; int i = 0;
	while (i < checked.bindings.program.arena.list_count(statements)) {
		if (work[0] == 0) return false; work[0] = work[0] - 1;
		var statement = checked.bindings.program.arena.node_at(statements, i);
		if (checked.bindings.program.arena.kind(statement) != SyntaxKind.FieldAssignmentStatementSyntax()) return false;
		var field = recover_template_field(checked, owner, checked.bindings.program.arena.get_node_target(statement));
		if (field.index == 0 || initialized[field.index]) return false;
		var value = checked.bindings.program.arena.get_node_expression(statement);
		if (!class_storage_slot_initialization(checked, value, checked.symbol_types[field.index])) return false;
		var allocation = checked.bindings.program.arena.buffer_allocation(value); var element = allocation.f_element_type;
		if (checked.bindings.program.arena.kind(element) != SyntaxKind.TypeNameSyntax()) return false;
		var name = checked.bindings.program.arena.type_name(element);
		if (name.f_namespace_qualifier.index != 0 || checked.bindings.program.arena.list_count(name.f_stars) != 0) return false;
		var parameter = checked_target(checked, element, name.f_identifier); var expected = checked.types.argument(checked.types, checked.symbol_types[field.index], 0).type;
		if (parameter.index != checked.types.row(expected).nominal.index) return false;
		initialized[field.index] = true; i = i + 1;
	}
	i = 0;
	while (i < checked.bindings.program.arena.list_count(fields)) {
		var field = checked.bindings.program.arena.node_at(fields, i); var symbol = checked.node_symbols[field.index];
		if (!initialized[symbol.index]) return false;
		i = i + 1;
	}
	return true;
}

bool recover_template_method(CheckedIndex checked, SymbolId owner, SymbolId member, int[] work) {
	var declaration = checked.bindings.symbol(member); var callable = checked.symbol_types[member.index]; var shape = checked.types.row(callable);
	var parameters = checked.bindings.program.arena.get_list_parameters(declaration.node);
	if (shape.kind != 25 || shape.count < 1 || shape.count > 257 || shape.count != checked.bindings.program.arena.list_count(parameters) + 1) return false;
	var result = checked.types.argument(checked.types, callable, 0); bool result_owner = recover_template_parameter(checked, owner, result.type);
	if (result_owner && result.flags != 4 || !result_owner && (result.flags != 0 || !type_numeric(checked_kind(checked, result.type)) && result.type.index != 13 && result.type.index != 14)) return false;
	var live = new bool[checked.bindings.symbol_count + 1]; int p = 0;
	while (p < checked.bindings.program.arena.list_count(parameters)) {
		var parameter = checked.bindings.program.arena.node_at(parameters, p); var symbol = checked.node_symbols[parameter.index]; var channel = checked.types.argument(checked.types, callable, p + 1);
		if (symbol.index < 1 || checked.bindings.symbol(symbol).kind != 7 || checked.bindings.symbol(symbol).owner.index != member.index || checked.symbol_types[symbol.index].index != channel.type.index || checked.symbol_flags[symbol.index] != channel.flags || checked.bindings.program.arena.get_node_caller_information(parameter).index != 0) return false;
		bool transferred = recover_template_parameter(checked, owner, channel.type);
		if (transferred && channel.flags != 4 || !transferred && (channel.flags != 0 || !type_numeric(checked_kind(checked, channel.type)) && channel.type.index != 13)) return false;
		live[symbol.index] = transferred; p = p + 1;
	}
	var body = checked.bindings.program.arena.get_node_body(declaration.node);
	if (body.index == 0 || checked.bindings.program.arena.kind(body) != SyntaxKind.BlockStatementSyntax()) return false;
	var statements = checked.bindings.program.arena.get_list_statements(body); bool returned = false; int i = 0;
	while (i < checked.bindings.program.arena.list_count(statements)) {
		if (returned || work[0] == 0) return false; work[0] = work[0] - 1;
		var statement = checked.bindings.program.arena.node_at(statements, i); var kind = checked.bindings.program.arena.kind(statement);
		if (kind == SyntaxKind.InferredLocalDeclarationSyntax() || kind == SyntaxKind.LocalDeclarationSyntax()) {
			var symbol = checked.node_symbols[statement.index];
			if (symbol.index < 1 || checked.bindings.symbol(symbol).kind != 8 || checked.bindings.symbol(symbol).owner.index != member.index) return false;
			var type = recover_template_value(checked, owner, member, checked.bindings.program.arena.get_node_initializer(statement), live, work, 0);
			if (type.index == 0 || type.index != checked.symbol_types[symbol.index].index) return false;
			bool acquired = recover_template_parameter(checked, owner, type);
