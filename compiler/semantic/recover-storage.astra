			live[symbol.index] = acquired;
		} else { if (kind == SyntaxKind.ReturnStatementSyntax()) {
				var value = checked.bindings.program.arena.get_node_expression(statement); var type = type_id(14);
				if (value.index > 0) type = recover_template_value(checked, owner, member, value, live, work, 0);
				if (type.index != result.type.index || result_owner && checked.bindings.program.arena.kind(value) != SyntaxKind.MoveExpressionSyntax()) return false;
				returned = true;
			} else {
				if (kind != SyntaxKind.CallStatementSyntax()) return false;
				var type = recover_template_value(checked, owner, member, checked.bindings.program.arena.get_node_call(statement), live, work, 0);
				if (type.index == 0 || recover_template_parameter(checked, owner, type)) return false;
			}
		}
		i = i + 1;
	}
	// Remaining local/parameter owners retire at scope exit. Concrete cleanup
	// paths and transfers must still pass the independent Core/SSA consumers.
	return returned || result.type.index == 14;
}

// Every original member of a closed-only template must have a concrete
// function in every used specialization. The generic verifier checks the
// source copy, and the ordinary Flow consumer checks every concrete body.
bool recover_closed_slot_template(CheckedIndex checked, SymbolId owner, SyntaxListId members, int[] work) {
	int closed = 0; int i = 0;
	while (i < checked.instance_count) {
		if (work[0] == 0) return false;
		work[0] = work[0] - 1;
		var instance = checked.instances[i];
		if (instance.origin.index == owner.index) {
			if (instance.state != 2 || instance.concrete.index < 1 || instance.concrete.index > checked.bindings.symbol_count) return false;
			var type = checked.symbol_types[instance.concrete.index];
			if (!recover_storage_class(checked, type)) return false;
			int m = 0;
			while (m < checked.bindings.program.arena.list_count(members)) {
				var node = checked.bindings.program.arena.node_at(members, m);
				var kind = checked.bindings.program.arena.kind(node);
				if (kind != SyntaxKind.StructFieldDeclarationSyntax()) {
					if (kind != SyntaxKind.FunctionDeclarationSyntax() && kind != SyntaxKind.LifecycleDeclarationSyntax() || !recover_plain_member(checked, node) || checked.bindings.program.arena.get_int_dispatch(node) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_parameters(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_where_clauses(node)) != 0) return false;
					var member = checked.node_symbols[node.index];
					if (member.index < 1 || checked.bindings.symbol(member).owner.index != owner.index) return false;
					int matches = 0; int c = 0;
					while (c < checked.instance_count) {
						if (work[0] == 0) return false;
						work[0] = work[0] - 1;
						var concrete = checked.instances[c];
						if (concrete.origin.index == member.index && concrete.enclosing.index == type.index) {
							if (concrete.state != 2 || concrete.concrete.index < 1 || concrete.concrete.index > checked.bindings.symbol_count || checked.bindings.symbol(concrete.concrete).kind != 1) return false;
							matches = matches + 1;
						}
						c = c + 1;
					}
					if (matches != 1) return false;
				}
				m = m + 1;
			}
			closed = closed + 1;
		}
		i = i + 1;
	}
	return closed > 0;
}

bool recover_slot_template_source(CheckedIndex checked, SymbolId owner) {
	if (!checked.class_storage || owner.index < 1 || owner.index > checked.generic_symbols || !generic_template(checked, owner) || !class_storage_template_verified(checked, owner)) return false;
	var declaration = checked.bindings.symbol(owner); var node = declaration.node;
	if (declaration.kind != 4 || checked.bindings.program.arena.kind(node) != SyntaxKind.ClassDeclarationSyntax() || checked.bindings.program.arena.get_node_parent_class(node).index != 0 || checked.bindings.program.arena.get_bool_is_interface(node) || checked.bindings.program.arena.get_token_exception_root(node).index != 0 || checked.bindings.program.arena.get_concurrency_concurrency_policy(node).present) return false;
	if (checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_allocator(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_alignment(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_representation(node)) != 0 || checked.bindings.program.arena.get_node_foreign_import(node).index != 0 || checked.bindings.program.arena.get_node_foreign_export(node).index != 0 || checked.bindings.program.arena.get_node_com_export(node).index != 0 || checked.bindings.program.arena.get_node_gobject_export(node).index != 0) return false;
	var fields = checked.bindings.program.arena.get_list_fields(node); int f = 0;
	while (f < checked.bindings.program.arena.list_count(fields)) {
		var field = checked.bindings.program.arena.node_at(fields, f); var symbol = checked.node_symbols[field.index];
		if (symbol.index < 1 || symbol.index > checked.bindings.symbol_count || checked.bindings.symbol(symbol).kind != 6 || checked.bindings.symbol(symbol).owner.index != owner.index || checked.bindings.symbol(symbol).node.index != field.index) return false;
		var type = checked.symbol_types[symbol.index];
		if (checked_kind(checked, type) != 23 || checked.symbol_flags[symbol.index] != 4 || !recover_template_parameter(checked, owner, checked.types.argument(checked.types, type, 0).type)) return false;
		f = f + 1;
	}
	var work = new int[1]; work[0] = 8000000; var members = checked.bindings.program.arena.get_list_members(node); int i = 0; int constructors = 0;
	if (!checked.bindings.program.arena.get_bool_exact_heap_class(node)) return recover_closed_slot_template(checked, owner, members, work);
	while (i < checked.bindings.program.arena.list_count(members)) {
		var member = checked.bindings.program.arena.node_at(members, i); var kind = checked.bindings.program.arena.kind(member); var symbol = checked.node_symbols[member.index];
		if (kind != SyntaxKind.StructFieldDeclarationSyntax()) {
			if (symbol.index < 1 || checked.bindings.symbol(symbol).owner.index != owner.index || !recover_plain_member(checked, member) || checked.bindings.program.arena.get_int_dispatch(member) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_where_clauses(member)) != 0) return false;
			if (kind == SyntaxKind.LifecycleDeclarationSyntax()) {
				if (!recover_template_constructor(checked, owner, member, work)) return false; constructors = constructors + 1;
			} else {
				if (kind != SyntaxKind.FunctionDeclarationSyntax() || !recover_template_method(checked, owner, symbol, work)) return false;
			}
		}
		i = i + 1;
	}
	if (constructors != 1) return false;
	i = 0;
	while (i < checked.instance_count) {
		var instance = checked.instances[i];
		if (instance.origin.index == owner.index && (instance.state != 2 || !recover_storage_class(checked, checked.symbol_types[instance.concrete.index]))) return false;
		i = i + 1;
	}
	return true;
}

SyntaxNodeId recover_class_deinit_source(CheckedIndex checked, SymbolId owner) {
	var declaration = checked.bindings.symbol(owner);
	var members = checked.bindings.program.arena.get_list_members(declaration.node); int i = 0;
	while (i < checked.bindings.program.arena.list_count(members)) {
		var member = checked.bindings.program.arena.node_at(members, i);
		if (checked.bindings.program.arena.kind(member) == SyntaxKind.LifecycleDeclarationSyntax() && checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_name(member), "deinit")) return member;
		i = i + 1;
	}
	SyntaxNodeId absent = {index = 0}; return absent;
}

bool recover_class_declaration_source(CheckedIndex checked, SymbolId symbol) {
	if (symbol.index < 1 || symbol.index > checked.bindings.symbol_count || checked.bindings.symbol(symbol).kind != 4) return false;
	var type = checked.symbol_types[symbol.index];
	if (recover_storage_class(checked, type)) {
		var declaration = checked.bindings.symbol(symbol);
		var members = checked.bindings.program.arena.get_list_members(declaration.node); int i = 0;
		while (i < checked.bindings.program.arena.list_count(members)) {
			var member = checked.bindings.program.arena.node_at(members, i);
			if (checked.bindings.program.arena.kind(member) == SyntaxKind.PropertyDeclarationSyntax()) {
				var property = checked.node_symbols[member.index]; var projection = class_property_verified(checked, property);
				if (projection.field.index == 0 && !text_storage_accessor_verified(checked, member, symbol)) {
					if (!class_getter_source_verified(checked, property)) return false;
					var accessor = checked.bindings.program.arena.get_node_getter(member);
					var getter = checked.node_symbols[accessor.index];
					if (getter.index < 1 || getter.index >= len(checked.direct_methods)) return false;
					var plan = checked.direct_methods[getter.index];
					if (plan.state != 2 || plan.origin.index != getter.index || plan.enclosing.index != type.index || plan.concrete.index < 1 || !class_getter_signature_verified(checked, plan)) return false;
				}
			}
			i = i + 1;
		}
		var source = recover_class_deinit_source(checked, symbol);
		if (source.index == 0) return true;
		var origin = checked.node_symbols[source.index];
		if (origin.index < 1 || origin.index > checked.bindings.symbol_count) return false;
		var member = checked.bindings.symbol(origin);
		if (member.kind != 12 || member.owner.index != symbol.index || member.node.index != source.index) return false;
		var function = class_storage_lifecycle(checked, type, "deinit");
		var plan = checked_source_plan(checked, function);
		return plan.concrete.index == function.index && plan.origin.index == origin.index;
	}
	return recover_error_shape(checked, symbol, 0) || error_storage_class(checked, type) && recover_error_record_memory_source(checked, symbol, 0) || recover_slot_template_source(checked, symbol);
}

// Owning slots are field storage, not a new callable carrier. Element source
// and nested payload admission remain distinct from field-place authority.
bool recover_storage_slots(CheckedIndex checked, TypeId type, int depth) {
	if (depth > 32 || checked_kind(checked, type) != 23) return false;
	var element = checked.types.argument(checked.types, type, 0);
	return element.flags == 0 && checked_kind(checked, element.type) == 31 && class_storage_slot_element_verified(checked, element.type, depth + 1) && recover_storage_fields(checked, element.type, depth + 1);
}

bool recover_storage_fields(CheckedIndex checked, TypeId type, int depth) {
	if (depth > 32) return false;
	var declaration = checked.bindings.symbol(checked.types.row(type).nominal); var fields = checked.bindings.program.arena.get_list_fields(declaration.node); int i = 0;
	while (i < checked.bindings.program.arena.list_count(fields)) {
		var node = checked.bindings.program.arena.node_at(fields, i); var symbol = checked.node_symbols[node.index]; var value = checked.symbol_types[symbol.index]; int kind = checked_kind(checked, value);
		if (kind == 23) {
			if (!recover_storage_slots(checked, value, depth + 1)) return false;
		} else { if (kind == 31) {
				if (!recover_storage_fields(checked, value, depth + 1)) return false;
			}
			else {
				if (kind == 22) {
					if (!recover_array_type(checked, value)) return false;
				} else {
					if (kind == 27 || kind == 28) {
						if (kind == 27 && !class_storage_shared_verified(checked, value, depth + 1) || kind == 28 && !class_storage_weak_verified(checked, value, depth + 1)) return false;
						var payload = checked.types.argument(checked.types, value, 0).type;
						if (!recover_storage_fields(checked, payload, depth + 1)) return false;
					} else {
						if (kind == 30) {
							if (!recover_storage_record(checked, value)) return false;
						} else {
							if (!type_numeric(kind) && kind != 13 && kind != 15 && !recover_storage_pointer(checked, value)) return false;
						}
					}
				}
			}
		}
		i = i + 1;
	}
	return true;
}

bool recover_storage_record(CheckedIndex checked, TypeId type) {
	if (checked_kind(checked, type) != 30 || !class_storage_record_verified(checked, type) || !class_storage_fields_verified(checked, type, 0) || checked_record_owned(checked, type, 0)) return false;
	var declaration = checked.bindings.symbol(checked.types.row(type).nominal); var fields = checked.bindings.program.arena.get_list_fields(declaration.node); int f = 0; bool nested = false;
	while (f < checked.bindings.program.arena.list_count(fields)) {
		var node = checked.bindings.program.arena.node_at(fields, f);
		var symbol = checked.node_symbols[node.index];
		int kind = checked_kind(checked, checked.symbol_types[symbol.index]);
		if (kind == 30) nested = true;
		else {
			if (!type_numeric(kind) && kind != 13 && !recover_storage_pointer(checked, checked.symbol_types[symbol.index])) return false;
		}
		f = f + 1;
	}
	if (nested) {
		var shape = recover_record_shape(checked, type);
		return recover_record_shape_verify(shape, checked);
	}
	return true;
}

bool recover_storage_shared(CheckedIndex checked, TypeId type) {
	if (!class_storage_shared_verified(checked, type, 0)) return false;
	return recover_storage_class(checked, checked.types.argument(checked.types, type, 0).type);
}

bool recover_storage_weak(CheckedIndex checked, TypeId type) {
	if (!class_storage_weak_verified(checked, type, 0)) return false;
	return recover_storage_class(checked, checked.types.argument(checked.types, type, 0).type);
}

// Opaque C handles retain their declared, non-owning void pointer type.
bool recover_storage_pointer(CheckedIndex checked, TypeId type) {
	return checked.field_effects && type.index == 16 && checked_kind(checked, type) == 16;
}

bool recover_storage_channel(CheckedIndex checked, TypeId type, int flags, bool result) {
	int kind = checked_kind(checked, type);
	if (flags == 0 && (type_numeric(kind) || kind == 13 || result && kind == 14 || recover_storage_pointer(checked, type))) return true;
	if (kind == 32) {
		if (!recover_enum_type_verified(checked, type)) return false;
		if (enum_storage_owned(checked, type, 0)) return flags == 4 || !result && flags == 2;
		return flags == 0;
	}
	if (kind == 15) return flags == 0;
	if (kind == 30) return flags == 0 && recover_storage_record(checked, type);
	if (kind == 27) return (flags == 4 || !result && flags == 2) && recover_storage_shared(checked, type);
	if (kind == 28) return (flags == 4 || !result && flags == 2) && recover_storage_weak(checked, type);
	if (kind == 31) return (flags == 4 || !result && (flags == 0 || flags == 2)) && (recover_storage_class(checked, type) || recover_storage_error(checked, type));
	if (kind == 22) {
		if (recover_string_array(checked, type)) return !result && flags == 0;
		return (flags == 4 || !result && (flags == 0 || flags == 2)) && recover_array_type(checked, type);
	}
	return false;
}

struct RecoverSlot {
	SymbolId symbol;
	TypeId type;
	int flags;
	int function;
	int scope;
	bool parameter;
	bool owner;
}

class RecoverStorage {
	owned shared TypeOwner identity;
	owned RecoverSlot[] slots;
	owned int[] symbols;
	owned int[] parents;
	int count;
	int status;
	SyntaxNodeId boundary;

	init(CheckedIndex checked) {
		int capacity = checked.bindings.symbol_count + 1;
		if (capacity < 8192) capacity = 8192;
		int status = 0;
		if (capacity > 8000000) {
			capacity = 0;
			status = 2;
		}
		var identity = shared_clone(checked.types.identity); this.identity = move identity; this.slots = new RecoverSlot[capacity]; this.symbols = new int[checked.bindings.symbol_count + 1]; this.parents = new int[checked.bindings.scope_count + 1]; this.count = 0; this.status = status; SyntaxNodeId absent = {index = 0}; this.boundary = absent;
	}

	void add(RecoverSlot row) { if (this.count == len(this.slots)) {
			this.status = 2;
			return;
		} this.slots[this.count] = row; this.count = this.count + 1; this.symbols[row.symbol.index] = this.count; }
}

void recover_storage_inventory(RecoverStorage storage, CheckedIndex checked, int[] functions) {
	var units = new int[8193];
	int scope = 1; while (scope < len(storage.parents)) {
		ScopeId id = {index = scope};
		var row = checked.bindings.scope(id);
		storage.parents[scope] = row.parent.index;
		scope = scope + 1;
	}
	int s = 1;
	while (s <= checked.bindings.symbol_count && storage.status == 0) {
		var symbol = type_symbol(s); var declaration = checked.bindings.symbol(symbol);
		if ((declaration.kind == 7 || declaration.kind == 8 || enum_scoped_binding(checked, symbol)) && declaration.owner.index > 0 && functions[declaration.owner.index] > 0) {
			int function = functions[declaration.owner.index];
			if (function > 8192 || units[function] == 8192) {
				storage.status = 2;
				storage.boundary = declaration.node;
				return;
			}
			units[function] = units[function] + 1;
			var type = checked.symbol_types[s]; int flags = checked.symbol_flags[s];
			if (!recover_storage_binding(checked, symbol)) {
				storage.status = 3;
				storage.boundary = declaration.node;
				return;
			}
			RecoverSlot row = {symbol = symbol, type = type, flags = flags, function = functions[declaration.owner.index], scope = declaration.scope.index, parameter = declaration.kind == 7, owner = (flags & 4) != 0}; storage.add(row);
		}
		s = s + 1;
	}
}

bool recover_storage_verify(RecoverStorage storage, CheckedIndex checked, int[] functions) {
	int capacity = checked.bindings.symbol_count + 1;
	if (capacity < 8192) capacity = 8192;
	if (storage.status != 0 || !type_owner_same(storage.identity, checked.types.identity) || capacity > 8000000 || len(storage.slots) != capacity || storage.count < 0 || storage.count > capacity || len(storage.symbols) != checked.bindings.symbol_count + 1 || len(storage.parents) != checked.bindings.scope_count + 1 || len(functions) != len(storage.symbols)) return false;
	var units = new int[8193];
	int expected = 0; int s = 1;
	while (s <= checked.bindings.symbol_count) {
		var declaration = checked.bindings.symbol(type_symbol(s));
		if ((declaration.kind == 7 || declaration.kind == 8 || enum_scoped_binding(checked, type_symbol(s))) && declaration.owner.index > 0 && functions[declaration.owner.index] > 0) {
			if (expected >= storage.count || storage.symbols[s] != expected + 1) return false;
			var row = storage.slots[expected]; if (row.symbol.index != s || row.type.index != checked.symbol_types[s].index || row.flags != checked.symbol_flags[s] || row.function != functions[declaration.owner.index] || row.scope != declaration.scope.index || row.parameter != (declaration.kind == 7) || row.owner != ((row.flags & 4) != 0) || !recover_storage_binding(checked, type_symbol(s))) return false;
			if (row.function > 8192 || units[row.function] == 8192) return false;
			units[row.function] = units[row.function] + 1;
			expected = expected + 1;
		} else {
			if (storage.symbols[s] != 0) return false;
		}
		s = s + 1;
	}
	if (expected != storage.count || storage.parents[0] != 0 || storage.symbols[0] != 0) return false;
	s = 1; while (s < len(storage.parents)) {
		ScopeId id = {index = s};
		var scope = checked.bindings.scope(id);
		if (storage.parents[s] != scope.parent.index) return false;
		s = s + 1;
	}
	return true;
}

bool recover_storage_outlives(RecoverStorage storage, int ancestor, int scope) {
	int steps = 0; int current = scope; while (current > 0 && current < len(storage.parents) && steps < 256) {
		if (current == ancestor) return true;
		current = storage.parents[current];
		steps = steps + 1;
	} return ancestor == 0;
}
