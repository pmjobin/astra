		else {
			token = checked.bindings.program.arena.get_token_identifier(node);
		}
		var symbol = checked_target(checked, node, token);
		if (symbol.index < 1 || symbol.index > checked.bindings.symbol_count) return no_type();
		var declaration = checked.bindings.symbol(symbol); var type = checked.symbol_types[symbol.index]; int flags = checked.symbol_flags[symbol.index];
		if ((declaration.kind != 7 && declaration.kind != 8) || declaration.owner.index != member.index) return no_type();
		if (kind == SyntaxKind.MoveExpressionSyntax()) {
			if (!recover_template_parameter(checked, owner, type) || flags != 4 || !live[symbol.index] || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(node)) != 0) return no_type();
			live[symbol.index] = false; return type;
		}
		if (flags == 0 && (type_numeric(checked_kind(checked, type)) || type.index == 13)) return type;
		return no_type();
	}
	if (kind == SyntaxKind.FieldAccessExpressionSyntax()) {
		if (!checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_field_name(node), "capacity") || recover_template_field(checked, owner, checked.bindings.program.arena.get_node_aggregate(node)).index == 0) return no_type();
		return type_id(1);
	}
	if (kind != SyntaxKind.CallExpressionSyntax() || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_arguments(node)) != 0) return no_type();
	var arguments = checked.bindings.program.arena.get_list_arguments(node);
	if (checked_flow_intrinsic(checked, node)) {
		if (!checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_identifier(node), "len") || checked.bindings.program.arena.list_count(arguments) != 1 || recover_template_field(checked, owner, checked.bindings.program.arena.node_at(arguments, 0)).index == 0) return no_type();
		return type_id(1);
	}
	int action = class_storage_slot_action(checked, node);
	var field = recover_template_field(checked, owner, checked.bindings.program.arena.get_node_receiver_place(node));
	if (action < 1 || action > 4 || field.index == 0) return no_type();
	var element = checked.types.argument(checked.types, checked.symbol_types[field.index], 0).type;
	int count = 1; if (action == 4) count = 2;
	if (checked.bindings.program.arena.list_count(arguments) != count) return no_type();
	int i = 0;
	while (i < count) {
		var child = checked.bindings.program.arena.node_at(arguments, i);
		var type = recover_template_value(checked, owner, member, child, live, work, depth + 1);
		var expected = type_id(1); if (action == 2 || action == 4 && i == 1) expected = element;
		if (expected.index == element.index && checked.bindings.program.arena.kind(child) != SyntaxKind.MoveExpressionSyntax()) return no_type();
