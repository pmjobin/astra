// Ordinary success storage has no Error header. These queries reuse the
// existing Class/record rules and never establish a lexical receiver root.
bool recover_storage_class(CheckedIndex checked, TypeId type) {
	if (checked_kind(checked, type) != 31 || !class_storage_source_verified(checked, type, false, 0)) return false;
	// Layout admission alone grants no receiver or initialization authority.
	return class_storage_fields_verified(checked, type, 0) && recover_storage_fields(checked, type, 0);
}

// Definition-time coverage for exact heap-Class slot collections. A lexical
// `this` selects a source declaration here; it is never a native receiver root.
// Every concrete method still needs the ordinary Flow/owner/CFG/SSA consumers.
bool recover_template_parameter(CheckedIndex checked, SymbolId owner, TypeId type) {
	if (checked_kind(checked, type) != 33) return false;
	var shape = checked.types.row(type); if (shape.count != 0 || shape.extent != 0) return false;
	var parameter = shape.nominal;
	return parameter.index > 0 && checked.bindings.symbol(parameter).kind == 9 && checked.bindings.symbol(parameter).owner.index == owner.index;
}

SymbolId recover_template_field(CheckedIndex checked, SymbolId owner, SyntaxNodeId node) {
	if (node.index == 0 || checked.bindings.program.arena.kind(node) != SyntaxKind.FieldAccessExpressionSyntax() || checked.bindings.program.arena.get_node_aggregate(node).index != 0 || !checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_identifier(node), "this")) return type_symbol(0);
	var token = checked.bindings.program.arena.get_token_field_name(node); var resolved = checked_target(checked, node, token);
	var declaration = checked.bindings.symbol(owner); var fields = checked.bindings.program.arena.get_list_fields(declaration.node); int i = 0;
	while (i < checked.bindings.program.arena.list_count(fields)) {
		var field_node = checked.bindings.program.arena.node_at(fields, i); var field = checked.node_symbols[field_node.index];
		if (field.index > 0 && checked.bindings.symbol(field).owner.index == owner.index && generic_token_equal(checked, checked.bindings.symbol(field).token, token)) {
			if (resolved.index != 0 && resolved.index != field.index) return type_symbol(0);
			return field;
		}
		i = i + 1;
	}
	return type_symbol(0);
}

TypeId recover_template_value(CheckedIndex checked, SymbolId owner, SymbolId member, SyntaxNodeId node, bool[] live, int[] work, int depth) {
	if (node.index == 0 || depth > 192 || work[0] == 0) return no_type();
	work[0] = work[0] - 1; var kind = checked.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.ParenthesizedExpressionSyntax()) return recover_template_value(checked, owner, member, checked.bindings.program.arena.get_node_expression(node), live, work, depth + 1);
	if (kind == SyntaxKind.IntegerLiteralExpressionSyntax() || kind == SyntaxKind.FloatLiteralExpressionSyntax() || kind == SyntaxKind.BooleanLiteralExpressionSyntax()) {
		var type = checked.uses[node.index].type; if (type_numeric(checked_kind(checked, type)) || type.index == 13) return type; return no_type();
	}
