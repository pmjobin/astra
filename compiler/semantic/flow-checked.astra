// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// General checked-use adapters, enabled only by the ownership consumer.
// Types/qualifiers are evidence, never an ownership/constructor safety proof.
bool checked_c_scalar_type(CheckedIndex index, TypeId type, bool result) {
	int kind = checked_kind(index, type);
	if (kind == 1 || kind == 11 || kind == 12 || kind == 16 || (result && kind == 14)) return true;
	if (kind != 20) return false;
	var pointee = index.types.argument(index.types, type, 0);
	return pointee.flags == 0 && checked_kind(index, pointee.type) == 14;
}

// Opt-in admission of existing explicit C0 scalar C semantics. Metadata,
// owned channels, borrowed C exports, callbacks and aggregate C ABI defer.
// Imported borrowed void* is a trusted noescape assertion, not an LLVM alias
// or capture premise and not a proof of the foreign implementation.
bool checked_c_scalar_signature(CheckedIndex index, SymbolId symbol) {
	if (!index.native_abi || !index.semantic_admission || symbol.index < 1 || symbol.index > index.bindings.symbol_count || index.symbol_signatures[symbol.index].index < 1) return false;
	var declaration = index.bindings.symbol(symbol);
	if (declaration.kind != 1 || index.bindings.program.arena.kind(declaration.node) != SyntaxKind.FunctionDeclarationSyntax()) return false;
	var node = declaration.node;
	bool imported = index.bindings.program.arena.get_token_extern_keyword(node).index != 0;
	bool exported = index.bindings.program.arena.get_token_export_keyword(node).index != 0;
	if (imported == exported || !index.bindings.program.arena.token_is(index.bindings.program.arena.get_token_abi_identifier(node), "C")) return false;
	if (index.bindings.program.arena.get_node_foreign_policy(node).index != 0 || index.bindings.program.arena.get_node_foreign_member(node).index != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_foreign_channels(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_ccode(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_floating_point(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_parameters(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_where_clauses(node)) != 0) return false;
	var signature = index.signatures[index.symbol_signatures[symbol.index].index - 1];
	if (signature.flags != 16 || signature.dispatch != 0 || signature.error.index != 0) return false;
	var shape = index.types.row(signature.callable);
	if (shape.count < 1 || shape.count > 257) return false;
	int i = 0;
	while (i < shape.count) {
		var channel = index.types.argument(index.types, signature.callable, i);
		int kind = checked_kind(index, channel.type);
		bool noescape = imported && i > 0 && channel.flags == 2 && (kind == 16 || kind == 20);
		if ((channel.flags != 0 && !noescape) || !checked_c_scalar_type(index, channel.type, i == 0)) return false;
		i = i + 1;
	}
	return imported == (index.bindings.program.arena.get_node_body(node).index == 0);
}

bool checked_flow_index_kind(SyntaxKind kind) {
	return kind == SyntaxKind.IndexExpressionSyntax() || kind == SyntaxKind.VectorExtractExpressionSyntax();
}

bool checked_flow_admits(SyntaxKind kind) {
	return kind == SyntaxKind.MoveExpressionSyntax() || kind == SyntaxKind.AddressOfExpressionSyntax() || kind == SyntaxKind.BufferAllocationSyntax() || kind == SyntaxKind.HeapObjectConstructionSyntax() || checked_flow_index_kind(kind) || kind == SyntaxKind.DereferenceExpressionSyntax();
}

bool checked_flow_intrinsic(CheckedIndex index, SyntaxNodeId node) {
	return index.bindings.program.arena.token_is(index.bindings.program.arena.get_token_identifier(node), "len") && checked_target(index, node, index.bindings.program.arena.get_token_identifier(node)).index == 0;
}

TypeId checked_flow_expression(CheckedIndex index, SyntaxNodeId node, TypeId expected, int depth) throws Error {
	var kind = index.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.MoveExpressionSyntax() || kind == SyntaxKind.AddressOfExpressionSyntax()) {
		SyntaxTokenId token = {
			index = 0
		};
		if (kind == SyntaxKind.MoveExpressionSyntax()) {
			token = index.bindings.program.arena.get_token_source(node);
		} else {
			token = index.bindings.program.arena.get_token_identifier(node);
		}
		var symbol = checked_target(index, node, token);
		if (symbol.index == 0 || (kind == SyntaxKind.MoveExpressionSyntax() && index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_fields(node)) != 0)) {
			return index.defer(node, 19);
		}
		var type = index.symbol_types[symbol.index];
		if (kind == SyntaxKind.AddressOfExpressionSyntax()) {
			if (type.index == 0) {
				return index.defer(node, 15);
			}
			return index.types.unary(20, type, 0);
		}
		var use = index.uses[node.index];
		use.flags = 4;
		if (kind == SyntaxKind.MoveExpressionSyntax() && generic_record_move_type(index, node, type)) use.flags = 0;
		use.deferred = 19;
		index.uses[node.index] = use;
		return type;
	}
	if (kind == SyntaxKind.BufferAllocationSyntax()) {
		var element = checked_resolve(index, index.bindings.program.arena.get_node_element_type(node), 0, 0);
		if (class_storage_slot_initialization(index, node, expected)) {
			var argument = index.types.argument(index.types, expected, 0);
			checked_mismatch(index, index.bindings.program.arena.header(node).span, argument.type, element, "owner-slot initializer element");
			var use = index.uses[node.index]; use.flags = 4; use.deferred = 19; index.uses[node.index] = use;
			return expected;
		}
		var count_node = index.bindings.program.arena.get_node_count(node);
		var count = checked_expression(index, count_node, type_id(1), depth + 1);
		checked_mismatch(index, index.bindings.program.arena.header(count_node).span, type_id(1), count, "buffer count");
		var use = index.uses[node.index];
		use.flags = 4;
		use.deferred = 19;
		index.uses[node.index] = use;
		if (element.index == 0) {
			return no_type();
		}
		return index.types.unary(22, element, 0);
	}
	if (kind == SyntaxKind.HeapObjectConstructionSyntax()) {
		var type = checked_resolve(index, index.bindings.program.arena.get_node_class_name(node), 0, 0);
		var arguments = checked_call_arguments(index, node);
		var constructor = type_symbol(0);
		if (index.semantic_flow && checked_kind(index, type) == 31 && checked_flow_receiver_shape(index, type)) constructor = checked_constructor(index, type);
		int i = 0;
		while (i < index.bindings.program.arena.list_count(arguments)) {
			var expected_argument = no_type();
			int flags = 0;
			if (constructor.index != 0 && index.symbol_signatures[constructor.index].index > 0) {
				var signature = index.signatures[index.symbol_signatures[constructor.index].index - 1];
				var descriptor = index.types.descriptor(index.types, signature.callable);
				int offset = 1; if (class_storage_initializing(index, constructor)) offset = 2;
				if (descriptor.count != index.bindings.program.arena.list_count(arguments) + offset) {
					index.fail(index.uses[node.index].span, "constructor argument count does not match signature");
					return no_type();
				}
				var parameter = index.types.argument(index.types, signature.callable, i + offset);
				expected_argument = parameter.type;
				flags = parameter.flags;
			}
			var argument = index.bindings.program.arena.node_at(arguments, i);
			var actual = checked_expression(index, argument, expected_argument, depth + 1);
			if (index.semantic_flow) {
				checked_mismatch(index, index.uses[argument.index].span, expected_argument, actual, "constructor argument");
				var contract = checked_contract(index, argument, flags);
			}
			i = i + 1;
		}
		var use = index.uses[node.index];
		use.flags = 4;
		use.deferred = 19;
		index.uses[node.index] = use;
		return type;
	}
	SyntaxNodeId operand = {
		index = 0};
	if (checked_flow_index_kind(kind)) {
		operand = index.bindings.program.arena.get_node_container(node);
	} else {
		operand = index.bindings.program.arena.get_node_pointer(node);
	}
	var type = checked_expression(index, operand, no_type(), depth + 1);
	if (checked_flow_index_kind(kind)) {
		var subscript = index.bindings.program.arena.get_node_subscript(node);
		var ignored = checked_expression(index, subscript, type_id(1), depth + 1);
	}
	int code = checked_kind(index, type);
	if ((kind == SyntaxKind.DereferenceExpressionSyntax() && code == 20) || (checked_flow_index_kind(kind) && (code == 21 || code == 22))) {
		return index.types.argument(index.types, type, 0).type;
	}
	return index.defer(node, 15);
}

TypeId checked_flow_length(CheckedIndex index, SyntaxNodeId node, int depth) throws Error {
	var args = checked_call_arguments(index, node);
	if (index.bindings.program.arena.list_count(args) != 1) {
		return index.defer(node, 17);
	}
	var operand = index.bindings.program.arena.node_at(args, 0);
	var type = checked_expression(index, operand, no_type(), depth + 1);
	int code = checked_kind(index, type);
	if (code == 21 || code == 22 || index.class_storage && code == 23) {
		return type_id(1);
	}
	return index.defer(node, 17);
}

owned CheckedIndex flow_checked_index(owned BindingIndex bindings) throws Error {
	var result = checked_build(move bindings, 0, true, false);
	return move result;
}

bool checked_flow_statement(CheckedIndex index, SyntaxNodeId node, int depth) throws Error {
	var kind = index.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.ReleaseStatementSyntax()) {
		var ignored = index.defer(node, 19);
		var recorded = index.record(node, type_id(14), 0);
		return true;
	}
	if (kind != SyntaxKind.DereferenceAssignmentSyntax() && kind != SyntaxKind.IndexedAssignmentSyntax()) {
		return false;
	}
	var target = index.bindings.program.arena.get_node_target(node);
	var expected = checked_expression(index, target, no_type(), depth + 1);
	var value = index.bindings.program.arena.get_node_expression(node);
	var actual = checked_expression(index, value, expected, depth + 1);
	checked_mismatch(index, index.bindings.program.arena.header(value).span, expected, actual, "store");
	var ignored = index.record(node, expected, 0);
	return true;
}

// Result context may search value operators, but never comparisons or call arguments.
TypeId checked_flow_context(CheckedIndex index, SyntaxNodeId node, int depth) throws Error {
	var kind = index.bindings.program.arena.kind(node);
	if (checked_flow_index_kind(kind) || kind == SyntaxKind.DereferenceExpressionSyntax()) {
		SyntaxNodeId source = {
			index = 0};
		if (checked_flow_index_kind(kind)) {
			source = index.bindings.program.arena.get_node_container(node);
		} else {
			source = index.bindings.program.arena.get_node_pointer(node);
		}
		var type = checked_context(index, source, depth + 1);
		int code = checked_kind(index, type);
		if (code == 20 || code == 21 || code == 22) {
			return index.types.argument(index.types, type, 0).type;
		}
		return no_type();
	}
	var token = index.bindings.program.arena.get_token_operator_token(node);
	if (kind == SyntaxKind.PrefixExpressionSyntax()) {
		if (index.bindings.program.arena.token_is(token, "!")) {
			return no_type();
		}
		return checked_context(index, index.bindings.program.arena.get_node_operand(node), depth + 1);
	}
	if (index.bindings.program.arena.token_is(token, "==") || index.bindings.program.arena.token_is(token, "!=") || index.bindings.program.arena.token_is(token, "<") || index.bindings.program.arena.token_is(token, "<=") || index.bindings.program.arena.token_is(token, ">") || index.bindings.program.arena.token_is(token, ">=")) {
		return no_type();
	}
	var left = checked_context(index, index.bindings.program.arena.get_node_left(node), depth + 1);
	if (left.index != 0 || index.bindings.program.arena.token_is(token, "<<") || index.bindings.program.arena.token_is(token, ">>")) {
		return left;
	}
	return checked_context(index, index.bindings.program.arena.get_node_right(node), depth + 1);
}

// The semantic consumer retains all original uses and adds no foreign authority.
owned CheckedIndex flowsem_checked_index(owned BindingIndex bindings) throws Error {
	return checked_build(move bindings, 0, true, true);
}

bool checked_record_owned(CheckedIndex index, TypeId type, int depth) {
	if (checked_kind(index, type) != 30 || depth > 64) return false;
	var descriptor = index.types.descriptor(index.types, type);
	var declaration = index.bindings.symbol(descriptor.nominal);
	var fields = index.bindings.program.arena.get_list_fields(declaration.node);
	int i = 0;
	while (i < index.bindings.program.arena.list_count(fields)) {
		var field = index.bindings.program.arena.node_at(fields, i);
		var symbol = index.node_symbols[field.index];
		if (symbol.index != 0 && ((index.symbol_flags[symbol.index] & 4) != 0 || checked_record_owned(index, index.symbol_types[symbol.index], depth + 1))) return true;
		i = i + 1;
	}
	return false;
}

TypeId checked_this_type(CheckedIndex index, SyntaxNodeId node, SyntaxTokenId token) {
	if (!index.semantic_flow || !index.bindings.program.arena.token_is(token, "this")) return no_type();
	var scope = index.bindings.scope_for_node(node);
	if (scope.index == 0) return no_type();
	var context = index.bindings.scope(scope);
	if (context.owner.index == 0) return no_type();
	var symbol = index.bindings.symbol(context.owner);
	if (index.class_storage && class_storage_receiver(index, context.owner) > 0) {
		int instance = generic_instance_for(index, context.owner);
		return index.instances[instance - 1].enclosing;
	}
	if (symbol.kind == 12 && symbol.owner.index != 0 && checked_flow_receiver_shape(index, index.symbol_types[symbol.owner.index])) return index.symbol_types[symbol.owner.index];
	return no_type();
}

SymbolId checked_constructor(CheckedIndex index, TypeId type) {
	if (index.class_storage && class_storage_class(index, type)) return class_storage_constructor(index, type);
	if (checked_kind(index, type) != 31) return type_symbol(0);
	var descriptor = index.types.descriptor(index.types, type);
	var declaration = index.bindings.symbol(descriptor.nominal);
	var members = index.bindings.program.arena.get_list_members(declaration.node);
	int i = 0;
	while (i < index.bindings.program.arena.list_count(members)) {
		var member = index.bindings.program.arena.node_at(members, i);
		if (index.bindings.program.arena.kind(member) == SyntaxKind.LifecycleDeclarationSyntax() && index.bindings.program.arena.token_is(index.bindings.program.arena.get_token_name(member), "init")) return index.node_symbols[member.index];
		i = i + 1;
	}
	return type_symbol(0);
}

bool checked_flow_declared_nonnull(CheckedIndex index, SymbolId symbol) {
	var declaration = index.bindings.symbol(symbol);
	var kind = index.bindings.program.arena.kind(declaration.node);
	if (kind != SyntaxKind.ParameterSyntax() && kind != SyntaxKind.LocalDeclarationSyntax() && kind != SyntaxKind.StructFieldDeclarationSyntax()) return false;
	var type = index.bindings.program.arena.get_node_type_name(declaration.node);
	return type.index != 0 && index.bindings.program.arena.kind(type) == SyntaxKind.NonNullTypeSyntax();
}

// Completing an implicit receiver must not expose unqualified storage families
// to the small type adapter (owner slots, shared fields and richer records).
bool checked_flow_receiver_shape(CheckedIndex index, TypeId type) {
	if (index.class_storage && class_storage_class(index, type)) return true;
	if (checked_kind(index, type) != 31) return false;
	var descriptor = index.types.descriptor(index.types, type);
	var declaration = index.bindings.symbol(descriptor.nominal);
	var node = declaration.node;
	if (index.bindings.program.arena.kind(node) != SyntaxKind.ClassDeclarationSyntax() || index.bindings.program.arena.get_node_parent_class(node).index != 0 || index.bindings.program.arena.get_node_foreign_import(node).index != 0 || index.bindings.program.arena.get_bool_is_interface(node) || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_parameters(node)) != 0) return false;
	var fields = index.bindings.program.arena.get_list_fields(node);
	int i = 0;
	while (i < index.bindings.program.arena.list_count(fields)) {
		var field = index.bindings.program.arena.node_at(fields, i);
		var symbol = index.node_symbols[field.index];
		if (symbol.index == 0) return false;
		var field_type = index.symbol_types[symbol.index];
		int code = checked_kind(index, field_type);
		bool admitted = type_numeric(code) || code == 13;
		if ((index.symbol_flags[symbol.index] & 4) != 0 && code == 22) {
			var element = index.types.argument(index.types, field_type, 0);
			admitted = type_numeric(checked_kind(index, element.type)) || checked_kind(index, element.type) == 13;
		}
		if ((index.symbol_flags[symbol.index] & 4) != 0 && code == 31) {
			var child = index.types.descriptor(index.types, field_type);
			var child_declaration = index.bindings.symbol(child.nominal);
			admitted = index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_fields(child_declaration.node)) == 0;
		}
		if (!admitted) return false;
		i = i + 1;
	}
	return true;
}
