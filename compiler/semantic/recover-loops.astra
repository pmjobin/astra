// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Loop targets are lexical identities, not value operands. Construction and
// the independent retained-tree walk establish the nearest enclosing loop.
RecoverNode recover_build_loop(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode initial, int depth) {
	var row = initial; var source = row.source; var kind = checked.bindings.program.arena.kind(source);
	if (kind == SyntaxKind.WhileStatementSyntax()) {
		row.kind = 28; row.type = type_id(14);
		row.a = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_condition(source), row.function, row.handler, row.caught, depth + 1);
		row.b = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_body(source), row.function, row.handler, row.caught, depth + 1);
	}
	if (kind == SyntaxKind.BreakStatementSyntax()) {
		row.kind = 29;
		row.type = type_id(14);
	}
	if (kind == SyntaxKind.ContinueStatementSyntax()) {
		row.kind = 41;
		row.type = type_id(14);
	}
	if (kind == SyntaxKind.AssignmentStatementSyntax()) {
		row.kind = 42; row.type = type_id(14); row.symbol = checked_target(checked, source, checked.bindings.program.arena.get_token_name(source));
		if (row.symbol.index > 0 && checked.symbol_flags[row.symbol.index] == 4) row.kind = 43;
		row.a = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_expression(source), row.function, row.handler, row.caught, depth + 1);
	}
	return row;
}

void recover_loop_bind(RecoverFlowData flow, int id, int loop, int depth) {
	if (id == 0 || flow.status != 0) return;
	if (depth > 192 || id > flow.node_count) {
		flow.status = 2;
		return;
	}
	var row = flow.nodes[id - 1];
	if (row.kind == 82) return;
	if (row.kind == 29 || row.kind == 41) {
		row.c = loop;
		flow.nodes[id - 1] = row;
		return;
	}
	recover_loop_bind(flow, row.a, loop, depth + 1);
	int nested = loop; if (row.kind == 28) nested = id;
	recover_loop_bind(flow, row.b, nested, depth + 1);
	if (row.kind == 21 || row.kind == 61 || row.kind == 76 || row.kind == 77) recover_loop_bind(flow, row.c, loop, depth + 1);
	int i = 0; while (i < row.count) {
		recover_loop_bind(flow, flow.edges[row.first + i], loop, depth + 1);
		i = i + 1;
	}
}

bool recover_loop_verify(RecoverFlowData flow, int id, int loop, int depth) {
	if (id == 0) return true;
	if (depth > 192 || id < 1 || id > flow.node_count) return false;
	var row = flow.nodes[id - 1];
	if (row.kind == 82) return true;
	if (row.kind == 29 || row.kind == 41) return loop > 0 && row.c == loop && flow.nodes[loop - 1].kind == 28 && flow.nodes[loop - 1].function == row.function;
	if (!recover_loop_verify(flow, row.a, loop, depth + 1)) return false;
	if (row.kind == 28) {
		if (!recover_loop_verify(flow, row.b, id, depth + 1)) return false;
	}
	else {
		if (!recover_loop_verify(flow, row.b, loop, depth + 1)) return false;
	}
	if ((row.kind == 21 || row.kind == 61 || row.kind == 76 || row.kind == 77) && !recover_loop_verify(flow, row.c, loop, depth + 1)) return false;
	int i = 0; while (i < row.count) {
		if (!recover_loop_verify(flow, flow.edges[row.first + i], loop, depth + 1)) return false;
		i = i + 1;
	}
	return true;
}

bool recover_loop_source(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, int depth) {
	var bindings = new u8[len(checked.symbol_types)];
	return recover_loop_source_with_bindings(flow, checked, types, row, function, handler, caught, seen, edges, bindings, depth);
}

bool recover_loop_source_with_bindings(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, u8[] bindings, int depth) {
	var kind = checked.bindings.program.arena.kind(row.source);
	if (row.kind == 28) return kind == SyntaxKind.WhileStatementSyntax() && row.c == 0 && recover_child_with_bindings(flow, checked, types, row.a, checked.bindings.program.arena.get_node_condition(row.source), function, handler, caught, seen, edges, bindings, depth + 1) && flow.nodes[row.a - 1].type.index == 13 && recover_child_with_bindings(flow, checked, types, row.b, checked.bindings.program.arena.get_node_body(row.source), function, handler, caught, seen, edges, bindings, depth + 1);
	if (row.kind == 29 || row.kind == 41) return row.a == 0 && row.b == 0 && row.c > 0 && row.c <= flow.node_count && (row.kind == 29 && kind == SyntaxKind.BreakStatementSyntax() || row.kind == 41 && kind == SyntaxKind.ContinueStatementSyntax());
	if (row.kind != 42 && row.kind != 43 || kind != SyntaxKind.AssignmentStatementSyntax() || row.b != 0 || row.c != 0 || row.symbol.index < 1 || row.symbol.index > checked.bindings.symbol_count) return false;
	var declaration = checked.bindings.symbol(row.symbol); var type = checked.symbol_types[row.symbol.index]; int code = checked_kind(checked, type);
	if (declaration.kind != 8 || declaration.owner.index != flow.functions[function - 1].symbol.index || checked_target(checked, row.source, checked.bindings.program.arena.get_token_name(row.source)).index != row.symbol.index || !recover_child_with_bindings(flow, checked, types, row.a, checked.bindings.program.arena.get_node_expression(row.source), function, handler, caught, seen, edges, bindings, depth + 1) || flow.nodes[row.a - 1].type.index != type.index) return false;
	if (row.kind == 42) return recover_copy_channel(checked, type, checked.symbol_flags[row.symbol.index], false);
	// C0 permits owned buffer rebinding, but forbids Class local rebinding.
	if (checked.symbol_flags[row.symbol.index] != 4 || code != 22 || !recover_storage_channel(checked, type, 4, false)) return false;
	int producer = row.a; int steps = 0;
	while (producer > 0 && producer <= flow.node_count && flow.nodes[producer - 1].kind == 7 && steps < 192) {
		producer = flow.nodes[producer - 1].a;
		steps = steps + 1;
	}
	return producer > 0 && producer <= flow.node_count && steps < 192 && (flow.nodes[producer - 1].kind == 4 || flow.nodes[producer - 1].kind == 9) && (checked.uses[flow.nodes[producer - 1].source.index].flags & 4) != 0;
}

bool recover_mutable(RecoverFlowData flow, SymbolId symbol) {
	return symbol.index > 0 && symbol.index < len(flow.mutable_symbols) && flow.mutable_symbols[symbol.index];
}
