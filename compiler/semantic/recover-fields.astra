			}
			if (row.kind == 17 && row.type.index != physical.semantic) return false;
			if (row.kind == 18 && (row.type.index != 1 || checked_kind(checked, type_id(physical.semantic)) != 22)) return false;
		}
		n = n + 1;
	}
	int i = 0;
	while (i < len(fields.facts)) {
		if (!seen[i]) {
			var fact = fields.facts[i];
			if (fact.receiver.index != 0 || fact.field.index != 0 || fact.aggregate.index != 0 || fact.slot != 0 || fact.parent != 0 || fact.ordinal != 0 || fact.offset != 0 || fact.cleanup_rank != 0 || fact.writable || fact.initializing) return false;
		}
		i = i + 1;
	}
	return true;
}
