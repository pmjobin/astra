// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Field authority is a nominal projection of an actual source receiver slot.
// Merely knowing the projected TypeId never creates a writable destination.
struct RecoverField {
	SymbolId receiver;
	SymbolId field;
	TypeId aggregate;
	int slot;
	int parent;
	int ordinal;
	int offset;
	int cleanup_rank;
	bool writable;
	bool initializing;
}

class RecoverFields {
	owned shared TypeOwner identity;
	owned ClassStoragePlan layout;
	owned ClassStoragePlan errors;
	owned RecoverField[] facts;

	init(CheckedIndex checked, owned ClassStoragePlan layout, owned ClassStoragePlan errors) {
		var identity = shared_clone(checked.types.identity); this.identity = move identity;
		this.layout = move layout; this.facts = new RecoverField[len(checked.uses)];
		this.errors = move errors;
	}
}

ClassStorageLayout recover_field_layout(RecoverFields fields, CheckedIndex checked, TypeId type) {
	if (error_storage_class(checked, type)) return fields.errors.types[type.index];
	return fields.layout.types[type.index];
}

ClassStorageField recover_field_physical(RecoverFields fields, CheckedIndex checked, TypeId type, SymbolId field) {
	if (error_storage_class(checked, type)) return fields.errors.fields[field.index];
	return fields.layout.fields[field.index];
}

// Resolve the implicit language receiver through its concrete specialization,
// then check the actual declared borrowed parameter and callable channel.
SymbolId recover_field_receiver_at(CheckedIndex checked, SyntaxNodeId projection, SymbolId function, int depth) {
	if (projection.index == 0 || depth > 192) return type_symbol(0);
	var aggregate = checked.bindings.program.arena.get_node_aggregate(projection);
	if (aggregate.index > 0 && checked.bindings.program.arena.kind(aggregate) == SyntaxKind.FieldAccessExpressionSyntax()) return recover_field_receiver_at(checked, aggregate, function, depth + 1);
	var receiver = recover_type_receiver(checked, projection);
	if (receiver.index == 0 && checked.bindings.program.arena.get_node_aggregate(projection).index == 0 && checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_identifier(projection), "this")) {
		var plan = checked_source_plan(checked, function);
		if (plan.concrete.index != function.index || plan.enclosing.index == 0) return type_symbol(0);
		int id = class_storage_receiver(checked, function);
		if (id < 1 || id > checked.bindings.symbol_count) return type_symbol(0);
		receiver = type_symbol(id);
		var parameter = checked.bindings.symbol(receiver);
		if (parameter.kind != 7 || parameter.owner.index != function.index || checked.symbol_flags[id] != 2 || checked.symbol_types[id].index != plan.enclosing.index) return type_symbol(0);
		int signature = checked.symbol_signatures[function.index].index;
		if (signature < 1 || signature > checked.signature_count) return type_symbol(0);
		var callable = checked.signatures[signature - 1].callable;
		if (checked.types.row(callable).count < 2) return type_symbol(0);
		var channel = checked.types.argument(checked.types, callable, 1);
		if (channel.flags != 2 || channel.type.index != checked.symbol_types[id].index) return type_symbol(0);
	}
	if (receiver.index < 1 || receiver.index > checked.bindings.symbol_count) return type_symbol(0);
	var declaration = checked.bindings.symbol(receiver);
	if ((declaration.kind != 7 && declaration.kind != 8) || declaration.owner.index != function.index || checked_kind(checked, checked.symbol_types[receiver.index]) != 31) return type_symbol(0);
	return receiver;
}

SymbolId recover_field_receiver(CheckedIndex checked, SyntaxNodeId projection, SymbolId function) {
	return recover_field_receiver_at(checked, projection, function, 0);
}

SymbolId recover_source_function(CheckedIndex checked, SyntaxNodeId node) {
	var scope = checked.bindings.scope_for_node(node);
	int depth = 0;
	while (scope.index > 0 && depth < 192) {
		var current = checked.bindings.scope(scope);
		if (current.owner.index > 0) {
			var owner = checked.bindings.symbol(current.owner);
			if (owner.kind == 1 || owner.kind == 11 || owner.kind == 12) return current.owner;
		}
		scope = current.parent;
		depth = depth + 1;
	}
	return type_symbol(0);
}

// This walk is intentionally separate from constructor lowering. Before all
// fields are initialized, only parameter moves, literals and initialized field
// reads can contribute values. Passing/returning the receiver is never allowed.
bool recover_constructor_value(CheckedIndex checked, SyntaxNodeId node, SymbolId function, TypeId aggregate, bool[] initialized, int depth) {
	if (node.index == 0 || depth > 192) return false;
	var kind = checked.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.IntegerLiteralExpressionSyntax() || kind == SyntaxKind.FloatLiteralExpressionSyntax() || kind == SyntaxKind.BooleanLiteralExpressionSyntax() || kind == SyntaxKind.TextLiteralExpressionSyntax() || kind == SyntaxKind.NullPointerExpressionSyntax()) return true;
	if (kind == SyntaxKind.NameExpressionSyntax()) {
		var symbol = checked_target(checked, node, checked.bindings.program.arena.get_token_identifier(node));
		if (symbol.index < 1 || symbol.index >= len(initialized)) return false;
		var declaration = checked.bindings.symbol(symbol);
		if (declaration.owner.index != function.index || !checked.bindings.accessible(symbol, checked.bindings.scope_for_node(node))) return false;
		if (declaration.kind == 7) return symbol.index != class_storage_receiver(checked, function);
		return declaration.kind == 8 && initialized[symbol.index] && checked.symbol_flags[symbol.index] == 0;
	}
	if (kind == SyntaxKind.MoveExpressionSyntax()) {
		var symbol = checked_target(checked, node, checked.bindings.program.arena.get_token_source(node));
		return symbol.index > 0 && checked.bindings.symbol(symbol).kind == 7 && checked.bindings.symbol(symbol).owner.index == function.index && checked.symbol_flags[symbol.index] == 4 && checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(node)) == 0;
	}
	if (kind == SyntaxKind.ParenthesizedExpressionSyntax()) return recover_constructor_value(checked, checked.bindings.program.arena.get_node_expression(node), function, aggregate, initialized, depth + 1);
	if (kind == SyntaxKind.PrefixExpressionSyntax()) return recover_constructor_value(checked, checked.bindings.program.arena.get_node_operand(node), function, aggregate, initialized, depth + 1);
	if (kind == SyntaxKind.BinaryExpressionSyntax() || kind == SyntaxKind.ShortCircuitExpressionSyntax()) return recover_constructor_value(checked, checked.bindings.program.arena.get_node_left(node), function, aggregate, initialized, depth + 1) && recover_constructor_value(checked, checked.bindings.program.arena.get_node_right(node), function, aggregate, initialized, depth + 1);
	if (kind == SyntaxKind.StructInitializerSyntax()) {
		if (!recover_record_source(checked, node, checked.uses[node.index].type)) return false;
		var fields = checked.bindings.program.arena.get_list_fields(node);
		int i = 0;
		while (i < checked.bindings.program.arena.list_count(fields)) {
			var field = checked.bindings.program.arena.node_at(fields, i);
			if (!recover_constructor_value(checked, checked.bindings.program.arena.get_node_expression(field), function, aggregate, initialized, depth + 1)) return false;
			i = i + 1;
		}
		return true;
	}
	if (kind == SyntaxKind.BufferAllocationSyntax()) {
		var type = checked.uses[node.index].type;
		if (checked_kind(checked, type) == 23) return class_storage_slot_initialization(checked, node, type) && recover_storage_slots(checked, type, 0);
		return checked.bindings.program.arena.get_node_allocation_context(node).index == 0 && checked.bindings.program.arena.get_node_failure_call(node).index == 0 && recover_constructor_value(checked, checked.bindings.program.arena.get_node_count(node), function, aggregate, initialized, depth + 1);
	}
	if (kind == SyntaxKind.CallExpressionSyntax() && checked_flow_intrinsic(checked, node)) {
		var arguments = checked_call_arguments(checked, node);
		return checked.bindings.program.arena.list_count(arguments) == 1 && recover_constructor_value(checked, checked.bindings.program.arena.node_at(arguments, 0), function, aggregate, initialized, depth + 1);
	}
	if (kind == SyntaxKind.CallExpressionSyntax() && class_storage_slot_call_present(checked, node)) {
		if (class_storage_slot_action(checked, node) != 1 || checked.uses[node.index].type.index != 13) return false;
		var place = checked.bindings.program.arena.get_node_receiver_place(node);
		if (place.index < 1 || checked.bindings.program.arena.kind(place) != SyntaxKind.FieldAccessExpressionSyntax() || checked.bindings.program.arena.get_node_aggregate(place).index != 0 || !checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_identifier(place), "this")) return false;
		var field = checked_target(checked, place, checked.bindings.program.arena.get_token_field_name(place));
		if (field.index < 1 || field.index >= len(initialized) || !initialized[field.index] || checked.bindings.symbol(field).kind != 6 || checked.bindings.symbol(field).owner.index != checked.types.row(aggregate).nominal.index || !recover_storage_slots(checked, checked.symbol_types[field.index], 0) || recover_field_receiver(checked, place, function).index != class_storage_receiver(checked, function)) return false;
		var arguments = checked.bindings.program.arena.get_list_arguments(node);
		if (checked.bindings.program.arena.list_count(arguments) != 1) return false;
		var capacity = checked.bindings.program.arena.node_at(arguments, 0);
		return checked.uses[capacity.index].type.index == 1 && recover_constructor_value(checked, capacity, function, aggregate, initialized, depth + 1);
	}
	if (kind == SyntaxKind.CallExpressionSyntax()) {
		var arguments = checked_call_arguments(checked, node);
		if (checked_shared_action(checked, node) == 3) return checked.bindings.program.arena.list_count(arguments) == 1 && recover_constructor_value(checked, checked.bindings.program.arena.node_at(arguments, 0), function, aggregate, initialized, depth + 1);
		var target = checked_target(checked, node, checked.bindings.program.arena.get_token_identifier(node));
		if (target.index < 1 || target.index > checked.bindings.symbol_count || checked.bindings.symbol(target).owner.index != 0) return false;
		bool foreign = recover_foreign_source(checked, target);
		if (foreign) {
			if (!recover_foreign_call(checked, node, target, checked.uses[node.index].type)) return false;
		} else {
			if (!recover_call_source(checked, node, target, checked.uses[node.index].type)) return false;
		}
		var signature = checked.signatures[checked.symbol_signatures[target.index].index - 1];
		if (!foreign && signature.flags != 0 || checked.types.argument(checked.types, signature.callable, 0).flags != 0) return false;
		int p = 0;
		while (p < checked.bindings.program.arena.list_count(arguments)) {
			var channel = checked.types.argument(checked.types, signature.callable, p + 1);
			if ((channel.flags & 4) != 0 || !recover_constructor_value(checked, checked.bindings.program.arena.node_at(arguments, p), function, aggregate, initialized, depth + 1)) return false;
			p = p + 1;
		}
		return true;
	}
	if (kind != SyntaxKind.FieldAccessExpressionSyntax()) return false;
	var field = checked_target(checked, node, checked.bindings.program.arena.get_token_field_name(node));
	if (field.index < 1 || field.index >= len(initialized) || !initialized[field.index] || checked.bindings.symbol(field).owner.index != checked.types.row(aggregate).nominal.index) return false;
	return recover_field_receiver(checked, node, function).index == class_storage_receiver(checked, function);
}

// An indexed store does not initialize a field descriptor. Its actual own
// buffer field must already be initialized on the constructor's source path.
bool recover_constructor_indexed(CheckedIndex checked, SyntaxNodeId statement, SymbolId function, TypeId aggregate, bool[] initialized) {
	if (checked.bindings.program.arena.kind(statement) != SyntaxKind.IndexedAssignmentSyntax()) return false;
	var target = checked.bindings.program.arena.get_node_target(statement);
	if (!checked_flow_index_kind(checked.bindings.program.arena.kind(target))) return false;
	var container = checked.bindings.program.arena.get_node_container(target);
	if (checked.bindings.program.arena.kind(container) != SyntaxKind.FieldAccessExpressionSyntax() || checked.bindings.program.arena.get_node_aggregate(container).index != 0 || !checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_identifier(container), "this")) return false;
	var field = checked_target(checked, container, checked.bindings.program.arena.get_token_field_name(container));
	if (field.index < 1 || field.index >= len(initialized) || !initialized[field.index] || checked.bindings.symbol(field).kind != 6 || checked.bindings.symbol(field).owner.index != checked.types.row(aggregate).nominal.index || (checked.symbol_flags[field.index] & ~256) != 4 || recover_field_receiver(checked, container, function).index != class_storage_receiver(checked, function)) return false;
	var type = checked.symbol_types[field.index];
	if (checked_kind(checked, type) != 22 || checked.uses[container.index].type.index != type.index) return false;
	var element = checked.types.argument(checked.types, type, 0);
	if (!recover_array_type(checked, type)) return false;
	var subscript = checked.bindings.program.arena.get_node_subscript(target);
	var value = checked.bindings.program.arena.get_node_expression(statement);
	return checked.uses[subscript.index].type.index == 1 && checked.uses[value.index].type.index == element.type.index && recover_constructor_value(checked, subscript, function, aggregate, initialized, 0) && recover_constructor_value(checked, value, function, aggregate, initialized, 0);
}

bool recover_constructor_fields_initialized(CheckedIndex checked, SyntaxListId fields, bool[] initialized) {
	int i = 0;
	while (i < checked.bindings.program.arena.list_count(fields)) {
		var field = checked.bindings.program.arena.node_at(fields, i);
		var symbol = checked.node_symbols[field.index];
		if (symbol.index < 1 || symbol.index >= len(initialized) || !initialized[symbol.index]) return false;
		i = i + 1;
	}
	return true;
}

// Conditional and loop bodies can change initialized scalar locals and write
// through an already initialized buffer field. Only the enclosing straight-line
// walk establishes that a field is initialized on all constructor paths.
bool recover_constructor_statement(CheckedIndex checked, SyntaxNodeId node, SymbolId function, TypeId aggregate, bool[] initialized, int depth) {
	if (node.index == 0 || depth > 192) return false;
	var kind = checked.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.BlockStatementSyntax()) {
		var statements = checked.bindings.program.arena.get_list_statements(node); int i = 0;
		while (i < checked.bindings.program.arena.list_count(statements)) {
			if (!recover_constructor_statement(checked, checked.bindings.program.arena.node_at(statements, i), function, aggregate, initialized, depth + 1)) return false;
			i = i + 1;
		}
		return true;
	}
	if (kind == SyntaxKind.IfStatementSyntax()) {
		var condition = checked.bindings.program.arena.get_node_condition(node);
		if (condition.index == 0 || checked.uses[condition.index].type.index != 13 || !recover_constructor_value(checked, condition, function, aggregate, initialized, depth + 1)) return false;
		var other = checked.bindings.program.arena.get_node_else_body(node);
		return recover_constructor_statement(checked, checked.bindings.program.arena.get_node_then_body(node), function, aggregate, initialized, depth + 1) && (other.index == 0 || recover_constructor_statement(checked, other, function, aggregate, initialized, depth + 1));
	}
	if (kind == SyntaxKind.WhileStatementSyntax()) {
		var condition = checked.bindings.program.arena.get_node_condition(node);
		return condition.index > 0 && checked.uses[condition.index].type.index == 13 && recover_constructor_value(checked, condition, function, aggregate, initialized, depth + 1) && recover_constructor_statement(checked, checked.bindings.program.arena.get_node_body(node), function, aggregate, initialized, depth + 1);
	}
	if (kind == SyntaxKind.IndexedAssignmentSyntax()) return recover_constructor_indexed(checked, node, function, aggregate, initialized);
	if (kind == SyntaxKind.CallStatementSyntax()) return recover_constructor_value(checked, checked.bindings.program.arena.get_node_call(node), function, aggregate, initialized, depth + 1);
	bool assignment = kind == SyntaxKind.AssignmentStatementSyntax();
	if (!assignment && kind != SyntaxKind.LocalDeclarationSyntax() && kind != SyntaxKind.InferredLocalDeclarationSyntax()) return false;
	var symbol = checked.node_symbols[node.index];
	var value = checked.bindings.program.arena.get_node_initializer(node);
	if (assignment) {
		symbol = checked_target(checked, node, checked.bindings.program.arena.get_token_name(node));
		value = checked.bindings.program.arena.get_node_expression(node);
	}
	if (symbol.index < 1 || symbol.index >= len(initialized) || checked.bindings.symbol(symbol).kind != 8 || checked.bindings.symbol(symbol).owner.index != function.index || checked.symbol_flags[symbol.index] != 0 || initialized[symbol.index] != assignment || !checked.bindings.accessible(symbol, checked.bindings.scope_for_node(node))) return false;
	var type = checked.symbol_types[symbol.index];
	if (!type_numeric(checked_kind(checked, type)) && type.index != 13 && !recover_storage_pointer(checked, type)) return false;
	if (value.index == 0 || checked.uses[value.index].type.index != type.index || !recover_constructor_value(checked, value, function, aggregate, initialized, depth + 1)) return false;
	initialized[symbol.index] = true;
	return true;
}

bool recover_field_constructor_verified(CheckedIndex checked, SymbolId function) {
	var plan = checked_source_plan(checked, function);
	if (plan.concrete.index == function.index && error_storage_class(checked, plan.enclosing)) return recover_error_constructor_source(checked, function);
	if (!class_storage_initializing(checked, function) || !generic_verify(checked)) return false;
	if (plan.concrete.index != function.index) return false;
	var type = plan.enclosing;
	if (!class_storage_source_verified(checked, type, false, 0)) return false;
	int receiver = class_storage_receiver(checked, function);
	if (receiver < 1 || receiver > checked.bindings.symbol_count || checked.bindings.symbol(type_symbol(receiver)).kind != 7 || checked.bindings.symbol(type_symbol(receiver)).owner.index != function.index || checked.symbol_types[receiver].index != type.index || checked.symbol_flags[receiver] != 2) return false;
	var origin = checked.bindings.symbol(plan.origin);
	if (origin.kind != 12 || origin.owner.index != class_storage_origin(checked, type).index) return false;
	var declaration = checked.bindings.symbol(checked.types.row(type).nominal);
	var fields = checked.bindings.program.arena.get_list_fields(declaration.node);
	var source = checked.bindings.symbol(function).node;
	if (!recover_plain_member(checked, source) || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_base_arguments(source)) != 0) return false;
	var body = checked.bindings.program.arena.get_node_body(source);
	if (body.index == 0 || checked.bindings.program.arena.kind(body) != SyntaxKind.BlockStatementSyntax()) return false;
	var statements = checked.bindings.program.arena.get_list_statements(body);
	var initialized = new bool[checked.bindings.symbol_count + 1]; int i = 0;
	while (i < checked.bindings.program.arena.list_count(statements)) {
		var statement = checked.bindings.program.arena.node_at(statements, i);
		if (checked.bindings.program.arena.kind(statement) == SyntaxKind.IndexedAssignmentSyntax()) {
			if (!recover_constructor_indexed(checked, statement, function, type, initialized)) return false;
			i = i + 1;
			continue;
		}
		if (checked.bindings.program.arena.kind(statement) == SyntaxKind.CallStatementSyntax()) {
			if (!recover_constructor_value(checked, checked.bindings.program.arena.get_node_call(statement), function, type, initialized, 0)) return false;
			i = i + 1;
			continue;
		}
		if (checked.bindings.program.arena.kind(statement) != SyntaxKind.FieldAssignmentStatementSyntax()) {
			if (!recover_constructor_statement(checked, statement, function, type, initialized, 0)) return false;
			i = i + 1;
			continue;
		}
		var target = checked.bindings.program.arena.get_node_target(statement);
		if (checked.bindings.program.arena.kind(target) != SyntaxKind.FieldAccessExpressionSyntax() || checked.bindings.program.arena.get_node_aggregate(target).index != 0 || !checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_identifier(target), "this")) return false;
		var field = checked_target(checked, target, checked.bindings.program.arena.get_token_field_name(target));
		if (field.index < 1 || initialized[field.index] || checked.bindings.symbol(field).kind != 6 || checked.bindings.symbol(field).owner.index != checked.types.row(type).nominal.index || recover_field_receiver(checked, target, function).index != class_storage_receiver(checked, function)) return false;
		var value = checked.bindings.program.arena.get_node_expression(statement);
		if (value.index == 0 || checked.uses[value.index].type.index != checked.symbol_types[field.index].index || !recover_constructor_value(checked, value, function, type, initialized, 0)) return false;
		initialized[field.index] = true; i = i + 1;
	}
	return recover_constructor_fields_initialized(checked, fields, initialized);
}

SyntaxNodeId recover_field_source(CheckedIndex checked, RecoverNode row) {
	if (row.kind == 17 || row.kind == 18) return row.source;
	if (row.kind == 44) return checked.bindings.program.arena.get_node_target(row.source);
	SyntaxNodeId absent = {index = 0}; return absent;
}

void recover_fields_build(RecoverFields fields, CheckedIndex checked, RecoverStorage storage, RecoverFlowData flow) {
	int n = 0;
	while (n < flow.node_count && flow.status == 0) {
		var row = flow.nodes[n]; var projection = recover_field_source(checked, row);
		if (projection.index > 0) {
			var function = flow.functions[row.function - 1].symbol;
			var receiver = recover_field_receiver(checked, projection, function);
			var member = checked_target(checked, projection, checked.bindings.program.arena.get_token_field_name(projection));
			var selected = member;
			member = text_storage_verified_projection(checked, member);
			if (member.index == 0 && selected.index > 0) {
				var declaration = checked.bindings.symbol(selected);
				var scalar = class_property_source(checked, declaration.node, declaration.owner);
				member = scalar.field;
			}
			if (receiver.index == 0 || member.index == 0 || storage.symbols[receiver.index] == 0) {
				flow.defer(row.source);
				return;
			}
			int parent = 0;
			if (row.kind == 17 || row.kind == 18) parent = row.a;
			var type = checked.symbol_types[receiver.index];
			if (parent > 0) type = flow.nodes[parent - 1].type;
			var layout = recover_field_layout(fields, checked, type); var field = recover_field_physical(fields, checked, type, member);
			bool initializing = parent == 0 && class_storage_initializing(checked, function) && receiver.index == class_storage_receiver(checked, function);
			int flags = checked.symbol_flags[member.index];
			RecoverField fact = {receiver = receiver, field = member, aggregate = type, slot = storage.symbols[receiver.index], parent = parent, ordinal = field.ordinal, offset = field.offset, cleanup_rank = layout.fields - 1 - field.ordinal, writable = (flags & 2) == 0 && ((flags & 128) == 0 || initializing), initializing = initializing};
			fields.facts[row.source.index] = fact;
		}
		n = n + 1;
	}
}

bool recover_fields_verify(RecoverFields fields, CheckedIndex checked, RecoverStorage storage, RecoverFlowData flow) {
	if (!type_owner_same(fields.identity, checked.types.identity) || !class_storage_verify(fields.layout, checked) || !recover_error_layout_verified(fields.errors, fields.layout, checked) || len(fields.facts) != len(checked.uses)) return false;
	var seen = new bool[len(fields.facts)]; int n = 0;
	while (n < flow.node_count) {
		var row = flow.nodes[n]; var projection = recover_field_source(checked, row);
		if (projection.index > 0) {
			if (seen[row.source.index] || checked.bindings.program.arena.kind(projection) != SyntaxKind.FieldAccessExpressionSyntax()) return false;
			seen[row.source.index] = true; var fact = fields.facts[row.source.index];
			if (row.function < 1 || row.function > flow.function_count || fact.receiver.index < 1 || fact.receiver.index > checked.bindings.symbol_count || fact.field.index < 1 || fact.field.index > checked.bindings.symbol_count || fact.slot < 1 || fact.slot > storage.count) return false;
			var function = flow.functions[row.function - 1].symbol;
			if (recover_field_receiver(checked, projection, function).index != fact.receiver.index || row.symbol.index != fact.receiver.index) return false;
			var slot = storage.slots[fact.slot - 1];
			if (slot.symbol.index != fact.receiver.index || slot.function != row.function || storage.symbols[fact.receiver.index] != fact.slot || checked.symbol_types[fact.receiver.index].index != slot.type.index || !class_storage_source_verified(checked, fact.aggregate, false, 0) && !error_storage_class(checked, fact.aggregate)) return false;
			if (fact.parent == 0) {
				if (slot.type.index != fact.aggregate.index) return false;
			} else {
				if (fact.parent < 1 || fact.parent > flow.node_count || row.kind != 17 && row.kind != 18 || row.a != fact.parent) return false;
				var parent = flow.nodes[fact.parent - 1];
				if (parent.kind != 17 || parent.function != row.function || parent.symbol.index != fact.receiver.index || parent.type.index != fact.aggregate.index || parent.source.index != checked.bindings.program.arena.get_node_aggregate(projection).index) return false;
			}
