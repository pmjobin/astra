// Private generic ABI: a unique owner and exactly one borrowed receiver.
// A source-owned T channel becomes value transport only for C0's copyable
// record specialization. Explicit owned Record declarations stay unsupported.
bool generic_record_channel(CheckedIndex index, SyntaxNodeId source_type, TypeId actual) {
	if (!index.class_storage || source_type.index <= index.generic_nodes || checked_kind(index, actual) != 30 || checked_record_owned(index, actual, 0) || index.bindings.program.arena.kind(source_type) != SyntaxKind.TypeNameSyntax()) return false;
	var parameter = checked_target(index, source_type, index.bindings.program.arena.get_token_identifier(source_type));
	if (parameter.index == 0) return false;
	var symbol = index.bindings.symbol(parameter);
	return symbol.kind == 9 && symbol.owner.index > 0 && index.bindings.symbol(symbol.owner).kind == 4 && class_storage_template_verified(index, symbol.owner);
}

int generic_channel_flags(CheckedIndex index, TypeId pattern, TypeId actual, int flags) {
	if (index.class_storage && checked_kind(index, pattern) == 33 && checked_kind(index, actual) == 30 && !checked_record_owned(index, actual, 0)) return flags & ~4;
	return flags;
}

bool generic_record_move_type(CheckedIndex index, SyntaxNodeId node, TypeId actual) {
	if (!index.class_storage || node.index <= index.generic_nodes || checked_kind(index, actual) != 30 || checked_record_owned(index, actual, 0)) return false;
	var scope = index.bindings.scope_for_node(node);
	if (scope.index == 0) return false;
	int instance = generic_instance_for(index, index.bindings.scope(scope).owner);
	if (instance == 0 || index.instances[instance - 1].enclosing.index == 0) return false;
	var owner = index.types.row(index.instances[instance - 1].enclosing);
	int outer = generic_instance_for(index, owner.nominal);
	return outer > 0 && class_storage_template_verified(index, index.instances[outer - 1].origin);
}

bool generic_record_move(CheckedIndex index, SyntaxNodeId node) {
	return generic_record_move_type(index, node, index.uses[node.index].type);
}

bool generic_empty_class(CheckedIndex index, TypeId type) {
	if (checked_kind(index, type) != 31) return false;
	var row = index.types.row(type);
	int ordinal = generic_instance_for(index, row.nominal);
	if (ordinal == 0) return false;
	var plan = index.instances[ordinal - 1]; var declaration = index.bindings.symbol(plan.origin);
	return declaration.kind == 4 && generic_class_source(index, plan.origin) && generic_check_node(index, plan, declaration.node);
}

SyntaxListId checked_call_arguments(CheckedIndex index, SyntaxNodeId node) {
	if (index.native_abi && node.index < len(index.generic_argument_lists) && index.generic_argument_lists[node.index].index != 0) return index.generic_argument_lists[node.index];
	return index.bindings.program.arena.get_list_arguments(node);
}

bool generic_class_source(CheckedIndex index, SymbolId origin) {
	var symbol = index.bindings.symbol(origin); var node = symbol.node;
	if (symbol.kind != 4 || index.bindings.program.arena.get_node_parent_class(node).index != 0 || index.bindings.program.arena.get_bool_is_interface(node) || index.bindings.program.arena.get_bool_exact_heap_class(node) || index.bindings.program.arena.get_token_exception_root(node).index != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_fields(node)) != 0) return false;
	var concurrency = index.bindings.program.arena.get_concurrency_concurrency_policy(node);
	if (concurrency.present || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_allocator(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_alignment(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_representation(node)) != 0 || index.bindings.program.arena.get_node_foreign_import(node).index != 0 || index.bindings.program.arena.get_node_foreign_export(node).index != 0 || index.bindings.program.arena.get_node_com_export(node).index != 0 || index.bindings.program.arena.get_node_gobject_export(node).index != 0) return false;
	var members = index.bindings.program.arena.get_list_members(node); int i = 0; int constructors = 0;
	while (i < index.bindings.program.arena.list_count(members)) {
		var member = index.bindings.program.arena.node_at(members, i); var kind = index.bindings.program.arena.kind(member);
		if (kind == SyntaxKind.LifecycleDeclarationSyntax()) {
			var body = index.bindings.program.arena.get_node_body(member);
			if (!index.bindings.program.arena.token_is(index.bindings.program.arena.get_token_name(member), "init") || body.index == 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_statements(body)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_parameters(member)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_base_arguments(member)) != 0) return false;
			constructors = constructors + 1;
		} else {
			if (kind != SyntaxKind.FunctionDeclarationSyntax() || index.bindings.program.arena.get_int_dispatch(member) != 0 || index.bindings.program.arena.get_node_body(member).index == 0) return false;
		}
		if (index.bindings.program.arena.get_node_throws_class(member).index != 0 || index.bindings.program.arena.get_token_async_keyword(member).index != 0 || index.bindings.program.arena.get_node_foreign_policy(member).index != 0 || index.bindings.program.arena.get_node_foreign_member(member).index != 0 || index.bindings.program.arena.get_bool_is_signal(member) || index.bindings.program.arena.get_token_extern_keyword(member).index != 0 || index.bindings.program.arena.get_token_export_keyword(member).index != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_ccode(member)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_floating_point(member)) != 0) return false;
		i = i + 1;
	}
	return constructors == 1;
}

SyntaxListId generic_class_members(CheckedIndex index, GenericInstance plan, SyntaxListId members, int depth) throws Error {
	var result = index.bindings.program.arena.new_list(syntax_kind_code(SyntaxKind.SyntaxNode())); int i = 0;
	while (i < index.bindings.program.arena.list_count(members) && !index.failed()) {
		var member = index.bindings.program.arena.node_at(members, i);
		if (index.bindings.program.arena.kind(member) == SyntaxKind.LifecycleDeclarationSyntax() || index.class_storage && index.bindings.program.arena.kind(member) == SyntaxKind.StructFieldDeclarationSyntax()) {
			var copy = generic_copy_node(index, plan, member, depth + 1);
			if (copy.index > 0) index.bindings.program.arena.append_node(result, copy);
		}
		i = i + 1;
	}
	return result;
}

bool generic_class_members_verified(CheckedIndex index, GenericInstance plan, SyntaxListId original, SyntaxListId concrete) {
	int i = 0; int p = 0;
	while (i < index.bindings.program.arena.list_count(original)) {
		var node = index.bindings.program.arena.node_at(original, i);
		if (index.bindings.program.arena.kind(node) == SyntaxKind.LifecycleDeclarationSyntax() || index.class_storage && index.bindings.program.arena.kind(node) == SyntaxKind.StructFieldDeclarationSyntax()) {
			if (p >= index.bindings.program.arena.list_count(concrete) || !generic_check_child(index, plan, node, index.bindings.program.arena.node_at(concrete, p))) return false;
			p = p + 1;
		}
		i = i + 1;
	}
	return p == index.bindings.program.arena.list_count(concrete);
}

SyntaxNodeId generic_hidden_parameter(CheckedIndex index, GenericInstance plan) throws Error {
	var original = index.bindings.symbol(plan.origin); var function = index.bindings.symbol(plan.concrete);
	var name_span = index.bindings.program.arena.token_span(original.token);
	var receiver_name = index.bindings.program.arena.generated_token(TokenKind.IDENTIFIER(), name_span, "_astra_receiver");
	var borrowed_keyword = index.bindings.program.arena.generated_token(TokenKind.BORROWED(), name_span, "borrowed");
	var receiver = index.types.row(plan.enclosing); var declaration = index.bindings.symbol(receiver.nominal);
	TypeNameSyntaxData type_data = {f_namespace_qualifier = {index = 0}, f_identifier = declaration.token, f_stars = {index = 0}};
	var type_node = index.bindings.program.arena.add_type_name(type_data, index.bindings.program.arena.token_span(declaration.token), 0);
	ParameterSyntaxData data = {f_caller_information = {index = 0}, f_type_name = type_node, f_name = receiver_name, f_borrowed_keyword = borrowed_keyword, f_owned_keyword = {index = 0}};
	var parameter = index.bindings.program.arena.add_parameter(data, name_span, 0);
	var params = index.bindings.program.arena.new_list(syntax_kind_code(SyntaxKind.ParameterSyntax()));
	index.bindings.program.arena.append_node(params, parameter);
	var source_params = index.bindings.program.arena.get_list_parameters(function.node); int i = 0;
	while (i < index.bindings.program.arena.list_count(source_params)) {
		index.bindings.program.arena.append_node(params, index.bindings.program.arena.node_at(source_params, i));
		i = i + 1;
	}
	index.bindings.program.arena.set_list_parameters(function.node, params);
	var symbol = original; symbol.kind = 7; symbol.node = parameter; symbol.token = receiver_name; symbol.span = name_span; symbol.owner = plan.concrete; symbol.name = index.bindings.names.intern("_astra_receiver"); symbol.first_reference = 0;
	var scope = index.bindings.scope_for_node(function.node); symbol.scope = scope;
	var id = index.bindings.append_instance_symbol(symbol, parameter);
	generic_resize(index); index.node_symbols[parameter.index] = id;
	index.bindings.set_instance_node_scope(parameter, scope); index.bindings.set_instance_node_scope(type_node, scope);
	var ignored = index.record(type_node, plan.enclosing, 0);
	return parameter;
}

bool generic_parameters_verified(CheckedIndex index, GenericInstance plan, SyntaxListId original, SyntaxListId concrete) {
	int offset = 0; if (plan.enclosing.index != 0) offset = 1;
	if (index.bindings.program.arena.list_count(concrete) != index.bindings.program.arena.list_count(original) + offset) return false;
	if (offset == 1) {
		var hidden = index.bindings.program.arena.node_at(concrete, 0);
		var symbol = index.node_symbols[hidden.index];
		if (symbol.index == 0 || index.symbol_types[symbol.index].index != plan.enclosing.index || index.symbol_flags[symbol.index] != 2 || !index.bindings.program.arena.token_is(index.bindings.program.arena.get_token_name(hidden), "_astra_receiver") || index.bindings.program.arena.get_token_owned_keyword(hidden).index != 0 || index.bindings.program.arena.get_token_borrowed_keyword(hidden).index == 0) return false;
		var type_node = index.bindings.program.arena.get_node_type_name(hidden);
		if (index.uses[type_node.index].type.index != plan.enclosing.index || index.bindings.program.arena.token_kind(index.bindings.program.arena.get_token_borrowed_keyword(hidden)) != TokenKind.BORROWED() || !index.bindings.program.arena.token_is(index.bindings.program.arena.get_token_borrowed_keyword(hidden), "borrowed")) return false;
		var declaration = index.bindings.symbol(symbol);
		if (declaration.kind != 7 || declaration.owner.index != plan.concrete.index) return false;
	}
	int i = 0;
	while (i < index.bindings.program.arena.list_count(original)) {
		if (!generic_check_child(index, plan, index.bindings.program.arena.node_at(original, i), index.bindings.program.arena.node_at(concrete, i + offset))) return false;
		i = i + 1;
	}
	return true;
}

void generic_method_arguments(CheckedIndex index, SyntaxNodeId call, SymbolId receiver) throws Error {
	var token = index.bindings.program.arena.get_token_receiver(call);
	NameExpressionSyntaxData data = {f_identifier = token};
	var node = index.bindings.program.arena.add_name_expression(data, index.bindings.program.arena.token_span(token), 0);
	var arguments = index.bindings.program.arena.new_list(syntax_kind_code(SyntaxKind.ExpressionSyntax()));
	index.bindings.program.arena.append_node(arguments, node);
	var original = index.bindings.program.arena.get_list_arguments(call); int i = 0;
	while (i < index.bindings.program.arena.list_count(original)) {
		index.bindings.program.arena.append_node(arguments, index.bindings.program.arena.node_at(original, i));
		i = i + 1;
	}
	var scope = index.bindings.scope_for_node(call);
	BindingReference reference = {node = node, token = token, span = index.bindings.program.arena.token_span(token), scope = scope, target = receiver, alternative = {index = 0}, state_code = 1, reason = 0, domain = 2, next_reference = 0};
	index.bindings.add_reference(reference); int number = index.bindings.reference_count;
	generic_resize(index); index.bindings.set_instance_node_scope(node, scope);
	index.node_references[node.index] = number; index.reference_next[number] = 0;
	index.generic_argument_lists[call.index] = arguments;
}

SymbolId generic_method_target(CheckedIndex index, SyntaxNodeId call, int depth) throws Error {
	var receiver_token = index.bindings.program.arena.get_token_receiver(call);
	if (receiver_token.index == 0 || index.bindings.program.arena.get_node_receiver_place(call).index != 0) return type_symbol(0);
	var receiver = checked_target(index, call, receiver_token);
	if (receiver.index == 0) return type_symbol(0);
	var enclosing = index.symbol_types[receiver.index];
	if (!generic_empty_class(index, enclosing) && !class_storage_class(index, enclosing)) return type_symbol(0);
	var class_type = index.types.row(enclosing); int outer = generic_instance_for(index, class_type.nominal) - 1;
	var origin = class_type.nominal; if (outer >= 0) origin = index.instances[outer].origin;
	var token = index.bindings.program.arena.get_token_identifier(call);
	SymbolId method = {index = 0}; int i = 1;
	while (i <= index.generic_symbols) {
		var candidate = index.bindings.symbol(type_symbol(i));
		if (candidate.kind == 11 && candidate.owner.index == origin.index && generic_token_equal(index, candidate.token, token)) {
			if (method.index != 0 || !index.bindings.accessible(type_symbol(i), index.bindings.scope_for_node(call))) return type_symbol(0);
			method = type_symbol(i);
		}
		i = i + 1;
	}
	if (method.index == 0) return method;
	var result = generic_select_call(index, call, method, enclosing, depth);
	if (result.index > 0) generic_method_arguments(index, call, receiver);
	return result;
}

int checked_call_argument_count(CheckedIndex index, SyntaxNodeId node) {
	var arguments = checked_call_arguments(index, node);
	return index.bindings.program.arena.list_count(arguments);
}
