// Capture both complete descriptors before either destination is overwritten.
// Destination responsibility and reverse declaration cleanup ranks stay fixed.
RecoverNode recover_build_exchange(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode initial, int depth) {
	var row = initial;
	if (checked.bindings.program.arena.kind(row.source) == SyntaxKind.SwapStatementSyntax()) {
		row.kind = 45; row.type = type_id(14);
		row.a = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_left(row.source), row.function, row.handler, row.caught, depth + 1);
		row.b = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_right(row.source), row.function, row.handler, row.caught, depth + 1);
	}
	return row;
}

bool recover_exchange_source(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, int depth) {
	var bindings = new u8[len(checked.symbol_types)];
	return recover_exchange_source_with_bindings(flow, checked, types, row, function, handler, caught, seen, edges, bindings, depth);
}

bool recover_exchange_source_with_bindings(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, u8[] bindings, int depth) {
	if (checked.bindings.program.arena.kind(row.source) != SyntaxKind.SwapStatementSyntax() || row.a < 1 || row.b < 1 || row.c != 0) return false;
	var left = checked.bindings.program.arena.get_node_left(row.source); var right = checked.bindings.program.arena.get_node_right(row.source);
	if (!owner_exchange_slot(checked, left) || !owner_exchange_slot(checked, right) || !recover_child_with_bindings(flow, checked, types, row.a, left, function, handler, caught, seen, edges, bindings, depth + 1) || !recover_child_with_bindings(flow, checked, types, row.b, right, function, handler, caught, seen, edges, bindings, depth + 1)) return false;
	var first = flow.nodes[row.a - 1]; var last = flow.nodes[row.b - 1];
	return first.type.index == last.type.index && checked_kind(checked, first.type) == 22 && (first.kind == 2 || first.kind == 17) && (last.kind == 2 || last.kind == 17);
}

bool recover_exchange_place(RecoverFlow flow, int id) {
	if (id < 1 || id > flow.data.node_count) return false;
	var row = flow.data.nodes[id - 1];
	if (row.kind == 17) {
		var fact = flow.fields.facts[row.source.index];
		return fact.parent == 0 && fact.writable && !fact.initializing && checked_kind(flow.checked, row.type) == 22 && (flow.checked.symbol_flags[fact.field.index] & (4 | 128)) == 4;
	}
	if (row.kind != 2 || row.symbol.index < 1 || row.symbol.index >= len(flow.storage.symbols)) return false;
	int place = flow.storage.symbols[row.symbol.index];
	return place > 0 && place <= flow.storage.count && flow.storage.slots[place - 1].owner && flow.storage.slots[place - 1].function == row.function && checked_kind(flow.checked, row.type) == 22;
}

// A field read exposes its selected value while inspecting its receiver chain.
// Only the independently source-checked field chain may occupy this role.
// Calls, moves and extra child effects cannot enter the chain. The caller checks
// the selected value against the captured aggregate before using this query.
bool recover_payload_field_read(RecoverFlowData flow, int id, int[] work, int depth) {
	if (id < 1 || id > flow.node_count || depth > 192 || work[0] == 0) return false;
	var first = flow.nodes[id - 1];
	if ((first.kind != 17 && first.kind != 18) || first.type.index < 1) return false;
	int current = id;
	int steps = depth;
	while (current > 0 && steps <= 192) {
		if (current > flow.node_count || work[0] == 0) return false;
		work[0] = work[0] - 1;
		var row = flow.nodes[current - 1];
		if ((row.kind != 17 && (current != id || row.kind != 18)) || row.function != first.function || row.symbol.index != first.symbol.index || row.symbol.index < 1 || row.b != 0 || row.c != 0 || row.count != 0 || row.a < 0) return false;
		current = row.a;
		steps = steps + 1;
	}
	return current == 0;
}

// Inspect the complete other-argument tree, including nested calls. A method
// on a possibly aliasing containing Class can replace a captured field even
// without moving its receiver. No noalias premise is inferred from symbols.
bool recover_payload_preserved(RecoverFlowData flow, int id, TypeId aggregate, int[] work, int depth) {
	if (id < 1 || id > flow.node_count || depth > 192 || work[0] == 0) return false;
	work[0] = work[0] - 1; var row = flow.nodes[id - 1];
	if (row.kind == 69 || aggregate.index > 0 && row.type.index == aggregate.index) return false;
	if (row.kind == 17 || row.kind == 18) return recover_payload_field_read(flow, id, work, depth);
	// The source-verified indexed read only inspects its backing projection.
	// Its index expression retains the other-argument effect checks.
	if (row.kind == 55) return recover_payload_preserved(flow, row.b, aggregate, work, depth + 1);
	if (row.a > 0 && !recover_payload_preserved(flow, row.a, aggregate, work, depth + 1) || row.b > 0 && !recover_payload_preserved(flow, row.b, aggregate, work, depth + 1) || row.c > 0 && !recover_payload_preserved(flow, row.c, aggregate, work, depth + 1)) return false;
	int i = 0;
	while (i < row.count) {
		if (!recover_payload_preserved(flow, flow.edges[row.first + i], aggregate, work, depth + 1)) return false;
		i = i + 1;
	}
	return true;
}

// Borrowed payloads cannot accompany an aliasing containing Class, or an
// explicit move of their own root. Borrowed payload locals are not admitted;
// forwarding parameters retain this obligation at their source call boundary.
bool recover_projection_preserved(RecoverFlow flow, int projection, int other, int[] work) {
	int current = projection;
	int depth = 0;
	while (current > 0 && depth < 192) {
		if (current > flow.data.node_count || work[0] == 0) return false;
		work[0] = work[0] - 1;
		var row = flow.data.nodes[current - 1];
		if (row.kind == 7) current = row.a;
		else {
			if (row.kind == 55 && row.a > 0 && row.a <= flow.data.node_count && recover_storage_slots(flow.checked, flow.data.nodes[row.a - 1].type, 0)) {
				current = row.a;
				depth = depth + 1;
				continue;
			}
			if (row.kind != 17) return true;
			var fact = flow.fields.facts[row.source.index];
			if (!recover_payload_preserved(flow.data, other, fact.aggregate, work, 0)) return false;
			current = fact.parent;
		}
		depth = depth + 1;
	}
	return current == 0;
}

bool recover_payload_calls_verified(RecoverFlow flow) {
	// Every module string result has independently reconstructed literal storage.
	// The call classifier below still binds the actual retained source function.
	if (!recover_literal_string_results(flow.data)) return false;
	var slot_borrows = new bool[flow.data.node_count];
	var work = new int[1]; work[0] = 8000000; int n = 0;
	while (n < flow.data.node_count) {
		var row = flow.data.nodes[n];
		if (row.kind == 45 && (!recover_exchange_place(flow, row.a) || !recover_exchange_place(flow, row.b))) return false;
		if (row.kind == 4 || recover_constructor_kind(row.kind) || row.kind == 50) {
			int signature = flow.checked.symbol_signatures[row.symbol.index].index; if (signature < 1 || signature > flow.checked.signature_count) return false;
			var callable = flow.checked.signatures[signature - 1].callable; int offset = 1; if (recover_constructor_kind(row.kind)) offset = 2;
			int i = 0;
			while (i < row.count) {
				var channel = flow.checked.types.argument(flow.checked.types, callable, i + offset); int kind = checked_kind(flow.checked, channel.type);
				if ((kind == 22 || kind == 15 || kind == 27 || kind == 31) && (channel.flags & 4) == 0) {
					int id = flow.data.edges[row.first + i]; int steps = 0;
					while (flow.data.nodes[id - 1].kind == 7 && steps < 192) {
						id = flow.data.nodes[id - 1].a;
						steps = steps + 1;
					}
					if (steps == 192) return false; var argument = flow.data.nodes[id - 1]; var root = type_symbol(0); TypeId aggregate = {index = 0};
					int projection = 0;
					bool module_string = recover_module_string_call(flow.data, argument);
					bool string_element = argument.kind == 55 && argument.type.index == 15 && argument.a > 0 && argument.a <= flow.data.node_count && recover_string_array(flow.checked, flow.data.nodes[argument.a - 1].type);
					if (string_element) {
						root = recover_array_root(flow, argument.a, false);
						if (root.index < 1 || flow.checked.bindings.symbol(root).kind != 7 || flow.checked.symbol_flags[root.index] != 0) return false;
						projection = argument.a;
					}
					bool slot_borrow = argument.kind == 55 && argument.a > 0 && argument.a <= flow.data.node_count && recover_storage_slots(flow.checked, flow.data.nodes[argument.a - 1].type, 0);
					if (slot_borrow) {
						if (row.kind != 4 || kind != 31 || channel.flags != 2) return false;
						root = recover_array_root(flow, argument.a, false);
						if (root.index == 0) return false;
						projection = argument.a;
						int container = argument.a; int container_steps = 0;
						while (flow.data.nodes[container - 1].kind == 7 && container_steps < 192) {
							container = flow.data.nodes[container - 1].a;
							container_steps = container_steps + 1;
						}
						if (container_steps == 192 || flow.data.nodes[container - 1].kind != 17) return false;
						aggregate = flow.fields.facts[flow.data.nodes[container - 1].source.index].aggregate;
						slot_borrows[id - 1] = true;
					}
					if (argument.kind == 56) {
						int input = flow.data.edges[argument.first];
						root = recover_array_root(flow, input, false);
						if (root.index == 0) return false;
						int depth = 0;
						while (flow.data.nodes[input - 1].kind == 7 && depth < 192) {
							input = flow.data.nodes[input - 1].a;
							depth = depth + 1;
						}
						if (depth == 192) return false;
						var backing = flow.data.nodes[input - 1];
						projection = input;
						if (backing.kind == 17) aggregate = flow.fields.facts[backing.source.index].aggregate;
					}
					if (argument.kind == 53) root = argument.symbol;
					if (argument.kind == 2) root = argument.symbol;
					if (argument.kind == 66) {
						if (!recover_error_borrow_binding(flow.checked, argument.symbol) || recover_caught_owner(flow.data, argument.symbol) < 1) return false;
						root = argument.symbol;
					}
					if (argument.kind == 17) {
						projection = id;
						var fact = flow.fields.facts[argument.source.index];
						root = fact.receiver;
						aggregate = fact.aggregate;
					}
					if (argument.kind == 19) {
						root = recover_shared_borrow_root(flow.data, flow.checked, id);
						if (root.index == 0) return false;
						int input = flow.data.edges[argument.first];
						int input_steps = 0;
						while (flow.data.nodes[input - 1].kind == 7 && input_steps < 192) {
							input = flow.data.nodes[input - 1].a;
							input_steps = input_steps + 1;
						}
						if (input_steps == 192) return false;
						var handle = flow.data.nodes[input - 1];
						projection = input;
						if (handle.kind == 17) aggregate = flow.fields.facts[handle.source.index].aggregate;
					}
					if (argument.kind != 1 && argument.kind != 51 && argument.kind != 53 && argument.kind != 56 && argument.kind != 2 && argument.kind != 17 && argument.kind != 19 && argument.kind != 66 && !slot_borrow && !module_string && !string_element) return false;
					int other = 0;
					while (other < row.count) {
						if (other != i) {
							int child = flow.data.edges[row.first + other];
							if (root.index > 0 && !recover_borrow_preserved(flow.data, child, root, work, 0)) return false;
							if (!recover_payload_preserved(flow.data, child, aggregate, work, 0)) return false;
							if (!recover_projection_preserved(flow, projection, child, work)) return false;
							var target = flow.checked.types.argument(flow.checked.types, callable, other + offset);
							if (aggregate.index > 0 && target.type.index == aggregate.index) return false;
						}
						other = other + 1;
					}
				}
				i = i + 1;
			}
		}
		n = n + 1;
	}
	n = 0;
	while (n < flow.data.node_count) {
		var row = flow.data.nodes[n];
		if (row.kind == 55 && row.a > 0 && row.a <= flow.data.node_count && recover_storage_slots(flow.checked, flow.data.nodes[row.a - 1].type, 0) && !slot_borrows[n]) return false;
		n = n + 1;
	}
	return work[0] > 0;
}
