		case SyntaxKind.InferredLocalDeclarationSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_initializer(node), reason, depth + 1);
		}
		case SyntaxKind.IntegerLiteralExpressionSyntax(): {
		}
		case SyntaxKind.LifecycleDeclarationSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_foreign_policy(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_throws_class(node), reason, depth + 1);
			var list_ccode = index.bindings.program.arena.get_list_ccode(node);
			int at_ccode = 0;
			while (at_ccode < index.bindings.program.arena.list_count(list_ccode)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_ccode, at_ccode), reason, depth + 1);
				at_ccode = at_ccode + 1;
			}
			var list_floating_point = index.bindings.program.arena.get_list_floating_point(node);
			int at_floating_point = 0;
			while (at_floating_point < index.bindings.program.arena.list_count(list_floating_point)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_floating_point, at_floating_point), reason, depth + 1);
				at_floating_point = at_floating_point + 1;
			}
			var list_where_clauses = index.bindings.program.arena.get_list_where_clauses(node);
			int at_where_clauses = 0;
			while (at_where_clauses < index.bindings.program.arena.list_count(list_where_clauses)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_where_clauses, at_where_clauses), reason, depth + 1);
				at_where_clauses = at_where_clauses + 1;
			}
			checked_deferred_node(index, index.bindings.program.arena.get_node_return_type(node), reason, depth + 1);
			var list_parameters = index.bindings.program.arena.get_list_parameters(node);
			int at_parameters = 0;
			while (at_parameters < index.bindings.program.arena.list_count(list_parameters)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_parameters, at_parameters), reason, depth + 1);
				at_parameters = at_parameters + 1;
			}
			checked_deferred_node(index, index.bindings.program.arena.get_node_body(node), reason, depth + 1);
			var list_base_arguments = index.bindings.program.arena.get_list_base_arguments(node);
			int at_base_arguments = 0;
			while (at_base_arguments < index.bindings.program.arena.list_count(list_base_arguments)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_base_arguments, at_base_arguments), reason, depth + 1);
				at_base_arguments = at_base_arguments + 1;
			}
		}
		case SyntaxKind.LocalDeclarationSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_type_name(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_initializer(node), reason, depth + 1);
		}
		case SyntaxKind.MatchStatementSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_scrutinee(node), reason, depth + 1);
			var list_arms = index.bindings.program.arena.get_list_arms(node);
			int at_arms = 0;
			while (at_arms < index.bindings.program.arena.list_count(list_arms)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_arms, at_arms), reason, depth + 1);
				at_arms = at_arms + 1;
			}
		}
		case SyntaxKind.MoveExpressionSyntax(): {
		}
		case SyntaxKind.NameExpressionSyntax(): {
		}
		case SyntaxKind.NonNullTypeSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_underlying(node), reason, depth + 1);
		}
		case SyntaxKind.NullPointerExpressionSyntax(): {
		}
		case SyntaxKind.OwnerSlotsTypeSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_element(node), reason, depth + 1);
		}
		case SyntaxKind.ParameterSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_caller_information(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_type_name(node), reason, depth + 1);
		}
		case SyntaxKind.ParenthesizedExpressionSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_expression(node), reason, depth + 1);
		}
		case SyntaxKind.PointerTypeSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_pointee(node), reason, depth + 1);
		}
		case SyntaxKind.PrefixExpressionSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_operand(node), reason, depth + 1);
		}
		case SyntaxKind.PropertyAccessorSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_parameter(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_body(node), reason, depth + 1);
		}
		case SyntaxKind.PropertyDeclarationSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_factory_syntax(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_throws_class(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_type_name(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_getter(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_setter(node), reason, depth + 1);
		}
		case SyntaxKind.ReleaseStatementSyntax(): {
		}
		case SyntaxKind.ReturnStatementSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_expression(node), reason, depth + 1);
		}
		case SyntaxKind.SharedTypeSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_payload(node), reason, depth + 1);
		}
		case SyntaxKind.ShortCircuitExpressionSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_left(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_right(node), reason, depth + 1);
		}
		case SyntaxKind.SliceTypeSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_element_type(node), reason, depth + 1);
		}
		case SyntaxKind.StructDeclarationSyntax(): {
			var list_allocator = index.bindings.program.arena.get_list_allocator(node);
			int at_allocator = 0;
			while (at_allocator < index.bindings.program.arena.list_count(list_allocator)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_allocator, at_allocator), reason, depth + 1);
				at_allocator = at_allocator + 1;
			}
			var list_alignment = index.bindings.program.arena.get_list_alignment(node);
			int at_alignment = 0;
			while (at_alignment < index.bindings.program.arena.list_count(list_alignment)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_alignment, at_alignment), reason, depth + 1);
				at_alignment = at_alignment + 1;
			}
			var list_representation = index.bindings.program.arena.get_list_representation(node);
			int at_representation = 0;
			while (at_representation < index.bindings.program.arena.list_count(list_representation)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_representation, at_representation), reason, depth + 1);
				at_representation = at_representation + 1;
			}
			var list_fields = index.bindings.program.arena.get_list_fields(node);
			int at_fields = 0;
			while (at_fields < index.bindings.program.arena.list_count(list_fields)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_fields, at_fields), reason, depth + 1);
				at_fields = at_fields + 1;
			}
			var list_where_clauses = index.bindings.program.arena.get_list_where_clauses(node);
			int at_where_clauses = 0;
			while (at_where_clauses < index.bindings.program.arena.list_count(list_where_clauses)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_where_clauses, at_where_clauses), reason, depth + 1);
				at_where_clauses = at_where_clauses + 1;
			}
		}
		case SyntaxKind.StructFieldDeclarationSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_type_name(node), reason, depth + 1);
		}
		case SyntaxKind.StructInitializerSyntax(): {
			var list_fields = index.bindings.program.arena.get_list_fields(node);
			int at_fields = 0;
			while (at_fields < index.bindings.program.arena.list_count(list_fields)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_fields, at_fields), reason, depth + 1);
				at_fields = at_fields + 1;
			}
		}
		case SyntaxKind.StructLocalDeclarationSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_type_name(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_initializer(node), reason, depth + 1);
		}
		case SyntaxKind.SwapStatementSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_left(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_right(node), reason, depth + 1);
		}
		case SyntaxKind.TextLiteralExpressionSyntax(): {
		}
		case SyntaxKind.TextMemberExpressionSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_receiver(node), reason, depth + 1);
		}
		case SyntaxKind.ThrowStatementSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_expression(node), reason, depth + 1);
		}
		case SyntaxKind.TryStatementSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_body(node), reason, depth + 1);
			var list_catches = index.bindings.program.arena.get_list_catches(node);
			int at_catches = 0;
			while (at_catches < index.bindings.program.arena.list_count(list_catches)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_catches, at_catches), reason, depth + 1);
				at_catches = at_catches + 1;
			}
		}
		case SyntaxKind.TypeNameSyntax(): {
		}
		case SyntaxKind.Utf8FactoryExpressionSyntax(): {
		}
		case SyntaxKind.VectorDotExpressionSyntax(): {
			var list_operands = index.bindings.program.arena.get_list_operands(node);
			int at_operands = 0;
			while (at_operands < index.bindings.program.arena.list_count(list_operands)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_operands, at_operands), reason, depth + 1);
				at_operands = at_operands + 1;
			}
			checked_deferred_node(index, index.bindings.program.arena.get_node_destination(node), reason, depth + 1);
		}
		case SyntaxKind.VectorExtractExpressionSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_container(node), reason, depth + 1);
		}
		case SyntaxKind.VectorInitializerSyntax(): {
			var list_lanes = index.bindings.program.arena.get_list_lanes(node);
			int at_lanes = 0;
			while (at_lanes < index.bindings.program.arena.list_count(list_lanes)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_lanes, at_lanes), reason, depth + 1);
				at_lanes = at_lanes + 1;
			}
		}
		case SyntaxKind.VectorPrimitiveExpressionSyntax(): {
			var list_operands = index.bindings.program.arena.get_list_operands(node);
			int at_operands = 0;
			while (at_operands < index.bindings.program.arena.list_count(list_operands)) {
				checked_deferred_node(index, index.bindings.program.arena.node_at(list_operands, at_operands), reason, depth + 1);
				at_operands = at_operands + 1;
			}
