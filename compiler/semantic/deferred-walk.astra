		case SyntaxKind.VectorReductionExpressionSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_operand(node), reason, depth + 1);
		}
		case SyntaxKind.VectorTypeSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_element_type(node), reason, depth + 1);
		}
		case SyntaxKind.WhereClauseSyntax(): {
