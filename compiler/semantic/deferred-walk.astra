		case SyntaxKind.WhileStatementSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_condition(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_body(node), reason, depth + 1);
		}
		case SyntaxKind.WithStatementSyntax(): {
			checked_deferred_node(index, index.bindings.program.arena.get_node_initializer(node), reason, depth + 1);
			checked_deferred_node(index, index.bindings.program.arena.get_node_body(node), reason, depth + 1);
		}
		else: { assert_that(false); }
	}
}

void checked_deferred_node(CheckedIndex index, SyntaxNodeId node, int reason, int depth) throws Error {
	if (node.index == 0 || index.failed() || index.uses[node.index].deferred != 0) return;
	var ignored = index.defer(node, reason);
	checked_deferred_children(index, node, reason, depth + 1);
}
