// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// IDs are nonowning ordinals. Public reads require the originating table too.
// Native Class identity checks that owner; no address or process-global counter.
struct TypeId {
	int index;
}

struct SignatureId {
	int index;
}

struct TypeEdge {
	TypeId type;
	int flags;
}

struct TypeDescriptor {
	int kind;
	SymbolId nominal;
	int extent;
	int first;
	int count;
	int depth;
}

struct CheckedTypeUse {
	SyntaxNodeId node;
	SyntaxSpan span;
	TypeId type;
	int flags;
	int deferred;
}

struct CheckedSignature {
	SymbolId declaration;
	TypeId callable;
	TypeId error;
	int flags;
	int dispatch;
}

TypeId no_type() {
	TypeId result = {
		index = 0
	};
	return result;
}

TypeId type_id(int index) {
	TypeId result = {
		index = index
	};
	return result;
}

SymbolId type_symbol(int index) {
	SymbolId result = {
		index = index
	};
	return result;
}

// Kind 1..16: fixed canonical builtins. 20..28: structural constructors.
// 30..33: exact nominal declarations/type parameters; 34: closed application.
// 35: existing CheckedClosure; 36: copyable concrete integer range.
class TypeOwner {
	init() {
	}
}

bool type_owner_refs(borrowed TypeOwner first, borrowed TypeOwner second) {
	return first == second;
}

bool type_owner_same(borrowed shared TypeOwner first, borrowed shared TypeOwner second) {
	return type_owner_refs(shared_borrow(first), shared_borrow(second));
}

class TypeTable {
	owned shared TypeOwner identity;
	private owned TypeDescriptor[] rows;
	private owned TypeEdge[] edges;
	int count;
	private int edge_count;
	int limit;
	bool exhausted;

	init(int limit) {
		var identity = new TypeOwner();
		var shared = shared_acquire(move identity);
		this.identity = move shared;
		this.rows = new TypeDescriptor[16];
		this.edges = new TypeEdge[16];
		this.count = 16;
		this.edge_count = 0;
		this.limit = limit;
		this.exhausted = false;
		int i = 1;
		while (i <= 16) {
			TypeDescriptor row = {
				kind = i, nominal = type_symbol(0), extent = 0, first = 0, count = 0, depth = 0
			};
			this.rows[i - 1] = row;
			i = i + 1;
		}
	}

	bool same_owner(borrowed TypeTable origin) {
		return type_owner_same(origin.identity, this.identity);
	}

	bool valid_id(TypeId id) {
		return id.index > 0 && id.index <= this.count;
	}

	TypeDescriptor row(TypeId id) {
		assert_that(this.valid_id(id));
		return this.rows[id.index - 1];
	}

	bool owns(borrowed TypeTable origin, TypeId id) {
		return this.same_owner(origin) && this.valid_id(id);
	}

	TypeDescriptor descriptor(borrowed TypeTable origin, TypeId id) {
		assert_that(this.owns(origin, id));
		return this.rows[id.index - 1];
	}

	TypeEdge argument(borrowed TypeTable origin, TypeId id, int ordinal) {
		var row = this.descriptor(origin, id);
		assert_that(ordinal >= 0 && ordinal < row.count);
		return this.edges[row.first + ordinal];
	}

	bool integer_range_type(TypeId type) {
		if (!this.valid_id(type) || this.count > len(this.rows)) return false;
		var row = this.row(type);
		if (row.kind != 36 || row.nominal.index != 0 || row.extent != 0 || row.count != 1 || row.depth != 1 || row.first < 0 || row.first >= this.edge_count || row.first >= len(this.edges)) return false;
		var element = this.edges[row.first];
		return element.flags == 0 && this.valid_id(element.type) && element.type.index < type.index && type_integer(this.row(element.type).kind);
	}

	bool integer_stride_type(TypeId type) {
		if (!this.valid_id(type) || this.count > len(this.rows)) return false;
		var row = this.row(type);
		if (row.kind != 37 || row.nominal.index != 0 || row.extent != 0 || row.count != 1 || row.depth != 1 || row.first < 0 || row.first >= this.edge_count || row.first >= len(this.edges)) return false;
		var element = this.edges[row.first];
		return element.flags == 0 && this.valid_id(element.type) && element.type.index < type.index && type_integer(this.row(element.type).kind);
	}

	bool inline_callable_edge(TypeEdge edge, int position) {
		if (!this.valid_id(edge.type)) return false;
		int kind = this.row(edge.type).kind;
		if (edge.flags == 0 && (type_numeric(kind) || kind == 13)) return true;
		if (position < 2 || edge.flags != 2 || kind != 21 && kind != 22) return false;
		var shape = this.row(edge.type);
		if (shape.nominal.index != 0 || shape.count != 1 || kind == 21 && shape.extent < 1 || kind == 22 && shape.extent != 0 || shape.first < 0 || shape.first >= this.edge_count) return false;
		var element = this.edges[shape.first];
		return element.flags == 0 && this.valid_id(element.type) && (type_numeric(this.row(element.type).kind) || this.row(element.type).kind == 13);
	}

	bool inline_callable_type(TypeId type) {
		if (!this.valid_id(type) || this.count > len(this.rows)) return false;
		var row = this.row(type);
		if (row.kind != 38 || row.nominal.index < 1 || row.extent < 0 || row.extent > 1 || row.count < 2 || row.count > 10 || row.first < 0 || row.first > this.edge_count - row.count) return false;
		int at = 0;
		while (at < row.count) {
			var edge = this.edges[row.first + at]; if (edge.type.index >= type.index || !this.inline_callable_edge(edge, at)) return false;
			at = at + 1;
		}
		return true;
	}

	int inline_callable_flags(TypeId type) {
		if (!this.inline_callable_type(type)) return -1;
		var row = this.row(type); int at = 2; int flags = 0;
		while (at < row.count) {
			flags = flags | this.edges[row.first + at].flags;
			at = at + 1;
		}
		return flags;
	}

	int lazy_flags(TypeId type) {
		if (!this.valid_id(type)) return -1;
		var row = this.row(type);
		if (row.kind == 36 || row.kind == 37) return 0;
		if (row.kind == 40) return 2;
		if (row.kind != 39 || row.count != 2 || row.first < 0 || row.first > this.edge_count - 2) return -1;
		return this.edges[row.first].flags | this.edges[row.first + 1].flags;
	}

	TypeId lazy_element(TypeId type, int depth) {
		if (depth > 8 || !this.valid_id(type) || this.count > len(this.rows)) return no_type();
		var row = this.row(type);
		if (this.integer_range_type(type) || this.integer_stride_type(type)) return this.edges[row.first].type;
		if (row.kind == 40) {
			if (row.nominal.index < 1 || row.extent != 0 || row.count != 1 || row.first < 0 || row.first >= this.edge_count) return no_type();
			var edge = this.edges[row.first]; if (!this.valid_id(edge.type) || edge.type.index >= type.index || edge.flags != 0 || !type_numeric(this.row(edge.type).kind) && this.row(edge.type).kind != 13) return no_type();
			return edge.type;
		}
		if (row.kind != 39 || row.nominal.index != 0 || row.extent < 1 || row.extent > 2 || row.count != 2 || row.first < 0 || row.first > this.edge_count - 2) return no_type();
		var source = this.edges[row.first]; var callback = this.edges[row.first + 1];
		if (source.type.index >= type.index || callback.type.index >= type.index || source.flags != this.lazy_flags(source.type) || callback.flags != this.inline_callable_flags(callback.type) || source.flags != 0 && source.flags != 2 || callback.flags != 0 && callback.flags != 2) return no_type();
		var callable = this.row(callback.type);
		var input = this.lazy_element(source.type, depth + 1); if (input.index == 0 || this.edges[callable.first].type.index != input.index) return no_type();
		var result = this.edges[callable.first + 1].type;
		if (row.extent == 2) {
			if (this.row(result).kind != 13) return no_type();
			return input;
		}
		return result;
	}

	bool format_plan_edge(TypeEdge edge) {
		if (!this.valid_id(edge.type)) return false; int kind = this.row(edge.type).kind;
		if (type_numeric(kind) || kind == 13) return edge.flags == 0;
		return (kind == 15 || kind == 31) && edge.flags == 2;
	}

	bool format_plan_type(TypeId type) {
		if (!this.valid_id(type)) return false; var row = this.row(type);
		if (row.kind != 41 || row.nominal.index != 0 || row.extent != 0 || row.count < 0 || row.count > 64 || row.first < 0 || row.first > this.edge_count - row.count) return false;
		int at = 0; while (at < row.count) {
			var edge = this.edges[row.first + at]; if (edge.type.index >= type.index || !this.format_plan_edge(edge)) return false; at = at + 1;
		} return true;
	}

	TypeId intern(int kind, SymbolId nominal, int extent, TypeEdge[] args) {
		if (kind == 41) {
			if (nominal.index != 0 || extent != 0 || len(args) > 64) return no_type(); int at = 0;
			while (at < len(args)) {
				if (!this.format_plan_edge(args[at])) return no_type();
				at = at + 1;
			}
		}
		if (kind == 39) {
			if (nominal.index != 0 || extent < 1 || extent > 2 || len(args) != 2 || !this.inline_callable_type(args[1].type)) return no_type();
			var input = this.lazy_element(args[0].type, 1);
			var callable = this.row(args[1].type); var parameter = this.edges[callable.first]; var result = this.edges[callable.first + 1];
			if (input.index == 0 || args[0].flags != this.lazy_flags(args[0].type) || args[1].flags != this.inline_callable_flags(args[1].type) || parameter.type.index != input.index || extent == 2 && this.row(result.type).kind != 13) return no_type();
		}
		if (kind == 40 && (nominal.index < 1 || extent != 0 || len(args) != 1 || !this.valid_id(args[0].type) || args[0].flags != 0 || !type_numeric(this.row(args[0].type).kind) && this.row(args[0].type).kind != 13)) return no_type();
		if (kind == 38) {
			if (nominal.index < 1 || extent < 0 || extent > 1 || len(args) < 2 || len(args) > 10) return no_type();
			int at = 0;
			while (at < len(args)) {
				if (!this.inline_callable_edge(args[at], at)) return no_type();
				at = at + 1;
			}
		}
		if ((kind == 36 || kind == 37) && (nominal.index != 0 || extent != 0 || len(args) != 1)) return no_type();
		if ((kind == 36 || kind == 37) && (!this.valid_id(args[0].type) || args[0].flags != 0 || !type_integer(this.row(args[0].type).kind))) return no_type();
		if (kind <= 16 && (kind < 1 || nominal.index != 0 || extent != 0 || len(args) != 0)) {
			return no_type();
		}
		if ((kind >= 30 && kind <= 34) && nominal.index <= 0) {
			return no_type();
		}
		if ((kind >= 30 && kind <= 33) && len(args) != 0) {
			return no_type();
		}
		if ((kind >= 20 && kind <= 24) && (len(args) != 1 || nominal.index != 0)) {
			return no_type();
		}
		if ((kind == 25 || kind == 26) && (len(args) < 1 || nominal.index != 0)) {
			return no_type();
		}
		int depth = 0;
		int i = 0;
		while (i < len(args)) {
			if (!this.valid_id(args[i].type)) {
				return no_type();
			}
			var row = this.row(args[i].type);
			if (row.depth + 1 > depth) {
				depth = row.depth + 1;
			}
			i = i + 1;
		}
		if (depth > 128) {
			this.exhausted = true;
			return no_type();
		}
		i = 0;
		while (i < this.count) {
			var row = this.rows[i];
			bool same = row.kind == kind && row.nominal.index == nominal.index && row.extent == extent && row.count == len(args);
			int a = 0;
			while (same && a < len(args)) {
				var old = this.edges[row.first + a];
				same = old.type.index == args[a].type.index && old.flags == args[a].flags;
				a = a + 1;
			}
			if (same) {
				return type_id(i + 1);
			}
			i = i + 1;
		}
		if (this.count >= this.limit || len(args) > 257 || this.edge_count > 4194304 - len(args)) {
			this.exhausted = true;
			return no_type();
		}
		if (this.count == len(this.rows)) {
			var grown = new TypeDescriptor[syntax_grown_capacity(len(this.rows), this.count + 1)];
			i = 0;
			while (i < this.count) {
				grown[i] = this.rows[i];
				i = i + 1;
			}
			swap(this.rows, grown);
		}
		if (len(this.edges) < this.edge_count + len(args)) {
			var grown = new TypeEdge[syntax_grown_capacity(len(this.edges), this.edge_count + len(args))];
			i = 0;
			while (i < this.edge_count) {
				grown[i] = this.edges[i];
				i = i + 1;
			}
			swap(this.edges, grown);
		}
		TypeDescriptor row = {
			kind = kind, nominal = nominal, extent = extent, first = this.edge_count, count = len(args), depth = depth
		};
		this.rows[this.count] = row;
		this.count = this.count + 1;
		i = 0;
		while (i < len(args)) {
			this.edges[this.edge_count] = args[i];
			this.edge_count = this.edge_count + 1;
			i = i + 1;
		}
		return type_id(this.count);
	}

	TypeId unary(int kind, TypeId element, int extent) {
		var args = new TypeEdge[1];
		TypeEdge edge = {
			type = element, flags = 0
		};
		args[0] = edge;
		return this.intern(kind, type_symbol(0), extent, args);
	}

	bool valid() {
		int i = 1;
		while (i <= this.count) {
			var row = this.row(type_id(i));
			if (row.kind == 41 && !this.format_plan_type(type_id(i))) return false;
			if (row.kind == 38 && !this.inline_callable_type(type_id(i))) return false;
			if ((row.kind == 39 || row.kind == 40) && this.lazy_element(type_id(i), 0).index == 0) return false;
			if (row.kind <= 0 || row.depth > 128 || row.first < 0 || row.count < 0 || row.first > this.edge_count - row.count) {
				return false;
			}
			if ((row.kind == 36 || row.kind == 37) && (row.nominal.index != 0 || row.extent != 0 || row.count != 1 || row.depth != 1)) return false;
			int a = 0;
			while (a < row.count) {
				var edge = this.edges[row.first + a];
				if (edge.type.index <= 0 || edge.type.index >= i) {
					return false;
				}
				if ((row.kind == 36 || row.kind == 37) && (edge.flags != 0 || !type_integer(this.row(edge.type).kind))) return false;
				a = a + 1;
			}
			i = i + 1;
		}
		return !this.exhausted;
	}
}

int type_builtin(string name) {
	if (name == "int" || name == "i32") {
		return 1;
	}
	if (name == "i8") {
		return 2;
	}
	if (name == "u8") {
		return 3;
	}
	if (name == "i16") {
		return 4;
	}
	if (name == "u16") {
		return 5;
	}
	if (name == "u32") {
		return 6;
	}
	if (name == "i64") {
		return 7;
	}
	if (name == "u64") {
		return 8;
	}
	if (name == "isize") {
		return 9;
	}
	if (name == "usize") {
		return 10;
	}
	if (name == "f32") {
		return 11;
	}
	if (name == "f64") {
		return 12;
	}
	if (name == "bool") {
		return 13;
	}
	if (name == "void") {
		return 14;
	}
	if (name == "string") {
		return 15;
	}
	return 0;
}

string type_builtin_name(int kind) {
	if (kind == 1) {
		return "int";
	}
	if (kind == 2) {
		return "i8";
	}
	if (kind == 3) {
		return "u8";
	}
	if (kind == 4) {
		return "i16";
	}
	if (kind == 5) {
		return "u16";
	}
	if (kind == 6) {
		return "u32";
	}
	if (kind == 7) {
		return "i64";
	}
	if (kind == 8) {
		return "u64";
	}
	if (kind == 9) {
		return "isize";
	}
	if (kind == 10) {
		return "usize";
	}
	if (kind == 11) {
		return "f32";
	}
	if (kind == 12) {
		return "f64";
	}
	if (kind == 13) {
		return "bool";
	}
	if (kind == 14) {
		return "void";
	}
	if (kind == 15) {
		return "string";
	}
	return "void*";
}

bool type_integer(int kind) {
	return kind >= 1 && kind <= 10;
}

bool type_numeric(int kind) {
	return kind >= 1 && kind <= 12;
}

bool type_signed(int kind) {
	return kind == 1 || kind == 2 || kind == 4 || kind == 7 || kind == 9;
}

int type_width(int kind) {
	if (kind == 2 || kind == 3) {
		return 8;
	}
	if (kind == 4 || kind == 5) {
		return 16;
	}
	if (kind == 7 || kind == 8 || kind == 9 || kind == 10 || kind == 12) {
		return 64;
	}
	return 32;
}
