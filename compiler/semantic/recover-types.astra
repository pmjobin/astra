// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Additional conditional Typecore facts for the private effect domain. The
// original CheckedIndex, its pending 17/19 obligations and type table are not
// mutated. Every nominal and declared property type comes from that owner.
class RecoverTypes {
	owned shared TypeOwner identity;
	owned TypeId[] types;
	owned SymbolId[] members;
	owned SymbolId[] borrows;
	owned SyntaxNodeId[] numeric_prefixes;
	int status;
	int remaining;
	SyntaxNodeId boundary;

	init(CheckedIndex checked) {
		var identity = shared_clone(checked.types.identity); this.identity = move identity;
		int count = len(checked.uses); this.types = new TypeId[count]; this.members = new SymbolId[count]; this.borrows = new SymbolId[count]; this.numeric_prefixes = new SyntaxNodeId[count]; this.status = 0; this.remaining = 8000000;
		SyntaxNodeId absent = {index = 0}; this.boundary = absent;
	}

	bool take(SyntaxNodeId node) { if (this.remaining == 0) {
			this.status = 2;
			this.boundary = node;
			return false;
		} this.remaining = this.remaining - 1; return true; }
}

SymbolId recover_type_receiver(CheckedIndex checked, SyntaxNodeId node) {
	if (node.index < 1 || node.index >= len(checked.uses) || checked.bindings.program.arena.kind(node) != SyntaxKind.FieldAccessExpressionSyntax()) return type_symbol(0);
	var receiver = checked.bindings.program.arena.get_node_aggregate(node);
	if (receiver.index == 0) return checked_target(checked, node, checked.bindings.program.arena.get_token_identifier(node));
	if (checked.bindings.program.arena.kind(receiver) != SyntaxKind.NameExpressionSyntax()) return type_symbol(0);
	return checked_target(checked, receiver, checked.bindings.program.arena.get_token_identifier(receiver));
}

SymbolId recover_type_message(CheckedIndex checked, SyntaxNodeId node) {
	if (checked.bindings.program.arena.kind(node) != SyntaxKind.FieldAccessExpressionSyntax() || !checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_field_name(node), "message")) return type_symbol(0);
	var receiver = recover_type_receiver(checked, node);
	if (receiver.index < 1 || receiver.index > checked.bindings.symbol_count) return type_symbol(0);
	var binding = checked.bindings.symbol(receiver);
	if (binding.kind != 15 || checked.symbol_flags[receiver.index] != 2 || checked.bindings.program.arena.kind(binding.node) != SyntaxKind.CatchClauseSyntax()) return type_symbol(0);
	var bound = checked.bindings.program.arena.get_node_class_name(binding.node);
	if (!checked_effect_bound(checked, bound, checked.symbol_types[receiver.index])) return type_symbol(0);
	var root = checked_effect_root(checked); var result = type_symbol(0); int s = 1;
	while (s <= checked.bindings.symbol_count) {
		var declaration = checked.bindings.symbol(type_symbol(s));
		if (declaration.kind == 14 && declaration.owner.index == root.index && generic_token_equal(checked, declaration.token, checked.bindings.program.arena.get_token_field_name(node))) {
			if (result.index != 0) return type_symbol(0);
			var property = checked.bindings.program.arena.property_declaration(declaration.node);
			if (property.f_dispatch != 1 || property.f_owned_keyword.index != 0 || property.f_factory_syntax.index != 0 || property.f_is_borrowed || property.f_lazy_keyword.index != 0 || property.f_throws_class.index != 0 || property.f_getter.index == 0 || property.f_setter.index != 0 || checked.uses[property.f_type_name.index].type.index != 15) return type_symbol(0);
			result = type_symbol(s);
		}
		s = s + 1;
	}
	return result;
}

TypeId recover_type_compute(RecoverTypes data, CheckedIndex checked, SyntaxNodeId node, int depth) {
	if (node.index == 0 || depth > 192 || !data.take(node)) return no_type();
	if (data.types[node.index].index != 0) return data.types[node.index];
	var kind = checked.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.TextLiteralExpressionSyntax() && recover_error_base_literal(checked, node)) {
		var type = type_id(15); data.types[node.index] = type; return type;
	}
	if (kind == SyntaxKind.ParenthesizedExpressionSyntax()) {
		var type = recover_type_compute(data, checked, checked.bindings.program.arena.get_node_expression(node), depth + 1);
		data.types[node.index] = type;
		return type;
	}
	// A caught Error.message has a separately proved text view. Typecore leaves
	// a surrounding call pending when that argument is initially untyped. Admit
	// only synchronous free calls with copied results and nonconsuming inputs;
	// retain the original CheckedIndex and its deferred use byte-for-byte.
	if (kind == SyntaxKind.CallExpressionSyntax() && checked.uses[node.index].deferred == 15) {
		var target = checked_target(checked, node, checked.bindings.program.arena.get_token_identifier(node));
		if (target.index < 1 || target.index > checked.bindings.symbol_count) return no_type();
		var declaration = checked.bindings.symbol(target);
		int ordinal = checked.symbol_signatures[target.index].index;
		if (declaration.kind != 1 || declaration.owner.index != 0 || ordinal < 1 || ordinal > checked.signature_count || checked.bindings.program.arena.get_node_receiver_place(node).index != 0 || checked.bindings.program.arena.get_token_receiver(node).index != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_arguments(node)) != 0) return no_type();
		var signature = checked.signatures[ordinal - 1];
		var result = checked.types.argument(checked.types, signature.callable, 0);
		int code = checked_kind(checked, result.type);
		if (signature.flags != 0 || result.flags != 0 || code != 13 && code != 14 && !type_numeric(code) || !checked_effect_signature_verified(checked, signature)) return no_type();
		var arguments = checked_call_arguments(checked, node);
		int count = checked.bindings.program.arena.list_count(arguments);
		if (checked.types.row(signature.callable).count != count + 1) return no_type();
		bool recovered = false;
		int i = 0;
		while (i < count) {
			var argument = checked.bindings.program.arena.node_at(arguments, i);
			var channel = checked.types.argument(checked.types, signature.callable, i + 1);
			var type = recover_type_compute(data, checked, argument, depth + 1);
			if (type.index != channel.type.index || channel.flags != 0 || checked.uses[argument.index].flags != 0) return no_type();
			if (checked.uses[argument.index].type.index == 0) {
				if (data.members[argument.index].index == 0 || data.borrows[argument.index].index == 0 || type.index != 15) return no_type();
				recovered = true;
			}
			i = i + 1;
		}
		if (!recovered) return no_type();
		data.types[node.index] = result.type;
		return result.type;
	}
	if (kind == SyntaxKind.ShortCircuitExpressionSyntax()) {
		var token = checked.bindings.program.arena.get_token_operator_token(node);
		if (!checked.bindings.program.arena.token_is(token, "&&") && !checked.bindings.program.arena.token_is(token, "||")) return no_type();
		var left = recover_type_compute(data, checked, checked.bindings.program.arena.get_node_left(node), depth + 1);
		var right = recover_type_compute(data, checked, checked.bindings.program.arena.get_node_right(node), depth + 1);
		if (left.index != 13 || right.index != 13) return no_type();
		var result = type_id(13); data.types[node.index] = result; return result;
	}
	if (kind != SyntaxKind.BinaryExpressionSyntax()) return no_type();
	var left = recover_type_compute(data, checked, checked.bindings.program.arena.get_node_left(node), depth + 1); var right = recover_type_compute(data, checked, checked.bindings.program.arena.get_node_right(node), depth + 1);
	if (left.index == 0 || right.index == 0 || left.index != right.index) return no_type();
	var token = checked.bindings.program.arena.get_token_operator_token(node);
	bool equality = checked.bindings.program.arena.token_is(token, "==") || checked.bindings.program.arena.token_is(token, "!=");
	if (!equality || (!type_numeric(checked_kind(checked, left)) && left.index != 13 && left.index != 15 && !recover_storage_class(checked, left) && !recover_storage_error(checked, left) && !recover_storage_shared(checked, left) && !recover_storage_pointer(checked, left))) return no_type();
	var result = type_id(13); data.types[node.index] = result; return result;
}

void recover_types_build(RecoverTypes data, CheckedIndex checked) {
	int n = 1;
	while (n < len(checked.uses) && data.status == 0) {
		SyntaxNodeId node = {index = n}; data.types[n] = checked.uses[n].type;
		if (checked.uses[n].type.index == 0 && checked.uses[n].deferred == 12) {
			var member = recover_type_message(checked, node);
			if (member.index > 0) {
				var declaration = checked.bindings.symbol(member);
				var source_type = checked.bindings.program.arena.get_node_type_name(declaration.node);
				data.types[n] = checked.uses[source_type.index].type;
				data.members[n] = member;
				data.borrows[n] = recover_type_receiver(checked, node);
			}
		}
		n = n + 1;
	}
	recover_prefix_types_build(data, checked);
	n = 1;
	while (n < len(checked.uses) && data.status == 0) {
		SyntaxNodeId node = {index = n};
		var type = recover_type_compute(data, checked, node, 0);
		n = n + 1;
	}
}

TypeId recover_type(RecoverTypes data, SyntaxNodeId node) { if (node.index < 1 || node.index >= len(data.types)) return no_type(); return data.types[node.index]; }
