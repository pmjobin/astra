// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Source typing for existing payload-free enum values. Physical sum transport
// and control/owner admission are separate obligations.
TypeId checked_enum_qualifier(CheckedIndex index, SyntaxNodeId node, SyntaxTokenId token) throws Error {
	if (token.index == 0) return no_type();
	var scope = index.bindings.scope_for_node(node);
	var name = index.bindings.program.arena.token_message(token);
	var selected = index.bindings.resolve(scope, node, token, name.text, 1);
	if (selected.state_code != 1 || selected.target.index < 1 || selected.target.index > index.generic_symbols) return no_type();
	var declaration = index.bindings.symbol(selected.target);
	var type = index.symbol_types[selected.target.index];
	if (declaration.kind != 5 || !enum_value_type_verified(index, type)) return no_type();
	return type;
}

SymbolId checked_enum_variant(CheckedIndex index, TypeId type, SyntaxTokenId token) {
	var declaration = index.bindings.symbol(index.types.row(type).nominal);
	var variants = index.bindings.program.arena.get_list_variants(declaration.node);
	int at = 0;
	while (at < index.bindings.program.arena.list_count(variants)) {
		var node = index.bindings.program.arena.node_at(variants, at);
		var symbol = index.node_symbols[node.index];
		if (symbol.index > 0 && generic_token_equal(index, token, index.bindings.symbol(symbol).token)) return symbol;
		at = at + 1;
	}
	return type_symbol(0);
}

TypeId checked_enum_call(CheckedIndex index, SyntaxNodeId node, int depth) throws Error {
	if (!index.field_effects || index.bindings.program.arena.get_node_receiver_place(node).index != 0) return no_type();
	var type = checked_enum_qualifier(index, node, index.bindings.program.arena.get_token_receiver(node));
	if (type.index == 0) return type;
	var token = index.bindings.program.arena.get_token_identifier(node);
	var variant = checked_enum_variant(index, type, token);
	if (variant.index == 0) {
		index.fail(index.bindings.program.arena.token_span(token), "unknown variant in enum construction");
		return no_type();
	}
	var variant_declaration = index.bindings.symbol(variant);
	var fields = index.bindings.program.arena.get_list_fields(variant_declaration.node);
	var arguments = index.bindings.program.arena.get_list_arguments(node);
	if (index.bindings.program.arena.get_bool_signal_emission(node) || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_arguments(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_qualifier_arguments(node)) != 0 || index.bindings.program.arena.list_count(arguments) != index.bindings.program.arena.list_count(fields) || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_argument_names(node)) != 0) {
		index.fail(index.bindings.program.arena.header(node).span, "enum construction requires exact declared payload fields and no type arguments");
		return no_type();
	}
	int at = 0;
	while (at < index.bindings.program.arena.list_count(fields) && !index.failed()) {
		var field = index.bindings.program.arena.node_at(fields, at);
		var expected = index.symbol_types[index.node_symbols[field.index].index];
		var input = index.bindings.program.arena.node_at(arguments, at);
		var actual = checked_expression(index, input, expected, depth + 1);
		checked_mismatch(index, index.bindings.program.arena.header(input).span, expected, actual, "enum payload");
		if (index.uses[input.index].flags != 0) {
			index.fail(index.bindings.program.arena.header(input).span, "copyable enum payload cannot consume an owner");
			return no_type();
		}
		at = at + 1;
	}
	checked_complete_member(index, node, token, variant);
	var use = index.uses[node.index];
	use.flags = 0; use.deferred = 0; index.uses[node.index] = use;
	return type;
}

bool checked_enum_match(CheckedIndex index, SyntaxNodeId node, TypeId result, int depth) throws Error {
	var scrutinee = index.bindings.program.arena.get_node_scrutinee(node);
	var type = checked_expression(index, scrutinee, no_type(), depth + 1);
	if (type.index == 0) return false;
	int kind = checked_kind(index, type);
	if (kind != 32 && kind != 34) {
		index.fail(index.bindings.program.arena.header(scrutinee).span, "match requires an enum scrutinee");
		return true;
	}
	if (kind != 32 || !checked_payload_free_enum(index, type)) return false;
	var declaration = index.bindings.symbol(index.types.row(type).nominal);
	var variants = index.bindings.program.arena.get_list_variants(declaration.node);
	int count = index.bindings.program.arena.list_count(variants);
	var seen = new bool[count];
	var arms = index.bindings.program.arena.get_list_arms(node);
	int matched = 0; int at = 0; bool fallback = false;
	while (at < index.bindings.program.arena.list_count(arms) && !index.failed()) {
		var arm = index.bindings.program.arena.node_at(arms, at);
		var qualifier = index.bindings.program.arena.get_token_qualifier(arm);
		var token = index.bindings.program.arena.get_token_variant(arm);
		if (fallback) {
			index.fail(index.bindings.program.arena.header(arm).span, "match else arm must be last");
			return true;
		}
		if (qualifier.index == 0 && token.index == 0) {
			if (matched == count) {
				index.fail(index.bindings.program.arena.header(arm).span, "unreachable match else arm");
				return true;
			}
			fallback = true;
		} else {
			var actual = checked_enum_qualifier(index, arm, qualifier);
			var variant = checked_enum_variant(index, type, token);
			if (actual.index != type.index || variant.index == 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_arguments(arm)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_bindings(arm)) != 0) {
				index.fail(index.bindings.program.arena.header(arm).span, "case requires an exact payload-free enum variant");
				return true;
			}
			int ordinal = 0;
			while (ordinal < count && index.node_symbols[index.bindings.program.arena.node_at(variants, ordinal).index].index != variant.index) ordinal = ordinal + 1;
			if (ordinal == count || seen[ordinal]) {
				index.fail(index.bindings.program.arena.header(arm).span, "duplicate enum case");
				return true;
			}
			seen[ordinal] = true; matched = matched + 1;
			checked_complete_member(index, arm, token, variant);
		}
		var recorded = index.record(arm, type, 0);
		checked_statement(index, index.bindings.program.arena.get_node_body(arm), result, depth + 1);
		at = at + 1;
	}
	if (!fallback && matched != count) index.fail(index.bindings.program.arena.header(node).span, "nonexhaustive enum match");
	var recorded = index.record(node, type_id(14), 0);
	return true;
}

bool checked_enum_pattern(CheckedIndex index, SyntaxNodeId pattern, TypeId type, SyntaxNodeId match_node, int depth) throws Error {
	if (depth > 32 || !enum_value_type_verified(index, type)) return false;
	index.pattern_matches[pattern.index] = match_node;
	var data = index.bindings.program.arena.enum_arm(pattern);
	var actual = checked_enum_qualifier(index, pattern, data.f_qualifier);
	var variant = checked_enum_variant(index, type, data.f_variant);
	if (actual.index != type.index || variant.index == 0 || index.bindings.program.arena.list_count(data.f_type_arguments) != 0) {
		index.fail(index.bindings.program.arena.header(pattern).span, "pattern requires an exact concrete enum constructor");
		return false;
	}
	var variant_declaration = index.bindings.symbol(variant);
	var fields = index.bindings.program.arena.get_list_fields(variant_declaration.node);
	int count = index.bindings.program.arena.list_count(fields);
	if (index.bindings.program.arena.list_count(data.f_bindings) != count) {
		index.fail(index.bindings.program.arena.header(pattern).span, "pattern must bind or explicitly discard every declared payload field");
		return false;
	}
	checked_complete_member(index, pattern, data.f_variant, variant);
	var recorded = index.record(pattern, type, 0);
	var seen = new bool[count]; int at = 0;
	while (at < count && !index.failed()) {
		int slot = enum_binding_slot(index, pattern, variant, at);
		if (slot < 0 || slot >= count || seen[slot]) {
			index.fail(index.bindings.program.arena.header(pattern).span, "duplicate or unknown pattern payload field");
			return false;
		}
		seen[slot] = true;
		var binding = index.bindings.program.arena.node_at(data.f_bindings, at);
		index.pattern_matches[binding.index] = match_node;
		var field = index.bindings.program.arena.node_at(fields, slot);
		var field_symbol = index.node_symbols[field.index];
		var expected = index.symbol_types[field_symbol.index];
		var field_name = index.bindings.program.arena.get_token_field(binding);
		if (field_name.index != 0) checked_complete_member(index, binding, field_name, field_symbol);
		var binding_use = index.record(binding, expected, 0);
		var nested = index.bindings.program.arena.get_node_nested_pattern(binding);
		if (nested.index != 0) {
			if (!checked_enum_pattern(index, nested, expected, match_node, depth + 1)) {
				if (!index.failed()) index.fail(index.bindings.program.arena.header(binding).span, "nested pattern requires a concrete enum payload");
				return false;
			}
		} else {
			var token = index.bindings.program.arena.get_token_binding(binding);
			if (token.index == 0) return false;
			var symbol = index.node_symbols[binding.index];
			if (!index.bindings.program.arena.token_is(token, "_")) {
				if (symbol.index < 1) return false;
				index.symbol_types[symbol.index] = expected;
				index.symbol_flags[symbol.index] = 0;
			}
		}
		at = at + 1;
	}
	return !index.failed();
}

TypeId checked_enum_match_expression(CheckedIndex index, SyntaxNodeId node, TypeId expected, int depth) throws Error {
	var span = index.bindings.program.arena.header(node).span;
	if (!checked_modern_source(index, node)) {
		index.fail(span, "match expression requires the explicit modern language profile");
		return no_type();
	}
	var scrutinee = index.bindings.program.arena.get_node_scrutinee(node);
	var type = checked_expression(index, scrutinee, no_type(), depth + 1);
	if (type.index == 0) return index.defer(node, 17);
	if (checked_kind(index, type) != 32 || !enum_value_type_verified(index, type)) return index.defer(node, 17);
	int count = enum_case_count(index, type, 0);
	if (count < 1) {
		index.fail(span, "finite nested pattern coverage exceeds 8192 cases or depth 32");
		return no_type();
	}
	var seen = new bool[count];
	int covered = 0;
	var arms = index.bindings.program.arena.get_list_arms(node);
	var result = expected;
	if (result.index == 0) {
		int context_arm = 0;
		while (context_arm < index.bindings.program.arena.list_count(arms) && result.index == 0) {
			var arm = index.bindings.program.arena.node_at(arms, context_arm);
			result = checked_context(index, index.bindings.program.arena.get_node_expression(arm), depth + 1);
			context_arm = context_arm + 1;
		}
	}
	bool owning = true;
	bool producer = false;
	int at = 0;
	while (at < index.bindings.program.arena.list_count(arms) && !index.failed()) {
		var arm = index.bindings.program.arena.node_at(arms, at);
		var data = index.bindings.program.arena.enum_arm(arm);
		if (data.f_body.index != 0 || data.f_expression.index == 0 || data.f_match_arrow.index == 0 || data.f_semicolon.index == 0 || !checked_enum_pattern(index, arm, type, node, 0)) {
			index.fail(index.bindings.program.arena.header(arm).span, "expression case requires an exact enum variant and one result expression");
			return no_type();
		}
		int choice = 0; bool reaches = false;
		while (choice < count) {
			if (enum_pattern_case(index, arm, type, choice, 0)) {
				if (seen[choice]) {
					index.fail(index.bindings.program.arena.header(arm).span, "overlapping or unreachable enum pattern");
					return no_type();
				}
				seen[choice] = true; covered = covered + 1; reaches = true;
			}
			choice = choice + 1;
		}
		if (!reaches) {
			index.fail(index.bindings.program.arena.header(arm).span, "unreachable enum pattern");
			return no_type();
		}
		var value = checked_expression(index, data.f_expression, result, depth + 1);
		if (value.index == 0) return index.defer(node, 17);
		if (result.index == 0) result = value;
		checked_mismatch(index, index.bindings.program.arena.header(data.f_expression).span, result, value, "match arm result");
		var direct = flow_unwrap(index, data.f_expression);
		bool arm_owner = (index.uses[direct.index].flags & 4) != 0;
		bool absent = index.bindings.program.arena.kind(direct) == SyntaxKind.NullPointerExpressionSyntax();
		owning = owning && (arm_owner || absent);
		producer = producer || arm_owner;
		at = at + 1;
	}
	if (index.failed()) return no_type();
	if (covered != count) {
		index.fail(span, "nonexhaustive enum match expression");
		return no_type();
	}
	if (result.index != 14 && result.index != 15 && recover_copy_channel(index, result, 0, false)) return result;
	if (owning && producer && recover_storage_channel(index, result, 4, true)) {
		var use = index.uses[node.index]; use.flags = 4; index.uses[node.index] = use;
		return result;
	}
	index.fail(span, "match join requires exact copyable values or explicit owning arm producers; borrowed results need an outlives proof");
	return no_type();
}
