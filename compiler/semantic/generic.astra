// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Typed specialization is target agnostic. LLVM's independent ABI plan binds
// each concrete body to the actual target and representation policy afterwards.
struct GenericInstance {
	SymbolId origin;
	SymbolId concrete;
	TypeId enclosing;
	int arguments;
	int argument_count;
	int nodes;
	int symbols;
	int scopes;
	int node_first;
	int node_count;
	int symbol_first;
	int symbol_count;
	bool sparse_bindings;
	int scope_first;
	int scope_count;
	int state;
	int first_reference;
	int reference_count;
}

// The parsed input is already owned by the arena. Bound additional syntax,
// independently of the number of original declarations in the compilation.
bool generic_syntax_room(int originals, int total) {
	if (originals < 0 || total < originals || total == 2147483647) return false;
	return total - originals < 262144;
}

bool generic_copy_room(CheckedIndex index, SyntaxNodeId original) throws Error {
	if (generic_syntax_room(index.generic_nodes, index.bindings.program.arena.node_count)) return true;
	index.fail(index.bindings.program.arena.header(original).span, "generic syntax resource limit");
	return false;
}

// Nodes reserve a conservative source-declaration window. Direct source
// binding keys retain actual original IDs, including head/body scope gaps.
// Source spans only bound storage; original integer identities remain map keys.
// The copier refuses any child outside the window, and the independent consumer
// reconstructs every copied edge starting with the exact declaration root.
GenericInstance generic_window(CheckedIndex index, SymbolId origin, TypeId enclosing, int arguments, bool sparse_bindings) {
	GenericInstance plan = {origin = origin, concrete = {index = 0}, enclosing = enclosing, arguments = index.generic_argument_used, argument_count = arguments, nodes = index.generic_node_used, symbols = index.generic_symbol_used, scopes = index.generic_scope_used, node_first = index.generic_nodes + 1, node_count = 0, symbol_first = index.generic_symbols + 1, symbol_count = 0, sparse_bindings = sparse_bindings, scope_first = index.generic_scopes + 1, scope_count = 0, state = 1, first_reference = 0, reference_count = 0};
	var declaration = index.bindings.symbol(origin);
	var span = index.bindings.program.arena.header(declaration.node).span;
	int last = 0; int i = 1;
	while (i <= index.generic_nodes) {
		SyntaxNodeId node = {index = i}; var child = index.bindings.program.arena.header(node).span;
		if (child.source.index == span.source.index && child.start >= span.start && child.end <= span.end) {
			if (i < plan.node_first) plan.node_first = i;
			last = i;
		}
		i = i + 1;
	}
	if (last >= plan.node_first) plan.node_count = last - plan.node_first + 1;
	last = 0; i = 1;
	while (i <= index.generic_symbols) {
		int node = index.bindings.symbol(type_symbol(i)).node.index;
		if (node >= plan.node_first && node - plan.node_first < plan.node_count) {
			if (i < plan.symbol_first) plan.symbol_first = i;
			plan.symbol_count = plan.symbol_count + 1;
			last = i;
		}
		i = i + 1;
	}
	if (!sparse_bindings && last >= plan.symbol_first) plan.symbol_count = last - plan.symbol_first + 1;
	last = 0; i = 1;
	while (i <= index.generic_scopes) {
		ScopeId id = {index = i}; int node = index.bindings.scope(id).node.index;
		if (node >= plan.node_first && node - plan.node_first < plan.node_count) {
			if (i < plan.scope_first) plan.scope_first = i;
			plan.scope_count = plan.scope_count + 1;
			last = i;
		}
		i = i + 1;
	}
	if (!sparse_bindings && last >= plan.scope_first) plan.scope_count = last - plan.scope_first + 1;
	return plan;
}

GenericInstance generic_new_plan(CheckedIndex index, GenericInstance input, TypeEdge[] arguments) {
	var plan = input;
	int size = index.generic_argument_used + len(arguments);
	var args = new TypeEdge[size]; int i = 0;
	while (i < index.generic_argument_used) {
		args[i] = index.generic_arguments[i];
		i = i + 1;
	}
	i = 0;
	while (i < len(arguments)) {
		args[plan.arguments + i] = arguments[i];
		i = i + 1;
	}
	swap(index.generic_arguments, args); index.generic_argument_used = size;
	generic_grow_maps(index, plan);
	return plan;
}

void generic_grow_maps(CheckedIndex index, GenericInstance plan) {
	int size = index.generic_node_used + plan.node_count + 1;
	if (size > len(index.generic_node_map)) {
		int capacity = syntax_grown_capacity(len(index.generic_node_map), size);
		if (capacity > 8000000) capacity = 8000000;
		var nodes = new int[capacity]; int i = 0;
		while (i < index.generic_node_used) {
			nodes[i] = index.generic_node_map[i];
			i = i + 1;
		}
		swap(index.generic_node_map, nodes);
	}
	index.generic_node_used = size;
	size = index.generic_symbol_used + plan.symbol_count + 1;
	if (size > len(index.generic_symbol_map)) {
		int capacity = syntax_grown_capacity(len(index.generic_symbol_map), size);
		if (capacity > 8000000) capacity = 8000000;
		var symbols = new int[capacity]; var keys = new int[capacity]; int i = 0;
		while (i < index.generic_symbol_used) {
			symbols[i] = index.generic_symbol_map[i];
			keys[i] = index.generic_symbol_keys[i];
			i = i + 1;
		}
		swap(index.generic_symbol_map, symbols); swap(index.generic_symbol_keys, keys);
	}
	if (plan.sparse_bindings) {
		int at = plan.symbols + 1; int i = 1;
		while (i <= index.generic_symbols) {
			int node = index.bindings.symbol(type_symbol(i)).node.index;
			if (node >= plan.node_first && node - plan.node_first < plan.node_count) {
				index.generic_symbol_keys[at] = i;
				at = at + 1;
			}
			i = i + 1;
		}
		assert_that(at == size);
	}
	index.generic_symbol_used = size;
	size = index.generic_scope_used + plan.scope_count + 1;
	if (size > len(index.generic_scope_map)) {
		int capacity = syntax_grown_capacity(len(index.generic_scope_map), size);
		var scopes = new int[capacity]; var keys = new int[capacity]; int i = 0;
		while (i < index.generic_scope_used) {
			scopes[i] = index.generic_scope_map[i];
			keys[i] = index.generic_scope_keys[i];
			i = i + 1;
		}
		swap(index.generic_scope_map, scopes); swap(index.generic_scope_keys, keys);
	}
	if (plan.sparse_bindings) {
		int at = plan.scopes + 1; int i = 1;
		while (i <= index.generic_scopes) {
			ScopeId id = {index = i}; int node = index.bindings.scope(id).node.index;
			if (node >= plan.node_first && node - plan.node_first < plan.node_count) {
				index.generic_scope_keys[at] = i;
				at = at + 1;
			}
			i = i + 1;
		}
		assert_that(at == size);
	}
	index.generic_scope_used = size;
}

void generic_add_plan(CheckedIndex index, GenericInstance plan) {
	if (index.instance_count == len(index.instances)) {
		var grown = new GenericInstance[syntax_grown_capacity(len(index.instances), index.instance_count + 1)]; int i = 0;
		while (i < index.instance_count) {
			grown[i] = index.instances[i];
			i = i + 1;
		}
		swap(index.instances, grown);
	}
	index.instances[index.instance_count] = plan; index.instance_count = index.instance_count + 1;
}

bool generic_template(CheckedIndex index, SymbolId id) {
	if (!index.native_abi || id.index < 1 || id.index > index.generic_symbols) return false;
	var symbol = index.bindings.symbol(id);
	if (class_storage_member_template(index, id)) return true;
	if (symbol.kind != 1 && symbol.kind != 3 && symbol.kind != 4 && symbol.kind != 11 && symbol.kind != 12) return false;
	if (index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_parameters(symbol.node)) != 0) return true;
	return symbol.owner.index > 0 && generic_template(index, symbol.owner);
}

int generic_instance_for(CheckedIndex index, SymbolId concrete) {
	int i = 0;
	while (i < index.instance_count) {
		if (generic_declaration(index.instances[i]).index == concrete.index) return i + 1;
		i = i + 1;
	}
	return 0;
}

TypeId generic_parameter(CheckedIndex index, GenericInstance plan, SymbolId parameter) {
	var symbol = index.bindings.symbol(parameter);
	if (symbol.owner.index != plan.origin.index) return no_type();
	var declaration = index.bindings.symbol(plan.origin);
	var params = index.bindings.program.arena.get_list_type_parameters(declaration.node);
	int i = 0;
	while (i < index.bindings.program.arena.list_count(params)) {
		if (index.bindings.program.arena.token_at(params, i).index == symbol.token.index && i < plan.argument_count) return index.generic_arguments[plan.arguments + i].type;
		i = i + 1;
	}
	return no_type();
}

TypeId generic_substitute(CheckedIndex index, GenericInstance plan, TypeId original, int depth) throws Error {
	if (original.index == 0 || depth > 128) return no_type();
	var row = index.types.row(original);
	if (row.kind == 33) {
		var result = generic_parameter(index, plan, row.nominal);
		if (result.index == 0 && plan.enclosing.index != 0) {
			var outer_type = index.types.row(plan.enclosing); int outer = generic_instance_for(index, outer_type.nominal);
			if (outer > 0) result = generic_parameter(index, index.instances[outer - 1], row.nominal);
		}
		return result;
	}
	if (row.count == 0) return original;
	var args = new TypeEdge[row.count];
	int i = 0;
	while (i < row.count) {
		var edge = index.types.argument(index.types, original, i);
		edge.type = generic_substitute(index, plan, edge.type, depth + 1);
		if (edge.type.index == 0) return no_type();
		args[i] = edge; i = i + 1;
	}
	var result = index.types.intern(row.kind, row.nominal, row.extent, args);
	return generic_concrete_type(index, result, depth + 1);
}

bool generic_closed(CheckedIndex index, TypeId type, int depth) {
	if (!index.types.valid_id(type) || depth > 128) return false;
	var row = index.types.row(type);
	if (row.kind == 33) return false;
	int i = 0;
	while (i < row.count) {
		if (!generic_closed(index, index.types.argument(index.types, type, i).type, depth + 1)) return false;
		i = i + 1;
	}
	return true;
}

void generic_resize(CheckedIndex index) {
	int size = index.bindings.program.arena.node_count + 1;
	if (size > len(index.uses)) {
		var uses = new CheckedTypeUse[size]; var symbols = new SymbolId[size]; var refs = new int[size]; var checking = new bool[size]; var calls = new SymbolId[size]; var lists = new SyntaxListId[size];
		int i = 1;
		while (i < size) {
			if (i < len(index.uses)) {
				uses[i] = index.uses[i]; symbols[i] = index.node_symbols[i]; refs[i] = index.node_references[i]; checking[i] = index.checking[i]; calls[i] = index.generic_calls[i]; lists[i] = index.generic_argument_lists[i];
			} else {
				SyntaxNodeId node = {index = i};
				CheckedTypeUse use = {node = node, span = index.bindings.program.arena.header(node).span, type = no_type(), flags = 0, deferred = 0}; uses[i] = use;
			}
			i = i + 1;
		}
		swap(index.uses, uses); swap(index.node_symbols, symbols); swap(index.node_references, refs); swap(index.checking, checking); swap(index.generic_calls, calls); swap(index.generic_argument_lists, lists);
	}
	size = index.bindings.symbol_count + 1;
	if (size > len(index.symbol_types)) {
		var types = new TypeId[size]; var flags = new int[size]; var signatures = new SignatureId[size]; var methods = new int[size];
		int i = 0;
		while (i < len(index.symbol_types)) {
			types[i] = index.symbol_types[i];
			flags[i] = index.symbol_flags[i];
			signatures[i] = index.symbol_signatures[i];
			methods[i] = index.direct_method_symbols[i];
			i = i + 1;
		}
		swap(index.symbol_types, types); swap(index.symbol_flags, flags); swap(index.symbol_signatures, signatures); swap(index.direct_method_symbols, methods);
	}
	size = index.bindings.reference_count + 1;
	if (size > len(index.reference_next)) {
		var refs = new int[size]; int i = 0;
		while (i < len(index.reference_next)) {
			refs[i] = index.reference_next[i];
			i = i + 1;
		}
		swap(index.reference_next, refs);
	}
}

GenericInstance generic_copy_bindings(CheckedIndex index, GenericInstance input) {
	var plan = input;
	int ordinal = 0;
	while (ordinal < plan.symbol_count) {
		int i = generic_symbol_source(index, plan, ordinal);
		var symbol = index.bindings.symbol(type_symbol(i));
		if (symbol.kind != 9 && generic_node(index, plan, symbol.node.index) != 0) {
			SyntaxNodeId node = {index = generic_node(index, plan, symbol.node.index)};
			index.generic_symbol_map[plan.symbols + ordinal + 1] = index.bindings.append_instance_symbol(symbol, node).index;
		}
		ordinal = ordinal + 1;
	}
	plan.concrete = type_symbol(generic_symbol(index, plan, plan.origin.index));
	ordinal = 0;
	while (ordinal < plan.scope_count) {
		int source = generic_scope_source(index, plan, ordinal);
		ScopeId scope_id = {index = source}; var scope = index.bindings.scope(scope_id);
		if (scope.node.index > 0 && generic_node(index, plan, scope.node.index) != 0) index.generic_scope_map[plan.scopes + ordinal + 1] = index.bindings.append_instance_scope(scope).index;
		ordinal = ordinal + 1;
	}
	ordinal = 0;
	while (ordinal < plan.scope_count) {
		int source = generic_scope_source(index, plan, ordinal);
		int target = index.generic_scope_map[plan.scopes + ordinal + 1];
		if (target != 0) {
			ScopeId old_id = {index = source}; var scope = index.bindings.scope(old_id);
			if (scope.parent.index > 0 && generic_scope(index, plan, scope.parent.index) != 0) scope.parent.index = generic_scope(index, plan, scope.parent.index);
			if (scope.owner.index > 0 && generic_symbol(index, plan, scope.owner.index) != 0) scope.owner.index = generic_symbol(index, plan, scope.owner.index);
			scope.node.index = generic_node(index, plan, scope.node.index);
			index.bindings.replace_instance_scope(target, scope);
		}
		ordinal = ordinal + 1;
	}
	int i = 0;
	ordinal = 0;
	while (ordinal < plan.symbol_count) {
		i = generic_symbol_source(index, plan, ordinal);
		if (generic_symbol(index, plan, i) != 0) {
			var target_symbol = type_symbol(generic_symbol(index, plan, i));
			var symbol = index.bindings.symbol(target_symbol);
			if (symbol.owner.index > 0 && generic_symbol(index, plan, symbol.owner.index) != 0) symbol.owner.index = generic_symbol(index, plan, symbol.owner.index);
			if (symbol.scope.index > 0 && generic_scope(index, plan, symbol.scope.index) != 0) symbol.scope.index = generic_scope(index, plan, symbol.scope.index);
			index.bindings.replace_instance_symbol(target_symbol, symbol);
		}
		ordinal = ordinal + 1;
	}
	generic_resize(index);
	i = 1;
	while (i <= index.generic_nodes) {
		if (generic_node(index, plan, i) != 0) {
			SyntaxNodeId old_node = {index = i}; SyntaxNodeId new_node = {index = generic_node(index, plan, i)};
			var scope = index.bindings.scope_for_node(old_node);
			if (scope.index > 0 && generic_scope(index, plan, scope.index) != 0) scope.index = generic_scope(index, plan, scope.index);
			index.bindings.set_instance_node_scope(new_node, scope);
			if (index.node_symbols[i].index > 0) {
				var mapped_symbol = type_symbol(generic_symbol(index, plan, index.node_symbols[i].index));
				index.node_symbols[new_node.index] = mapped_symbol;
			}
		}
		i = i + 1;
	}
	int first = index.bindings.reference_count;
	plan.first_reference = first + 1;
	i = 1;
	while (i <= index.generic_references) {
		var edge = index.bindings.reference(i);
		if (generic_node(index, plan, edge.node.index) != 0) {
			// Member binding names the source Class declaration. Its executable
			// function (including a recursive self call) is selected separately by
			// generic_calls. Preserve that identity even after early completion.
			bool lexical_method = edge.domain == 4 && index.bindings.program.arena.kind(edge.node) == SyntaxKind.CallExpressionSyntax() && edge.target.index > 0 && index.bindings.symbol(edge.target).kind == 11;
			edge.node.index = generic_node(index, plan, edge.node.index);
			if (edge.scope.index > 0 && generic_scope(index, plan, edge.scope.index) != 0) edge.scope.index = generic_scope(index, plan, edge.scope.index);
			if (!lexical_method && edge.target.index > 0 && generic_symbol(index, plan, edge.target.index) != 0) {
				edge.target.index = generic_symbol(index, plan, edge.target.index);
			} else {
				if (!lexical_method && index.class_storage && plan.enclosing.index != 0 && edge.target.index > 0) {
					int outer = generic_instance_for(index, index.types.row(plan.enclosing).nominal);
					if (outer > 0 && generic_symbol(index, index.instances[outer - 1], edge.target.index) != 0) edge.target.index = generic_symbol(index, index.instances[outer - 1], edge.target.index);
				}
			}
			if (edge.alternative.index > 0 && generic_symbol(index, plan, edge.alternative.index) != 0) edge.alternative.index = generic_symbol(index, plan, edge.alternative.index);
			index.bindings.add_reference(edge);
		}
		i = i + 1;
	}
	generic_resize(index);
	i = first + 1;
	while (i <= index.bindings.reference_count) {
		var edge = index.bindings.reference(i);
		index.reference_next[i] = index.node_references[edge.node.index]; index.node_references[edge.node.index] = i; i = i + 1;
	}
	plan.reference_count = index.bindings.reference_count - first;
	return plan;
}

// Establish only a closed private checked declaration. Executable channels,
// receiver provenance, ownership and error edges remain separate consumers.
bool generic_checked_source(CheckedIndex index, SymbolId origin, TypeId enclosing) {
	if (!index.native_abi || !index.semantic_admission || !index.class_storage) return false;
	var declaration = index.bindings.symbol(origin); var node = declaration.node;
	if (declaration.kind == 1) {
		if (declaration.owner.index != 0 || enclosing.index != 0) return false;
	} else {
		if (declaration.kind != 11 || !class_storage_source_verified(index, enclosing, false, 0)) return false;
		var owner = class_storage_origin(index, enclosing); var source = index.bindings.symbol(owner); var fields = index.bindings.program.arena.get_list_fields(source.node);
		if (!index.field_effects && index.bindings.program.arena.list_count(fields) != 0) return false;
		if (!class_storage_fields_verified(index, enclosing, 0)) return false;
	}
	if (index.bindings.program.arena.kind(node) != SyntaxKind.FunctionDeclarationSyntax() || index.bindings.program.arena.get_node_body(node).index == 0 || index.bindings.program.arena.get_int_dispatch(node) != 0 || index.bindings.program.arena.get_token_extern_keyword(node).index != 0 || index.bindings.program.arena.get_token_export_keyword(node).index != 0 || index.bindings.program.arena.get_token_async_keyword(node).index != 0 || index.bindings.program.arena.get_bool_is_signal(node) || index.bindings.program.arena.get_node_foreign_policy(node).index != 0 || index.bindings.program.arena.get_node_foreign_member(node).index != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_foreign_channels(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_ccode(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_floating_point(node)) != 0) return false;
	var bound = index.bindings.program.arena.get_node_throws_class(node);
	if (bound.index < 1 || bound.index >= len(index.uses) || index.bindings.program.arena.get_bool_utf8_factory(node)) return false;
	return (index.symbol_flags[origin.index] & (8 | 16 | 32 | 64)) == 64 && checked_effect_bound(index, bound, index.uses[bound.index].type);
}

SymbolId generic_instantiate(CheckedIndex index, SymbolId origin, TypeId enclosing, TypeEdge[] arguments, SyntaxSpan span) throws Error {
	if (len(arguments) == 0 && direct_method_source(index, origin, enclosing)) return direct_method_lower(index, origin, enclosing, span);
	int request = 0;
	if (index.generic_trace) {
		index.generic_requests = index.generic_requests + 1; request = index.generic_requests;
		generic_trace_request(index, request, origin, enclosing, arguments, span);
	}
	var declaration = index.bindings.symbol(origin);
	int count = index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_parameters(declaration.node));
	if ((index.symbol_flags[origin.index] & (8 | 16 | 32)) != 0 || (index.symbol_flags[origin.index] & 64) != 0 && !generic_checked_source(index, origin, enclosing)) {
		index.fail(span, "DEFERRED: generic foreign, async, signal or throwing ABI policy");
		return type_symbol(0);
	}
	if (count != len(arguments) || (count == 0 && enclosing.index == 0)) {
		index.fail(span, "generic specialization arity mismatch");
		return type_symbol(0);
	}
	if (declaration.kind == 4 && !generic_class_source(index, origin) && !class_storage_generic_source(index, origin)) {
		index.fail(span, "DEFERRED: generic Class requires the bounded empty receiver policy");
		return type_symbol(0);
	}
	if (declaration.kind == 3) {
		var fields = index.bindings.program.arena.get_list_fields(declaration.node); int f = 0;
		while (f < index.bindings.program.arena.list_count(fields)) {
			if (index.bindings.program.arena.get_token_owned_keyword(index.bindings.program.arena.node_at(fields, f)).index != 0) {
				index.fail(span, "DEFERRED: C0 rejects owning generic record fields");
				return type_symbol(0);
			}
			f = f + 1;
		}
	}
	int i = 0;
	while (i < len(arguments)) {
		if (checked_record_owned(index, arguments[i].type, 0)) {
			index.fail(span, "DEFERRED: generic owning-record type argument capability policy");
			return type_symbol(0);
		}
		if (arguments[i].flags != 0 || !generic_closed(index, arguments[i].type, 0)) {
			index.fail(span, "DEFERRED: generic specialization requires closed unqualified type arguments");
			return type_symbol(0);
		}
		i = i + 1;
	}
	if (!checked_constraints(index, origin, arguments, span)) return type_symbol(0);
	i = 0;
	while (i < index.instance_count) {
		var old_origin = generic_origin(index.instances[i]);
		bool same = old_origin.index == origin.index && generic_enclosing(index.instances[i]).index == enclosing.index && generic_argument_count(index, index.instances[i]) == len(arguments);
		int p = 0;
		while (same && p < len(arguments)) {
			same = generic_argument(index, index.instances[i], p).type.index == arguments[p].type.index && generic_argument(index, index.instances[i], p).flags == arguments[p].flags;
			p = p + 1;
		}
		if (same) {
			if (generic_state(index.instances[i]) != 2) {
				index.fail(span, "DEFERRED: recursive generic instantiation");
				return type_symbol(0);
			}
			if (index.generic_trace) {
				index.generic_hits = index.generic_hits + 1;
				generic_trace_event(index, request, 2, i + 1);
			}
			return generic_declaration(index.instances[i]);
		}
		i = i + 1;
	}
	var window = generic_window(index, origin, enclosing, len(arguments), false);
	if (index.instance_count >= 256 || index.generic_node_used > 8000000 - window.node_count - 1 || index.generic_symbol_used > 8000000 - window.symbol_count - 1) {
		if (index.generic_trace) generic_trace_event(index, request, 5, 0);
		index.fail(span, "generic instance resource limit");
		return type_symbol(0);
	}
	if (index.generic_active[origin.index]) {
		if (index.generic_trace) generic_trace_event(index, request, 6, 0);
		index.fail(span, "DEFERRED: recursive generic instantiation");
		return type_symbol(0);
	}
	index.generic_active[origin.index] = true;
	int parent = index.generic_parent;
	if (index.generic_trace) {
		index.generic_parent = request;
		generic_trace_event(index, request, 3, 0);
	}
	var plan = generic_new_plan(index, window, arguments);
	var clone = generic_copy_node(index, plan, declaration.node, 0);
	if (index.failed() || clone.index == 0) {
		generic_abandon(index, origin, request, parent);
		return type_symbol(0);
	}
	plan = generic_copy_bindings(index, plan);
	var concrete = plan.concrete;

	if (declaration.kind == 3 || declaration.kind == 4) {
		int kind = 30; if (declaration.kind == 4) kind = 31;
		var empty = new TypeEdge[0]; index.symbol_types[concrete.index] = index.types.intern(kind, concrete, 0, empty);
	}
	// Outside this source window generic_node is identically zero. Preserve
	// ascending original identities without rescanning unrelated declarations.
	i = plan.node_first;
	while (i - plan.node_first < plan.node_count && !index.failed()) {
		int mapped = generic_node(index, plan, i);
		if (mapped != 0) {
			SyntaxNodeId node = {index = i};
			var pattern = index.uses[i].type;
			// Class constructors can be requested while heads are being checked,
			// before their generic body has visited a type-name expression. Resolve
			// that declared parameter from its Binder identity, without marking an
			// unvisited original expression as checked.
			if (index.class_storage && pattern.index == 0 && index.bindings.program.arena.kind(node) == SyntaxKind.TypeNameSyntax()) {
				var target = checked_target(index, node, index.bindings.program.arena.get_token_identifier(node));
				if (target.index > 0 && index.bindings.symbol(target).kind == 9) pattern = index.symbol_types[target.index];
			}
			if (syntax_kind_accepts(index.bindings.program.arena.kind(node), SyntaxKind.TypeNameSyntax()) && pattern.index != 0) {
				var type = generic_substitute(index, plan, pattern, 0);
				SyntaxNodeId copy = {index = mapped}; var ignored = index.record(copy, type, index.uses[i].flags);
			}
		}
		i = i + 1;
	}
	int ordinal = 0;
	while (ordinal < plan.symbol_count && !index.failed()) {
		i = generic_symbol_source(index, plan, ordinal);
		int mapped = generic_symbol(index, plan, i);
		if (mapped != 0) {
			var symbol = index.bindings.symbol(type_symbol(mapped));
			// The retained Class constructor is a source template, not a second
			// executable body. Its source parameters still need specialized type
			// identities, independently of the callable's hidden receiver.
			if (symbol.kind == 6 || declaration.kind == 4 && symbol.kind == 7) {
				int context = 1;
				if (index.class_storage && index.bindings.program.arena.get_token_owned_keyword(symbol.node).index != 0) context = 2;
				var ignored = checked_declared(index, symbol, index.bindings.program.arena.get_node_type_name(symbol.node), context);
			}
		}
		ordinal = ordinal + 1;
	}
	if (declaration.kind == 11 || index.class_storage && declaration.kind == 12) {
		var function = index.bindings.symbol(concrete); function.kind = 1; index.bindings.replace_instance_symbol(concrete, function);
		var hidden = generic_hidden_parameter(index, plan);
	}
	if (!index.failed() && (declaration.kind == 1 || declaration.kind == 11 || index.class_storage && declaration.kind == 12)) checked_signature(index, concrete);
	if (index.failed()) {
		generic_abandon(index, origin, request, parent);
		return type_symbol(0);
	}
	plan.state = 2;
	generic_add_plan(index, plan);
	index.generic_active[origin.index] = false;
	if (index.class_storage && declaration.kind == 4) class_storage_members(index, index.symbol_types[concrete.index]);
	if (index.generic_trace) {
		generic_trace_event(index, request, 4, generic_instance_for(index, concrete));
		index.generic_parent = parent;
	}
	return concrete;
}

void generic_abandon(CheckedIndex index, SymbolId origin, int request, int parent) throws Error {
	index.generic_active[origin.index] = false;
	if (index.generic_trace) {
		generic_trace_event(index, request, 7, 0);
		index.generic_parent = parent;
	}
}

// Optional observation only. IDs are scoped to this CheckedIndex, with full
// TypeTable edges and Binder declarations emitted by the diagnostic consumer.
// A bounded prefix avoids source-sized keys or unbounded trace storage.
void generic_trace_request(CheckedIndex index, int request, SymbolId origin, TypeId enclosing, TypeEdge[] arguments, SyntaxSpan span) throws Error {
	if (request > 4096) return;
	var output = new Utf8ByteBuilder(); source_append_text(output, "GENREQUEST "); append_int(output, request);
	source_append_text(output, " "); append_int(output, index.generic_parent);
	source_append_text(output, " "); append_int(output, origin.index);
	source_append_text(output, " "); append_int(output, enclosing.index);
	source_append_text(output, " "); append_int(output, len(arguments));
	int i = 0;
	while (i < len(arguments)) {
		source_append_text(output, " "); append_int(output, arguments[i].type.index);
		source_append_text(output, " "); append_int(output, arguments[i].flags); i = i + 1;
	}
	source_append_text(output, " "); binding_write_span(index.bindings, span, output);
	source_append_text(output, "\n"); var text = output.snapshot(); print(text.text);
}

void generic_trace_event(CheckedIndex index, int request, int state, int ordinal) throws Error {
	if (request > 4096) return;
	var output = new Utf8ByteBuilder(); source_append_text(output, "GENEVENT "); append_int(output, request);
	source_append_text(output, " "); append_int(output, state);
	source_append_text(output, " "); append_int(output, ordinal);
	source_append_text(output, " "); append_int(output, index.instance_count);
	source_append_text(output, " "); append_int(output, index.generic_node_used);
	source_append_text(output, " "); append_int(output, index.generic_symbol_used);
	source_append_text(output, " "); append_int(output, index.generic_scope_used);
	source_append_text(output, "\n"); var text = output.snapshot(); print(text.text);
}

TypeId generic_concrete_type(CheckedIndex index, TypeId type, int depth) throws Error {
	if (!index.native_abi || type.index == 0 || depth > 128) return type;
	var row = index.types.row(type);
	if (row.kind != 34 || !generic_closed(index, type, 0)) return type;
	var declaration = index.bindings.symbol(row.nominal);
	if (declaration.kind != 3 && declaration.kind != 4) return type;
	var args = new TypeEdge[row.count]; int i = 0;
	while (i < row.count) {
		args[i] = index.types.argument(index.types, type, i);
		i = i + 1;
	}
	var concrete = generic_instantiate(index, row.nominal, no_type(), args, index.bindings.program.arena.header(declaration.node).span);
	if (concrete.index == 0) return no_type();
	return index.symbol_types[concrete.index];
}

bool generic_unify(CheckedIndex index, SymbolId origin, TypeId enclosing, TypeId pattern, TypeId actual, TypeEdge[] arguments, int depth) {
	if (pattern.index == 0 || actual.index == 0 || depth > 128) return false;
	var p = index.types.row(pattern); var a = index.types.row(actual);
	if (p.kind == 33) {
		var parameter = index.bindings.symbol(p.nominal);
		if (parameter.owner.index != origin.index) {
			if (enclosing.index == 0) return pattern.index == actual.index;
			int outer = generic_instance_for(index, index.types.row(enclosing).nominal);
			return outer > 0 && generic_parameter(index, index.instances[outer - 1], p.nominal).index == actual.index;
		}
		var declaration = index.bindings.symbol(origin);
		var params = index.bindings.program.arena.get_list_type_parameters(declaration.node); int i = 0;
		while (i < len(arguments)) {
			if (index.bindings.program.arena.token_at(params, i).index == parameter.token.index) {
				if (arguments[i].type.index != 0) return arguments[i].type.index == actual.index;
				TypeEdge edge = {type = actual, flags = 0}; arguments[i] = edge; return true;
			}
			i = i + 1;
		}
		return false;
	}
	if (p.kind != a.kind || p.nominal.index != a.nominal.index || p.extent != a.extent || p.count != a.count) return false;
	int i = 0;
	while (i < p.count) {
		var pe = index.types.argument(index.types, pattern, i); var ae = index.types.argument(index.types, actual, i);
		if (pe.flags != ae.flags || !generic_unify(index, origin, enclosing, pe.type, ae.type, arguments, depth + 1)) return false;
		i = i + 1;
	}
	return true;
}

SymbolId generic_select_call(CheckedIndex index, SyntaxNodeId node, SymbolId target, TypeId enclosing, int depth) throws Error {
	if (index.generic_definition) return type_symbol(0);
	var declaration = index.bindings.symbol(target);
	if (declaration.kind != 1 && declaration.kind != 11) return type_symbol(0);
	var params = index.bindings.program.arena.get_list_type_parameters(declaration.node);
	int count = index.bindings.program.arena.list_count(params);
	var args = new TypeEdge[count];
	var explicit = index.bindings.program.arena.get_list_type_arguments(node);
	int supplied = index.bindings.program.arena.list_count(explicit);
	if (supplied != 0 && supplied != count) {
		index.fail(index.uses[node.index].span, "generic call type argument count mismatch");
		return type_symbol(0);
	}
	int i = 0;
	while (i < supplied) {
		var type = checked_resolve(index, index.bindings.program.arena.node_at(explicit, i), 0, 0);
		TypeEdge edge = {type = type, flags = 0}; args[i] = edge; i = i + 1;
	}
	// A concrete method may need receiver specialization, but has no inference
	// variables. The ordinary call checker checks its full concrete signature.
	if (count == 0 && supplied == 0) {
		if (enclosing.index == 0) return target;
		var concrete = generic_instantiate(index, target, enclosing, args, index.uses[node.index].span);
		if (concrete.index > 0) index.generic_calls[node.index] = concrete;
		return concrete;
	}
	if (supplied == 0) {
		var callable = index.symbol_types[target.index];
		if (callable.index == 0) return type_symbol(0);
		var arguments = index.bindings.program.arena.get_list_arguments(node);
		if (index.types.row(callable).count != index.bindings.program.arena.list_count(arguments) + 1) {
			index.fail(index.uses[node.index].span, "generic call argument count mismatch");
			return type_symbol(0);
		}
		i = 0;
		while (i < index.bindings.program.arena.list_count(arguments)) {
			var actual = checked_expression(index, index.bindings.program.arena.node_at(arguments, i), no_type(), depth + 1);
			if (actual.index == 0) return type_symbol(0);
			if (!generic_unify(index, target, enclosing, index.types.argument(index.types, callable, i + 1).type, actual, args, 0)) {
				index.fail(index.uses[node.index].span, "conflicting or unavailable generic argument inference");
				return type_symbol(0);
			}
			i = i + 1;
		}
	}
	var concrete = generic_instantiate(index, target, enclosing, args, index.uses[node.index].span);
	if (concrete.index > 0) index.generic_calls[node.index] = concrete;
	return concrete;
}

SymbolId generic_call_target(CheckedIndex index, SyntaxNodeId node, SymbolId target, int depth) throws Error {
	if (node.index < len(index.generic_calls) && index.generic_calls[node.index].index > 0) return index.generic_calls[node.index];
	var place = index.bindings.program.arena.get_node_receiver_place(node);
	if (index.bindings.program.arena.get_token_receiver(node).index != 0 || place.index != 0) {
		var method = generic_method_target(index, node, depth);
		if (method.index > 0 || index.failed() || target.index == 0 || place.index != 0) return method;
		// Binder may have resolved a namespace-qualified ordinary callable.
		// An unsupported instance method must never take that fallback.
		if (index.bindings.symbol(target).kind == 11) return type_symbol(0);
	}
	if (target.index == 0) return generic_method_target(index, node, depth);
	if (!generic_template(index, target)) return target;
	return generic_select_call(index, node, target, no_type(), depth);
}

SymbolId generic_origin(GenericInstance plan) { return plan.origin; }

SymbolId generic_declaration(GenericInstance plan) { return plan.concrete; }

TypeId generic_enclosing(GenericInstance plan) { return plan.enclosing; }

int generic_argument_count(CheckedIndex index, GenericInstance plan) { return plan.argument_count; }

TypeEdge generic_argument(CheckedIndex index, GenericInstance plan, int ordinal) { return index.generic_arguments[plan.arguments + ordinal]; }

int generic_node(CheckedIndex index, GenericInstance plan, int ordinal) {
	if (ordinal < plan.node_first || ordinal - plan.node_first >= plan.node_count) return 0;
	return index.generic_node_map[plan.nodes + ordinal - plan.node_first + 1];
}

int generic_symbol_source(CheckedIndex index, GenericInstance plan, int ordinal) {
	if (plan.sparse_bindings) return index.generic_symbol_keys[plan.symbols + ordinal + 1];
	return plan.symbol_first + ordinal;
}

int generic_symbol(CheckedIndex index, GenericInstance plan, int ordinal) {
	if (!plan.sparse_bindings) {
		if (ordinal < plan.symbol_first || ordinal - plan.symbol_first >= plan.symbol_count) return 0;
		return index.generic_symbol_map[plan.symbols + ordinal - plan.symbol_first + 1];
	}
	if (ordinal < plan.symbol_first || ordinal > index.generic_symbols) return 0;
	int low = 0; int high = plan.symbol_count - 1;
	while (low <= high) {
		int middle = low + (high - low) / 2;
		int slot = plan.symbols + middle + 1;
		int key = index.generic_symbol_keys[slot];
		if (key == ordinal) return index.generic_symbol_map[slot];
		if (key < ordinal) low = middle + 1;
		else {
			high = middle - 1;
		}
	}
	return 0;
}

int generic_scope_source(CheckedIndex index, GenericInstance plan, int ordinal) {
	if (plan.sparse_bindings) return index.generic_scope_keys[plan.scopes + ordinal + 1];
	return plan.scope_first + ordinal;
}

int generic_scope(CheckedIndex index, GenericInstance plan, int ordinal) {
	if (!plan.sparse_bindings) {
		if (ordinal < plan.scope_first || ordinal - plan.scope_first >= plan.scope_count) return 0;
		return index.generic_scope_map[plan.scopes + ordinal - plan.scope_first + 1];
	}
	if (ordinal < plan.scope_first || ordinal > index.generic_scopes) return 0;
	int low = 0; int high = plan.scope_count - 1;
	while (low <= high) {
		int middle = low + (high - low) / 2;
		int slot = plan.scopes + middle + 1;
		int key = index.generic_scope_keys[slot];
		if (key == ordinal) return index.generic_scope_map[slot];
		if (key < ordinal) low = middle + 1;
		else {
			high = middle - 1;
		}
	}
	return 0;
}

void generic_store_node(CheckedIndex index, GenericInstance plan, SyntaxNodeId original, SyntaxNodeId concrete) throws Error {
	if (original.index < plan.node_first || original.index - plan.node_first >= plan.node_count) {
		index.fail(index.bindings.program.arena.header(original).span, "generic mapping outside declaration window");
		return;
	}
	index.generic_node_map[plan.nodes + original.index - plan.node_first + 1] = concrete.index;
}

int generic_state(GenericInstance plan) { return plan.state; }
