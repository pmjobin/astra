// A range is a copyable bound pair plus an inclusive bit, never an allocation.
bool range_type_verified(TypeTable types, TypeId type) {
	return types.integer_range_type(type);
}

TypeId checked_range_binary(CheckedIndex index, SyntaxNodeId node, TypeId expected, int depth) throws Error {
	if (!checked_modern_source(index, node)) return index.defer(node, 15);
	var left_node = index.bindings.program.arena.get_node_left(node);
	var right_node = index.bindings.program.arena.get_node_right(node);
	var context = no_type();
	if (range_type_verified(index.types, expected)) context = index.types.argument(index.types, expected, 0).type;
	if (context.index == 0) context = checked_context(index, left_node, depth + 1);
	if (context.index == 0) context = checked_context(index, right_node, depth + 1);
	var left = checked_expression(index, left_node, context, depth + 1);
	var right = checked_expression(index, right_node, left, depth + 1);
	if (left.index == 0 || right.index == 0) return index.defer(node, 15);
	if (left.index != right.index || !type_integer(checked_kind(index, left)) || index.uses[left_node.index].flags != 0 || index.uses[right_node.index].flags != 0) {
		index.fail(index.bindings.program.arena.header(node).span, "range bounds require one exact concrete integer type");
		return no_type();
	}
	return index.types.unary(36, left, 0);
}

bool range_source_verified(SyntaxArena arena, SyntaxNodeId node) {
	var token = arena.get_token_operator_token(node);
	var whole = arena.header(node).span;
	var left = arena.header(arena.get_node_left(node)).span;
	var right = arena.header(arena.get_node_right(node)).span;
	var operator_span = arena.token_span(token);
	if (whole.source.index != left.source.index || whole.source.index != right.source.index || whole.source.index != operator_span.source.index || whole.start != left.start || whole.end != right.end || left.end > operator_span.start || operator_span.end > right.start) return false;
	try {
		var backing = arena.source(whole.source);
		if (!source_valid_span(shared_borrow(backing), left.end, right.start)) return false;
		var bytes = source_bytes(shared_borrow(backing), left.end, right.start);
		var buffer = source_buffer("<integer-range-operator-proof>", move bytes, false);
		var retained = shared_acquire(move buffer);
		// An unselected fragment lexer intentionally keeps the original dot
		// tokens, proving adjacency without trusting the new range token kind.
		var scanner = lexer(move retained);
		var first = scanner.next_token(); var second = scanner.next_token();
		if (scanner.failed || first.kind() != TokenKind.DOT() || second.kind() != TokenKind.DOT() || first.span.end != second.span.start || operator_span.start != left.end + first.span.start) return false;
		int end = second.span.end;
		if (arena.token_is(token, "..=")) {
			var equal = scanner.next_token();
			if (scanner.failed || equal.kind() != TokenKind.EQUAL() || equal.span.start != end) return false;
			end = equal.span.end;
		}
		var eof = scanner.next_token();
		return !scanner.failed && eof.kind() == TokenKind.EOF() && operator_span.end == left.end + end;
	} catch (Error error) { return false; }
}

TypeId range_receiver_type(CheckedIndex index, SyntaxNodeId node) {
	var aggregate = index.bindings.program.arena.get_node_aggregate(node);
	if (aggregate.index > 0 && aggregate.index < len(index.uses)) return index.uses[aggregate.index].type;
	var symbol = checked_target(index, node, index.bindings.program.arena.get_token_identifier(node));
	if (symbol.index > 0 && symbol.index < len(index.symbol_types)) return index.symbol_types[symbol.index];
	return no_type();
}

bool range_field_verified(CheckedIndex index, SyntaxNodeId node) {
	if (node.index < 1 || node.index >= len(index.uses) || index.bindings.program.arena.kind(node) != SyntaxKind.FieldAccessExpressionSyntax() || !checked_modern_source(index, node)) return false;
	var type = range_receiver_type(index, node);
	if (!range_type_verified(index.types, type)) return false;
	var field = index.bindings.program.arena.get_token_field_name(node);
	if (!index.bindings.program.arena.token_is(field, "start") && !index.bindings.program.arena.token_is(field, "end") || checked_target(index, node, field).index != 0) return false;
	var use = index.uses[node.index];
	if (use.flags != 0 || use.deferred != 0 || use.type.index != index.types.argument(index.types, type, 0).type.index) return false;
	return range_field_source(index.bindings.program.arena, node);
}

bool range_field_source(SyntaxArena arena, SyntaxNodeId node) {
	var field = arena.get_token_field_name(node);
	var whole = arena.header(node).span;
	var aggregate = arena.get_node_aggregate(node);
	var receiver = arena.token_span(arena.get_token_identifier(node));
	if (aggregate.index > 0) receiver = arena.header(aggregate).span;
	var member = arena.token_span(field);
	if (whole.source.index != receiver.source.index || whole.source.index != member.source.index || whole.start != receiver.start || whole.end != member.end || receiver.end > member.start) return false;
	try {
		var backing = arena.source(whole.source);
		if (!source_valid_span(shared_borrow(backing), receiver.end, member.end)) return false;
		var bytes = source_bytes(shared_borrow(backing), receiver.end, member.end);
		var buffer = source_buffer("<range-member-proof>", move bytes, false);
		var retained = shared_acquire(move buffer); var scanner = lexer(move retained);
		var separator = scanner.next_token(); var identifier = scanner.next_token(); var eof = scanner.next_token();
		if (scanner.failed || separator.kind() != TokenKind.DOT() || identifier.kind() != TokenKind.IDENTIFIER() || eof.kind() != TokenKind.EOF() || receiver.end + identifier.span.start != member.start || receiver.end + identifier.span.end != member.end) return false;
		var text = source_bytes(shared_borrow(backing), member.start, member.end);
		if (arena.token_is(field, "start")) return len(text) == 5 && text[0] == 115 && text[1] == 116 && text[2] == 97 && text[3] == 114 && text[4] == 116;
		return len(text) == 3 && text[0] == 101 && text[1] == 110 && text[2] == 100;
	} catch (Error error) { return false; }
}

bool range_value_facts_verified(CheckedIndex index) {
	int at = 1;
	while (at < len(index.uses)) {
		SyntaxNodeId node = {index = at};
		if (index.bindings.program.arena.kind(node) == SyntaxKind.BinaryExpressionSyntax()) {
			var token = index.bindings.program.arena.get_token_operator_token(node);
			bool inclusive = index.bindings.program.arena.token_is(token, "..=");
			if (inclusive || index.bindings.program.arena.token_is(token, "..")) {
				var use = index.uses[at];
				if (!checked_modern_source(index, node) || !range_type_verified(index.types, use.type) || use.flags != 0 || use.deferred != 0 || !range_source_verified(index.bindings.program.arena, node)) return false;
				var expected = TokenKind.RANGE(); if (inclusive) expected = TokenKind.RANGE_INCLUSIVE();
				if (index.bindings.program.arena.token_kind(token) != expected) return false;
				var element = index.types.argument(index.types, use.type, 0);
				var left = index.bindings.program.arena.get_node_left(node);
				var right = index.bindings.program.arena.get_node_right(node);
				if (index.uses[left.index].type.index != element.type.index || index.uses[right.index].type.index != element.type.index || index.uses[left.index].flags != 0 || index.uses[right.index].flags != 0) return false;
			}
		}
		at = at + 1;
	}
	return true;
}

int range_query_action(CheckedIndex index, SyntaxNodeId node) {
	if (index.bindings.program.arena.kind(node) != SyntaxKind.CallExpressionSyntax() || !checked_modern_source(index, node)) return 0;
	var token = index.bindings.program.arena.get_token_identifier(node);
	if (index.bindings.program.arena.token_is(token, "is_empty")) return 1;
	if (index.bindings.program.arena.token_is(token, "contains")) return 2;
	return 0;
}

TypeId range_query_receiver(CheckedIndex index, SyntaxNodeId node) {
	var receiver = index.bindings.program.arena.get_node_receiver_place(node);
	if (receiver.index > 0) return index.uses[receiver.index].type;
	var target = checked_target(index, node, index.bindings.program.arena.get_token_receiver(node));
	if (target.index > 0) return index.symbol_types[target.index];
	return no_type();
}

TypeId checked_range_query(CheckedIndex index, SyntaxNodeId node, int depth) throws Error {
	int action = range_query_action(index, node); if (action == 0) return no_type();
	var receiver = index.bindings.program.arena.get_node_receiver_place(node);
	var type = no_type();
	if (receiver.index > 0) type = checked_expression(index, receiver, no_type(), depth + 1);
	else {
		type = range_query_receiver(index, node);
	}
	if (!range_type_verified(index.types, type)) return no_type();
	var arguments = index.bindings.program.arena.get_list_arguments(node);
	if (index.bindings.program.arena.list_count(arguments) != action - 1 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_argument_names(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_arguments(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_qualifier_arguments(node)) != 0 || index.bindings.program.arena.get_bool_signal_emission(node)) {
		index.fail(index.bindings.program.arena.header(node).span, "range query requires its exact positional signature"); return no_type();
	}
	if (action == 2) {
		var argument = index.bindings.program.arena.node_at(arguments, 0);
		var expected = index.types.argument(index.types, type, 0).type;
		var actual = checked_expression(index, argument, expected, depth + 1);
		checked_mismatch(index, index.bindings.program.arena.header(argument).span, expected, actual, "range containment argument");
		if (index.uses[argument.index].flags != 0) {
			index.fail(index.bindings.program.arena.header(argument).span, "range containment requires a copied integer");
			return no_type();
		}
	}
	var use = index.uses[node.index]; use.flags = 0; use.deferred = 0; index.uses[node.index] = use;
	return type_id(13);
}

bool range_query_source(SyntaxArena arena, SyntaxNodeId node) {
	var whole = arena.header(node).span; var receiver = arena.token_span(arena.get_token_receiver(node));
	var aggregate = arena.get_node_receiver_place(node); if (aggregate.index > 0) receiver = arena.header(aggregate).span;
	var token = arena.get_token_identifier(node); var method = arena.token_span(token); var opening = arena.token_span(arena.get_token_open_paren(node)); var closing = arena.token_span(arena.get_token_close_paren(node));
	if (whole.source.index != receiver.source.index || whole.source.index != method.source.index || whole.source.index != opening.source.index || whole.source.index != closing.source.index || whole.start != receiver.start || whole.end != closing.end || receiver.end > method.start || method.end > opening.start || opening.end > closing.start || !syntax_call_labels_verified(arena, node)) return false;
	try {
		var backing = arena.source(whole.source); if (!source_valid_span(shared_borrow(backing), receiver.end, opening.start)) return false;
		var bytes = source_bytes(shared_borrow(backing), receiver.end, opening.start);
		var buffer = source_buffer("<range-query-proof>", move bytes, false); var retained = shared_acquire(move buffer); var scanner = lexer(move retained);
		var separator = scanner.next_token(); var name = scanner.next_token(); var eof = scanner.next_token();
		return !scanner.failed && separator.kind() == TokenKind.DOT() && name.kind() == TokenKind.IDENTIFIER() && eof.kind() == TokenKind.EOF() && receiver.end + name.span.start == method.start && receiver.end + name.span.end == method.end && arena.token_is(token, name.spelling.text);
	} catch (Error error) { return false; }
}

bool range_query_verified(CheckedIndex index, SyntaxNodeId node) {
	int action = range_query_action(index, node); if (action == 0) return false;
	var type = range_query_receiver(index, node); if (!range_type_verified(index.types, type)) return false;
	var token = index.bindings.program.arena.get_token_identifier(node);
	if (checked_target(index, node, token).index != 0 || index.uses[node.index].type.index != 13 || index.uses[node.index].flags != 0 || index.uses[node.index].deferred != 0 || index.bindings.program.arena.get_bool_signal_emission(node) || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_type_arguments(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_qualifier_arguments(node)) != 0 || index.bindings.program.arena.list_count(index.bindings.program.arena.get_list_argument_names(node)) != 0 || !range_query_source(index.bindings.program.arena, node)) return false;
	var arguments = index.bindings.program.arena.get_list_arguments(node);
	if (index.bindings.program.arena.list_count(arguments) != action - 1) return false;
	if (action == 2) {
		var argument = index.bindings.program.arena.node_at(arguments, 0); var use = index.uses[argument.index];
		if (use.type.index != index.types.argument(index.types, type, 0).type.index || use.flags != 0 || use.deferred != 0) return false;
	}
	return true;
}
