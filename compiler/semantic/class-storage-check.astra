// Independent source/representation consumer. No planner, producer eligibility
// helper, cached proof bit, LLVM handle or source filename is an authority here.
bool class_storage_template_verified(CheckedIndex checked, SymbolId origin) {
	if (!checked.class_storage || origin.index < 1 || origin.index > checked.generic_symbols) return false;
	var declaration = checked.bindings.symbol(origin); var node = declaration.node;
	if (declaration.kind != 4) return false;
	var parameters = checked.bindings.program.arena.get_list_type_parameters(node);
	var clauses = checked.bindings.program.arena.get_list_where_clauses(node);
	int constraints = checked.bindings.program.arena.list_count(clauses);
	if (checked.bindings.program.arena.list_count(parameters) != 1 || constraints > 1) return false;
	if (checked.bindings.program.arena.get_bool_exact_heap_class(node) != (constraints == 1)) return false;
	if (constraints == 1) {
		var clause = checked.bindings.program.arena.node_at(clauses, 0);
		var capabilities = checked.bindings.program.arena.get_list_capabilities(clause);
		if (!generic_token_equal(checked, checked.bindings.program.arena.token_at(parameters, 0), checked.bindings.program.arena.get_token_type_parameter(clause)) || checked.bindings.program.arena.list_count(capabilities) != 1 || !checked.bindings.program.arena.token_is(checked.bindings.program.arena.token_at(capabilities, 0), "ExactHeapClass")) return false;
	}
	var fields = checked.bindings.program.arena.get_list_fields(node); int slots = 0; int i = 0;
	while (i < checked.bindings.program.arena.list_count(fields)) {
		var field = checked.bindings.program.arena.node_at(fields, i); var id = checked.node_symbols[field.index];
		if (id.index == 0) return false;
		var type = checked.symbol_types[id.index]; var row = checked.types.row(type);
		int flags = checked.symbol_flags[id.index];
		if (row.kind == 23) {
			var argument = checked.types.argument(checked.types, type, 0); var parameter = checked.types.row(argument.type);
			if (flags != 4 || argument.flags != 0 || parameter.kind != 33) return false;
			var source = checked.bindings.symbol(parameter.nominal);
			if (source.kind != 9 || source.owner.index != origin.index || source.token.index != checked.bindings.program.arena.token_at(parameters, 0).index) return false;
			slots = slots + 1;
		} else {
			if ((!type_numeric(row.kind) && row.kind != 13) || flags != 0) return false;
		}
		i = i + 1;
	}
	return slots >= 1 && slots <= 8;
}

bool class_storage_source_verified(CheckedIndex checked, TypeId type, bool exact, int depth) {
	if (!checked.class_storage || depth > 32 || !checked.types.valid_id(type)) return false;
	var descriptor = checked.types.row(type);
	if (descriptor.kind != 31 || descriptor.count != 0 || descriptor.nominal.index < 1 || descriptor.nominal.index > checked.bindings.symbol_count) return false;
	var declaration = checked.bindings.symbol(descriptor.nominal); var node = declaration.node;
	if (declaration.kind != 4 || checked.bindings.program.arena.kind(node) != SyntaxKind.ClassDeclarationSyntax() || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_parameters(node)) != 0) return false;
	if (exact && generic_instance_for(checked, descriptor.nominal) != 0) return false;
	if (checked.bindings.program.arena.get_node_parent_class(node).index != 0 || checked.bindings.program.arena.get_bool_is_interface(node) || checked.bindings.program.arena.get_token_exception_root(node).index != 0) return false;
	int instance = generic_instance_for(checked, descriptor.nominal);
	if (instance > 0 && !class_storage_template_verified(checked, checked.instances[instance - 1].origin)) return false;
	if (checked.bindings.program.arena.get_bool_exact_heap_class(node) && instance == 0) return false;
	var policy = checked.bindings.program.arena.get_concurrency_concurrency_policy(node);
	if (policy.present || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_allocator(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_representation(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_alignment(node)) != 0 || checked.bindings.program.arena.get_node_foreign_import(node).index != 0 || checked.bindings.program.arena.get_node_foreign_export(node).index != 0 || checked.bindings.program.arena.get_node_com_export(node).index != 0 || checked.bindings.program.arena.get_node_gobject_export(node).index != 0) return false;
	var members = checked.bindings.program.arena.get_list_members(node); int initializers = 0; int m = 0;
	while (m < checked.bindings.program.arena.list_count(members)) {
		var member = checked.bindings.program.arena.node_at(members, m); var kind = checked.bindings.program.arena.kind(member);
		if (kind != SyntaxKind.StructFieldDeclarationSyntax()) {
			if (kind != SyntaxKind.FunctionDeclarationSyntax() && kind != SyntaxKind.LifecycleDeclarationSyntax()) return false;
			if (kind == SyntaxKind.LifecycleDeclarationSyntax()) {
				if (!checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_name(member), "init") || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_base_arguments(member)) != 0) return false;
				initializers = initializers + 1;
			}
			if (checked.bindings.program.arena.get_int_dispatch(member) != 0 || checked.bindings.program.arena.get_node_body(member).index == 0 || checked.bindings.program.arena.get_node_throws_class(member).index != 0 || checked.bindings.program.arena.get_token_async_keyword(member).index != 0 || checked.bindings.program.arena.get_bool_is_signal(member) || checked.bindings.program.arena.get_token_extern_keyword(member).index != 0 || checked.bindings.program.arena.get_token_export_keyword(member).index != 0 || checked.bindings.program.arena.get_node_foreign_policy(member).index != 0 || checked.bindings.program.arena.get_node_foreign_member(member).index != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_ccode(member)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_floating_point(member)) != 0) return false;
		}
		m = m + 1;
	}
	if (initializers != 1) return false;
	return class_storage_fields_verified(checked, type, depth + 1);
}

bool class_storage_fields_verified(CheckedIndex checked, TypeId type, int depth) {
	if (depth > 32 || !checked.types.valid_id(type)) return false;
	var descriptor = checked.types.row(type);
	if (descriptor.kind != 30 && descriptor.kind != 31) return false;
	var declaration = checked.bindings.symbol(descriptor.nominal);
	var fields = checked.bindings.program.arena.get_list_fields(declaration.node); int count = checked.bindings.program.arena.list_count(fields);
	if (count > 128 || descriptor.kind == 30 && count == 0) return false;
	int i = count - 1;
	while (i >= 0) {
		var node = checked.bindings.program.arena.node_at(fields, i); var symbol = checked.node_symbols[node.index];
		if (symbol.index < 1 || symbol.index > checked.bindings.symbol_count) return false;
		var field = checked.bindings.symbol(symbol);
		if (field.kind != 6 || field.owner.index != descriptor.nominal.index || field.node.index != node.index) return false;
		int flags = checked.symbol_flags[symbol.index];
		// Field qualifiers come directly from source, without a dependency
		// on the Flow solver or its graph representation.
		int source_flags = checked_flags(checked.bindings.program.arena, node) & 7;
		var source_type = checked.bindings.program.arena.get_node_type_name(node);
		if (source_type.index != 0 && checked.bindings.program.arena.kind(source_type) == SyntaxKind.NonNullTypeSyntax()) source_flags = source_flags | 1;
		if (flags != source_flags) return false;
		var value = checked.symbol_types[symbol.index]; int kind = checked_kind(checked, value);
		if (type_numeric(kind) || kind == 13) {
			if (flags != 0) return false;
		}
		if (kind == 30) {
			if (flags != 0 || !class_storage_record_verified(checked, value) || !class_storage_fields_verified(checked, value, depth + 1) || descriptor.kind == 31 && checked_record_owned(checked, value, 0)) return false;
		} if (kind == 31) {
			if ((flags != 4 && flags != 5) || !class_storage_source_verified(checked, value, false, depth + 1)) return false;
		} if (kind == 22) {
			var element = checked.types.argument(checked.types, value, 0); int element_kind = checked_kind(checked, element.type);
			if (flags != 4 || element.flags != 0) return false;
			if (element_kind == 30) {
				if (checked_record_owned(checked, element.type, 0) || !class_storage_record_verified(checked, element.type) || !class_storage_fields_verified(checked, element.type, depth + 1)) return false;
			} if (element_kind != 30 && !type_numeric(element_kind) && element_kind != 13) return false;
		} if (kind == 23) {
			var element = checked.types.argument(checked.types, value, 0);
			if (flags != 4 || element.flags != 0 || !class_storage_slot_element_verified(checked, element.type, depth + 1)) return false;
		} if (!type_numeric(kind) && kind != 13 && kind != 30 && kind != 31 && kind != 22 && kind != 23) return false;
		i = i - 1;
	}
	return true;
}

bool class_storage_slot_element_verified(CheckedIndex checked, TypeId type, int depth) {
	if (depth > 32) return false;
	int kind = checked_kind(checked, type);
	if (kind == 31) return class_storage_source_verified(checked, type, true, depth + 1);
	return kind == 30 && class_storage_record_verified(checked, type) && !checked_record_owned(checked, type, 0) && class_storage_fields_verified(checked, type, depth + 1);
}

bool class_storage_record_verified(CheckedIndex checked, TypeId type) {
	if (checked_kind(checked, type) != 30) return false;
	var declaration = checked.bindings.symbol(checked.types.row(type).nominal); var node = declaration.node;
	if (declaration.kind != 3 || checked.bindings.program.arena.kind(node) != SyntaxKind.StructDeclarationSyntax()) return false;
	if (checked.bindings.program.arena.get_concurrency_concurrency_policy(node).present || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_parameters(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_allocator(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_alignment(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_representation(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_where_clauses(node)) != 0 || checked.bindings.program.arena.get_node_foreign_member(node).index != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_foreign_channels(node)) != 0) return false;
	var members = checked.bindings.program.arena.get_list_members(node); int i = checked.bindings.program.arena.list_count(members);
	while (i > 0) {
		i = i - 1;
		if (checked.bindings.program.arena.kind(checked.bindings.program.arena.node_at(members, i)) != SyntaxKind.StructFieldDeclarationSyntax()) return false;
	}
	int count = checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(node));
	return count >= 1 && count <= 128;
}

bool class_storage_verify(ClassStoragePlan plan, CheckedIndex checked) {
	if (!type_owner_same(plan.identity, checked.types.identity)) return false;
	if (!checked.class_storage || !checked.validate() || !generic_verify(checked) || !plan.active || plan.target != 1 || plan.pointer_size != 8 || plan.pointer_alignment != 8 || len(plan.types) != checked.types.count + 1 || len(plan.fields) != checked.bindings.symbol_count + 1) return false;
	var seen = new bool[len(plan.fields)]; int t = 1;
	while (t < len(plan.types)) {
		var row = plan.types[t]; var source = checked.types.row(type_id(t));
		if (row.state != 0) {
			if (row.state != 2 || row.semantic != t || row.nominal != source.nominal.index || row.kind != source.kind) return false;
			int size = 0; int alignment = 1;
			if (type_integer(source.kind)) {
				size = type_width(source.kind) / 8;
				alignment = size;
			}
			if (source.kind == 13) size = 1;
			if (source.kind == 11) {
				size = 4;
				alignment = 4;
			}
			if (source.kind == 12 || source.kind == 16 || source.kind == 20 || source.kind == 31) {
				size = 8;
				alignment = 8;
			}
			if (source.kind == 22 || source.kind == 23) {
				size = 16;
				alignment = 8;
			}
			if (!type_numeric(source.kind) && source.kind != 13 && source.kind != 16 && source.kind != 20 && source.kind != 31 && source.kind != 22 && source.kind != 23 && source.kind != 14 && source.kind != 30) return false;
			if (source.kind == 30 || source.kind == 31) {
				if (source.kind == 31 && !class_storage_source_verified(checked, type_id(t), false, 0)) return false;
				if (source.kind == 30 && !class_storage_fields_verified(checked, type_id(t), 0)) return false;
				var declaration = checked.bindings.symbol(source.nominal);
				var fields = checked.bindings.program.arena.get_list_fields(declaration.node);
				int extent = 0; int payload_alignment = 1; int field = 0;
				if (row.fields != checked.bindings.program.arena.list_count(fields)) return false;
				while (field < row.fields) {
					var node = checked.bindings.program.arena.node_at(fields, field); var symbol = checked.node_symbols[node.index];
					var type = checked.symbol_types[symbol.index]; var child = plan.types[type.index]; var entry = plan.fields[symbol.index];
					if (child.state != 2 || child.alignment < 1 || child.alignment > 8 || child.size < 1 || child.size > 16777216) return false;
					extent = ((extent + child.alignment - 1) / child.alignment) * child.alignment;
					if (entry.owner != t || entry.symbol != symbol.index || entry.ordinal != field || entry.semantic != type.index || entry.flags != checked.symbol_flags[symbol.index] || entry.offset != extent || seen[symbol.index]) return false;
					seen[symbol.index] = true; extent = extent + child.size;
					if (child.alignment > payload_alignment) payload_alignment = child.alignment;
					field = field + 1;
				}
				extent = ((extent + payload_alignment - 1) / payload_alignment) * payload_alignment;
				if (source.kind == 31 && extent == 0) extent = 1;
				if (row.payload_size != extent || row.payload_alignment != payload_alignment) return false;
				if (source.kind == 30) {
					size = extent;
					alignment = payload_alignment;
				}
			} if (source.kind != 30 && source.kind != 31 && (row.fields != 0 || row.payload_size != 0 || row.payload_alignment != 1)) return false;
			if (row.size != size || row.alignment != alignment) return false;
			if (source.kind == 22 || source.kind == 23) {
				var element = checked.types.argument(checked.types, type_id(t), 0);
				if (plan.types[element.type.index].state != 2 || element.flags != 0) return false;
				if (source.kind == 23 && !class_storage_slot_element_verified(checked, element.type, 0)) return false;
			}
		}
		t = t + 1;
	}
	int s = 1;
	while (s < len(plan.fields)) {
		if (!seen[s] && plan.fields[s].symbol != 0) return false;
		var symbol = checked.bindings.symbol(type_symbol(s)); var type = checked.symbol_types[s];
		if ((symbol.kind == 4 || symbol.kind == 8 || symbol.kind == 7) && class_storage_source_verified(checked, type, false, 0) && plan.types[type.index].state != 2) return false;
		s = s + 1;
	}
	return true;
}
