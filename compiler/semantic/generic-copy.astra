SyntaxListId generic_copy_list(CheckedIndex index, GenericInstance plan, SyntaxListId original, int element, int depth) throws Error {
	if (original.index == 0) return original;
	var result = index.bindings.program.arena.new_list(element);
	int i = 0;
	while (i < index.bindings.program.arena.list_count(original) && !index.failed()) {
		var child = generic_copy_node(index, plan, index.bindings.program.arena.node_at(original, i), depth + 1);
		if (child.index == 0) break;
		index.bindings.program.arena.append_node(result, child); i = i + 1;
	}
	return result;
}
