			data.f_subscript = generic_copy_node(index, plan, data.f_subscript, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_index_expression(data, header.span, header.depth);
		}
		case SyntaxKind.VectorExtractExpressionSyntax(): {
			var data = index.bindings.program.arena.vector_extract_expression(original);
			data.f_container = generic_copy_node(index, plan, data.f_container, depth + 1);
			data.f_subscript = generic_copy_node(index, plan, data.f_subscript, depth + 1);
			data.f_vector = generic_copy_node(index, plan, data.f_vector, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_vector_extract_expression(data, header.span, header.depth);
		}
		case SyntaxKind.IndexedAssignmentSyntax(): {
			var data = index.bindings.program.arena.indexed_assignment(original);
			data.f_target = generic_copy_node(index, plan, data.f_target, depth + 1);
			data.f_expression = generic_copy_node(index, plan, data.f_expression, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_indexed_assignment(data, header.span, header.depth);
		}
		case SyntaxKind.FieldAccessExpressionSyntax(): {
			var data = index.bindings.program.arena.field_access_expression(original);
			data.f_aggregate = generic_copy_node(index, plan, data.f_aggregate, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_field_access_expression(data, header.span, header.depth);
		}
		case SyntaxKind.BreakStatementSyntax(): {
			var data = index.bindings.program.arena.break_statement(original);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_break_statement(data, header.span, header.depth);
		}
		case SyntaxKind.ContinueStatementSyntax(): {
			var data = index.bindings.program.arena.continue_statement(original);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_continue_statement(data, header.span, header.depth);
		}
		case SyntaxKind.WhereClauseSyntax(): {
			var data = index.bindings.program.arena.where_clause(original);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_where_clause(data, header.span, header.depth);
		}
		case SyntaxKind.HeapObjectConstructionSyntax(): {
			var data = index.bindings.program.arena.heap_object_construction(original);
			data.f_allocation_context = generic_copy_node(index, plan, data.f_allocation_context, depth + 1);
			data.f_class_name = generic_copy_node(index, plan, data.f_class_name, depth + 1);
			data.f_arguments = generic_copy_list(index, plan, data.f_arguments, syntax_kind_code(SyntaxKind.ExpressionSyntax()), depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_heap_object_construction(data, header.span, header.depth);
		}
		case SyntaxKind.ClassDeclarationSyntax(): {
			var data = index.bindings.program.arena.class_declaration(original);
			data.f_allocator = generic_copy_list(index, plan, data.f_allocator, syntax_kind_code(SyntaxKind.CCodeEntrySyntax()), depth + 1);
			data.f_alignment = generic_copy_list(index, plan, data.f_alignment, syntax_kind_code(SyntaxKind.CCodeEntrySyntax()), depth + 1);
			data.f_representation = generic_copy_list(index, plan, data.f_representation, syntax_kind_code(SyntaxKind.CCodeEntrySyntax()), depth + 1);
			data.f_members = generic_class_members(index, plan, data.f_members, depth + 1);
			data.f_methods.index = 0;
			data.f_fields = generic_copy_list(index, plan, data.f_fields, syntax_kind_code(SyntaxKind.StructFieldDeclarationSyntax()), depth + 1);
			data.f_where_clauses.index = 0;
			data.f_foreign_import = generic_copy_node(index, plan, data.f_foreign_import, depth + 1);
			data.f_foreign_export = generic_copy_node(index, plan, data.f_foreign_export, depth + 1);
			data.f_com_export = generic_copy_node(index, plan, data.f_com_export, depth + 1);
			data.f_gobject_export = generic_copy_node(index, plan, data.f_gobject_export, depth + 1);
			data.f_type_parameters.index = 0;
			data.f_parent_class = generic_copy_node(index, plan, data.f_parent_class, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_class_declaration(data, header.span, header.depth);
		}
		case SyntaxKind.LifecycleDeclarationSyntax(): {
			var data = index.bindings.program.arena.lifecycle_declaration(original);
			data.f_foreign_policy = generic_copy_node(index, plan, data.f_foreign_policy, depth + 1);
			data.f_throws_class = generic_copy_node(index, plan, data.f_throws_class, depth + 1);
			data.f_ccode = generic_copy_list(index, plan, data.f_ccode, syntax_kind_code(SyntaxKind.CCodeEntrySyntax()), depth + 1);
			data.f_floating_point = generic_copy_list(index, plan, data.f_floating_point, syntax_kind_code(SyntaxKind.CCodeEntrySyntax()), depth + 1);
			data.f_where_clauses = generic_copy_list(index, plan, data.f_where_clauses, syntax_kind_code(SyntaxKind.WhereClauseSyntax()), depth + 1);
			data.f_return_type = generic_copy_node(index, plan, data.f_return_type, depth + 1);
			data.f_parameters = generic_copy_list(index, plan, data.f_parameters, syntax_kind_code(SyntaxKind.ParameterSyntax()), depth + 1);
			data.f_body = generic_copy_node(index, plan, data.f_body, depth + 1);
			data.f_base_arguments = generic_copy_list(index, plan, data.f_base_arguments, syntax_kind_code(SyntaxKind.ExpressionSyntax()), depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_lifecycle_declaration(data, header.span, header.depth);
		}
		case SyntaxKind.TextLiteralExpressionSyntax(): {
			var data = index.bindings.program.arena.text_literal_expression(original);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_text_literal_expression(data, header.span, header.depth);
		}
		case SyntaxKind.ThrowStatementSyntax(): {
			var data = index.bindings.program.arena.throw_statement(original);
			data.f_expression = generic_copy_node(index, plan, data.f_expression, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_throw_statement(data, header.span, header.depth);
		}
		case SyntaxKind.TryStatementSyntax(): {
			var data = index.bindings.program.arena.try_statement(original);
			data.f_body = generic_copy_node(index, plan, data.f_body, depth + 1);
			data.f_catches = generic_copy_list(index, plan, data.f_catches, syntax_kind_code(SyntaxKind.CatchClauseSyntax()), depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_try_statement(data, header.span, header.depth);
		}
		case SyntaxKind.CatchClauseSyntax(): {
			var data = index.bindings.program.arena.catch_clause(original);
			data.f_class_name = generic_copy_node(index, plan, data.f_class_name, depth + 1);
			data.f_body = generic_copy_node(index, plan, data.f_body, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_catch_clause(data, header.span, header.depth);
		}
		case SyntaxKind.RecordExpressionSyntax(): {
			var data = index.bindings.program.arena.record_expression(original);
			data.f_type_name = generic_copy_node(index, plan, data.f_type_name, depth + 1);
			data.f_initializer = generic_copy_node(index, plan, data.f_initializer, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_record_expression(data, header.span, header.depth);
		}
		case SyntaxKind.ConditionalExpressionSyntax(): {
			var data = index.bindings.program.arena.conditional_expression(original);
			data.f_condition = generic_copy_node(index, plan, data.f_condition, depth + 1);
			data.f_left = generic_copy_node(index, plan, data.f_left, depth + 1);
			data.f_right = generic_copy_node(index, plan, data.f_right, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_conditional_expression(data, header.span, header.depth);
		}
		case SyntaxKind.CompoundAssignmentSyntax(): {
			var data = index.bindings.program.arena.compound_assignment(original);
			data.f_target = generic_copy_node(index, plan, data.f_target, depth + 1);
			data.f_expression = generic_copy_node(index, plan, data.f_expression, depth + 1);
			if (!index.failed() && generic_copy_room(index, original)) result = index.bindings.program.arena.add_compound_assignment(data, header.span, header.depth);
		}
		else: { index.fail(header.span, "DEFERRED: generic body syntax lacks a concrete specialization contract"); }
	}
	if (result.index != 0) {
		generic_store_node(index, plan, original, result);
		index.bindings.program.arena.set_bool_module_internal(result, header.module_internal);
	}
	return result;
}

SyntaxListId generic_copy_list(CheckedIndex index, GenericInstance plan, SyntaxListId original, int element, int depth) throws Error {
	if (original.index == 0) return original;
	var result = index.bindings.program.arena.new_list(element);
	foreach (var i in 0..index.bindings.program.arena.list_count(original)) {
		if (index.failed()) break;
		var child = generic_copy_node(index, plan, index.bindings.program.arena.node_at(original, i), depth + 1);
		if (child.index == 0) break;
		index.bindings.program.arena.append_node(result, child);
	}
	return result;
}
