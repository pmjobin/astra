		case SyntaxKind.CallStatementSyntax(): {
			var first_data = index.bindings.program.arena.call_statement(original);
			var second_data = index.bindings.program.arena.call_statement(concrete);
			if (!generic_check_child(index, plan, first_data.f_call, second_data.f_call)) return false;
			if (first_data.f_semicolon.index != second_data.f_semicolon.index) return false;
		}
		case SyntaxKind.MoveExpressionSyntax(): {
			var first_data = index.bindings.program.arena.move_expression(original);
			var second_data = index.bindings.program.arena.move_expression(concrete);
			if (first_data.f_keyword.index != second_data.f_keyword.index) return false;
			if (first_data.f_source.index != second_data.f_source.index) return false;
			if (first_data.f_fields.index != second_data.f_fields.index) return false;
		}
		case SyntaxKind.BufferAllocationSyntax(): {
			var first_data = index.bindings.program.arena.buffer_allocation(original);
			var second_data = index.bindings.program.arena.buffer_allocation(concrete);
			if (!generic_check_child(index, plan, first_data.f_allocation_context, second_data.f_allocation_context)) return false;
			if (!generic_check_child(index, plan, first_data.f_element_type, second_data.f_element_type)) return false;
			if (!generic_check_child(index, plan, first_data.f_count, second_data.f_count)) return false;
			if (!generic_check_child(index, plan, first_data.f_failure_call, second_data.f_failure_call)) return false;
		}
		case SyntaxKind.FieldAccessExpressionSyntax(): {
			var first_data = index.bindings.program.arena.field_access_expression(original);
			var second_data = index.bindings.program.arena.field_access_expression(concrete);
			if (first_data.f_identifier.index != second_data.f_identifier.index) return false;
			if (first_data.f_dot.index != second_data.f_dot.index) return false;
			if (first_data.f_field_name.index != second_data.f_field_name.index) return false;
			if (!generic_check_child(index, plan, first_data.f_aggregate, second_data.f_aggregate)) return false;
		}
		case SyntaxKind.BreakStatementSyntax(): {
			var first_data = index.bindings.program.arena.break_statement(original);
			var second_data = index.bindings.program.arena.break_statement(concrete);
			if (first_data.f_keyword.index != second_data.f_keyword.index) return false;
			if (first_data.f_semicolon.index != second_data.f_semicolon.index) return false;
		}
		case SyntaxKind.ContinueStatementSyntax(): {
			var first_data = index.bindings.program.arena.continue_statement(original);
			var second_data = index.bindings.program.arena.continue_statement(concrete);
			if (first_data.f_keyword.index != second_data.f_keyword.index) return false;
			if (first_data.f_semicolon.index != second_data.f_semicolon.index) return false;
		}
		case SyntaxKind.WhereClauseSyntax(): {
			var first_data = index.bindings.program.arena.where_clause(original);
			var second_data = index.bindings.program.arena.where_clause(concrete);
			if (first_data.f_keyword.index != second_data.f_keyword.index) return false;
			if (first_data.f_type_parameter.index != second_data.f_type_parameter.index) return false;
			if (first_data.f_colon.index != second_data.f_colon.index) return false;
			if (first_data.f_capabilities.index != second_data.f_capabilities.index) return false;
			if (first_data.f_commas.index != second_data.f_commas.index) return false;
		}
		case SyntaxKind.HeapObjectConstructionSyntax(): {
			var first_data = index.bindings.program.arena.heap_object_construction(original);
			var second_data = index.bindings.program.arena.heap_object_construction(concrete);
			if (!generic_check_child(index, plan, first_data.f_allocation_context, second_data.f_allocation_context)) return false;
			if (first_data.f_fallible != second_data.f_fallible) return false;
			if (!generic_check_child(index, plan, first_data.f_class_name, second_data.f_class_name)) return false;
			if (!generic_check_list(index, plan, first_data.f_arguments, second_data.f_arguments)) return false;
		}
		case SyntaxKind.ClassDeclarationSyntax(): {
			var first_data = index.bindings.program.arena.class_declaration(original);
			var second_data = index.bindings.program.arena.class_declaration(concrete);
			if (first_data.f_concurrency_policy.present != second_data.f_concurrency_policy.present) return false;
			if (first_data.f_concurrency_policy.kinds != second_data.f_concurrency_policy.kinds) return false;
			if (first_data.f_concurrency_policy.admitted != second_data.f_concurrency_policy.admitted) return false;
			if (!generic_check_list(index, plan, first_data.f_allocator, second_data.f_allocator)) return false;
			if (!generic_check_list(index, plan, first_data.f_alignment, second_data.f_alignment)) return false;
			if (!generic_check_list(index, plan, first_data.f_representation, second_data.f_representation)) return false;
			if (!generic_class_members_verified(index, plan, first_data.f_members, second_data.f_members)) return false;
			if (index.bindings.program.arena.list_count(second_data.f_methods) != 0) return false;
			if (first_data.f_keyword.index != second_data.f_keyword.index) return false;
			if (first_data.f_name.index != second_data.f_name.index) return false;
			if (first_data.f_open_brace.index != second_data.f_open_brace.index) return false;
			if (!generic_check_list(index, plan, first_data.f_fields, second_data.f_fields)) return false;
			if (first_data.f_close_brace.index != second_data.f_close_brace.index) return false;
			if (second_data.f_where_clauses.index != 0) return false;
			if (!generic_check_child(index, plan, first_data.f_foreign_import, second_data.f_foreign_import)) return false;
			if (!generic_check_child(index, plan, first_data.f_foreign_export, second_data.f_foreign_export)) return false;
			if (!generic_check_child(index, plan, first_data.f_com_export, second_data.f_com_export)) return false;
			if (!generic_check_child(index, plan, first_data.f_gobject_export, second_data.f_gobject_export)) return false;
			if (first_data.f_is_interface != second_data.f_is_interface) return false;
			if (second_data.f_type_parameters.index != 0) return false;
			if (first_data.f_exact_heap_class != second_data.f_exact_heap_class) return false;
			if (!generic_check_child(index, plan, first_data.f_parent_class, second_data.f_parent_class)) return false;
			if (first_data.f_exception_root.index != second_data.f_exception_root.index) return false;
		}
		case SyntaxKind.LifecycleDeclarationSyntax(): {
			var first_data = index.bindings.program.arena.lifecycle_declaration(original);
			var second_data = index.bindings.program.arena.lifecycle_declaration(concrete);
			if (first_data.f_is_signal != second_data.f_is_signal) return false;
			if (!generic_check_child(index, plan, first_data.f_foreign_policy, second_data.f_foreign_policy)) return false;
			if (first_data.f_utf8_factory != second_data.f_utf8_factory) return false;
			if (first_data.f_async_keyword.index != second_data.f_async_keyword.index) return false;
			if (first_data.f_dispatch != second_data.f_dispatch) return false;
			if (!generic_check_child(index, plan, first_data.f_throws_class, second_data.f_throws_class)) return false;
			if (!generic_check_list(index, plan, first_data.f_ccode, second_data.f_ccode)) return false;
			if (!generic_check_list(index, plan, first_data.f_floating_point, second_data.f_floating_point)) return false;
			if (!generic_check_list(index, plan, first_data.f_where_clauses, second_data.f_where_clauses)) return false;
			if (first_data.f_type_parameters.index != second_data.f_type_parameters.index) return false;
			if (first_data.f_owned_keyword.index != second_data.f_owned_keyword.index) return false;
			if (!generic_check_child(index, plan, first_data.f_return_type, second_data.f_return_type)) return false;
			if (first_data.f_name.index != second_data.f_name.index) return false;
			if (first_data.f_open_paren.index != second_data.f_open_paren.index) return false;
			if (!generic_check_list(index, plan, first_data.f_parameters, second_data.f_parameters)) return false;
			if (first_data.f_commas.index != second_data.f_commas.index) return false;
			if (first_data.f_close_paren.index != second_data.f_close_paren.index) return false;
			if (!generic_check_child(index, plan, first_data.f_body, second_data.f_body)) return false;
			if (first_data.f_extern_keyword.index != second_data.f_extern_keyword.index) return false;
			if (first_data.f_export_keyword.index != second_data.f_export_keyword.index) return false;
			if (first_data.f_abi_identifier.index != second_data.f_abi_identifier.index) return false;
			if (first_data.f_semicolon.index != second_data.f_semicolon.index) return false;
			if (!generic_check_list(index, plan, first_data.f_base_arguments, second_data.f_base_arguments)) return false;
		}
		else: { return false; }
	}
	return true;
}

bool generic_check_child(CheckedIndex index, GenericInstance plan, SyntaxNodeId original, SyntaxNodeId concrete) {
	if (original.index == 0) return concrete.index == 0;
	return original.index > 0 && original.index < (index.generic_nodes + 1) && index.generic_node_map[plan.nodes + original.index] == concrete.index && concrete.index != 0;
}

bool generic_check_list(CheckedIndex index, GenericInstance plan, SyntaxListId original, SyntaxListId concrete) {
	int count = index.bindings.program.arena.list_count(original);
	if (count != index.bindings.program.arena.list_count(concrete)) return false;
	int i = 0;
	while (i < count) {
		if (!generic_check_child(index, plan, index.bindings.program.arena.node_at(original, i), index.bindings.program.arena.node_at(concrete, i))) return false;
		i = i + 1;
	}
	return true;
}
