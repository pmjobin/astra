// A foreach binding is an immutable copied integer scoped to one iteration.
// Collection construction is distinct from the loop's repeated body.
void checked_range_foreach(CheckedIndex index, SyntaxNodeId node, TypeId result, int depth) throws Error {
	var collection = index.bindings.program.arena.get_node_collection(node);
	var type = checked_expression(index, collection, no_type(), depth + 1);
	if (!checked_modern_source(index, node) || !range_type_verified(index.types, type) || index.uses[collection.index].flags != 0) {
		index.fail(index.bindings.program.arena.header(node).span, "foreach requires an admitted lazy integer sequence"); return;
	}
	var binding = index.node_symbols[node.index];
	if (binding.index < 1 || index.bindings.symbol(binding).kind != 15) {
		index.fail(index.bindings.program.arena.header(node).span, "foreach requires its exact lexical integer binding");
		return;
	}
	index.symbol_types[binding.index] = index.types.argument(index.types, type, 0).type;
	index.symbol_flags[binding.index] = 0;
	var recorded = index.record(node, type_id(14), 0);
	checked_statement(index, index.bindings.program.arena.get_node_body(node), result, depth + 1);
}

bool range_foreach_source(SyntaxArena arena, SyntaxNodeId node) {
	var whole = arena.header(node).span; var keyword = arena.token_span(arena.get_token_keyword(node));
	var binding = arena.get_token_binding(node); var name = arena.token_span(binding);
	var collection = arena.header(arena.get_node_collection(node)).span; var body = arena.header(arena.get_node_body(node)).span;
	if (whole.source.index != keyword.source.index || whole.source.index != name.source.index || whole.source.index != collection.source.index || whole.source.index != body.source.index || whole.start != keyword.start || whole.end != body.end || keyword.end > name.start || name.end > collection.start || collection.end > body.start) return false;
	try {
		var backing = arena.source(whole.source);
		if (!source_valid_span(shared_borrow(backing), whole.start, collection.start) || !source_valid_span(shared_borrow(backing), collection.end, body.start)) return false;
		var bytes = source_bytes(shared_borrow(backing), whole.start, collection.start);
		var buffer = source_buffer("<range-foreach-prefix-proof>", move bytes, false); var retained = shared_acquire(move buffer); var scanner = lexer(move retained);
		var first = scanner.next_token(); var opening = scanner.next_token(); var inferred = scanner.next_token(); var identifier = scanner.next_token(); var separator = scanner.next_token(); var eof = scanner.next_token();
		if (scanner.failed || first.kind() != TokenKind.FOREACH() || first.span.start != 0 || first.span.end + whole.start != keyword.end || opening.kind() != TokenKind.OPEN_PAREN() || inferred.kind() != TokenKind.VAR() || identifier.kind() != TokenKind.IDENTIFIER() || whole.start + identifier.span.start != name.start || whole.start + identifier.span.end != name.end || !arena.token_is(binding, identifier.spelling.text) || separator.kind() != TokenKind.IDENTIFIER() || separator.spelling.text != "in" || eof.kind() != TokenKind.EOF()) return false;
		var tail_bytes = source_bytes(shared_borrow(backing), collection.end, body.start);
		var tail_buffer = source_buffer("<range-foreach-suffix-proof>", move tail_bytes, false); var tail_retained = shared_acquire(move tail_buffer); var tail = lexer(move tail_retained);
		var closing = tail.next_token(); var end = tail.next_token();
		return !tail.failed && closing.kind() == TokenKind.CLOSE_PAREN() && end.kind() == TokenKind.EOF();
	} catch (Error error) { return false; }
}

bool range_foreach_binding(CheckedIndex index, SymbolId binding) {
	if (binding.index < 1 || binding.index > index.bindings.symbol_count) return false;
	var declaration = index.bindings.symbol(binding); var node = declaration.node;
	if (declaration.kind != 15 || index.bindings.program.arena.kind(node) != SyntaxKind.ForeachStatementSyntax() || !checked_modern_source(index, node) || index.node_symbols[node.index].index != binding.index || index.symbol_flags[binding.index] != 0 || declaration.token.index != index.bindings.program.arena.get_token_binding(node).index || declaration.scope.index != index.bindings.scope_for_node(node).index || !range_foreach_source(index.bindings.program.arena, node)) return false;
	var collection = index.bindings.program.arena.get_node_collection(node); var use = index.uses[collection.index];
	return range_type_verified(index.types, use.type) && use.flags == 0 && use.deferred == 0 && index.symbol_types[binding.index].index == index.types.argument(index.types, use.type, 0).type.index && index.uses[node.index].type.index == 14 && index.uses[node.index].flags == 0;
}
