// Independent conditional-type consumer. It never invokes the refiner,
// computes a nominal ID from spelling, or changes an original checked use.
bool recover_types_verify(RecoverTypes data, CheckedIndex checked) {
	if (!syntax_program_languages_verified(checked.bindings.program)) return false;
	if (data.status != 0 || !type_owner_same(data.identity, checked.types.identity) || !checked.validate() || len(data.types) != len(checked.uses) || len(data.members) != len(data.types) || len(data.borrows) != len(data.types) || len(data.numeric_prefixes) != len(data.types) || data.numeric_prefixes[0].index != 0) return false;
	int n = 1;
	while (n < len(data.types)) {
		SyntaxNodeId node = {index = n}; var original = checked.uses[n]; var type = data.types[n]; var member = data.members[n]; var borrow = data.borrows[n];
		if (type.index != 0 && !checked.types.valid_id(type)) return false;
		if (data.numeric_prefixes[n].index != 0 && (member.index != 0 || borrow.index != 0 || !recover_prefix_type_verified(data, checked, node))) return false;
		if (member.index != 0) {
			if (original.type.index != 0 || original.deferred != 12 || checked.bindings.program.arena.kind(node) != SyntaxKind.FieldAccessExpressionSyntax() || member.index < 1 || member.index > checked.bindings.symbol_count || borrow.index < 1 || borrow.index > checked.bindings.symbol_count) return false;
			var property = checked.bindings.symbol(member); var binding = checked.bindings.symbol(borrow); var root = checked_effect_root(checked);
			if (property.kind != 14 || property.owner.index != root.index || binding.kind != 15 || checked.symbol_flags[borrow.index] != 2 || checked.bindings.program.arena.kind(binding.node) != SyntaxKind.CatchClauseSyntax() || !checked.bindings.program.arena.token_is(property.token, "message") || !generic_token_equal(checked, checked.bindings.program.arena.get_token_field_name(node), property.token)) return false;
			var receiver = checked.bindings.program.arena.get_node_aggregate(node); var target = type_symbol(0);
			if (receiver.index == 0) target = checked_target(checked, node, checked.bindings.program.arena.get_token_identifier(node));
			else {
				if (checked.bindings.program.arena.kind(receiver) != SyntaxKind.NameExpressionSyntax()) return false;
				target = checked_target(checked, receiver, checked.bindings.program.arena.get_token_identifier(receiver));
			}
			if (target.index != borrow.index || !checked_effect_bound(checked, checked.bindings.program.arena.get_node_class_name(binding.node), checked.symbol_types[borrow.index])) return false;
			var declaration = checked.bindings.program.arena.property_declaration(property.node); var declared_type = checked.uses[declaration.f_type_name.index].type;
			if (declared_type.index != 15 || type.index != declared_type.index || declaration.f_dispatch != 1 || declaration.f_setter.index != 0 || declaration.f_getter.index == 0 || declaration.f_owned_keyword.index != 0 || declaration.f_factory_syntax.index != 0 || declaration.f_is_borrowed || declaration.f_lazy_keyword.index != 0 || declaration.f_throws_class.index != 0) return false;
		} else {
			if (borrow.index != 0) return false;
			if (original.type.index != 0) {
				if (type.index != original.type.index) return false;
			}
			else {
				var kind = checked.bindings.program.arena.kind(node); TypeId expected = {index = 0};
				if (data.numeric_prefixes[n].index != 0) expected = checked.uses[data.numeric_prefixes[n].index].type;
				if (kind == SyntaxKind.TextLiteralExpressionSyntax() && recover_error_base_literal(checked, node)) expected = type_id(15);
				if (kind == SyntaxKind.ParenthesizedExpressionSyntax()) {
					var child = checked.bindings.program.arena.get_node_expression(node);
					expected = data.types[child.index];
				}
				if (kind == SyntaxKind.CallExpressionSyntax() && type.index != 0) {
					// Reconstruct the declaration and every argument independently;
					// never call the producer's type computation to certify its result.
					if (original.deferred != 15 || original.flags != 0 || checked.bindings.program.arena.get_node_receiver_place(node).index != 0 || checked.bindings.program.arena.get_token_receiver(node).index != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_arguments(node)) != 0) return false;
					var target = checked_target(checked, node, checked.bindings.program.arena.get_token_identifier(node));
					if (target.index < 1 || target.index > checked.bindings.symbol_count) return false;
					var declaration = checked.bindings.symbol(target);
					int ordinal = checked.symbol_signatures[target.index].index;
					if (declaration.kind != 1 || declaration.owner.index != 0 || ordinal < 1 || ordinal > checked.signature_count) return false;
					var signature = checked.signatures[ordinal - 1];
					if (signature.declaration.index != target.index || signature.callable.index != checked.symbol_types[target.index].index || signature.flags != 0 || !checked_effect_signature_verified(checked, signature)) return false;
					var result = checked.types.argument(checked.types, signature.callable, 0);
					int code = checked_kind(checked, result.type);
					if (result.flags != 0 || code != 13 && code != 14 && !type_numeric(code)) return false;
					var arguments = checked_call_arguments(checked, node);
					int count = checked.bindings.program.arena.list_count(arguments);
					if (checked.types.row(signature.callable).count != count + 1) return false;
					bool recovered = false;
					int a = 0;
					while (a < count) {
						var argument = checked.bindings.program.arena.node_at(arguments, a);
						var channel = checked.types.argument(checked.types, signature.callable, a + 1);
						var use = checked.uses[argument.index];
						if (channel.flags != 0 || use.flags != 0 || data.types[argument.index].index != channel.type.index) return false;
						if (use.type.index == 0) {
							if (use.deferred != 12 || data.types[argument.index].index != 15 || data.members[argument.index].index == 0 || data.borrows[argument.index].index == 0) return false;
							recovered = true;
						} else {
							if (use.type.index != channel.type.index || use.deferred != 0 && use.deferred != 17 && use.deferred != 19) return false;
						}
						a = a + 1;
					}
					if (!recovered) return false;
					expected = result.type;
				}
				if (kind == SyntaxKind.BinaryExpressionSyntax()) {
					var left_node = checked.bindings.program.arena.get_node_left(node); var right_node = checked.bindings.program.arena.get_node_right(node); var left = data.types[left_node.index]; var right = data.types[right_node.index]; var token = checked.bindings.program.arena.get_token_operator_token(node);
					if (left.index > 0 && left.index == right.index && (type_numeric(checked_kind(checked, left)) || left.index == 13 || left.index == 15 || recover_storage_class(checked, left) || recover_storage_error(checked, left) || recover_storage_shared(checked, left) || recover_storage_pointer(checked, left)) && (checked.bindings.program.arena.token_is(token, "==") || checked.bindings.program.arena.token_is(token, "!="))) expected = type_id(13);
				}
				if (kind == SyntaxKind.ShortCircuitExpressionSyntax()) {
					var left = checked.bindings.program.arena.get_node_left(node); var right = checked.bindings.program.arena.get_node_right(node); var token = checked.bindings.program.arena.get_token_operator_token(node);
					if (data.types[left.index].index == 13 && data.types[right.index].index == 13 && (checked.bindings.program.arena.token_is(token, "&&") || checked.bindings.program.arena.token_is(token, "||"))) expected = type_id(13);
				}
				if (type.index != expected.index) return false;
			}
		}
		n = n + 1;
	}
	return enum_value_facts_verified(checked);
}
