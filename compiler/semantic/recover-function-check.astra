// Admit ordinary private functions and actual existing constructor instances.
// A receiver is accepted only with the original generic/Class storage proof.
// These local predicates are used within passes that verify the whole generic
// map at entry. They read the current source rows on every invocation.
bool recover_closed_free_function(CheckedIndex checked, SymbolId function) {
	int instance = generic_instance_for(checked, function);
	if (instance < 1) return false;
	var plan = checked.instances[instance - 1]; var origin = checked.bindings.symbol(plan.origin);
	if (plan.concrete.index != function.index || plan.enclosing.index != 0 || plan.state != 2 || origin.kind != 1 || origin.owner.index != 0 || plan.argument_count < 1 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_parameters(origin.node)) != plan.argument_count) return false;
	int i = 0;
	while (i < plan.argument_count) {
		var argument = checked.generic_arguments[plan.arguments + i];
		if (argument.flags != 0 || !generic_closed(checked, argument.type, 0)) return false;
		i = i + 1;
	}
	return true;
}

bool recover_runtime_function(CheckedIndex checked, SymbolId symbol) {
	return checked.bindings.symbol(symbol).kind == 1 && !generic_template(checked, symbol) && !recover_foreign_source(checked, symbol);
}

bool recover_static_method(CheckedIndex checked, SymbolId function) {
	var plan = checked_source_plan(checked, function); if (plan.origin.index < 1 || plan.concrete.index != function.index) return false;
	var origin = checked.bindings.symbol(plan.origin);
	bool finalizer = origin.kind == 12 && checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_name(origin.node), "deinit");
	bool getter = origin.kind == 18 && class_getter_plan_verified(checked, plan); var owner = origin.owner;
	if (getter) {
		var property = class_getter_property(checked, plan.origin);
		owner = checked.bindings.symbol(property).owner;
	}
	if (plan.concrete.index != function.index || plan.state != 2 || origin.kind != 11 && !finalizer && !getter || !recover_storage_class(checked, plan.enclosing) && (finalizer || getter || !error_storage_class(checked, plan.enclosing)) || owner.index != class_storage_origin(checked, plan.enclosing).index) return false;
	var declaration = checked.bindings.symbol(function); var parameters = checked.bindings.program.arena.get_list_parameters(declaration.node);
	if (checked.bindings.program.arena.list_count(parameters) < 1) return false;
	if (finalizer && (checked.bindings.program.arena.list_count(parameters) != 1 || plan.argument_count != 0 || checked.bindings.program.arena.get_node_return_type(declaration.node).index != 0 || checked.bindings.program.arena.get_node_throws_class(declaration.node).index != 0)) return false;
	var parameter = checked.bindings.program.arena.node_at(parameters, 0); var symbol = checked.node_symbols[parameter.index];
	return symbol.index > 0 && checked.bindings.symbol(symbol).kind == 7 && checked.bindings.symbol(symbol).owner.index == function.index && checked.symbol_types[symbol.index].index == plan.enclosing.index && checked.symbol_flags[symbol.index] == 2 && class_storage_receiver(checked, function) == symbol.index;
}

bool recover_call_receiver(CheckedIndex checked, SymbolId function) { return recover_static_method(checked, function) && generic_verify(checked); }

bool recover_empty_constructor_verified(CheckedIndex checked, SymbolId function) {
	return recover_field_constructor_verified(checked, function);
}

bool recover_owner_function_source(CheckedIndex checked, SymbolId symbol) {
	if (symbol.index < 1 || symbol.index > checked.bindings.symbol_count) return false; var declaration = checked.bindings.symbol(symbol); var node = declaration.node;
	if (!recover_caller_parameters(checked, symbol)) return false;
	if (declaration.kind != 1 || checked.bindings.program.arena.get_node_body(node).index == 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_parameters(node)) != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_where_clauses(node)) != 0 || !recover_member_attributes(checked, node)) return false;
	bool initializing = class_storage_initializing(checked, symbol); var kind = checked.bindings.program.arena.kind(node);
	if (initializing) {
		var plan = checked_source_plan(checked, symbol);
		if (plan.concrete.index != symbol.index || !recover_storage_class(checked, plan.enclosing) && !error_storage_class(checked, plan.enclosing) || !recover_empty_constructor_verified(checked, symbol)) return false;
	}
	else {
		bool method = recover_static_method(checked, symbol);
		if (kind != SyntaxKind.FunctionDeclarationSyntax() && (!method || kind != SyntaxKind.LifecycleDeclarationSyntax())) return false;
		if (!method && (declaration.owner.index != 0 || generic_instance_for(checked, symbol) != 0 && !recover_closed_free_function(checked, symbol))) return false;
	}
	if (kind != SyntaxKind.FunctionDeclarationSyntax() && kind != SyntaxKind.LifecycleDeclarationSyntax()) return false;
	int ordinal = checked.symbol_signatures[symbol.index].index; if (ordinal < 1 || ordinal > checked.signature_count) return false; var signature = checked.signatures[ordinal - 1];
	if (signature.declaration.index != symbol.index || signature.callable.index != checked.symbol_types[symbol.index].index || signature.flags != checked.symbol_flags[symbol.index] || signature.dispatch != 0 || (signature.flags & ~(4 | 64)) != 0 || !checked_effect_signature_verified(checked, signature)) return false;
	if ((signature.flags & 64) != 0 && checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_name(node), "main")) return false;
	var shape = checked.types.row(signature.callable); if (shape.kind != 25 || shape.count < 1 || shape.count > 257 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_parameters(node)) != shape.count - 1) return false;
	int p = 0; while (p < shape.count) {
		var channel = checked.types.argument(checked.types, signature.callable, p);
		if (!recover_storage_channel(checked, channel.type, channel.flags, p == 0)) return false;
		p = p + 1;
	} return true;
}
