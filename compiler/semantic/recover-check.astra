// Independent source/Flow consumer. Never calls the builder or changes the
// CheckedIndex's pending obligations. Success is a control fact, not a TypeId.
bool recover_child(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, int child, SyntaxNodeId source, int function, int handler, int caught, bool[] seen, bool[] edges, int depth) {
	if (source.index == 0) return child == 0;
	if (depth > 192 || child < 1 || child > flow.node_count || seen[child - 1] || source.index < 1 || source.index >= len(checked.uses)) return false;
	seen[child - 1] = true; var row = flow.nodes[child - 1];
	if (row.source.index != source.index || row.function != function || row.handler != handler || row.caught != caught || row.first < 0 || row.count < 0 || row.first > flow.edge_count - row.count) return false;
	var kind = checked.bindings.program.arena.kind(source);
	if (row.kind < 20 && row.type.index != types.types[source.index].index) return false;
	if (row.kind >= 20 && row.kind != 25 && row.type.index != 14) return false;
	if (row.kind != 3 && row.kind != 21 && (row.b != 0 || row.c != 0)) return false;
	if (row.kind == 3 && row.c != 0) return false;
	if (row.kind != 4 && row.kind != 5 && row.kind != 8 && row.kind != 20 && row.kind != 24 && (row.count != 0 || row.first != 0)) return false;
	if (row.kind != 1 && row.kind != 3 && row.kind != 6 && row.kind != 12 && row.token.index != 0) return false;
	if (row.kind != 2 && row.kind != 4 && row.kind != 5 && row.kind != 6 && row.kind != 12 && row.kind != 25 && row.kind != 27 && row.symbol.index != 0) return false;
	if (row.kind == 1) {
		if (row.a != 0) return false;
		if (kind == SyntaxKind.TextLiteralExpressionSyntax()) return row.token.index == checked.bindings.program.arena.get_token_token(source).index && row.type.index == 15;
		if (kind != SyntaxKind.IntegerLiteralExpressionSyntax() && kind != SyntaxKind.BooleanLiteralExpressionSyntax()) return false;
		return row.token.index == checked.bindings.program.arena.get_token_literal(source).index && (type_integer(checked_kind(checked, row.type)) || checked_kind(checked, row.type) == 13);
	}
	if (row.kind == 2) {
		if (kind != SyntaxKind.NameExpressionSyntax() || row.a != 0 || row.symbol.index < 1 || row.symbol.index > checked.bindings.symbol_count) return false;
		var declaration = checked.bindings.symbol(row.symbol);
		return (declaration.kind == 7 || declaration.kind == 8) && declaration.owner.index == flow.functions[function - 1].symbol.index && row.symbol.index == checked_target(checked, source, checked.bindings.program.arena.get_token_identifier(source)).index && checked.symbol_flags[row.symbol.index] == 0 && row.type.index == checked.symbol_types[row.symbol.index].index;
	}
	if (row.kind == 3) {
		if (kind != SyntaxKind.BinaryExpressionSyntax() || row.token.index != checked.bindings.program.arena.get_token_operator_token(source).index || row.a < 1 || row.b < 1) return false;
		if (!checked.bindings.program.arena.token_is(row.token, "+") && !checked.bindings.program.arena.token_is(row.token, "-") && !checked.bindings.program.arena.token_is(row.token, "*") && !checked.bindings.program.arena.token_is(row.token, "==") && !checked.bindings.program.arena.token_is(row.token, "!=") && !checked.bindings.program.arena.token_is(row.token, "<") && !checked.bindings.program.arena.token_is(row.token, ">") && !checked.bindings.program.arena.token_is(row.token, "<=") && !checked.bindings.program.arena.token_is(row.token, ">=")) return false;
		if (!recover_child(flow, checked, types, row.a, checked.bindings.program.arena.get_node_left(source), function, handler, caught, seen, edges, depth + 1) || !recover_child(flow, checked, types, row.b, checked.bindings.program.arena.get_node_right(source), function, handler, caught, seen, edges, depth + 1)) return false;
		var left = flow.nodes[row.a - 1]; var right = flow.nodes[row.b - 1];
		if (left.type.index != right.type.index) return false;
		bool compare = checked.bindings.program.arena.token_is(row.token, "==") || checked.bindings.program.arena.token_is(row.token, "!=") || checked.bindings.program.arena.token_is(row.token, "<") || checked.bindings.program.arena.token_is(row.token, ">") || checked.bindings.program.arena.token_is(row.token, "<=") || checked.bindings.program.arena.token_is(row.token, ">=");
		int code = checked_kind(checked, left.type);
		if (code == 15 && !checked.bindings.program.arena.token_is(row.token, "==") && !checked.bindings.program.arena.token_is(row.token, "!=")) return false;
		if (!type_integer(code) && code != 13 && code != 15) return false;
		return compare && row.type.index == 13 || !compare && code != 15 && row.type.index == left.type.index;
	}
	if (row.kind == 4 || row.kind == 5) {
		if (row.a != 0 || row.symbol.index < 1 || row.symbol.index > checked.bindings.symbol_count) return false;
		var arguments = checked_call_arguments(checked, source);
		if (row.kind == 4) {
			if (kind != SyntaxKind.CallExpressionSyntax() || row.symbol.index != checked_target(checked, source, checked.bindings.program.arena.get_token_identifier(source)).index || checked.bindings.program.arena.get_node_receiver_place(source).index != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_arguments(source)) != 0) return false;
			int callee = flow.symbols[row.symbol.index]; if (callee < 1 || callee > flow.function_count) return false;
			var function_row = flow.functions[callee - 1];
			if (row.type.index != function_row.result.index || function_row.checked && !checked_effect_call_verified(checked, source) || !function_row.checked && checked.uses[source.index].deferred != 0) return false;
		} else {
			if (kind != SyntaxKind.HeapObjectConstructionSyntax() || row.symbol.index != checked_effect_class(checked, checked.bindings.program.arena.get_node_class_name(source)).index || !recover_error_shape(checked, row.symbol, 0) || checked_kind(checked, row.type) != 31 || checked.types.row(row.type).nominal.index != row.symbol.index || row.count != 1) return false;
			arguments = checked.bindings.program.arena.get_list_arguments(source);
		}
		if (row.count != checked.bindings.program.arena.list_count(arguments)) return false;
		int i = 0;
		while (i < row.count) {
			int at = row.first + i; if (edges[at]) return false; edges[at] = true;
			if (!recover_child(flow, checked, types, flow.edges[at], checked.bindings.program.arena.node_at(arguments, i), function, handler, caught, seen, edges, depth + 1)) return false;
			var argument = flow.nodes[flow.edges[at] - 1];
			if (row.kind == 5 && argument.type.index != 15) return false;
			if (row.kind == 4) {
				var signature = checked.signatures[checked.symbol_signatures[row.symbol.index].index - 1];
				if (argument.type.index != checked.types.argument(checked.types, signature.callable, i + 1).type.index) return false;
			}
			i = i + 1;
		}
		return true;
	}
	if (row.kind == 6) {
		if (kind != SyntaxKind.FieldAccessExpressionSyntax() || row.a != 0 || caught < 1 || caught > flow.node_count || row.type.index != 15 || !checked.bindings.program.arena.token_is(row.token, "message") || row.token.index != checked.bindings.program.arena.get_token_field_name(source).index) return false;
		return row.symbol.index == flow.nodes[caught - 1].symbol.index && row.symbol.index == types.borrows[source.index].index && types.members[source.index].index > 0;
	}
	if (row.kind == 8) {
		if (row.a != 0 || !recover_record_source(checked, source, row.type)) return false; var fields = checked.bindings.program.arena.get_list_fields(source); if (row.count != checked.bindings.program.arena.list_count(fields)) return false; int i = 0;
		while (i < row.count) {
			int at = row.first + i;
			if (edges[at]) return false;
			edges[at] = true;
			var field = checked.bindings.program.arena.node_at(fields, i);
			if (!recover_child(flow, checked, types, flow.edges[at], checked.bindings.program.arena.get_node_expression(field), function, handler, caught, seen, edges, depth + 1) || flow.nodes[flow.edges[at] - 1].type.index != types.types[field.index].index) return false;
			i = i + 1;
		} return true;
	}
	if (row.kind == 12) {
		if (kind != SyntaxKind.FieldAccessExpressionSyntax() || row.a != 0 || row.symbol.index < 1 || row.symbol.index > checked.bindings.symbol_count || row.token.index != checked.bindings.program.arena.get_token_field_name(source).index || row.symbol.index != recover_type_receiver(checked, source).index) return false;
		var declaration = checked.bindings.symbol(row.symbol); if ((declaration.kind != 7 && declaration.kind != 8) || declaration.owner.index != flow.functions[function - 1].symbol.index || checked.symbol_flags[row.symbol.index] != 0) return false;
		var receiver = checked.symbol_types[row.symbol.index]; int ordinal = recover_record_field(checked, receiver, row.token); if (ordinal < 0) return false; var record = checked.bindings.symbol(checked.types.row(receiver).nominal); var field = checked.bindings.program.arena.node_at(checked.bindings.program.arena.get_list_fields(record.node), ordinal); var symbol = checked.node_symbols[field.index]; return row.type.index == checked.symbol_types[symbol.index].index;
	}
	if (row.kind == 27) {
		if (kind != SyntaxKind.LocalDeclarationSyntax() && kind != SyntaxKind.InferredLocalDeclarationSyntax() && kind != SyntaxKind.StructLocalDeclarationSyntax() || row.symbol.index < 1 || row.symbol.index != checked.node_symbols[source.index].index || checked.bindings.symbol(row.symbol).kind != 8 || checked.bindings.symbol(row.symbol).owner.index != flow.functions[function - 1].symbol.index || !recover_copy_channel(checked, checked.symbol_types[row.symbol.index], checked.symbol_flags[row.symbol.index], false)) return false;
		return recover_child(flow, checked, types, row.a, checked.bindings.program.arena.get_node_initializer(source), function, handler, caught, seen, edges, depth + 1) && flow.nodes[row.a - 1].type.index == checked.symbol_types[row.symbol.index].index;
	}
	if (row.kind == 7) return kind == SyntaxKind.ParenthesizedExpressionSyntax() && recover_child(flow, checked, types, row.a, checked.bindings.program.arena.get_node_expression(source), function, handler, caught, seen, edges, depth + 1);
	if (row.kind == 20 || row.kind == 24) {
		if (row.kind == 20 && (kind != SyntaxKind.BlockStatementSyntax() || row.a != 0) || row.kind == 24 && kind != SyntaxKind.TryStatementSyntax()) return false;
		SyntaxListId children = {index = 0};
		if (row.kind == 20) children = checked.bindings.program.arena.get_list_statements(source);
		if (row.kind == 24) {
			children = checked.bindings.program.arena.get_list_catches(source);
			if (row.count == 0 || !recover_child(flow, checked, types, row.a, checked.bindings.program.arena.get_node_body(source), function, child, caught, seen, edges, depth + 1)) return false;
		}
		if (row.count != checked.bindings.program.arena.list_count(children)) return false;
		int i = 0;
		while (i < row.count) {
			int at = row.first + i; if (edges[at]) return false; edges[at] = true;
			if (!recover_child(flow, checked, types, flow.edges[at], checked.bindings.program.arena.node_at(children, i), function, handler, caught, seen, edges, depth + 1)) return false;
			i = i + 1;
		}
		return true;
	}
	if (row.kind == 21) {
		if (kind != SyntaxKind.IfStatementSyntax() || !recover_child(flow, checked, types, row.a, checked.bindings.program.arena.get_node_condition(source), function, handler, caught, seen, edges, depth + 1) || flow.nodes[row.a - 1].type.index != 13) return false;
		return recover_child(flow, checked, types, row.b, checked.bindings.program.arena.get_node_then_body(source), function, handler, caught, seen, edges, depth + 1) && recover_child(flow, checked, types, row.c, checked.bindings.program.arena.get_node_else_body(source), function, handler, caught, seen, edges, depth + 1);
	}
	if (row.kind == 22 || row.kind == 23) {
		if (row.kind == 22 && kind != SyntaxKind.ReturnStatementSyntax() || row.kind == 23 && kind != SyntaxKind.ThrowStatementSyntax()) return false;
		if (!recover_child(flow, checked, types, row.a, checked.bindings.program.arena.get_node_expression(source), function, handler, caught, seen, edges, depth + 1)) return false;
		if (row.kind == 23) return row.a == 0 && caught > 0 || row.a > 0 && flow.nodes[row.a - 1].kind == 5;
		return row.a == 0 && flow.functions[function - 1].result.index == 14 || row.a > 0 && flow.nodes[row.a - 1].type.index == flow.functions[function - 1].result.index;
	}
	if (row.kind == 25) {
		if (kind != SyntaxKind.CatchClauseSyntax()) return false;
		var bound_node = checked.bindings.program.arena.get_node_class_name(source); var bound_use = checked.uses[bound_node.index];
		if (kind != SyntaxKind.CatchClauseSyntax() || row.symbol.index < 1 || row.symbol.index != checked.node_symbols[source.index].index || checked.bindings.symbol(row.symbol).kind != 15 || row.type.index != bound_use.type.index || !recover_error_shape(checked, checked_effect_class(checked, checked.bindings.program.arena.get_node_class_name(source)), 0)) return false;
		return recover_child(flow, checked, types, row.a, checked.bindings.program.arena.get_node_body(source), function, handler, child, seen, edges, depth + 1);
	}
	if (row.kind == 26) return kind == SyntaxKind.CallStatementSyntax() && recover_child(flow, checked, types, row.a, checked.bindings.program.arena.get_node_call(source), function, handler, caught, seen, edges, depth + 1) && flow.nodes[row.a - 1].type.index == 14;
	return false;
}

bool recover_falls(RecoverFlowData flow, int id, int depth) {
	if (id == 0 || depth > 192) return true;
	var row = flow.nodes[id - 1];
	if (row.kind == 22 || row.kind == 23) return false;
	if (row.kind == 21) return recover_falls(flow, row.b, depth + 1) || recover_falls(flow, row.c, depth + 1);
	if (row.kind == 20) {
		int i = 0;
		while (i < row.count) {
			if (!recover_falls(flow, flow.edges[row.first + i], depth + 1)) return false;
			i = i + 1;
		}
	}
	if (row.kind == 24) {
		if (recover_falls(flow, row.a, depth + 1)) return true;
		int i = 0;
		while (i < row.count) {
			if (recover_falls(flow, flow.edges[row.first + i], depth + 1)) return true;
			i = i + 1;
		}
		return false;
	}
	if (row.kind == 25) return recover_falls(flow, row.a, depth + 1);
	return true;
}

bool recover_flow_verify(RecoverFlow flow) {
	if (flow.data.status != 0 || flow.data.limit < 1 || flow.data.limit > 8192 || flow.data.function_count < 1 || flow.data.function_count > flow.data.limit || flow.data.node_count < 1 || flow.data.node_count > flow.data.limit || flow.data.edge_count < 0 || flow.data.edge_count > flow.data.limit || len(flow.data.nodes) != flow.data.limit || len(flow.data.edges) != flow.data.limit || len(flow.data.functions) != flow.data.limit || len(flow.data.symbols) != flow.checked.bindings.symbol_count + 1 || !flow.checked.validate() || flow.checked.failed()) return false;
	if (!recover_types_verify(flow.types, flow.checked) || !recover_storage_verify(flow.storage, flow.checked, flow.data.symbols)) return false;
	var source = checked_effect_source_verify(flow.checked); if (source.status != 0) return false;
	var seen = new bool[flow.data.node_count]; var edges = new bool[flow.data.edge_count]; int expected = 0; int s = 1; int entries = 0;
	while (s <= flow.checked.bindings.symbol_count) {
		var declaration = flow.checked.bindings.symbol(type_symbol(s));
		if (declaration.kind == 4 && !recover_error_shape(flow.checked, type_symbol(s), 0) || declaration.kind == 11 || declaration.kind == 12 && !recover_error_shape(flow.checked, declaration.owner, 0)) return false;
		if (declaration.kind == 1) {
			if (!recover_function_source(flow.checked, type_symbol(s)) || expected >= flow.data.function_count || flow.data.symbols[s] != expected + 1) return false;
			var row = flow.data.functions[expected]; var sid = flow.checked.symbol_signatures[s]; var signature = flow.checked.signatures[sid.index - 1];
			if (row.symbol.index != s || row.signature.index != sid.index || row.result.index != flow.checked.types.argument(flow.checked.types, signature.callable, 0).type.index || row.error.index != signature.error.index || row.checked != ((signature.flags & 64) != 0)) return false;
			if (flow.checked.bindings.program.arena.token_is(declaration.token, "main")) {
				if (row.checked || row.result.index != 1 || flow.checked.types.row(signature.callable).count != 1) return false;
				entries = entries + 1;
			}
			if (!recover_child(flow.data, flow.checked, flow.types, row.body, flow.checked.bindings.program.arena.get_node_body(declaration.node), expected + 1, 0, 0, seen, edges, 0) || row.result.index != 14 && recover_falls(flow.data, row.body, 0)) return false;
			expected = expected + 1;
		} else {
			if (flow.data.symbols[s] != 0) return false;
		}
		s = s + 1;
	}
	if (expected != flow.data.function_count || entries != 1) return false;
	int i = 0; while (i < flow.data.node_count) {
		if (!seen[i]) return false;
		i = i + 1;
	}
	i = 0; while (i < flow.data.edge_count) {
		if (!edges[i]) return false;
		i = i + 1;
	}
	return true;
}
