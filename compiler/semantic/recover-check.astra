	return false;
}

bool recover_falls(RecoverFlowData flow, int id, int depth) {
	if (id == 0 || depth > 192) return true;
	var row = flow.nodes[id - 1];
	if (row.kind == 22 || row.kind == 23) return false;
	if (row.kind == 21) return recover_falls(flow, row.b, depth + 1) || recover_falls(flow, row.c, depth + 1);
	if (row.kind == 20) {
		int i = 0;
		while (i < row.count) {
			if (!recover_falls(flow, flow.edges[row.first + i], depth + 1)) return false;
			i = i + 1;
		}
	}
	if (row.kind == 24) {
		if (recover_falls(flow, row.a, depth + 1)) return true;
		int i = 0;
		while (i < row.count) {
			if (recover_falls(flow, flow.edges[row.first + i], depth + 1)) return true;
			i = i + 1;
		}
		return false;
	}
	if (row.kind == 25) return recover_falls(flow, row.a, depth + 1);
	return true;
}

bool recover_flow_verify(RecoverFlow flow) {
	if (flow.data.status != 0 || flow.data.limit < 1 || flow.data.limit > 8192 || flow.data.function_count < 1 || flow.data.function_count > flow.data.limit || flow.data.node_count < 1 || flow.data.node_count > flow.data.limit || flow.data.edge_count < 0 || flow.data.edge_count > flow.data.limit || len(flow.data.nodes) != flow.data.limit || len(flow.data.edges) != flow.data.limit || len(flow.data.functions) != flow.data.limit || len(flow.data.symbols) != flow.checked.bindings.symbol_count + 1 || len(flow.data.catch_owners) != len(flow.data.symbols) || !flow.checked.validate() || flow.checked.failed()) return false;
	if (!recover_types_verify(flow.types, flow.checked) || !recover_storage_verify(flow.storage, flow.checked, flow.data.symbols)) return false;
	var source = checked_effect_source_verify(flow.checked); if (source.status != 0 || !generic_verify(flow.checked)) return false;
	var seen = new bool[flow.data.node_count]; var edges = new bool[flow.data.edge_count]; var caught_symbols = new bool[len(flow.data.catch_owners)]; int expected = 0; int s = 1; int entries = 0;
	while (s <= flow.checked.bindings.symbol_count) {
		var declaration = flow.checked.bindings.symbol(type_symbol(s));
		if (declaration.kind == 4 && !recover_error_shape(flow.checked, type_symbol(s), 0) && !recover_storage_class(flow.checked, flow.checked.symbol_types[s]) && !error_storage_class(flow.checked, flow.checked.symbol_types[s]) || (declaration.kind == 11 || declaration.kind == 12) && !recover_error_shape(flow.checked, declaration.owner, 0) && !recover_storage_class(flow.checked, flow.checked.symbol_types[declaration.owner.index]) && !error_storage_class(flow.checked, flow.checked.symbol_types[declaration.owner.index])) return false;
		if (recover_runtime_function(flow.checked, type_symbol(s))) {
			if (!recover_function_source(flow.checked, type_symbol(s)) || expected >= flow.data.function_count || flow.data.symbols[s] != expected + 1) return false;
			var row = flow.data.functions[expected]; var sid = flow.checked.symbol_signatures[s]; var signature = flow.checked.signatures[sid.index - 1];
			if (row.symbol.index != s || row.signature.index != sid.index || row.result.index != flow.checked.types.argument(flow.checked.types, signature.callable, 0).type.index || row.error.index != signature.error.index || row.checked != ((signature.flags & 64) != 0)) return false;
			if (flow.checked.bindings.program.arena.token_is(declaration.token, "main")) {
				if (row.checked || row.result.index != 1 || flow.checked.types.row(signature.callable).count != 1) return false;
				entries = entries + 1;
			}
			if (!recover_child(flow.data, flow.checked, flow.types, row.body, flow.checked.bindings.program.arena.get_node_body(declaration.node), expected + 1, 0, 0, seen, edges, 0) || row.result.index != 14 && recover_falls(flow.data, row.body, 0)) return false;
			if (!recover_loop_verify(flow.data, row.body, 0, 0)) return false;
			expected = expected + 1;
		} else {
			if (flow.data.symbols[s] != 0) return false;
		}
		s = s + 1;
	}
	if (expected != flow.data.function_count || entries != 1) return false;
	int i = 0; while (i < flow.data.node_count) {
		if (!seen[i]) return false;
		var node = flow.data.nodes[i];
		if (node.kind == 25) {
			int symbol = node.symbol.index;
			if (symbol < 1 || symbol >= len(caught_symbols) || caught_symbols[symbol] || flow.data.catch_owners[symbol] != i + 1) return false;
			caught_symbols[symbol] = true;
		}
		i = i + 1;
	}
	i = 0; while (i < flow.data.edge_count) {
		if (!edges[i]) return false;
		i = i + 1;
	}
	i = 0; while (i < len(caught_symbols)) {
		if (!caught_symbols[i] && flow.data.catch_owners[i] != 0) return false;
		i = i + 1;
	}
	return recover_fields_verify(flow.fields, flow.checked, flow.storage, flow.data) && recover_array_places_verified(flow) && recover_payload_calls_verified(flow) && recover_literal_string_results(flow.data);
}
