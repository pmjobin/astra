// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Foreign calls retain the original declaration and every explicit AST input.
// No ordinary Astra body, error result, hidden receiver or owner is fabricated.
bool recover_foreign_source(CheckedIndex checked, SymbolId symbol) {
	if (checked_c_text_signature(checked, symbol) || checked_c_counted_signature(checked, symbol, true)) return true;
	if (!checked.field_effects || symbol.index < 1 || symbol.index > checked.bindings.symbol_count) return false;
	var declaration = checked.bindings.symbol(symbol);
	return declaration.kind == 1 && declaration.owner.index == 0 && checked.bindings.program.arena.kind(declaration.node) == SyntaxKind.FunctionDeclarationSyntax() && checked.bindings.program.arena.get_token_extern_keyword(declaration.node).index != 0 && checked_c_scalar_abi_signature(checked, symbol, true);
}

bool recover_foreign_counted(CheckedIndex checked, TypeId type) { return type.index == 15 || checked_c_byte_buffer(checked, type); }

bool recover_foreign_call(CheckedIndex checked, SyntaxNodeId source, SymbolId symbol, TypeId result) {
	if (checked.bindings.program.arena.kind(source) != SyntaxKind.CallExpressionSyntax() || !recover_foreign_source(checked, symbol)) return false;
	var syntax = checked.bindings.program.arena.call_expression(source);
	if (syntax.f_signal_emission || syntax.f_receiver_place.index != 0 || syntax.f_receiver.index != 0 || checked.bindings.program.arena.list_count(syntax.f_qualifier_arguments) != 0 || checked.bindings.program.arena.list_count(syntax.f_type_arguments) != 0 || checked_target(checked, source, syntax.f_identifier).index != symbol.index) return false;
	var signature = checked.signatures[checked.symbol_signatures[symbol.index].index - 1];
	var channel = checked.types.argument(checked.types, signature.callable, 0);
	var use = checked.uses[source.index];
	if (channel.type.index != result.index || use.type.index != result.index || use.flags != 0 || use.deferred != 0 && use.deferred != 17 && use.deferred != 19) return false;
	int count = checked.bindings.program.arena.list_count(syntax.f_arguments);
	if (checked.types.row(signature.callable).count != count + 1) return false;
	int p = 0;
	while (p < count) {
		var argument = checked.bindings.program.arena.node_at(syntax.f_arguments, p);
		var input = checked.types.argument(checked.types, signature.callable, p + 1);
		var value = checked.uses[argument.index];
		if (value.type.index != input.type.index || value.deferred != 0 && value.deferred != 17 && value.deferred != 19 || (value.flags & 4) != 0) return false;
		p = p + 1;
	}
	return true;
}

// Value opcodes and structured statements occupy separate explicit ranges.
// Adding an operation never turns an arbitrary statement into a value.
bool recover_value_kind(int kind) {
	return kind > 0 && kind < 20 || kind == 50 || kind == 51 || kind == 52 || kind == 53 || kind == 54 || kind == 55 || kind == 56 || kind == 57 || kind == 58 || kind == 62 || kind == 66 || kind == 67 || kind == 68 || kind == 69 || kind == 70;
}

bool recover_constructor_kind(int kind) { return kind == 11 || kind == 67; }

bool recover_error_new_kind(int kind) { return kind == 5 || kind == 67; }
