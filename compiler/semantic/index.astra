// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// This owner retains the original typed program. All edges below are indices.
class BindingIndex {
	owned SyntaxProgram program;
	owned BindingNames names;
	private owned BindingSymbol[] symbols;
	private owned BindingScope[] scopes;
	private owned BindingReference[] references;
	private owned BindingWork[] work;
	private int work_count;
	private owned BindingWork[] bodies;
	private int body_count;
	private owned int[] pending_errors;
	private owned SyntaxSpan[] pending_spans;
	private bool checking_local;
	int symbol_count;
	int scope_count;
	int reference_count;
	private owned ScopeId[] unit_scopes;
	private owned SymbolId[] node_symbols;
	private owned ScopeId[] node_scopes;
	private owned bool[] visited;
	private owned bool[] slot_counts;
	SyntaxSpan error_span;
	int error_message;
	// A deterministic failure checkpoint exercises partially constructed owners.
	int stop_after;
	init(owned SyntaxProgram program, int stop_after) {
		this.program = move program;
		var names = new BindingNames();
		this.names = move names;
		this.symbols = new BindingSymbol[16];
		this.scopes = new BindingScope[16];
		this.references = new BindingReference[16];
		this.work = new BindingWork[16];
		this.work_count = 0;
		this.bodies = new BindingWork[16];
		this.body_count = 0;
		this.pending_errors = new int[this.program.arena.node_count + 1];
		this.pending_spans = new SyntaxSpan[this.program.arena.node_count + 1];
		this.checking_local = false;
		this.symbol_count = 0;
		this.scope_count = 0;
		this.reference_count = 0;
		this.unit_scopes = new ScopeId[this.program.arena.source_count + 1];
		this.node_symbols = new SymbolId[this.program.arena.node_count + 1];
		this.node_scopes = new ScopeId[this.program.arena.node_count + 1];
		this.visited = new bool[this.program.arena.node_count + 1];
		this.slot_counts = new bool[this.program.arena.node_count + 1];
		this.error_span = syntax_empty_span();
		this.error_message = 0;
		this.stop_after = stop_after;
	}
	bool failed() {
		return this.error_message != 0;
	}
	BindingSymbol symbol(SymbolId id) {
		assert_that(id.index > 0 && id.index <= this.symbol_count);
		return this.symbols[id.index - 1];
	}
	BindingScope scope(ScopeId id) {
		assert_that(id.index > 0 && id.index <= this.scope_count);
		return this.scopes[id.index - 1];
	}
	BindingReference reference(int index) {
		assert_that(index > 0 && index <= this.reference_count);
		return this.references[index - 1];
	}
	// The checked layer may complete only the original deferred edge. It must
	// supply the exact receiver declaration for member/initializer selections.
	// Keep its source/token/node/scope and maintain the existing reverse lists.
	bool complete_reference(int number, SymbolId target, SymbolId receiver) {
		if (number <= 0 || number > this.reference_count || target.index <= 0 || target.index > this.symbol_count) {
			return false;
		}
		var edge = this.reference(number);
		var symbol = this.symbol(target);
		if (edge.state_code != 5 || edge.target.index != 0) { return false; }
		if (edge.reason == 1 || edge.reason == 3) {
			if (symbol.owner.index != receiver.index || receiver.index == 0 || symbol.kind != 6) { return false; }
		} else {
			if (edge.reason != 7 || target.index != edge.alternative.index || (symbol.kind != 8 && symbol.kind != 7)) { return false; }
		}
		if (!this.accessible(target, edge.scope)) { return false; }
		edge.state_code = 1;
		edge.reason = 0;
		edge.target = target;
		edge.next_reference = symbol.first_reference;
		symbol.first_reference = number;
		this.symbols[target.index - 1] = symbol;
		this.references[number - 1] = edge;
		return true;
	}
	ScopeId scope_for_node(SyntaxNodeId node) {
		assert_that(node.index > 0 && node.index < len(this.node_scopes));
		return this.node_scopes[node.index];
	}
	void fail(SyntaxSpan span, string message) throws Error {
		if (!this.failed()) {
			this.error_span = span;
			this.error_message = this.names.intern(message);
		}
	}
	void duplicate(SyntaxSpan span, string message, SymbolId previous) throws Error {
		var old = this.symbol(previous);
		var output = new Utf8ByteBuilder();
		source_append_text(output, message);
		if (span.source.index != old.span.source.index) {
			var previous_span = this.program.arena.source_span(old.span);
			var location = previous_span.location();
			var path = previous_span.path();
			source_append_text(output, "\nprevious declaration: ");
			source_append_text(output, path.text);
			source_append_text(output, ":");
			append_int(output, location.line);
			source_append_text(output, ":");
			append_int(output, location.column);
		}
		var text = output.snapshot();
		this.fail(span, text.text);
	}
	ScopeId new_scope(ScopeId parent, SymbolId owner, SyntaxNodeId node, SyntaxNodeId unit, int kind, int namespace_name) {
		if (this.scope_count == len(this.scopes)) {
			var replacement = new BindingScope[syntax_grown_capacity(len(this.scopes), this.scope_count + 1)];
			int i = 0;
			while (i < this.scope_count) {
				replacement[i] = this.scopes[i];
				i = i + 1;
			}
			swap(this.scopes, replacement);
		}
		BindingScope record = {
			parent = parent, owner = owner, node = node, unit = unit, kind = kind, namespace_name = namespace_name
		};
		this.scopes[this.scope_count] = record;
		this.scope_count = this.scope_count + 1;
		ScopeId result = {
			index = this.scope_count
		};
		return result;
	}
	ScopeId child_scope(ScopeId parent, SymbolId owner, SyntaxNodeId node, int kind) {
		var outer = this.scope(parent);
		return this.new_scope(parent, owner, node, outer.unit, kind, outer.namespace_name);
	}
	SymbolId declaration(SyntaxNodeId node, SyntaxTokenId token, ScopeId scope, SymbolId owner, int kind, int domain, bool global) throws Error {
		SymbolId absent = {
			index = 0
		};
		if (this.failed() || token.index == 0) {
			return absent;
		}
		var span = this.program.arena.token_span(token);
		var name = this.program.arena.token_message(token);
		if (name.text.byte_length == 0 || span.start == span.end || !this.program.arena.valid_span(span)) {
			this.fail(span, "empty or malformed declaration");
			return absent;
		}
		if (owner.index != 0 && domain == 4) {
			var parent = this.symbol(owner);
			if (kind == 12 && parent.kind == 3) {
				this.fail(this.program.arena.header(node).span, "struct lifecycle members are unsupported");
				return absent;
			}
			if (parent.kind == 4 && (name.text == "init" || name.text == "deinit") && (kind == 6 || kind == 11 || kind == 14)) {
				var output = new Utf8ByteBuilder();
				source_append_text(output, "class lifecycle name '");
				source_append_text(output, name.text);
				source_append_text(output, "' is reserved; ");
				if (kind == 6) {
					source_append_text(output, "fields cannot use it");
				} else {
					if (kind == 14) {
						source_append_text(output, "properties cannot use it");
					} else {
						source_append_text(output, "lifecycle declarations have no result type");
					}
				}
				var message = output.snapshot();
				this.fail(span, message.text);
				return absent;
			}
		}
		var context = this.scope(scope);
		var canonical = this.canonical_name(scope, owner, global, name.text);
		int map_scope = scope.index;
		if (global) {
			map_scope = 0;
		}
		var lookup_name = binding_lookup_name(name.text, canonical.text, global);
		var key = binding_key(map_scope, domain, lookup_name.text);
		SymbolId previous = {
			index = this.names.get(key.text)
		};
		// C0 forbids hiding active lexical locals or parameters, but permits
		// equal names in sibling blocks. Global values are a separate layer.
		if (kind == 7 || kind == 8 || kind == 15) {
			previous = this.lexical(scope, name.text, domain);
		}
		if ((kind == 8 || kind == 15) && previous.index == 0) {
			previous = this.root_constant(name.text);
			if (previous.index != 0 && !this.accessible(previous, scope)) {
				previous.index = 0;
			}
		}
		if (global && domain == 1 && (binding_builtin(name.text) || previous.index != 0)) {
			int parameters = 0;
			if (this.program.arena.kind(node) == SyntaxKind.ClassDeclarationSyntax() || this.program.arena.kind(node) == SyntaxKind.StructDeclarationSyntax()) {
				parameters = this.program.arena.list_count(this.program.arena.get_list_type_parameters(node));
			}
			if (kind == 5 || (parameters > 0 && (kind == 3 || kind == 4))) {
				var output = new Utf8ByteBuilder();
				if (kind == 4) {
					source_append_text(output, "duplicate or conflicting generic Class definition");
				} else {
					if (kind == 5) {
						source_append_text(output, "duplicate or conflicting enum type '");
					} else {
						source_append_text(output, "duplicate or conflicting generic struct type '");
					}
					source_append_text(output, canonical.text);
					source_append_text(output, "'");
				}
				var message = output.snapshot();
				bool locate_previous = false;
				if (kind == 3 && previous.index != 0) {
					var old = this.symbol(previous);
					locate_previous = old.kind == 3 && this.program.arena.list_count(this.program.arena.get_list_type_parameters(old.node)) > 0;
				}
				if (locate_previous) {
					this.duplicate(span, message.text, previous);
				} else {
					this.fail(span, message.text);
				}
				return absent;
			}
		}
		if (global && domain == 1 && binding_builtin(name.text)) {
			var output = new Utf8ByteBuilder();
			if (kind == 3) {
				source_append_text(output, "struct name '");
			} else {
				source_append_text(output, "class name '");
			}
			source_append_text(output, canonical.text);
			source_append_text(output, "' conflicts with builtin type");
			var message = output.snapshot();
			this.fail(span, message.text);
			return absent;
		}
		if (previous.index != 0 && domain == 4 && kind != 16) {
			this.member_duplicate(span, name.text, kind, owner, previous);
			return absent;
		}
		if (previous.index != 0 && kind != 10) {
			var old = this.symbol(previous);
			var output = new Utf8ByteBuilder();
			if (kind == 1) {
				source_append_text(output, "duplicate function '");
			} else {
				if (kind == 2) {
					source_append_text(output, "duplicate constant or callable '");
				} else {
					if (kind == 7) {
						source_append_text(output, "duplicate parameter '");
					} else {
						if (kind == 8 || kind == 15) {
							if (old.kind == 7) {
								source_append_text(output, "local '");
							} else {
								source_append_text(output, "duplicate local '");
							}
						} else {
							if (kind == 9) {
								source_append_text(output, "duplicate type parameter '");
							} else {
								if (kind == 3) {
									source_append_text(output, "duplicate struct type '");
								} else {
									source_append_text(output, "duplicate class type '");
								}
							}
						}
					}
				}
			}
			source_append_text(output, lookup_name.text);
			source_append_text(output, "'");
			if (kind == 1) {
				source_append_text(output, "; overloading is not implemented");
			}
			if ((kind == 8 || kind == 15) && old.kind == 7) {
				source_append_text(output, " conflicts with parameter");
			}
			if (kind == 7 && old.kind == 2) {
				var special = new Utf8ByteBuilder();
				source_append_text(special, "parameter '");
				source_append_text(special, name.text);
				source_append_text(special, "' conflicts with a visible constant");
				var message = special.snapshot();
				this.fail(span, message.text);
			} else {
				var message = output.snapshot();
				this.duplicate(span, message.text, previous);
			}
			return absent;
		}
		if (this.checking_local) {
			return absent;
		}
		if (this.symbol_count == len(this.symbols)) {
			var replacement = new BindingSymbol[syntax_grown_capacity(len(this.symbols), this.symbol_count + 1)];
			int i = 0;
			while (i < this.symbol_count) {
				replacement[i] = this.symbols[i];
				i = i + 1;
			}
			swap(this.symbols, replacement);
		}
		bool restricted = this.program.arena.header(node).module_internal;
		BindingSymbol record = {
			node = node, token = token, span = span, scope = scope, owner = owner, name = this.names.intern(name.text), canonical = this.names.intern(canonical.text), kind = kind, domain = domain, restricted = restricted, first_reference = 0
		};
		this.symbols[this.symbol_count] = record;
		this.symbol_count = this.symbol_count + 1;
		SymbolId result = {
			index = this.symbol_count
		};
		if (kind != 10) {
			this.names.put(key.text, result.index);
		}
		if (node.index != 0 && kind != 9 && kind != 10) {
			this.node_symbols[node.index] = result;
		}
		if (this.stop_after > 0 && this.symbol_count == this.stop_after) {
			this.fail(span, "injected partial binding construction");
		}
		return result;
	}
	SymbolId lexical(ScopeId scope, string name, int domain) throws Error {
		var current = scope;
		while (current.index != 0) {
			var context = this.scope(current);
			if (context.kind <= 2) {
				break;
			}
			var key = binding_key(current.index, domain, name);
			int found = this.names.get(key.text);
			if (found != 0) {
				SymbolId result = {
					index = found
				};
				return result;
			}
			current = context.parent;
		}
		SymbolId absent = {
			index = 0
		};
		return absent;
	}
	SymbolId lexical_at(ScopeId scope, string name, int domain, SyntaxSpan origin) throws Error {
		var current = scope;
		while (current.index != 0) {
			var context = this.scope(current);
			if (context.kind <= 2) {
				break;
			}
			var key = binding_key(current.index, domain, name);
			SymbolId found = {
				index = this.names.get(key.text)
			};
			if (found.index != 0) {
				var symbol = this.symbol(found);
				bool visible = symbol.kind != 8 && symbol.kind != 15;
				visible = visible || symbol.span.source.index != origin.source.index || symbol.span.end <= origin.start;
				if (visible) {
					return found;
				}
			}
			current = context.parent;
		}
		SymbolId absent = {
			index = 0
		};
		return absent;
	}
	SymbolId root_constant(string name) throws Error {
		SymbolId absent = {
			index = 0
		};
		int i = 0;
		while (i < name.byte_length) {
			if (astra_host_text_byte(name, i) == 46) {
				return absent;
			}
			i = i + 1;
		}
		var key = binding_key(0, 2, name);
		SymbolId found = {
			index = this.names.get(key.text)
		};
		if (found.index != 0) {
			var value = this.symbol(found);
			if (value.kind == 2) {
				return found;
			}
		}
		return absent;
	}
	bool accessible(SymbolId symbol, ScopeId scope) {
		var value = this.symbol(symbol);
		var declaration = this.scope(value.scope);
		var use = this.scope(scope);
		return !value.restricted || declaration.namespace_name == use.namespace_name;
	}
	bool function_type(SyntaxNodeId type, ScopeId scope) throws Error {
		if (type.index == 0 || this.program.arena.kind(type) != SyntaxKind.GenericTypeApplicationSyntax()) {
			return false;
		}
		if (this.program.arena.get_token_namespace_qualifier(type).index != 0) {
			return false;
		}
		var token = this.program.arena.get_token_identifier(type);
		var name = this.program.arena.token_message(token);
		if (name.text == "Fn") {
			return true;
		}
		if (name.text != "Callback") {
			return false;
		}
		var context = this.scope(scope);
		var selected = this.resolve(this.unit_scope(context.unit), type, token, name.text, 1);
		return selected.state_code == 6;
	}
	int callee_category(SymbolId local, ScopeId scope) throws Error {
		var symbol = this.symbol(local);
		var kind = this.program.arena.kind(symbol.node);
		if (kind == SyntaxKind.InferredLocalDeclarationSyntax() || symbol.kind == 15) {
			return 2;
		}
		if (kind == SyntaxKind.ParameterSyntax() || kind == SyntaxKind.LocalDeclarationSyntax() || kind == SyntaxKind.StructLocalDeclarationSyntax()) {
			if (this.function_type(this.program.arena.get_node_type_name(symbol.node), scope)) {
				return 1;
			}
		}
		return 0;
	}
	BindingReference resolve(ScopeId scope, SyntaxNodeId node, SyntaxTokenId token, string name, int requested_domain) throws Error {
		int domain = requested_domain;
		if (domain == 5) {
			domain = 2;
		}
		SymbolId absent = {
			index = 0
		};
		BindingReference result = {
			node = node, token = token, span = this.program.arena.token_span(token), scope = scope, target = absent, alternative = absent, state_code = 2, reason = 0, domain = domain, next_reference = 0
		};
		if (domain == 3) {
			var key = binding_key(0, 3, name);
			ScopeId space = {
				index = this.names.get(key.text)
			};
			if (space.index != 0) {
				var context = this.scope(space);
				result.target = context.owner;
				result.state_code = 1;
			}
			return result;
		}
		var local = this.lexical_at(scope, name, domain, result.span);
		if (requested_domain == 5 && local.index != 0) {
			int category = this.callee_category(local, scope);
			var context = this.scope(scope);
			var global = this.resolve(this.unit_scope(context.unit), node, token, name, 5);
			global.scope = scope;
			// C0's free-call prepass preserves module ambiguity even for a
			// lexical Fn. A unique module callable can be superseded by Fn.
			if (global.state_code == 3 || global.state_code == 4) {
				return global;
			}
			if (category == 1) {
				result.target = local;
				result.state_code = 1;
				return result;
			}
			if (global.state_code == 1) {
				var symbol = this.symbol(global.target);
				if (symbol.kind == 1) {
					if (category == 2) {
						result.state_code = 5;
						result.reason = 7;
						result.alternative = local;
						return result;
					}
					return global;
				}
			}
		}
		if (local.index != 0) {
			result.target = local;
			result.state_code = 1;
			return result;
		}
		if (domain == 2 && requested_domain != 5) {
			var constant = this.root_constant(name);
			if (constant.index != 0) {
				result.target = constant;
				result.state_code = 1;
				if (!this.accessible(constant, scope)) {
					result.state_code = 4;
				}
				return result;
			}
		}
		var context = this.scope(scope);
		var space = this.names.text(context.namespace_name);
		bool qualified = false;
		int i = 0;
		while (i < name.byte_length) {
			if (astra_host_text_byte(name, i) == 46) {
				qualified = true;
			}
			i = i + 1;
		}
		var key = binding_key(0, domain, name);
		if (qualified) {
			result.target.index = this.names.get(key.text);
			if (result.target.index != 0) {
				var selected = this.symbol(result.target);
				var selected_context = this.scope(selected.scope);
				result.state_code = 1;
				if (selected.restricted && selected_context.namespace_name != context.namespace_name) {
					result.state_code = 4;
				}
			}
			return result;
		}
		var same_name = binding_qualified(space.text, name);
		var same_key = binding_key(0, domain, same_name.text);
		result.target.index = this.names.get(same_key.text);
		if (result.target.index != 0) {
			result.state_code = 1;
			return result;
		}
		if (context.unit.index != 0) {
			var imports = this.program.arena.get_list_imports(context.unit);
			i = 0;
			while (i < this.program.arena.list_count(imports)) {
				var imported = this.program.arena.token_message(this.program.arena.token_at(imports, i));
				var candidate_name = binding_qualified(imported.text, name);
				var candidate_key = binding_key(0, domain, candidate_name.text);
				SymbolId candidate = {
					index = this.names.get(candidate_key.text)
				};
				if (candidate.index != 0) {
					var symbol = this.symbol(candidate);
					var candidate_context = this.scope(symbol.scope);
					if (!symbol.restricted || candidate_context.namespace_name == context.namespace_name) {
						if (result.target.index != 0 && result.target.index != candidate.index) {
							result.alternative = candidate;
							result.state_code = 3;
							return result;
						}
						result.target = candidate;
					}
				}
				i = i + 1;
			}
		}
		if (result.target.index == 0) {
			result.target.index = this.names.get(key.text);
		}
		if (result.target.index != 0) {
			result.state_code = 1;
		} else {
			if (domain == 1 && (binding_builtin(name) || binding_type_constructor(name))) {
				result.state_code = 6;
			}
		}
		return result;
	}
	void add_reference(BindingReference record) {
		assert_that(record.state_code >= 1 && record.state_code <= 6);
		assert_that(record.state_code != 5 || (record.reason >= 1 && record.reason <= 7 && record.target.index == 0));
		if (this.reference_count == len(this.references)) {
			var replacement = new BindingReference[syntax_grown_capacity(len(this.references), this.reference_count + 1)];
			int i = 0;
			while (i < this.reference_count) {
				replacement[i] = this.references[i];
				i = i + 1;
			}
			swap(this.references, replacement);
		}
		var next = record;
		if (record.state_code == 1) {
			var symbol = this.symbol(record.target);
			next.next_reference = symbol.first_reference;
			symbol.first_reference = this.reference_count + 1;
			this.symbols[record.target.index - 1] = symbol;
		}
		this.references[this.reference_count] = next;
		this.reference_count = this.reference_count + 1;
	}
	void bind(SyntaxNodeId node, SyntaxTokenId token, ScopeId scope, int domain, string name, int reason, bool whole_span) throws Error {
		if (token.index == 0 || this.failed()) {
			return;
		}
		var result = this.resolve(scope, node, token, name, domain);
		if (reason != 0) {
			result.state_code = 5;
			result.reason = reason;
			result.target.index = 0;
		}
		if (whole_span) {
			result.span = this.program.arena.header(node).span;
		}
		this.add_reference(result);
		if (result.state_code == 1 || result.state_code >= 5) {
			return;
		}
		var output = new Utf8ByteBuilder();
		if (result.state_code == 3) {
			var first = this.symbol(result.target);
			var second = this.symbol(result.alternative);
			var first_name = this.names.text(first.canonical);
			var second_name = this.names.text(second.canonical);
			source_append_text(output, "ambiguous imported name '");
			source_append_text(output, name);
			source_append_text(output, "': '");
			source_append_text(output, first_name.text);
			source_append_text(output, "' and '");
			source_append_text(output, second_name.text);
			source_append_text(output, "'; qualify the reference");
		} else {
			if (result.state_code == 4) {
				var symbol = this.symbol(result.target);
				var owner_scope = this.scope(symbol.scope);
				var namespace_name = this.names.text(owner_scope.namespace_name);
				source_append_text(output, "internal declaration '");
				source_append_text(output, name);
				source_append_text(output, "' is accessible only within namespace '");
				source_append_text(output, namespace_name.text);
				source_append_text(output, "'");
			} else {
				if (domain == 1) {
					source_append_text(output, "unknown type '");
				} else {
					if (domain == 5) {
						source_append_text(output, "unknown function '");
					} else {
						source_append_text(output, "unknown name '");
					}
				}
				source_append_text(output, name);
				source_append_text(output, "'");
			}
		}
		if (result.state_code == 2 && domain != 1) {
			var context = this.scope(scope);
			if (context.kind == 6) {
				source_append_text(output, " in constant expression");
			}
		}
		var message = output.snapshot();
		this.fail(result.span, message.text);
	}
	void bind_token(SyntaxNodeId node, SyntaxTokenId token, ScopeId scope, int domain, int reason) throws Error {
		if (token.index == 0) {
			return;
		}
		var name = this.program.arena.token_message(token);
		this.bind(node, token, scope, domain, name.text, reason, false);
	}
	void push(SyntaxNodeId node, ScopeId scope, int action) {
		if (node.index == 0) {
			return;
		}
		if (this.work_count == len(this.work)) {
			var replacement = new BindingWork[syntax_grown_capacity(len(this.work), this.work_count + 1)];
			int i = 0;
			while (i < this.work_count) {
				replacement[i] = this.work[i];
				i = i + 1;
			}
			swap(this.work, replacement);
		}
		BindingWork record = {
			node = node, scope = scope, action = action
		};
		this.work[this.work_count] = record;
		this.work_count = this.work_count + 1;
	}
	void push_list(SyntaxListId list, ScopeId scope) {
		int i = this.program.arena.list_count(list);
		while (i > 0) {
			i = i - 1;
			this.push(this.program.arena.node_at(list, i), scope, 0);
		}
	}
	owned Utf8Message canonical_name(ScopeId scope, SymbolId owner, bool global, string name) throws Error {
		if (owner.index != 0 && !global) {
			var parent = this.symbol(owner);
			var prefix = this.names.text(parent.canonical);
			var result = binding_qualified(prefix.text, name);
			return move result;
		}
		var context = this.scope(scope);
		var space = this.names.text(context.namespace_name);
		var result = binding_qualified(space.text, name);
		return move result;
	}
	ScopeId unit_scope(SyntaxNodeId unit) {
		var header = this.program.arena.header(unit);
		return this.unit_scopes[header.span.source.index];
	}
	SymbolId header_declaration(SyntaxNodeId node, SyntaxTokenId token, ScopeId scope, SymbolId owner, int kind, int domain, bool global) throws Error {
		var result = this.declaration(node, token, scope, owner, kind, domain, global);
		// Headers provide forward lookup. Duplicate headers never mint an ID;
		// their diagnostic is delivered when C0 reaches that declaration phase.
		if (this.failed() && this.stop_after == 0 && (domain == 4 || kind == 7 || (global && domain == 2))) {
			if (this.pending_errors[node.index] == 0) {
				this.pending_errors[node.index] = this.error_message;
				this.pending_spans[node.index] = this.error_span;
			}
			this.error_message = 0;
			this.error_span = syntax_empty_span();
		}
		return result;
	}
	void deferred_body(SyntaxNodeId body, ScopeId scope, int priority) {
		if (body.index == 0) {
			return;
		}
		if (this.body_count == len(this.bodies)) {
			var replacement = new BindingWork[syntax_grown_capacity(len(this.bodies), this.body_count + 1)];
			int i = 0;
			while (i < this.body_count) {
				replacement[i] = this.bodies[i];
				i = i + 1;
			}
			swap(this.bodies, replacement);
		}
		BindingWork work = {
			node = body, scope = scope, action = priority
		};
		this.bodies[this.body_count] = work;
		this.body_count = this.body_count + 1;
	}
	void callable_body(SyntaxNodeId body, ScopeId scope) {
		var context = this.scope(scope);
		var owner = this.symbol(context.owner);
		int priority = 0;
		if (owner.kind == 11) {
			priority = 1;
		}
		if (owner.kind == 12) {
			priority = 2;
		}
		if (owner.kind == 18) {
			priority = 3;
		}
		this.deferred_body(body, scope, priority);
	}
	void lifecycle_arguments(SyntaxListId list, ScopeId scope) {
		int i = 0;
		while (i < this.program.arena.list_count(list)) {
			this.deferred_body(this.program.arena.node_at(list, i), scope, 2);
			i = i + 1;
		}
	}
	void collect_list(SyntaxListId list, ScopeId scope, SymbolId owner, int kind, int domain, bool global) throws Error {
		int i = 0;
		while (i < this.program.arena.list_count(list) && !this.failed()) {
			var node = this.program.arena.node_at(list, i);
			var declared_1 = this.header_declaration(node, this.program.arena.get_token_name(node), scope, owner, kind, domain, global);
			i = i + 1;
		}
	}
	void collect() throws Error {
		ScopeId absent_scope = {
			index = 0
		};
		SymbolId absent_symbol = {
			index = 0
		};
		SyntaxNodeId absent_node = {
			index = 0
		};
		int empty = this.names.intern("");
		var root = this.new_scope(absent_scope, absent_symbol, absent_node, absent_node, 0, empty);
		int i = 0;
		while (i < this.program.arena.list_count(this.program.units)) {
			var unit = this.program.arena.node_at(this.program.units, i);
			var namespace_token = this.program.arena.get_token_namespace_name(unit);
			var parent = root;
			var owner = absent_symbol;
			int namespace_name = empty;
			if (namespace_token.index != 0) {
				var name = this.program.arena.token_message(namespace_token);
				namespace_name = this.names.intern(name.text);
				var key = binding_key(0, 3, name.text);
				int existing = this.names.get(key.text);
				if (existing == 0) {
					owner = this.declaration(unit, namespace_token, root, absent_symbol, 10, 3, false);
					parent = this.new_scope(root, owner, unit, absent_node, 1, namespace_name);
					this.names.put(key.text, parent.index);
				} else {
					parent.index = existing;
					var context = this.scope(parent);
					owner = context.owner;
				}
			}
			var scope = this.new_scope(parent, owner, unit, unit, 2, namespace_name);
			var header = this.program.arena.header(unit);
			this.unit_scopes[header.span.source.index] = scope;
			this.node_scopes[unit.index] = scope;
			this.visited[unit.index] = true;
			i = i + 1;
		}
		// Match collect_modules: validate all imports before deeper declarations.
		i = 0;
		while (i < this.program.arena.list_count(this.program.units) && !this.failed()) {
			var unit = this.program.arena.node_at(this.program.units, i);
			var imports = this.program.arena.get_list_imports(unit);
			int n = 0;
			while (n < this.program.arena.list_count(imports) && !this.failed()) {
				var token = this.program.arena.token_at(imports, n);
				var name = this.program.arena.token_message(token);
				var key = binding_key(0, 3, name.text);
				int found = this.names.get(key.text);
				if (found == 0) {
					var output = new Utf8ByteBuilder();
					source_append_text(output, "unknown imported namespace '");
					source_append_text(output, name.text);
					source_append_text(output, "'; supply its source files explicitly");
					var message = output.snapshot();
					this.fail(this.program.arena.token_span(token), message.text);
				} else {
					ScopeId imported_scope = {
						index = found
					};
					var imported = this.scope(imported_scope);
					var header = this.program.arena.header(unit);
					var scope = this.unit_scopes[header.span.source.index];
					BindingReference reference = {
						node = unit, token = token, span = this.program.arena.token_span(token), scope = scope, target = imported.owner, alternative = absent_symbol, state_code = 1, reason = 0, domain = 3, next_reference = 0
					};
					this.add_reference(reference);
				}
				n = n + 1;
			}
			i = i + 1;
		}
		int part = 0;
		while (part < 10 && !this.failed()) {
			i = 0;
			while (i < this.program.arena.list_count(this.program.units) && !this.failed()) {
				var unit = this.program.arena.node_at(this.program.units, i);
				var scope = this.unit_scope(unit);
				var context = this.scope(scope);
				int phase = part;
				int kind = 4;
				int domain = 1;
				if (part == 2 || part == 5) {
					phase = 3;
				}
				if (part == 3 || part == 4) {
					phase = 2;
					kind = 3;
				}
				if (part == 6) {
					phase = 4;
					kind = 5;
				}
				if (part == 7) {
					phase = 6;
					kind = 1;
					domain = 2;
				}
				if (part == 8) {
					phase = 7;
					kind = 2;
					domain = 2;
				}
				if (part == 9) {
					phase = 8;
					kind = 16;
					domain = 4;
				}
				var list = this.phase_roots(unit, phase);
				int n = 0;
				while (n < this.program.arena.list_count(list) && !this.failed()) {
					var node = this.program.arena.node_at(list, n);
					bool selected = true;
					if (part >= 2 && part <= 5) {
						bool generic = this.program.arena.list_count(this.program.arena.get_list_type_parameters(node)) > 0;
						selected = generic == (part == 2 || part == 3);
					}
					if (selected) {
						var declared = this.header_declaration(node, this.program.arena.get_token_name(node), scope, context.owner, kind, domain, true);
					}
					n = n + 1;
				}
				i = i + 1;
			}
			part = part + 1;
		}
	}
	void generics(SyntaxNodeId node, ScopeId scope, SymbolId owner) throws Error {
		var list = this.program.arena.get_list_type_parameters(node);
		int i = 0;
		while (i < this.program.arena.list_count(list) && !this.failed()) {
			var token = this.program.arena.token_at(list, i);
			var name = this.program.arena.token_message(token);
			var outer = this.scope(scope);
			var visible = this.resolve(outer.parent, node, token, name.text, 1);
			bool builtin = binding_builtin(name.text);
			bool nominal = visible.state_code == 1;
			if (builtin || nominal) {
				var output = new Utf8ByteBuilder();
				if (this.program.arena.kind(node) == SyntaxKind.ClassDeclarationSyntax()) {
					source_append_text(output, "generic Class type parameter cannot shadow a builtin or nominal definition");
				} else {
					if (this.program.arena.kind(node) == SyntaxKind.EnumDeclarationSyntax()) {
						source_append_text(output, "duplicate or shadowing enum type parameter '");
						source_append_text(output, name.text);
						source_append_text(output, "'");
					} else {
						if (builtin) {
							source_append_text(output, "builtin type name '");
							source_append_text(output, name.text);
							source_append_text(output, "' is unavailable as a type parameter");
						} else {
							source_append_text(output, "type parameter '");
							source_append_text(output, name.text);
							source_append_text(output, "' cannot shadow an outer type in GEN-1");
						}
					}
				}
				var message = output.snapshot();
				this.fail(this.program.arena.token_span(token), message.text);
			} else {
				var declaration = this.declaration(node, token, scope, owner, 9, 1, false);
			}
			i = i + 1;
		}
	}
	void bind_type(SyntaxNodeId node, ScopeId scope) throws Error {
		var token = this.program.arena.get_token_identifier(node);
		var qualifier = this.program.arena.get_token_namespace_qualifier(node);
		if (qualifier.index != 0 && this.namespace_token(qualifier)) {
			this.bind_token(node, qualifier, scope, 3, 0);
		}
		if (this.function_type(node, scope)) {
			var builtin = this.resolve(scope, node, token, "Fn", 1);
			builtin.state_code = 6;
			builtin.target.index = 0;
			builtin.alternative.index = 0;
			this.add_reference(builtin);
			return;
		}
		var name = binding_type_name(this.program.arena, node);
		this.bind(node, token, scope, 1, name.text, 0, false);
	}
	bool namespace_token(SyntaxTokenId token) throws Error {
		if (token.index == 0) {
			return false;
		}
		var name = this.program.arena.token_message(token);
		var key = binding_key(0, 3, name.text);
		return this.names.get(key.text) != 0;
	}
	void bind_selection(SyntaxNodeId node, SyntaxTokenId receiver, SyntaxTokenId member, ScopeId scope, bool whole_span, bool aggregate) throws Error {
		bool qualified = false;
		if (!aggregate && receiver.index != 0) {
			var name = this.program.arena.token_message(receiver);
			var local = this.lexical(scope, name.text, 2);
			if (local.index == 0) {
				local = this.root_constant(name.text);
				if (local.index != 0 && !this.accessible(local, scope)) {
					local.index = 0;
				}
			}
			qualified = local.index == 0 && this.namespace_token(receiver);
		}
		if (qualified) {
			this.bind_token(node, receiver, scope, 3, 0);
			var space = this.program.arena.token_message(receiver);
			var name = this.program.arena.token_message(member);
			var full = binding_qualified(space.text, name.text);
			this.bind(node, member, scope, 2, full.text, 0, whole_span);
		} else {
			if (!aggregate && receiver.index != 0) {
				var name = this.program.arena.token_message(receiver);
				if (name.text != "this" && name.text != "base") {
					// A nominal receiver can be an enum/static construction. The
					// selection still waits for semantic classification.
					var value = this.resolve(scope, node, receiver, name.text, 2);
					if (value.state_code == 2) {
						var type = this.resolve(scope, node, receiver, name.text, 1);
						if (type.state_code != 2) {
							this.bind_token(node, receiver, scope, 1, 0);
						} else {
							this.bind_token(node, receiver, scope, 2, 0);
						}
					} else {
						this.bind_token(node, receiver, scope, 2, 0);
					}
				} else {
					this.bind_token(node, receiver, scope, 2, 2);
				}
			}
			this.bind_token(node, member, scope, 4, 1);
		}
	}
	void member_duplicate(SyntaxSpan span, string name, int kind, SymbolId owner, SymbolId previous) throws Error {
		var parent = this.symbol(owner);
		var owner_name = this.names.text(parent.canonical);
		var old = this.symbol(previous);
		var output = new Utf8ByteBuilder();
		if (kind == 13) {
			source_append_text(output, "duplicate enum variant '");
			source_append_text(output, owner_name.text);
			source_append_text(output, ".");
			source_append_text(output, name);
			source_append_text(output, "'");
		} else {
			if (kind == 17) {
				source_append_text(output, "duplicate enum payload field '");
				source_append_text(output, name);
				source_append_text(output, "'");
			} else {
				if (kind == 14) {
					source_append_text(output, "property/member name collision '");
					source_append_text(output, name);
					source_append_text(output, "' in '");
					source_append_text(output, owner_name.text);
					source_append_text(output, "'; fields, methods and properties share one namespace without overloading");
				} else {
					if (kind == 12) {
						source_append_text(output, "duplicate lifecycle member '");
						source_append_text(output, name);
						source_append_text(output, "' in class '");
						source_append_text(output, owner_name.text);
						source_append_text(output, "'; only one is permitted, without overloading");
					} else {
						if (kind == 11 && old.kind == 14) {
							source_append_text(output, "method/property name collision '");
							source_append_text(output, name);
							source_append_text(output, "' in '");
							source_append_text(output, owner_name.text);
							source_append_text(output, "'");
						} else {
							if (kind == 6) {
								source_append_text(output, "duplicate field '");
							} else {
								if (old.kind == 6) {
									source_append_text(output, "field/method name collision '");
								} else {
									source_append_text(output, "duplicate method '");
								}
							}
							source_append_text(output, name);
							source_append_text(output, "' in ");
							if (parent.kind == 3) {
								source_append_text(output, "struct '");
							} else {
								source_append_text(output, "class '");
							}
							source_append_text(output, owner_name.text);
							source_append_text(output, "'");
							if (kind == 11 && old.kind != 6) {
								source_append_text(output, "; overloading is not implemented");
							}
						}
					}
				}
			}
		}
		var message = output.snapshot();
		this.fail(span, message.text);
	}
	void caller_information(SyntaxNodeId node, ScopeId scope) throws Error {
		var target = this.program.arena.get_token_target(node);
		if (target.index == 0) {
			return;
		}
		var output = new Utf8ByteBuilder();
		this.program.arena.write_payload(target, output);
		var name = output.snapshot();
		var reference = this.resolve(scope, node, target, name.text, 2);
		bool valid = false;
		if (reference.state_code == 1) {
			var parameter = this.symbol(reference.target);
			valid = parameter.kind == 7 && parameter.span.end <= this.program.arena.header(node).span.start;
			if (valid) {
				valid = this.program.arena.get_node_caller_information(parameter.node).index == 0;
			}
		}
		if (!valid) {
			reference.state_code = 2;
			reference.target.index = 0;
			this.fail(this.program.arena.header(node).span, "CallerArgumentExpression must name an earlier required non-annotated parameter; unknown names, self, caller parameters, this and member paths are unsupported");
		}
		this.add_reference(reference);
	}
	void where_subject(SyntaxNodeId node, ScopeId scope) throws Error {
		var token = this.program.arena.get_token_type_parameter(node);
		var name = this.program.arena.token_message(token);
		var found = this.lexical(scope, name.text, 1);
		var reference = this.resolve(scope, node, token, name.text, 1);
		bool bound = false;
		if (found.index != 0) {
			var parameter = this.symbol(found);
			bound = parameter.kind == 9;
		}
		reference.target = found;
		reference.alternative.index = 0;
		reference.state_code = 2;
		if (bound) {
			reference.state_code = 1;
		}
		this.add_reference(reference);
		if (!bound) {
			var context = this.scope(scope);
			bool record = false;
			if (context.owner.index != 0) {
				var owner = this.symbol(context.owner);
				record = owner.kind == 3;
			}
			if (record) {
				this.fail(this.program.arena.token_span(token), "unknown owning record type parameter");
			} else {
				var output = new Utf8ByteBuilder();
				source_append_text(output, "unknown type parameter '");
				source_append_text(output, name.text);
				source_append_text(output, "' in where clause");
				var message = output.snapshot();
				this.fail(this.program.arena.token_span(token), message.text);
			}
		}
	}
	void where_subjects(SyntaxNodeId owner, ScopeId scope) throws Error {
		if (this.program.arena.kind(owner) == SyntaxKind.EnumDeclarationSyntax()) {
			return;
		}
		var clauses = this.program.arena.get_list_where_clauses(owner);
		int i = 0;
		while (i < this.program.arena.list_count(clauses) && !this.failed()) {
			var node = this.program.arena.node_at(clauses, i);
			this.visited[node.index] = true;
			this.node_scopes[node.index] = scope;
			this.where_subject(node, scope);
			i = i + 1;
		}
	}
	void constructor_selection(SyntaxNodeId node, ScopeId scope) throws Error {
		var receiver = this.program.arena.get_token_receiver(node);
		var member = this.program.arena.get_token_identifier(node);
		if (receiver.index == 0) {
			this.bind_token(node, member, scope, 4, 1);
			return;
		}
		this.bind_token(node, receiver, scope, 1, 0);
		if (this.failed()) {
			return;
		}
		var name = this.program.arena.token_message(receiver);
		var type = this.resolve(scope, node, receiver, name.text, 1);
		if (type.state_code == 1) {
			var symbol = this.symbol(type.target);
			if (symbol.kind == 4 && this.program.arena.kind(symbol.node) == SyntaxKind.ClassDeclarationSyntax()) {
				var member_scope = this.node_scopes[symbol.node.index];
				var member_name = this.program.arena.token_message(member);
				var selected = this.resolve(member_scope, node, member, member_name.text, 4);
				if (selected.state_code == 1) {
					var target = this.symbol(selected.target);
					if (target.kind == 12) {
						selected.scope = scope;
						this.add_reference(selected);
						return;
					}
				}
			}
		}
		this.bind_token(node, member, scope, 4, 1);
	}
	void contextual_count(SyntaxNodeId node, ScopeId scope) throws Error {
		var target = this.program.arena.get_node_target(node);
		var value = this.program.arena.get_node_expression(node);
		if (this.program.arena.kind(value) != SyntaxKind.BufferAllocationSyntax() || this.program.arena.kind(target) != SyntaxKind.FieldAccessExpressionSyntax()) {
			return;
		}
		if (this.program.arena.get_node_aggregate(target).index != 0) {
			return;
		}
		var receiver = this.program.arena.get_token_identifier(target);
