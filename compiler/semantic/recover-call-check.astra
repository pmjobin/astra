// Conditional call facts stay in CheckedIndex. This consumer binds their
// original declaration/result/argument channels; Core and SSA must separately
// discharge result initialization and every owner obligation.
// The Flow pass has already independently checked the complete generic map.
bool recover_call_source(CheckedIndex checked, SyntaxNodeId source, SymbolId target, TypeId result) {
	if (checked.bindings.program.arena.kind(source) == SyntaxKind.FieldAccessExpressionSyntax()) {
		return class_getter_call_verified(checked, source, target) && recover_function_source(checked, target) && checked.uses[source.index].type.index == result.index && checked.uses[source.index].flags == 0;
	}
	if (!syntax_call_labels_verified(checked.bindings.program.arena, source)) return false;
	var written_arguments = checked_call_written_arguments(checked, source);
	if (!checked_named_arguments_verified(checked, source, target, checked.bindings.program.arena.list_count(written_arguments))) return false;
	if (checked.bindings.program.arena.kind(source) != SyntaxKind.CallExpressionSyntax() || target.index < 1 || target.index > checked.bindings.symbol_count || checked_target(checked, source, checked.bindings.program.arena.get_token_identifier(source)).index != target.index) return false;
	var declaration = checked.bindings.symbol(target); int ordinal = checked.symbol_signatures[target.index].index;
	if (declaration.kind != 1 || ordinal < 1 || ordinal > checked.signature_count || !recover_function_source(checked, target)) return false;
	if (recover_static_method(checked, target)) {
		if (checked.generic_calls[source.index].index != target.index) return false;
		var arguments = checked_call_arguments(checked, source);
		if (checked.bindings.program.arena.list_count(arguments) < 1) return false;
		var receiver = checked.bindings.program.arena.node_at(arguments, 0);
		var owner = type_symbol(0);
		var receiver_kind = checked.bindings.program.arena.kind(receiver);
		if (receiver_kind == SyntaxKind.NameExpressionSyntax()) owner = checked_target(checked, receiver, checked.bindings.program.arena.get_token_identifier(receiver));
		if (receiver_kind == SyntaxKind.FieldAccessExpressionSyntax()) {
			var caller = recover_source_function(checked, source);
			if (caller.index == 0) return false;
			owner = recover_field_receiver(checked, receiver, caller);
		}
		var plan = checked_source_plan(checked, target);
		if (owner.index < 1 || checked.uses[receiver.index].type.index != plan.enclosing.index) return false;
		var binding = checked.bindings.symbol(owner);
		// A borrowed local needs a separate alias-root proof. Parameters retain
		// their declared borrow; an owned local retains its actual binder slot.
		int flags = checked.symbol_flags[owner.index];
		if (!(binding.kind == 7 && (flags == 0 || flags == 2 || flags == 4)) && !(binding.kind == 8 && flags == 4) && !recover_error_borrow_binding(checked, owner)) return false;
	} else {
		if (checked.bindings.program.arena.get_node_receiver_place(source).index != 0) return false;
		if (checked.bindings.program.arena.get_token_receiver(source).index != 0 && !recover_namespace_call_source(checked, source, target)) return false;
	}
	if (checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_arguments(source)) != 0 && !recover_closed_free_function(checked, target)) return false;
	var signature = checked.signatures[ordinal - 1]; var channel = checked.types.argument(checked.types, signature.callable, 0); var use = checked.uses[source.index];
	if (!checked_effect_signature_verified(checked, signature) || signature.declaration.index != target.index || signature.callable.index != checked.symbol_types[target.index].index || result.index != channel.type.index || use.type.index != result.index || use.flags != channel.flags || use.deferred != 0 && use.deferred != 17 && use.deferred != 19) return false;
	if ((signature.flags & 64) != 0 && !checked_effect_bound(checked, checked.bindings.program.arena.get_node_throws_class(declaration.node), signature.error)) return false;
	var arguments = checked_call_arguments(checked, source); int count = checked.bindings.program.arena.list_count(arguments); if (!recover_caller_arity(checked, source, target) || checked.types.row(signature.callable).count < count + 1) return false;
	int a = 0; while (a < count) {
		var argument = checked.bindings.program.arena.node_at(arguments, a);
		var input = checked.types.argument(checked.types, signature.callable, a + 1);
		var value = checked.uses[argument.index];
		if (value.type.index != input.type.index || value.deferred != 0 && value.deferred != 17 && value.deferred != 19 && !(value.deferred == 20 && recover_record_expression_source(checked, argument, input.type))) return false;
		a = a + 1;
	} return true;
}

// This path consumes a RecoverTypes table already independently verified by
// Flow. A pending caught-message argument neither changes CheckedIndex nor
// grants owned-result, consuming-argument, method or checked-effect permission.
bool recover_refined_call_source(RecoverTypes types, CheckedIndex checked, SyntaxNodeId source, SymbolId target, TypeId result) {
	if (checked.uses[source.index].type.index != 0) return recover_call_source(checked, source, target, result);
	if (!syntax_call_labels_verified(checked.bindings.program.arena, source)) return false;
	var written_arguments = checked_call_written_arguments(checked, source);
	if (!checked_named_arguments_verified(checked, source, target, checked.bindings.program.arena.list_count(written_arguments))) return false;
	if (checked.bindings.program.arena.kind(source) != SyntaxKind.CallExpressionSyntax() || checked.uses[source.index].deferred != 15 || checked.uses[source.index].flags != 0 || types.types[source.index].index != result.index || target.index < 1 || target.index > checked.bindings.symbol_count || checked_target(checked, source, checked.bindings.program.arena.get_token_identifier(source)).index != target.index) return false;
	var declaration = checked.bindings.symbol(target);
	int ordinal = checked.symbol_signatures[target.index].index;
	if (declaration.kind != 1 || declaration.owner.index != 0 || ordinal < 1 || ordinal > checked.signature_count || !recover_function_source(checked, target) || checked.bindings.program.arena.get_node_receiver_place(source).index != 0 || checked.bindings.program.arena.get_token_receiver(source).index != 0 || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_arguments(source)) != 0) return false;
	var signature = checked.signatures[ordinal - 1];
	var output = checked.types.argument(checked.types, signature.callable, 0);
	int code = checked_kind(checked, output.type);
	if (signature.flags != 0 || output.flags != 0 || output.type.index != result.index || code != 13 && code != 14 && !type_numeric(code) || !checked_effect_signature_verified(checked, signature)) return false;
	var arguments = checked_call_arguments(checked, source);
	int count = checked.bindings.program.arena.list_count(arguments);
	if (checked.types.row(signature.callable).count != count + 1) return false;
	bool recovered = false;
	int i = 0;
	while (i < count) {
		var argument = checked.bindings.program.arena.node_at(arguments, i);
		var channel = checked.types.argument(checked.types, signature.callable, i + 1);
		var use = checked.uses[argument.index];
		if (channel.flags != 0 || use.flags != 0 || types.types[argument.index].index != channel.type.index) return false;
		if (use.type.index == 0) {
			if (use.deferred != 12 || types.members[argument.index].index == 0 || types.borrows[argument.index].index == 0 || channel.type.index != 15) return false;
			recovered = true;
		} else {
			if (use.type.index != channel.type.index || use.deferred != 0 && use.deferred != 17 && use.deferred != 19 && !(use.deferred == 20 && recover_record_expression_source(checked, argument, channel.type))) return false;
		}
		i = i + 1;
	}
	return recovered;
}
