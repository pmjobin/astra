			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_right(node), depth);
		}
		case SyntaxKind.TextLiteralExpressionSyntax(): {
		}
		case SyntaxKind.TextMemberExpressionSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_receiver(node), depth);
		}
		case SyntaxKind.ThrowStatementSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_expression(node), depth);
		}
		case SyntaxKind.TryStatementSyntax(): {
		}
		case SyntaxKind.TypeNameSyntax(): {
		}
		case SyntaxKind.Utf8FactoryExpressionSyntax(): {
		}
		case SyntaxKind.VectorDotExpressionSyntax(): {
			var list_operands = index.bindings.program.arena.get_list_operands(node);
			int at_operands = 0;
			while (at_operands < index.bindings.program.arena.list_count(list_operands)) {
				checked_effect_source_visit(index, source, index.bindings.program.arena.node_at(list_operands, at_operands), depth);
				at_operands = at_operands + 1;
			}
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_destination(node), depth);
		}
		case SyntaxKind.VectorExtractExpressionSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_container(node), depth);
		}
		case SyntaxKind.VectorInitializerSyntax(): {
			var list_lanes = index.bindings.program.arena.get_list_lanes(node);
			int at_lanes = 0;
			while (at_lanes < index.bindings.program.arena.list_count(list_lanes)) {
				checked_effect_source_visit(index, source, index.bindings.program.arena.node_at(list_lanes, at_lanes), depth);
				at_lanes = at_lanes + 1;
			}
		}
		case SyntaxKind.VectorPrimitiveExpressionSyntax(): {
			var list_operands = index.bindings.program.arena.get_list_operands(node);
			int at_operands = 0;
			while (at_operands < index.bindings.program.arena.list_count(list_operands)) {
				checked_effect_source_visit(index, source, index.bindings.program.arena.node_at(list_operands, at_operands), depth);
				at_operands = at_operands + 1;
			}
		}
		case SyntaxKind.VectorReductionExpressionSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_operand(node), depth);
		}
		case SyntaxKind.VectorTypeSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_element_type(node), depth);
		}
		case SyntaxKind.WhereClauseSyntax(): {
		}
		case SyntaxKind.WhileStatementSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_condition(node), depth);
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_body(node), depth);
		}
		case SyntaxKind.WithStatementSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_initializer(node), depth);
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_body(node), depth);
		}
		case SyntaxKind.RecordExpressionSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_type_name(node), depth);
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_initializer(node), depth);
		}
		case SyntaxKind.ConditionalExpressionSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_condition(node), depth);
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_left(node), depth);
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_right(node), depth);
		}
		case SyntaxKind.CompoundAssignmentSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_target(node), depth);
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_expression(node), depth);
		}
		case SyntaxKind.LambdaExpressionSyntax(): {
			// Construction does not execute the body. Finite callable admission
			// and each consuming traversal must independently consume its effects.
		}
		case SyntaxKind.MatchExpressionSyntax(): {
			checked_effect_source_visit(index, source, index.bindings.program.arena.get_node_scrutinee(node), depth);
			var list_arms = index.bindings.program.arena.get_list_arms(node);
			int at_arms = 0;
			while (at_arms < index.bindings.program.arena.list_count(list_arms)) {
				checked_effect_source_visit(index, source, index.bindings.program.arena.node_at(list_arms, at_arms), depth);
				at_arms = at_arms + 1;
			}
		}
		else: { assert_that(false); }
	}
}
