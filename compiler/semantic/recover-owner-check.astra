// Source correspondence for owner operations, independent of the builder.
// These read-only value queries belong to recovered Flow. Source verification
// can run without linking the later Core owner-plan builder or its consumers.
int recover_owner_unwrap(RecoverFlowData flow, int id) {
	int current = id; int depth = 0; while (current > 0 && current <= flow.node_count && flow.nodes[current - 1].kind == 7 && depth < 192) {
		current = flow.nodes[current - 1].a;
		depth = depth + 1;
	} if (depth == 192) return 0; return current;
}

bool recover_owner_value(CheckedIndex checked, RecoverNode row) {
	if (row.kind == 113) return formatting_action(checked, row.source) == 2 && formatting_call_verified(checked, row.source);
	if (row.kind == 94) return range_collect_verified(checked, row.source) && checked_kind(checked, row.type) == 22;
	if (row.kind == 5 || row.kind == 9 || row.kind == 68 || row.kind == 10 || recover_constructor_kind(row.kind)) return true;
	if (row.kind != 4 && row.kind != 19 && row.kind != 69 && row.kind != 71 && row.kind != 77 && row.kind != 80) return false;
	return (checked.uses[row.source.index].flags & 4) != 0;
}

bool recover_owner_source(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, int depth) {
	var bindings = new u8[len(checked.symbol_types)];
	return recover_owner_source_with_bindings(flow, checked, types, row, function, handler, caught, seen, edges, bindings, depth);
}

bool recover_owner_source_with_bindings(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, u8[] bindings, int depth) {
	var source = row.source; var kind = checked.bindings.program.arena.kind(source);
	if (row.kind == 68) return row.a == 0 && row.symbol.index == 0 && class_storage_slot_initialization(checked, source, row.type) && recover_storage_slots(checked, row.type, 0);
	if (row.kind == 9) {
		if (kind != SyntaxKind.BufferAllocationSyntax() || checked_kind(checked, row.type) != 22 || !recover_storage_channel(checked, row.type, 4, false) || checked.bindings.program.arena.get_node_allocation_context(source).index != 0 || checked.bindings.program.arena.get_node_failure_call(source).index != 0 || row.symbol.index != 0) return false;
		return recover_child_with_bindings(flow, checked, types, row.a, checked.bindings.program.arena.get_node_count(source), function, handler, caught, seen, edges, bindings, depth + 1) && flow.nodes[row.a - 1].type.index == 1;
	}
	if (row.kind == 10) {
		if (kind != SyntaxKind.MoveExpressionSyntax() || row.a != 0 || row.symbol.index < 1 || row.symbol.index > checked.bindings.symbol_count || checked_target(checked, source, checked.bindings.program.arena.get_token_source(source)).index != row.symbol.index || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(source)) != 0) return false;
		var declaration = checked.bindings.symbol(row.symbol); return (declaration.kind == 7 || declaration.kind == 8 || enum_scoped_binding(checked, row.symbol)) && declaration.owner.index == flow.functions[function - 1].symbol.index && checked.symbol_flags[row.symbol.index] == 4 && row.type.index == checked.symbol_types[row.symbol.index].index && recover_storage_channel(checked, row.type, 4, false);
	}
	if (recover_constructor_kind(row.kind)) {
		if (!syntax_call_labels_verified(checked.bindings.program.arena, source) || !checked_named_arguments_verified(checked, source, row.symbol, row.count)) return false;
		if (kind != SyntaxKind.HeapObjectConstructionSyntax() || row.a != 0 || row.kind == 11 && !recover_storage_class(checked, row.type) || row.kind == 67 && !error_storage_class(checked, row.type) || checked.bindings.program.arena.get_node_allocation_context(source).index != 0 || checked.bindings.program.arena.get_bool_fallible(source) || row.symbol.index < 1 || row.symbol.index != checked_constructor(checked, row.type).index || !recover_field_constructor_source(checked, row.symbol)) return false;
		var arguments = checked_call_arguments(checked, source); if (row.count != checked.bindings.program.arena.list_count(arguments)) return false;
		var signature = checked.signatures[checked.symbol_signatures[row.symbol.index].index - 1]; if (checked.types.row(signature.callable).count != row.count + 2) return false;
		int i = 0;
		while (i < row.count) {
			int at = row.first + i; if (edges[at]) return false; edges[at] = true;
			if (!recover_child_with_bindings(flow, checked, types, flow.edges[at], checked.bindings.program.arena.node_at(arguments, i), function, handler, caught, seen, edges, bindings, depth + 1) || flow.nodes[flow.edges[at] - 1].type.index != checked.types.argument(checked.types, signature.callable, i + 2).type.index) return false;
			i = i + 1;
		}
		int callee = flow.symbols[row.symbol.index]; return callee > 0 && callee <= flow.function_count && !flow.functions[callee - 1].checked && flow.functions[callee - 1].result.index == 14;
	}
	if (row.kind == 13) return kind == SyntaxKind.NullPointerExpressionSyntax() && row.a == 0 && (checked_kind(checked, row.type) == 31 && (recover_storage_class(checked, row.type) || recover_storage_error(checked, row.type)) || recover_storage_shared(checked, row.type) || recover_storage_weak(checked, row.type) || recover_storage_pointer(checked, row.type));
	if (row.kind == 14) {
		if (kind != SyntaxKind.CallExpressionSyntax() || row.a != 0 || row.type.index != 1 || row.symbol.index != 0 || !checked_flow_intrinsic(checked, source) || row.count != 1) return false;
		var arguments = checked_call_arguments(checked, source); if (checked.bindings.program.arena.list_count(arguments) != 1 || edges[row.first]) return false; edges[row.first] = true;
		if (!recover_child_with_bindings(flow, checked, types, flow.edges[row.first], checked.bindings.program.arena.node_at(arguments, 0), function, handler, caught, seen, edges, bindings, depth + 1)) return false;
		var child = flow.nodes[flow.edges[row.first] - 1];
		return recover_array_type(checked, child.type) && (child.kind == 2 || child.kind == 17 || child.kind == 56 && range_slice_verified(checked, child.source));
	}
	return false;
}

bool recover_slot_source(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, int depth) {
	var bindings = new u8[len(checked.symbol_types)];
	return recover_slot_source_with_bindings(flow, checked, types, row, function, handler, caught, seen, edges, bindings, depth);
}

bool recover_slot_source_with_bindings(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, u8[] bindings, int depth) {
	if (row.a != 0 || row.b != 0 || row.c != 0 || row.symbol.index != 0 || row.count < 1) return false;
	var source = row.source; var kind = checked.bindings.program.arena.kind(source);
	SyntaxNodeId receiver = {index = 0}; SyntaxListId arguments = {index = 0}; int action = 0;
	if (row.kind == 69) {
		if (!class_storage_slot_call_present(checked, source) || row.token.index != checked.bindings.program.arena.get_token_identifier(source).index || checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_type_arguments(source)) != 0) return false;
		action = class_storage_slot_action(checked, source); receiver = checked.bindings.program.arena.get_node_receiver_place(source); arguments = checked_call_arguments(checked, source);
		int count = 2; if (action == 4) count = 3;
		if (row.count != count || checked.bindings.program.arena.list_count(arguments) != count - 1) return false;
	} else {
		if (row.kind != 70 || row.count != 1 || row.type.index != 1) return false;
		if (class_storage_slot_capacity(checked, source)) {
			receiver = checked.bindings.program.arena.get_node_aggregate(source);
			if (row.token.index != checked.bindings.program.arena.get_token_field_name(source).index) return false;
		} else {
			if (kind != SyntaxKind.CallExpressionSyntax() || !checked_flow_intrinsic(checked, source) || row.token.index != checked.bindings.program.arena.get_token_identifier(source).index || !checked.bindings.program.arena.token_is(row.token, "len")) return false;
			arguments = checked_call_arguments(checked, source);
			if (checked.bindings.program.arena.list_count(arguments) != 1) return false;
			receiver = checked.bindings.program.arena.node_at(arguments, 0);
		}
	}
	int i = 0;
	while (i < row.count) {
		int at = row.first + i; if (edges[at]) return false; edges[at] = true;
		var child_source = receiver; if (i > 0) child_source = checked.bindings.program.arena.node_at(arguments, i - 1);
		if (!recover_child_with_bindings(flow, checked, types, flow.edges[at], child_source, function, handler, caught, seen, edges, bindings, depth + 1)) return false;
		i = i + 1;
	}
	var type = flow.nodes[flow.edges[row.first] - 1].type;
	if (!recover_storage_slots(checked, type, 0)) return false;
	var element = checked.types.argument(checked.types, type, 0).type;
	if (row.kind == 69) {
		var result = type_id(14); if (action == 1) result = type_id(13); if (action == 3) result = element;
		if (row.type.index != result.index || action == 3 && checked.uses[source.index].flags != 4) return false;
		i = 1;
		while (i < row.count) {
			var expected = type_id(1); if (action == 2 || action == 4 && i == 2) expected = element;
			if (flow.nodes[flow.edges[row.first + i] - 1].type.index != expected.index) return false;
			i = i + 1;
		}
	}
	return true;
}

bool recover_slot_places_verified(RecoverFlow flow) {
	var work = new int[1]; work[0] = 8000000; int n = 0;
	while (n < flow.data.node_count) {
		var row = flow.data.nodes[n];
		if (row.kind == 69 || row.kind == 70) {
			int id = flow.data.edges[row.first]; int steps = 0;
			while (id > 0 && id <= flow.data.node_count && flow.data.nodes[id - 1].kind == 7 && steps < 192) {
				id = flow.data.nodes[id - 1].a;
				steps = steps + 1;
			}
			if (steps == 192) return false;
			if (id < 1 || id > flow.data.node_count) return false;
			var receiver = flow.data.nodes[id - 1];
			if (receiver.kind != 17 || receiver.function != row.function || checked_kind(flow.checked, receiver.type) != 23) return false;
			var field = flow.fields.facts[receiver.source.index];
			if (field.receiver.index != receiver.symbol.index || field.field.index < 1 || field.slot < 1 || field.slot > flow.storage.count || flow.storage.slots[field.slot - 1].symbol.index != field.receiver.index || flow.checked.symbol_types[field.field.index].index != receiver.type.index || (flow.checked.symbol_flags[field.field.index] & 4) == 0 || row.kind == 69 && !field.writable) return false;
			int i = 1;
			while (i < row.count) {
				int child = flow.data.edges[row.first + i];
				if (!recover_borrow_preserved(flow.data, child, field.receiver, work, 0) || !recover_payload_preserved(flow.data, child, field.aggregate, work, 0)) return false;
				i = i + 1;
			}
		}
		n = n + 1;
	}
	return true;
}
