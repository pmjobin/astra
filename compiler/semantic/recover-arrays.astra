// Array views retain a real lexical slot or a source-verified Class field.
// Element types and counts alone never grant backing, lifetime or writability.
struct RecoverArrayBound { bool constant; bool valid; int value; }

int recover_array_decimal(string text, int maximum) {
	if (maximum < 0 || text.byte_length == 0) return -1;
	int value = checked_decimal(text, maximum);
	// Truncating division in the legacy decimal helper's first-digit check
	// can admit a digit above a small limit. Source bounds require the exact
	// range postcondition independently of that parsing implementation.
	if (value < 0 || value > maximum) return -1;
	return value;
}

RecoverArrayBound recover_array_bound(CheckedIndex checked, SyntaxNodeId source, int maximum) {
	try {
		var node = source;
		int depth = 0;
		bool negative = false;
		bool walking = true;
		while (walking && depth < 192) {
			walking = false;
			if (checked.bindings.program.arena.kind(node) == SyntaxKind.ParenthesizedExpressionSyntax()) {
				node = checked.bindings.program.arena.get_node_expression(node);
				walking = true;
			} else {
				if (checked.bindings.program.arena.kind(node) == SyntaxKind.PrefixExpressionSyntax()) {
					var token = checked.bindings.program.arena.get_token_operator_token(node);
					if (checked.bindings.program.arena.token_is(token, "+") || checked.bindings.program.arena.token_is(token, "-")) {
						if (checked.bindings.program.arena.token_is(token, "-")) negative = !negative;
						node = checked.bindings.program.arena.get_node_operand(node);
						walking = true;
					}
				}
			}
			depth = depth + 1;
		}
		RecoverArrayBound result = {constant = false, valid = depth < 192, value = 0};
		if (checked.bindings.program.arena.kind(node) != SyntaxKind.IntegerLiteralExpressionSyntax()) return result;
		result.constant = true;
		var text = checked.bindings.program.arena.token_message(checked.bindings.program.arena.get_token_literal(node));
		int value = recover_array_decimal(text.text, maximum);
		result.valid = result.valid && value >= 0 && (!negative || value == 0);
		result.value = value;
		return result;
	} catch (Error error) {
		RecoverArrayBound invalid = {constant = false, valid = false, value = 0};
		return invalid;
	}
}

bool recover_array_static_index(CheckedIndex checked, TypeId type, SyntaxNodeId subscript) {
	if (checked_kind(checked, type) != 21) return true;
	var bound = recover_array_bound(checked, subscript, checked.types.row(type).extent - 1);
	return bound.valid;
}

// The hosted argv provider owns the descriptor table. These source channels
// are non-owning, read-only views of its actual builtin string descriptors.
bool recover_string_array(CheckedIndex checked, TypeId type) {
	if (!checked.field_effects || !checked.types.valid_id(type)) return false;
	var shape = checked.types.row(type);
	if (shape.kind != 22 || shape.count != 1 || shape.nominal.index != 0 || shape.extent != 0) return false;
	var element = checked.types.argument(checked.types, type, 0);
	return element.type.index == 15 && element.flags == 0;
}

bool recover_array_type(CheckedIndex checked, TypeId type) {
	int kind = checked_kind(checked, type);
	if (kind == 21) return recover_storage_fixed(checked, type);
	if (kind != 22) return false;
	var element = checked.types.argument(checked.types, type, 0);
	int code = checked_kind(checked, element.type);
	return element.flags == 0 && (type_numeric(code) || code == 13 || code == 30 && recover_storage_record(checked, element.type) || recover_string_array(checked, type) || recover_storage_pointer(checked, element.type));
}

SymbolId recover_array_root(RecoverFlow flow, int value, bool write) {
	int id = value;
	int depth = 0;
	while (id > 0 && id <= flow.data.node_count && flow.data.nodes[id - 1].kind == 7 && depth < 192) {
		id = flow.data.nodes[id - 1].a;
		depth = depth + 1;
	}
	if (id < 1 || id > flow.data.node_count || depth == 192) return type_symbol(0);
	var row = flow.data.nodes[id - 1];
	bool slots = !write && recover_storage_slots(flow.checked, row.type, 0);
	if (!recover_array_type(flow.checked, row.type) && !slots || write && recover_string_array(flow.checked, row.type)) return type_symbol(0);
	if (row.kind == 17) {
		var fact = flow.fields.facts[row.source.index];
		// Visibility is independently checked by recover_fields_verify. It
		// neither creates nor removes the declared owned-buffer obligation.
		if (fact.slot < 1 || fact.slot > flow.storage.count || fact.receiver.index != row.symbol.index || fact.field.index < 1 || flow.checked.symbol_types[fact.field.index].index != row.type.index || checked_kind(flow.checked, row.type) != 22 && !slots || write && !fact.writable) return type_symbol(0);
		int flags = flow.checked.symbol_flags[fact.field.index];
		if (slots) {
			if ((flags & ~(128 | 256)) != 4) return type_symbol(0);
		} else {
			if ((flags & ~256) != 4) return type_symbol(0);
		}
		return fact.receiver;
	}
	if (row.kind != 2 || row.symbol.index < 1 || row.symbol.index >= len(flow.storage.symbols)) return type_symbol(0);
	int slot = flow.storage.symbols[row.symbol.index];
	if (slot < 1 || slot > flow.storage.count) return type_symbol(0);
	var backing = flow.storage.slots[slot - 1];
	if (backing.symbol.index != row.symbol.index || backing.function != row.function || backing.type.index != row.type.index) return type_symbol(0);
	int kind = checked_kind(flow.checked, row.type);
	if (kind == 21 && !backing.parameter && (backing.flags == 0 || backing.flags == 2) && !backing.owner || kind == 22 && (backing.owner && backing.flags == 4 || backing.parameter && (backing.flags == 0 || backing.flags == 2) && !backing.owner)) return row.symbol;
	return type_symbol(0);
}

RecoverNode recover_build_array(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode initial, int depth) {
	var row = initial;
	var source = row.source;
	var kind = checked.bindings.program.arena.kind(source);
	if (kind == SyntaxKind.ConversionExpressionSyntax()) {
		row.kind = 54;
		row.token = checked.bindings.program.arena.get_token_keyword(source);
		row.a = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_operand(source), row.function, row.handler, row.caught, depth + 1);
	}
	if (checked_flow_index_kind(kind)) {
		row.kind = 55;
		row.a = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_container(source), row.function, row.handler, row.caught, depth + 1);
		row.b = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_subscript(source), row.function, row.handler, row.caught, depth + 1);
	}
	if (kind == SyntaxKind.ArrayInitializerSyntax() || kind == SyntaxKind.CallExpressionSyntax() && checked_slice_intrinsic(checked, source)) {
		row.kind = 57;
		SyntaxListId inputs = {index = 0};
		if (kind == SyntaxKind.ArrayInitializerSyntax()) inputs = checked.bindings.program.arena.get_list_elements(source);
		if (kind == SyntaxKind.CallExpressionSyntax()) {
			row.kind = 56;
			inputs = checked.bindings.program.arena.get_list_arguments(source);
		}
		int count = checked.bindings.program.arena.list_count(inputs);
		var children = new int[count];
		int p = 0;
		while (p < count && flow.status == 0) {
			children[p] = recover_build_node(flow, checked, types, checked.bindings.program.arena.node_at(inputs, p), row.function, row.handler, row.caught, depth + 1);
			p = p + 1;
		}
		row.first = flow.edge_count;
		row.count = count;
		p = 0;
		while (p < count && flow.status == 0) {
			int edge = flow.edge(children[p]);
			p = p + 1;
		}
	}
	if (kind == SyntaxKind.FieldAccessExpressionSyntax() && checked.bindings.program.arena.token_is(checked.bindings.program.arena.get_token_field_name(source), "byte_length")) {
		var aggregate = checked.bindings.program.arena.get_node_aggregate(source);
		var receiver = recover_type_receiver(checked, source);
		if (aggregate.index > 0 && checked.uses[aggregate.index].type.index == 15 || aggregate.index == 0 && receiver.index > 0 && checked.symbol_types[receiver.index].index == 15) {
			row.kind = 58;
			row.token = checked.bindings.program.arena.get_token_field_name(source);
			row.a = 0;
			row.symbol = receiver;
			if (aggregate.index > 0) {
				row.symbol = type_symbol(0);
				row.a = recover_build_node(flow, checked, types, aggregate, row.function, row.handler, row.caught, depth + 1);
			}
		}
	}
	if (kind == SyntaxKind.TextMemberExpressionSyntax()) {
		row.kind = 58;
		row.token = checked.bindings.program.arena.get_token_member(source);
		row.a = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_receiver(source), row.function, row.handler, row.caught, depth + 1);
	}
	if (kind == SyntaxKind.IndexedAssignmentSyntax()) {
		row.kind = 61;
		row.type = type_id(14);
		var target = checked.bindings.program.arena.get_node_target(source);
		if (!checked_flow_index_kind(checked.bindings.program.arena.kind(target))) {
			flow.defer(source);
			return row;
		}
		row.a = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_container(target), row.function, row.handler, row.caught, depth + 1);
		row.b = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_subscript(target), row.function, row.handler, row.caught, depth + 1);
		row.c = recover_build_node(flow, checked, types, checked.bindings.program.arena.get_node_expression(source), row.function, row.handler, row.caught, depth + 1);
	}
	return row;
}

bool recover_array_value_source(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, int depth) {
	var bindings = new u8[len(checked.symbol_types)];
	return recover_array_value_source_with_bindings(flow, checked, types, row, function, handler, caught, seen, edges, bindings, depth);
}

bool recover_array_value_source_with_bindings(RecoverFlowData flow, CheckedIndex checked, RecoverTypes types, RecoverNode row, int function, int handler, int caught, bool[] seen, bool[] edges, u8[] bindings, int depth) {
	var source = row.source;
	var kind = checked.bindings.program.arena.kind(source);
	if (row.kind == 54) return recover_integer_cast_source_with_bindings(flow, checked, types, row, function, handler, caught, seen, edges, bindings, depth);
	if (row.kind == 58) {
		if (row.b != 0 || row.c != 0 || row.type.index != 1 || !checked.bindings.program.arena.token_is(row.token, "byte_length")) return false;
		if (kind == SyntaxKind.TextMemberExpressionSyntax()) return row.symbol.index == 0 && row.token.index == checked.bindings.program.arena.get_token_member(source).index && recover_child_with_bindings(flow, checked, types, row.a, checked.bindings.program.arena.get_node_receiver(source), function, handler, caught, seen, edges, bindings, depth + 1) && flow.nodes[row.a - 1].type.index == 15;
		if (kind != SyntaxKind.FieldAccessExpressionSyntax() || row.token.index != checked.bindings.program.arena.get_token_field_name(source).index) return false;
		var aggregate = checked.bindings.program.arena.get_node_aggregate(source);
		if (aggregate.index > 0) return row.symbol.index == 0 && recover_child_with_bindings(flow, checked, types, row.a, aggregate, function, handler, caught, seen, edges, bindings, depth + 1) && flow.nodes[row.a - 1].type.index == 15;
		if (row.a != 0 || row.symbol.index < 1 || row.symbol.index > checked.bindings.symbol_count || row.symbol.index != recover_type_receiver(checked, source).index || checked.symbol_types[row.symbol.index].index != 15 || checked.symbol_flags[row.symbol.index] != 0) return false;
		var binding = checked.bindings.symbol(row.symbol);
		return (binding.kind == 7 || binding.kind == 8) && binding.owner.index == flow.functions[function - 1].symbol.index;
	}

	if (row.kind == 55) {
		if (!checked_flow_index_kind(kind) || row.c != 0 || !recover_child_with_bindings(flow, checked, types, row.a, checked.bindings.program.arena.get_node_container(source), function, handler, caught, seen, edges, bindings, depth + 1) || !recover_child_with_bindings(flow, checked, types, row.b, checked.bindings.program.arena.get_node_subscript(source), function, handler, caught, seen, edges, bindings, depth + 1)) return false;
		var container = flow.nodes[row.a - 1];
		bool slots = recover_storage_slots(checked, container.type, 0);
		if (slots && (checked.uses[source.index].flags != 2 || checked.uses[source.index].deferred != 19 || checked_kind(checked, row.type) != 31)) return false;
		return (recover_array_type(checked, container.type) || slots) && flow.nodes[row.b - 1].type.index == 1 && checked.types.argument(checked.types, container.type, 0).type.index == row.type.index && recover_array_static_index(checked, container.type, checked.bindings.program.arena.get_node_subscript(source));
	}
	if (row.kind == 56 || row.kind == 57) {
		if (row.a != 0 || row.b != 0 || row.c != 0) return false;
		SyntaxListId inputs = {index = 0};
		if (kind == SyntaxKind.ArrayInitializerSyntax()) inputs = checked.bindings.program.arena.get_list_elements(source);
		if (row.kind == 56) {
			if (kind != SyntaxKind.CallExpressionSyntax()) return false;
			var syntax = checked.bindings.program.arena.call_expression(source);
			if (syntax.f_signal_emission || checked.bindings.program.arena.list_count(syntax.f_type_arguments) != 0 || checked.bindings.program.arena.list_count(syntax.f_qualifier_arguments) != 0 || !checked_slice_intrinsic(checked, source) || row.count != 1 && row.count != 3 || checked_kind(checked, row.type) != 22) return false;
			inputs = checked.bindings.program.arena.get_list_arguments(source);
		} else {
			if (kind != SyntaxKind.ArrayInitializerSyntax() || !recover_storage_fixed(checked, row.type) || row.count != checked.types.row(row.type).extent) return false;
		}
		if (row.count != checked.bindings.program.arena.list_count(inputs)) return false;
		var element = checked.types.argument(checked.types, row.type, 0);
		int p = 0;
		while (p < row.count) {
			int edge = row.first + p;
			if (edges[edge]) return false;
			edges[edge] = true;
			int child = flow.edges[edge];
			if (!recover_child_with_bindings(flow, checked, types, child, checked.bindings.program.arena.node_at(inputs, p), function, handler, caught, seen, edges, bindings, depth + 1)) return false;
			var value = flow.nodes[child - 1];
			if (row.kind == 57 && value.type.index != element.type.index || row.kind == 56 && p > 0 && value.type.index != 1) return false;
			if (row.kind == 56 && p == 0) {
				if (!recover_storage_fixed(checked, value.type) || value.kind != 2 || checked.bindings.symbol(value.symbol).kind != 8 || checked.bindings.program.arena.kind(value.source) != SyntaxKind.NameExpressionSyntax() || checked.types.argument(checked.types, value.type, 0).type.index != element.type.index) return false;
				if (row.count == 3) {
					int extent = checked.types.row(value.type).extent;
					var first = recover_array_bound(checked, checked.bindings.program.arena.node_at(inputs, 1), extent);
					var count = recover_array_bound(checked, checked.bindings.program.arena.node_at(inputs, 2), extent);
					if (!first.valid || !count.valid || first.constant && count.constant && count.value > extent - first.value) return false;
				}
			}
			p = p + 1;
		}
		return true;
	}
	if (row.kind == 76) {
		if (kind != SyntaxKind.FieldAssignmentStatementSyntax() || row.symbol.index != 0 || row.type.index != 14 || row.count != 0) return false;
		var target = checked.bindings.program.arena.get_node_target(source);
		var indexed = recover_record_index(checked, target, 0);
		var value = checked.bindings.program.arena.get_node_expression(source);
		if (indexed.index < 1 || row.token.index != checked.bindings.program.arena.get_token_field_name(target).index || !recover_child_with_bindings(flow, checked, types, row.a, checked.bindings.program.arena.get_node_container(indexed), function, handler, caught, seen, edges, bindings, depth + 1) || !recover_child_with_bindings(flow, checked, types, row.b, checked.bindings.program.arena.get_node_subscript(indexed), function, handler, caught, seen, edges, bindings, depth + 1) || !recover_child_with_bindings(flow, checked, types, row.c, value, function, handler, caught, seen, edges, bindings, depth + 1)) return false;
		var container = flow.nodes[row.a - 1];
		if (!recover_array_type(checked, container.type)) return false;
		var record = checked.types.argument(checked.types, container.type, 0).type;
		var field = checked_target(checked, target, checked.bindings.program.arena.get_token_field_name(target));
		return recover_storage_record(checked, record) && checked.uses[indexed.index].type.index == record.index && flow.nodes[row.b - 1].type.index == 1 && field.index > 0 && checked.symbol_types[field.index].index == flow.nodes[row.c - 1].type.index && checked.uses[source.index].type.index == flow.nodes[row.c - 1].type.index && recover_copy_channel(checked, flow.nodes[row.c - 1].type, checked.uses[value.index].flags, false) && recover_array_static_index(checked, container.type, checked.bindings.program.arena.get_node_subscript(indexed)) && recover_record_destination_at(checked, target, record, indexed, type_symbol(0), 0) >= 0;
	}
	if (row.kind == 61) {
		if (kind != SyntaxKind.IndexedAssignmentSyntax()) return false;
		var target = checked.bindings.program.arena.get_node_target(source);
		if (!checked_flow_index_kind(checked.bindings.program.arena.kind(target)) || !recover_child_with_bindings(flow, checked, types, row.a, checked.bindings.program.arena.get_node_container(target), function, handler, caught, seen, edges, bindings, depth + 1) || !recover_child_with_bindings(flow, checked, types, row.b, checked.bindings.program.arena.get_node_subscript(target), function, handler, caught, seen, edges, bindings, depth + 1) || !recover_child_with_bindings(flow, checked, types, row.c, checked.bindings.program.arena.get_node_expression(source), function, handler, caught, seen, edges, bindings, depth + 1)) return false;
		var container = flow.nodes[row.a - 1];
		return recover_array_type(checked, container.type) && flow.nodes[row.b - 1].type.index == 1 && checked.types.argument(checked.types, container.type, 0).type.index == flow.nodes[row.c - 1].type.index && recover_array_static_index(checked, container.type, checked.bindings.program.arena.get_node_subscript(target));
	}
	return false;
}

bool recover_array_places_verified(RecoverFlow flow) {
	var work = new int[1];
	work[0] = 8000000;
	int n = 0;
	while (n < flow.data.node_count) {
		var row = flow.data.nodes[n];
		if (row.kind == 55 || row.kind == 56 || row.kind == 61 || row.kind == 76) {
			int input = row.a;
			if (row.kind == 56) input = flow.data.edges[row.first];
			var root = recover_array_root(flow, input, row.kind == 61 || row.kind == 76);
			if (root.index < 1) return false;
			int unwrapped = input;
			int depth = 0;
			while (flow.data.nodes[unwrapped - 1].kind == 7 && depth < 192) {
				unwrapped = flow.data.nodes[unwrapped - 1].a;
				depth = depth + 1;
			}
			if (depth == 192) return false;
			if (row.kind == 55 || row.kind == 61 || row.kind == 76) {
				if (!recover_borrow_preserved(flow.data, row.b, root, work, 0) || !recover_projection_preserved(flow, unwrapped, row.b, work)) return false;
			}
			if ((row.kind == 61 || row.kind == 76) && (!recover_borrow_preserved(flow.data, row.c, root, work, 0) || !recover_projection_preserved(flow, unwrapped, row.c, work))) return false;
			if (row.kind == 56) {
				int p = 1;
				while (p < row.count) {
					int bound = flow.data.edges[row.first + p];
					if (!recover_borrow_preserved(flow.data, bound, root, work, 0) || !recover_projection_preserved(flow, unwrapped, bound, work)) return false;
					p = p + 1;
				}
			}
		}
		n = n + 1;
	}
	return work[0] > 0;
}
