// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Structured Core has explicit conditional result and owned error channels.
// The retained Flow is a sibling authority, not a mutable producer certificate.
struct RecoverCoreNode {
	RecoverNode value;
	TypeId error;
	int result_role;
	int place;
	int error_owner;
	int borrowed_owner;
	bool conditional;
}

class RecoverCore {
	owned RecoverFlow flow;
	owned RecoverOwners owners;
	owned shared TypeOwner identity;
	owned RecoverCoreNode[] nodes;
	int count;
	int status;

	init(owned RecoverFlow flow, bool valid) {
		int count = 0; if (valid) count = flow.data.node_count;
		var owners = recover_owners_build(flow, valid); this.owners = move owners; this.flow = move flow;
		var owner = new TypeOwner(); var identity = shared_acquire(move owner); this.identity = move identity;
		this.nodes = new RecoverCoreNode[count]; this.count = count; this.status = 0;
	}
}

bool recover_node_equal(RecoverNode a, RecoverNode b) {
	return a.kind == b.kind && a.function == b.function && a.source.index == b.source.index && a.type.index == b.type.index && a.token.index == b.token.index && a.symbol.index == b.symbol.index && a.a == b.a && a.b == b.b && a.c == b.c && a.first == b.first && a.count == b.count && a.handler == b.handler && a.caught == b.caught;
}

bool recover_core_verify(RecoverCore core) {
	if (core.status != 0 || !recover_flow_verify(core.flow) || !recover_owners_verify(core.owners, core.flow) || core.count != core.flow.data.node_count || len(core.nodes) != core.count) return false;
	int i = 0;
	while (i < core.count) {
		var row = core.nodes[i]; var source = core.flow.data.nodes[i];
		if (!recover_node_equal(row.value, source)) return false;
		int role = 0; if (recover_value_kind(source.kind) && source.type.index != 14) role = 1;
		if (recover_error_new_kind(source.kind)) role = 2;
		if (source.kind == 6 || source.kind == 66 || source.kind == 53 || source.kind == 56) role = 3;
		if (source.kind == 94 || source.kind == 68 || source.kind == 9 || source.kind == 10 || source.kind == 11 || (source.kind == 4 || source.kind == 19 || source.kind == 69 || source.kind == 71 || source.kind == 77 || source.kind == 80) && (core.flow.checked.uses[source.source.index].flags & 4) != 0) role = 4;
		if (source.kind == 19 && core.flow.checked.uses[source.source.index].flags == 2) role = 3;
		if (source.kind == 55 && recover_storage_slots(core.flow.checked, core.flow.data.nodes[source.a - 1].type, 0)) role = 3;
		int place = 0; if (source.kind == 58 || source.kind == 2 || source.kind == 10 || source.kind == 12 || source.kind == 27 || source.kind == 86 || source.kind == 89 || source.kind == 42 || source.kind == 43 || source.kind == 75) place = core.flow.storage.symbols[source.symbol.index];
		if (source.kind == 65) place = core.flow.storage.symbols[source.symbol.index];
		if (source.kind == 17 || source.kind == 18 || source.kind == 44) place = core.flow.fields.facts[source.source.index].slot;
		if (row.result_role != role || row.place != place) return false;
		int owner = 0; if (recover_error_new_kind(source.kind) || source.kind == 25) owner = i + 1;
		int borrow = 0; if (source.kind == 6 || source.kind == 66) borrow = recover_caught_owner(core.flow.data, source.symbol);
		if (source.kind == 53) borrow = core.flow.storage.symbols[source.symbol.index];
		if (source.kind == 56) {
			var root = recover_array_root(core.flow, core.flow.data.edges[source.first], false);
			if (root.index < 1 || root.index >= len(core.flow.storage.symbols)) return false;
			borrow = core.flow.storage.symbols[root.index];
		}
		if (source.kind == 55 && role == 3) {
			var root = recover_array_root(core.flow, source.a, false);
			if (root.index < 1 || root.index >= len(core.flow.storage.symbols)) return false;
			borrow = core.flow.storage.symbols[root.index];
			if (borrow < 1 || borrow > core.flow.storage.count) return false;
		}
		if (source.kind == 19 && role == 3) {
			var root = recover_shared_borrow_root(core.flow.data, core.flow.checked, i + 1);
			if (root.index < 1 || root.index >= len(core.flow.storage.symbols)) return false;
			borrow = core.flow.storage.symbols[root.index];
			if (borrow < 1 || borrow > core.flow.storage.count) return false;
		}
		if (source.kind == 65 && (place < 1 || place > core.flow.storage.count || !core.flow.storage.slots[place - 1].parameter || core.flow.storage.slots[place - 1].owner)) return false;
		if (source.kind == 66 && borrow == 0) return false;
		if (row.error_owner != owner || row.borrowed_owner != borrow) return false;
		TypeId error = {index = 0}; bool conditional = false;
		if (source.kind == 4) {
			int callee = core.flow.data.symbols[source.symbol.index]; var function = core.flow.data.functions[callee - 1]; error = function.error; conditional = function.checked;
		}
		if (row.error.index != error.index || row.conditional != conditional) return false;
		// A caught source binding is always a borrow. The separately identified
		// owner can only be destroyed or transferred by explicit CFG operations.
		if (source.kind == 25 && (source.symbol.index == 0 || core.flow.checked.bindings.symbol(source.symbol).kind != 15)) return false;
		i = i + 1;
	}
	return true;
}

owned RecoverCore recover_core_lower(owned RecoverFlow flow) {
	bool valid = recover_flow_verify(flow); var core = new RecoverCore(move flow, valid);
	if (!valid) {
		core.status = 4;
		return move core;
	}
	int i = 0;
	while (i < core.count) {
		var value = core.flow.data.nodes[i]; int role = 0; if (recover_value_kind(value.kind) && value.type.index != 14) role = 1;
		if (recover_error_new_kind(value.kind)) role = 2; if (value.kind == 6 || value.kind == 66 || value.kind == 53 || value.kind == 56) role = 3;
		if (value.kind == 94 || value.kind == 68 || value.kind == 9 || value.kind == 10 || value.kind == 11 || (value.kind == 4 || value.kind == 19 || value.kind == 69 || value.kind == 71 || value.kind == 77 || value.kind == 80) && (core.flow.checked.uses[value.source.index].flags & 4) != 0) role = 4;
		if (value.kind == 19 && core.flow.checked.uses[value.source.index].flags == 2) role = 3;
		if (value.kind == 55 && recover_storage_slots(core.flow.checked, core.flow.data.nodes[value.a - 1].type, 0)) role = 3;
		int place = 0; if (value.kind == 58 || value.kind == 2 || value.kind == 10 || value.kind == 12 || value.kind == 27 || value.kind == 86 || value.kind == 89 || value.kind == 42 || value.kind == 43 || value.kind == 75) place = core.flow.storage.symbols[value.symbol.index];
		if (value.kind == 65) place = core.flow.storage.symbols[value.symbol.index];
		if (value.kind == 17 || value.kind == 18 || value.kind == 44) place = core.flow.fields.facts[value.source.index].slot;
		int owner = 0; if (recover_error_new_kind(value.kind) || value.kind == 25) owner = i + 1;
		int borrow = 0; if (value.kind == 6 || value.kind == 66) borrow = recover_caught_owner(core.flow.data, value.symbol);
		if (value.kind == 53) borrow = core.flow.storage.symbols[value.symbol.index];
		if (value.kind == 56) {
			var root = recover_array_root(core.flow, core.flow.data.edges[value.first], false);
			if (root.index > 0 && root.index < len(core.flow.storage.symbols)) borrow = core.flow.storage.symbols[root.index];
		}
		if (value.kind == 55 && role == 3) {
			var root = recover_array_root(core.flow, value.a, false);
			if (root.index > 0 && root.index < len(core.flow.storage.symbols)) borrow = core.flow.storage.symbols[root.index];
		}
		if (value.kind == 19 && role == 3) {
			var root = recover_shared_borrow_root(core.flow.data, core.flow.checked, i + 1);
			if (root.index > 0 && root.index < len(core.flow.storage.symbols)) borrow = core.flow.storage.symbols[root.index];
		}
		TypeId error = {index = 0}; bool conditional = false;
		if (value.kind == 4) {
			var function = core.flow.data.functions[core.flow.data.symbols[value.symbol.index] - 1];
			error = function.error;
			conditional = function.checked;
		}
		RecoverCoreNode row = {value = value, error = error, result_role = role, place = place, error_owner = owner, borrowed_owner = borrow, conditional = conditional}; core.nodes[i] = row; i = i + 1;
	}
	if (!recover_core_verify(core)) core.status = 1;
	return move core;
}
