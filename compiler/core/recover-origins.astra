// Native-v14 checked Class results must have heap-factory provenance. A raw
// nullable Class TypeId alone may describe excluded caller-backed storage.
bool recover_heap_witness(RecoverFlow flow, int id, bool[] seen, RecoverOwnerBudget work, int depth) {
	if (id < 1 || id > flow.data.node_count || depth > 192 || !work.take() || seen[id - 1]) return false; seen[id - 1] = true; var row = flow.data.nodes[id - 1];
	if (row.kind == 11) return recover_storage_class(flow.checked, row.type);
	if (row.kind == 7) return recover_heap_witness(flow, row.a, seen, work, depth + 1);
	if (row.kind == 10) {
		var declaration = flow.checked.bindings.symbol(row.symbol); if (declaration.kind == 7) return (flow.checked.symbol_flags[row.symbol.index] & 4) != 0;
		int n = 0; while (n < flow.data.node_count) {
			if (!work.take()) return false;
			var candidate = flow.data.nodes[n];
			if (candidate.kind == 27 && candidate.symbol.index == row.symbol.index && recover_heap_witness(flow, candidate.a, seen, work, depth + 1)) return true;
			n = n + 1;
		} return false;
	}
	if (row.kind == 4) {
		int callee = flow.data.symbols[row.symbol.index];
		int n = 0;
		while (n < flow.data.node_count) {
			if (!work.take()) return false;
			var candidate = flow.data.nodes[n];
			if (candidate.kind == 22 && candidate.function == callee && recover_heap_witness(flow, candidate.a, seen, work, depth + 1)) return true;
			n = n + 1;
		}
	}
	return false;
}

bool recover_heap_results(RecoverFlow flow, RecoverOwnerBudget work) {
	int f = 0; while (f < flow.data.function_count) { var function = flow.data.functions[f]; if (checked_kind(flow.checked, function.result) == 31) {
			bool heap = false; int n = 0; while (n < flow.data.node_count) {
				if (!work.take()) return false;
				var row = flow.data.nodes[n];
				if (row.function == f + 1 && row.kind == 22) {
					var seen = new bool[flow.data.node_count];
					heap = recover_heap_witness(flow, row.a, seen, work, 0) || heap;
				}
				n = n + 1;
			} if (!heap) return false;
		} f = f + 1; } return !work.exhausted;
}
