// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Ownership relations are retained separately from value TypeIds. A move
// reserves its actual binder slot until its unique consuming operation enters.
class RecoverOwnerBudget {
	int remaining;
	bool exhausted;

	init() { this.remaining = 8000000; this.exhausted = false; }

	bool take() { if (this.remaining == 0) {
			this.exhausted = true;
			return false;
		} this.remaining = this.remaining - 1; return true; }
}

// A reserved move retains its original slot on failure. A fresh value instead
// retires on that edge. Both dispositions retain the actual written operand.
struct RecoverAbort { int operation; int reservation; int call; }

bool recover_owner_fresh_argument(CheckedIndex checked, RecoverNode row) {
	if (!recover_owner_value(checked, row)) return false;
	return row.kind == 9 || row.kind == 11 || row.kind == 4 || row.kind == 19 || row.kind == 71 || row.kind == 77 || row.kind == 80;
}

class RecoverOwners {
	owned shared TypeOwner identity;
	owned int[] scopes;
	owned int[] functions;
	owned int[] consumers;
	owned int[] reservations;
	owned int[] slots;
	owned RecoverAbort[] aborts;
	int abort_count;
	int status;

	init(RecoverFlow flow, bool valid) {
		var identity = shared_clone(flow.data.identity); this.identity = move identity; int count = 0; int functions = 0; int status = 4;
		if (valid) {
			count = flow.data.node_count;
			functions = flow.data.function_count;
			status = 0;
		}
		this.scopes = new int[count]; this.functions = new int[functions]; this.consumers = new int[count]; this.reservations = new int[count]; this.slots = new int[count]; this.aborts = new RecoverAbort[8192]; this.abort_count = 0; this.status = status;
	}
}

int recover_owner_written_input(RecoverFlow flow, RecoverNode call, int ordinal) {
	if (call.kind == 71) {
		if (ordinal < 0 || ordinal >= call.count) return 0;
		return flow.data.edges[call.first + ordinal];
	}
	int slot = checked_named_argument_slot(flow.checked, call.source, call.symbol, call.count, ordinal);
	if (slot < 0 || slot >= call.count) return 0;
	return flow.data.edges[call.first + slot];
}

bool recover_owner_record_use(RecoverFlow flow, int[] consumers, int input, int consumer, RecoverOwnerBudget work) {
	if (!work.take()) return false;
	int producer = recover_owner_unwrap(flow.data, input);
	if (producer == 0) return true;
	if (producer < 1 || producer > flow.data.node_count) return false;
	if (!recover_owner_value(flow.checked, flow.data.nodes[producer - 1])) return true;
	if (consumers[producer - 1] != 0) return false;
	consumers[producer - 1] = consumer;
	return true;
}

bool recover_owner_uses(RecoverFlow flow, int[] consumers, RecoverOwnerBudget work) {
	int n = 0;
	while (n < flow.data.node_count) {
		if (!work.take()) return false;
		var row = flow.data.nodes[n];
		if ((row.kind == 22 || row.kind == 23 || row.kind == 27 || row.kind == 43 || row.kind == 44) && !recover_owner_record_use(flow, consumers, row.a, n + 1, work)) return false;
		if (row.kind == 77 && (!recover_owner_record_use(flow, consumers, row.b, n + 1, work) || !recover_owner_record_use(flow, consumers, row.c, n + 1, work))) return false;
		if (row.kind == 80) {
			if (!recover_owner_record_use(flow, consumers, row.a, n + 1, work)) return false;
			int a = 0;
			while (a < row.count) {
				int arm = flow.data.edges[row.first + a];
				if (!recover_owner_record_use(flow, consumers, flow.data.nodes[arm - 1].a, n + 1, work)) return false;
				a = a + 1;
			}
		}
		if (row.kind == 4 || recover_constructor_kind(row.kind) || row.kind == 19 || row.kind == 69 || row.kind == 71) {
			int a = 0;
			while (a < row.count) {
				if (!recover_owner_record_use(flow, consumers, flow.data.edges[row.first + a], n + 1, work)) return false;
				a = a + 1;
			}
		}
		n = n + 1;
	}
	return true;
}

bool recover_owner_contains(RecoverFlowData flow, int root, int target, RecoverOwnerBudget work, int depth) {
	if (root == target) return true; if (root == 0 || depth > 192 || !work.take()) return false; var row = flow.nodes[root - 1];
	if (row.kind == 82) return false;
	if (row.a != 0 && recover_owner_contains(flow, row.a, target, work, depth + 1) || row.b != 0 && recover_owner_contains(flow, row.b, target, work, depth + 1)) return true;
	if (row.kind == 77 && recover_owner_contains(flow, row.c, target, work, depth + 1)) return true;
	int i = 0; while (i < row.count) {
		if (recover_owner_contains(flow, flow.edges[row.first + i], target, work, depth + 1)) return true;
		i = i + 1;
	} return false;
}

// Reconstruct checked-call chains in ascending node order for each function.
// Source verification already requires every subtree to retain its function.
bool recover_owner_checked_calls(RecoverFlow flow, int[] first, int[] next, RecoverOwnerBudget work) {
	if (len(first) != flow.data.function_count || len(next) != flow.data.node_count) return false;
	int n = flow.data.node_count - 1;
	while (n >= 0) {
		if (!work.take()) return false;
		var row = flow.data.nodes[n];
		if (row.kind == 4 && (flow.checked.symbol_flags[row.symbol.index] & 64) != 0) {
			if (row.function < 1 || row.function > flow.data.function_count) return false;
			next[n] = first[row.function - 1];
			first[row.function - 1] = n + 1;
		}
		n = n - 1;
	}
	return true;
}

owned RecoverOwners recover_owners_build(RecoverFlow flow, bool valid) {
	var plan = new RecoverOwners(flow, valid);
	if (!valid) return move plan;
	var work = new RecoverOwnerBudget(); int n = 0;
	if (!recover_owner_uses(flow, plan.consumers, work)) {
		plan.status = 3;
		if (work.exhausted) plan.status = 2;
		return move plan;
	}
	var first_checked = new int[flow.data.function_count]; var next_checked = new int[flow.data.node_count];
	if (!recover_owner_checked_calls(flow, first_checked, next_checked, work)) {
		plan.status = 3;
		if (work.exhausted) plan.status = 2;
		return move plan;
	}
	int f = 0; while (f < flow.data.function_count) {
		var declaration = flow.checked.bindings.symbol(flow.data.functions[f].symbol);
		plan.functions[f] = flow.checked.bindings.scope_for_node(declaration.node).index;
		f = f + 1;
	}
	while (n < flow.data.node_count && plan.status == 0) { var row = flow.data.nodes[n]; plan.scopes[n] = flow.checked.bindings.scope_for_node(row.source).index;
		if (recover_owner_value(flow.checked, row)) { int consumer = plan.consumers[n]; if (consumer < 1) {
				plan.status = 3;
				break;
			}
			if (row.kind == 10) {
				int slot = flow.storage.symbols[row.symbol.index];
				if (slot < 1 || !flow.storage.slots[slot - 1].owner) {
					plan.status = 3;
					break;
				}
				plan.slots[n] = slot;
				var parent = flow.data.nodes[consumer - 1];
				bool matched = parent.kind == 80 && recover_owner_unwrap(flow.data, parent.a) == n + 1 && enum_match_consuming(flow.checked, parent.source);
				if (parent.kind == 4 || recover_constructor_kind(parent.kind) || parent.kind == 19 || parent.kind == 69 || parent.kind == 71 || matched) plan.reservations[n] = consumer;
			}
		}
		n = n + 1;
	}
	int call = 1; while (call <= flow.data.node_count && plan.status == 0) { var parent = flow.data.nodes[call - 1];
		if (parent.kind == 4 || recover_constructor_kind(parent.kind) || parent.kind == 71) { int a = 1; bool reserved = false; while (a < parent.count && plan.status == 0) {
				int preceding_input = recover_owner_written_input(flow, parent, a - 1);
				int preceding = recover_owner_unwrap(flow.data, preceding_input);
				if (preceding > 0 && recover_owner_value(flow.checked, flow.data.nodes[preceding - 1])) reserved = true;
				if (!reserved) {
					a = a + 1;
					continue;
				}
				int subtree = recover_owner_written_input(flow, parent, a); int child = first_checked[parent.function - 1];
				while (child > 0 && plan.status == 0) { if (!work.take()) {
						plan.status = 2;
						break;
					}
					if (recover_owner_contains(flow.data, subtree, child, work, 0)) {
						int earlier = 0; while (earlier < a) {
							int reserve_input = recover_owner_written_input(flow, parent, earlier);
							int reserve = recover_owner_unwrap(flow.data, reserve_input);
							if (reserve > 0 && recover_owner_value(flow.checked, flow.data.nodes[reserve - 1])) {
								if (plan.abort_count == 8192) {
									plan.status = 2;
									break;
								}
								RecoverAbort abort = {operation = child, reservation = reserve, call = call};
								plan.aborts[plan.abort_count] = abort;
								plan.abort_count = plan.abort_count + 1;
							}
							earlier = earlier + 1;
						}
					} child = next_checked[child - 1];
				} a = a + 1;
			} } call = call + 1;
	}
	if (work.exhausted) plan.status = 2; return move plan;
}

struct RecoverOwnerParent { int node; int argument; }

bool recover_owner_enum_channel(RecoverFlow flow, RecoverNode row, int argument) {
	if (row.kind != 71 || argument < 0 || argument >= row.count || !enum_constructor_verified(flow.checked, row.source, row.symbol, row.type)) return false;
	var declaration = flow.checked.bindings.symbol(row.symbol);
	var fields = flow.checked.bindings.program.arena.get_list_fields(declaration.node);
	if (row.count != flow.checked.bindings.program.arena.list_count(fields)) return false;
	var field = flow.checked.bindings.program.arena.node_at(fields, argument);
	var symbol = flow.checked.node_symbols[field.index];
	return flow.checked.symbol_flags[symbol.index] == 4 || enum_storage_owned(flow.checked, flow.checked.symbol_types[symbol.index], 0);
}

bool recover_owner_parent(RecoverOwnerParent[] parents, int child, int node, int argument) {
	if (child == 0) return true;
	if (child < 1 || child > len(parents) || parents[child - 1].node != 0) return false;
	RecoverOwnerParent use = {node = node, argument = argument};
	parents[child - 1] = use;
	return true;
}

// Reconstruct immediate use edges from the verified source tree. The verifier
// follows parentheses outward and checks the actual enclosing operation.
bool recover_owner_parents(RecoverFlowData flow, RecoverOwnerParent[] parents, RecoverOwnerBudget work) {
	int n = 0;
	while (n < flow.node_count) {
		if (!work.take()) return false;
		var row = flow.nodes[n];
		if (row.kind == 7 || row.kind == 22 || row.kind == 23 || row.kind == 27 || row.kind == 43 || row.kind == 44) {
			if (!recover_owner_parent(parents, row.a, n + 1, -1)) return false;
		}
		if (row.kind == 77 && (!recover_owner_parent(parents, row.b, n + 1, 0) || !recover_owner_parent(parents, row.c, n + 1, 1))) return false;
		if (row.kind == 80) {
			if (!recover_owner_parent(parents, row.a, n + 1, -2)) return false;
			int a = 0;
			while (a < row.count) {
				int arm = flow.edges[row.first + a];
				if (!work.take() || !recover_owner_parent(parents, flow.nodes[arm - 1].a, n + 1, a)) return false;
				a = a + 1;
			}
		}
		if (row.kind == 4 || recover_constructor_kind(row.kind) || row.kind == 19 || row.kind == 69 || row.kind == 71) {
			int a = 0;
			while (a < row.count) {
				if (!work.take() || !recover_owner_parent(parents, flow.edges[row.first + a], n + 1, a)) return false;
				a = a + 1;
			}
		}
		n = n + 1;
	}
	return true;
}

bool recover_owners_verify(RecoverOwners plan, RecoverFlow flow) {
	int count = flow.data.node_count; if (plan.status != 0 || !type_owner_same(plan.identity, flow.data.identity) || len(plan.scopes) != count || len(plan.functions) != flow.data.function_count || len(plan.consumers) != count || len(plan.reservations) != count || len(plan.slots) != count || len(plan.aborts) != 8192 || plan.abort_count < 0 || plan.abort_count > 8192) return false;
	var work = new RecoverOwnerBudget(); int n = 0;
	var parents = new RecoverOwnerParent[count];
	if (!recover_owner_parents(flow.data, parents, work)) return false;
	var first_checked = new int[flow.data.function_count]; var next_checked = new int[count];
	if (!recover_owner_checked_calls(flow, first_checked, next_checked, work)) return false;
	int f = 0; while (f < flow.data.function_count) {
		var declaration = flow.checked.bindings.symbol(flow.data.functions[f].symbol);
		if (plan.functions[f] != flow.checked.bindings.scope_for_node(declaration.node).index) return false;
		f = f + 1;
	}
	while (n < count) { var row = flow.data.nodes[n]; if (!work.take() || plan.scopes[n] != flow.checked.bindings.scope_for_node(row.source).index) return false; bool owner = recover_owner_value(flow.checked, row); int consumer = 0; int call = 0; int slot = 0;
		if ((row.kind == 27 || row.kind == 43) && (flow.checked.symbol_flags[row.symbol.index] & 4) != 0) {
			int input = recover_owner_unwrap(flow.data, row.a);
			if (input < 1 || !recover_owner_value(flow.checked, flow.data.nodes[input - 1])) return false;
		}
		if (row.kind == 44 && (flow.checked.symbol_flags[flow.fields.facts[row.source.index].field.index] & 4) != 0) {
			int input = recover_owner_unwrap(flow.data, row.a);
			if (input < 1 || !recover_owner_value(flow.checked, flow.data.nodes[input - 1])) return false;
		}
		if (row.kind == 22) {
			var function = flow.data.functions[row.function - 1];
			var signature = flow.checked.signatures[function.signature.index - 1];
			var result = flow.checked.types.argument(flow.checked.types, signature.callable, 0);
			if ((result.flags & 4) != 0) {
				int input = recover_owner_unwrap(flow.data, row.a);
				if (input < 1) return false;
				var value = flow.data.nodes[input - 1];
				// The source-verified absent literal carries no allocation or
				// initialized owner. The caller still owns its returned slot.
				if (!recover_owner_value(flow.checked, value) && !(value.kind == 13 && value.type.index == result.type.index && (recover_storage_class(flow.checked, value.type) || recover_storage_error(flow.checked, value.type) || recover_storage_shared(flow.checked, value.type) || recover_storage_weak(flow.checked, value.type)))) return false;
			}
		}
		if (row.kind == 4 || recover_constructor_kind(row.kind)) {
			var signature = flow.checked.signatures[flow.checked.symbol_signatures[row.symbol.index].index - 1];
			int a = 0;
			while (a < row.count) {
				int offset = 1; if (recover_constructor_kind(row.kind)) offset = 2;
				var channel = flow.checked.types.argument(flow.checked.types, signature.callable, a + offset);
				if ((channel.flags & 4) != 0) {
					int input = recover_owner_unwrap(flow.data, flow.data.edges[row.first + a]);
					if (input < 1 || !recover_owner_value(flow.checked, flow.data.nodes[input - 1])) return false;
				}
				a = a + 1;
			}
		}
		if (row.kind == 71) {
			if (!enum_constructor_verified(flow.checked, row.source, row.symbol, row.type)) return false;
			int a = 0;
			while (a < row.count) {
				if (recover_owner_enum_channel(flow, row, a)) {
					int input = recover_owner_unwrap(flow.data, flow.data.edges[row.first + a]);
					if (input < 1 || !recover_owner_value(flow.checked, flow.data.nodes[input - 1])) return false;
				}
				a = a + 1;
			}
		}
		if (owner) {
			var parent = parents[n]; int depth = 0;
			while (parent.node > 0 && flow.data.nodes[parent.node - 1].kind == 7) {
				if (!work.take() || depth == 191) return false;
				parent = parents[parent.node - 1]; depth = depth + 1;
			}
			if (parent.node == 0) return false;
			var candidate = flow.data.nodes[parent.node - 1];
			consumer = parent.node;
			if (candidate.kind == 77 && ((flow.checked.uses[candidate.source.index].flags & 4) == 0 || parent.argument < 0 || parent.argument > 1 || row.function != candidate.function)) return false;
			if (candidate.kind == 80) {
				if (row.function != candidate.function) return false;
				if (parent.argument == -2) {
					if (recover_owner_unwrap(flow.data, candidate.a) != n + 1 || !enum_storage_owned(flow.checked, row.type, 0) || !enum_match_consuming(flow.checked, candidate.source)) return false;
					if (row.kind == 10) call = consumer;
				} else {
					if ((flow.checked.uses[candidate.source.index].flags & 4) == 0 || parent.argument < 0 || parent.argument >= candidate.count) return false;
				}
			}
			if (candidate.kind == 71) {
				if (row.function != candidate.function || !recover_owner_enum_channel(flow, candidate, parent.argument)) return false;
				if (row.kind == 10) call = consumer;
			}
			if (candidate.kind == 69) {
				bool consuming = parent.argument == candidate.count - 1 && (flow.checked.bindings.program.arena.token_is(candidate.token, "append") || flow.checked.bindings.program.arena.token_is(candidate.token, "replace"));
				if (!consuming || row.kind != 10 || row.function != candidate.function) return false;
				call = consumer;
			}
			if (candidate.kind == 19) {
				if (candidate.count != 1 || row.kind != 10 || !flow.checked.bindings.program.arena.token_is(candidate.token, "shared_acquire")) return false;
				call = consumer;
			}
			if (candidate.kind == 4 || recover_constructor_kind(candidate.kind)) {
				var signature = flow.checked.signatures[flow.checked.symbol_signatures[candidate.symbol.index].index - 1];
				int offset = 1; if (recover_constructor_kind(candidate.kind)) offset = 2;
				var channel = flow.checked.types.argument(flow.checked.types, signature.callable, parent.argument + offset);
				if ((channel.flags & 4) == 0 || row.kind != 10 && !recover_owner_fresh_argument(flow.checked, row)) return false;
				if (row.kind == 10) call = consumer;
			}
		}
		if (row.kind == 10) {
			if (row.symbol.index < 1 || row.symbol.index >= len(flow.storage.symbols)) return false;
			slot = flow.storage.symbols[row.symbol.index];
			if (slot < 1 || slot > flow.storage.count || !flow.storage.slots[slot - 1].owner || flow.storage.slots[slot - 1].function != row.function) return false;
		}
		if (plan.consumers[n] != consumer || plan.reservations[n] != call || plan.slots[n] != slot) return false; n = n + 1;
	}
	int expected = 0; int call = 1;
	var preceding_aborts = new int[count];
	while (call <= count) {
		var parent = flow.data.nodes[call - 1];
		if (parent.kind == 4 || recover_constructor_kind(parent.kind) || parent.kind == 71) {
			int a = 1; bool reserved = false;
			while (a < parent.count) {
				int preceding_slot = a - 1;
				if (parent.kind != 71) preceding_slot = checked_named_argument_slot(flow.checked, parent.source, parent.symbol, parent.count, a - 1);
				if (preceding_slot < 0 || preceding_slot >= parent.count) return false;
				int preceding = recover_owner_unwrap(flow.data, flow.data.edges[parent.first + preceding_slot]);
				if (preceding > 0 && recover_owner_value(flow.checked, flow.data.nodes[preceding - 1])) reserved = true;
				if (!reserved) {
					a = a + 1;
					continue;
				}
				int subtree_slot = a;
				if (parent.kind != 71) subtree_slot = checked_named_argument_slot(flow.checked, parent.source, parent.symbol, parent.count, a);
				if (subtree_slot < 0 || subtree_slot >= parent.count) return false;
				int subtree = flow.data.edges[parent.first + subtree_slot];
				int child = first_checked[parent.function - 1];
				while (child > 0) {
					if (!work.take()) return false;
					if (recover_owner_contains(flow.data, subtree, child, work, 0)) {
						int earlier = 0;
						while (earlier < a) {
							int reserve_slot = earlier;
							if (parent.kind != 71) reserve_slot = checked_named_argument_slot(flow.checked, parent.source, parent.symbol, parent.count, earlier);
							if (reserve_slot < 0 || reserve_slot >= parent.count) return false;
							int reserve = recover_owner_unwrap(flow.data, flow.data.edges[parent.first + reserve_slot]);
							if (reserve > 0 && recover_owner_value(flow.checked, flow.data.nodes[reserve - 1])) {
								if (expected >= plan.abort_count) return false;
								var abort = plan.aborts[expected];
								if (abort.operation != child || abort.reservation != reserve || abort.call != call) return false;
								// Plan order is acquisition order even across nested calls.
								// Establish it from source ranges, not numeric node order.
								int previous = preceding_aborts[child - 1];
								if (previous > 0) {
									var before = flow.checked.bindings.program.arena.header(flow.data.nodes[previous - 1].source).span;
									var after = flow.checked.bindings.program.arena.header(flow.data.nodes[reserve - 1].source).span;
									if (before.source.index != after.source.index || before.end > after.start) return false;
								}
								preceding_aborts[child - 1] = reserve;
								expected = expected + 1;
							}
							earlier = earlier + 1;
						}
					}
					child = next_checked[child - 1];
				}
				a = a + 1;
			}
		}
		call = call + 1;
	}
	var heap = recover_heap_index(flow, work);
	return expected == plan.abort_count && !work.exhausted && heap.valid && recover_heap_results(flow, heap, work) && recover_class_consumers(plan, flow, parents, work) && recover_shared_acquisitions(flow, heap, work);
}
