// Bounded append-only arenas; only construction and adversarial tests mutate.
int core_add_node(CoreData core, CoreNode row) {
	if (!core.room(core.node_count)) return 0;
	if (core.node_count == len(core.nodes)) {
		var grown = new CoreNode[syntax_grown_capacity(len(core.nodes), core.node_count + 1)];
		int i = 0;
		while (i < core.node_count) {
			grown[i] = core.nodes[i];
			i = i + 1;
		}
		swap(core.nodes, grown);
	}
	core.nodes[core.node_count] = row;
	core.node_count = core.node_count + 1;
	return core.node_count;
}

