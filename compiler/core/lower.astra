// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Lower actual retained syntax/CheckedUse, never source text or an event dump.
CoreNode core_node(CheckedIndex checked, SyntaxNodeId source, int function) {
	CoreNode row = {
		kind = 0, function = function, source = source, span = checked.bindings.program.arena.header(source).span,
		type = checked.uses[source.index].type, flags = checked.uses[source.index].flags,
		token = {index = 0}, operation = {index = 0}, a = 0, b = 0, c = 0, place = 0,
		symbol = {index = 0}, signature = {index = 0}, target = 0, first = 0, count = 0
	};
	return row;
}

int core_lower_place(CoreData core, CheckedIndex checked, borrowed FlowGraph graph, int function, SyntaxNodeId node) {
	int first = core.functions[function - 1].place_first;
	var kind = checked.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.FieldAccessExpressionSyntax()) {
		int field = flowsem_place(graph, checked, node, 0);
		if (field > 0) return first + graph.slot_count + field;
		return 0;
	}
	SyntaxTokenId token = {index = 0};
	if (kind == SyntaxKind.MoveExpressionSyntax()) {
		token = checked.bindings.program.arena.get_token_source(node);
	} else {
		token = checked.bindings.program.arena.get_token_identifier(node);
	}
	int slot = graph.slot_for(checked_target(checked, node, token));
	if (slot == 0) return 0;
	return first + slot;
}

int core_lower_tree(CoreData core, CheckedIndex checked, borrowed FlowGraph graph, SyntaxNodeId source, int function, int loop, int call, int depth) {
	if (source.index == 0 || core.status != 0) return 0;
	if (depth > 192) {
		core.status = 2;
		return 0;
	}
	var kind = checked.bindings.program.arena.kind(source);
	var row = core_node(checked, source, function);
	int id = core_add_node(core, row);
	if (id == 0) return 0;
	if (kind == SyntaxKind.IntegerLiteralExpressionSyntax() || kind == SyntaxKind.FloatLiteralExpressionSyntax() || kind == SyntaxKind.BooleanLiteralExpressionSyntax()) {
		row.kind = 1;
		row.token = checked.bindings.program.arena.get_token_literal(source);
	} else {
		if (kind == SyntaxKind.NameExpressionSyntax() || kind == SyntaxKind.FieldAccessExpressionSyntax() || kind == SyntaxKind.MoveExpressionSyntax()) {
			row.kind = 3;
			row.place = core_lower_place(core, checked, graph, function, source);
			if (kind == SyntaxKind.MoveExpressionSyntax()) {
				row.kind = 4;
				row.target = call;
			}
			if (row.place == 0) core.status = 3;
		} else {
			if (kind == SyntaxKind.PrefixExpressionSyntax() || kind == SyntaxKind.ConversionExpressionSyntax() || kind == SyntaxKind.ParenthesizedExpressionSyntax()) {
				row.kind = 5;
				SyntaxNodeId operand = {index = 0};
				if (kind != SyntaxKind.ParenthesizedExpressionSyntax()) operand = checked.bindings.program.arena.get_node_operand(source);
				int child_call = 0;
				if (kind == SyntaxKind.PrefixExpressionSyntax()) row.operation = checked.bindings.program.arena.get_token_operator_token(source);
				if (kind == SyntaxKind.ConversionExpressionSyntax()) row.kind = 8;
				if (kind == SyntaxKind.ParenthesizedExpressionSyntax()) {
					row.kind = 12;
					operand = checked.bindings.program.arena.get_node_expression(source);
					child_call = call;
				}
				var direct = flow_unwrap(checked, operand);
				if (row.kind == 5 && checked.bindings.program.arena.kind(direct) == SyntaxKind.IntegerLiteralExpressionSyntax()) {
					row.kind = 2;
					row.token = checked.bindings.program.arena.get_token_literal(direct);
				} else {
					row.a = core_lower_tree(core, checked, graph, operand, function, loop, child_call, depth + 1);
				}
			} else {
				if (kind == SyntaxKind.BinaryExpressionSyntax() || kind == SyntaxKind.ShortCircuitExpressionSyntax()) {
					row.kind = 6;
					if (kind == SyntaxKind.ShortCircuitExpressionSyntax()) row.kind = 7;
					row.operation = checked.bindings.program.arena.get_token_operator_token(source);
					row.a = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_left(source), function, loop, 0, depth + 1);
					row.b = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_right(source), function, loop, 0, depth + 1);
				} else {
					if (kind == SyntaxKind.HeapObjectConstructionSyntax()) {
						row.kind = 13;
					} else { if (kind == SyntaxKind.BufferAllocationSyntax()) {
							row.kind = 11;
							row.a = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_count(source), function, loop, 0, depth + 1);
						} else {
							if (kind == SyntaxKind.CallExpressionSyntax() || kind == SyntaxKind.StructInitializerSyntax() || kind == SyntaxKind.BlockStatementSyntax()) {
								row = core_lower_list(core, checked, graph, row, id, function, loop, depth);
							} else {
								row = core_lower_statement(core, checked, graph, row, id, function, loop, depth);
							}
						} }
				}
			}
		}
	}
	if (row.kind == 0) {
		core.status = 3;
		core.error_span = row.span;
	}
	core.nodes[id - 1] = row;
	return id;
}

CoreNode core_lower_list(CoreData core, CheckedIndex checked, borrowed FlowGraph graph, CoreNode input, int id, int function, int loop, int depth) {
	var row = input;
	var kind = checked.bindings.program.arena.kind(row.source);
	SyntaxListId list = {index = 0};
	SyntaxListId params = {index = 0};
	if (kind == SyntaxKind.CallExpressionSyntax() && checked_flow_intrinsic(checked, row.source)) {
		var arguments = checked_call_arguments(checked, row.source);
		if (checked.bindings.program.arena.list_count(arguments) != 1) {
			core.status = 3;
			return row;
		}
		var argument = flow_unwrap(checked, checked.bindings.program.arena.node_at(arguments, 0));
		row.kind = 14; row.place = core_lower_place(core, checked, graph, function, argument);
		if (row.place == 0 || !flow_buffer_type(checked, core.places[row.place - 1].type)) core.status = 3;
		return row;
	}
	if (kind == SyntaxKind.CallExpressionSyntax()) {
		row.kind = 9;
		row.symbol = checked_target(checked, row.source, checked.bindings.program.arena.get_token_identifier(row.source));
		if (row.symbol.index == 0) {
			core.status = 3;
			return row;
		}
		row.signature = checked.symbol_signatures[row.symbol.index];
		int i = 0;
		while (i < core.function_count) {
			if (core.functions[i].symbol.index == row.symbol.index) row.target = i + 1;
			i = i + 1;
		}
		if (row.target == 0 || row.signature.index == 0) {
			core.status = 3;
			return row;
		}
		list = checked_call_arguments(checked, row.source);
		var callee_declaration = checked.bindings.symbol(row.symbol);
		params = checked.bindings.program.arena.get_list_parameters(callee_declaration.node);
	}
	if (kind == SyntaxKind.StructInitializerSyntax()) {
		row.kind = 10;
		list = checked.bindings.program.arena.get_list_fields(row.source);
	}
	if (kind == SyntaxKind.BlockStatementSyntax()) {
		row.kind = 20;
		row.type = type_id(14);
		row.flags = 0;
		list = checked.bindings.program.arena.get_list_statements(row.source);
	}
	row.count = checked.bindings.program.arena.list_count(list);
	// Reserve ordered edges before descending; nested lists cannot interleave them.
	row.first = core.edge_count;
	int i = 0;
	while (i < row.count && core.status == 0) {
		CoreEdge edge = {child = 0, label = {index = 0}, mode = 0};
		int added = core_add_edge(core, edge);
		i = i + 1;
	}
	i = 0;
	while (i < row.count && core.status == 0) {
		var source = checked.bindings.program.arena.node_at(list, i);
		CoreEdge edge = {child = 0, label = {index = 0}, mode = 0};
		int child_call = 0;
		if (row.kind == 9) {
			var parameter_node = checked.bindings.program.arena.node_at(params, i);
			edge.label = checked.node_symbols[parameter_node.index];
			var signature = checked.signatures[row.signature.index - 1];
			var parameter = checked.types.argument(checked.types, signature.callable, i + 1);
			edge.mode = parameter.flags;
			child_call = id;
		}
		if (row.kind == 10) {
			edge.label = checked_target(checked, source, checked.bindings.program.arena.get_token_name(source));
			edge.mode = checked.symbol_flags[edge.label.index];
			var initializer = checked.bindings.program.arena.get_node_initializer(source);
			if (initializer.index == 0) initializer = checked.bindings.program.arena.get_node_expression(source);
			source = initializer;
		}
		edge.child = core_lower_tree(core, checked, graph, source, function, loop, child_call, depth + 1);
		core.edges[row.first + i] = edge;
		i = i + 1;
	}
	return row;
}

CoreNode core_lower_statement(CoreData core, CheckedIndex checked, borrowed FlowGraph graph, CoreNode input, int id, int function, int loop, int depth) {
	var row = input;
	var source = row.source;
	var kind = checked.bindings.program.arena.kind(source);
	row.type = type_id(14);
	row.flags = 0;
	if (kind == SyntaxKind.LocalDeclarationSyntax() || kind == SyntaxKind.InferredLocalDeclarationSyntax() || kind == SyntaxKind.StructLocalDeclarationSyntax() || kind == SyntaxKind.AssignmentStatementSyntax() || kind == SyntaxKind.FieldAssignmentStatementSyntax()) {
		row.kind = 21;
		SyntaxNodeId value = {index = 0};
		if (kind != SyntaxKind.AssignmentStatementSyntax() && kind != SyntaxKind.FieldAssignmentStatementSyntax()) value = checked.bindings.program.arena.get_node_initializer(source);
		var symbol = checked.node_symbols[source.index];
		if (kind == SyntaxKind.AssignmentStatementSyntax() || kind == SyntaxKind.FieldAssignmentStatementSyntax()) {
			row.kind = 22;
			value = checked.bindings.program.arena.get_node_expression(source);
			if (kind == SyntaxKind.AssignmentStatementSyntax()) symbol = checked_target(checked, source, checked.bindings.program.arena.get_token_name(source));
		}
		int slot = graph.slot_for(symbol);
		if (slot > 0) row.place = core.functions[function - 1].place_first + slot;
		if (kind == SyntaxKind.FieldAssignmentStatementSyntax()) row.place = core_lower_place(core, checked, graph, function, checked.bindings.program.arena.get_node_target(source));
		if (row.place == 0) {
			core.status = 3;
			return row;
		}
		row.type = checked.uses[source.index].type;
		if (row.kind == 21) row.flags = checked.uses[source.index].flags;
		row.a = core_lower_tree(core, checked, graph, value, function, loop, 0, depth + 1);
	}
	if (kind == SyntaxKind.IfStatementSyntax() || kind == SyntaxKind.WhileStatementSyntax()) {
		row.kind = 23;
		row.a = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_condition(source), function, loop, 0, depth + 1);
		if (kind == SyntaxKind.IfStatementSyntax()) {
			row.b = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_then_body(source), function, loop, 0, depth + 1);
			row.c = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_else_body(source), function, loop, 0, depth + 1);
		} else {
			row.kind = 24;
			row.b = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_body(source), function, id, 0, depth + 1);
		}
	}
	if (kind == SyntaxKind.BreakStatementSyntax() || kind == SyntaxKind.ContinueStatementSyntax()) {
		row.kind = 25;
		if (kind == SyntaxKind.ContinueStatementSyntax()) row.kind = 26;
		row.target = loop;
	}
	if (kind == SyntaxKind.ReturnStatementSyntax()) {
		row.kind = 27;
		row.type = core.functions[function - 1].result;
		row.flags = core.functions[function - 1].flags;
		row.a = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_expression(source), function, loop, 0, depth + 1);
	}
	if (kind == SyntaxKind.CallStatementSyntax()) {
		row.kind = 28;
		row.a = core_lower_tree(core, checked, graph, checked.bindings.program.arena.get_node_call(source), function, loop, 0, depth + 1);
	}
	return row;
}

void core_lower_inventory(CoreData core, CheckedIndex checked, borrowed FlowGraph graph, int function) {
	int first = core.place_count;
	int s = 0;
	while (s < graph.slot_count && core.status == 0) {
		var slot = graph.slots[s];
		CorePlace row = { function = function, root = first + s + 1, parent = 0, slot = s + 1, field = 0, symbol = slot.symbol, type = slot.type, flags = slot.flags, region = slot.region, parameter = slot.parameter, leaf = checked_kind(checked, slot.type) != 30 };
		int added = core_add_place(core, row);
		s = s + 1;
	}
	int i = 0;
	while (i < graph.field_count && core.status == 0) {
		var field = graph.fields[i];
		if (field.root == 0) {
			core.status = 3;
			return;
		}
		var slot = graph.slots[field.root - 1];
		int parent = first + field.root;
		if (field.parent > 0) parent = first + graph.slot_count + field.parent;
		CorePlace row = { function = function, root = first + field.root, parent = parent, slot = field.root, field = i + 1, symbol = field.symbol, type = field.type, flags = field.flags, region = slot.region, parameter = slot.parameter, leaf = field.leaf };
		int added = core_add_place(core, row);
		i = i + 1;
	}
}

void core_lower_cleanup(CoreData core, int place, int owner, int state) {
	CoreCleanup row = {place = place, owner = owner, type = core.places[place - 1].type, state = state};
	int added = core_add_cleanup(core, row);
}

void core_lower_responsibility(CoreData core, CheckedIndex checked, borrowed FlowGraph graph, int function) {
	int first = core.functions[function - 1].place_first;
	int e = 0;
	while (e < graph.count && core.status == 0) {
		var event = graph.events[e];
		if (event.operation == 9) {
			CoreExit plan = {function = function, source = event.node, region = event.region, witness = e + 1, first = core.cleanup_count, count = 0};
			int s = graph.slot_count - 1;
			while (s >= 0 && core.status == 0) {
				int state = graph.facts[e * graph.slot_count + s];
				var slot = graph.slots[s];
				if (slot.owner && slot.region == event.region && graph.reachable[e] && (state & 1) != 0) {
					int owner = first + s + 1;
					if (checked_kind(checked, slot.type) == 30) {
						int field = graph.field_count - 1;
						while (field >= 0 && core.status == 0) {
							if (graph.fields[field].root == s + 1 && graph.fields[field].leaf && (graph.fields[field].flags & 4) != 0) core_lower_cleanup(core, first + graph.slot_count + field + 1, owner, state);
							field = field - 1;
						}
					} else {
						core_lower_cleanup(core, owner, owner, state);
					}
				}
				s = s - 1;
			}
			plan.count = core.cleanup_count - plan.first;
			int added = core_add_exit(core, plan);
		}
		e = e + 1;
	}
	int l = 0;
	while (l < graph.loan_count && core.status == 0) {
		var loan = graph.loans[l];
		if (loan.call.index == 0 || loan.borrower != 0) {
			core.status = 3;
			return;
		}
		CoreLoan row = {function = function, source = first + loan.source, value = loan.node, call = loan.call, region = loan.region, begin = 0, end = 0};
		e = 0;
		while (e < graph.count) {
			if (graph.events[e].operation == 7 && graph.events[e].loan == l + 1) row.begin = e + 1;
			if (graph.events[e].operation == 8 && graph.events[e].call == loan.call.index) row.end = e + 1;
			e = e + 1;
		}
		int added = core_add_loan(core, row);
		l = l + 1;
	}
}

void core_set_status(CoreData core, int status) { core.status = status; }

void core_replace_function(CoreData core, int ordinal, CoreFunction row) { core.functions[ordinal] = row; }

owned CoreProgram core_lower(owned FlowIndex flow, int limit) {
	var program = new CoreProgram(move flow, limit);
	// No partial success when any source proof/function remains deferred.
	if (!program.flow.checked.semantic_admission || program.flow.checked.failed()) {
		core_set_status(program.data, 4);
		return move program;
	}
	int status = flow_status(program.flow);
	if (status != 0) {
		core_set_status(program.data, 4);
		if (status == 3) core_set_status(program.data, 3);
		if (status == 2) core_set_status(program.data, 2);
		return move program;
	}
	if (!admit_verify_index(program.flow)) {
		core_set_status(program.data, 4);
		return move program;
	}
	int i = 0;
	int first = 0;
	while (i < program.flow.checked.signature_count && program.data.status == 0) {
		var sig = program.flow.checked.signatures[i];
		var declaration = program.flow.checked.bindings.symbol(sig.declaration);
		if (declaration.kind != 1) {
			core_set_status(program.data, 3);
			return move program;
		}
		var result = program.flow.checked.types.argument(program.flow.checked.types, sig.callable, 0);
		CoreFunction f = {symbol = sig.declaration, signature = {index = i + 1}, result = result.type, flags = result.flags, span = program.flow.checked.bindings.program.arena.header(declaration.node).span, body = 0, place_first = first, place_count = flow_graph_slot_count(program.flow.graphs.entries[i]) + flow_field_count(program.flow.graphs.entries[i])};
		int added = core_add_function(program.data, f);
		first = first + f.place_count;
		i = i + 1;
	}
	i = 0;
	while (i < program.data.function_count && program.data.status == 0) {
		core_lower_inventory(program.data, program.flow.checked, program.flow.graphs.entries[i], i + 1);
		core_lower_responsibility(program.data, program.flow.checked, program.flow.graphs.entries[i], i + 1);
		var f = program.data.functions[i];
		var declaration = program.flow.checked.bindings.symbol(f.symbol);
		f.body = core_lower_tree(program.data, program.flow.checked, program.flow.graphs.entries[i], program.flow.checked.bindings.program.arena.get_node_body(declaration.node), i + 1, 0, 0, 0);
		core_replace_function(program.data, i, f);
		i = i + 1;
	}
	if (program.data.status == 0) {
		int verified = core_verify(program);
		core_set_status(program.data, verified);
	}
	return move program;
}
