// Temporary array views and indexed Class inspections have one borrowed call use.
int recover_slice_consumer(RecoverFlow flow, int value, RecoverOwnerParent[] parents, RecoverOwnerBudget work) {
	if (value < 1 || value > flow.data.node_count || len(parents) != flow.data.node_count) return -1;
	var input = flow.data.nodes[value - 1];
	bool slot_borrow = input.kind == 55 && input.a > 0 && input.a <= flow.data.node_count && recover_storage_slots(flow.checked, flow.data.nodes[input.a - 1].type, 0);
	var parent = parents[value - 1]; int depth = 0;
	while (parent.node > 0 && parent.node <= flow.data.node_count && flow.data.nodes[parent.node - 1].kind == 7) {
		if (!work.take() || depth == 191) return -1;
		parent = parents[parent.node - 1]; depth = depth + 1;
	}
	if (!work.take() || parent.node < 1 || parent.node > flow.data.node_count) return -1;
	var row = flow.data.nodes[parent.node - 1];
	if (!slot_borrow && input.kind == 56 && range_slice_verified(flow.checked, input.source) && row.function == input.function) {
		if (row.kind == 14 && parent.argument == 0 && row.count == 1 && row.type.index == 1) return parent.node;
		if (row.kind == 56 && parent.argument == 0 && row.count == 3 && range_slice_verified(flow.checked, row.source) && row.type.index == input.type.index) return parent.node;
		if (row.kind == 55 && parent.argument == -1 && recover_owner_unwrap(flow.data, row.a) == recover_owner_unwrap(flow.data, value) && checked_kind(flow.checked, row.type) != 31) return parent.node;
	}
	if (row.kind != 4 && !recover_constructor_kind(row.kind) || row.function != input.function || parent.argument < 0 || parent.argument >= row.count) return -1;
	var signature = flow.checked.signatures[flow.checked.symbol_signatures[row.symbol.index].index - 1];
	int offset = 1; if (recover_constructor_kind(row.kind)) offset = 2;
	var channel = flow.checked.types.argument(flow.checked.types, signature.callable, parent.argument + offset);
	if (channel.type.index != input.type.index) return -1;
	if (slot_borrow) {
		if (row.kind != 4 || channel.flags != 2 || checked_kind(flow.checked, channel.type) != 31) return -1;
	} else {
		if (channel.flags != 0 && channel.flags != 2 || checked_kind(flow.checked, channel.type) != 22) return -1;
	}
	return parent.node;
}
