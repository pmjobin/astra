int cfg_add_block(CfgData data, CfgBlock row) {
	if (!data.room(data.block_count)) { return 0; }
	if (data.block_count == len(data.blocks)) {
		var grown = new CfgBlock[syntax_grown_capacity(len(data.blocks), data.block_count + 1)];
		int i = 0;
		while (i < data.block_count) { grown[i] = data.blocks[i]; i = i + 1; }
		swap(data.blocks, grown);
	}
	data.blocks[data.block_count] = row;
	data.block_count = data.block_count + 1;
	return data.block_count;
}
