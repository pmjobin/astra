// Continuation lowering from Core only. Error owners travel on explicit edges.
int recover_cfg_owner(RecoverCfg cfg, int caught) { return cfg.core.count * 2 + cfg.catch_try[caught - 1]; }

int recover_cfg_cleanup(RecoverCfg cfg, int origin, int caught, int stop, int skip, int carry, int next, int depth) {
	if (caught == stop || caught == 0 || cfg.status != 0) return next;
	if (depth > 192) {
		cfg.status = 2;
		return 0;
	}
	var row = cfg.core.nodes[caught - 1].value;
	int tail = recover_cfg_cleanup(cfg, origin, row.caught, stop, skip, carry, next, depth + 1);
	if (caught == skip) return tail;
	return cfg.block(row.function, origin, 32, 0, 0, tail, 0, recover_cfg_owner(cfg, caught), carry, caught);
}

int recover_cfg_error(RecoverCfg cfg, int id, int owner, int skip) {
	var row = cfg.core.nodes[id - 1].value; int destination = cfg.errors[row.function - 1]; int stop = 0;
	if (row.handler > 0) {
		destination = cfg.handlers[row.handler - 1];
		stop = cfg.core.owners.scopes[row.handler - 1];
	}
	int tail = recover_cfg_scope_exit(cfg, id, cfg.core.owners.scopes[id - 1], stop, row.caught, skip, owner, destination, 0);
	int origin = cfg.block(row.function, id, 34, 0, 0, tail, 0, owner, owner, 0); return recover_cfg_abort(cfg, id, owner, origin);
}

int recover_cfg_tree(RecoverCfg cfg, int id, int next, int depth) {
	if (id == 0 || cfg.status != 0) return next;
	if (depth > 192) {
		cfg.status = 2;
		return 0;
	}
	var node = cfg.core.nodes[id - 1]; var row = node.value;
	if (row.kind == 99) return recover_cfg_lazy(cfg, id, next, depth);
	if (row.kind == 102 || row.kind == 115) {
		int operation = cfg.block(row.function, id, row.kind, 0, 0, next, 0, 0, 0, 0);
		RecoverRegion region = {entry = operation, operation = operation, next = next}; cfg.regions[id - 1] = region; return operation;
	}
	if (row.kind == 82 || row.kind == 86) {
		int operation = cfg.block(row.function, id, row.kind, row.a, 0, next, 0, 0, 0, 0);
		RecoverRegion region = {entry = operation, operation = operation, next = next}; cfg.regions[id - 1] = region;
		return operation;
	}
	if (row.kind == 72 || row.kind == 80) return recover_cfg_enum(cfg, id, next, depth);
	if (row.kind == 44) {
		int publish = cfg.block(row.function, id, 44, row.a, 0, next, 0, 0, 0, 0);
		int enter = recover_cfg_commit(cfg, id, publish);
		int head = recover_cfg_tree(cfg, row.a, enter, depth + 1); head = recover_cfg_field_guard(cfg, id, head); RecoverRegion region = {entry = head, operation = publish, next = next}; cfg.regions[id - 1] = region; return head;
	}
	if (row.kind == 45) {
		int operation = cfg.block(row.function, id, 45, row.a, row.b, next, 0, 0, 0, 0);
		int head = recover_cfg_tree(cfg, row.b, operation, depth + 1); head = recover_cfg_tree(cfg, row.a, head, depth + 1);
		RecoverRegion region = {entry = head, operation = operation, next = next}; cfg.regions[id - 1] = region; return head;
	}
	if (row.kind == 43) {
		int place = node.place; var slot = cfg.core.flow.storage.slots[place - 1];
		int publish = cfg.block(row.function, id, 27, row.a, 0, next, 0, 0, 0, 0);
		int retire = cfg.block(row.function, id, 38, place, slot.scope, publish, 0, 0, 0, place);
		int head = recover_cfg_tree(cfg, row.a, retire, depth + 1); RecoverRegion region = {entry = head, operation = publish, next = next}; cfg.regions[id - 1] = region; return head;
	}
	if (row.kind == 89 || row.kind == 28 || row.kind == 29 || row.kind == 41 || row.kind == 42 || row.kind == 75) return recover_cfg_loop(cfg, id, next, depth);
	int operation = 0; int head = next;
	if (row.kind == 61 || row.kind == 76) {
		int store = cfg.block(row.function, id, row.kind, row.a, row.b, next, 0, 0, 0, 0);
		int value = recover_cfg_tree(cfg, row.c, store, depth + 1);
		int guard = cfg.block(row.function, id, 64, row.a, row.b, value, 0, 0, 0, 0);
		int index = recover_cfg_tree(cfg, row.b, guard, depth + 1);
		int input = recover_cfg_tree(cfg, row.a, index, depth + 1);
		RecoverRegion region = {entry = input, operation = store, next = next};
		cfg.regions[id - 1] = region;
		return input;
	}
	if (row.kind == 77) {
		int join = cfg.block(row.function, id, 62, row.b, row.c, next, 0, 0, 0, 0);
		int left_edge = cfg.block(row.function, id, 78, row.b, 0, join, 0, 0, 0, 0);
		int right_edge = cfg.block(row.function, id, 78, row.c, 0, join, 0, 0, 0, 1);
		int left_tail = left_edge; int right_tail = right_edge;
		int left_owner = recover_owner_unwrap(cfg.core.flow.data, row.b); int right_owner = recover_owner_unwrap(cfg.core.flow.data, row.c);
		if (cfg.core.owners.slots[left_owner - 1] > 0) left_tail = cfg.block(row.function, id, 36, left_owner, cfg.core.owners.slots[left_owner - 1], left_edge, 0, 0, 0, id);
		if (cfg.core.owners.slots[right_owner - 1] > 0) right_tail = cfg.block(row.function, id, 36, right_owner, cfg.core.owners.slots[right_owner - 1], right_edge, 0, 0, 0, id);
		int yes = recover_cfg_tree(cfg, row.b, left_tail, depth + 1);
		int no = recover_cfg_tree(cfg, row.c, right_tail, depth + 1);
		int guard = cfg.block(row.function, id, 63, row.a, 0, yes, no, 0, 0, 0);
		int condition_entry = recover_cfg_tree(cfg, row.a, guard, depth + 1);
		RecoverRegion region = {entry = condition_entry, operation = join, next = next};
		cfg.regions[id - 1] = region;
		return condition_entry;
	}
	if (row.kind == 62) {
		int join = cfg.block(row.function, id, 62, row.a, row.b, next, 0, 0, 0, 0);
		int right = recover_cfg_tree(cfg, row.b, join, depth + 1);
		int yes = right;
		int no = join;
		if (!recover_cfg_short_and(cfg, row)) {
			yes = join;
			no = right;
		}
		int guard = cfg.block(row.function, id, 63, row.a, 0, yes, no, 0, 0, 0);
		int left = recover_cfg_tree(cfg, row.a, guard, depth + 1);
		RecoverRegion region = {entry = left, operation = join, next = next};
		cfg.regions[id - 1] = region;
		return left;
	}
	if (row.kind == 20) {
		int scope = cfg.core.owners.scopes[id - 1]; head = recover_cfg_scope_exit(cfg, id, scope, cfg.core.flow.storage.parents[scope], row.caught, 0, 0, next, 0);
		int i = row.count - 1;
		while (i >= 0 && cfg.status == 0) {
			head = recover_cfg_tree(cfg, cfg.core.flow.data.edges[row.first + i], head, depth + 1);
			i = i - 1;
		}
	} else {
		if (row.kind == 21) {
			int yes = recover_cfg_tree(cfg, row.b, next, depth + 1); int no = recover_cfg_tree(cfg, row.c, next, depth + 1);
			operation = cfg.block(row.function, id, 21, row.a, 0, yes, no, 0, 0, 0); head = recover_cfg_tree(cfg, row.a, operation, depth + 1);
		} else {
			if (row.kind == 24) {
				int owner = cfg.core.count * 2 + id;
				int phi = cfg.block(row.function, id, 33, 0, 0, 0, 0, owner, owner, id); cfg.handlers[id - 1] = phi;
				if (phi == 0) return 0;
				int i = 0;
				while (i < row.count) {
					int caught = cfg.core.flow.data.edges[row.first + i];
					cfg.catch_try[caught - 1] = id;
					i = i + 1;
				}
				int dispatch = recover_cfg_error(cfg, id, owner, 0); i = row.count - 1;
				while (i >= 0 && cfg.status == 0) {
					int caught = cfg.core.flow.data.edges[row.first + i]; var clause = cfg.core.nodes[caught - 1].value;
					int retire = cfg.block(row.function, caught, 32, 0, 0, next, 0, owner, 0, caught);
					int body = recover_cfg_tree(cfg, clause.a, retire, depth + 1);
					int test = cfg.block(row.function, caught, 31, 0, 0, body, dispatch, owner, owner, caught);
					RecoverRegion region = {entry = body, operation = test, next = next}; cfg.regions[caught - 1] = region;
					dispatch = test; i = i - 1;
				}
				var saved = cfg.blocks[phi - 1]; saved.next = dispatch; cfg.blocks[phi - 1] = saved;
				operation = phi; head = recover_cfg_tree(cfg, row.a, next, depth + 1);
			} else {
				if (row.kind == 22) {
					operation = cfg.block(row.function, id, 22, row.a, 0, 0, 0, 0, 0, 0);
					head = recover_cfg_scope_exit(cfg, id, cfg.core.owners.scopes[id - 1], 0, row.caught, 0, 0, operation, 0);
					head = recover_cfg_commit(cfg, id, head);
					head = recover_cfg_tree(cfg, row.a, head, depth + 1);
				} else {
					if (row.kind == 23) {
						int owner = row.a; int skip = 0;
						if (row.a == 0) {
							owner = recover_cfg_owner(cfg, row.caught);
							skip = row.caught;
						}
						if (recover_cfg_throw_move(cfg, id)) owner = recover_cfg_move_token(cfg, id);
						operation = recover_cfg_error(cfg, id, owner, skip); int enter = operation; if (recover_cfg_throw_move(cfg, id)) enter = recover_cfg_raise_move(cfg, id, operation); head = recover_cfg_tree(cfg, row.a, enter, depth + 1);
					} else {
						if (row.kind == 26 || row.kind == 27) {
							int tail = next; if (row.kind == 27) {
								operation = cfg.block(row.function, id, 27, row.a, 0, next, 0, 0, 0, 0);
								tail = recover_cfg_commit(cfg, id, operation);
							}
							head = recover_cfg_tree(cfg, row.a, tail, depth + 1);
						}
						else {
							int tail = next; int error = 0;
							if (node.conditional) {
								error = recover_cfg_error(cfg, id, cfg.core.count + id, 0);
								if (row.type.index != 14) tail = cfg.block(row.function, id, 30, 0, 0, next, 0, 0, 0, 0);
							}
							int owner = 0; if (recover_error_new_kind(row.kind)) owner = id;
							operation = cfg.block(row.function, id, row.kind, row.a, row.b, tail, error, owner, 0, 0); head = operation; if (row.kind == 4 || recover_constructor_kind(row.kind) || row.kind == 19 || row.kind == 69 || row.kind == 71) head = recover_cfg_commit(cfg, id, operation);
							int i = row.count - 1;
							while (i >= 0 && cfg.status == 0) {
								// Check the evaluated receiver before explicit arguments.
								if (i == 0 && row.kind == 4 && recover_static_method(cfg.core.flow.checked, row.symbol)) {
									int fatal = cfg.block(row.function, id, 35, 0, 0, 0, 0, 0, 0, 0);
									head = cfg.block(row.function, id, 16, cfg.core.flow.data.edges[row.first], 0, head, fatal, 0, 0, 0);
								}
								int slot = i;
								if (row.kind == 4 || row.kind == 50 || recover_constructor_kind(row.kind)) slot = checked_named_argument_slot(cfg.core.flow.checked, row.source, row.symbol, row.count, i);
								if (slot < 0 || slot >= row.count) {
									cfg.status = 4;
									break;
								}
								head = recover_cfg_tree(cfg, cfg.core.flow.data.edges[row.first + slot], head, depth + 1);
								i = i - 1;
							}
							if (row.kind == 17 || row.kind == 18) head = recover_cfg_field_guard(cfg, id, head);
							if (row.b != 0) head = recover_cfg_tree(cfg, row.b, head, depth + 1);
							if (row.a != 0) head = recover_cfg_tree(cfg, row.a, head, depth + 1);
						}
					}
				}
			}
		}
	}
	RecoverRegion region = {entry = head, operation = operation, next = next}; cfg.regions[id - 1] = region; return head;
}

owned RecoverCfg recover_cfg_lower(owned RecoverCore core, int limit) {
	bool valid = recover_core_verify(core); var cfg = new RecoverCfg(move core, limit);
	if (!valid) {
		cfg.status = 4;
		return move cfg;
	}
	int f = 0;
	while (f < cfg.core.flow.data.function_count && cfg.status == 0) {
		cfg.begin_function(f + 1);
		var function = cfg.core.flow.data.functions[f]; int owner = cfg.core.count * 3 + f + 1;
		int opcode = 35; if (function.checked) opcode = 23;
		int error = cfg.block(f + 1, 0, opcode, 0, 0, 0, 0, owner, 0, 0);
		int phi = cfg.block(f + 1, 0, 33, 0, 0, error, 0, owner, owner, 0); cfg.errors[f] = phi;
		int terminal = 35; if (function.result.index == 14) terminal = 22;
		int exit = cfg.block(f + 1, 0, terminal, 0, 0, 0, 0, 0, 0, 0);
		cfg.terminals[f] = exit; int continuation = exit; if (function.result.index == 14) continuation = recover_cfg_scope_exit(cfg, function.body, cfg.core.owners.functions[f], 0, 0, 0, 0, exit, 0);
		int entry = recover_cfg_tree(cfg, function.body, continuation, 0); cfg.entries[f] = entry; f = f + 1;
	}
	if (cfg.status != 0) return move cfg;
	var edges = new RecoverCfgEdge[cfg.block_count * 2];
	cfg.edges = move edges;
	int b = 0;
	while (b < cfg.block_count && cfg.status == 0) {
		var block = cfg.blocks[b]; int p = 1;
		while (p <= 2) {
			int target = block.next; int owner = block.carry;
			if (p == 2) {
				target = block.other;
				if (block.opcode == 4) owner = cfg.core.count + block.origin;
			}
			if (target != 0) {
				RecoverCfgEdge edge = {source = b + 1, target = target, polarity = p, owner = owner};
				cfg.edges[cfg.edge_count] = edge;
				cfg.edge_count = cfg.edge_count + 1;
			}
			p = p + 1;
		}
		b = b + 1;
	}
	if (cfg.status == 0 && !recover_cfg_verify(cfg)) cfg.status = 1;
	return move cfg;
}
