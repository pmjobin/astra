// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
language astra27b;
// The condition entry exists before lowering the body, so continue targets
// the actual condition evaluation, including its checked-call error edge.
int recover_cfg_loop(RecoverCfg cfg, int id, int next, int depth) {
	var row = cfg.core.nodes[id - 1].value; int operation = 0; int head = 0;
	if (row.kind == 89) {
		int check = cfg.block(row.function, id, opcode: 90, a: row.a, b: 0, next: 0, other: next, owner: 0, carry: 0, rank: 0);
		int increment = cfg.block(row.function, id, opcode: 92, a: 0, b: 0, next: check, other: 0, owner: 0, carry: 0, rank: 0);
		int advance = cfg.block(row.function, id, opcode: 91, a: row.a, b: 0, next: increment, other: next, owner: 0, carry: 0, rank: 0);
		operation = cfg.block(row.function, id, opcode: 89, a: row.a, b: 0, next: check, other: 0, owner: 0, carry: 0, rank: advance);
		if (operation == 0) return 0;
		cfg.regions[id - 1] = RecoverRegion {entry = operation, operation, next};
		int body = recover_cfg_tree(cfg, row.b, advance, depth + 1);
		var branch = cfg.blocks[check - 1]; branch.next = body; cfg.blocks[check - 1] = branch;
		head = recover_cfg_tree(cfg, row.a, operation, depth + 1);
	}
	if (row.kind == 28) {
		operation = cfg.block(row.function, id, opcode: 21, a: row.a, b: 0, next: 0, other: next, owner: 0, carry: 0, rank: 0);
		if (operation == 0) return 0;
		head = recover_cfg_tree(cfg, row.a, operation, depth + 1);
		cfg.regions[id - 1] = RecoverRegion {entry = head, operation, next};
		int body = recover_cfg_tree(cfg, row.b, head, depth + 1); var branch = cfg.blocks[operation - 1]; branch.next = body; cfg.blocks[operation - 1] = branch;
	}
	if (row.kind == 29 || row.kind == 41) {
		var loop = cfg.regions[row.c - 1]; int destination = loop.next; if (row.kind == 41) {
			destination = loop.entry;
			if (cfg.core.nodes[row.c - 1].value.kind == 89) {
				if (loop.operation < 1 || loop.operation > cfg.block_count) return 0;
				destination = cfg.blocks[loop.operation - 1].rank;
			}
		}
		operation = cfg.block(row.function, id, opcode: row.kind, a: 0, b: 0, next: destination, other: 0, owner: 0, carry: 0, rank: 0);
		head = recover_cfg_scope_exit(cfg, id, cfg.core.owners.scopes[id - 1], cfg.core.owners.scopes[row.c - 1], row.caught, 0, 0, operation, 0);
	}
	if (row.kind == 42 || row.kind == 75) {
		operation = cfg.block(row.function, id, opcode: row.kind, a: row.a, b: 0, next: next, other: 0, owner: 0, carry: 0, rank: 0);
		head = recover_cfg_tree(cfg, row.a, operation, depth + 1);
	}
	cfg.regions[id - 1] = RecoverRegion {entry = head, operation, next}; return head;
}

bool recover_cfg_check_loop(RecoverCfg cfg, int id, int next, bool[] seen, bool[] nodes, int depth) {
	var row = cfg.core.nodes[id - 1].value; var region = cfg.regions[id - 1]; int operation = region.operation;
	if (row.kind == 89) {
		if (operation < 1 || operation > cfg.block_count) return false;
		int check = cfg.blocks[operation - 1].next; int advance = cfg.blocks[operation - 1].rank;
		if (check < 1 || check > cfg.block_count || advance < 1 || advance > cfg.block_count) return false;
		int increment = cfg.blocks[advance - 1].next; int body = cfg.regions[row.b - 1].entry;
		if (!recover_cfg_expect(cfg, operation, recover_cfg_expected(row.function, id, 89, row.a, 0, check, 0, 0, 0, advance), seen) || !recover_cfg_expect(cfg, check, recover_cfg_expected(row.function, id, 90, row.a, 0, body, next, 0, 0, 0), seen) || !recover_cfg_expect(cfg, advance, recover_cfg_expected(row.function, id, 91, row.a, 0, increment, next, 0, 0, 0), seen) || !recover_cfg_expect(cfg, increment, recover_cfg_expected(row.function, id, 92, 0, 0, check, 0, 0, 0, 0), seen)) return false;
		return recover_cfg_check_tree(cfg, row.a, operation, seen, nodes, depth + 1) && region.entry == cfg.regions[row.a - 1].entry && recover_cfg_check_tree(cfg, row.b, advance, seen, nodes, depth + 1);
	}
	if (row.kind == 28) {
		int body = cfg.regions[row.b - 1].entry;
		return recover_cfg_expect(cfg, operation, recover_cfg_expected(row.function, id, 21, row.a, 0, body, next, 0, 0, 0), seen) && recover_cfg_check_tree(cfg, row.a, operation, seen, nodes, depth + 1) && region.entry == cfg.regions[row.a - 1].entry && recover_cfg_check_tree(cfg, row.b, region.entry, seen, nodes, depth + 1);
	}
	if (row.kind == 29 || row.kind == 41) {
		var loop = cfg.regions[row.c - 1]; int destination = loop.next; if (row.kind == 41) {
			destination = loop.entry;
			if (cfg.core.nodes[row.c - 1].value.kind == 89) {
				if (loop.operation < 1 || loop.operation > cfg.block_count) return false;
				destination = cfg.blocks[loop.operation - 1].rank;
			}
		}
		return recover_cfg_expect(cfg, operation, recover_cfg_expected(row.function, id, row.kind, 0, 0, destination, 0, 0, 0, 0), seen) && recover_cfg_check_scope_exit(cfg, region.entry, id, cfg.core.owners.scopes[id - 1], cfg.core.owners.scopes[row.c - 1], row.caught, 0, 0, operation, seen);
	}
	return (row.kind == 42 || row.kind == 75) && recover_cfg_expect(cfg, operation, recover_cfg_expected(row.function, id, row.kind, row.a, 0, next, 0, 0, 0, 0), seen) && recover_cfg_check_tree(cfg, row.a, operation, seen, nodes, depth + 1) && region.entry == cfg.regions[row.a - 1].entry;
}
