// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Explore each genuine owner slot over the actual CFG. States distinguish
// dead, live, and live with one pending reservation; nullness is irrelevant.
// No producer-supplied liveness or definite-assignment certificate is trusted.
class RecoverSsaOwnerIndex {
	owned int[] starts;
	owned int[] positions;
	owned int[] blocks;
	owned int[] reservations;
	owned int[] moves;
	owned int[] shortcuts;
	// A fresh SSA verifier sets this only after its complete physical scan.
	// Standalone callers reconstruct reservations from the verified Core.
	bool reservations_ready;

	init(RecoverCfg cfg) {
		this.starts = new int[len(cfg.entries) + 1];
		this.positions = new int[cfg.block_count];
		this.blocks = new int[cfg.block_count];
		this.reservations = new int[cfg.core.count];
		this.moves = new int[cfg.core.flow.storage.count];
		this.shortcuts = new int[cfg.block_count + 1];
		this.reservations_ready = false;
	}
}

void recover_ssa_owner_shortcut(RecoverSsaOwnerIndex index, RecoverCfg cfg, int b) {
	var row = cfg.blocks[b]; int place = 0;
	if (row.origin > 0) {
		int symbol = cfg.core.nodes[row.origin - 1].value.symbol.index;
		if (symbol > 0 && symbol < len(cfg.core.flow.storage.symbols)) place = cfg.core.flow.storage.symbols[symbol];
	}
	bool event = row.opcode == 22 || row.opcode == 23 || row.opcode == 36 || row.opcode == 37 || row.opcode == 38 || row.next > 0 && row.other > 0;
	if (place > 0 && cfg.core.flow.storage.slots[place - 1].owner && (row.opcode == 2 || row.opcode == 10 || row.opcode == 12 || row.opcode == 17 || row.opcode == 18 || row.opcode == 44 || row.opcode == 46 || row.opcode == 27)) event = true;
	int target = row.next; if (target == 0) target = row.other;
	if (!event && target <= b) index.shortcuts[b + 1] = index.shortcuts[target];
	else {
		index.shortcuts[b + 1] = b + 1;
	}
}

bool recover_ssa_owner_index(RecoverSsaOwnerIndex index, RecoverCfg cfg, RecoverWork work) {
	int b = 0;
	if (len(work.function_counts) == len(index.starts)) {
		int function = 1;
		while (function < len(index.starts)) {
			if (!work.take()) return false;
			index.starts[function] = work.function_counts[function];
			function = function + 1;
		}
	} else {
		while (b < cfg.block_count) {
			if (!work.take()) return false;
			int function = cfg.blocks[b].function;
			if (function < 1 || function >= len(index.starts)) return false;
			index.starts[function] = index.starts[function] + 1;
			b = b + 1;
		}
	}
	int f = 1;
	while (f < len(index.starts)) {
		index.starts[f] = index.starts[f] + index.starts[f - 1];
		f = f + 1;
	}
	var used = new int[len(cfg.entries)]; b = 0;
	while (b < cfg.block_count) {
		if (!work.take()) return false;
		f = cfg.blocks[b].function - 1;
		int position = used[f]; used[f] = position + 1;
		index.positions[b] = position;
		index.blocks[index.starts[f] + position] = b + 1;
		recover_ssa_owner_shortcut(index, cfg, b);
		b = b + 1;
	}
	if (!index.reservations_ready) {
		int n = 0;
		while (n < cfg.core.count) {
			if (!work.take()) return false;
			int place = cfg.core.owners.slots[n];
			if (place != 0) {
				if (place < 1 || place > len(index.moves)) return false;
				index.reservations[n] = index.moves[place - 1] + 2;
				index.moves[place - 1] = index.moves[place - 1] + 1;
			}
			n = n + 1;
		}
		index.reservations_ready = true;
	}
	return true;
}

bool recover_ssa_slot(RecoverSsa ssa, int place, RecoverSsaOwnerIndex index, RecoverWork work) {
	var slot = ssa.cfg.core.flow.storage.slots[place - 1]; if (!slot.owner) return true;
	int versions = index.moves[place - 1] + 2;
	int first = index.starts[slot.function - 1]; int blocks = index.starts[slot.function] - first;
	if (blocks > 8000000 / versions) {
		work.exhausted = true;
		return false;
	}
	int capacity = blocks * versions; var seen = new bool[capacity]; var pending = new int[capacity]; int entry = ssa.cfg.entries[slot.function - 1]; int state = 0; if (slot.parameter) state = 1; int start = index.positions[entry - 1] * versions + state; pending[0] = start; seen[start] = true; int count = 1;
	while (count > 0) {
		if (!work.take()) return false; count = count - 1; int item = pending[count]; int block = index.blocks[first + item / versions]; int before = item % versions; int after = before; var row = ssa.cfg.blocks[block - 1];
		SyntaxNodeId absent = {index = 0}; var source = recover_empty(absent, 0, type_id(14), 0, 0); if (row.origin > 0) source = ssa.cfg.core.nodes[row.origin - 1].value;
		if ((row.opcode == 2 || row.opcode == 10 || row.opcode == 12 || row.opcode == 17 || row.opcode == 18 || row.opcode == 44 || row.opcode == 46) && source.symbol.index == slot.symbol.index) {
			if (before == 0) return false;
			if (row.opcode == 10) {
				if (before != 1 || ssa.cfg.core.owners.slots[row.origin - 1] != place || index.reservations[row.origin - 1] < 2) return false;
				after = index.reservations[row.origin - 1];
			}
		}
		if (row.opcode == 27 && source.symbol.index == slot.symbol.index) {
			if (before != 0) return false;
			after = 1;
		}
		if (row.opcode == 36 && row.b == place) {
			if (row.a < 1 || row.a > len(index.reservations) || ssa.cfg.core.owners.slots[row.a - 1] != place || before != index.reservations[row.a - 1] || before < 2) return false;
			after = 0;
		}
		if (row.opcode == 37 && row.b == place) {
			if (row.a < 1 || row.a > len(index.reservations) || ssa.cfg.core.owners.slots[row.a - 1] != place || before != index.reservations[row.a - 1] || before < 2) return false;
			after = 1;
		}
		if (row.opcode == 38 && row.a == place) {
			if (before >= 2) return false;
			after = 0;
		}
		if ((row.opcode == 22 || row.opcode == 23) && after != 0) return false;
		int polarity = 0; while (polarity < 2) {
			int target = row.next;
			if (polarity == 1) target = row.other;
			if (target > 0) {
				if (ssa.cfg.blocks[target - 1].function != slot.function) return false;
				int next = index.positions[target - 1] * versions + after;
				if (!seen[next]) {
					seen[next] = true;
					pending[count] = next;
					count = count + 1;
				}
			}
			polarity = polarity + 1;
		}
	} return true;
}

bool recover_ssa_slots(RecoverSsa ssa, RecoverSsaOwnerIndex index, RecoverWork work) {
	if (!recover_owners_verify(ssa.cfg.core.owners, ssa.cfg.core.flow)) return false;
	int place = 1;
	while (place <= ssa.cfg.core.flow.storage.count && !ssa.cfg.core.flow.storage.slots[place - 1].owner) place = place + 1;
	if (place > ssa.cfg.core.flow.storage.count) return !work.exhausted;
	if (!recover_ssa_owner_index(index, ssa.cfg, work)) return false;
	return recover_ssa_packed_slots(ssa, index, work);
}

// Ordinary owned temporaries are distinct from both Error tokens and slots.
// Their unique consumer must execute before every returning normal/error exit.
bool recover_ssa_temporary(RecoverSsaData data, RecoverCfg cfg, int value, RecoverWork work) {
	var definition = data.values[value]; int consumer = cfg.core.owners.consumers[value - 1]; if (consumer < 1) return false;
	int consumer_block = 0;
	if (consumer < len(work.temporary_consumers)) consumer_block = work.temporary_consumers[consumer];
	int gate = -1;
	if (consumer_block > 0 && consumer_block < len(work.dominance_cycle_gate)) gate = work.dominance_cycle_gate[consumer_block];
	bool restart = gate >= 0 && consumer_block != definition.block && recover_ssa_dominates(definition.block, consumer_block, work) && (gate == 0 || recover_ssa_dominates(gate, definition.block, work));
	int start = cfg.blocks[definition.block - 1].next; if (start == 0) return false; var seen = new bool[cfg.block_count * 2]; var pending = new int[cfg.block_count * 2]; int count = 1; pending[0] = (start - 1) * 2 + 1; seen[pending[0]] = true;
	while (count > 0) { if (!work.take()) return false; count = count - 1; int item = pending[count]; int block = item / 2 + 1; bool live = item % 2 == 1; var row = cfg.blocks[block - 1];
		if (block == definition.block) {
			if (live) return false;
			live = true;
		}
		if (row.origin == consumer && (row.opcode == 22 || row.opcode == 27 || row.opcode == 4 || row.opcode == 69 || row.opcode == 62 && (cfg.core.nodes[row.origin - 1].value.kind == 77 || cfg.core.nodes[row.origin - 1].value.kind == 80) || (row.opcode == 11 || row.opcode == 67) || row.opcode == 44)) {
			if (!live) return false;
			live = false;
			// With one physical consumer, every cycle back to it passes the
			// definition again. Its fresh live paths are already explored from
			// that definition; a dead suffix cannot add a second consumption.
			// Ambiguous consumers or unproved cycle gates retain the full walk.
			if (restart) continue;
		}
		if ((row.opcode == 22 || row.opcode == 23) && live) return false;
		int polarity = 0; while (polarity < 2) {
			int target = row.next;
			if (polarity == 1) target = row.other;
			if (target > 0) {
				int next = (target - 1) * 2;
				if (live) next = next + 1;
				if (!seen[next]) {
					seen[next] = true;
					pending[count] = next;
					count = count + 1;
				}
			}
			polarity = polarity + 1;
		}
	} return true;
}
