// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Follow every actual path from a slice definition to its call consumer. A
// retired backing or replacement of its captured field cannot reach that use.
bool recover_ssa_array_view(RecoverSsa ssa, int value, RecoverWork work) {
	var row = ssa.cfg.core.nodes[value - 1].value;
	if (row.kind != 56) return true;
	var root = recover_array_root(ssa.cfg.core.flow, ssa.cfg.core.flow.data.edges[row.first], false);
	if (root.index < 1 || root.index >= len(ssa.cfg.core.flow.storage.symbols)) return false;
	int slot = ssa.cfg.core.flow.storage.symbols[root.index];
	if (slot < 1 || slot > ssa.cfg.core.flow.storage.count || ssa.cfg.core.nodes[value - 1].result_role != 3 || ssa.cfg.core.nodes[value - 1].borrowed_owner != slot) return false;
	var budget = new RecoverOwnerBudget();
	budget.remaining = work.remaining;
	int consumer = recover_slice_consumer(ssa.cfg.core.flow, value, budget);
	work.remaining = budget.remaining;
	if (budget.exhausted) work.exhausted = true;
	if (consumer < 1 || consumer > ssa.cfg.core.count || !recover_storage_outlives(ssa.cfg.core.flow.storage, ssa.cfg.core.flow.storage.slots[slot - 1].scope, ssa.cfg.core.owners.scopes[consumer - 1])) return false;
	int use = ssa.cfg.regions[consumer - 1].operation;
	int definition = ssa.data.values[value].block;
	if (definition < 1 || definition > ssa.cfg.block_count || use < 1 || use > ssa.cfg.block_count) return false;
	int input = recover_owner_unwrap(ssa.cfg.core.flow.data, ssa.cfg.core.flow.data.edges[row.first]);
	var seen = new bool[ssa.cfg.block_count * 2];
	var pending = new int[ssa.cfg.block_count * 2];
	int start = ssa.cfg.blocks[definition - 1].next;
	if (start == 0) return false;
	int count = 1;
	pending[0] = (start - 1) * 2 + 1;
	seen[pending[0]] = true;
	bool reached = false;
	while (count > 0) {
		if (!work.take()) return false;
		count = count - 1;
		int state = pending[count];
		int id = state / 2 + 1;
		bool live = state % 2 == 1;
		var block = ssa.cfg.blocks[id - 1];
		if (id == definition) live = true;
		if (block.opcode == 36 && block.b == slot || block.opcode == 38 && block.a == slot) live = false;
		if (block.opcode == 44) {
			var target = ssa.cfg.core.flow.fields.facts[ssa.cfg.core.nodes[block.origin - 1].value.source.index];
			int projection = input;
			int depth = 0;
			while (projection > 0 && depth < 192) {
				if (!work.take()) return false;
				var source = ssa.cfg.core.nodes[projection - 1].value;
				if (source.kind != 17) break;
				var fact = ssa.cfg.core.flow.fields.facts[source.source.index];
				if (target.slot == slot && target.field.index == fact.field.index) live = false;
				projection = fact.parent;
				depth = depth + 1;
			}
			if (depth == 192) return false;
		}
		if (id == use) {
			if (!live) return false;
			reached = true;
			continue;
		}
		int p = 0;
		while (p < 2) {
			int target = block.next;
			if (p == 1) target = block.other;
			if (target > 0) {
				int next = (target - 1) * 2;
				if (live) next = next + 1;
				if (!seen[next]) {
					seen[next] = true;
					pending[count] = next;
					count = count + 1;
				}
			}
			p = p + 1;
		}
	}
	return reached && !work.exhausted;
}
