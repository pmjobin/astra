int ssa_variable_for(SsaData data, int kind, int origin) {
	int i = 0; while (i < data.variable_count) {
		if (data.variables[i].kind == kind && data.variables[i].origin == origin) return i + 1;
		i = i + 1;
	} return 0;
}

int ssa_temp_value(SsaData data, int temp) {
	int i = 0; while (i < data.instruction_count) {
		if (data.instructions[i].origin.result == temp && temp != 0) return data.instructions[i].result;
		i = i + 1;
	} return 0;
}

bool ssa_scalar(TypeId type, int flags) { return type.index >= 1 && type.index <= 13 && flags == 0; }

// A sufficient local proof, deliberately conservative. No address operation,
// move, borrow, field observer, cleanup or indirect call can expose this place.
bool ssa_promotable(CoreData core, CfgData cfg, int place) {
	var p = core.places[place - 1];
	if (!ssa_scalar(p.type, p.flags) || p.parent != 0 || !p.leaf) return false;
	int i = 0;
	while (i < cfg.instruction_count) {
		var row = cfg.instructions[i];
		if (row.value.place == place && (row.opcode != 3 && row.opcode != 21 && row.opcode != 22)) return false;
		if (row.opcode == 3 && row.value.place == place && row.value.flags != 0) return false;
		i = i + 1;
	}
	i = 0;
	while (i < core.place_count) {
		if (core.places[i].parent == place) return false;
		i = i + 1;
	}
	return true;
}

void ssa_set_status(SsaData data, int status) { data.status = status; }

void ssa_set_graph(SsaData data, owned SsaGraph graph) { data.graph = move graph; }

// Charge conservative bounded scan work before unmetered arena setup loops.
bool ssa_reserve_work(SsaBudget budget, int count, int width) {
	if (count < 0 || width < 1 || count > budget.remaining / width) {
		budget.exhausted = true;
		return false;
	}
	return budget.take(count * width);
}
