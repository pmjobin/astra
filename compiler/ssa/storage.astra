int ssa_add_value(SsaData data, SsaValue row) {
	if (!data.room(data.value_count)) return 0;
	if (data.value_count == len(data.values)) {
		var grown = new SsaValue[syntax_grown_capacity(len(data.values), data.value_count + 1)];
		int i = 0; while (i < data.value_count) {
			grown[i] = data.values[i];
			i = i + 1;
		}
		swap(data.values, grown);
	}
	data.values[data.value_count] = row; data.value_count = data.value_count + 1; return data.value_count;
}

