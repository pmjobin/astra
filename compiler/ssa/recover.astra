// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Normal values and error owners occupy disjoint SSA identities. A checked
// result is defined by its success load, never by the nullable-error call.
struct RecoverValue { int function; int block; TypeId type; int channel; int edge; }

class RecoverWork {
	int remaining;
	bool exhausted;
	owned int[] dominance_first;
	owned int[] dominance_end;
	owned int[] dominance_cycle_gate;
	owned int[] temporary_consumers;
	owned int[] function_counts;
	owned int[] owner_shortcuts;

	init(int limit) {
		this.remaining = limit;
		this.exhausted = limit < 1 || limit > 8000000;
		this.dominance_first = new int[0];
		this.dominance_end = new int[0];
		this.dominance_cycle_gate = new int[0];
		this.temporary_consumers = new int[0];
		this.function_counts = new int[0];
		this.owner_shortcuts = new int[0];
	}

	bool take() { if (this.exhausted || this.remaining == 0) {
			this.exhausted = true;
			return false;
		} this.remaining = this.remaining - 1; return true; }
}

class RecoverSsaData {
	owned RecoverValue[] values;
	owned bool[] reachable;
	int status;
	int work_limit;

	init(int values, int blocks, int work_limit) { this.values = new RecoverValue[values]; this.reachable = new bool[blocks]; this.status = 0; this.work_limit = work_limit; }

	void fail(int status) { this.status = status; }
}

class RecoverSsa {
	owned RecoverCfg cfg;
	owned RecoverSsaData data;

	init(owned RecoverCfg cfg, int work_limit) {
		int values = cfg.core.count * 4 + cfg.core.flow.data.function_count + 1; int blocks = cfg.block_count; this.cfg = move cfg;
		var data = new RecoverSsaData(values, blocks, work_limit); this.data = move data;
	}
}

bool recover_ssa_reach(RecoverCfg cfg, bool[] reachable, RecoverWork work) {
	var pending = new int[cfg.block_count]; int f = 0;
	while (f < len(cfg.entries)) {
		int count = 1; pending[0] = cfg.entries[f]; reachable[pending[0] - 1] = true;
		while (count > 0) {
			if (!work.take()) return false;
			count = count - 1; var block = cfg.blocks[pending[count] - 1]; int p = 0;
			while (p < 2) {
				int target = block.next; if (p == 1) target = block.other;
				if (target != 0 && !reachable[target - 1]) {
					reachable[target - 1] = true;
					pending[count] = target;
					count = count + 1;
				}
				p = p + 1;
			}
		}
		f = f + 1;
	}
	return true;
}

// Walk the checked successor graph once. The rank table is also the discovery
// mark until the postorder is complete.
int recover_ssa_dominance_order(RecoverBlock[] blocks, int count, int[] entries, int[] post, int[] rank, int[] limits, int[] loops, int[] dfs_parent, RecoverWork work) {
	var stack = new int[count]; var next_edge = new int[count + 1]; int reached = 0;
	int f = 0;
	while (f < len(entries)) {
		int root = entries[f];
		if (root < 1 || root > count || rank[root] != 0 || blocks[root - 1].function != f + 1) return -1;
		limits[f] = reached;
		int depth = 1; stack[0] = root; rank[root] = -1;
		while (depth > 0) {
			if (!work.take()) return -1;
			int node = stack[depth - 1];
			if (next_edge[node] == 0) {
				next_edge[node] = 1;
				int target = blocks[node - 1].next;
				if (target < 0 || target > count) return -1;
				if (target > 0 && rank[target] == -1 && loops[target] == 0) {
					loops[target] = 1;
				}
				if (target > 0 && rank[target] == 0) {
					dfs_parent[target] = node;
					rank[target] = -1;
					stack[depth] = target;
					depth = depth + 1;
					continue;
				}
			}
			if (next_edge[node] == 1) {
				next_edge[node] = 2;
				int target = blocks[node - 1].other;
				if (target < 0 || target > count) return -1;
				if (target > 0 && rank[target] == -1 && loops[target] == 0) {
					loops[target] = 1;
				}
				if (target > 0 && rank[target] == 0) {
					dfs_parent[target] = node;
					rank[target] = -1;
					stack[depth] = target;
					depth = depth + 1;
					continue;
				}
			}
			post[reached] = node;
			rank[node] = -reached - 2;
			reached = reached + 1;
			depth = depth - 1;
		}
		f = f + 1;
		limits[f] = reached;
	}
	return reached;
}

// Reconstruct predecessors and immediate dominators from the checked CFG.
// All scans, chain intersections and queries use the verifier's work budget.
bool recover_ssa_build_dominance(RecoverBlock[] blocks, int count, int[] entries, RecoverWork work) {
	if (count < 1 || count > 8000000 || count > len(blocks) || len(entries) == 0 || len(entries) > count || work.exhausted) return false;
	if (count > work.remaining) {
		work.exhausted = true;
		return false;
	}
	var incoming = new int[count + 1]; var links = new int[count * 2 + 1]; var functions = new int[len(entries) + 1];
	int b = 1;
	while (b <= count) {
		if (!work.take()) return false;
		int function = blocks[b - 1].function;
		if (function < 1 || function >= len(functions)) return false;
		functions[function] = functions[function] + 1;
		int p = 0;
		while (p < 2) {
			int target = blocks[b - 1].next;
			if (p == 1) target = blocks[b - 1].other;
			if (target < 0 || target > count) return false;
			if (target > 0) {
				if (blocks[target - 1].function != blocks[b - 1].function) return false;
				int edge = (b - 1) * 2 + p + 1;
				links[edge] = incoming[target];
				incoming[target] = edge;
			}
			p = p + 1;
		}
		b = b + 1;
	}
	var post = new int[count]; var rank = new int[count + 1]; var limits = new int[len(entries) + 1];
	var loops = new int[count + 1]; var dfs_parent = new int[count + 1];
	int reached = recover_ssa_dominance_order(blocks, count, entries, post, rank, limits, loops, dfs_parent, work);
	if (reached < 1) return false;
	var parent = new int[count + 1];
	// Finished negative postorder ranks already have reverse-postorder order.
	// Their common offset is irrelevant; no separate rank assignment scan.
	int i = 0;
	int f = 0;
	while (f < len(entries)) {
		parent[entries[f]] = entries[f];
		f = f + 1;
	}
	// Functions have disjoint successor graphs. Converge each postorder range
	// separately so a loop in one function cannot rescan every other function.
	f = 0;
	while (f < len(entries)) {
		bool changed = true; bool initial = true;
		while (changed) {
			changed = false; bool unknown = false;
			i = limits[f + 1] - 1;
			while (i >= limits[f]) {
				if (!work.take()) return false;
				int node = post[i]; i = i - 1;
				if (parent[node] == node) continue;
				int candidate = 0; int edge = incoming[node];
				while (edge > 0) {
					if (!work.take()) return false;
					int predecessor = (edge - 1) / 2 + 1; edge = links[edge];
					if (parent[predecessor] == 0) {
						unknown = true;
						continue;
					}
					if (candidate == 0) {
						candidate = predecessor;
						continue;
					}
					while (candidate != predecessor) {
						if (!work.take()) return false;
						if (parent[candidate] == candidate) {
							predecessor = candidate;
							continue;
						}
						if (parent[predecessor] == predecessor) {
							candidate = predecessor;
							continue;
						}
						if (parent[candidate] == parent[predecessor]) {
							candidate = parent[candidate];
							predecessor = candidate;
							continue;
						}
						if (rank[candidate] > rank[predecessor]) candidate = parent[candidate];
						else {
							predecessor = parent[predecessor];
						}
					}
				}
				if (candidate == 0 || rank[candidate] >= rank[node]) return false;
				if (parent[node] != candidate) {
					parent[node] = candidate;
					changed = true;
				}
			}
			// With no unknown predecessor on the first pass, each dependency
			// was already final in this range. No confirmation pass is needed.
			if (initial && !unknown) changed = false;
			initial = false;
		}
		f = f + 1;
	}
	var sizes = new int[count + 1]; var cursor = new int[count + 1];
	var levels = new int[count + 1]; var gates = new int[count + 1];
	// The final parent always precedes its child in reverse postorder. Derive
	// gates forwards while accumulating subtree sizes in the opposite order.
	i = reached - 1;
	while (i >= 0) {
		if (!work.take()) return false;
		int bottom = post[reached - 1 - i]; int upper = parent[bottom];
		sizes[bottom] = sizes[bottom] + 1;
		if (upper != bottom) sizes[upper] = sizes[upper] + sizes[bottom];
		int node = post[i]; int ancestor = parent[node];
		if (ancestor != node) {
			levels[node] = levels[ancestor] + 1;
		}
		int gate = gates[dfs_parent[node]];
		if (loops[node] != 0 && gate >= 0) {
			if (gate == 0) gate = node;
			else {
				int left = gate; int right = node;
				while (levels[left] > levels[right]) {
					if (!work.take()) return false;
					left = parent[left];
				}
				while (levels[right] > levels[left]) {
					if (!work.take()) return false;
					right = parent[right];
				}
				if (left != right) gate = -1;
				else {
					if (levels[node] > levels[gate]) gate = node;
				}
			}
		}
		gates[node] = gate;
		i = i - 1;
	}
	var first = new int[count + 1]; var end = new int[count + 1];
	// Reserve each complete child interval in sibling order. Parents are ready
	// before children, so one pass reproduces the prior tree DFS intervals.
	int stamp = 1; f = 0;
	while (f < len(entries)) {
		int root = entries[f]; i = limits[f + 1] - 1;
		while (i >= limits[f]) {
			if (!work.take()) return false;
			int node = post[i]; int ancestor = parent[node];
			if (node == root) first[node] = stamp;
			else {
				first[node] = cursor[ancestor];
			}
			end[node] = first[node] + sizes[node]; cursor[node] = first[node] + 1;
			if (sizes[node] < 1 || first[node] < stamp) return false;
			if (node != root) {
				if (first[node] <= first[ancestor] || end[node] > end[ancestor]) return false;
				cursor[ancestor] = end[node];
			}
			i = i - 1;
		}
		stamp = stamp + sizes[root];
		f = f + 1;
	}
	if (stamp != reached + 1) return false;
	work.dominance_first = move first;
	work.dominance_end = move end;
	work.dominance_cycle_gate = move gates;
	work.function_counts = move functions;
	return true;
}

bool recover_ssa_dominates(int definition, int use, RecoverWork work) {
	if (!work.take() || definition < 1 || use < 1 || definition >= len(work.dominance_first) || use >= len(work.dominance_first)) return false;
	int anchor = work.dominance_first[definition]; int point = work.dominance_first[use];
	return point == 0 || anchor > 0 && anchor <= point && point < work.dominance_end[definition];
}

int recover_ssa_definition(RecoverCfg cfg, int block) {
	var row = cfg.blocks[block - 1]; if (row.origin == 0) {
		if (row.opcode == 33) return row.owner;
		return 0;
	}
	if (row.opcode == 16) return 0;
	if (row.opcode == 33) return row.owner;
	if (row.opcode == 39) return row.owner;
	if (row.opcode == 30) return row.origin;
	if (row.opcode == 109) return row.origin;
	if (row.opcode == 4 && cfg.core.nodes[row.origin - 1].conditional) return cfg.core.count + row.origin;
	if (recover_value_kind(row.opcode) && cfg.core.nodes[row.origin - 1].value.type.index != 14) return row.origin;
	return 0;
}

RecoverValue recover_ssa_expected(RecoverCfg cfg, int block) {
	var row = cfg.blocks[block - 1]; TypeId type = {index = 0}; int channel = 0; int edge = 0;
	if (row.opcode == 39) {
		channel = 5;
		edge = row.next;
		type = cfg.core.nodes[row.a - 1].value.type;
	}
	else { if (row.opcode == 33) {
			channel = 3;
			var root = checked_effect_root(cfg.core.flow.checked);
			type = cfg.core.flow.checked.symbol_types[root.index];
		}
		else {
			if (row.opcode == 4 && cfg.core.nodes[row.origin - 1].conditional) {
				channel = 2;
				edge = row.other;
				type = cfg.core.nodes[row.origin - 1].error;
			}
			else {
				type = cfg.core.nodes[row.origin - 1].value.type;
				if (recover_error_new_kind(row.opcode)) channel = 1;
				if ((row.opcode == 94 || row.opcode == 68 || row.opcode == 9 || row.opcode == 11 || row.opcode == 13 || row.opcode == 4 || row.opcode == 19 || row.opcode == 69 || row.opcode == 71 || row.opcode == 62 || row.opcode == 30) && cfg.core.nodes[row.origin - 1].result_role == 4) channel = 4;
			}
		}
	} RecoverValue value = {function = row.function, block = block, type = type, channel = channel, edge = edge}; return value;
}

void recover_ssa_define(RecoverSsaData data, RecoverCfg cfg, RecoverWork work) {
	int b = 1;
	while (b <= cfg.block_count && work.take()) {
		int id = recover_ssa_definition(cfg, b);
		if (id > 0) data.values[id] = recover_ssa_expected(cfg, b);
		b = b + 1;
	}
	if (work.exhausted || !recover_ssa_reach(cfg, data.reachable, work)) data.status = 2;
}

bool recover_ssa_use(RecoverSsaData data, RecoverCfg cfg, int value, int block, RecoverWork work) {
	if (value < 1 || value >= len(data.values)) return false;
	var definition = data.values[value]; if (definition.block < 1 || definition.function != cfg.blocks[block - 1].function) return false;
	int anchor = definition.block; if (definition.edge != 0) anchor = definition.edge;
	return !data.reachable[block - 1] || recover_ssa_dominates(anchor, block, work);
}

// Elide only straight paths with no owner definition, use, retirement or
// branch. The fresh physical scan builds this index in increasing block order;
// a forward edge or a cycle remains an explicit event. Standalone callers
// without that index retain the complete original walk.
void recover_ssa_value_shortcut(RecoverSsa ssa, int block, RecoverWork work) {
	var row = ssa.cfg.blocks[block - 1]; int definition = recover_ssa_definition(ssa.cfg, block);
	bool event = definition > 0 && ssa.data.values[definition].channel != 0 || row.next > 0 && row.other > 0 || row.next == 0 && row.other == 0 || row.carry != 0;
	if (row.opcode == 6 || row.opcode == 66 || row.opcode == 22 || row.opcode == 23 || row.opcode == 31 || row.opcode == 32 || row.opcode == 34 || row.opcode == 27 || row.opcode == 4 || row.opcode == 69 || row.opcode == 62 || row.opcode == 11 || row.opcode == 67 || row.opcode == 71 || row.opcode == 44 || row.opcode == 84 || row.opcode == 85) event = true;
	int target = row.next; if (target == 0) target = row.other;
	if (!event && target < block) work.owner_shortcuts[block] = work.owner_shortcuts[target];
	else {
		work.owner_shortcuts[block] = block;
	}
}

int recover_ssa_owner_target(RecoverCfg cfg, int target, RecoverWork work) {
	if (len(work.owner_shortcuts) == cfg.block_count + 1) return work.owner_shortcuts[target];
	return target;
}

// Explore each owner version on all its paths, including its retired state.
// A phi consumes an incoming owner and creates a new version of that same
// allocation. Borrow/message, destroy, carry and return uses require LIVE.
bool recover_ssa_owner(RecoverSsaData data, RecoverCfg cfg, int value, RecoverWork work) {
	var definition = data.values[value]; if (definition.channel == 0 || !data.reachable[definition.block - 1]) return true;
	if (definition.channel == 4) return recover_ssa_temporary(data, cfg, value, work);
	int start = cfg.blocks[definition.block - 1].next; if (definition.edge != 0) start = definition.edge;
	start = recover_ssa_owner_target(cfg, start, work);
	if (start == 0) return false;
	var seen = new bool[cfg.block_count * 2]; var pending = new int[cfg.block_count * 2]; int count = 1; pending[0] = (start - 1) * 2 + 1; seen[pending[0]] = true;
	while (count > 0) {
		if (!work.take()) return false; count = count - 1; int state = pending[count]; int id = state / 2 + 1; bool live = (state % 2) == 1; var block = cfg.blocks[id - 1];
		if (id == definition.block) {
			if (live) return false;
			if (definition.channel != 2 && definition.channel != 5) live = true;
		}
		bool use = (block.opcode == 31 || block.opcode == 32 || block.opcode == 34 || block.opcode == 23) && block.owner == value;
		if (block.opcode == 6 || block.opcode == 66) {
			var source = cfg.core.nodes[block.origin - 1].value;
			int caught = cfg.core.nodes[block.origin - 1].borrowed_owner;
			if (caught < 1 || caught > cfg.core.count || cfg.catch_try[caught - 1] < 1) return false;
			use = cfg.core.count * 2 + cfg.catch_try[caught - 1] == value;
		}
		if (use && !live) return false;
		if (definition.channel == 1 && (block.opcode == 27 || block.opcode == 22) && block.a > 0 && recover_owner_unwrap(cfg.core.flow.data, block.a) == value) {
			if (!live) return false;
			live = false;
		}
		if (block.opcode == 32 && block.owner == value || block.opcode == 23 && block.owner == value) live = false;
		if ((block.opcode == 22 || block.opcode == 23) && live) return false;
		int p = 0;
		while (p < 2) {
			int target = block.next; int carried = block.carry; if (p == 1) {
				target = block.other;
				if (block.opcode == 4) carried = cfg.core.count + block.origin;
			}
			if (target > 0) {
				bool next_live = live;
				if (id == definition.block && (definition.channel == 2 || definition.channel == 5) && target == definition.edge) next_live = true;
				if (cfg.blocks[target - 1].opcode == 33 && carried == value) {
					if (!live) return false;
					next_live = false;
				}
				target = recover_ssa_owner_target(cfg, target, work);
				if (target == 0) {
					if (next_live) return false;
					p = p + 1; continue;
				}
				int next_state = (target - 1) * 2; if (next_live) next_state = next_state + 1;
				if (!seen[next_state]) {
					seen[next_state] = true;
					pending[count] = next_state;
					count = count + 1;
				}
			}
			p = p + 1;
		}
	}
	return true;
}

// Reconstruct declaration sites once from the independently verified Core/CFG.
// Zero is absent; -1 records a duplicate. No producer index is accepted.
owned int[] recover_ssa_local_definitions(RecoverCfg cfg, RecoverWork work) {
	var result = new int[cfg.core.flow.checked.bindings.symbol_count + 1]; int n = 0;
	while (n < cfg.core.count) {
		if (!work.take()) return move result;
		var source = cfg.core.nodes[n].value;
		if (source.kind == 27 || source.kind == 86 || source.kind == 89) {
			int symbol = source.symbol.index; int operation = cfg.regions[n].operation;
			if (symbol > 0 && symbol < len(result)) {
				if (result[symbol] != 0) result[symbol] = -1;
				else {
					result[symbol] = operation;
				}
			}
		}
		n = n + 1;
	}
	return move result;
}

// Rebuild these private facts in the already-budgeted SSA block scan. The
// standalone Core declaration query above remains an independent reference.
bool recover_ssa_block_facts(RecoverCfg cfg, int block, int[] locals, RecoverSsaOwnerIndex index) {
	var row = cfg.blocks[block - 1];
	if (row.origin == 0) return true;
	var source = cfg.core.nodes[row.origin - 1].value;
	if (source.kind == 27 && row.opcode == 27 || source.kind == 86 && row.opcode == 86 || source.kind == 89 && row.opcode == 89) {
		if (cfg.regions[row.origin - 1].operation != block) return false;
		int symbol = source.symbol.index;
		if (symbol > 0 && symbol < len(locals)) {
			if (locals[symbol] == 0) locals[symbol] = block;
			else {
				locals[symbol] = -1;
			}
		}
	}
	return recover_ssa_index_reservation(index, cfg, block);
}

// Read-only proof diagnostics expose the first failing phase and item without
// accepting producer metadata or increasing the existing work ceiling.
bool recover_ssa_refuse(RecoverWork work, int[] detail) {
	detail[2] = work.remaining; detail[3] = 0; if (work.exhausted) detail[3] = 1;
	return false;
}

bool recover_ssa_verify(RecoverSsa ssa) {
	var detail = new int[4];
	return recover_ssa_verify_details(ssa, detail);
}

bool recover_ssa_verify_details(RecoverSsa ssa, int[] detail) {
	if (len(detail) != 4) return false;
	detail[0] = 1; detail[1] = 0; detail[2] = 0; detail[3] = 0;
	if (ssa.data.status != 0 || ssa.data.work_limit < 1 || ssa.data.work_limit > 8000000 || !recover_cfg_verify(ssa.cfg) || len(ssa.data.values) != ssa.cfg.core.count * 4 + ssa.cfg.core.flow.data.function_count + 1 || len(ssa.data.reachable) != ssa.cfg.block_count) return false;
	var work = new RecoverWork(ssa.data.work_limit); var reachable = new bool[ssa.cfg.block_count];
	detail[0] = 2;
	if (!recover_ssa_build_dominance(ssa.cfg.blocks, ssa.cfg.block_count, ssa.cfg.entries, work)) return recover_ssa_refuse(work, detail);
	// The independently reconstructed dominator traversal also proves reach.
	// Reverse block order builds Error and short-circuit phi lists in edge order
	// during the definition scan instead of scanning the CFG a second time.
	var phi_head = new int[ssa.cfg.block_count + 1]; var phi_next = new int[ssa.cfg.edge_count + 1]; int e = ssa.cfg.edge_count;
	var consumers = new int[ssa.cfg.core.count + 1];
	var locals = new int[ssa.cfg.core.flow.checked.bindings.symbol_count + 1]; var owners = new RecoverSsaOwnerIndex(ssa.cfg);
	var definitions = new bool[len(ssa.data.values)]; int b = ssa.cfg.block_count;
	// Counts were reconstructed from every actual block during dominance.
	// Fill the same per-function order while this physical scan walks backwards.
	var owner_remaining = new int[len(owners.starts)]; int owner_function = 1;
	while (owner_function < len(owners.starts)) {
		if (!work.take()) return recover_ssa_refuse(work, detail);
		int count = work.function_counts[owner_function];
		if (count < 0 || count > ssa.cfg.block_count) return recover_ssa_refuse(work, detail);
		owner_remaining[owner_function] = count;
		owners.starts[owner_function] = owners.starts[owner_function - 1] + count;
		owner_function = owner_function + 1;
	}
	if (owners.starts[len(owners.starts) - 1] != ssa.cfg.block_count) return recover_ssa_refuse(work, detail);
	detail[0] = 3;
	while (b > 0) {
		detail[1] = b;
		reachable[b - 1] = work.dominance_first[b] > 0;
		if (!work.take() || reachable[b - 1] != ssa.data.reachable[b - 1]) return recover_ssa_refuse(work, detail);
		int id = recover_ssa_definition(ssa.cfg, b);
		if (id != 0) {
			if (definitions[id]) return recover_ssa_refuse(work, detail); definitions[id] = true; var value = ssa.data.values[id]; var expected = recover_ssa_expected(ssa.cfg, b);
			if (value.function != expected.function || value.block != b || value.type.index != expected.type.index || value.channel != expected.channel || value.edge != expected.edge) return recover_ssa_refuse(work, detail);
		}
		var row = ssa.cfg.blocks[b - 1]; int p = 1;
		if (row.function < 1 || row.function >= len(owner_remaining) || owner_remaining[row.function] < 1) return recover_ssa_refuse(work, detail);
		owner_remaining[row.function] = owner_remaining[row.function] - 1;
		int owner_position = owner_remaining[row.function];
		owners.positions[b - 1] = owner_position;
		owners.blocks[owners.starts[row.function - 1] + owner_position] = b;
		if (!recover_ssa_block_facts(ssa.cfg, b, locals, owners)) return recover_ssa_refuse(work, detail);
		if (row.origin > 0 && (row.opcode == 22 || row.opcode == 27 || row.opcode == 4 || row.opcode == 69 || row.opcode == 62 && (ssa.cfg.core.nodes[row.origin - 1].value.kind == 77 || ssa.cfg.core.nodes[row.origin - 1].value.kind == 80) || row.opcode == 11 || row.opcode == 67 || row.opcode == 71 || row.opcode == 85 || row.opcode == 44)) {
			if (consumers[row.origin] == 0) consumers[row.origin] = b;
			else {
				consumers[row.origin] = -1;
			}
		}
		while (p >= 0) {
			int target = row.other; if (p == 0) target = row.next;
			if (target > 0) {
				int opcode = ssa.cfg.blocks[target - 1].opcode;
				if ((opcode == 33 || opcode == 62) && reachable[b - 1]) {
					phi_next[e] = phi_head[target];
					phi_head[target] = e;
				}
				e = e - 1;
			}
			p = p - 1;
		}
		b = b - 1;
	}
	if (e != 0) return recover_ssa_refuse(work, detail);
	work.temporary_consumers = move consumers;
	owners.reservations_ready = true;
	int v = 0;
	while (v < len(definitions)) {
		if (!definitions[v]) {
			var value = ssa.data.values[v];
			if (value.function != 0 || value.block != 0 || value.type.index != 0 || value.channel != 0 || value.edge != 0) return recover_ssa_refuse(work, detail);
		}
		v = v + 1;
	}
	detail[0] = 4; detail[1] = 0;
	var parents = new RecoverOwnerParent[ssa.cfg.core.count];
	var parent_work = new RecoverOwnerBudget(); parent_work.remaining = work.remaining;
	if (!recover_owner_parents(ssa.cfg.core.flow.data, parents, parent_work)) return recover_ssa_refuse(work, detail);
	work.remaining = parent_work.remaining;
	if (parent_work.exhausted) work.exhausted = true;
	v = 1;
	while (v <= ssa.cfg.core.count) {
		if (!recover_ssa_weak_upgrade(ssa, v, work)) return recover_ssa_refuse(work, detail);
		if (definitions[v] && (!recover_ssa_shared_borrow(ssa, v, parents, work) || !recover_ssa_utf8(ssa, v, work) || !recover_ssa_array_view(ssa, v, parents, work))) return recover_ssa_refuse(work, detail);
		v = v + 1;
	}
	if (work.exhausted) return recover_ssa_refuse(work, detail);
	detail[0] = 5;
	work.owner_shortcuts = new int[ssa.cfg.block_count + 1];
	b = 1;
	while (b <= ssa.cfg.block_count) {
		detail[1] = b;
		var row = ssa.cfg.blocks[b - 1];
		recover_ssa_owner_shortcut(owners, ssa.cfg, b - 1);
		recover_ssa_value_shortcut(ssa, b, work);
		if (!recover_ssa_lazy_inputs(ssa, b, locals, work)) return recover_ssa_refuse(work, detail);
		if (row.opcode != 62 && row.opcode != 36 && row.opcode != 37 && row.opcode != 38 && (row.a != 0 && !recover_ssa_use(ssa.data, ssa.cfg, row.a, b, work) || row.b != 0 && !recover_ssa_use(ssa.data, ssa.cfg, row.b, b, work))) return recover_ssa_refuse(work, detail);
		if (row.opcode == 90 || row.opcode == 91 || row.opcode == 92) {
			var source = ssa.cfg.core.nodes[row.origin - 1].value;
			if (source.kind != 89 || !range_foreach_binding(ssa.cfg.core.flow.checked, source.symbol)) return recover_ssa_refuse(work, detail);
			int definition = locals[source.symbol.index];
			if (definition < 1 || ssa.data.reachable[b - 1] && !recover_ssa_dominates(definition, b, work)) return recover_ssa_refuse(work, detail);
		}
		if (row.opcode == 61 || row.opcode == 76) {
			var source = ssa.cfg.core.nodes[row.origin - 1].value;
			int guard = ssa.cfg.regions[source.b - 1].next;
			if (!recover_ssa_use(ssa.data, ssa.cfg, source.c, b, work) || guard < 1 || guard > ssa.cfg.block_count || !recover_ssa_dominates(guard, b, work)) return recover_ssa_refuse(work, detail);
		}
		if (row.opcode == 62 && !recover_ssa_short_inputs(ssa, b, phi_head, phi_next, work)) return recover_ssa_refuse(work, detail);
		if (row.opcode == 4 || row.opcode == 5 || row.opcode == 8 || recover_constructor_kind(row.opcode) || row.opcode == 14 || row.opcode == 19 || row.opcode == 50 || row.opcode == 56 || row.opcode == 57 || row.opcode == 69 || row.opcode == 70 || row.opcode == 71) {
			var source = ssa.cfg.core.nodes[row.origin - 1].value; int i = 0;
			while (i < source.count) {
				if (!recover_ssa_use(ssa.data, ssa.cfg, ssa.cfg.core.flow.data.edges[source.first + i], b, work)) return recover_ssa_refuse(work, detail);
				i = i + 1;
			}
		}
		if ((row.opcode == 31 || row.opcode == 32 || row.opcode == 34 || row.opcode == 23) && !recover_ssa_use(ssa.data, ssa.cfg, row.owner, b, work)) return recover_ssa_refuse(work, detail);
		if (row.opcode == 2 || (row.opcode == 12 || row.opcode == 58 || row.opcode == 88 || row.opcode == 93 || row.opcode == 94 || row.opcode == 95) && ssa.cfg.core.nodes[row.origin - 1].value.symbol.index > 0 || row.opcode == 42 || row.opcode == 75 || row.opcode == 79 && ssa.cfg.core.nodes[row.origin - 1].value.symbol.index > 0) {
			var source = ssa.cfg.core.nodes[row.origin - 1].value; var declaration = ssa.cfg.core.flow.checked.bindings.symbol(source.symbol);
			if (declaration.kind == 8 || enum_scoped_binding(ssa.cfg.core.flow.checked, source.symbol) || range_foreach_binding(ssa.cfg.core.flow.checked, source.symbol)) {
				int definition = locals[source.symbol.index];
				if (definition < 1 || ssa.data.reachable[b - 1] && !recover_ssa_dominates(definition, b, work)) return recover_ssa_refuse(work, detail);
			}
		}
		if (row.opcode == 6 || row.opcode == 66) {
			var source = ssa.cfg.core.nodes[row.origin - 1].value;
			int caught = ssa.cfg.core.nodes[row.origin - 1].borrowed_owner;
			if (caught < 1 || caught > ssa.cfg.core.count || ssa.cfg.catch_try[caught - 1] < 1 || !recover_ssa_use(ssa.data, ssa.cfg, ssa.cfg.core.count * 2 + ssa.cfg.catch_try[caught - 1], b, work)) return recover_ssa_refuse(work, detail);
		}
		if (row.opcode == 65) {
			var source = ssa.cfg.core.nodes[row.origin - 1].value;
			int place = ssa.cfg.core.nodes[row.origin - 1].place;
			if (place < 1 || place > ssa.cfg.core.flow.storage.count) return recover_ssa_refuse(work, detail);
			var slot = ssa.cfg.core.flow.storage.slots[place - 1];
			if (!slot.parameter || slot.owner || slot.flags != 2 || slot.symbol.index != source.symbol.index || slot.function != row.function) return recover_ssa_refuse(work, detail);
		}
		if (row.opcode == 33) {
			e = phi_head[b];
			while (e > 0) {
				var edge = ssa.cfg.edges[e - 1];
				if (edge.owner == 0 || !recover_ssa_use(ssa.data, ssa.cfg, edge.owner, edge.source, work)) return recover_ssa_refuse(work, detail);
				e = phi_next[e];
			}
		}
		b = b + 1;
	}
	detail[0] = 6;
	v = 1;
	while (v < len(definitions)) {
		detail[1] = v;
		if (definitions[v] && !recover_ssa_owner(ssa.data, ssa.cfg, v, work)) return recover_ssa_refuse(work, detail);
		v = v + 1;
	}
	// The two existing physical scans produced the fresh local owner index.
	// Standalone slot verification still reconstructs its own complete index.
	detail[0] = 7; detail[1] = 0;
	if (work.exhausted || !recover_owners_verify(ssa.cfg.core.owners, ssa.cfg.core.flow) || !recover_ssa_packed_slots(ssa, owners, work)) return recover_ssa_refuse(work, detail);
	detail[0] = 0; detail[2] = work.remaining;
	return true;
}

owned RecoverSsa recover_ssa_lower(owned RecoverCfg cfg, int work_limit) {
	bool valid = recover_cfg_verify(cfg); var ssa = new RecoverSsa(move cfg, work_limit);
	if (!valid) {
		ssa.data.fail(4);
		return move ssa;
	}
	var work = new RecoverWork(work_limit); recover_ssa_define(ssa.data, ssa.cfg, work);
	if (ssa.data.status == 0 && !recover_ssa_verify(ssa)) ssa.data.fail(1);
	return move ssa;
}
