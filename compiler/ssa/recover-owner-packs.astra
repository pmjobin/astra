// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// A word contains exact possible states for several independent owner slots.
// Joins union those states; each transfer distributes over that union. This is
// the same universal path check as the scalar walk, with up to30 states per
// word. Slots too large for a word retain the bounded scalar implementation.
class RecoverSsaOwnerPacks {
	owned int[] heads;
	owned int[] links;
	owned int[] groups;
	owned int[] shifts;
	owned int[] masks;
	owned int[] places;

	init(RecoverCfg cfg) {
		int slots = cfg.core.flow.storage.count;
		this.heads = new int[len(cfg.entries)];
		this.links = new int[slots];
		this.groups = new int[slots];
		this.shifts = new int[slots];
		this.masks = new int[slots];
		this.places = new int[len(cfg.core.flow.storage.symbols)];
	}
}

bool recover_ssa_owner_pack(RecoverSsa ssa, RecoverSsaOwnerIndex index, RecoverSsaOwnerPacks packs, int function, int group, int initial, int dead, int full, RecoverWork work) {
	int first = index.starts[function - 1]; int blocks = index.starts[function] - first;
	var states = new int[blocks]; var queued = new bool[blocks]; var pending = new int[blocks];
	int entry = index.shortcuts[ssa.cfg.entries[function - 1]]; int count = 0;
	if (entry > 0) {
		int position = index.positions[entry - 1];
		states[position] = initial; queued[position] = true; pending[0] = position; count = 1;
	}
	while (count > 0) {
		if (!work.take()) return false;
		count = count - 1; int position = pending[count]; queued[position] = false;
		int block = index.blocks[first + position]; var row = ssa.cfg.blocks[block - 1];
		int before = states[position]; int after = before; int place = 0;
		if (row.origin > 0) {
			int symbol = ssa.cfg.core.nodes[row.origin - 1].value.symbol.index;
			if (symbol > 0 && symbol < len(packs.places)) place = packs.places[symbol];
		}
		if (place > 0 && packs.groups[place - 1] == group) {
			int shift = packs.shifts[place - 1]; int mask = packs.masks[place - 1];
			int possible = (before & mask) >> shift;
			if (row.opcode == 2 || row.opcode == 10 || row.opcode == 12 || row.opcode == 17 || row.opcode == 18 || row.opcode == 44 || row.opcode == 46) {
				if ((possible & 1) != 0) return false;
				if (row.opcode == 10) {
					if (possible != 2 || ssa.cfg.core.owners.slots[row.origin - 1] != place || index.reservations[row.origin - 1] < 2) return false;
					after = (after & (full ^ mask)) | (1 << (shift + index.reservations[row.origin - 1]));
				}
			}
			if (row.opcode == 27 || row.opcode == 86) {
				if (possible != 1) return false;
				after = (after & (full ^ mask)) | (1 << (shift + 1));
			}
		}
		if ((row.opcode == 36 || row.opcode == 37) && row.b > 0 && row.b <= len(packs.groups) && packs.groups[row.b - 1] == group) {
			int shift = packs.shifts[row.b - 1]; int mask = packs.masks[row.b - 1];
			if (row.a < 1 || row.a > len(index.reservations) || ssa.cfg.core.owners.slots[row.a - 1] != row.b || index.reservations[row.a - 1] < 2 || (before & mask) != (1 << (shift + index.reservations[row.a - 1]))) return false;
			int state = 0; if (row.opcode == 37) state = 1;
			after = (after & (full ^ mask)) | (1 << (shift + state));
		}
		if (row.opcode == 38 && row.a > 0 && row.a <= len(packs.groups) && packs.groups[row.a - 1] == group) {
			int shift = packs.shifts[row.a - 1]; int mask = packs.masks[row.a - 1];
			if ((before & mask & (full ^ (3 << shift))) != 0) return false;
			after = (after & (full ^ mask)) | (1 << shift);
		}
		if ((row.opcode == 22 || row.opcode == 23) && (after & dead) != after) return false;
		int polarity = 0;
		while (polarity < 2) {
			int target = row.next; if (polarity == 1) target = row.other;
			target = index.shortcuts[target];
			if (target > 0) {
				if (ssa.cfg.blocks[target - 1].function != function) return false;
				int next = index.positions[target - 1]; int combined = states[next] | after;
				if (combined != states[next]) {
					states[next] = combined;
					if (!queued[next]) {
						if (count == blocks) return false;
						queued[next] = true; pending[count] = next; count = count + 1;
					}
				}
			}
			polarity = polarity + 1;
		}
	}
	return true;
}

bool recover_ssa_packed_slots(RecoverSsa ssa, RecoverSsaOwnerIndex index, RecoverWork work) {
	var packs = new RecoverSsaOwnerPacks(ssa.cfg); int place = ssa.cfg.core.flow.storage.count;
	while (place > 0) {
		if (!work.take()) return false;
		var slot = ssa.cfg.core.flow.storage.slots[place - 1];
		if (slot.owner) {
			if (slot.function < 1 || slot.function > len(packs.heads) || slot.symbol.index < 1 || slot.symbol.index >= len(packs.places) || packs.places[slot.symbol.index] != 0) return false;
			packs.places[slot.symbol.index] = place;
			packs.links[place - 1] = packs.heads[slot.function - 1]; packs.heads[slot.function - 1] = place;
		}
		place = place - 1;
	}
	int function = 1; int group = 0;
	while (function <= len(packs.heads)) {
		place = packs.heads[function - 1];
		while (place > 0) {
			if (index.moves[place - 1] > 28) {
				if (!recover_ssa_slot(ssa, place, index, work)) return false;
				place = packs.links[place - 1];
				continue;
			}
			group = group + 1; int bits = 0; int initial = 0; int dead = 0;
			while (place > 0 && index.moves[place - 1] + 2 <= 30 - bits) {
				if (!work.take()) return false;
				int versions = index.moves[place - 1] + 2;
				packs.groups[place - 1] = group; packs.shifts[place - 1] = bits; packs.masks[place - 1] = ((1 << versions) - 1) << bits;
				int state = 0; if (ssa.cfg.core.flow.storage.slots[place - 1].parameter) state = 1;
				initial = initial | (1 << (bits + state)); dead = dead | (1 << bits);
				bits = bits + versions; place = packs.links[place - 1];
			}
			if (!recover_ssa_owner_pack(ssa, index, packs, function, group, initial, dead, (1 << bits) - 1, work)) return false;
		}
		function = function + 1;
	}
	return !work.exhausted;
}
