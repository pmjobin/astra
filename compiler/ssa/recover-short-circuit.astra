// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Phi input uses belong to their actual predecessor edges, not the join.
bool recover_ssa_short_inputs(RecoverSsa ssa, int join, int[] incoming_head, int[] incoming_next, RecoverWork work) {
	if (join < 1 || join > ssa.cfg.block_count || len(incoming_head) != ssa.cfg.block_count + 1 || len(incoming_next) != ssa.cfg.edge_count + 1) return false;
	var block = ssa.cfg.blocks[join - 1];
	var row = ssa.cfg.core.nodes[block.origin - 1].value;
	if (block.opcode != 62 || row.kind != 62 && row.kind != 77 && row.kind != 80) return false;
	var arms_seen = new bool[row.count];
	int arm_edges = 0;
	int short_edges = 0;
	int right_edges = 0;
	// Only verifier-reconstructed incoming edges are indexed. Still check each
	// physical edge and its actual predecessor use; no phi certificate is trusted.
	int e = incoming_head[join];
	while (e > 0) {
		if (!work.take() || e > ssa.cfg.edge_count) return false;
		var edge = ssa.cfg.edges[e - 1];
		if (edge.target != join || !ssa.data.reachable[edge.source - 1]) return false;
		var source = ssa.cfg.blocks[edge.source - 1];
		if (row.kind == 80) {
			if (source.opcode != 78 || source.origin != block.origin || source.rank < 0 || source.rank >= row.count || arms_seen[source.rank]) return false;
			int arm = ssa.cfg.core.flow.data.edges[row.first + source.rank];
			if (arm < 1 || arm > ssa.cfg.core.count) return false;
			int input = ssa.cfg.core.nodes[arm - 1].value.a;
			if (source.a != input || !recover_ssa_use(ssa.data, ssa.cfg, input, edge.source, work)) return false;
			arms_seen[source.rank] = true; arm_edges = arm_edges + 1;
		} else { if (row.kind == 77) {
				if (source.opcode != 78 || source.origin != block.origin || source.rank < 0 || source.rank > 1) return false;
				int input = row.b;
				if (source.rank == 1) input = row.c;
				if (source.a != input || !recover_ssa_use(ssa.data, ssa.cfg, input, edge.source, work)) return false;
				if (source.rank == 0) {
					short_edges = short_edges + 1;
				} else {
					right_edges = right_edges + 1;
				}
			} else { if (source.opcode == 63 && source.origin == block.origin) {
					if (!recover_ssa_use(ssa.data, ssa.cfg, row.a, edge.source, work)) return false;
					short_edges = short_edges + 1;
				} else {
					if (!recover_ssa_use(ssa.data, ssa.cfg, row.b, edge.source, work)) return false;
					right_edges = right_edges + 1;
				} } }
		e = incoming_next[e];
	}
	if (row.kind == 80) return arm_edges == row.count;
	return short_edges == 1 && right_edges == 1;
}
