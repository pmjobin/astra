// Track the actual root version from payload definition to its call use.
// Cleanup on an aborted argument path is legal; reaching the consuming call
// after retiring/replacing that root is not. No cached liveness is accepted.
bool recover_ssa_shared_borrow(RecoverSsa ssa, int value, RecoverOwnerParent[] parents, RecoverWork work) {
	var source = ssa.cfg.core.nodes[value - 1];
	if (source.value.kind != 19 || source.result_role != 3) return true;
	int place = source.borrowed_owner;
	if (place < 1 || place > ssa.cfg.core.flow.storage.count) return false;
	var slot = ssa.cfg.core.flow.storage.slots[place - 1];
	var budget = new RecoverOwnerBudget();
	budget.remaining = work.remaining;
	int consumer = recover_shared_borrow_consumer(ssa.cfg.core.flow, value, parents, budget);
	work.remaining = budget.remaining;
	if (budget.exhausted) work.exhausted = true;
	if (consumer < 1 || work.exhausted) return false;
	int target = ssa.cfg.regions[consumer - 1].operation;
	int definition = ssa.data.values[value].block;
	if (target < 1 || definition < 1 || source.value.count != 1) return false;
	int input = recover_owner_unwrap(ssa.cfg.core.flow.data, ssa.cfg.core.flow.data.edges[source.value.first]);
	if (input < 1 || input > ssa.cfg.core.count) return false;
	var seen = new bool[ssa.cfg.block_count * 2];
	var pending = new int[ssa.cfg.block_count * 2];
	int first = ssa.cfg.blocks[definition - 1].next;
	if (first < 1) return false;
	pending[0] = (first - 1) * 2 + 1;
	seen[pending[0]] = true;
	int count = 1;
	while (count > 0) {
		if (!work.take()) return false;
		count = count - 1;
		int item = pending[count];
		int block = item / 2 + 1;
		bool live = item % 2 == 1;
		if (block == target) {
			if (!live) return false;
		} else {
			var row = ssa.cfg.blocks[block - 1];
			if (row.function != source.value.function) return false;
			if (block == definition) live = true;
			if (slot.owner && (row.opcode == 36 && row.b == place || row.opcode == 38 && row.a == place)) live = false;
			if (row.opcode == 44) {
				var write = ssa.cfg.core.nodes[row.origin - 1].value;
				var target_field = ssa.cfg.core.flow.fields.facts[write.source.index].field;
				int projection = input;
				int depth = 0;
				while (projection > 0 && depth < 192) {
					if (!work.take()) return false;
					var source_field = ssa.cfg.core.nodes[projection - 1].value;
					if (source_field.kind != 17) break;
					var fact = ssa.cfg.core.flow.fields.facts[source_field.source.index];
					if (target_field.index == fact.field.index) live = false;
					projection = fact.parent;
					depth = depth + 1;
				}
				if (depth == 192) return false;
			}
			int polarity = 0;
			while (polarity < 2) {
				int next = row.next;
				if (polarity == 1) next = row.other;
				if (next > 0) {
					int state = (next - 1) * 2;
					if (live) state = state + 1;
					if (!seen[state]) {
						seen[state] = true;
						pending[count] = state;
						count = count + 1;
					}
				}
				polarity = polarity + 1;
			}
		}
	}
	return true;
}

// An upgrade result can be null. Keep it in one checked owner slot until an
// explicit comparison with null selects a dominating success edge. Passing,
// moving, returning or borrowing that slot before the check is refused.
bool recover_ssa_weak_upgrade(RecoverSsa ssa, int value, RecoverWork work) {
	if (value < 1 || value > ssa.cfg.core.count) return false;
	int n = value - 1;
	var operation = ssa.cfg.core.nodes[n].value;
	if (operation.kind == 19 && ssa.cfg.core.flow.checked.bindings.program.arena.token_is(operation.token, "weak_upgrade")) {
		int binding = 0; int declaration = 0; int i = 0;
		while (i < ssa.cfg.core.count) {
			if (!work.take()) return false;
			var candidate = ssa.cfg.core.nodes[i].value;
			if (candidate.function == operation.function && candidate.kind == 27 && recover_owner_unwrap(ssa.cfg.core.flow.data, candidate.a) == n + 1) {
				if (binding != 0 || candidate.symbol.index == 0 || ssa.cfg.core.flow.checked.symbol_flags[candidate.symbol.index] != 4) return false;
				binding = candidate.symbol.index; declaration = i + 1;
			}
			i = i + 1;
		}
		if (binding == 0 || declaration == 0) return false;
		bool checked_none = false;
		i = 0;
		while (i < ssa.cfg.core.count) {
			if (!work.take()) return false;
			var use = ssa.cfg.core.nodes[i].value;
			if (use.function == operation.function && use.symbol.index == binding && (use.kind == 2 || use.kind == 10 || use.kind == 17 || use.kind == 18 || use.kind == 44)) {
				bool comparison = false; bool guarded = false; int c = 0;
				while (c < ssa.cfg.core.count) {
					if (!work.take()) return false;
					var condition = ssa.cfg.core.nodes[c].value;
					if (condition.function == operation.function && condition.kind == 3 && (ssa.cfg.core.flow.checked.bindings.program.arena.token_is(condition.token, "==") || ssa.cfg.core.flow.checked.bindings.program.arena.token_is(condition.token, "!="))) {
						int left = recover_owner_unwrap(ssa.cfg.core.flow.data, condition.a); int right = recover_owner_unwrap(ssa.cfg.core.flow.data, condition.b);
						if (left > 0 && right > 0) {
							var subject = ssa.cfg.core.nodes[left - 1].value; var other = ssa.cfg.core.nodes[right - 1].value;
							if (subject.kind == 13) {
								subject = ssa.cfg.core.nodes[right - 1].value;
								other = ssa.cfg.core.nodes[left - 1].value;
							}
							if (subject.kind == 2 && subject.symbol.index == binding && other.kind == 13 && other.type.index == operation.type.index) {
								if (left == i + 1 || right == i + 1) {
									comparison = true;
									checked_none = true;
								}
								int b = 0;
								while (b < ssa.cfg.block_count) {
									if (!work.take()) return false;
									var control = ssa.cfg.blocks[b];
									if ((control.opcode == 21 || control.opcode == 63) && control.function == operation.function && recover_owner_unwrap(ssa.cfg.core.flow.data, control.a) == c + 1) {
										int edge = control.next;
										if (ssa.cfg.core.flow.checked.bindings.program.arena.token_is(condition.token, "==")) edge = control.other;
										int target = ssa.cfg.regions[i].operation;
										if (edge > 0 && target > 0 && recover_ssa_dominates(b + 1, target, work) && recover_ssa_dominates(edge, target, work)) guarded = true;
									}
									b = b + 1;
								}
							}
						}
					}
					c = c + 1;
				}
				if (!comparison && !guarded) return false;
			}
			i = i + 1;
		}
		if (!checked_none) return false;
	}
	return !work.exhausted;
}
