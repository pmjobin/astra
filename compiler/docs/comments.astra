// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Documentation is trivia. Only the real lexer selects comment extents, and
// only original Binder declarations can receive them; generated nodes cannot.
class ApiComments {
	owned Utf8Message[slots] bodies;
	owned int[] starts;
	owned int[] ends;

	init(int symbols) {
		this.bodies = new Utf8Message[slots];
		bool reserved = this.bodies.reserve(symbols);
		assert_that(reserved);
		this.starts = new int[symbols];
		this.ends = new int[symbols];
	}
}

bool api_declaration(int kind) {
	return kind >= 1 && kind <= 6 || kind >= 10 && kind <= 14 || kind == 16 || kind == 17;
}

// One physical line break is adjacency; a blank line or ordinary comment is
// a barrier. CRLF counts as one break. Indentation has no association meaning.
bool api_adjacent(borrowed SourceBuffer source, int first, int last) throws Error {
	int breaks = 0;
	int cursor = first;
	while (cursor < last) {
		int byte = source.byte_at(cursor);
		if (byte == 13) {
			breaks = breaks + 1;
			if (cursor + 1 < last && source.byte_at(cursor + 1) == 10) cursor = cursor + 1;
		} else {
			if (byte == 10) breaks = breaks + 1;
			if (byte != 10 && byte != 32 && byte != 9) return false;
		}
		cursor = cursor + 1;
	}
	return breaks == 1;
}

bool api_doc_comment(borrowed SourceBuffer source, int first, int last) throws Error {
	return last - first >= 3 && source.byte_at(first) == 47 && source.byte_at(first + 1) == 47 && source.byte_at(first + 2) == 47 && (last - first == 3 || source.byte_at(first + 3) != 47);
}

owned ApiComments api_comments(CheckedIndex checked) throws Error {
	var result = new ApiComments(checked.generic_symbols + 1);
	int symbol = 0;
	while (symbol <= checked.generic_symbols) {
		var empty = syntax_text("");
		result.bodies.append(move empty);
		symbol = symbol + 1;
	}
	int file = 1;
	while (file <= checked.bindings.program.arena.source_count) {
		SyntaxSourceId id = {index = file};
		var source = checked.bindings.program.arena.source(id);
		var retained = shared_clone(source);
		var scanner = syntax_format_scan(move retained);
		int at = 0;
		while (at < scanner.comment_count) {
			var comment = scanner.comments[at];
			if (!api_doc_comment(shared_borrow(source), comment.start, comment.end)) {
				at = at + 1;
				continue;
			}
			int first = comment.start;
			int last = comment.end;
			var body = new Utf8ByteBuilder();
			while (true) {
				int begin = comment.start + 3;
				if (begin < comment.end && syntax_byte(shared_borrow(source), begin) == 32) begin = begin + 1;
				syntax_format_copy(shared_borrow(source), begin, comment.end, body);
				if (body.byte_count() > 65536) {
					throw new Error("api docs: comment exceeds 65536 bytes");
				}
				last = comment.end;
				at = at + 1;
				if (at == scanner.comment_count) break;
				var next = scanner.comments[at];
				if (!api_doc_comment(shared_borrow(source), next.start, next.end) || !api_adjacent(shared_borrow(source), last, next.start)) break;
				source_append_text(body, "\n");
				comment = next;
			}
			int target = 0;
			symbol = 1;
			while (symbol <= checked.generic_symbols) {
				var declaration = checked.bindings.symbol(type_symbol(symbol));
				if (api_declaration(declaration.kind)) {
					var span = checked.bindings.program.arena.header(declaration.node).span;
					if (span.source.index == file && span.start >= last) {
						if (target == 0) target = symbol;
						else {
							var old = checked.bindings.symbol(type_symbol(target));
							if (span.start < checked.bindings.program.arena.header(old.node).span.start) target = symbol;
						}
					}
				}
				symbol = symbol + 1;
			}
			if (target != 0) {
				var declaration = checked.bindings.symbol(type_symbol(target));
				int declaration_start = checked.bindings.program.arena.header(declaration.node).span.start;
				int token = 0;
				while (token < scanner.count && scanner.tokens[token].start < last) token = token + 1;
				if (token == scanner.count) target = 0;
				else {
					if (!api_adjacent(shared_borrow(source), last, scanner.tokens[token].start)) target = 0;
				}
				while (target != 0 && token < scanner.count && scanner.tokens[token].start < declaration_start) {
					int kind = scanner.tokens[token].kind;
					if (kind == token_kind_code(TokenKind.SEMICOLON()) || kind == token_kind_code(TokenKind.OPEN_BRACE()) || kind == token_kind_code(TokenKind.CLOSE_BRACE())) target = 0;
					token = token + 1;
				}
				if (at < scanner.comment_count && scanner.comments[at].start < declaration_start) target = 0;
			}
			if (target == 0) {
				throw new Error("api docs: unattached documentation comment (blank line, ordinary comment, or ineligible declaration)");
			}
			if (result.ends[target] != 0) {
				throw new Error("api docs: duplicate documentation association");
			}
			var text = body.snapshot();
			result.bodies.replace(target, move text);
			result.starts[target] = first;
			result.ends[target] = last;
		}
		file = file + 1;
	}
	return move result;
}
