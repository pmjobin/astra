// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// A concrete nominal's diagnostic TypeTable row has no argument edges. Its
// checked GenericInstance retains the authoritative origin and specialization.
int api_type_instance(CheckedIndex checked, TypeId type) {
	if (type.index == 0) return 0;
	var row = checked.types.row(type);
	if (row.kind != 30 && row.kind != 31) return 0;
	return generic_instance_for(checked, row.nominal);
}

int api_type_argument_count(CheckedIndex checked, TypeId type) {
	int instance = api_type_instance(checked, type);
	if (instance != 0) return generic_argument_count(checked, checked.instances[instance - 1]);
	return checked.types.row(type).count;
}

TypeEdge api_type_argument(CheckedIndex checked, TypeId type, int ordinal) {
	int instance = api_type_instance(checked, type);
	if (instance != 0) return generic_argument(checked, checked.instances[instance - 1], ordinal);
	return checked.types.argument(checked.types, type, ordinal);
}

string api_type_constructor_name(int kind) {
	if (kind == 25) return "Fn";
	if (kind == 26) return "Callback";
	if (kind == 27) return "Shared";
	if (kind == 28) return "Weak";
	if (kind == 29) return "Closure";
	if (kind == 35) return "CheckedClosure";
	if (kind == 36) return "Range";
	if (kind == 37) return "RangeSequence";
	if (kind == 38) return "InlineCallable";
	if (kind == 39) return "LazySequence";
	if (kind == 40) return "BorrowedIterator";
	return "";
}

void api_name(CheckedIndex checked, TypeId type, Utf8ByteBuilder output, int depth) throws Error {
	if (depth > 128) {
		throw new Error("api docs: type name depth exceeded");
	}
	if (type.index == 0) {
		source_append_text(output, "<deferred>");
		return;
	}
	var row = checked.types.row(type);
	if (row.kind <= 16) {
		source_append_text(output, type_builtin_name(row.kind));
		return;
	}
	int instance = api_type_instance(checked, type);
	int count = api_type_argument_count(checked, type);
	if (row.nominal.index != 0 && row.kind >= 30 && row.kind <= 34) {
		var nominal = row.nominal;
		if (instance != 0) nominal = generic_origin(checked.instances[instance - 1]);
		var declaration = checked.bindings.symbol(nominal);
		int name_id = declaration.canonical;
		if (row.kind == 33) name_id = declaration.name;
		var name = checked.bindings.names.text(name_id);
		source_append_text(output, name.text);
		if (count == 0) return;
	} else {
		source_append_text(output, api_type_constructor_name(row.kind));
	}
	bool bracket = row.kind >= 25;
	if (bracket) source_append_text(output, "<");
	int at = 0;
	while (at < count) {
		if (at > 0) source_append_text(output, ",");
		var edge = api_type_argument(checked, type, at);
		if ((edge.flags & 4) != 0) source_append_text(output, "owned ");
		if ((edge.flags & 2) != 0) source_append_text(output, "borrowed ");
		if ((edge.flags & 1) != 0) source_append_text(output, "nonnull ");
		api_name(checked, edge.type, output, depth + 1);
		at = at + 1;
	}
	if (bracket) source_append_text(output, ">");
	if (row.kind == 20) source_append_text(output, "*");
	if (row.kind == 21) {
		source_append_text(output, "[");
		append_int(output, row.extent);
		source_append_text(output, "]");
	}
	if (row.kind == 22) source_append_text(output, "[]");
	if (row.kind == 23) source_append_text(output, "[slots]");
	if (row.kind == 24) {
		source_append_text(output, "<");
		append_int(output, row.extent);
		source_append_text(output, ">");
	}
}

owned Utf8Message api_type_name(CheckedIndex checked, TypeId type) throws Error {
	var output = new Utf8ByteBuilder();
	api_name(checked, type, output, 0);
	var result = output.snapshot();
	return move result;
}
