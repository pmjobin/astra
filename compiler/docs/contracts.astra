// Additional documentation contracts read only checked owner-bound tables.
// Arena accessors require their actual source variant, even for absent lists.
SyntaxListId api_parameters(CheckedIndex checked, SyntaxNodeId node) {
	var kind = checked.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.FunctionDeclarationSyntax() || kind == SyntaxKind.LifecycleDeclarationSyntax()) return checked.bindings.program.arena.get_list_parameters(node);
	if (kind == SyntaxKind.EnumVariantSyntax()) return checked.bindings.program.arena.get_list_fields(node);
	SyntaxListId empty = {index = 0};
	return empty;
}

bool api_foreign_import(CheckedIndex checked, SyntaxNodeId node) {
	var kind = checked.bindings.program.arena.kind(node);
	return (kind == SyntaxKind.FunctionDeclarationSyntax() || kind == SyntaxKind.LifecycleDeclarationSyntax()) && checked.bindings.program.arena.computed_is_c_import(node);
}

bool api_foreign_export(CheckedIndex checked, SyntaxNodeId node) {
	var kind = checked.bindings.program.arena.kind(node);
	return (kind == SyntaxKind.FunctionDeclarationSyntax() || kind == SyntaxKind.LifecycleDeclarationSyntax()) && checked.bindings.program.arena.computed_is_c_export(node);
}

int api_concurrency(CheckedIndex checked, SyntaxNodeId node) {
	var kind = checked.bindings.program.arena.kind(node);
	if (kind == SyntaxKind.ClassDeclarationSyntax() || kind == SyntaxKind.StructDeclarationSyntax()) return checked.bindings.program.arena.get_concurrency_concurrency_policy(node).kinds;
	return 0;
}

TypeId api_error_type(CheckedIndex checked, int number) {
	var signature = checked.symbol_signatures[number];
	if (signature.index != 0) return checked.signature(checked, signature).error;
	var symbol = checked.bindings.symbol(type_symbol(number));
	var kind = checked.bindings.program.arena.kind(symbol.node);
	if (kind != SyntaxKind.FunctionDeclarationSyntax() && kind != SyntaxKind.LifecycleDeclarationSyntax() && kind != SyntaxKind.PropertyDeclarationSyntax()) return no_type();
	var node = checked.bindings.program.arena.get_node_throws_class(symbol.node);
	if (node.index != 0) return checked.type_use(checked, node).type;
	return no_type();
}

string api_foreign_contract(CheckedIndex checked, int number) {
	var symbol = type_symbol(number);
	if (checked_c_text_signature(checked, symbol)) return "checked_C_utf8_i32_noescape";
	if (checked_c_counted_signature(checked, symbol, true)) return "checked_C_u8_i32_noescape";
	if (checked_c_scalar_abi_signature(checked, symbol, true)) return "checked_C_scalar";
	var declaration = checked.bindings.symbol(symbol);
	if (api_foreign_import(checked, declaration.node) || api_foreign_export(checked, declaration.node)) return "unproven_foreign_profile";
	return "native_or_not_foreign";
}

void api_constraints(CheckedIndex checked, int number, Utf8ByteBuilder output) throws Error {
	var declaration = checked.bindings.symbol(type_symbol(number));
	var kind = checked.bindings.program.arena.kind(declaration.node);
	SyntaxListId clauses = {index = 0};
	if (kind == SyntaxKind.ClassDeclarationSyntax() || kind == SyntaxKind.FunctionDeclarationSyntax() || kind == SyntaxKind.LifecycleDeclarationSyntax() || kind == SyntaxKind.StructDeclarationSyntax()) clauses = checked.bindings.program.arena.get_list_where_clauses(declaration.node);
	source_append_text(output, "[");
	int clause_number = 0;
	while (clause_number < checked.bindings.program.arena.list_count(clauses)) {
		var clause = checked.bindings.program.arena.node_at(clauses, clause_number);
		var parameter_token = checked.bindings.program.arena.get_token_type_parameter(clause);
		var parameter_name = checked.bindings.program.arena.token_message(parameter_token);
		int parameter = 1;
		int selected = 0;
		while (parameter <= checked.generic_symbols) {
			var symbol = checked.bindings.symbol(type_symbol(parameter));
			if (symbol.kind == 9 && symbol.owner.index == number && checked.bindings.program.arena.token_is(symbol.token, parameter_name.text)) selected = parameter;
			parameter = parameter + 1;
		}
		if (selected == 0) {
			throw new Error("api docs: generic constraint has no checked parameter");
		}
		if (clause_number > 0) source_append_text(output, ",");
		source_append_text(output, "{\"parameter\":");
		api_json_string(output, parameter_name.text);
		source_append_text(output, ",\"capabilities\":[");
		var capabilities = checked.bindings.program.arena.get_list_capabilities(clause);
		int capability_number = 0;
		while (capability_number < checked.bindings.program.arena.list_count(capabilities)) {
			var token = checked.bindings.program.arena.token_at(capabilities, capability_number);
			var name = checked.bindings.program.arena.token_message(token);
			if (!checked_parameter_capability(checked, checked.symbol_types[selected], name.text)) {
				throw new Error("api docs: unchecked generic capability");
			}
			if (capability_number > 0) source_append_text(output, ",");
			api_json_string(output, name.text);
			capability_number = capability_number + 1;
		}
		source_append_text(output, "]}");
		clause_number = clause_number + 1;
	}
	source_append_text(output, "]");
}
