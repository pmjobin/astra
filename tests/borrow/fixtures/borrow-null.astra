struct Pair { int x; bool ready; }

int choose(bool condition) {
	Pair pair = { x = 1, ready = true };
	Pair* p = null;
	if (condition) { p = &pair; }
	if (p != null && p->ready) { p->x = 42; }
	if (condition) {
		if (pair.x != 42 || p == null) { return 1; }
	} else {
		if (pair.x != 1 || p != null) { return 2; }
	}
	if (p == null || p->x == 42) { return 0; }
	return 3;
}

int main() {
	return choose(true) + choose(false);
}
