struct Pair { int x; int y; }

int main() {
	Pair a = { x = 0, y = 2 };
	Pair b = { x = 0, y = 4 };
	Pair* p = &a;
	int i = 0;
	while (i < 8) {
		p->x = p->x + 1;
		i = i + 1;
		if (i == 2) { p = &b; continue; }
		if (i == 5) { break; }
	}
	if (a.x != 2 || b.x != 3 || p != &b) { return 1; }
	return 0;
}
