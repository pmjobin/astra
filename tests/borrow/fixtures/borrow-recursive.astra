struct Pair { int x; int y; }

void recurse(Pair* parameter, int n) {
	Pair* p = parameter;
	if (n > 0) {
		Pair* q = p;
		q->x = q->x + n;
		recurse(q, n - 1);
	}
}

int main() {
	Pair pair = { x = 0, y = 2 };
	Pair* p = &pair;
	recurse(p, 6);
	if (pair.x != 21 || pair.y != 2) { return 1; }
	return 0;
}
