// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// The new private profile is selected explicitly. Existing native-ABI commands
// retain their original admission and hidden borrowed-receiver contract.
string llvm_class_command(string command) {
	if (command == "--classstorage-genclass-consumer") return "--genclass-consumer";
	if (command == "--classstorage-genclass-model-mutations") return "--genclass-model-mutations";
	if (command == "--classstorage-genclass-native-mutations") return "--genclass-native-mutations";
	if (command == "--classstorage-admit") return "--nativeabi-admit";
	if (command == "--classstorage-core") return "--nativeabi-core";
	if (command == "--classstorage-cfg") return "--nativeabi-cfg";
	if (command == "--classstorage-ssa") return "--nativeabi-ssa";
	if (command == "--classstorage-abi-plan") return "--abi-plan";
	if (command == "--classstorage-generic-plan") return "--generic-plan";
	if (command == "--classstorage-llvm-ir") return "--llvm-ir";
	if (command == "--classstorage-emit-obj") return "--emit-obj";
	if (command == "--classstorage-llvm-raw") return "--llvm-raw";
	if (command == "--classstorage-model-mutations") return "--storage-model-mutations";
	if (command == "--classstorage-native-mutations") return "--storage-native-mutations";
	return "";
}

int main(string[] args) {
	if (len(args) < 2) {
		println_stderr("LLVM_INVALID_COMMAND");
		return 2;
	}
	var mapped = llvm_class_command(args[1]); var command = args[1];
	if (mapped != "") command = mapped;
	if (command != "--llvm-ir" && command != "--emit-obj" && command != "--llvm-raw" && command != "--mutate-llvm" && command != "--llvm-limits" && command != "--llvm-lifecycle" && command != "--nativeabi-mutations" && command != "--abi-plan" && command != "--nativeabi-admit" && command != "--nativeabi-ssa" && command != "--generic-plan" && command != "--generic-mutations" && command != "--generic-native-mutations" && command != "--nativeabi-core" && command != "--nativeabi-cfg" && command != "--storage-model-mutations" && command != "--storage-native-mutations" && command != "--genclass-consumer" && command != "--genclass-model-mutations" && command != "--genclass-native-mutations") return llvm_ssa_cli(args);
	if (len(args) < 5) {
		println_stderr("LLVM_INVALID_COMMAND");
		return 2;
	}
	try {
		int optimization = 0;
		if (args[2] == "O2") {
			optimization = 2;
		} else {
			if (args[2] != "O0") {
				throw new Error("LLVM_TARGET_UNAVAILABLE");
			}
		}
		var source = binding_load_program(args, 4); var bindings = binding_index(move source, 0);
		var checked = checked_build_profile(move bindings, 0, true, true, true, true, command != args[1]); var flow = flow_index(move checked, 8192, 1000000);
		if (command == "--genclass-model-mutations") {
			genclass_model_mutations(flow);
			return 0;
		}
		if (command == "--genclass-consumer") {
			assert_that(flow_status(flow) == 0 && genclass_mutation_stage(flow) == 0);
			var text = generic_observation(flow.checked); print(text.text); println("GENCLASS_SOURCE_CONSUMER_VALID"); return 0;
		}
		if (command == "--storage-model-mutations") {
			class_storage_model_mutations(flow);
			return 0;
		}
		if (command == "--generic-mutations") {
			generic_mutations(flow);
			return 0;
		}
		if (command == "--generic-plan") {
			var observation = generic_observation(flow.checked); print(observation.text); return flow_status(flow);
		}
		if (command == "--nativeabi-admit") {
			var observation = flow_observation(flow);
			print(observation.text);
			return flow_status(flow);
		}
		var core = core_lower(move flow, 65536);
		if (command == "--nativeabi-core") {
			var text = core_projection(core);
			print(text.text);
			return 0;
		}
		if (core_verify(core) != 0) {
			var stage = llvm_name("LLVM_INVALID_UPSTREAM: Core ", core.data.status);
			throw new Error(stage.text);
		}
		var cfg = cfg_lower(move core, 65536);
		if (command == "--nativeabi-cfg") {
			var text = cfg_projection(cfg);
			print(text.text);
			return 0;
		}
		if (cfg_verify(cfg) != 0) {
			var stage = llvm_name("LLVM_INVALID_UPSTREAM: CFG ", cfg.data.status);
			throw new Error(stage.text);
		}
		var program = ssa_lower(move cfg, 65536, 8000000);
		var profile = new LlvmProfile(optimization, 8000000, 16777216);
		if (command == "--nativeabi-ssa") {
			if (ssa_verify(program) != 0) {
				var reason = new Utf8ByteBuilder(); source_append_text(reason, "LLVM_INVALID_UPSTREAM: native ABI SSA"); flow_number(reason, program.data.status); flow_number(reason, ssa_verify(program)); var message = reason.snapshot(); throw new Error(message.text);
			}
			var projection = ssa_projection(program);
			print(projection.text);
			return 0;
		}
		if (command == "--generic-native-mutations") {
			generic_native_mutations(program, profile, args[3]);
			return 0;
		}
		if (command == "--storage-native-mutations") {
			class_storage_native_mutations(program, profile, args[3]);
			return 0;
		}
		if (command == "--genclass-native-mutations") {
			genclass_native_mutations(program, profile, args[3]);
			return 0;
		}
		if (command == "--mutate-llvm") {
			llvm_mutations(program, profile, args[3]);
			return 0;
		}
		if (command == "--nativeabi-mutations") {
			nativeabi_mutations(program, profile, args[3]);
			return 0;
		}
		if (command == "--llvm-limits") {
			llvm_limits(program, args[3]);
			return 0;
		}
		var module = llvm_lower(program, program, profile);
		if (command == "--abi-plan") {
			assert_that(module.audit(program) == 0);
			module.abi_snapshot();
			if (command != args[1]) module.storage_snapshot(program);
			println("");
			return 0;
		}
		if (command == "--llvm-lifecycle") {
			llvm_lifecycle(module, program, profile, args, args[3]);
			return 0;
		}
		if (command == "--llvm-raw") {
			module.raw(program, args[3]);
			return 0;
		}
		module.write(program, program, profile, args[3], command == "--emit-obj");
		return 0;
	} catch (Error error) { println_stderr(error.message); return 2; }
}

void nativeabi_mutations(SsaProgram program, LlvmProfile profile, string path) throws Error {
	var upstream = ssa_test_snapshot(program.data); int category = 21;
	while (category < 39) {
		var baseline = llvm_lower(program, program, profile); assert_that(baseline.audit(program) == 0);
		var mutant = llvm_lower(program, program, profile);
		if (mutant.fault(category)) {
			int stage = mutant.audit(program); assert_that(stage > 0 && stage < 5);
			bool rejected = false; try { mutant.write(program, program, profile, path, true); } catch (Error error) { rejected = true; } assert_that(rejected);
			var prefix = llvm_name("NATIVEABI_MUTATION ", category); print(prefix.text); var number = llvm_name(" ", stage); print(number.text); print(" ");
			baseline.abi_snapshot(); print(" "); baseline.snapshot(); print(" "); mutant.abi_snapshot(); print(" "); mutant.snapshot(); print(" ");
			mutant.close(); var restored = llvm_lower(program, program, profile); assert_that(restored.audit(program) == 0); restored.abi_snapshot(); print(" "); restored.snapshot(); println("");
			var after = ssa_test_snapshot(program.data); assert_that(after.text == upstream.text && ssa_verify(program) == 0);
		}
		category = category + 1;
	}
}

void llvm_mutations(SsaProgram program, LlvmProfile profile, string path) throws Error {
	var initial = ssa_test_snapshot(program.data); int category = 0;
	while (category < 21) {
		var module = llvm_lower(program, program, profile);
		// Snapshot before mutation is emitted only for applicable categories.
		var baseline = llvm_lower(program, program, profile);
		if (module.fault(category)) {
			bool rejected = false;
			try { module.write(program, program, profile, path, true); } catch (Error error) { rejected = true; }
			assert_that(rejected);
			var prefix = llvm_name("LLVM_MUTATION ", category); print(prefix.text); print(" "); baseline.snapshot(); print(" "); module.snapshot(); print(" ");
			module.close(); var restored = llvm_lower(program, program, profile); restored.snapshot(); println("");
			var after = ssa_test_snapshot(program.data); assert_that(initial.text == after.text); assert_that(ssa_verify(program) == 0);
		}
		category = category + 1;
	}
}

void llvm_limits(SsaProgram program, string path) throws Error {
	int i = 0;
	while (i < 5) {
		int work = 8000000; int output = 16777216; int level = 0;
		if (i == 0) work = 0; if (i == 1) work = 1; if (i == 2) output = 0; if (i == 3) output = 1; if (i == 4) level = 1;
		var profile = new LlvmProfile(level, work, output); bool rejected = false;
		try { var module = llvm_lower(program, program, profile); module.write(program, program, profile, path, true); } catch (Error error) { rejected = true; }
		assert_that(rejected); i = i + 1;
	}
	println("LLVM_LIMITS_REJECTED");
}

void llvm_lifecycle(LlvmArtifact module, SsaProgram program, LlvmProfile profile, string[] args, string path) throws Error {
	var source = binding_load_program(args, 4); var bindings = binding_index(move source, 0);
	var checked = checked_build_nativeabi(move bindings, 0); var flow = flow_index(move checked, 8192, 1000000);
	var core = core_lower(move flow, 65536); var cfg = cfg_lower(move core, 65536); var other = ssa_lower(move cfg, 65536, 8000000);
	bool rejected = false;
	try { module.write(program, other, profile, path, true); } catch (Error error) { rejected = true; } assert_that(rejected);
	rejected = false; try { var crossed = llvm_lower(program, other, profile); } catch (Error error) { rejected = true; } assert_that(rejected);
	module.close(); module.close(); rejected = false;
	try { module.write(program, program, profile, path, true); } catch (Error error) { rejected = true; } assert_that(rejected);
	println("LLVM_LIFECYCLE_REJECTED");
}

void generic_native_mutations(SsaProgram program, LlvmProfile profile, string path) throws Error {
	var upstream = ssa_test_snapshot(program.data); int category = 39;
	while (category < 45) {
		var baseline = llvm_lower(program, program, profile); assert_that(baseline.audit(program) == 0);
		var mutant = llvm_lower(program, program, profile); assert_that(mutant.fault(category));
		int stage = mutant.audit(program); assert_that(stage > 0 && stage < 5);
		bool rejected = false;
		try { mutant.write(program, program, profile, path, true); } catch (Error error) { rejected = true; }
		assert_that(rejected);
		print("GENERIC_NATIVE_MUTATION "); var number = llvm_name("", category); print(number.text); var boundary = llvm_name(" ", stage); print(boundary.text); print(" ");
		baseline.abi_snapshot(); print(" "); baseline.snapshot(); print(" "); mutant.abi_snapshot(); print(" "); mutant.snapshot(); println("");
		mutant.close(); var restored = llvm_lower(program, program, profile); assert_that(restored.audit(program) == 0);
		var after = ssa_test_snapshot(program.data); assert_that(after.text == upstream.text && ssa_verify(program) == 0);
		category = category + 1;
	}
}
