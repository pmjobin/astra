(unit
	(function
		(type "int")
		(name "scoped")
		(parameters)
		(block
			(owned-local (type "void*") (name "h") (call "create_resource" (arguments (integer "1"))))
			(release (name "h"))
			(assign (name "h") (call "create_resource" (arguments (integer "2"))))
			(return (integer "0"))
		)
	)
)
