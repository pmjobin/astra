int scoped() {
	owned void* h = create_resource(1);
	owned void* b = move h;
	h = create_resource(2);
	if (resource_id(b) != 1 || resource_id(h) != 2 || resource_live_count() != 2) { return 1; }
	return 0;
}
int main() {
	resource_reset();
	if (scoped() != 0 || resource_create_count() != 2 || resource_destroy_count() != 2 || resource_destroy_order() != 12 || resource_effect_order() != 12 || resource_live_count() != 0 || resource_error_count() != 0) { return 1; }
	return 0;
}
