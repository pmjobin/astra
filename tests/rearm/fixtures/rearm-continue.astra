int scoped() {
	owned void* h = create_resource(0);
	release h;
	resource_reset();
	int i = 0;
	while (i < 3) {
		if (resource_destroy_count() != i) return 1;
		i = i + 1;
		h = create_resource(i);
		release h;
		continue;
	}
	return 0;
}

int main() {
	resource_reset();
	if (scoped() != 0 || resource_create_count() != 3 || resource_destroy_count() != 3 || resource_destroy_order() != 123 || resource_effect_order() != 123 || resource_live_count() != 0 || resource_error_count() != 0) return 1;
	return 0;
}
