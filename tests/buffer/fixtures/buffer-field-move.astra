class Context {
	owned f64[] values;
	init(owned f64[] incoming) { this.values = move incoming; }
	void replace(owned f64[] incoming) { this.values = move incoming; }
	int size() { return len(this.values); }
}
int main() {
	owned f64[] values = new f64[3];
	owned Context context = Context.init(move values);
	values = new f64[5];
	context.replace(move values);
	return context.size() - 5;
}
