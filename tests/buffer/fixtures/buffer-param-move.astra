void consume(owned int[] values, owned int[] replacement) {
	values = move replacement;
	if (len(values) != 4) {
		int invalid = 1 / mark(0);
	}
	release values;
	values = new int[5];
	replacement = new int[6];
}

int main() {
	owned int[] values = new int[3];
	owned int[] replacement = new int[4];
	consume(move values, move replacement);
	return 0;
}
