class Context {
	owned f64[] values;

	init() { this.values = new f64[1]; }

	void replace(int count) { this.values = new f64[count]; }

	property int width { get { return len(this.values); } set(int next) { this.values = new f64[next]; } }

	deinit() {
		mark(len(this.values));
		this.values = new f64[2];
		this.replace(3);
		this.width = 4;
		mark(len(this.values));
	}
}

int main() { owned Context context = Context.init(); return 0; }
