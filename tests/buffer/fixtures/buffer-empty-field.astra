class Context {
	owned int[] values;
	init() { this.values = new int[0]; }
	void replace() { this.values = new int[3]; this.values = new int[0]; }
	deinit() { if (len(this.values) != 0) { int invalid = 1 / mark(0); } }
}
int main() { owned Context context = Context.init(); context.replace(); return 0; }
