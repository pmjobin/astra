namespace CallableFunctions;

int increment(int value) { return value + 1; }

// An explicit nominal function object has no captured fields and needs no heap.
class Increment {
	init() {}

	int invoke(int value) { return increment(value); }
}

class Wide {
	init() {}

	i64 invoke(i64 value) { return value + 2; }
}
