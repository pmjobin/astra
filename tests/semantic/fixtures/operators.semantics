(program
	(function "operators" -> int
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return (binary - : int (prefix + : int (parameter-ref #0 "a" : int)) (binary / : int (parameter-ref #1 "b" : int) (integer 2 : int))))
			(return (binary + : int (integer 1 : int) (binary * : int (integer 2 : int) (integer 3 : int))))
			(return (binary * : int (binary + : int (integer 1 : int) (integer 2 : int)) (integer 3 : int)))
			(return (binary / : int (integer 1 : int) (integer 0 : int)))
			(return (binary % : int (integer 1 : int) (integer 0 : int)))
			(return (prefix + : int (integer -7 : int)))
		)
	)
)
