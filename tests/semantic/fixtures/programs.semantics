(program
	(function "main" -> int
		(parameters)
		(block
			(return (integer 0 : int))
		)
	)
	(function "noop" -> void
		(parameters)
		(block
			(return)
		)
	)
	(function "identity" -> int
		(parameters
			(parameter #0 "x" : int)
		)
		(block
			(return (parameter-ref #0 "x" : int))
		)
	)
	(function "arithmetic" -> int
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return (binary % : int (binary * : int (prefix - : int (binary + : int (parameter-ref #0 "a" : int) (integer 2 : int))) (parameter-ref #1 "b" : int)) (integer 3 : int)))
		)
	)
	(function "empty_for_now" -> int
		(parameters)
		(block)
	)
)
