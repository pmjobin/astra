(core-program
	(function "signed_bytes" -> i16
		(parameters
			(parameter #0 "a" : i8<16>)
			(parameter #1 "b" : i8<16>)
		)
		(block
			(return
				(dot-wrap (source i8<16>) (accumulator i16) (order modular)
					(parameter #0 : i8<16>)
					(parameter #1 : i8<16>)
				)
			)
		)
	)
