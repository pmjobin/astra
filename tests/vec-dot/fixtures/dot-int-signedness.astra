int main(){
	i8<4> s={-1,-1,-1,-1};
	i8<4> one_s={1,1,1,1};
	u8<4> u={255,255,255,255};
	u8<4> one_u=splat(1,4);
	if(dot_wrap(s,one_s,i16)!=-4) return 1;
	if(dot_wrap(u,one_u,u16)!=1020) return 2;
	if(dot_wrap(s,one_s,u16)!=65532) return 3;
	if(dot_wrap(u,one_u,i16)!=1020) return 4;
	i8<4> a={-1,0,0,0};
	i8<4> b={2,0,0,0};
	if(dot_wrap(a,b,i16)!=-2 || dot_wrap(a,b,u16)!=65534) return 5;
	return 0;
}
