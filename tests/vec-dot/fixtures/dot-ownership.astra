struct Log {int value;}

i8<16> make(borrowed Resource r,Log* log,int id){resource_touch(r);log->value=log->value*10+id;return splat(2,16);}

i32 consume(owned Resource r,i8<16> v,i32 c,Log* log){resource_touch(r);log->value=log->value*10+3;return mac_wrap(c,v,v);}

i8<16> nested(owned Resource r,Log* log){log->value=9;return splat(1,16);}

int scenario(Log* log){
	owned Resource a=create_resource(1);
	owned Resource b=create_resource(2);
	i32 result=consume(move a,make(b,log,1),dot_wrap(make(b,log,2),splat(1 as i8,16),i32),log);
	if(result!=96 || log->value!=123) return 1;
	// Capture the accumulator and first vector before nested owned transfer.
	result=mac_wrap(log->value,splat(1 as i8,16),nested(move b,log));
	if(result!=139 || log->value!=9) return 2;
	return 0;
}

int main(){
	resource_reset();
	Log log={value=0};
	if(scenario(&log)!=0) return 1;
	if(resource_destroy_count()!=2 || resource_destroy_order()!=12 || resource_live_count()!=0 || resource_error_count()!=0 || resource_touch_count()!=3) return 2;
	return 0;
}
