f32 dot2(f32<2> a,f32<2> b){return dot(a,b);}
f32 dot4(f32<4> a,f32<4> b){return dot(a,b);}
int main(){
	f32<2> a={2.0,3.0};
	f32<2> b={4.0,5.0};
	if(dot2(a,b)!=23.0){return 1;}
	if(dot4(splat(2.0,4),splat(3.0,4))!=24.0){return 2;}
	return 0;
}
