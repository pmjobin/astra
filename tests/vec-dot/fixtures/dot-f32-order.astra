f32 ordered(f32<4> a,f32<4> b){return dot(a,b);}
f32 tree(f32<4> a,f32<4> b){f32<4> p=a*b;return (p[0]+p[1])+(p[2]+p[3]);}
int main(){
	f32<4> a={16777216.0,1.0,-16777216.0,1.0};
	f32<4> b=splat(1.0,4);
	if(ordered(a,b)!=1.0){return 1;}
	if(tree(a,b)!=1.0){return 2;}
	// Pair the cancelling large terms and the small terms: different tree.
	f32 alternative=(a[0]*b[0]+a[2]*b[2])+(a[1]*b[1]+a[3]*b[3]);
	if(alternative!=2.0 || alternative==ordered(a,b)){return 3;}
	if(ordered(shuffle(a,0,2,1,3),shuffle(b,0,2,1,3))!=2.0){return 4;}
	return 0;
}
