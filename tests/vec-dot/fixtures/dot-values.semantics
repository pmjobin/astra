		(block
			(return (dot-wrap (source u32<4>) (accumulator u32) (order modular) (parameter-ref #0 "a" : u32<4>) (parameter-ref #1 "b" : u32<4>)))
		)
	)
	(function "cross_sign" -> u16
		(parameters
			(parameter #0 "a" : i8<16>)
			(parameter #1 "b" : i8<16>)
		)
		(block
			(return (dot-wrap (source i8<16>) (accumulator u16) (order modular) (parameter-ref #0 "a" : i8<16>) (parameter-ref #1 "b" : i8<16>)))
		)
	)
	(function "cross_unsigned" -> i16
		(parameters
			(parameter #0 "a" : u8<16>)
			(parameter #1 "b" : u8<16>)
		)
		(block
			(return (dot-wrap (source u8<16>) (accumulator i16) (order modular) (parameter-ref #0 "a" : u8<16>) (parameter-ref #1 "b" : u8<16>)))
		)
	)
	(function "accumulate" -> int
		(parameters
			(parameter #0 "c" : int)
			(parameter #1 "a" : i8<16>)
			(parameter #2 "b" : i8<16>)
		)
		(block
			(return (mac-wrap (source i8<16>) (accumulator int) (order modular) (acc (parameter-ref #0 "c" : int)) (parameter-ref #1 "a" : i8<16>) (parameter-ref #2 "b" : i8<16>)))
		)
	)
	(function "ordered4" -> f32
		(parameters
			(parameter #0 "a" : f32<4>)
			(parameter #1 "b" : f32<4>)
		)
		(block
			(return (dot-f32 (source f32<4>) (accumulator f32) (order ascending-lane) (parameter-ref #0 "a" : f32<4>) (parameter-ref #1 "b" : f32<4>)))
