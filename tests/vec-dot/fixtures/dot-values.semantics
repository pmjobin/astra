(program
	(function "signed_bytes" -> i16
		(parameters
			(parameter #0 "a" : i8<16>)
			(parameter #1 "b" : i8<16>)
		)
		(block
			(return (dot-wrap (source i8<16>) (accumulator i16) (order modular) (parameter-ref #0 "a" : i8<16>) (parameter-ref #1 "b" : i8<16>)))
		)
	)
	(function "signed_wide" -> int
		(parameters
			(parameter #0 "a" : i8<16>)
