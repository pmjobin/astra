// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
void emit_path(borrowed Utf8Message path) { println(path.text); }
int main(string[] args) {
	try {
		var paths = source_canonical_paths(args);
		int i = 0;
		while (i < paths.count()) { emit_path(paths.entries[i]); i = i + 1; }
		return 0;
	} catch (DuplicateSourceInput error) { println("DUPLICATE"); return 0; }
	catch (Error error) { println_stderr(error.message); return 1; }
}
