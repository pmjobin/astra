int value(int x) {
	return x + 1;
}

int break_tail(bool c) {
	int x = 0;
	while (c) {
		x = value(x);
		value(x);
		break;
		x = 99;
		value(99);
	}
	return x;
}

int continue_tail(int n) {
	int x = 0;
	while (x < n) {
		x = value(x);
		value(x);
		continue;
		x = 99;
		value(99);
	}
	return x;
}

int distinct(bool c, bool a, bool b) {
	while (c) {
		if (a) {
			return 1;
		}
		if (b) {
			break;
		}
		continue;
	}
	return 2;
}
