int zero_break(bool c) {
	int x = 5;
	while (c) {
		x = 10;
		break;
	}
	return x;
}

int continue_before(int n) {
	int i = 0;
	int x = 1;
	while (i < n) {
		i = i + 1;
		if (i == 2) {
			continue;
		}
		x = x + 1;
	}
	return x;
}

int continue_after(int n) {
	int i = 0;
	int x = 1;
	while (i < n) {
		i = i + 1;
		x = x + 1;
		continue;
	}
	return x;
}

int break_after(bool c) {
	int x = 5;
	while (c) {
		x = x + 1;
		break;
	}
	return x;
}

int body_local(int n) {
	int i = 0;
	int x = 0;
	while (i < n) {
		i = i + 1;
		if (i == 2) {
			continue;
		}
		int temp = 10;
		if (i == 4) {
			break;
		}
		temp = temp + i;
		x = x + temp;
	}
	return x;
}
