int trap_continue(int n, int divisor) {
	int i = 0;
	int x = 64;
	while (i < n) {
		i = i + 1;
		if (i == 2) {
			x = x / divisor;
			continue;
		}
		x = x - 1;
	}
	return x;
}
int trap_break(int n, int divisor) {
	int i = 0;
	int x = 64;
	while (i < n) {
		i = i + 1;
		if (n == 2) {
			x = x / divisor;
			break;
		}
		if (i == 3) {
			x = x % divisor;
			break;
		}
		x = x - 1;
	}
	return x;
}
