int nested_control(int outer_n, int inner_n) {
	int outer = 0;
	int total = 0;
	while (outer < outer_n) {
		int inner = 0;
		while (inner < inner_n) {
			inner = inner + 1;
			if (inner == 2) {
				continue;
			}
			if (inner == 4) {
				break;
			}
			total = total + 1;
		}
		outer = outer + 1;
		if (outer == 2) {
			continue;
		}
		if (outer == 4) {
			break;
		}
	}
	return total;
}
