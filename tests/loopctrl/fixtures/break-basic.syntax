(unit
	(function
		(type "int")
		(name "run")
		(parameters)
		(block
			(local (type "int") (name "i") (integer "0"))
			(while
				(condition (binary "<" (name "i") (integer "100")))
				(body
					(block
						(assign (name "i") (binary "+" (name "i") (integer "1")))
						(if
							(condition (binary "==" (name "i") (integer "7")))
							(then
								(block
									(break)
								)
							)
						)
					)
				)
			)
			(return (name "i"))
		)
	)
)
