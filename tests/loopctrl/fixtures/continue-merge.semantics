(program
	(function "continue_merge" -> int
		(parameters
			(parameter #0 "n" : int)
		)
		(locals
			(local #0 "i" : int)
			(local #1 "x" : int)
		)
		(block
			(local-init #0 "i" : int (integer 0 : int))
			(local-init #1 "x" : int (integer 0 : int))
			(while #0
				(condition (binary < : bool (local-ref #0 "i" : int) (parameter-ref #0 "n" : int)))
				(body
					(block
						(assign (local-ref #0 "i" : int) (binary + : int (local-ref #0 "i" : int) (integer 1 : int)))
						(if
							(condition (binary == : bool (local-ref #0 "i" : int) (integer 2 : int)))
							(then
								(block
									(assign (local-ref #1 "x" : int) (integer 10 : int))
									(continue #0)
								)
							)
						)
						(assign (local-ref #1 "x" : int) (integer 20 : int))
					)
				)
			)
			(return (local-ref #1 "x" : int))
		)
	)
)
