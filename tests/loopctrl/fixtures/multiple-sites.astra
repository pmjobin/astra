int multiple_continue(int n) {
	int i = 0;
	int x = 0;
	while (i < n) {
		i = i + 1;
		if (i % 3 == 0) {
			x = x + 10;
			continue;
		}
		if (i % 3 == 1) {
			x = x + 100;
			continue;
		}
		x = x + 1;
	}
	return x;
}
int multiple_break(int n) {
	int i = 0;
	int x = 5;
	while (i < n) {
		i = i + 1;
		if (n == 2) {
			x = 10;
			break;
		}
		x = x + 1;
		if (i == 3) {
			x = 20;
			break;
		}
	}
	return x;
}
