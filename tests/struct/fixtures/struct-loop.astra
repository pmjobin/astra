struct Counter { int value; bool flip; }

int count(int n) {
	Counter c = { value = 0, flip = false };
	while (c.value < n) {
		c.value = c.value + 1;
		c.flip = !c.flip;
	}
	if (c.flip) { return c.value * 10 + 1; }
	return c.value * 10;
}

int transfers(int n) {
	Counter c = { flip = false, value = 0 };
	int sum = 0;
	while (c.value < n) {
		Counter body = { value = c.value, flip = c.flip && c.value != 0 };
		c.value = c.value + 1;
		c.flip = !c.flip;
		body.value = body.value + 1;
		if (body.value == 2) { continue; }
		if (body.value == 5) { break; }
		sum = sum + body.value;
	}
	if (c.flip) { return sum * 100 + c.value * 10 + 1; }
	return sum * 100 + c.value * 10;
}

int main() {
	if (count(0) != 0 || count(1) != 11 || count(10) != 100 || count(11) != 111) { return 1; }
	if (transfers(0) != 0 || transfers(1) != 111 || transfers(20) != 851) { return 2; }
	return 0;
}
