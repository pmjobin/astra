struct Pair { int x; int y; }

int choose(bool c) {
	Pair p = { x = 0, y = 10 };
	if (c) { p.x = 1; } else { p.x = 2; }
	return p.x + p.y;
}

int multiple(bool c) {
	Pair p = { y = 0, x = 0 };
	if (c) { p.x = 2; p.y = 3; } else { p.x = 4; p.y = 5; }
	return p.x * 10 + p.y;
}

int main() {
	if (choose(true) != 11 || choose(false) != 12) { return 1; }
	if (multiple(true) != 23 || multiple(false) != 45) { return 2; }
	return 0;
}
