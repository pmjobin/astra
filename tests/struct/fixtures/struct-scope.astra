struct A { int value; }

struct B { bool value; }

int scope(bool c) {
	int result = 0;
	if (c) {
		A a = { value = 41 };
		a.value = a.value + 1;
		result = a.value;
	} else {
		B a = { value = true };
		if (a.value) result = 24;
	}
	return result;
}

int main() {
	if (scope(true) != 42 || scope(false) != 24) return 1;
	return 0;
}
