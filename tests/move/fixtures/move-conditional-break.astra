int scoped(bool condition) {
	owned void* a = create_resource(1);
	int n = 0;
	while (n < 3) {
		n = n + 1;
		if (condition) {
			owned void* b = move a;
			break;
		}
	}
	return 0;
}

int main() {
	resource_reset();
	if (scoped(true) != 0) return 1;
	if (resource_create_count() != 1 || resource_destroy_count() != 1 || resource_destroy_order() != 1 || resource_live_count() != 0 || resource_error_count() != 0) return 2;
	resource_reset();
	if (scoped(false) != 0) return 1;
	if (resource_create_count() != 1 || resource_destroy_count() != 1 || resource_destroy_order() != 1 || resource_live_count() != 0 || resource_error_count() != 0) return 2;
	return 0;
}
