int scoped() {
	int n = 0;
	while (n < 3) {
		n = n + 1;
		owned void* a = create_resource(n);
		owned void* b = move a;
		if (b == null || resource_live_count() != 1) return 1;
	}
	return 0;
}

int main() {
	resource_reset();
	if (scoped() != 0) return 1;
	if (resource_create_count() != 3 || resource_destroy_count() != 3 || resource_destroy_order() != 123 || resource_live_count() != 0 || resource_error_count() != 0) return 2;
	return 0;
}
