int scoped() {
	owned void* a = create_resource(1);
	owned void* b = create_resource(2);
	owned void* c = move a;
	return 0;
}
int main() {
	resource_reset();
	if (scoped() != 0) { return 1; }
	if (resource_create_count() != 2 || resource_destroy_count() != 2 || resource_destroy_order() != 12 || resource_live_count() != 0 || resource_error_count() != 0) { return 2; }
	return 0;
}
