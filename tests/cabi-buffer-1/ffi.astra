[CCode(buffer_abi="u8-i32")]
extern(C) int inspect_bytes(int tag, borrowed u8[] bytes, int expected);
[CCode(buffer_abi="u8-i32")]
extern(C) int two_views(borrowed u8[] first, int separator, borrowed u8[] second);
[CCode(text_abi="utf8-i32",buffer_abi="u8-i32")]
extern(C) u64 mixed_views(i64 first, borrowed string text, borrowed u8[] bytes, u64 last);
int forwarded(u8[] bytes) { return inspect_bytes(9, bytes, len(bytes)); }
int consumed(owned u8[] bytes) { return len(bytes); }
class ByteBox {
	private owned u8[] bytes;
	init() { this.bytes = new u8[3]; this.bytes[1] = 255; this.bytes[2] = 128; }
	int inspect() { return inspect_bytes(8, this.bytes, 3); }
}
int main() {
	u8[5] fixed = {7, 0, 255, 128, 7};
	if (inspect_bytes(4, slice(fixed, 1, 3), 3) != 4 || fixed[2] != 42 || fixed[0] != 7 || fixed[4] != 7) { return 1; }
	if (two_views(slice(fixed, 2, 2), 77, slice(fixed, 2, 2)) != 0 || fixed[2] != 91) { return 2; }
	if (inspect_bytes(10, slice(fixed, 5, 0), 0) != 10) { return 7; }
	var empty = new u8[0]; if (inspect_bytes(0, empty, 0) != 0) { return 3; }
	var owned_bytes = new u8[3]; owned_bytes[1] = 255; owned_bytes[2] = 128;
	if (forwarded(owned_bytes) != 9 || owned_bytes[1] != 42) { return 4; }
	if (consumed(move owned_bytes) != 3) { return 5; }
	var box = new ByteBox(); if (box.inspect() != 8) { return 6; }
	u8[3] mixed = {0, 255, 128};
	i64 first = -9223372036854775808;
	u64 last = 18446744073709551615;
	u64 expected = 18446744073709551610;
	if (mixed_views(first, "a\0b", slice(mixed), last) != expected || mixed[2] != 64) { return 8; }
	return 0;
}
