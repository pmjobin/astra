int scoped() { owned void* a = create_resource(1); resource_touch(a); owned void* b = move a; resource_touch(b); if (resource_id(b) != 1 || resource_destroy_count() != 0) { return 1; } return 0; }
int main() {
	resource_reset();
	if (scoped() != 0) { return 1; }
	if (resource_create_count() != 1 || resource_destroy_count() != 1) { return 2; }
	if (resource_effect_order() != 771 || resource_touch_count() != 2) { return 3; }
	if (resource_live_count() != 0 || resource_error_count() != 0) { return 4; }
	return 0;
}
