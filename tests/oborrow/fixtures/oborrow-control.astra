int inspect(borrowed void* p, borrowed void* q) { int i = 0; while (p != null && (p == q || q == null) && i < 3) {
		if (p != q && q != null) return 1;
		resource_touch(p);
		i = i + 1;
	} return 0; }

int scoped() { owned void* h = create_resource(1); return inspect(h, h); }

int main() {
	resource_reset();
	if (scoped() != 0) return 1;
	if (resource_create_count() != 1 || resource_destroy_count() != 1) return 2;
	if (resource_effect_order() != 7771 || resource_touch_count() != 3) return 3;
	if (resource_live_count() != 0 || resource_error_count() != 0) return 4;
	return 0;
}
