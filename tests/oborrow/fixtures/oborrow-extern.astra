extern(C) int astra_test_resource_inspect_extern(borrowed void* p); int wrapper(borrowed void* p) { return astra_test_resource_inspect_extern(p); } int scoped() { owned void* h = create_resource(1); if (wrapper(h) != 1) { return 1; } return 0; }
int main() {
	resource_reset();
	if (scoped() != 0) { return 1; }
	if (resource_create_count() != 1 || resource_destroy_count() != 1) { return 2; }
	if (resource_effect_order() != 1 || resource_touch_count() != 0) { return 3; }
	if (resource_live_count() != 0 || resource_error_count() != 0) { return 4; }
	return 0;
}
