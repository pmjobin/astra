class Counter {
	int value;
	void add(int amount) { this.value = this.value + amount; }
	int get() { return this.value; }
}
int main() {
	Counter reference = null;
	if (reference != null) { return 1; }
	Counter object = { value = 42 };
	reference = object;
	if (reference == null) { return 2; }
	object = null;
	return reference.value;
}
