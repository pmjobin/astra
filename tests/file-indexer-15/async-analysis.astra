namespace IndexAnalysis;
enum AsyncStatus { Completed, Cancelled }
async runtime VirtualExecutor throws IndexFoundation.AsyncError returns AsyncStatus;

// Every capture is an independent owner. No caller-backed path, interface loan
// or callback environment remains borrowed while the producer is suspended.
async IndexFoundation.Summary process_async(owned IndexFoundation.Store store,
	owned IndexFoundation.Utf8Message path, owned IndexFoundation.ClassificationTable policy,
	owned CheckedClosure<IndexFoundation.SinkState<int>, IndexFoundation.Error,
	IndexFoundation.Receipt, IndexFoundation.Summary, bool> sink,
	bool retry, int generation) throws IndexFoundation.Error {
	IndexFoundation.async_watch(1);
	await delay_ticks(3);
	IndexFoundation.async_watch(2);
	if (retry) {
		try {
			var rejected = process(store, 1, path.text, policy, generation, false, sink, true);
			throw new IndexFoundation.IndexError("sink did not reject");
		} catch (IndexFoundation.SinkFailure error) {
			if (store.contains(1)) { throw new IndexFoundation.IndexError("failed sink published a result"); }
		}
	}
	var result = process(store, 1, path.text, policy, generation, false, sink, false);
	int offset = 0;
	while (true) {
		int byte = store.report_byte(1, offset);
		if (byte < 0) { break; }
		if (!IndexFoundation.write_byte(byte)) { throw new IndexFoundation.IndexError("output"); }
		offset = offset + 1;
	}
	return result;
}
