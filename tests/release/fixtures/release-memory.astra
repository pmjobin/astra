struct Pair { int x; }

int scoped() {
	Pair pair = { x = 0 };
	Pair* p = &pair;
	owned void* h = create_resource(1);
	p->x = record_effect(2);
	release h;
	int x = p->x;
	if (x != 2) return 1;
	record_effect(3);
	return 0;
}

int main() {
	resource_reset();
	if (scoped() != 0) return 1;
	if (resource_create_count() != 1 || resource_destroy_count() != 1) return 2;
	if (resource_destroy_order() != 1 || resource_effect_order() != 213) return 3;
	if (resource_live_count() != 0 || resource_error_count() != 0) return 4;
	return 0;
}
