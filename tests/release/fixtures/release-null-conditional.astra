int scoped(bool c) {
	owned void* h = create_resource(0);
	if (h != null) { return 1; }
	if (c) { release h; }
	return 0;
}
int main() {
	resource_reset();
	if (scoped(true) != 0 || scoped(false) != 0) { return 1; }
	if (resource_create_count() != 2 || resource_destroy_count() != 0 || resource_live_count() != 0 || resource_error_count() != 0) { return 2; }
	return 0;
}
