int scoped() {
	owned void* a = create_resource(1);
	owned void* b = create_resource(2);
	owned void* c = create_resource(3);
	release b;
	if (resource_destroy_order() != 2) return 1;
	return 0;
}

int main() {
	resource_reset();
	if (scoped() != 0) return 1;
	if (resource_create_count() != 3 || resource_destroy_count() != 3) return 2;
	if (resource_destroy_order() != 231 || resource_effect_order() != 231) return 3;
	if (resource_live_count() != 0 || resource_error_count() != 0) return 4;
	return 0;
}
