int scoped() {
	owned void* h = create_resource(0);
	if (h != null) { return 1; }
	if (resource_null_count() != 0) { return 2; }
	resource_touch(h);
	release h;
	if (resource_destroy_count() != 0) { return 3; }
	return 0;
}
int main() {
	resource_reset();
	if (scoped() != 0) { return 1; }
	if (resource_create_count() != 1 || resource_destroy_count() != 0) { return 2; }
	if (resource_destroy_order() != 0 || resource_effect_order() != 0) { return 3; }
	if (resource_live_count() != 0 || resource_error_count() != 0) { return 4; }
	if (resource_null_count() != 1) { return 5; }
	return 0;
}
