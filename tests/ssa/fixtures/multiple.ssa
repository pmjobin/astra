(ssa-program
	(function #0 "multiple" -> int
		(parameters
			(%0 "c" : bool)
			(%1 "a" : int)
			(%2 "b" : int)
		)
		(entry #0)
		(block #0
			(conditional-branch %0
				(true #1 ())
				(false #2 ())
			)
		)
		(block #1
			(branch #3 (%1 %2))
		)
		(block #2
			(branch #3 (%2 %1))
		)
		(block #3
			(arguments
				(%3 "x" : int)
				(%4 "y" : int)
			)
			(%5 : int = binary + %3 %4)
			(return %5)
		)
	)
)
