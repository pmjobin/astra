(ssa-program
	(function #0 "arithmetic" -> int
		(parameters
			(%0 "a" : int)
			(%1 "b" : int)
		)
		(entry #0)
		(block #0
			(%2 : int = binary + %0 (integer 2 : int))
			(%3 : int = prefix - %2)
			(%4 : int = binary * %3 %1)
			(%5 : int = binary % %4 (integer 3 : int))
			(return %5)
		)
	)
)
