(ssa-program
	(function #0 "choose" -> int
		(parameters
			(%0 "condition" : bool)
			(%1 "a" : int)
			(%2 "b" : int)
		)
		(entry #0)
		(block #0
			(conditional-branch %0
				(true #1 ())
				(false #2 ())
			)
		)
		(block #1
			(branch #3 (%1))
		)
		(block #2
			(branch #3 (%2))
		)
		(block #3
			(arguments
				(%3 "x" : int)
			)
			(return %3)
		)
	)
)
