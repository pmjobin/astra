(core-program
	(function "arithmetic" -> int
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return
				(binary % : int
					(binary * : int
						(prefix - : int
							(binary + : int
								(parameter #0 : int)
								(integer 2 : int)
							)
						)
						(parameter #1 : int)
					)
					(integer 3 : int)
				)
			)
		)
	)
)
