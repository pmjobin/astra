(unit
	(function
		(type "int")
		(name "f")
		(parameters
			(parameter (type "bool") (name "c"))
		)
		(block
			(local (type "int") (name "x") (integer "0"))
			(if
				(condition (name "c"))
				(then
					(block
						(assign (name "x") (integer "1"))
					)
				)
			)
			(return (name "x"))
		)
	)
)
