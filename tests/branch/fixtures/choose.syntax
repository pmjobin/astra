(unit
	(function
		(type "int")
		(name "choose")
		(parameters
			(parameter (type "bool") (name "condition"))
			(parameter (type "int") (name "a"))
			(parameter (type "int") (name "b"))
		)
		(block
			(local (type "int") (name "x") (integer "0"))
			(if
				(condition (name "condition"))
				(then
					(block
						(assign (name "x") (name "a"))
					)
				)
				(else
					(block
						(assign (name "x") (name "b"))
					)
				)
			)
			(return (name "x"))
		)
	)
)
