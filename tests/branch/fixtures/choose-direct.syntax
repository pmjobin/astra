(unit
	(function
		(type "int")
		(name "choose_direct")
		(parameters
			(parameter (type "bool") (name "condition"))
		)
		(block
			(if
				(condition (name "condition"))
				(then
					(block
						(return (integer "1"))
					)
				)
				(else
					(block
						(return (integer "2"))
					)
				)
			)
		)
	)
)
