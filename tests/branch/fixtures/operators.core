(core-program
	(function "yes" -> bool
		(parameters)
		(block
			(return
				(bool true : bool)
			)
		)
	)
	(function "invert" -> bool
		(parameters
			(parameter #0 "x" : bool)
		)
		(block
			(return
				(prefix ! : bool
					(parameter #0 : bool)
				)
			)
		)
	)
	(function "different" -> bool
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return
				(prefix ! : bool
					(binary == : bool
						(parameter #0 : int)
						(parameter #1 : int)
					)
				)
			)
		)
	)
	(function "compare" -> bool
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return
				(binary == : bool
					(binary < : bool
						(binary + : int
							(parameter #0 : int)
							(integer 1 : int)
						)
						(binary * : int
							(parameter #1 : int)
							(integer 2 : int)
						)
					)
					(bool true : bool)
				)
			)
		)
	)
	(function "less_equal" -> bool
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return
				(binary <= : bool
					(parameter #0 : int)
					(parameter #1 : int)
				)
			)
		)
	)
	(function "greater" -> bool
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return
				(binary > : bool
					(parameter #0 : int)
					(parameter #1 : int)
				)
			)
		)
	)
	(function "greater_equal" -> bool
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return
				(binary >= : bool
					(parameter #0 : int)
					(parameter #1 : int)
				)
			)
		)
	)
	(function "unequal" -> bool
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return
				(binary != : bool
					(parameter #0 : int)
					(parameter #1 : int)
				)
			)
		)
	)
	(function "same_bool" -> bool
		(parameters
			(parameter #0 "a" : bool)
			(parameter #1 "b" : bool)
		)
		(block
			(return
				(binary != : bool
					(binary == : bool
						(parameter #0 : bool)
						(parameter #1 : bool)
					)
					(bool false : bool)
				)
			)
		)
	)
)
