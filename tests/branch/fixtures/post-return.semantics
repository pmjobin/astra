(program
	(function "f" -> int
		(parameters
			(parameter #0 "c" : bool)
		)
		(block
			(return (integer 1 : int))
			(if
				(condition (parameter-ref #0 "c" : bool))
				(then
					(block
						(return (integer 2 : int))
					)
				)
				(else
					(block
						(return (integer 3 : int))
					)
				)
			)
		)
	)
)
