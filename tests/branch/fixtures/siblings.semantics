(program
	(function "f" -> void
		(parameters
			(parameter #0 "c" : bool)
		)
		(locals
			(local #0 "x" : int)
			(local #1 "x" : int)
		)
		(block
			(if
				(condition (parameter-ref #0 "c" : bool))
				(then
					(block
						(local-init #0 "x" : int (integer 1 : int))
					)
				)
				(else
					(block
						(local-init #1 "x" : int (integer 2 : int))
					)
				)
			)
			(return)
		)
	)
)
