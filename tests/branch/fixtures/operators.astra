bool yes() {
	return true;
}

bool invert(bool x) {
	return !x;
}

bool different(int a, int b) {
	return !(a == b);
}

bool compare(int a, int b) {
	return a + 1 < b * 2 == true;
}

bool less_equal(int a, int b) {
	return a <= b;
}

bool greater(int a, int b) {
	return a > b;
}

bool greater_equal(int a, int b) {
	return a >= b;
}

bool unequal(int a, int b) {
	return a != b;
}

bool same_bool(bool a, bool b) {
	return a == b != false;
}
