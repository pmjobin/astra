(unit
	(struct "Box"
		(type-parameters T)
		(field (type "T") (name "value"))
	)
	(struct "Bundle"
		(type-parameters T)
		(field (type "Box<T>") (name "left"))
		(field (type "Box<T>") (name "right"))
		(field (type "ConcretePair") (name "meta"))
	)
	(struct "ConcretePair"
		(field (type "int") (name "x"))
		(field (type "f64") (name "y"))
	)
	(function
		(type-parameters T)
		(type "T")
		(name "pass")
		(parameters
			(parameter (type "T") (name "value"))
		)
		(block
			(struct-local (type "ConcretePair") (name "a")
				(initialize-field "x" (integer "2"))
				(initialize-field "y" (float "1.0"))
			)
			(local (type "ConcretePair") (name "b") (name "a"))
			(struct-local (type "Box<int>") (name "c")
				(initialize-field "value" (field-access "b" "x"))
			)
			(local (type "Box<i32>") (name "d") (name "c"))
			(assign (name "c") (name "d"))
			(return (name "value"))
		)
	)
	(function
		(type "int")
		(name "main")
		(parameters)
		(block
			(struct-local (type "Box<int>") (name "a")
				(initialize-field "value" (integer "42"))
			)
			(local (type "Box<i32>") (name "b") (name "a"))
			(assign (name "b") (name "a"))
			(struct-local (type "Box<f64>") (name "c")
				(initialize-field "value" (float "3.5"))
			)
			(local (type "Box<f64>") (name "d") (name "c"))
			(struct-local (type "Box<i16<8>>") (name "e")
				(initialize-field "value" (vector-splat (integer "7") (ordinals 8)))
			)
			(local (type "Box<i16<8>>") (name "f") (name "e"))
			(struct-local (type "Bundle<f64>") (name "g")
				(initialize-field "left" (storage-initializer
					(initialize-field "value" (float "1.5"))
				))
				(initialize-field "right" (storage-initializer
					(initialize-field "value" (float "2.5"))
				))
				(initialize-field "meta" (storage-initializer
					(initialize-field "x" (integer "7"))
					(initialize-field "y" (float "1.5"))
				))
			)
			(local (type "Bundle<f64>") (name "h") (name "g"))
			(assign (field-access "h" "left") (field-access "h" "right"))
			(local (type "ConcretePair") (name "metadata") (field-access "h" "meta"))
			(assign (field-access "h" "meta") (name "metadata"))
			(local (type "Box<f64>") (name "i") (field-access "h" "left"))
			(local (type "Box<int>*") (name "p") (address-of "b"))
			(assign (dereference (name "p")) (name "a"))
			(local (type "Box<i32>") (name "j") (dereference (name "p")))
			(if
				(condition (short-circuit "||" (short-circuit "||" (short-circuit "||" (short-circuit "||" (short-circuit "||" (short-circuit "||" (short-circuit "||" (short-circuit "||" (binary "!=" (field-access (base (field-access "h" "meta")) "x") (integer "7")) (binary "!=" (field-access "metadata" "y") (float "1.5"))) (binary "!=" (field-access "j" "value") (integer "42"))) (binary "!=" (field-access "d" "value") (float "3.5"))) (binary "!=" (vector-extract (lane 7) (field-access "f" "value")) (integer "7"))) (binary "!=" (field-access (base (field-access "h" "left")) "value") (float "2.5"))) (binary "!=" (field-access (base (field-access "g" "left")) "value") (float "1.5"))) (binary "!=" (field-access "i" "value") (float "2.5"))) (binary "!=" (generic-call "pass" (type-arguments int) (arguments (integer "42"))) (integer "42"))))
				(then
					(block
						(return (integer "1"))
					)
				)
			)
			(return (integer "0"))
		)
	)
)
