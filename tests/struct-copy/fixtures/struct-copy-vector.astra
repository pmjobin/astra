struct S { i16<8> v; f32<4> f; bool<4> mask; }
void copy(S* d, S* s) { *d = *s; }
int main() {
	S a = { v = splat(7,8), f = splat(1.5,4), mask = splat(true,4) };
	S b = a;
	copy(&b,&a);
	b.v = insert(b.v,7,42);
	if (a.v[7] != 7 || b.v[7] != 42 || b.f[2] != 1.5 || !b.mask[3]) { return 1; }
	return 0;
}
