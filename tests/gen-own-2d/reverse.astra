int main() {
	var heap = new Counter(20, 1);
	owned Counter lexical = Counter.init(10, 0);
	if (stage(20, move heap, true, false) != 20) { return 81; }
	if (stage<Counter>(10, move lexical, false, false) != 10) { return 81; }
	return own_finish();
}
