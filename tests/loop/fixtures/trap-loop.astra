int divide_loop(int n, int divisor) {
	int i = 0;
	int x = 64;
	while (i < n) {
		x = x / divisor;
		i = i + 1;
	}
	return x;
}
int remainder_loop(int n, int divisor) {
	int i = 0;
	int x = 64;
	while (i < n) {
		x = x % divisor;
		i = i + 1;
	}
	return x;
}
int condition_divide(int a, int b) {
	int x = a;
	while ((x / b) > 0) {
		x = x - 1;
	}
	return x;
}
