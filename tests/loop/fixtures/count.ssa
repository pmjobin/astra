(ssa-program
	(function #0 "count" -> int
		(parameters
			(%0 "n" : int)
		)
		(entry #0)
		(block #0
			(branch #1 ((integer 0 : int)))
		)
		(block #1
			(arguments
				(%1 "i" : int)
			)
			(%2 : bool = binary < %1 %0)
			(conditional-branch %2
				(true #2 ())
				(false #3 ())
			)
		)
		(block #2
			(%3 : int = binary + %1 (integer 1 : int))
			(branch #1 (%3))
		)
		(block #3
			(return %1)
		)
	)
)
