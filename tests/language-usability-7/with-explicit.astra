// Explicit equivalent for the one-evaluation and lifetime trace oracle.
extern(C) void usability_event(int tag);
class Config {
	int port;
	readonly string name;
	init(int port) { this.port = port; this.name = "config"; }
	property int next { get { return this.port + 1; } }
	deinit() { usability_event(100 + this.port); }
}
owned Config make_config(int tag) {
	usability_event(tag);
	var config = new Config(tag);
	return move config;
}
void fail() throws Error { usability_event(90); throw new Error("checked exit"); }
int render(bool early) throws Error {
	{
		var config = make_config(1);
		usability_event(10 + config.port);
		usability_event(20 + config.next);
		{
			var nested = make_config(2);
			usability_event(30 + nested.port);
			usability_event(40 + config.port);
		}
		if (early) { return 7; }
		fail();
	}
	return 0;
}
int main() {
	try { if (render(true) != 7) { return 1; } }
	catch (Error error) { return 2; }
	try { render(false); return 3; }
	catch (Error error) { usability_event(91); }
	var config = new Config(3);
	{ usability_event(50 + config.port); }
	usability_event(92);
	return 0;
}
