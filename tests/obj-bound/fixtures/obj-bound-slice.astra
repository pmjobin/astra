class Counter { int value; }

int process(borrowed Counter c, borrowed int[] values) {
	int i = 0;
	while (i < len(values)) {
		c.value = c.value + values[i];
		i = i + 1;
	}
	values[0] = c.value;
	return c.value;
}

int main() {
	Counter c = { value = 1 };
	int[3] values = { 10, 20, 11 };
	if (process(c, slice(values)) != 42 || values[0] != 42) return 1;
	return c.value;
}
