// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
struct Pair<T,U> { T first; U second; }
T first<T,U>(T a, U b) { Pair<T,U> p = { first = a, second = b }; return p.first; }
int main() {
	i16<8> samples = { 1, 2, 3, 4, 5, 6, 7, 8 };
	bool<4> mask = { true, false, true, false };
	if (first<int,f64>(42, 3.5) != 42 || first<i32,f64>(43, 4.5) != 43 || first<f64,int>(3.5, 42) != 3.5) { return 1; }
	if (!all(first<i16<8>,bool>(samples, true) == samples) || !all(first<bool<4>,u32>(mask, 7) == mask)) { return 2; }
	if (first<i8,f64>(7, 1.0) != 7 || first<u8,f64>(8, 1.0) != 8) { return 3; }
	return 0;
}
