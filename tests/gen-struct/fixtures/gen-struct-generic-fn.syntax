		(block
			(struct-local (type "Pair<T,U>") (name "p")
				(initialize-field "first" (name "a"))
				(initialize-field "second" (name "b"))
			)
			(return (field-access "p" "first"))
		)
	)
	(function
		(type "int")
		(name "main")
		(parameters)
		(block
			(local (type "i16<8>") (name "samples") (vector-init (integer "1") (integer "2") (integer "3") (integer "4") (integer "5") (integer "6") (integer "7") (integer "8")))
			(local (type "bool<4>") (name "mask") (vector-init (bool true) (bool false) (bool true) (bool false)))
			(if
				(condition (short-circuit "||" (short-circuit "||" (binary "!=" (generic-call "first" (type-arguments int f64) (arguments (integer "42") (float "3.5"))) (integer "42")) (binary "!=" (generic-call "first" (type-arguments i32 f64) (arguments (integer "43") (float "4.5"))) (integer "43"))) (binary "!=" (generic-call "first" (type-arguments f64 int) (arguments (float "3.5") (integer "42"))) (float "3.5"))))
				(then
					(block
						(return (integer "1"))
					)
				)
			)
			(if
				(condition (short-circuit "||" (prefix "!" (vector-all (binary "==" (generic-call "first" (type-arguments i16<8> bool) (arguments (name "samples") (bool true))) (name "samples")))) (prefix "!" (vector-all (binary "==" (generic-call "first" (type-arguments bool<4> u32) (arguments (name "mask") (integer "7"))) (name "mask"))))))
				(then
					(block
