struct Tagged<T> { int value; }
struct A<T> { T value; }
struct B<T> { T value; }
struct Unused<T> { T value; }
int main() {
	Tagged<i8> a = { value = 1 };
	Tagged<u8> b = { value = 2 };
	A<int> c = { value = 3 };
	B<int> d = { value = 4 };
	if (a.value + b.value + c.value + d.value != 10) { return 1; }
	return 0;
}
