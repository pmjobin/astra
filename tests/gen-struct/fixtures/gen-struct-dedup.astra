struct Pair<T,U> { T first; U second; }
struct Bundle<T> { Pair<T,T> pair; int tag; }
struct Box<T> { T value; }
T first<T,U>(T a, U b) { Pair<T,U> p = { first = a, second = b }; return p.first; }
int main() {
	Pair<f64,f64> p = { first = 1.0, second = 2.0 };
	Bundle<f64> b = { pair = { first = p.first, second = p.second }, tag = 7 };
	Box<int> i = { value = 1 };
	Box<i32> j = { value = 2 };
	Box<i8> s = { value = 3 };
	Box<u8> u = { value = 4 };
	if (first<f64,f64>(b.pair.first, b.pair.second) != 1.0 || i.value + j.value != 3 || s.value != 3 || u.value != 4) { return 1; }
	return 0;
}
