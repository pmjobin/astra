(program
	(generic-definition "identity" checked-once GEN1_PLAIN_COPY)
	(type-parameter #0 T)
	(function "identity" -> T
		(parameters
			(parameter #0 "value" : T)
		)
		(block
			(return (parameter-ref #0 "value" : T))
		)
	)
	(function "main" -> int
		(parameters)
		(block
			(return (generic-call "identity" -> int (type-arguments int) (arguments (integer 42 : int))))
		)
	)
)
