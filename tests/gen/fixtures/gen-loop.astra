T loop_choose<T>(int count, T a, T b) {
	T current = a;
	int i = 0;
	while (i < count) { current = b; i = i + 1; }
	return current;
}
int main() {
	f64 f = loop_choose<f64>(3, 0.0, 1.25);
	i16<8> a = {1,2,3,4,5,6,7,8};
	i16<8> b = {42,2,3,4,5,6,7,8};
	i16<8> v = loop_choose<i16<8>>(3, a, b);
	if (f == 1.25 && v[0] == 42) { return loop_choose<int>(3,0,42); }
	return 1;
}
