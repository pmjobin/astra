(unit
	(function
		(type-parameters T)
		(type "T")
		(name "identity")
		(parameters
			(parameter (type "T") (name "value"))
		)
		(block
			(return (name "value"))
		)
	)
	(function
		(type "int")
		(name "main")
		(parameters)
		(block
			(return (generic-call "identity" (type-arguments int) (arguments (integer "42"))))
		)
	)
)
