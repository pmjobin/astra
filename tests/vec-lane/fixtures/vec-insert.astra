struct Log { int order; }

int<4> vector(Log* log) { log->order = log->order * 10 + 1; int<4> v = {10, 20, 30, 40}; return v; }

int scalar(Log* log) { log->order = log->order * 10 + 2; return 99; }

int<4> replace(int<4> v, int x) { return insert(v, 2, x); }

int main() {
	Log log = {order = 0};
	int<4> v = insert(vector(&log), 2, scalar(&log));
	int<4> expected = {10, 20, 99, 40};
	if (log.order != 12 || !all(v == expected)) return 1;
	int<4> copy = v;
	v = insert(insert(v, 0, 1), 3, 4);
	if (v[0] != 1 || v[1] != 20 || v[2] != 99 || v[3] != 4 || !all(copy == expected)) return 2;
	u8<4> bytes = splat(255, 4);
	u8 wrap = bytes[0] + 1;
	bytes = insert(bytes, 0, wrap);
	if (bytes[0] != 0 || bytes[1] != 255 || bytes[3] != 255) return 3;
	bool<4> mask = splat(false, 4);
	mask = insert(mask, 1, true);
	if (!any(mask) || all(mask) || !mask[1]) return 4;
	return 0;
}
