i16<4> compose(i16 x, bool<4> mask) {
	i16<4> v = splat(x, 4);
	i16 lane = v[2];
	v = insert(v, 1, lane);
	v = shuffle(v, 3, 2, 1, 0);
	return select(mask, v, v);
}
int main() {
	i16<4> expected = {7, 7, 7, 7};
	if (!all(compose(7, splat(true, 4)) == expected)) { return 1; }
	return 0;
}
