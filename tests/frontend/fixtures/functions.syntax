(unit
	(function
		(type "int")
		(name "main")
		(parameters)
		(block
			(return (integer "0"))
		)
	)
	(function
		(type "int")
		(name "add")
		(parameters
			(parameter (type "int") (name "a"))
			(parameter (type "int") (name "b"))
		)
		(block
			(return (binary "+" (name "a") (name "b")))
		)
	)
	(function
		(type "number")
		(name "f")
		(parameters
			(parameter (type "number") (name "x"))
		)
		(block
			(return (binary "*" (prefix "-" (parenthesized (binary "+" (name "x") (integer "2")))) (integer "3")))
		)
	)
	(function
		(type "void")
		(name "noop")
		(parameters)
		(block
			(return)
		)
	)
	(function
		(type "UnknownType")
		(name "f")
		(parameters)
		(block
			(return (name "mystery"))
		)
	)
	(function
		(type "Whatever")
		(name "f")
		(parameters)
		(block)
	)
)
