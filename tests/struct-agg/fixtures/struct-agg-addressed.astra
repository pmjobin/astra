struct Inner { int x; f64 gain; }

struct Outer { Inner inner; int tag; }

void change(Outer* p) { p->inner.x = 42; p->inner.gain = 0.25; }

int pay_for_use(bool pick) {
	Outer a = { inner = { x = 10, gain = 0.5 }, tag = 1 };
	Outer b = { inner = { x = 20, gain = 0.75 }, tag = 2 };
	if (pick) a.inner.x = 11;
	change(&b);
	if (b.inner.x != 42 || b.inner.gain != 0.25 || a.inner.gain != 0.5) return -1;
	return a.inner.x;
}

int main() { if (pay_for_use(false) != 10 || pay_for_use(true) != 11) return 1; return 0; }
