struct Inner { int x; }
struct Outer {
	Inner inner;
	int read() { return this.inner.x; }
	void write(int value) { this.inner.x = value; }
	property int x { get { return this.inner.x; } set(int value) { this.inner.x = value; } }
}
int main() {
	Outer o = { inner = { x = 10 } };
	if (o.read() != 10 || o.x != 10) { return 1; }
	o.write(20); o.x = o.x + 22;
	if (o.inner.x != 42 || o.read() != 42) { return 2; }
	return 0;
}
