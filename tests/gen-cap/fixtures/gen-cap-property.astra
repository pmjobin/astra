T max_value<T>(T value,T other) where T : Ordered {
	if(value<other){return other;}
	return value;
}
int ordinary(int x) { return x; }
struct S { int raw; int get_raw() { return max_value<int>(this.raw,0); } }
class Counter {
	int raw;
	init(int x) { this.raw = max_value<int>(x,0); }
	int read() { return max_value<int>(this.raw,0); }
	property int value { get { return max_value<int>(this.raw,0); } set(int next) { this.raw = max_value<int>(next,0); } }
}
T observe<T>(borrowed Counter counter, T value) where T : Ordered {
	int property_value = counter.value;
	int method_value = counter.read();
	int field_value = counter.raw;
	int free_value = ordinary(field_value);
	S s = {raw=free_value}; int struct_value = s.get_raw();
	if (property_value == method_value && struct_value == field_value) { counter.value = free_value; }
	if(value<value){return value;}
	return value;
}
int main() {
	Counter c = Counter.init(42);
	f64 f = observe<f64>(c,1.25);
	if (f == 1.25 && c.value == 42) { return observe<int>(c,42); }
	return 1;
}
