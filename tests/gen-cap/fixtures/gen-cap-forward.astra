T inner<T>(T a,T b) where T : Numeric {return a+b;}
T outer<T,U>(T a,T b,U token) where U : Eq where T : Numeric {if(token==token){return inner<T>(a,b);}return a;}
int tag<T>() where T : Eq {return 1;}
T unused<T>(T a,T b) where T : Numeric {return a/b;}
int main(){int a=outer<int,bool>(40,2,true);int b=outer<i32,bool>(40,2,false);i8 c=inner<i8>(1,2);u8 d=inner<u8>(1,2);if(a==b && c==3 && d==3 && tag<int>()==tag<f64>()){return a;}return 1;}
