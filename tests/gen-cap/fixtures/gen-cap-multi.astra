bool less_or_same<T>(T a,T b) where T : Eq, Ordered {return a==b || a<b;}
T multi<T,U>(T a,T b,U token) where U : Eq where T : Numeric, Bitwise {if(token==token){return (a+b)^b;}return a;}
int tag<T>() where T : Numeric, Shift {return 1;}
int main(){if(less_or_same<f64>(1.0,2.0) && multi<int,bool>(40,1,true)==40 && tag<u32>()==1){return 42;}return 1;}
