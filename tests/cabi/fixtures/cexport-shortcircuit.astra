extern(C) void astra_test_reset();

extern(C) int astra_test_state();

extern(C) int astra_test_record(int value);

extern(C) int c_call_astra_shortcircuit(int value);

export(C) int astra_export_shortcircuit(int x) {
	bool both = (x != 0) && (astra_test_record(1) != 0);
	bool either = (x == 0) || (astra_test_record(2) != 0);
	if (both && either) {
		return 1;
	}
	return 0;
}

int main() {
	astra_test_reset();
	if (c_call_astra_shortcircuit(0) != 0 || astra_test_state() != 0) {
		return 1;
	}
	if (c_call_astra_shortcircuit(1) != 1 || astra_test_state() != 12) {
		return 2;
	}
	return 0;
}
