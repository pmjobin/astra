int main() {
	observe_begin(1, 0);
	owned R value = create_r(1);
	int count = 0;
	while (count < 3) {
		if (count == 1) { leaf<R>(value, 66); }
		else { forward(value, 70); }
		count = count + 1;
	}
	if (resource_id(value) != 1) { return 81; }
	wrapper<R>(move value);
	return observe_end();
}
