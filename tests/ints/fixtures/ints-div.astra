// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
i8 div8(i8 a, i8 b) { return a / b; }

i8 rem8(i8 a, i8 b) { return a % b; }

i16 div16(i16 a, i16 b) { return a / b; }

i16 rem16(i16 a, i16 b) { return a % b; }

i32 div32(i32 a, i32 b) { return a / b; }

i32 rem32(i32 a, i32 b) { return a % b; }

u8 udiv8(u8 a, u8 b) { return a / b; }

u8 urem8(u8 a, u8 b) { return a % b; }

u16 udiv16(u16 a, u16 b) { return a / b; }

u16 urem16(u16 a, u16 b) { return a % b; }

u32 udiv32(u32 a, u32 b) { return a / b; }

u32 urem32(u32 a, u32 b) { return a % b; }

int main() {
	if (div8(-128, -1) != -128 || rem8(-128, -1) != 0) return 1;
	if (div16(-32768, -1) != -32768 || rem16(-32768, -1) != 0) return 2;
	if (div32(-2147483648, -1) != -2147483648 || rem32(-2147483648, -1) != 0) return 3;
	if (div8(-7, 3) != -2 || rem8(-7, 3) != -1 || div8(7, -3) != -2 || rem8(7, -3) != 1) return 4;
	if (div16(-7, -3) != 2 || rem16(-7, -3) != -1 || div16(7, 3) != 2 || rem16(7, 3) != 1) return 5;
	if (udiv8(255, 2) != 127 || urem8(255, 2) != 1) return 6;
	if (udiv16(65535, 256) != 255 || urem16(65535, 256) != 255) return 7;
	if (udiv32(4294967295, 2) != 2147483647 || urem32(4294967295, 2) != 1) return 8;
	return 0;
}
