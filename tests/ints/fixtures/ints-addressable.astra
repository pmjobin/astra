// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
struct Packet { u8 tag; i16 delta; u32 checksum; i8 signed_tag; u16 length; }
void mutate(Packet* p, int n) {
	int i = 0;
	while (i < n) { p->tag = 1 + p->tag; p->delta = p->delta + 1; p->checksum = p->checksum + 1; p->signed_tag = p->signed_tag - 1; p->length = p->length + 1; i = i + 1; }
}
int main() {
	Packet p = { tag = 255, delta = 32767, checksum = 4294967295, signed_tag = -128, length = 65535 };
	mutate(&p, 2);
	if (p.tag != 1 || p.delta != -32767 || p.checksum != 1 || p.signed_tag != 126 || p.length != 1) { return 1; }
	return 0;
}
