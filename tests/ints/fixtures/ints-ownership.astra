u8 mode(borrowed Resource r) { if (resource_touch_count() != 0) return 0; resource_touch(r); return 250; }

u16 count(borrowed Resource r) { if (resource_touch_count() != 1) return 0; resource_touch(r); return 10; }

int process(u8 mode_value, owned Resource r, u16 count_value) {
	if (resource_touch_count() != 2 || resource_destroy_count() != 0) return 1;
	u8 x = mode_value;
	u16 i = 0;
	while (i < count_value) {
		if (i < 2) resource_touch(r);
		x = x + 1;
		i = i + 1;
	}
	if (x != 4 || i != 10 || resource_touch_count() != 4) return 2;
	return 0;
}

int scenario() {
	owned Resource a = create_resource(1);
	owned Resource b = create_resource(2);
	return process(mode(a), move a, count(b));
}

int main() {
	resource_reset();
	if (scenario() != 0) return 1;
	if (resource_destroy_count() != 2 || resource_destroy_order() != 12 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 4) return 2;
	return 0;
}
