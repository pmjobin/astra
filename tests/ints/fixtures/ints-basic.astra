int main() {
	i8 a = -128;
	i8 b = 127;
	u8 c = 0;
	u8 d = 255;
	i16 e = -32768;
	i16 f = 32767;
	u16 g = 0;
	u16 h = 65535;
	i32 i = -2147483648;
	int j = 2147483647;
	u32 k = 0;
	u32 l = 4294967295;
	if (a != -128 || b != 127 || c != 0 || d != 255) { return 1; }
	if (e != -32768 || f != 32767 || g != 0 || h != 65535) { return 2; }
	if (i != -2147483648 || j != 2147483647 || k != 0 || l != 4294967295) { return 3; }
	return 0;
}
