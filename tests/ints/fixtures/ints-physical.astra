i8 add_i8(i8 x, i8 y) { return x + y; }

i8 sub_i8(i8 x, i8 y) { return x - y; }

i8 mul_i8(i8 x, i8 y) { return x * y; }

i8 div_i8(i8 x, i8 y) { return x / y; }

i8 rem_i8(i8 x, i8 y) { return x % y; }

i8 positive_i8(i8 x) { return +x; }

i8 negative_i8(i8 x) { return -x; }

bool lt_i8(i8 x, i8 y) { return x < y; }

bool le_i8(i8 x, i8 y) { return x <= y; }

bool gt_i8(i8 x, i8 y) { return x > y; }

bool ge_i8(i8 x, i8 y) { return x >= y; }

bool eq_i8(i8 x, i8 y) { return x == y; }

bool ne_i8(i8 x, i8 y) { return x != y; }

