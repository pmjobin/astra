struct Packet { u8 tag; i16 delta; u32 checksum; }

bool packet(bool c, int n) {
	Packet p = { tag = 255, delta = -32768, checksum = 4294967295 };
	if (c) {
		p.tag = 254;
		p.delta = 32767;
	} else {
		p.tag = 253;
		p.delta = 32766;
	}
	int i = 0;
	while (i < n) {
		p.tag = p.tag + 1;
		p.delta = p.delta + 1;
		p.checksum = p.checksum + 1;
		i = i + 1;
	}
	if (c) return p.tag == 0 && p.delta == -32767 && p.checksum == 1;
	return p.tag == 255 && p.delta == -32768 && p.checksum == 1;
}

int main() { if (!packet(true, 2) || !packet(false, 2)) return 1; return 0; }
