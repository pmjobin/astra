// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
u8 cycle8(int n) { u8 x = 250; int i = 0; while (i < n) {
		x = x + 1;
		i = i + 1;
	} return x; }

i8 signed8(int n) { i8 x = 120; int i = 0; while (i < n) {
		x = x + 1;
		i = i + 1;
	} return x; }

u16 cycle16(int n) { u16 x = 65530; int i = 0; while (i < n) {
		x = x + 1;
		i = i + 1;
	} return x; }

i8 split8(i8 initial, i8 d, int n) { i8 x = initial; int i = 0; while (i < n) {
		i = i + 1;
		x = x / d;
	} return x; }

i16 split16(i16 initial, i16 d, int n) { i16 x = initial; int i = 0; while (i < n) {
		i = i + 1;
		x = x % d;
	} return x; }

u8 unsigned_split(u8 initial, u8 d, int n) { u8 x = initial; int i = 0; while (i < n) {
		i = i + 1;
		x = x / d;
	} return x; }

int main() {
	if (cycle8(0) != 250 || cycle8(10) != 4 || cycle8(266) != 4) return 1;
	if (signed8(10) != -126 || signed8(266) != -126 || cycle16(10) != 4 || cycle16(65546) != 4) return 2;
	if (split8(-128, -1, 3) != -128 || split8(100, 2, 3) != 12) return 3;
	if (split16(-32768, -1, 3) != 0 || split16(-32767, 100, 1) != -67) return 4;
	if (unsigned_split(255, 2, 3) != 31) return 5;
	return 0;
}
