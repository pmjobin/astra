// The contextual Class marker must not reserve an ordinary buffer count name.
class Numbers {
	owned int[] values;
	init(int slots) { this.values = new int[slots]; }
}
bool fixed_spelling() {
	const slots = 2;
	int[slots] pair = {10, 20};
	int[slots + 1] triple = {30, 40, 50};
	return len(pair) == 2 && len(triple) == 3 && pair[1] == 20 && triple[2] == 50;
}
int main() {
	var slots = 3;
	var numbers = new Numbers(slots);
	var values = new int[slots];
	var larger = new int[slots + 1];
	values[2] = 42;
	if (len(values) != 3 || values[2] != 42 || len(numbers.values) != 3 || len(larger) != 4 || !fixed_spelling()) { return 81; }
	return 0;
}
