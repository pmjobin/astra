extern(C) int life_record(int code, int value);

class Counter {
	int value;

	init(int value) { this.value = value; life_record(67, 0); }

	deinit() { if (this.value != 42) life_record(88, 0); life_record(68, 0); }

	void add(int n) { this.value = this.value + n; }

	owned Counter copy() { return Counter.init(this.value); }
}

owned Counter make(bool enabled) {
	if (enabled) return Counter.init(42);
	return null;
}

void consume(owned Counter c) { if (c == null) life_record(78, 0); }

bool absent(borrowed Counter c) { return c == null; }

int main() {
	owned Counter empty = make(false);
	if (empty != null || !absent(empty)) return 1;
	consume(move empty);
	owned Counter c = make(true);
	return c.value;
}
