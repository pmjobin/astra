extern(C) int life_record(int code, int value);

class Counter {
	int value;

	init(int value) { this.value = value; life_record(67, 0); }

	deinit() { if (this.value != 42) life_record(88, 0); life_record(68, 0); }

	void add(int n) { this.value = this.value + n; }

	owned Counter copy() { return Counter.init(this.value); }
}

owned Counter make() { return Counter.init(42 / life_record(65, 0)); }

int main() { owned Counter c = make(); return c.value; }
