// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
struct Pair { int x; int y; }

void mutate(Pair* p) { p->x = 7; }

int scoped() {
	Pair pair = { x = 1, y = 2 };
	Pair* p = &pair;
	owned void* h = create_resource(1);
	Pair* q = p;
	mutate(q);
	if (h != null && p->x == 7) return pair.x;
	return 0;
}

int main() {
	resource_reset();
	if (scoped() != 7) return 1;
	if (resource_live_count() != 0) return 2;
	if (resource_destroy_count() != 1) return 3;
	if (resource_destroy_order() != 1) return 4;
	if (resource_error_count() != 0) return 5;

	return 0;
}
