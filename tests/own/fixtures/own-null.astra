int scoped() {
	owned void* h = (create_resource(0));
	if (h != null || null != h) { return 1; }
	if (h == null && null == h) { return 0; }
	return 2;
}
int main() {
	resource_reset();
	if (scoped() != 0) { return 1; }
	if (resource_live_count() != 0) { return 2; }
	if (resource_destroy_count() != 0) { return 3; }
	if (resource_destroy_order() != 0) { return 4; }
	if (resource_error_count() != 0) { return 5; }
	if (resource_create_count() != 1) { return 6; }
	return 0;
}
