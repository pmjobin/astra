int scoped() {
	owned void* a = create_resource(1);
	if (a != null) {
		owned void* b = create_resource(2);
		owned void* c = create_resource(3);
	}
	if (resource_destroy_order() != 32 || resource_live_count() != 1) { return 1; }
	return 0;
}
int main() {
	resource_reset();
	if (scoped() != 0) { return 1; }
	if (resource_live_count() != 0) { return 2; }
	if (resource_destroy_count() != 3) { return 3; }
	if (resource_destroy_order() != 321) { return 4; }
	if (resource_error_count() != 0) { return 5; }

	return 0;
}
