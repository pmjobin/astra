int scoped() {
	owned void* outer = create_resource(4);
	int n = 0;
	while (n < 3) {
		owned void* h = create_resource(n + 1);
		n = n + 1;
		if (n < 3) { continue; }
	}
	if (resource_live_count() != 1) { return 1; }
	return 0;
}
int main() {
	resource_reset();
	if (scoped() != 0) { return 1; }
	if (resource_live_count() != 0) { return 2; }
	if (resource_destroy_count() != 4) { return 3; }
	if (resource_destroy_order() != 1234) { return 4; }
	if (resource_error_count() != 0) { return 5; }

	return 0;
}
