int scoped() {
	owned void* outer = create_resource(1);
	while (true) {
		owned void* body = create_resource(2);
		if (body != null) {
			owned void* inner = create_resource(3);
			return 0;
		}
	}
	return 1;
}
int main() {
	resource_reset();
	if (scoped() != 0) { return 1; }
	if (resource_live_count() != 0) { return 2; }
	if (resource_destroy_count() != 3) { return 3; }
	if (resource_destroy_order() != 321) { return 4; }
	if (resource_error_count() != 0) { return 5; }

	return 0;
}
