language astra27b;
namespace Readings;
struct Summary {
	int count;
	int total;
}

Summary summarize(borrowed int[] values) {
	int count = 0;
	int total = 0;
	int at = 0;
	while (at < len(values)) {
		if (values[at] != 6) {
			count += 1;
			total += values[at];
		}
		at += 1;
	}
	return Summary {count, total};
}
