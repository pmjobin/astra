language astra27b;
T add<T>(T first, T last) where T: Numeric {
	return first + last;
}

int main() {
	int total = 0;
	int reading = 2;
	while (reading <= 10) {
		total = add<int>(total, reading);
		reading += 2;
	}
	u8 left = 2;
	u8 right = 4;
	u8 expected = 6;
	if (add<u8>(last: right, first: left) != expected || total != 30) return 1;
	return 0;
}
