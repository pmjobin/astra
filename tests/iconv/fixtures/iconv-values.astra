i16 sw(i8 x) { return x as i16; }
u16 uw(u8 x) { return x as u16; }
i8 sn(i16 x) { return x as i8; }
u8 same(i8 x) { return x as u8; }
i16<8> vsw(i8<8> v) { return v as i16<8>; }
u16<8> vuw(u8<8> v) { return v as u16<8>; }
i8<8> vsn(i16<8> v) { return v as i8<8>; }
u8<16> vsame(i8<16> v) { return v as u8<16>; }
u16 mixed(i8 x) { return x as u16; }
i16 umixed(u8 x) { return x as i16; }
u32 chain(i8 x) { return x as i16 as u32; }
int main() { return 0; }
