u16 signed_widen(i8 x) { return x as u16; }
i16 unsigned_widen(u8 x) { return x as i16; }
i8 narrow(u16 x) { return x as i8; }
u32 unsigned_bits(int x) { return x as u32; }
int signed_bits(u32 x) { return x as int; }
i16 consume(i16 x) { return x; }
int main() {
	if (signed_widen(-1) != 65535 || unsigned_widen(255) != 255 || narrow(65535) != -1) { return 1; }
	if (unsigned_bits(-1) != 4294967295 || signed_bits(4294967295) != -1) { return 2; }
	if (256 as u8 != 0 || 257 as u8 != 1 || -1 as u8 != 255) { return 3; }
	i16 n = -129;
	if (n as i8 != 127 || 300 as u8 != 44) { return 4; }
	i8 a = -128;
	u8 b = 255;
	i16 c = -32768;
	u16 d = 65535;
	int e = -2147483648;
	u32 f = 4294967295;
	if (a as i8 != a || b as u8 != b || c as i16 != c || d as u16 != d || e as int != e || f as u32 != f) { return 5; }
	if (e as i32 != e || e as i32 as int != e) { return 6; }
	if (a as u8 as i8 != a || c as u16 as i16 != c || e as u32 as int != e) { return 7; }
	if (consume(a as i16) != -128 || (a as i16) + 1 != -127) { return 8; }
	// Each chain step matters: signed -128 -> unsigned 128 -> signed 128.
	if (a as u8 as i16 != 128 || a as i16 != -128) { return 9; }
	if (b as i16 * 2 != 510 || 2 * b as i16 != 510 || b as i16 / 3 != 85 || b as i16 % 2 != 1) { return 10; }
	if (!(b as i16 < 256) || !(b as i16 > 254) || b as i16 + 1 != 256 || 1 + b as i16 != 256) { return 11; }
	return 0;
}
