i8 scalar_i8(i8 a,i8 b,int c){return ((~a&b)|(a^b))>>c;}
i8<16> vector_i8(i8<16> a,i8<16> b,u32 c){return ((~a&b)|(a^b))>>c;}
i8<16> left_i8(i8<16> a,i8 c){return a<<c;}
u8 scalar_u8(u8 a,u8 b,int c){return ((~a&b)|(a^b))>>c;}
u8<16> vector_u8(u8<16> a,u8<16> b,u32 c){return ((~a&b)|(a^b))>>c;}
u8<16> left_u8(u8<16> a,i8 c){return a<<c;}
i16 scalar_i16(i16 a,i16 b,int c){return ((~a&b)|(a^b))>>c;}
i16<8> vector_i16(i16<8> a,i16<8> b,u32 c){return ((~a&b)|(a^b))>>c;}
i16<8> left_i16(i16<8> a,i8 c){return a<<c;}
u16 scalar_u16(u16 a,u16 b,int c){return ((~a&b)|(a^b))>>c;}
u16<8> vector_u16(u16<8> a,u16<8> b,u32 c){return ((~a&b)|(a^b))>>c;}
u16<8> left_u16(u16<8> a,i8 c){return a<<c;}
i32 scalar_i32(i32 a,i32 b,int c){return ((~a&b)|(a^b))>>c;}
i32<4> vector_i32(i32<4> a,i32<4> b,u32 c){return ((~a&b)|(a^b))>>c;}
i32<4> left_i32(i32<4> a,i8 c){return a<<c;}
u32 scalar_u32(u32 a,u32 b,int c){return ((~a&b)|(a^b))>>c;}
u32<4> vector_u32(u32<4> a,u32<4> b,u32 c){return ((~a&b)|(a^b))>>c;}
u32<4> left_u32(u32<4> a,i8 c){return a<<c;}
bool eager(bool a,bool b){return (a&b)|(a^b);}
bool<8> mask(bool<8> a,bool<8> b){return (a&b)|(a^b);}
int main(){return 0;}
