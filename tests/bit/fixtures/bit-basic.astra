u8 bits(u8 a,u8 b){return (a&b)|(a^b);}

int main(){
	u8 a=170;
	u8 b=85;
	u8 c=1|2;
	if((a&b)!=0 || (a|b)!=255 || (a^b)!=255 || ~a!=85 || c!=3) return 1;
	if(bits(a,b)!=255 || (15&a)!=10 || (a&15)!=10) return 2;
	u8 z=0;
	u8 ones=255;
	if(~z!=255 || ~ones!=0) return 3;
	if((1+2<<2)!=12 || (32>>1+1)!=8 || (1|2^3&1)!=3) return 4;
	return 0;
}
