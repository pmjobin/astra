(unit
	(function
		(type "i8")
		(name "scalar_i8")
		(parameters
			(parameter (type "i8") (name "a"))
			(parameter (type "i8") (name "b"))
			(parameter (type "int") (name "c"))
		)
		(block
			(return (binary ">>" (parenthesized (binary "|" (parenthesized (binary "&" (prefix "~" (name "a")) (name "b"))) (parenthesized (binary "^" (name "a") (name "b"))))) (name "c")))
		)
	)
