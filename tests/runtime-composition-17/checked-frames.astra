extern(C) void checked_frame_header_failure();
extern(C) void checked_frame_event(int kind, int identity);
extern(C) int checked_frame_finish();
[Allocator(kind="context",context="owned-concurrent")]
class CheckedFrameCargo {
	private int identity;
	init(int identity) { this.identity = identity; }
	int id() { return this.identity; }
	deinit() { checked_frame_event(2, this.identity); }
}
async void checked_frame_empty() {}
async void checked_frame_consume(owned CheckedFrameCargo cargo, owned ConcurrentAllocator token) throws Error {
	if (cargo == null || token == null || concurrent_allocator_query(token, 1) != 0) { throw new Error("lost admitted capture"); }
	checked_frame_event(1, cargo.id());
	if (cargo.id() == 3) { throw new Error("original task body failure"); }
}
async void checked_frame_parent(owned ConcurrentAllocator frames, owned CheckedFrameCargo cargo, owned ConcurrentAllocator token) throws Error {
	{
		var blocker = task_in(frames, checked_frame_empty());
		bool caught = false;
		try { var refused = checked_task_in(frames, checked_frame_consume(move cargo, move token)); }
		catch (Error error) { caught = true; }
		if (!caught || cargo == null || token == null) { throw new Error("async refusal lost original inputs"); }
	}
	await delay_ticks(1);
	var child = checked_task_in(frames, checked_frame_consume(move cargo, move token));
	if (cargo != null || token != null) { await cancel_and_join(move child); throw new Error("async admission did not empty slots"); }
	await move child;
}
export(C) int run_checked_frames() {
	var frames = concurrent_allocator(2, 8192, 1, 64);
	var objects = concurrent_allocator(1, 8192, 7, 64);
	if (frames == null || objects == null) { return 1; }
	var cargo = new(objects) CheckedFrameCargo(1);
	var token = concurrent_allocator(1, 1024, 3, 64);
	{
		var blocker = task_in(frames, checked_frame_empty());
		bool caught = false;
		try { var refused = checked_task_in(frames, checked_frame_consume(move cargo, move token)); }
		catch (Error error) { caught = true; }
		if (!caught || cargo == null || cargo.id() != 1 || token == null || concurrent_allocator_query(frames, 1) != 1) { return 2; }
	}
	if (concurrent_allocator_query(frames, 1) != 0) { return 3; }
	checked_frame_header_failure();
	bool caught = false;
	try { var refused = checked_task_in(frames, checked_frame_consume(move cargo, move token)); }
	catch (Error error) { caught = true; }
	if (!caught || cargo == null || cargo.id() != 1 || token == null || concurrent_allocator_query(frames, 1) != 0) { return 4; }
	try {
		var executor = ThreadedExecutor.open(2);
		var admitted = checked_task_in(frames, checked_frame_consume(move cargo, move token));
		if (cargo != null || token != null || concurrent_allocator_query(frames, 1) != 1) { return 5; }
		var status = executor.run(move admitted);
		match (status) { case ThreadedStatus.Completed(): {} else: { return 6; } }
	} catch (Error error) { return 7; }
	{
		var dropped = new(objects) CheckedFrameCargo(2);
		var resource = concurrent_allocator(1, 1024, 3, 64);
		try { var cold = checked_task_in(frames, checked_frame_consume(move dropped, move resource)); }
		catch (Error error) { return 8; }
		if (dropped != null || resource != null) { return 9; }
	}
	{
		var failing = new(objects) CheckedFrameCargo(3);
		var resource = concurrent_allocator(1, 1024, 3, 64);
		bool failed = false;
		try {
			var executor = ThreadedExecutor.open(2);
			var task = checked_task_in(frames, checked_frame_consume(move failing, move resource));
			var status = executor.run(move task);
		} catch (Error error) { failed = true; }
		if (!failed || failing != null || resource != null) { return 10; }
	}
	{
		var nested = new(objects) CheckedFrameCargo(4);
		var resource = concurrent_allocator(1, 1024, 3, 64);
		var selected = concurrent_allocator(2, 8192, 1, 64);
		try {
			var executor = ThreadedExecutor.open(2);
			var status = executor.run(checked_frame_parent(move selected, move nested, move resource));
			match (status) { case ThreadedStatus.Completed(): {} else: { return 12; } }
		} catch (Error error) { return 13; }
	}
	if (concurrent_allocator_query(frames, 1) != 0 || concurrent_allocator_query(objects, 1) != 0) { return 11; }
	return checked_frame_finish();
}
