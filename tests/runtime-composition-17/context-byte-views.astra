[CCode(buffer_abi="u8-i32")]
extern(C) int context_byte_view_observe(borrowed u8[] bytes);
extern(C) int context_byte_views_finish();
void close_view_anchor(owned ConcurrentAllocator context) {}
int mutate_byte_view(u8[] bytes) {
	if (len(bytes) != 37 || bytes[0] != 0) { return 1; }
	bytes[0] = 17;
	bytes[36] = 29;
	return 0;
}
export(C) int context_byte_views_run() {
	var context = custom_allocator(16387, 11);
	var bytes = new(context)u8[37];
	close_view_anchor(move context);
	if (mutate_byte_view(bytes) != 0) { return 2; }
	if (context_byte_view_observe(bytes) != 46) { return 3; }
	if (bytes[0] != 19 || bytes[36] != 31) { return 4; }
	release bytes;
	return context_byte_views_finish();
}
