extern(C) void scoped_class_retired(int identity);

[Allocator(kind="context",context="scoped-affine")]
class ScopedItem {
	private int identity;
	private int value;

	init(int identity, int value) { this.identity = identity; this.value = value; }

	int code() { return this.value; }

	deinit() { scoped_class_retired(this.identity); }
}

[Allocator(kind="context",context="scoped-affine")]
class ScopedGeneric<T> {
	private int identity;
	private T value;

	init(int identity, T value) { this.identity = identity; this.value = value; }

	T code() { return this.value; }

	deinit() { scoped_class_retired(this.identity); }
}

struct ScopedPair { owned ScopedItem first; owned ScopedItem second; int marker; }

struct ScopedPacket<T> where T:Ownable { owned T payload; int marker; }

int observe(borrowed ScopedItem item) { return item.code(); }

int observe_pair(borrowed ScopedPair input) { return input.first.code() + input.second.code() + input.marker; }

int observe_packet(borrowed ScopedPacket<ScopedItem> input) { return input.payload.code() + input.marker; }

ScopedPair pair(owned ScopedItem first, owned ScopedItem second) {
	ScopedPair result = { first = move first, second = move second, marker = 7 };
	return move result;
}

ScopedPacket<ScopedItem> packet(owned ScopedItem input) {
	ScopedPacket<ScopedItem> result = { payload = move input, marker = 11 };
	return move result;
}

owned ScopedItem create_item(borrowed ScopedAllocator context, int identity, int value) {
	var item = new (context) ScopedItem(identity, value);
	return move item;
}

owned ScopedItem relay_item(borrowed ScopedAllocator context, int identity, int value) {
	var item = create_item(context, identity, value);
	return move item;
}

owned ScopedItem try_item(borrowed ScopedAllocator context, int identity, int value) {
	var item = try_new (context) ScopedItem(identity, value);
	return move item;
}

owned ScopedGeneric<int> try_generic_int(borrowed ScopedAllocator context, int identity, int value) {
	var item = try_new (context) ScopedGeneric<int>(identity, value);
	return move item;
}

owned ScopedGeneric<i64> create_generic_wide(borrowed ScopedAllocator context, int identity, i64 value) {
	var item = new (context) ScopedGeneric<i64>(identity, value);
	return move item;
}

export(C) int scoped_classes_run() {
	owned u8[] first_backing = new u8[8197];
	owned u8[] second_backing = new u8[12289];
	{
		var first = scoped_allocator<ScopedAllocator>(first_backing, 2, 1);
		var second = scoped_allocator<ScopedAllocator>(second_backing, 1, 7);
		if (first == null || second == null) return 1;
		if (scoped_allocator_query(first, 0) == scoped_allocator_query(second, 0)) return 2;
		{
			var left = relay_item(first, 1, 17);
			var right = create_item(second, 2, 23);
			var refused = try_item(first, 99, 99);
			if (refused != null) return 3;
			if (scoped_allocator_query(first, 1) != 1 || scoped_allocator_query(second, 1) != 1) return 4;
			if (observe(left) + observe(right) != 40) return 5;
			var joined = pair(move left, move right);
			if (observe_pair(joined) != 47) return 6;
		}
		if (scoped_allocator_query(first, 1) != 0 || scoped_allocator_query(second, 1) != 0) return 7;
		{
			var reused = try_item(first, 3, 31);
			if (reused == null) return 8;
			var other = create_item(second, 4, 37);
			var packed = packet(move reused);
			if (observe_packet(packed) + observe(other) != 79) return 9;
		}
		if (scoped_allocator_query(first, 1) != 0 || scoped_allocator_query(second, 1) != 0) return 10;
		{
			var generic_first = try_generic_int(first, 5, 43);
			if (generic_first == null) return 14;
			var generic_second = create_generic_wide(second, 6, 47);
			if (generic_first.code() != 43 || generic_second.code() != 47) return 15;
		}
		if (scoped_allocator_query(first, 1) != 0 || scoped_allocator_query(second, 1) != 0) return 16;
		if (scoped_allocator_query(first, 4) != 3 || scoped_allocator_query(first, 5) != 3) return 11;
		if (scoped_allocator_query(second, 4) != 3 || scoped_allocator_query(second, 5) != 3) return 12;
	}
	if (len(first_backing) != 8197 || len(second_backing) != 12289) return 13;
	return 0;
}
