extern(C) int admission_event(int kind, int id);

extern(C) int admission_finish();

[ExceptionRoot] class AdmissionFault {
	readonly string text;

	init(string text) { this.text = text; }

	virtual property string message { get { return this.text; } }
}

class AdmissionChild {
	private int id;

	init(int id) { this.id = id; }

	int identity() { return this.id; }

	deinit() { admission_event(2, this.id); }
}

[Allocator(kind="context",context="owned-concurrent")]
class AdmissionOwner {
	private owned AdmissionChild child;
	private owned AdmissionToken token;

	init(owned AdmissionChild child, owned AdmissionToken token, int id, int failure) throws AdmissionFault {
		admission_event(1, id);
		if (failure == 1) {
			throw new AdmissionFault("before fields");
		}
		this.child = move child;
		if (failure == 2) {
			throw new AdmissionFault("one field");
		}
		this.token = move token;
		if (failure == 3) {
			throw new AdmissionFault("both fields");
		}
	}

	int identity() { return this.child.identity(); }

	deinit() { admission_event(3, this.child.identity()); }
}

[Allocator(kind="context",context="owned-concurrent")]
class AdmissionOnly<T> {
	private owned T item;

	init(owned T item) { this.item = move item; }
}

owned AdmissionChild retained_input(borrowed ConcurrentAllocator context, owned AdmissionChild input) {
	var owner = try_new(context) AdmissionOnly<AdmissionChild>(move input);
	if (owner == null) return move input;
	return null;
}

int main() {
	var context = concurrent_allocator(2, 512, 1, 64);
	if (context == null) return 1;
	var child = new AdmissionChild(1); var token = admission_token(1);
	try {
		var first = try_new(context) AdmissionOwner(move child, move token, 1, 0);
		if (first == null || child != null || token != null || first.identity() != 1) return 2;
		var extra = new AdmissionChild(6); var retained = retained_input(context, move extra);
		if (retained == null || retained.identity() != 6) return 9;
		release retained;
		var pending = new AdmissionChild(2); var pending_token = admission_token(2);
		var refused = try_new(context) AdmissionOwner(move pending, move pending_token, 2, 3);
		if (refused != null || pending == null || pending.identity() != 2 || admission_token_identity(pending_token) != 2) return 3;
		release first;
		var recovered = try_new(context) AdmissionOwner(move pending, move pending_token, 2, 0);
		if (recovered == null || pending != null || pending_token != null || recovered.identity() != 2) return 4;
		release recovered;
	} catch(AdmissionFault error) { return 5; }
	for (int mode = 1; mode < 4; mode = mode + 1) {
		var input = new AdmissionChild(mode + 2); var resource = admission_token(mode + 2);
		bool caught = false;
		try { var failed = try_new(context) AdmissionOwner(move input, move resource, mode + 2, mode); return 6; }
		catch(AdmissionFault error) { caught = true; }
		if (!caught || input != null || resource != null || concurrent_allocator_query(context, 1) != 0) return 7;
	}
	if (concurrent_allocator_query(context, 1) != 0) return 8;
	return admission_finish();
}
