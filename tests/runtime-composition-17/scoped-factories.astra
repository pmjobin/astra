extern(C) void scoped_graph_constructed(int identity);

extern(C) void scoped_class_retired(int identity);

[Allocator(kind="context",context="scoped-affine")]
class ScopedLeaf {
	private int identity;
	private int value;

	init(int identity,int value){this.identity=identity;this.value=value;scoped_graph_constructed(identity);}

	int read(){return this.value;}

	deinit(){scoped_class_retired(this.identity);}
}

int inspect(borrowed ScopedLeaf input){return input.read();}

[Allocator(kind="context",context="scoped-affine")]
class ScopedHost {
	private int identity;
	private owned ScopedLeaf left;
	private owned ScopedLeaf right;

	init(int identity,owned ScopedLeaf left,owned ScopedLeaf right){this.identity=identity;this.left=move left;this.right=move right;scoped_graph_constructed(identity);}

	int read(){return inspect(this.left)+this.right.read();}

	deinit(){scoped_class_retired(this.identity);}
}

[Allocator(kind="context",context="scoped-affine")]
class ScopedBox<T> where T:Ownable {
	private int identity;
	private owned T left;
	private owned T right;

	init(int identity,owned T left,owned T right){this.identity=identity;this.left=move left;this.right=move right;scoped_graph_constructed(identity);}

	int marker(){return this.identity;}

	deinit(){scoped_class_retired(this.identity);}
}

owned ScopedHost relay_host(owned ScopedHost input){return move input;}

owned ScopedBox<ScopedLeaf> relay_box(owned ScopedBox<ScopedLeaf> input){return move input;}

int consume_host(owned ScopedHost input){return input.read();}

int consume_box(owned ScopedBox<ScopedLeaf> input){return input.marker();}

int discard_host(owned ScopedHost input){return 0;}

owned ScopedHost make_host(borrowed ScopedAllocator children,borrowed ScopedAllocator parent){var left=new(children)ScopedLeaf(1,17);var right=new(children)ScopedLeaf(2,23);var host=new(parent)ScopedHost(3,move left,move right);return move host;}

owned ScopedBox<ScopedLeaf> make_box(borrowed ScopedAllocator children,borrowed ScopedAllocator parent){var left=new(children)ScopedLeaf(7,37);var right=new(children)ScopedLeaf(8,41);var host=try_new(parent)ScopedBox<ScopedLeaf>(9,move left,move right);return move host;}

owned ScopedBox<ScopedLeaf> make_refused(borrowed ScopedAllocator children,borrowed ScopedAllocator parent){var left=new(children)ScopedLeaf(4,19);var right=new(children)ScopedLeaf(5,29);var host=try_new(parent)ScopedBox<ScopedLeaf>(99,move left,move right);return move host;}

export(C) int scoped_graphs_run(){
	owned u8[] first_backing=new u8[8197];
	owned u8[] second_backing=new u8[12289];
	{
		var first=scoped_allocator<ScopedAllocator>(first_backing,1,7);
		var second=scoped_allocator<ScopedAllocator>(second_backing,2,1);
		if(first==null||second==null) return 1;
		{
			var original=make_host(first,second);
			var host=relay_host(move original);
			if(host.read()!=40) return 2;
			var refused_factory=make_refused(first,second);
			if(refused_factory!=null||scoped_allocator_query(first,1)!=2) return 14;
			var retained=new(first)ScopedLeaf(6,31);
			var refused=try_new(second)ScopedHost(99,move retained,null);
			int discarded=discard_host(move refused);
			if(discarded!=0||retained.read()!=31) return 3;
			release retained;
			if(scoped_allocator_query(first,1)!=2||scoped_allocator_query(second,1)!=1) return 4;
			if(consume_host(move host)!=40) return 11;
			if(scoped_allocator_query(first,1)!=0||scoped_allocator_query(second,1)!=0) return 12;
		}
		if(scoped_allocator_query(first,1)!=0||scoped_allocator_query(second,1)!=0) return 5;
		{
			var reused=make_box(first,second);
			if(reused==null) return 6;
			var delivered=relay_box(move reused);
			if(delivered.marker()!=9) return 10;
			if(consume_box(move delivered)!=9) return 13;
		}
		if(scoped_allocator_query(first,4)!=7||scoped_allocator_query(first,5)!=7) return 7;
		if(scoped_allocator_query(second,4)!=2||scoped_allocator_query(second,5)!=2) return 8;
	}
	if(len(first_backing)!=8197||len(second_backing)!=12289) return 9;
	return 0;
}
