namespace OpaqueScope;
extern(C) void host_error_begin(int mode);

extern(C) void host_error_retired(int identity);

extern(C) void host_error_outcome(int mode, int value);

extern(C) void host_error_delay_arm();

extern(C) int host_error_finish();

[Allocator(kind="context",context="scoped-affine")]
class HostErrorLeaf {
	private int identity;

	init(int identity) { this.identity = identity; }

	int read() { return this.identity; }

	deinit() { host_error_retired(this.identity); }
}

[ExceptionRoot]
class HostErrorFault {
	private owned HostErrorLeaf child;

	init(owned HostErrorLeaf child) { this.child = move child; }

	int read() { if (this.child == null) return -1; return this.child.read(); }

	virtual property string message { get { return "host error"; } }
}

class HostRuntimeFault : HostErrorFault { init(string message) : base(null) {} }

enum HostErrorPhase { Completed, Cancelled }

async runtime HostErrorTasks throws HostRuntimeFault returns HostErrorPhase;
async void host_error_fail(owned HostErrorLeaf input, int mode) throws HostErrorFault {
	if (mode == 5) return;
	if (mode == 3) host_error_delay_arm();
	if (mode == 1 || mode == 3) {
		await delay_ticks(1);
	}
	throw new HostErrorFault(move input);
}
