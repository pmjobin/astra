[CCode(text_abi="utf8-i32")]
extern(C) int braid_prepare(borrowed string path);
[CCode(text_abi="utf8-i32")]
extern(C) void braid_error(borrowed string message);
extern(C) int braid_finish(int result);

[Allocator(kind="context",context="scoped-affine")]
class LocalInterval {
	private int offset;
	private int count;
	init(int offset, int count) { this.offset = offset; this.count = count; }
	bool valid(int extent) { return this.offset >= 0 && this.count > 0 && this.count <= 3071 && this.count <= extent && this.offset <= extent - this.count; }
}
bool braid_valid_triple(BraidModel.Triple pair, int extent) {
	owned u8[] backing = new u8[8191];
	var context = scoped_allocator<ScopedAllocator>(backing, 1, 7);
	if (context == null) { return false; }
	var first = new(context) LocalInterval(pair.first.offset, pair.first.count);
	var second = new(context) LocalInterval(pair.second.offset, pair.second.count);
	var third = new(context) LocalInterval(pair.third.offset, pair.third.count);
	return first.valid(extent) && second.valid(extent) && third.valid(extent);
}
int braid_integer(u8[] bytes, int offset) throws BraidModel.Fault {
	if (bytes[offset + 3] != 0) { throw new Error("query integer exceeds protocol bound"); }
	return (bytes[offset] as int) + (bytes[offset + 1] as int) * 256 + (bytes[offset + 2] as int) * 65536;
}
void braid_put_integer(u8[] bytes, int offset, int value) {
	int remaining = value;
	for (int i = 0; i < 4; i = i + 1) { bytes[offset + i] = (remaining % 256) as u8; remaining = remaining / 256; }
}
void braid_encode(u8[] bytes, BraidModel.Envelope<BraidModel.Alignment> envelope, int left_sample, int right_sample) {
	BraidModel.Reply<BraidModel.Alignment> reply = envelope.reply;
	braid_put_integer(bytes, 0, 84); braid_put_integer(bytes, 4, reply.identity); braid_put_integer(bytes, 8, 0);
	braid_put_integer(bytes, 12, reply.cached); braid_put_integer(bytes, 16, reply.payload.generation); braid_put_integer(bytes, 20, reply.payload.inner.ordinal);
	braid_put_integer(bytes, 24, reply.payload.inner.value.ranges.first.offset); braid_put_integer(bytes, 28, reply.payload.inner.value.ranges.first.count);
	braid_put_integer(bytes, 32, reply.payload.inner.value.ranges.second.offset); braid_put_integer(bytes, 36, reply.payload.inner.value.ranges.second.count);
	braid_put_integer(bytes, 40, reply.payload.inner.value.ranges.third.offset); braid_put_integer(bytes, 44, reply.payload.inner.value.ranges.third.count);
	braid_put_integer(bytes, 48, reply.payload.inner.value.costs.insertion); braid_put_integer(bytes, 52, reply.payload.inner.value.costs.deletion); braid_put_integer(bytes, 56, reply.payload.inner.value.costs.substitution);
	braid_put_integer(bytes, 60, reply.payload.inner.value.totals.count); braid_put_integer(bytes, 64, reply.payload.inner.value.totals.sum); braid_put_integer(bytes, 68, reply.payload.inner.value.totals.energy);
	braid_put_integer(bytes, 72, reply.payload.inner.value.scores.left); braid_put_integer(bytes, 76, reply.payload.inner.value.scores.right);
	braid_put_integer(bytes, 80, left_sample); braid_put_integer(bytes, 84, right_sample); braid_put_integer(bytes, 88, reply.payload.inner.value.ranges.first.count + 1); braid_put_integer(bytes, 92, envelope.witness);
}

void braid_failure(u8[] bytes, int identity, int status) {
	for (int i = 0; i < 96; i = i + 1) { bytes[i] = 0; }
	braid_put_integer(bytes, 0, 84); braid_put_integer(bytes, 4, identity); braid_put_integer(bytes, 8, status);
}
owned BraidModel.Entry braid_lookup(borrowed BraidModel.Cache cache, BraidModel.Triple ranges, BraidModel.Costs costs, int mode) {
	if (mode == 1) { cache.miss(); return null; }
	var result = BraidModel.lookup(cache, ranges, costs); return move result;
}
void braid_success(u8[] bytes, borrowed BraidModel.Entry entry, int identity, int cached) {
	BraidModel.Envelope<BraidModel.Alignment> reply = BraidModel.reply(entry, identity, cached); braid_encode(bytes, reply, entry.left_at(entry.first_count() / 3), entry.right_at((entry.first_count() * 2) / 3));
}

async void braid_client(owned TcpSocket socket, owned BraidModel.Queue reads, owned BraidModel.Cache cache, int client, int quota, int extent) throws BraidModel.Fault {
	try {
		var context = braid_allocator(quota as i64, 128, 10 + client);
		if (context == null) { throw new Error("query client allocator"); }
		var header = new(context)u8[44]; var response = new(context)u8[96];
		bool done = false; int queries = 0;
		while (!done) {
			int received = 0; int started = astra_net_milliseconds();
			while (received < 44) {
				if (cache.stopped()) { throw new Error("query client stopped"); }
				int count = socket.try_read(header, received, 44 - received);
				if (count > 0) { received = received + count; braid_event(12, client, count); }
				else { if (count == 0) { throw new Error("query client EOF"); } network_deadline(started, 15000); await delay_ms(1); }
			}
			int identity = braid_integer(header, 0);
			if (identity == 0) { done = true; }
			else {
				if (queries >= 64) { throw new Error("query request budget"); } queries = queries + 1;
				BraidModel.Triple ranges = {first = {offset = braid_integer(header, 4), count = braid_integer(header, 8)}, second = {offset = braid_integer(header, 12), count = braid_integer(header, 16)}, third = {offset = braid_integer(header, 20), count = braid_integer(header, 24)}};
				int mode = braid_integer(header, 28); int cached = 0;
				BraidModel.Costs costs = {insertion = braid_integer(header, 32), deletion = braid_integer(header, 36), substitution = braid_integer(header, 40)};
				if (mode > 1 || costs.insertion < 1 || costs.insertion > 7 || costs.deletion < 1 || costs.deletion > 7 || costs.substitution < 1 || costs.substitution > 7 || !braid_valid_triple(ranges, extent)) { cache.rejection(); braid_failure(response, identity, 1); }
				else {
					var entry = braid_lookup(cache, ranges, costs, mode);
					if (entry != null) { cached = 1; braid_success(response, entry, identity, cached); }
					else {
						var ticket = BraidSetup.ticket(context, identity, mode, ranges, costs);
						while (!reads.available()) { if (cache.stopped()) { throw new Error("query read queue stopped"); } network_deadline(started, 15000); await delay_ms(1); }
						var enqueued = BraidModel.clone_ticket(ticket); if (!reads.offer(move enqueued)) { throw new Error("query read queue admission"); }
						while (ticket.state() == 0) { if (cache.stopped()) { throw new Error("query analysis stopped"); } network_deadline(started, 15000); await delay_ms(1); }
						if (ticket.state() == 1) { var computed = ticket.outcome(); braid_success(response, computed, identity, 0); }
						else { braid_failure(response, identity, 2); }
					}
				}
				int sent = 0;
				while (sent < 96) {
					int count = socket.try_write(response, sent, 96 - sent);
					if (count > 0) { sent = sent + count; } else { network_deadline(started, 15000); await delay_ms(1); }
				}
				braid_event(13, identity, cached);
			}
		}
		socket.half_close(); cache.client_done();
	} catch (BraidModel.Fault error) { cache.fail(); throw; }
}

async void braid_read(owned LinuxPayload file, owned BraidModel.Queue reads, owned BraidModel.Queue ready, owned BraidModel.Cache cache) throws BraidModel.Fault {
	try {
		bool done = false;
		while (!done) {
			if (cache.stopped()) { throw new Error("query file stage stopped"); }
			var ticket = reads.pop();
			if (ticket == null) { if (cache.completed_clients() == 3) { done = true; } else { await delay_ms(1); } }
			else {
				var block = ticket.payload(); int destination = 0;
				for (int half = 0; half < 3; half = half + 1) {
					int offset = ticket.first_offset(); int length = ticket.first_count();
					if (half == 1) { offset = ticket.second_offset(); length = ticket.second_count(); }
					if (half == 2) { offset = ticket.third_offset(); length = ticket.third_count(); }
					int received = 0;
					while (received < length) {
						payload_configure(file, 0, length - received, (offset + received) as i64); await payload_io(file);
						int count = astra_linux_payload_count(file); if (count <= 0 || count > length - received) { throw new Error("query file range progress"); }
						for (int i = 0; i < count; i = i + 1) { block.set_byte(destination + received + i, payload_byte(file, i)); }
						received = received + count;
					}
					destination = destination + length;
				}
				braid_event(4, ticket.id(), destination);
				while (!ready.available()) { if (cache.stopped()) { throw new Error("query CPU queue stopped"); } await delay_ms(1); }
				if (!ready.offer(move ticket)) { throw new Error("query CPU queue admission"); }
			}
		}
		payload_finish(file);
	} catch (BraidModel.Fault error) { cache.fail(); throw; }
}
async void braid_compute(owned WorkerPool pool, owned BraidModel.Queue ready, owned BraidModel.Cache cache, int quota) throws BraidModel.Fault {
	try {
		int completed = 0;
		{
			var frames = braid_allocator((quota * 2) as i64, 32, 40); var children = braid_allocator((quota * 2) as i64, 32, 41);
			if (frames == null || children == null) { throw new Error("query frame allocator"); }
			completed = await pool.submit(task_in(frames, BraidCPU.pipeline(move children, BraidModel.clone_queue(ready), BraidModel.clone_cache(cache), quota)));
		}
		braid_event(10, completed, 0); braid_event(11, braid_provider_disposed(61), braid_provider_disposed(62));
	} catch (BraidModel.Fault error) { cache.fail(); throw; }
}
async void braid_status(owned UdpSocket socket, owned BraidModel.Cache cache) throws BraidModel.Fault {
	var bytes = new u8[24];
	while (true) {
		try {
			NetworkDatagram packet = socket.receive_from(bytes, 0, 1);
			if (packet.count == 1 && packet.message_length == 1 && bytes[0] == 81) {
				braid_put_integer(bytes, 0, 84); braid_put_integer(bytes, 4, cache.hit_count()); braid_put_integer(bytes, 8, cache.miss_count());
				braid_put_integer(bytes, 12, cache.count()); braid_put_integer(bytes, 16, cache.rejections()); braid_put_integer(bytes, 20, cache.completed_clients());
				int count = socket.send_to(packet.peer, bytes, 0, 24); if (count != 24 && count != NetAgain && count != NetInterrupted) { throw new Error("query status send"); }
			}
		} catch (SocketError error) { if (error.code != NetAgain && error.code != NetInterrupted) { throw; } }
		await delay_ms(1);
	}
}

async void braid_pipeline(owned TcpSocket first_socket, owned TcpSocket second_socket, owned TcpSocket third_socket, owned UdpSocket datagrams, owned LinuxPayload file, owned WorkerPool pool, owned BraidModel.Queue reads, owned BraidModel.Queue ready, owned BraidModel.Cache cache, int quota, int extent) throws BraidModel.Fault {
	var first = braid_client(move first_socket, BraidModel.clone_queue(reads), BraidModel.clone_cache(cache), 1, quota, extent);
	var second = braid_client(move second_socket, BraidModel.clone_queue(reads), BraidModel.clone_cache(cache), 2, quota, extent);
	var third = braid_client(move third_socket, BraidModel.clone_queue(reads), BraidModel.clone_cache(cache), 3, quota, extent);
	var reader = braid_read(move file, BraidModel.clone_queue(reads), BraidModel.clone_queue(ready), BraidModel.clone_cache(cache));
	var workers = braid_compute(move pool, BraidModel.clone_queue(ready), BraidModel.clone_cache(cache), quota);
	var status = braid_status(move datagrams, BraidModel.clone_cache(cache));
	try {
		start(first); start(second); start(third); start(reader); start(workers); start(status);
		while (cache.completed_clients() != 3 && !cache.stopped() && braid_stop_requested() == 0) { await delay_ms(1); }
	} catch (BraidModel.Fault error) {
		cancel(first); cancel(second); cancel(third); cancel(reader); cancel(workers); cancel(status);
		await cancel_and_join(move first); await cancel_and_join(move second); await cancel_and_join(move third); await cancel_and_join(move reader); await cancel_and_join(move workers); await cancel_and_join(move status); throw;
	}
	if (cache.stopped() || braid_stop_requested() != 0) {
		cancel(first); cancel(second); cancel(third); cancel(reader); cancel(workers); cancel(status);
		await cancel_and_join(move first); await cancel_and_join(move second); await cancel_and_join(move third); await cancel_and_join(move reader); await cancel_and_join(move workers); await cancel_and_join(move status);
		if (braid_stop_requested() == 0) { throw new Error("query pipeline failed"); }
	} else {
		await cancel_and_join(move status);
		try { await move first; } catch (BraidModel.Fault error) { cancel(second); cancel(third); cancel(reader); cancel(workers); await cancel_and_join(move second); await cancel_and_join(move third); await cancel_and_join(move reader); await cancel_and_join(move workers); throw; }
		try { await move second; } catch (BraidModel.Fault error) { cancel(third); cancel(reader); cancel(workers); await cancel_and_join(move third); await cancel_and_join(move reader); await cancel_and_join(move workers); throw; }
		try { await move third; } catch (BraidModel.Fault error) { cancel(reader); cancel(workers); await cancel_and_join(move reader); await cancel_and_join(move workers); throw; }
		try { await move reader; } catch (BraidModel.Fault error) { await cancel_and_join(move workers); throw; }
		await move workers;
	}
}
int braid_service(string address, int family, string input) throws BraidModel.Fault {
	NetworkEndpoint endpoint = network_endpoint(address, family, 0, 0);
	var listener = new TcpSocket(); listener.open_family(family); listener.listen_at(endpoint, 8);
	var datagrams = new UdpSocket(); datagrams.open_at(endpoint);
	NetworkEndpoint tcp = listener.local_address(); NetworkEndpoint udp = datagrams.local_address(); braid_ready(tcp.port, udp.port);
	var first = new TcpSocket(); var second = new TcpSocket(); var third = new TcpSocket(); NetworkEndpoint peer = endpoint;
	int started = astra_net_milliseconds();
	while (!listener.accept_from(first, &peer)) { if (braid_stop_requested() != 0) { return 130; } network_deadline(started, 15000); }
	while (!listener.accept_from(second, &peer)) { if (braid_stop_requested() != 0) { return 130; } network_deadline(started, 15000); }
	while (!listener.accept_from(third, &peer)) { if (braid_stop_requested() != 0) { return 130; } network_deadline(started, 15000); }
	var context = concurrent_allocator(1, 262147, 31, 128);
	if (context == null) { throw new Error("query control context"); }
	var reads = BraidSetup.queue(context, braid_queue_capacity()); var ready = BraidSetup.queue(context, braid_queue_capacity()); var cache = BraidSetup.cache(context, braid_cache_capacity());
	if (!reads.ready() || !ready.ready() || !cache.ready()) { throw new Error("query queue/cache admission"); }
	var file = payload_open(input, 3071, 0); var pool = worker_pool(braid_worker_count()); if (pool == null) { throw new Error("query worker pool"); }
	var executor = BraidIo.open(16); var result = executor.run(braid_pipeline(move first, move second, move third, move datagrams, move file, move pool, move reads, move ready, move cache, braid_quota(), braid_file_extent()));
	match (result) { case BraidPhase.Completed(): {} else: { return 2; } }
	if (braid_stop_requested() != 0) { return 130; } return 0;
}
int main(string[] args) {
	if (len(args) != 4 || args[2] != "4" && args[2] != "6") { return 64; }
	if (braid_prepare(args[3]) != 0) { return 64; }
	int family = 4; if (args[2] == "6") { family = 6; }
	int result = 0;
	try { result = braid_service(args[1], family, args[3]); }
	catch (BraidModel.Fault error) { braid_error(error.message); result = 1; }
	return braid_finish(result);
}
