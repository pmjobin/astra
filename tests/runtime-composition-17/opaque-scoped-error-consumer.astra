extern(C) void host_error_begin(int mode);

extern(C) void host_error_retired(int identity);

extern(C) void host_error_outcome(int mode, int value);

extern(C) void host_error_delay_arm();

extern(C) int host_error_finish();

enum HostErrorPhase { Completed, Cancelled }

async runtime HostErrorTasks throws OpaqueScope.HostRuntimeFault returns HostErrorPhase;
int host_error_forward(owned OpaqueScope.HostErrorLeaf input, int mode) throws OpaqueScope.HostErrorFault {
	var executor = HostErrorTasks.open(8);
	var task = OpaqueScope.host_error_fail(move input, mode);
	if (mode == 2) executor.cancel(task);
	if (mode == 4) executor.begin_shutdown();
	var status = executor.run(move task);
	if (mode == 2) {
		match (status) { case HostErrorPhase.Cancelled(): {} else: { return 2; } }
	}
	else {
		if (mode != 5) return 3;
		match (status) { case HostErrorPhase.Completed(): {} else: { return 4; } }
	}
	host_error_outcome(mode, 0);
	return 0;
}

int host_error_case(int mode) {
	owned u8[] backing = new u8[16381];
	var objects = scoped_allocator<ScopedAllocator>(backing, 1, 8);
	host_error_begin(mode);
	try {
		var input = new(objects) OpaqueScope.HostErrorLeaf(mode + 1);
		var executor = HostErrorTasks.open(8);
		var task = OpaqueScope.host_error_fail(move input, mode);
		if (mode == 2) executor.cancel(task);
		if (mode == 4) executor.begin_shutdown();
		try {
			var status = executor.run(move task);
			if (mode == 2) {
				match (status) { case HostErrorPhase.Cancelled(): {} else: { return 2; } }
			}
			else {
				if (mode != 5) return 3;
				match (status) { case HostErrorPhase.Completed(): {} else: { return 4; } }
			}
			host_error_outcome(mode, 0);
		} catch(OpaqueScope.HostErrorFault error) { host_error_outcome(mode, error.read()); }
	} catch(OpaqueScope.HostErrorFault unexpected) { return 91; }
	if (scoped_allocator_query(objects, 1) != 0) return 1;
	return 0;
}

export(C) int host_error_probe() {
	for (int mode = 0; mode < 6; mode = mode + 1) {
		int result = host_error_case(mode);
		if (result != 0) return result;
	}
	return host_error_finish();
}
