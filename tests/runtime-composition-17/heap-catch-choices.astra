extern(C) void heap_choice_retired(int identity);
extern(C) void heap_choice_observed(int mode, int value);
extern(C) int heap_choice_finish();
[Allocator(kind="context",context="scoped-affine")]
class ChoiceLeaf {
	private int identity;
	private int value;
	init(int identity, int value) { this.identity = identity; this.value = value; }
	int read() { return this.value; }
	deinit() { heap_choice_retired(this.identity); }
}
[ExceptionRoot]
class ChoiceFault {
	private owned ChoiceLeaf child;
	init(owned ChoiceLeaf child) { this.child = move child; }
	int read() { return this.child.read(); }
	virtual property string message { get { return "choice"; } }
}
void choice_raise(owned ChoiceLeaf input) throws ChoiceFault { throw new ChoiceFault(move input); }
int heap_choice_case(int mode) {
	owned u8[] left_backing = new u8[8197];
	owned u8[] right_backing = new u8[8197];
	var first = scoped_allocator<ScopedAllocator>(left_backing, 1, 2);
	var second = scoped_allocator<ScopedAllocator>(right_backing, 2, 2);
	try {
		var left = new(first) ChoiceLeaf(mode * 2 + 1, 17);
		var right = new(second) ChoiceLeaf(mode * 2 + 2, 29);
		if (mode == 0) { choice_raise(move left); }
		else { choice_raise(move right); }
	} catch(ChoiceFault error) { heap_choice_observed(mode, error.read()); }
	if (scoped_allocator_query(first, 1) != 0 || scoped_allocator_query(second, 1) != 0) { return 1; }
	return 0;
}
export(C) int heap_choice_probe() {
	for (int mode = 0; mode < 2; mode = mode + 1) {
		int result = heap_choice_case(mode);
		if (result != 0) { return result; }
	}
	return heap_choice_finish();
}
