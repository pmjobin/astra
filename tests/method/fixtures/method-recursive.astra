struct Counter {
	int value;

	int count_down(int n) {
		if (n == 0) return this.value;
		this.value = this.value + 1;
		return this.count_down(n - 1);
	}

	int even(int n) {
		if (n == 0) return this.value;
		return this.odd(n - 1);
	}

	int odd(int n) {
		if (n == 0) return this.value;
		return this.even(n - 1);
	}
}

int main() {
	Counter c = { value = 39 };
	if (c.count_down(3) != 42) return 1;
	return c.even(10);
}
