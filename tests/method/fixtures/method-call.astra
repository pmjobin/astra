struct Counter {
	int value;

	void bump() { this.add(1); }
	void add(int value) { this.value = this.value + value; }
	int reset() { this.value = 40; this.bump(); return this.value; }
}
struct Other {
	int value;
	int reset() { return this.value; }
}
int reset() { return 0; }
int main() {
	Counter c = { value = 0 };
	Other other = { value = 1 };
	return c.reset() + other.reset() + reset();
}
