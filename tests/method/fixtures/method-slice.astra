struct Accumulator {
	int bias;

	int sum(borrowed int[] values) {
		int result = this.bias;
		int i = 0;
		while (i < len(values)) {
			result = result + values[i];
			i = i + 1;
		}
		return result;
	}
}
int main() {
	Accumulator accumulator = { bias = 32 };
	int[4] array = { 1, 2, 3, 4 };
	return accumulator.sum(slice(array));
}
