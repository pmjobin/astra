struct Counter {
	int value;

	void add(int amount) {
		this.value = this.value + amount;
	}
}

int main() {
	Counter untouched = { value = 7 };
	Counter c = { value = 1 };
	untouched.value = untouched.value + 1;
	c.value = 36;
	c.add(1);
	c.add(2);
	c.add(3);
	return c.value + untouched.value - 8;
}
