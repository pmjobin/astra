namespace Alloc12;
extern(C) void unit_event(int value);
[Allocator(kind="region", domain="unit12.region", capacity="256", blocks="8")]
[Align(bytes="64")]
class Entry {
	private int value;
	init(int value) { this.value = value; unit_event(value); }
	deinit() { unit_event(0 - this.value); }
	int read() { return this.value; }
}
[Repr(layout="C")]
[Align(bytes="8")]
struct Snapshot { i64 first; f64 second; }
owned Entry create(int value) { var result = new Entry(value); return move result; }
