void consume(owned Resource r, bool c) {
	if (c) { record(3); }
}
void scenario() {
	owned Resource r = create_resource(4);
	consume(move r, record(1) == 1 && record(2) == 2);
}
int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 1 || resource_destroy_count() != 1 || resource_destroy_order() != 4 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 0) { return 1; }
	if (resource_effect_order() != 1234) { return 2; }
	return 0;
}
