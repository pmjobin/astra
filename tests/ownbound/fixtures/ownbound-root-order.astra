void consume(owned Resource a, int n, owned Resource b) {
	owned Resource local = create_resource(n);
}

void scenario() {
	owned Resource x = create_resource(1);
	owned Resource y = create_resource(2);
	consume(move x, 3, move y);
}

int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 3 || resource_destroy_count() != 3 || resource_destroy_order() != 321 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 0) return 1;
	return 0;
}
