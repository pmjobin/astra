owned Resource pass(owned Resource r) {
	return move r;
}

void scenario() {
	owned Resource a = create_resource(1);
	owned Resource b = pass(move a);
	if (resource_id(b) != 1 || resource_destroy_count() != 0) record(9);
}

int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 1 || resource_destroy_count() != 1 || resource_destroy_order() != 1 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 0) return 1;
	if (resource_effect_order() != 1) return 2;
	return 0;
}
