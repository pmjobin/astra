void consume(owned Resource a, owned Resource b) {
	return;
}
void scenario() {
	owned Resource x = create_resource(1);
	owned Resource y = create_resource(2);
	consume(move x, move y);
}
int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 2 || resource_destroy_count() != 2 || resource_destroy_order() != 21 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 0) { return 1; }
	return 0;
}
