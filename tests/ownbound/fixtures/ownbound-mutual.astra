owned Resource even(owned Resource r, int n) {
	if (n == 0) { return move r; }
	owned Resource next = odd(move r, n - 1);
	return move next;
}
owned Resource odd(owned Resource r, int n) {
	if (n == 0) { return move r; }
	owned Resource next = even(move r, n - 1);
	return move next;
}
void scenario() {
	owned Resource r = create_resource(1);
	owned Resource final = even(move r, 7);
}
int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 1 || resource_destroy_count() != 1 || resource_destroy_order() != 1 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 0) { return 1; }
	return 0;
}
