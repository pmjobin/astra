owned Resource make(int id) {
	owned Resource r = create_resource(id);
	return move r;
}

void scenario() {
	owned Resource r = make(1);
	release r;
	r = make(2);
}

int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 2 || resource_destroy_count() != 2 || resource_destroy_order() != 12 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 0) return 1;
	return 0;
}
