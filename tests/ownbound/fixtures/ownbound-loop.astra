void consume(owned Resource r) {
	int n = 0;
	while (n < 2) {
		resource_touch(r);
		release r;
		r = create_resource(n + 2);
		n = n + 1;
	}
}

void scenario() {
	owned Resource r = create_resource(1);
	consume(move r);
}

int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 3 || resource_destroy_count() != 3 || resource_destroy_order() != 123 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 2) return 1;
	return 0;
}
