owned Resource choose(owned Resource a, owned Resource b, bool c) {
	owned Resource temp = create_resource(3);
	if (c) { return move a; }
	return move b;
}
void scenario() {
	owned Resource a = create_resource(1);
	owned Resource b = create_resource(2);
	owned Resource result = choose(move a, move b, true);
}
int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 3 || resource_destroy_count() != 3 || resource_destroy_order() != 321 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 0) { return 1; }
	return 0;
}
