bool constructor_index_mutations(RecoverFlow flow) {
	int f = 0;
	while (f < flow.data.function_count) {
		var function = flow.data.functions[f].symbol;
		if (class_storage_initializing(flow.checked, function)) {
			int instance = generic_instance_for(flow.checked, function);
			var aggregate = flow.checked.instances[instance - 1].enclosing;
			var declaration = flow.checked.bindings.symbol(function);
			var body = flow.checked.bindings.program.arena.get_node_body(declaration.node);
			var statements = flow.checked.bindings.program.arena.get_list_statements(body);
			var initialized = new bool[flow.checked.bindings.symbol_count + 1];
			int i = 0;
			while (i < flow.checked.bindings.program.arena.list_count(statements)) {
				var statement = flow.checked.bindings.program.arena.node_at(statements, i);
				if (flow.checked.bindings.program.arena.kind(statement) == SyntaxKind.FieldAssignmentStatementSyntax()) {
					var target = flow.checked.bindings.program.arena.get_node_target(statement);
					var field = checked_target(flow.checked, target, flow.checked.bindings.program.arena.get_token_field_name(target));
					if (field.index > 0) initialized[field.index] = true;
				}
				if (flow.checked.bindings.program.arena.kind(statement) == SyntaxKind.IndexedAssignmentSyntax()) {
					if (!recover_constructor_indexed(flow.checked, statement, function, aggregate, initialized)) return false;
					var target = flow.checked.bindings.program.arena.get_node_target(statement);
					var container = flow.checked.bindings.program.arena.get_node_container(target);
					var field = checked_target(flow.checked, container, flow.checked.bindings.program.arena.get_token_field_name(container));
					initialized[field.index] = false; bool rejected = !recover_constructor_indexed(flow.checked, statement, function, aggregate, initialized); initialized[field.index] = true;
					if (!rejected || !recover_constructor_indexed(flow.checked, statement, function, aggregate, initialized) || !recover_flow_verify(flow)) return false;
					println("SEMANTIC constructor-array-initialized-source-path");
					int flags = flow.checked.symbol_flags[field.index]; flow.checked.symbol_flags[field.index] = 0; rejected = !recover_flow_verify(flow); flow.checked.symbol_flags[field.index] = flags;
					if (!rejected || !recover_flow_verify(flow)) return false;
					println("SEMANTIC constructor-array-owned-field");
					var type = flow.checked.symbol_types[field.index]; flow.checked.symbol_types[field.index] = type_id(1); rejected = !recover_flow_verify(flow); flow.checked.symbol_types[field.index] = type;
					if (!rejected || !recover_flow_verify(flow)) return false;
					println("SEMANTIC constructor-array-source-type");
					int receiver = class_storage_receiver(flow.checked, function); flags = flow.checked.symbol_flags[receiver]; flow.checked.symbol_flags[receiver] = 0; rejected = !recover_flow_verify(flow); flow.checked.symbol_flags[receiver] = flags;
					if (!rejected || !recover_flow_verify(flow)) return false;
					println("SEMANTIC constructor-array-actual-receiver");
					return true;
				}
				i = i + 1;
			}
		}
		f = f + 1;
	}
	return true;
}

bool frontier_flow_mutations(RecoverFlow flow) {
	if (!error_flow_mutations(flow) || !constructor_index_mutations(flow)) return false;
	bool foreign = false;
	bool caller = false;
	bool utf8 = false;
	var arrays = new bool[7];
	int n = 0;
	while (n < flow.data.node_count) {
		var saved = flow.data.nodes[n];
		bool changed = false;
		var row = saved;
		if (saved.kind == 50 && !foreign) {
			row.symbol = type_symbol(0);
			foreign = true;
			changed = true;
		}
		if (saved.kind == 51 && !caller) {
			row.symbol = type_symbol(0);
			caller = true;
			changed = true;
		}
		if (saved.kind == 53 && !utf8) {
			row.symbol = type_symbol(0);
			utf8 = true;
			changed = true;
		}
		int array = -1;
		if (saved.kind == 55) array = 0;
		if (saved.kind == 61) array = 1;
		if (saved.kind == 56) array = 2;
		if (saved.kind == 57) array = 3;
		if (saved.kind == 54) array = 4;
		if (saved.kind == 58 && saved.symbol.index > 0) array = 5;
		if (saved.kind == 17 && flow.fields.facts[saved.source.index].parent > 0) array = 6;
		if (array >= 0 && !arrays[array]) {
			arrays[array] = true;
			if (array == 0) row.a = row.b;
			if (array == 1) row.b = row.a;
			if (array == 2 || array == 3) row.count = row.count - 1;
			if (array == 4) {
				SyntaxTokenId absent = {index = 0};
				row.token = absent;
			}
			if (array == 5) row.symbol = type_symbol(0);
			if (array == 6) {
				var fact = flow.fields.facts[saved.source.index];
				var changed_fact = fact;
				changed_fact.parent = 0;
				flow.fields.facts[saved.source.index] = changed_fact;
				bool rejected = !recover_flow_verify(flow);
				flow.fields.facts[saved.source.index] = fact;
				if (!rejected || !recover_flow_verify(flow)) return false;
				println("SEMANTIC nested-field-parent-authority");
			} else {
				flow.data.nodes[n] = row;
				bool rejected = !recover_flow_verify(flow);
				flow.data.nodes[n] = saved;
				if (!rejected || !recover_flow_verify(flow)) return false;
				if (array == 0) println("SEMANTIC indexed-load-source-input");
				if (array == 1) println("SEMANTIC indexed-store-source-index");
				if (array == 2) println("SEMANTIC slice-source-arity");
				if (array == 3) println("SEMANTIC fixed-array-initializer-extent");
				if (array == 4) println("SEMANTIC integer-cast-source-operator");
				if (array == 5) println("SEMANTIC counted-text-source-root");
			}
		}
		if (changed) {
			flow.data.nodes[n] = row;
			bool rejected = !recover_flow_verify(flow);
			flow.data.nodes[n] = saved;
			if (!rejected || !recover_flow_verify(flow)) return false;
			if (saved.kind == 50) println("SEMANTIC counted-C-source-identity");
			if (saved.kind == 51) println("SEMANTIC caller-parameter-identity");
			if (saved.kind == 53) println("SEMANTIC UTF8-input-identity");
		}
		n = n + 1;
	}
	int literal = 1;
	while (literal < len(flow.types.numeric_prefixes)) {
		var parent = flow.types.numeric_prefixes[literal];
		if (parent.index > 0) {
			SyntaxNodeId absent = {index = 0};
			flow.types.numeric_prefixes[literal] = absent;
			bool rejected = !recover_flow_verify(flow);
			flow.types.numeric_prefixes[literal] = parent;
			if (!rejected || !recover_flow_verify(flow)) return false;
			println("SEMANTIC signed-magnitude-source-parent");
			break;
		}
		literal = literal + 1;
	}
	return true;
}

bool frontier_core_mutations(RecoverCore core) {
	if (!error_core_mutations(core)) return false;
	int n = 0;
	while (n < core.count) {
		var saved = core.nodes[n];
		if (saved.value.kind == 56) {
			var row = saved;
			row.borrowed_owner = 0;
			core.nodes[n] = row;
			bool rejected = !recover_core_verify(core);
			core.nodes[n] = saved;
			if (!rejected || !recover_core_verify(core)) return false;
			println("SEMANTIC slice-core-backing-root");
			return true;
		}
		if (saved.value.kind == 53) {
			var row = saved;
			row.borrowed_owner = 0;
			core.nodes[n] = row;
			bool rejected = !recover_core_verify(core);
			core.nodes[n] = saved;
			if (!rejected || !recover_core_verify(core)) return false;
			println("SEMANTIC UTF8-core-borrow-root");
			return true;
		}
		n = n + 1;
	}
	return true;
}

bool frontier_cfg_mutations(RecoverCfg cfg) {
	if (!error_cfg_mutations(cfg)) return false;
	int n = 0;
	while (n < cfg.block_count) {
		var saved = cfg.blocks[n];
		if (saved.opcode == 64) {
			var row = saved;
			row.next = cfg.regions[saved.origin - 1].operation;
			int edge = -1;
			int e = 0;
			while (e < cfg.edge_count) {
				if (cfg.edges[e].source == n + 1 && cfg.edges[e].polarity == 1) edge = e;
				e = e + 1;
			}
			if (edge < 0) return false;
			var saved_edge = cfg.edges[edge];
			var changed_edge = saved_edge;
			changed_edge.target = row.next;
			cfg.edges[edge] = changed_edge;
			cfg.blocks[n] = row;
			bool rejected = !recover_cfg_verify(cfg);
			cfg.blocks[n] = saved;
			cfg.edges[edge] = saved_edge;
			if (!rejected || !recover_cfg_verify(cfg)) return false;
			println("SEMANTIC indexed-store-guard-before-RHS");
			return true;
		}
		if (saved.opcode == 21 && cfg.core.nodes[saved.a - 1].value.kind == 52) {
			var row = saved;
			row.next = saved.other;
			row.other = saved.next;
			int yes = -1;
			int no = -1;
			int e = 0;
			while (e < cfg.edge_count) {
				if (cfg.edges[e].source == n + 1) {
					if (cfg.edges[e].polarity == 1) yes = e;
					if (cfg.edges[e].polarity == 2) no = e;
				}
				e = e + 1;
			}
			if (yes < 0 || no < 0) return false;
			var saved_yes = cfg.edges[yes];
			var saved_no = cfg.edges[no];
			var changed_yes = saved_yes;
			var changed_no = saved_no;
			changed_yes.target = row.next;
			changed_no.target = row.other;
			cfg.edges[yes] = changed_yes;
			cfg.edges[no] = changed_no;
			cfg.blocks[n] = row;
			bool rejected = !recover_cfg_verify(cfg);
			cfg.blocks[n] = saved;
			cfg.edges[yes] = saved_yes;
			cfg.edges[no] = saved_no;
			if (!rejected || !recover_cfg_verify(cfg)) return false;
			println("SEMANTIC UTF8-CFG-true-edge");
			return true;
		}
		n = n + 1;
	}
	return true;
}

bool frontier_ssa_mutations(RecoverSsa ssa) {
	if (!error_ssa_mutations(ssa)) return false;
	int n = 1;
	while (n <= ssa.cfg.core.count) {
		int kind = ssa.cfg.core.nodes[n - 1].value.kind;
		if (kind == 53 || kind == 56) {
			var saved = ssa.data.values[n];
			var row = saved;
			row.block = ssa.cfg.entries[row.function - 1];
			ssa.data.values[n] = row;
			bool rejected = !recover_ssa_verify(ssa);
			ssa.data.values[n] = saved;
			if (!rejected || !recover_ssa_verify(ssa)) return false;
			if (kind == 53) println("SEMANTIC UTF8-SSA-definition-dominance");
			if (kind == 56) println("SEMANTIC slice-SSA-definition-dominance");
			return true;
		}
		n = n + 1;
	}
	return true;
}

bool error_flow_mutations(RecoverFlow flow) {
	bool base = false;
	bool nominal = false;
	bool layout = false;
	bool conditional = false;
	bool catch_root = false;
	int n = 0;
	while (n < flow.data.node_count) {
		var saved = flow.data.nodes[n];
		if (saved.kind == 4 && !catch_root) {
			int p = 0;
			while (p < saved.count && !catch_root) {
				int id = recover_owner_unwrap(flow.data, flow.data.edges[saved.first + p]);
				if (id > 0 && flow.data.nodes[id - 1].kind == 66) {
					var argument = flow.data.nodes[id - 1]; int prior = flow.data.catch_owners[argument.symbol.index];
					flow.data.catch_owners[argument.symbol.index] = 0;
					bool rejected = !recover_payload_calls_verified(flow);
					flow.data.catch_owners[argument.symbol.index] = prior;
					if (!rejected || !recover_flow_verify(flow)) return false;
					println("SEMANTIC Error-catch-borrow-call-root"); catch_root = true;
				}
				p = p + 1;
			}
		}
		if (saved.kind == 62 && flow.checked.uses[saved.source.index].type.index == 0 && !conditional) {
			var prior = flow.types.types[saved.source.index];
			var row = saved; row.type = type_id(1);
			flow.data.nodes[n] = row; flow.types.types[saved.source.index] = row.type;
			bool rejected = !recover_flow_verify(flow);
			flow.data.nodes[n] = saved; flow.types.types[saved.source.index] = prior;
			if (!rejected || !recover_flow_verify(flow)) return false;
			println("SEMANTIC recovered-short-circuit-source-type"); conditional = true;
		}
		if (saved.kind == 65 && !base) {
			var row = saved;
			int instance = generic_instance_for(flow.checked, flow.data.functions[row.function - 1].symbol);
			row.source = flow.checked.bindings.symbol(flow.checked.instances[instance - 1].origin).node;
			flow.data.nodes[n] = row;
			bool rejected = !recover_flow_verify(flow);
			flow.data.nodes[n] = saved;
			if (!rejected || !recover_flow_verify(flow)) return false;
			println("SEMANTIC Error-base-binder-universe");
			base = true;
		}
		if (saved.kind == 67 && !nominal) {
			var row = saved;
			var owner = flow.checked.bindings.symbol(flow.checked.types.row(row.type).nominal);
			var parent_node = flow.checked.bindings.program.arena.get_node_parent_class(owner.node);
			var parent = checked_effect_class(flow.checked, parent_node);
			row.type = flow.checked.symbol_types[parent.index];
			flow.data.nodes[n] = row;
			bool rejected = !recover_flow_verify(flow);
			flow.data.nodes[n] = saved;
			if (!rejected || !recover_flow_verify(flow)) return false;
			println("SEMANTIC Error-construction-source-nominal");
			nominal = true;
		}
		if ((saved.kind == 17 || saved.kind == 44) && !layout) {
			var fact = flow.fields.facts[saved.source.index];
			if (error_storage_class(flow.checked, fact.aggregate)) {
				var physical = flow.fields.errors.fields[fact.field.index];
				var forged = physical;
				forged.offset = 16;
				flow.fields.errors.fields[fact.field.index] = forged;
				int k = 0;
				while (k < len(flow.fields.facts)) {
					var other = flow.fields.facts[k];
					if (other.field.index == fact.field.index) {
						other.offset = 16;
						flow.fields.facts[k] = other;
					}
					k = k + 1;
				}
				bool rejected = !recover_flow_verify(flow);
				flow.fields.errors.fields[fact.field.index] = physical;
				k = 0;
				while (k < len(flow.fields.facts)) {
					var other = flow.fields.facts[k];
					if (other.field.index == fact.field.index) {
						other.offset = physical.offset;
						flow.fields.facts[k] = other;
					}
					k = k + 1;
				}
				if (!rejected || !recover_flow_verify(flow)) return false;
				println("SEMANTIC Error-derived-field-header-overlap");
				layout = true;
			}
		}
		n = n + 1;
	}
	return true;
}

bool error_core_mutations(RecoverCore core) {
	int n = 0;
	while (n < core.count) {
		var saved = core.nodes[n];
		if (saved.value.kind == 66) {
			int other = 0;
			while (other < core.count) {
				var owner = core.nodes[other].value;
				if (owner.kind == 25 && owner.type.index == saved.value.type.index && other + 1 != saved.borrowed_owner) {
					var row = saved;
					row.borrowed_owner = other + 1;
					core.nodes[n] = row;
					bool rejected = !recover_core_verify(core);
					core.nodes[n] = saved;
					if (!rejected || !recover_core_verify(core)) return false;
					println("SEMANTIC Error-same-type-catch-owner");
					return true;
				}
				other = other + 1;
			}
		}
		n = n + 1;
	}
	return true;
}

bool error_cfg_mutations(RecoverCfg cfg) {
	int b = 0;
	while (b < cfg.block_count) {
		var saved = cfg.blocks[b];
		if (saved.opcode == 65) {
			var region = cfg.regions[saved.origin - 1];
			var row = saved;
			row.next = cfg.terminals[row.function - 1];
			if (row.next == saved.next) row.next = cfg.errors[row.function - 1];
			cfg.blocks[b] = row;
			var forged = region;
			forged.next = row.next;
			cfg.regions[saved.origin - 1] = forged;
			int e = 0;
			while (e < cfg.edge_count) {
				var edge = cfg.edges[e];
				if (edge.source == b + 1) {
					edge.target = row.next;
					cfg.edges[e] = edge;
				}
				e = e + 1;
			}
			bool rejected = !recover_cfg_verify(cfg);
			cfg.blocks[b] = saved;
			cfg.regions[saved.origin - 1] = region;
			e = 0;
			while (e < cfg.edge_count) {
				var edge = cfg.edges[e];
				if (edge.source == b + 1) {
					edge.target = saved.next;
					cfg.edges[e] = edge;
				}
				e = e + 1;
			}
			if (!rejected || !recover_cfg_verify(cfg)) return false;
			println("SEMANTIC Error-base-before-field-continuation");
			return true;
		}
		b = b + 1;
	}
	return true;
}

bool error_ssa_mutations(RecoverSsa ssa) {
	int n = 0;
	while (n < ssa.cfg.core.count) {
		if (ssa.cfg.core.nodes[n].value.kind == 67) {
			var saved = ssa.data.values[n + 1];
			var row = saved;
			row.channel = 4;
			ssa.data.values[n + 1] = row;
			bool rejected = !recover_ssa_verify(ssa);
			ssa.data.values[n + 1] = saved;
			if (!rejected || !recover_ssa_verify(ssa)) return false;
			println("SEMANTIC Error-SSA-acquisition-channel");
			return true;
		}
		n = n + 1;
	}
	return true;
}
