int main(string[] args) {
	if (len(args) > 2 && (args[1] == "--r1-types" || args[1] == "--r1-type-mutations")) return r1_typecore_cli(args);
	if (len(args) > 4 && args[1] == "--r1-owner-trace") return r1_owner_cli(args);
	if (len(args) > 4 && args[1] == "--effects-trace") return effects_cli(args, 4);
	return genref_cli(args);
}
