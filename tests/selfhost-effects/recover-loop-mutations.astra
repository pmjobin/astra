// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Fresh positive twins precede mutations of the actual retained owners/IR.
int recover_loop_semantic_case(string[] args, int category) throws Error {
	var source = binding_load_program(args, 3); var bindings = binding_index(move source, 0); var checked = checked_build_profile(move bindings, 0, true, true, true, true, true); var flow = recover_flow_lower(move checked, 8192); assert_that(recover_flow_verify(flow));
	if (category == 0) {
		int n = 0;
		while (n < flow.data.node_count) {
			var row = flow.data.nodes[n];
			if (row.kind == 41) {
				row.c = 0;
				flow.data.nodes[n] = row;
				assert_that(!recover_flow_verify(flow));
				return 2;
			}
			n = n + 1;
		}
	}
	var core = recover_core_lower(move flow); assert_that(recover_core_verify(core));
	if (category == 1) {
		int n = 0;
		while (n < core.count) {
			var row = core.nodes[n];
			if (row.value.kind == 10 && recover_storage_error(core.flow.checked, row.value.type)) {
				row.place = 0;
				core.nodes[n] = row;
				assert_that(!recover_core_verify(core));
				return 3;
			}
			n = n + 1;
		}
	}
	var cfg = recover_cfg_lower(move core, 8192); assert_that(recover_cfg_verify(cfg));
	if (category == 2 || category == 3) { int b = 0; while (b < cfg.block_count) { var row = cfg.blocks[b];
			if (category == 2 && row.opcode == 41) {
				row.next = cfg.regions[cfg.core.nodes[row.origin - 1].value.c - 1].next;
				cfg.blocks[b] = row;
				recover_owner_refresh_edges(cfg);
				assert_that(!recover_cfg_verify(cfg));
				return 4;
			}
			if (category == 3 && row.opcode == 39) {
				int saved = row.next;
				row.next = row.other;
				row.other = saved;
				cfg.blocks[b] = row;
				recover_owner_refresh_edges(cfg);
				assert_that(!recover_cfg_verify(cfg));
				return 4;
			}
			b = b + 1;
		} }
	var ssa = recover_ssa_lower(move cfg, 8000000); assert_that(recover_ssa_verify(ssa));
	if (category == 4) {
		int v = 1;
		while (v < len(ssa.data.values)) {
			var row = ssa.data.values[v];
			if (row.channel == 5) {
				row.channel = 0;
				ssa.data.values[v] = row;
				assert_that(!recover_ssa_verify(ssa));
				return 5;
			}
			v = v + 1;
		}
	}
	if (category == 5) {
		int f = 0;
		while (f < ssa.cfg.core.flow.data.function_count) {
			var function = ssa.cfg.core.flow.data.functions[f];
			if (recover_storage_error(ssa.cfg.core.flow.checked, function.result)) {
				var plan = new RecoverAbi(ssa.cfg.core.flow.checked, function.symbol);
				assert_that(recover_abi_verify(plan, ssa.cfg.core.flow.checked));
				plan.result_flags = 0;
				assert_that(!recover_abi_verify(plan, ssa.cfg.core.flow.checked));
				return 6;
			}
			f = f + 1;
		}
	}
	assert_that(false); return 0;
}

bool recover_loop_mutate_physical(RecoverLlvm module, RecoverSsa ssa, int category) {
	if (category == 5) {
		var entry = LLVMGetEntryBasicBlock(module.error_owner_function);
		var split = LLVMGetBasicBlockTerminator(entry);
		LLVMSetSuccessor(split, 0, LLVMGetSuccessor(split, 1));
		return true;
	}
	bool changed = false; int b = 0; while (b < ssa.cfg.block_count) { var row = ssa.cfg.blocks[b]; var operation = module.state.operations[b];
		if (ssa.data.reachable[b]) {
			if (category == 0 && row.opcode == 38 && recover_storage_error(ssa.cfg.core.flow.checked, ssa.cfg.core.flow.storage.slots[row.a - 1].type)) {
				LLVMSetOperand(operation, 0, LLVMConstNull(module.pointer));
				changed = true;
			}
			if (category == 1 && row.opcode == 39) {
				var split = LLVMGetBasicBlockTerminator(module.state.blocks[b]);
				var yes = LLVMGetSuccessor(split, 0);
				LLVMSetSuccessor(split, 0, LLVMGetSuccessor(split, 1));
				LLVMSetSuccessor(split, 1, yes);
				changed = true;
			}
			if (category == 2 && row.opcode == 39) {
				LLVMSetOperand(operation, 0, LLVMConstNull(module.pointer));
				changed = true;
			}
			if (category == 3 && row.opcode == 42) {
				LLVMSetOperand(operation, 0, LLVMConstNull(LLVMTypeOf(LLVMGetOperand(operation, 0))));
				changed = true;
			}
			if (category == 4 && row.opcode == 41) {
				int loop = ssa.cfg.core.nodes[row.origin - 1].value.c;
				LLVMSetSuccessor(LLVMGetBasicBlockTerminator(module.state.blocks[b]), 0, module.state.blocks[ssa.cfg.regions[loop - 1].next - 1]);
				changed = true;
			}
		} b = b + 1;
	} return changed;
}

int recover_loop_mutations_cli(string[] args) {
	try {
		int category = 0; while (category < 6) {
			int stage = recover_loop_semantic_case(args, category);
			var out = new Utf8ByteBuilder();
			source_append_text(out, "RECOVER_LOOP_REJECT ");
			append_int(out, category);
			source_append_text(out, " ");
			append_int(out, stage);
			var text = out.snapshot();
			println(text.text);
			category = category + 1;
		}
		var source = binding_load_program(args, 3); var bindings = binding_index(move source, 0); var checked = checked_build_profile(move bindings, 0, true, true, true, true, true); var flow = recover_flow_lower(move checked, 8192); var core = recover_core_lower(move flow); var cfg = recover_cfg_lower(move core, 8192); var ssa = recover_ssa_lower(move cfg, 8000000); assert_that(recover_ssa_verify(ssa));
		category = 0; while (category < 6) { var module = new RecoverLlvm(ssa); module.build(ssa); assert_that(module.check(ssa)); assert_that(recover_loop_mutate_physical(module, ssa, category)); assert_that(llvm12_verify(module.module) == 0); assert_that(!module.check(ssa));
			var path = new Utf8ByteBuilder(); source_append_text(path, args[2]); source_append_text(path, "/loop-physical-"); append_int(path, category); source_append_text(path, ".ll"); var filename = path.snapshot(); assert_that(llvm12_write(module.module, module.machine, 0, 16777216, filename.text) == 0);
			var out = new Utf8ByteBuilder(); source_append_text(out, "RECOVER_LOOP_LLVM_REJECT "); append_int(out, category); var text = out.snapshot(); println(text.text); category = category + 1;
		} return 0;
	} catch (Error error) { println_stderr(error.message); return 5; }
}
