// Current production consumers, with valid twins around every changed plan.
// Read-only diagnosis of a failed Flow consumer. The original failure status
// stays set; these observations cannot make a rejected plan executable.
void recover_frontier_flow_diagnose(RecoverFlow flow) throws Error {
	var bad = new bool[flow.data.node_count];
	int n = 0;
	while (n < flow.data.node_count) {
		var row = flow.data.nodes[n];
		if (row.kind != 51) {
			var seen = new bool[flow.data.node_count];
			var edges = new bool[flow.data.edge_count];
			bad[n] = !recover_child(flow.data, flow.checked, flow.types, n + 1, row.source, row.function, row.handler, row.caught, seen, edges, 0);
		}
		n = n + 1;
	}
	n = 0;
	int printed = 0;
	while (n < flow.data.node_count && printed < 16) {
		var row = flow.data.nodes[n];
		bool child_bad = row.a > 0 && bad[row.a - 1] || row.b > 0 && bad[row.b - 1];
		int p = 0;
		while (p < row.count) {
			if (bad[flow.data.edges[row.first + p] - 1]) child_bad = true;
			p = p + 1;
		}
		if (bad[n] && !child_bad) {
			var output = new Utf8ByteBuilder();
			source_append_text(output, "FLOW_LEAF ");
			append_int(output, n + 1);
			source_append_text(output, " ");
			append_int(output, row.kind);
			source_append_text(output, " ");
			append_int(output, row.source.index);
			source_append_text(output, " ");
			append_int(output, row.type.index);
			source_append_text(output, "\n");
			binding_write_span(flow.checked.bindings, flow.checked.bindings.program.arena.header(row.source).span, output);
			var text = output.snapshot();
			println(text.text);
			printed = printed + 1;
		}
		n = n + 1;
	}
	if (printed == 0) {
		if (!recover_types_verify(flow.types, flow.checked)) println("FLOW_PROOF_FAILED types");
		if (!recover_storage_verify(flow.storage, flow.checked, flow.data.symbols)) println("FLOW_PROOF_FAILED storage");
		if (!recover_fields_verify(flow.fields, flow.checked, flow.storage, flow.data)) println("FLOW_PROOF_FAILED fields");
		if (!recover_array_places_verified(flow)) println("FLOW_PROOF_FAILED array-roots");
		if (!recover_payload_calls_verified(flow)) println("FLOW_PROOF_FAILED payload-calls");
		if (!recover_literal_string_results(flow.data)) println("FLOW_PROOF_FAILED string-results");
		var seen = new bool[flow.data.node_count];
		var edges = new bool[flow.data.edge_count];
		int f = 0;
		while (f < flow.data.function_count) {
			var function = flow.data.functions[f];
			var declaration = flow.checked.bindings.symbol(function.symbol);
			if (!recover_child(flow.data, flow.checked, flow.types, function.body, flow.checked.bindings.program.arena.get_node_body(declaration.node), f + 1, 0, 0, seen, edges, 0)) println("FLOW_PROOF_FAILED function-tree");
			if (function.result.index != 14 && recover_falls(flow.data, function.body, 0)) println("FLOW_PROOF_FAILED function-return");
			if (!recover_loop_verify(flow.data, function.body, 0, 0)) println("FLOW_PROOF_FAILED loop-context");
			f = f + 1;
		}
		n = 0;
		while (n < flow.data.node_count) {
			if (!seen[n]) {
				var row = flow.data.nodes[n];
				var output = new Utf8ByteBuilder();
				source_append_text(output, "FLOW_UNSEEN ");
				append_int(output, n + 1);
				source_append_text(output, "\n");
				binding_write_span(flow.checked.bindings, flow.checked.bindings.program.arena.header(row.source).span, output);
				var text = output.snapshot();
				println(text.text);
			}
			n = n + 1;
		}
	}
}

int recover_shared_stage_cli(string[] args, int start, bool mutations) {
	try {
		var program = binding_load_program(args, start);
		var bindings = binding_index(move program, 0);
		var checked = checked_build_effects_profile(move bindings, 0);
		if (checked.failed()) {
			var text = checked_observation(checked);
			print(text.text);
			return 1;
		}
		int n = 1;
		while (n < len(checked.uses)) {
			SyntaxNodeId node = {index = n};
			int action = checked_shared_action(checked, node);
			if (action > 0 && checked.uses[n].type.index > 0) {
				var facts = new Utf8ByteBuilder();
				source_append_text(facts, "SHARED ");
				append_int(facts, action);
				source_append_text(facts, " ");
				append_int(facts, checked_kind(checked, checked.uses[n].type));
				source_append_text(facts, " ");
				append_int(facts, checked.uses[n].flags);
				source_append_text(facts, " ");
				append_int(facts, checked.uses[n].deferred);
				var fact_text = facts.snapshot();
				println(fact_text.text);
			}
			n = n + 1;
		}
		var flow = recover_flow_lower(move checked, 8192);
		var output = new Utf8ByteBuilder();
		source_append_text(output, "SHARED_FLOW ");
		append_int(output, flow.data.status);
		source_append_text(output, " ");
		append_int(output, flow.data.boundary.index);
		source_append_text(output, "\n");
		if (flow.data.boundary.index > 0) binding_write_span(flow.checked.bindings, flow.checked.bindings.program.arena.header(flow.data.boundary).span, output);
		var text = output.snapshot();
		println(text.text);
		if (flow.data.status != 0) {
			if (flow.data.status == 1) recover_frontier_flow_diagnose(flow);
			return 2;
		}
		if (!recover_flow_verify(flow) || mutations && (!shared_flow_mutations(flow) || !frontier_flow_mutations(flow))) return 3;
		var core = recover_core_lower(move flow);
		if (core.status != 0 || !recover_core_verify(core) || mutations && (!shared_core_mutations(core) || !frontier_core_mutations(core))) return 4;
		println("SHARED_CORE_VALID");
		var cfg = recover_cfg_lower(move core, 8192);
		if (cfg.status != 0 || !recover_cfg_verify(cfg) || mutations && (!shared_cfg_mutations(cfg) || !frontier_cfg_mutations(cfg))) return 5;
		println("SHARED_CFG_VALID");
		int cfg_blocks = cfg.block_count;
		var ssa = recover_ssa_lower(move cfg, 8000000);
		if (ssa.data.status != 0 || !recover_ssa_verify(ssa) || mutations && (!shared_ssa_mutations(ssa) || !frontier_ssa_mutations(ssa))) {
			var diagnostic = new Utf8ByteBuilder();
			source_append_text(diagnostic, "SHARED_SSA_STOP status ");
			append_int(diagnostic, ssa.data.status);
			source_append_text(diagnostic, " CFG_blocks ");
			append_int(diagnostic, cfg_blocks);
			source_append_text(diagnostic, " work_limit ");
			append_int(diagnostic, ssa.data.work_limit);
			var message = diagnostic.snapshot();
			println(message.text);
			return 6;
		}
		println("SHARED_SSA_VALID");
		return 42;
	} catch (Error error) {
		println(error.message);
		return 7;
	}
}
