// Keep the inherited native routes intact in the same current compiler.
int main(string[] args) {
	if (len(args) > 3 && args[1] == "--error-physical") return recover_error_physical_cli(args);
	if (len(args) > 3 && args[1] == "--frontier-physical") return recover_frontier_physical_cli(args);
	if (len(args) > 2 && args[1] == "--shared-stages") return recover_shared_stage_cli(args, 2, true);
	if (len(args) > 2 && args[1] == "--r4-source-policy") return recover_r4_observe_cli(args);
	if (len(args) > 4 && args[1] == "--r4-field-adversarial") return recover_cli(args);
	if (len(args) > 4 && args[1] == "--r3-domain-adversarial") return recover_cli(args);
	if (len(args) > 4 && args[1] == "--r3-adversarial") return recover_cli(args);
	if (len(args) > 4 && args[1] == "--loop-adversarial") return recover_cli(args);
	if (len(args) > 2 && (args[1] == "--native" || args[1] == "--native-module" || args[1] == "--flow" || args[1] == "--adversarial" || args[1] == "--owner-adversarial")) return recover_cli(args);
	return r2_cli(args);
}
