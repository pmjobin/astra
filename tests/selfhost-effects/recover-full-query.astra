// Keep the inherited native routes intact in the same current compiler.
int main(string[] args) {
	if (len(args) > 2 && (args[1] == "--native" || args[1] == "--flow" || args[1] == "--adversarial" || args[1] == "--owner-adversarial")) return recover_cli(args);
	return r2_cli(args);
}
