[CImport(name="com14_created")] int created(int value);
[CImport(name="com14_destroyed")] int destroyed(int value);

[COMExport(value_iid="849ad154-8d1e-4c63-9ea2-14329b022001", scale_iid="849ad154-8d1e-4c63-9ea2-14329b022002", threading="constructing")]
[Shared]
[CExport(name="com14", property="value")]
class Counter {
	private int data;
	init(int value) { this.data = value; created(value); }
	property int value {
		get { return this.data; }
		set(int value) { this.data = value; }
	}
	deinit() { destroyed(this.data); }
}

[CExport(name="com14_native_only")]
int native_only() {
	var root = new Counter(9);
	var copy = root.clone();
	var weak = root.downgrade();
	release root;
	if (copy.value != 9) { return 1; }
	release copy;
	var expired = weak.upgrade();
	if (expired != null) { return 2; }
	release weak;
	return 0;
}
