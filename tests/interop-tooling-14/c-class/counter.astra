[CImport(name="counter14_created")] int created(int value);

[CImport(name="counter14_destroyed")] int destroyed(int value);

[CExport(name="counter14", property="value")]
[Shared]
class Counter14 {
	private int data;

	init(int value) { this.data = value; created(value); }

	property int value {
		get { return this.data; }
		set(int value) { this.data = value; }
	}

	deinit() { destroyed(this.data); }
}

[CExport(name="counter14_native_only")]
int native_only() {
	var root = new Counter14(9);
	var weak = root.downgrade();
	var copy = root.clone();
	release root;
	if (copy.value != 9) return 1;
	release copy;
	var expired = weak.upgrade();
	if (expired != null) return 2;
	release weak;
	return 0;
}
