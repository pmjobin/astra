owned T prefix<T>(int id, owned T value) where T: Ownable {
	own_mark(69, id); loan<T>(value, id); return move value;
}
int main() {
	var original = new Counter(87, 1);
	var received = prefix(87, move original);
	consume(move received, 87);
	return own_finish();
}
