f32<4> gain(borrowed Resource r) {
	f32<4> failure = {0.0, 0.0, 0.0, 0.0};
	if (resource_touch_count() != 0) { return failure; }
	resource_touch(r);
	f32<4> value = {1.5, 2.0, 2.5, 3.0};
	return value;
}
u8 mode(borrowed Resource r) { if (resource_touch_count() != 1) { return 0; } resource_touch(r); return 250; }
f32<4> process(owned Resource r, f32<4> gain_value, u8 mode_value) {
	f32<4> failure = {0.0, 0.0, 0.0, 0.0};
	if (resource_touch_count() != 2 || resource_destroy_count() != 0 || mode_value != 250) { return failure; }
	f32<4> two = {2.0, 2.0, 2.0, 2.0};
	f32<4> result = gain_value * two;
	resource_touch(r);
	return result;
}
f32<4> scenario() {
	owned Resource a = create_resource(1);
	owned Resource b = create_resource(2);
	return process(move a, gain(b), mode(b));
}
int main() {
	resource_reset();
	f32<4> expected = {3.0, 4.0, 5.0, 6.0};
	if (!all(scenario() == expected)) { return 1; }
	if (resource_destroy_count() != 2 || resource_destroy_order() != 12 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 3) { return 2; }
	return 0;
}
