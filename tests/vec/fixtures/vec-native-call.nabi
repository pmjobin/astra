(native-abi vector-v4
	(function #0 "add_vectors"
		(linkage native-internal)
		(signature
			(parameters
				(parameter #0 VECTOR(I16,8))
				(parameter #1 VECTOR(I16,8))
			)
			(result VECTOR(I16,8))
		)
	)
	(function #1 "gain"
		(linkage native-internal)
		(signature
			(parameters
				(parameter #0 VECTOR(F32,4))
				(parameter #1 VECTOR(F32,4))
			)
			(result VECTOR(F32,4))
		)
	)
	(function #2 "passthrough"
		(linkage native-internal)
		(signature
			(parameters
				(parameter #0 VECTOR(B1,4))
			)
			(result VECTOR(B1,4))
		)
	)
	(function #3 "mix"
		(linkage native-internal)
		(signature
			(parameters
				(parameter #0 PTR)
				(parameter #1 VECTOR(F32,4))
				(parameter #2 U8)
				(parameter #3 VECTOR(B1,4))
			)
			(result U8)
		)
	)
	(function #4 "main"
		(linkage native-internal)
		(signature
			(parameters)
			(result I32)
		)
	)
)
