(program
	(function "add" -> int<4>
		(parameters
			(parameter #0 "a" : int<4>)
			(parameter #1 "b" : int<4>)
		)
		(block
			(return (binary + : int<4> (prefix + : int<4> (parameter-ref #0 "a" : int<4>)) (parameter-ref #1 "b" : int<4>)))
		)
	)
	(function "dynamic" -> int<4>
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
			(parameter #2 "c" : int)
			(parameter #3 "d" : int)
		)
		(locals
			(local #0 "v" : int<4>)
		)
		(block
			(local-init #0 "v" : int<4> (vector-init : int<4> (parameter-ref #0 "a" : int) (parameter-ref #1 "b" : int) (parameter-ref #2 "c" : int) (parameter-ref #3 "d" : int)))
			(return (local-ref #0 "v" : int<4>))
		)
	)
	(function "main" -> int
		(parameters)
		(locals
			(local #0 "a" : int<4>)
			(local #1 "b" : int<4>)
			(local #2 "expected" : int<4>)
		)
		(block
			(local-init #0 "a" : int<4> (vector-init : int<4> (integer 1 : int) (integer 2 : int) (integer 3 : int) (integer 4 : int)))
			(local-init #1 "b" : int<4> (call "dynamic" -> int<4> (arguments (integer 5 : int) (integer 6 : int) (integer 7 : int) (integer 8 : int))))
			(local-init #2 "expected" : int<4> (vector-init : int<4> (integer 6 : int) (integer 8 : int) (integer 10 : int) (integer 12 : int)))
			(assign (local-ref #0 "a" : int<4>) (call "add" -> int<4> (arguments (local-ref #0 "a" : int<4>) (local-ref #1 "b" : int<4>))))
			(if
				(condition (vector-all : bool (binary == : bool<4> (local-ref #0 "a" : int<4>) (local-ref #2 "expected" : int<4>))))
				(then
					(block
						(return (integer 0 : int))
					)
				)
			)
			(return (integer 1 : int))
		)
	)
)
