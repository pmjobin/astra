// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
void parser_cursor_checks() throws Error {
	var program = parser_text_program("int f(){return 0;}");
	var source = program.arena.add_source_text("probe", "A<B<C>>+x", false);
	var root = program.arena.source(source);
	var scanner = lexer(move root);
	var empty = syntax_text("");
	var prefix = syntax_text("");
	var parser = new SyntaxParser(program.arena, source, move scanner, move empty, move prefix);
	assert_that(parser.advance(program.arena));
	assert_that(parser.advance(program.arena));
	assert_that(parser.next_is(program.arena, TokenKind.IDENTIFIER()));
	assert_that(parser.following_is(program.arena, TokenKind.LESS()));
	var current = parser.current;
	var lookahead = parser.lookahead;
	var second = parser.second_lookahead;
	var before = program.arena.checkpoint();
	assert_that(!parser.begins_generic_call(program.arena));
	assert_that(!parser.begins_enum_application(program.arena));
	var after = program.arena.checkpoint();
	assert_that(before.used == after.used && before.tokens == after.tokens && before.texts == after.texts && before.lists == after.lists);
	assert_that(parser.current.index == current.index && parser.lookahead.index == lookahead.index && parser.second_lookahead.index == second.index);
	assert_that(parser.error_message.text.byte_length == 0);
	var fork = parser.fork(program.arena);
	var arguments = fork.parse_type_arguments(program.arena, -1);
	assert_that(program.arena.list_count(arguments) == 1);
	assert_that(program.arena.token_kind(fork.current) == TokenKind.PLUS());
	assert_that(program.arena.list_count(parser.type_applications) == 0);
	assert_that(parser.advance(program.arena));
	assert_that(program.arena.token_is(parser.current, "B"));
	assert_that(parser.advance(program.arena));
	assert_that(program.arena.token_kind(parser.current) == TokenKind.LESS());
	assert_that(parser.next_is(program.arena, TokenKind.IDENTIFIER()));
	assert_that(parser.error_message.text.byte_length == 0);
	var bad_source = program.arena.add_source_text("bad-probe", "A<B @;", false);
	var bad_root = program.arena.source(bad_source);
	var bad_scanner = lexer(move bad_root);
	var bad_empty = syntax_text("");
	var bad_prefix = syntax_text("");
	var bad = new SyntaxParser(program.arena, bad_source, move bad_scanner, move bad_empty, move bad_prefix);
	assert_that(bad.advance(program.arena) && bad.advance(program.arena));
	assert_that(bad.next_is(program.arena, TokenKind.IDENTIFIER()));
	var bad_before = program.arena.checkpoint();
	assert_that(!bad.begins_generic_call(program.arena));
	var bad_after = program.arena.checkpoint();
	assert_that(bad_before.used == bad_after.used && bad_before.tokens == bad_after.tokens && bad_before.lists == bad_after.lists);
	assert_that(bad.error_message.text.byte_length == 0);
	assert_that(bad.advance(program.arena));
	assert_that(!bad.advance(program.arena));
	assert_that(bad.error_span.start == 4 && bad.error_span.end == 5 && bad.error_message.text == "unexpected character '@'");
	println("PARSER_CURSOR_OK");
}
