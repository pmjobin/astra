using Left;
int main() {
	var first = new Record(7);
	var second = new Right.Record(9);
	if (measure(first) != 7 || Right.measure(second) != 18) { return 1; }
	if (Left.adjustment != 11 || Right.adjustment != 17 || adjustment != 11) { return 2; }
	consume(move first); Right.consume(move second);
	return 0;
}
