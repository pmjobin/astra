struct Bag { int tag; owned R r; }

int work() throws Error {
	Bag bag = {tag=42, r=make(26)};
	var moved = move bag;
	Bag final = move moved;
	if (final.tag != 42 || live() != 1) return 81;
	mark(260);
	checked(true, 261);
	return final.tag;
}

int main() {
	try { work(); } catch (Error error) {
		if (live() != 0 || record_errors() != 1 || error.message != "checked\0é") return 82;
		mark(262);
	}
	if (record_errors() != 0) return 83;
	return 42;
}
