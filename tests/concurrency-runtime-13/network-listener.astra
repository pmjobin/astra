extern(C) int listener_oracle_start(int port, int clients, int seed);
extern(C) int listener_oracle_guard();
extern(C) int listener_oracle_guard_close();
extern(C) int listener_oracle_finish(int clients);

async int serve_connection(owned TcpSocket socket, int seed) throws Error {
	var bytes = new u8[4096];
	int started = astra_net_milliseconds();
	int used = 0;
	while (used < len(bytes)) {
		int count = len(bytes) - used;
		if (count > 29) { count = 29; }
		int progress = socket.try_read(bytes, used, count);
		if (progress > 0) { used = used + progress; }
		else {
			if (progress == 0) { throw new Error("early client EOF"); }
			network_deadline(started, 10000); await delay_ticks(1);
		}
	}
	int id = bytes[4] as int;
	if (id < 1 || id > 8) { throw new Error("invalid client identity"); }
	for (int frame = 0; frame < 4; frame = frame + 1) {
		int base = frame * 1024;
		if (bytes[base] != 0 || bytes[base + 1] != 0 || bytes[base + 2] != 3 || bytes[base + 3] != 252) { throw new Error("invalid frame extent"); }
		for (int i = 0; i < 1020; i = i + 1) {
			int expected = (id * 17 + seed + frame * 31 + i) % 251;
			if (i == 0) { expected = id; }
			if (i == 1) { expected = 0; }
			if (i == 2) { expected = 195; }
			if (i == 3) { expected = 169; }
			if (bytes[base + 4 + i] != expected as u8) { throw new Error("request byte corruption"); }
		}
	}
	bool bounds = false;
	try { int ignored = socket.try_read(bytes, -1, 1); }
	catch (SocketError error) { if (error.code != -22) { throw; } bounds = true; }
	if (!bounds) { throw new Error("missing buffer bound check"); }
	// Preserve an immutable UTF-8 snapshot from the actual received frame.
	var label = new u8[3];
	label[0] = bytes[5]; label[1] = bytes[6]; label[2] = bytes[7];
	var message = utf8_message(label);
	label[1] = 120;
	release label;
	if (message.text != "\0é" || message.text.byte_length != 3) { throw new Error("UTF-8 snapshot changed"); }
	int sent = 0;
	while (sent < len(bytes)) {
		int count = len(bytes) - sent;
		if (count > 31) { count = 31; }
		int progress = socket.try_write(bytes, sent, count);
		if (progress > 0) { sent = sent + progress; }
		else { network_deadline(started, 10000); await delay_ticks(1); }
	}
	socket.half_close();
	while (true) {
		int progress = socket.try_read(bytes, 0, 1);
		if (progress == 0) { break; }
		if (progress > 0) { throw new Error("trailing client bytes"); }
		network_deadline(started, 10000); await delay_ticks(1);
	}
	return id;
}

async void refused_connection() throws Error {
	int port = listener_oracle_guard();
	{
		var probe = new TcpSocket(); probe.open();
		bool refused = false;
		try {
			int result = probe.connect(port);
			int started = astra_net_milliseconds();
			while (result == NetAgain || result == NetInterrupted) {
				if (probe.ready(true) == 1) { probe.connected(); break; }
				network_deadline(started, 10000); await delay_ticks(1);
			}
		} catch (SocketError error) { if (error.code != -111) { throw; } refused = true; }
		if (!refused) { throw new Error("missing refused connection"); }
	}
	listener_oracle_guard_close();
}
