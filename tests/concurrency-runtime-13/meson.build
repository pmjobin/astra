concurrency_atomic_proof = executable('astra-concurrency-atomic-proof', ['atomic-contracts.vala', '../../bootstrap/backend/llvm/capi/llvm-test.vapi'], dependencies: llvm_backend_dependency, vala_args: frontend_vala_args, c_args: frontend_c_args)
test('concurrency-runtime-13-atomic-contracts', concurrency_atomic_proof, args: ['--tap'], protocol: 'tap')
