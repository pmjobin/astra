T recurse<T>(int count,T a,T b){if(count==0) return a;return recurse(count-1,b,a);}

T left<T>(int count,T a){if(count==0) return a;return right(count-1,a);}

T right<T>(int count,T a){return left(count,a);}

int main(){if(recurse(4,42,1)==42 && recurse(3,1.0d,2.5d)==2.5d && left(5,42)==42) return 0;return 1;}
