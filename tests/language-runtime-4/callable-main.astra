	if (astra_fn_qualified(5) != 118 || astra_fn_half(9.5) != 4.75) { return 85; }
	if (astra_fn_exported(7) != 106) { return 86; }
	if (astra_fn_assigned(0, 5) != 12 || astra_fn_assigned(1, 5) != 15 || astra_fn_four() != 85) { return 87; }
	if (astra_fn_shadow(5) != 15 || astra_fn_direct_argument(5) != 19) { return 88; }
