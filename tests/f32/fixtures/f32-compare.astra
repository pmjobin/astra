bool eq(f32 a, f32 b) { return a == b; }

bool ne(f32 a, f32 b) { return a != b; }

bool lt(f32 a, f32 b) { return a < b; }

bool le(f32 a, f32 b) { return a <= b; }

bool gt(f32 a, f32 b) { return a > b; }

bool ge(f32 a, f32 b) { return a >= b; }

f32 nan(f32 x) { return x / x; }

int main() {
	f32 n = nan(0.0);
	if (eq(n, n)) return 1;
	if (!ne(n, n)) return 1;
	if (lt(n, n)) return 1;
	if (le(n, n)) return 1;
	if (gt(n, n)) return 1;
	if (ge(n, n)) return 1;
	if (eq(n, n)) return 1;
	if (!ne(n, n)) return 1;
	if (lt(n, n)) return 1;
	if (le(n, n)) return 1;
	if (gt(n, n)) return 1;
	if (ge(n, n)) return 1;
	if (eq(n, 1.0)) return 1;
	if (!ne(n, 1.0)) return 1;
	if (lt(n, 1.0)) return 1;
	if (le(n, 1.0)) return 1;
	if (gt(n, 1.0)) return 1;
	if (ge(n, 1.0)) return 1;
	if (eq(1.0, n)) return 1;
	if (!ne(1.0, n)) return 1;
	if (lt(1.0, n)) return 1;
	if (le(1.0, n)) return 1;
	if (gt(1.0, n)) return 1;
	if (ge(1.0, n)) return 1;
	if (eq(n, 1e100)) return 1;
	if (!ne(n, 1e100)) return 1;
	if (lt(n, 1e100)) return 1;
	if (le(n, 1e100)) return 1;
	if (gt(n, 1e100)) return 1;
	if (ge(n, 1e100)) return 1;
	if (eq(1e100, n)) return 1;
	if (!ne(1e100, n)) return 1;
	if (lt(1e100, n)) return 1;
	if (le(1e100, n)) return 1;
	if (gt(1e100, n)) return 1;
	if (ge(1e100, n)) return 1;
	if (eq(n, 0.0)) return 1;
	if (!ne(n, 0.0)) return 1;
	if (lt(n, 0.0)) return 1;
	if (le(n, 0.0)) return 1;
	if (gt(n, 0.0)) return 1;
	if (ge(n, 0.0)) return 1;
	if (eq(0.0, n)) return 1;
	if (!ne(0.0, n)) return 1;
	if (lt(0.0, n)) return 1;
	if (le(0.0, n)) return 1;
	if (gt(0.0, n)) return 1;
	if (ge(0.0, n)) return 1;
	if (!eq(0.0, -0.0) || ne(0.0, -0.0) || !lt(-1.0, 0.0) || !le(1.0, 1.0) || !gt(2.0, 1.0) || !ge(1.0, 1.0)) return 2;
	return 0;
}
