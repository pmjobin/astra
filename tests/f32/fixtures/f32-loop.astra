// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
f32 accumulate(int n, f32 step) {
	f32 x = 0.0;
	int i = 0;
	while (i < n) { x = x + step; i = i + 1; }
	return x;
}
int main() {
	if (accumulate(0, 0.5) != 0.0 || accumulate(100, 0.5) != 50.0 || accumulate(8, 2.0) != 16.0) { return 1; }
	return 0;
}
