f32 add(f32 a, f32 b) { return a + b; }

f32 unfused(f32 a, f32 b, f32 c) { return a * b + c; }

f32 left(f32 a, f32 b, f32 c) { return (a + b) + c; }

f32 right(f32 a, f32 b, f32 c) { return a + (b + c); }

int main() {
	f32 x = 16777216.0;
	f32 y = add(x, 1.0);
	if (y != 16777216.0 || add(x, 2.0) != 16777218.0) return 1;
	if (unfused(1.00000011920928955078125, 0.99999988079071044921875, -1.0) != 0.0) return 2;
	if (left(x, 1.0, -x) != 0.0 || right(x, 1.0, -x) != 1.0) return 3;
	return 0;
}
