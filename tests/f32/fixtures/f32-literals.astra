f32 zero() { return 0.0; }
f32 negative_zero() { return -0.0; }
f32 one() { return 1.0; }
f32 negative_one() { return -1.0; }
f32 half() { return 0.5; }
f32 two() { return 2.0; }
f32 subnormal() { return 1.401298464324817e-45; }
f32 normal() { return 1.1754943508222875e-38; }
f32 maximum() { return 3.4028234663852886e38; }
f32 infinity() { return 1e100; }
f32 underflow() { return 1e-100; }
f32 tie_down() { return 1.000000059604644775390625; }
f32 tie_up() { return 1.000000178813934326171875; }
int main() {
	if (zero() != -0.0 || negative_zero() != 0.0 || one() != 1.00 || negative_one() != -10e-1) { return 1; }
	if (half() != 0.5 || two() != 2.0 || subnormal() == 0.0 || normal() <= subnormal()) { return 2; }
	if (maximum() >= infinity() || underflow() != 0.0 || tie_down() != 1.0 || tie_up() != 1.0000002384185791015625) { return 3; }
	if (1e3 != 1E3 || 1.25e-4 != 0.000125 || 123.456E+7 != 1234560000.0) { return 4; }
	return 0;
}
