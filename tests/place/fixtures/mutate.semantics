(program
	(function "mutate" -> int
		(parameters
			(parameter #0 "x" : int)
		)
		(locals
			(local #0 "y" : int)
		)
		(block
			(local-init #0 "y" : int (binary + : int (parameter-ref #0 "x" : int) (integer 1 : int)))
			(assign (local-ref #0 "y" : int) (binary * : int (local-ref #0 "y" : int) (integer 2 : int)))
			(return (local-ref #0 "y" : int))
		)
	)
)
