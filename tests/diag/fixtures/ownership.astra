extern(C) int diag_mark(int event);

class State {
	owned int[] data;

	init(string[] args) { this.data = new int[len(args)]; diag_mark(67); }

	deinit() { diag_mark(99); }
}

void consume<T>(owned T value, [CallerArgumentExpression("value")] string expression) where T:Ownable {
	if (expression != "move moving") diag_mark(63);
	diag_mark(85);
}

int main(string[] args) {
	diag_mark(69);
	owned Resource moving = diag_acquire();
	consume(move moving);
	// Moved owners are unavailable to source reads; lowering nulls the slot.
	owned Resource remaining = diag_acquire();
	owned State state = State.init(args);
	assert_message(args[1] == "ok", args[1]);
	diag_mark(77);
	return 0;
}
