extern(C) int mark(int x);

int mark_int(int x) { return mark(x); }

f64 mark_float(f64 x) { mark(2); return x; }

int consume(f64 a, int b, int c) {
	mark(4);
	if (a != 1.0d || b != 2 || c != 3) return 1;
	return 0;
}

int main() { return consume(mark_int(1) as f64, mark_float(2.5d) as int, mark_int(3)); }
