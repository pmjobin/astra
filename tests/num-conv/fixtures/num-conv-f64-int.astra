// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
i8 convert_i8(f64 x) { return x as i8; }

u8 convert_u8(f64 x) { return x as u8; }

i16 convert_i16(f64 x) { return x as i16; }

u16 convert_u16(f64 x) { return x as u16; }

int convert_int(f64 x) { return x as int; }

u32 convert_u32(f64 x) { return x as u32; }

int main() {
	if (convert_i8(7.9d) != 7) return 1;
	if (convert_u8(7.9d) != 7) return 2;
	if (convert_i16(7.9d) != 7) return 3;
	if (convert_u16(7.9d) != 7) return 4;
	if (convert_int(7.9d) != 7) return 5;
	if (convert_u32(7.9d) != 7) return 6;
	return 0;
}
