// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
f64 convert_i8(i8 x) { return x as f64; }
f64 convert_u8(u8 x) { return x as f64; }
f64 convert_i16(i16 x) { return x as f64; }
f64 convert_u16(u16 x) { return x as f64; }
f64 convert_int(int x) { return x as f64; }
f64 convert_u32(u32 x) { return x as f64; }
int main() {
	i8 x0 = 7;
	if (convert_i8(x0) != 7.0d) { return 1; }
	u8 x1 = 7;
	if (convert_u8(x1) != 7.0d) { return 2; }
	i16 x2 = 7;
	if (convert_i16(x2) != 7.0d) { return 3; }
	u16 x3 = 7;
	if (convert_u16(x3) != 7.0d) { return 4; }
	int x4 = 7;
	if (convert_int(x4) != 7.0d) { return 5; }
	u32 x5 = 7;
	if (convert_u32(x5) != 7.0d) { return 6; }
	return 0;
}
