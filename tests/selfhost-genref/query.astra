int main(string[] args) {
	if (len(args) < 2 || args[1] != "--classstorage-genref-data") return callplace_cli(args);
	try {
		assert_that(len(args) >= 5 && (args[2] == "O0" || args[2] == "O2"));
		var source = binding_load_program(args, 4); var bindings = binding_index(move source, 0);
		var out = new Utf8ByteBuilder(); genref_binding_data(bindings, "B", out); var before = out.snapshot(); print(before.text);
		var checked = checked_build_profile(move bindings, 0, true, true, true, true, true);
		genref_checked_data(checked); genref_extra_data(checked); return 0;
	} catch (Error error) { println_stderr(error.message); return 2; }
}
