struct K { int n; int choose(int value) { return this.n + value; } }
class C {
	owned K[] a;
	owned K[] b;
	init() { this.a = new K[1]; this.b = new K[2]; this.a[0].n = 13; this.b[0].n = 29; }
	int rotate() { swap(this.a, this.b); return 0; }
}
int take_snapshot(K value, int ignored) { return value.n + ignored; }
int main() {
	var c = C.init();
	var result = take_snapshot(c.a[0], c.rotate());
	if (result != 13 || len(c.a) != 2 || c.a[0].n != 29 || c.b[0].n != 13) { return 1; }
	return 0;
}
