// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
owned R open_resource(int n) { var result = resource(n); return move result; }
void consume(owned R value) { mark(id(value)); }
int main() {
	var handle = open_resource(1);
	handle = open_resource(2);
	var moved = move handle;
	consume(move moved);
	handle = open_resource(3);
	release handle;
	return 0;
}
