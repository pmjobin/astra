// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
int answer() { return 10; }
int main() {
	var count = 1;
	var a = count as i8;
	var b = count as u8;
	var c = count as i16;
	var d = count as u16;
	var e = count as u32;
	var ready = true;
	var result = answer();
	count = 2;
	if (ready && count == 2 && a == 1 && b == 1 && c == 1 && d == 1 && e == 1 && result == 10) { return 0; }
	return 1;
}
