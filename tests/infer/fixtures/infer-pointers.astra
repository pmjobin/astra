struct Point { int x; }

int main() {
	var raw = pointer();
	var copied = raw;
	var zero = null;
	int value = 7;
	f64 wide = 2.5d;
	Point point = { x = 3 };
	var p = &value;
	var q = &wide;
	var r = &point;
	var read = *p;
	if (raw == copied && zero == null && read == 7 && *q == 2.5d && r->x == 3) return 0;
	return 1;
}
