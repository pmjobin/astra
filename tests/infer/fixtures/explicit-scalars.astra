// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
int answer() { return 10; }

int main() {
	int count = 1;
	i8 a = count as i8;
	u8 b = count as u8;
	i16 c = count as i16;
	u16 d = count as u16;
	u32 e = count as u32;
	bool ready = true;
	int result = answer();
	count = 2;
	if (ready && count == 2 && a == 1 && b == 1 && c == 1 && d == 1 && e == 1 && result == 10) return 0;
	return 1;
}
