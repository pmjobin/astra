int main() {
	var lanes = splat(7, 4);
	var samples = splat(1.5f, 4);
	var mask = lanes == lanes;
	var selected = select(mask, lanes, lanes);
	var all_lanes = all(mask);
	if (all_lanes && selected[3] == 7 && samples[2] == 1.5f) { return 0; }
	return 1;
}
