int main() {
	int<4> lanes = splat(7, 4);
	f32<4> samples = splat(1.5f, 4);
	bool<4> mask = lanes == lanes;
	int<4> selected = select(mask, lanes, lanes);
	bool all_lanes = all(mask);
	if (all_lanes && selected[3] == 7 && samples[2] == 1.5f) { return 0; }
	return 1;
}
