struct Pair {
	int x;
	int y;
}

bool same(Pair* a, Pair* b) {
	return a == b;
}

void set_two(Pair* a, Pair* b) {
	a->x = 1;
	b->x = 2;
}

int increment(Pair* p) {
	p->x = p->x + 1;
	return p->x;
}

int main() {
	Pair p = { x = 0, y = 10 };
	Pair q = { y = 20, x = 0 };
	set_two(&p, &p);
	if (p.x != 2 || !same(&p, &p)) {
		return 1;
	}
	if (same(&p, &q)) {
		return 2;
	}
	set_two(&p, &q);
	if (p.x != 1 || q.x != 2 || p.y != 10 || q.y != 20) {
		return 3;
	}
	// An earlier direct read must not move across a later borrowing call.
	int result = p.x * 10 + increment(&p);
	if (result != 12 || p.x != 2) {
		return 4;
	}
	return 0;
}
