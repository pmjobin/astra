struct Pair {
	int x;
	int y;
}

int first(Pair* log) {
	log->x = log->x * 10 + 1;
	return 3;
}

int second(Pair* log) {
	log->x = log->x * 10 + 2;
	return 4;
}

int consume(int a, Pair* p, int b) {
	p->x = p->x + a + b;
	return p->x;
}

int change(Pair* p) {
	p->x = 9;
	return 2;
}

int indirect_order(Pair* p) {
	return p->x * 10 + change(p);
}

int main() {
	Pair log = { x = 0, y = 0 };
	Pair p = { y = second(&log), x = first(&log) };
	if (log.x != 21 || p.x != 3 || p.y != 4) {
		return 1;
	}
	log.x = 0;
	if (consume(first(&log), &p, second(&log)) != 10 || log.x != 12) {
		return 2;
	}
	if (indirect_order(&p) != 102 || p.x != 9) {
		return 3;
	}
	// Capture both field read and address borrow before a later call.
	if (consume(p.x, &p, change(&p)) != 20) {
		return 4;
	}
	return 0;
}
