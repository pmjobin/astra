int main(string[] args) {
	try {
		int start = 1; if (len(args) > 1 && args[1] == "--generic-mutations") start = 2;
		var source = binding_load_program(args, start); var bindings = binding_index(move source, 0);
		var checked = checked_build_nativeabi(move bindings, 0);
		if (!checked.failed()) {
			var plans = generic_observation(checked);
			print(plans.text);
		}
		var flow = flow_index(move checked, 8192, 1000000); if (start == 2) {
			generic_mutations(flow);
			return 0;
		}
		var observation = flow_observation(flow); print(observation.text); return flow_status(flow);
	} catch (Error error) { println_stderr(error.message); return 2; }
}
