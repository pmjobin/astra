bool less(int a, int b) { return a < b; }
bool less_equal(int a, int b) { return a <= b; }
bool greater(int a, int b) { return a > b; }
bool greater_equal(int a, int b) { return a >= b; }
bool equal(int a, int b) { return a == b; }
bool unequal(int a, int b) { return a != b; }
bool bool_equal(bool a, bool b) { return a == b; }
bool bool_unequal(bool a, bool b) { return a != b; }
bool negate(bool a) { return !a; }
