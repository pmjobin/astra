bool guarded(void* p) {
	return p != null && guarded_handle_a(p) != 0;
}

int main() {
	if (guarded(null)) { return 1; }
	if (predicate_calls() != 0) { return 2; }
	if (!guarded(handle_a())) { return 3; }
	if (predicate_calls() != 1) { return 4; }
	void* p = null;
	int i = 0;
	while (i < 4) {
		i = i + 1;
		if (p == null) {
			p = handle_a();
			continue;
		}
		if (p != null && guarded_handle_a(p) != 0) {
			break;
		}
		return 5;
	}
	if (i != 2) { return 6; }
	if (predicate_calls() != 2) { return 7; }
	if (p != handle_a()) { return 8; }
	return 0;
}
