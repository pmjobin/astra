int main() {
	void* a = handle_a();
	void * b = handle_b();
	void    * copy = a;
	if (is_handle_a(copy) == 0) return 1;
	if (is_handle_b(b) == 0) return 2;
	if (handle_a() != handle_a()) return 3;
	if (!(handle_a() != handle_b())) return 4;
	if (a == null) return 5;
	if (null == b) return 6;
	copy = null;
	if (is_null(copy) == 0) return 7;
