[CImport(name="com16_exception_retired")]int retired();
[ExceptionRoot]class Fault{
	readonly string text;private int status;private int domain;
	init(int domain,int status){this.domain=domain;this.status=status;this.text="COM failure";}
	virtual property string message{get{return this.text;}}
	int code(){return this.status;}int space(){return this.domain;}
	deinit(){retired();}
}
owned Fault foreign_fault(int domain,int status){var error=new Fault(domain,status);return move error;}
[COMImport(name="query16",iid="2c2d4a08-a483-4ace-9e01-f6793e47f101",threading="constructing",profile="declarations-v1")]
interface IQuery {
	[Foreign(error_factory="foreign_fault",error_domain="16",errors="Fault=-1600")]init(borrowed void* unknown) throws Fault;
	[Foreign(error_factory="foreign_fault",error_domain="16",errors="Fault=-1600")]i64 transform(i64 input,f64 bias,bool enabled) throws Fault;
	[Foreign(error_factory="foreign_fault",error_domain="16",errors="Fault=-1600")]property f64 gain throws Fault {get;set(f64 input);}
	[Foreign(error_factory="foreign_fault",error_domain="16",errors="Fault=-1600")]bool choose(bool input,borrowed Callback<bool,bool> code) throws Fault;
}
[COMImport(name="detail16",iid="2c2d4a08-a483-4ace-9e01-f6793e47f102",threading="constructing",profile="declarations-v1")]
interface IDetail : IQuery {
	[Foreign(error_factory="foreign_fault",error_domain="16",errors="Fault=-1600")]init(borrowed void* unknown) throws Fault;
	[Foreign(error_factory="foreign_fault",error_domain="16",errors="Fault=-1600")]u64 stamp(u64 input) throws Fault;
}
bool invert(bool value){return !value;}
struct ComSample { bool enabled; bool marked; int count; f64 scale; u64 stamp; f32 weight; u32 flags; i64 offset; }
[COMImport(name="records16",iid="2c2d4a08-a483-4ace-9e01-f6793e47f103",threading="constructing",profile="declarations-v1")]
