export(C)int catalog16_native_run(){try{
		var index=new Lens16.Catalog();var missing=index.last;if(missing!=null || index.requests!=0 || !index.enabled || index.description.byte_length!=15){return 1;}
		LensCore16.Query query={ceiling=10.0,minimum=0,cap=0,mask=7,lowest=true};var answer=index.lookup(query);if(!answer.found || answer.code!=59 || answer.score!=1.75 || answer.matches!=3){return 2;}var held=index.last;if(held==null || held.code!=59){return 3;}
		index.bias=1.0;query.ceiling=3.0;query.mask=3;query.lowest=false;var absent=index.resolve(query);if(absent!=null || index.requests!=2){return 4;}
		index.bias=0.0;query.minimum=20;query.ceiling=10.0;query.mask=7;var found=index.resolve(query);if(found==null || found.code!=31 || found.score!=5.5 || index.requests!=3 || index.rank(held,found)!=1){return 5;}
		query.minimum=-1;try{var ignored=index.lookup(query);return 6;}catch(LensCore16.Fault fault){}
		query.minimum=0;index.enabled=false;try{var ignored=index.lookup(query);return 7;}catch(LensCore16.Fault fault){}
		release index;if(held.code!=59 || found.code!=31){return 8;}
	}catch(LensCore16.Fault fault){return 90;}return 0;}
