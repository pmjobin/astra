namespace Propertyless16;
[Shared][CExport(name="propertyless16",profile="declarations-v1",bool_abi="c99")]
[GObjectExport(type="Propertyless16Worker",namespace="Propertyless16",version="2.8",profile="declarations-v1")]
class Worker{
	[Foreign]init(){}

	[Foreign]i64 apply(i64 input,f64 scale,bool negate){i64 result=input+scale as i64;if(negate) return -result;return result;}
}
