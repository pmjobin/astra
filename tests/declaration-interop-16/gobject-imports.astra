export(C) int gi16_run(){try{var value=Ledger.init(7,true,2.5);Sample sample={count=12,scale=1.25,enabled=true,mask=4000000000,stamp=9,weight=0.5};var adjusted=value.adjust(sample,0);if(adjusted.count!=19 || adjusted.scale!=3.125 || adjusted.enabled || adjusted.mask!=4000000000 || adjusted.stamp!=10 || adjusted.weight!=1.0){return 50;}int record_mode=1;while(record_mode<3){try{var ignored=value.adjust(sample,record_mode);return 51;}catch(Fault fault){int expected=-1600;if(record_mode==2){expected=-2147418113;}if(fault.code()!=expected){return 52;}}record_mode=record_mode+1;}Pair<f64> pair={first=1.5,second=2};var paired=value.pair(pair);if(paired.first!=4.0 || paired.second!=9){return 53;}i64 expected_fold=-999999983;i64 expected_ref=-4999999995;i64 expected_input=-5000000000;if(value.fold(-5000000000,4000000000,1.25,9)!=expected_fold){return 1;}value.gain=3.5;if(value.gain!=3.5 || !value.choose(true) || value.choose(false)){return 2;}if(value.visit(true,invert) || !value.visit(false,invert) || !value.optional_visit(true,null)){return 12;}var environment=new CallbackEnvironment(true);var captured=closure_bind(move environment,captured_flip);if(value.visit(true,captured) || !value.visit(false,captured)){return 54;}value.deliver(1.25,sink);if(value.evaluate(2.0)!=7.0){return 3;}var item=Item.init(5);var copy=value.duplicate(item);if(value.inspect(item)!=5 || copy.code()!=5){return 40;}var missing=value.lookup(false,item);var found=value.lookup(true,item);if(missing!=null || found==null || found.code()!=5){return 41;}var made=value.make(0);if(made.code()!=41){return 42;}int object_mode=1;while(object_mode<4){try{var ignored=value.make(object_mode);return 43;}catch(Fault fault){int expected=-1600;if(object_mode==2){expected=-2147418113;}if(object_mode==3){expected=-2147467262;}if(fault.code()!=expected){return 44;}}object_mode=object_mode+1;}object_mode=0;while(object_mode<2){var consumed=Item.init(10+object_mode);try{if(value.take(move consumed,object_mode)!=10 || object_mode==1){return 45;}}catch(Fault fault){if(object_mode!=1 || fault.code()!=-1600){return 46;}}object_mode=object_mode+1;}u8[3] bytes={1,0,254};if(value.digest(slice(bytes))!=255){return 20;}var snapshot=value.snapshot(slice(bytes),0);if(len(snapshot)!=3 || snapshot[0]!=84 || snapshot[1]!=85 || snapshot[2]!=171){return 21;}int payload_mode=1;while(payload_mode<3){try{var ignored=value.snapshot(slice(bytes),payload_mode);return 22;}catch(Fault fault){int expected=-1600;if(payload_mode==2){expected=-2147418113;}if(fault.code()!=expected){return 23;}}payload_mode=payload_mode+1;}var text=value.text(0);if(len(text)!=4 || text[0]!=97 || text[1]!=0 || text[2]!=195 || text[3]!=169){return 24;}try{var ignored=value.text(1);return 25;}catch(Fault fault){if(fault.code()!=-2147024809){return 26;}}var terminated=value.terminated();var empty_text=value.terminated_empty();if(len(terminated)!=5 || terminated[0]!=99 || terminated[3]!=195 || terminated[4]!=169 || len(empty_text)!=0){return 31;}if(value.measure("café","a\0é")!=9){return 27;}u8[4] output={77,77,77,77};if(value.transform(slice(bytes),slice(output),0)!=3 || output[0]!=2 || output[1]!=1 || output[2]!=255 || output[3]!=77){return 28;}if(value.bounded(slice(bytes),slice(output),4,0)!=3){return 32;}payload_mode=1;while(payload_mode<5){output[0]=77;try{var ignored=value.transform(slice(bytes),slice(output),payload_mode);return 29;}catch(Fault fault){int expected=-2147418113;if(payload_mode==1){expected=-1600;}if(fault.code()!=expected || output[0]!=77 || output[3]!=77){return 30;}}payload_mode=payload_mode+1;}i64 input=-5000000000;f64 scale=2.5;u32 count=99;if(value.refs(&input,&scale,&count,false)!=expected_ref || input!=expected_input || scale!=4.0 || count!=4000000000){return 4;}scale=2.5;count=99;try{var ignored=value.refs(&input,&scale,&count,true);return 5;}catch(Fault fault){if(fault.code()!=-1600 || fault.space()!=16 || input!=expected_input || scale!=2.5 || count!=0){return 6;}}try{var ignored=value.evaluate(-1.0);return 7;}catch(Fault fault){if(fault.code()!=-1600 || fault.space()!=16){return 8;}}}catch(Fault fault){return 90;}int mode=-1;while(mode>=-4){try{var bad=Ledger.init(mode,true,2.5);return 10;}catch(Fault fault){int expected=-2147467262;int domain=0;if(mode==-1){expected=-1600;domain=16;}if(mode==-2){expected=-2147418113;}if(fault.code()!=expected || fault.space()!=domain){return 11;}}mode=mode-1;}return 0;}

