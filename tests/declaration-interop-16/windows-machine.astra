[CExport(name="machine16",profile="declarations-v1",bool_abi="c99")]
class Machine {
	[Foreign]init(){}
	[Foreign]f32 half32(f32 input){return input*0.5;}
	[Foreign]f64 half64(f64 input){return input*0.5;}
	[Foreign]bool flip(bool input){return !input;}
	[Foreign]i64 signed64(i64 input){return input+7;}
	[Foreign]u64 unsigned64(u64 input){return input+7;}
}
