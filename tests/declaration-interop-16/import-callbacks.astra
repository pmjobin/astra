i64 transform(i32 a,u32 b,i64 c,u64 d,f32 e,f64 f,bool g){u32 large32=4000000000;i64 negative=-5000000000;u64 large64=9223372036854775809;f32 single=1.25;if(a!=10 || b!=large32 || c!=negative || d!=large64 || e!=single || f!=2.5 || !g){return 0;}return c+21;}
