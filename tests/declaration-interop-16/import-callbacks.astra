[ExceptionRoot] class Fault {
	readonly string text;
	private int domain;
	private int status;
	init(int domain, int status) { this.domain = domain; this.status = status; this.text = "foreign provider failure"; }
	virtual property string message { get { return this.text; } }
	int code() { return this.status; }
	int space() { return this.domain; }
	deinit() { retired(); }
}
owned Fault foreign_fault(int domain, int status) { var fault = new Fault(domain,status); return move fault; }
