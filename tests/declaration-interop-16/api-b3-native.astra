export(C)int orbit16_native_run(){try{
		var index=new Orbit16.Directory();var missing=index.last;if(missing!=null || index.requests!=0 || !index.enabled || index.description.byte_length!=15){return 1;}
		OrbitCore16.Probe query={boost=0.0,ceiling=10.0,minimum=0,cap=0,mask=7,lowest=true};var answer=index.scan(query);if(!answer.found || answer.code!=83 || answer.score!=0.5 || answer.matches!=3){return 2;}var held=index.last;if(held==null || held.code!=83){return 3;}
		index.bias=1.0;query.ceiling=3.0;query.mask=3;query.lowest=false;var absent=index.entry_for(query);if(absent!=null || index.requests!=2){return 4;}
		index.bias=0.0;query.minimum=30;query.ceiling=10.0;query.mask=7;var found=index.entry_for(query);if(found==null || found.code!=47 || found.score!=6.25 || index.requests!=3 || index.order(held,found)!=1){return 5;}
		query.minimum=-1;try{var ignored=index.scan(query);return 6;}catch(OrbitCore16.Fault fault){}
		query.minimum=0;index.enabled=false;try{var ignored=index.scan(query);return 7;}catch(OrbitCore16.Fault fault){}
		release index;if(held.code!=83 || found.code!=47){return 8;}
	}catch(OrbitCore16.Fault fault){return 90;}return 0;}
