interface IOpaque16{
	[Foreign(error_factory="WinUnit16.foreign_fault",error_domain="16",errors="WinUnit16.Fault=-1600")]init(borrowed void* unknown)throws WinUnit16.Fault;
	[Foreign(native="count",error_factory="WinUnit16.foreign_fault",error_domain="16",errors="WinUnit16.Fault=-1600")]property int count throws WinUnit16.Fault{get;set(int input);}
