namespace Orbit16;
owned OrbitCore16.Fault foreign_fault(int domain,int status){var result=new OrbitCore16.Fault("foreign query failure");return move result;}
[Shared][CExport(name="orbit16",profile="declarations-v1",bool_abi="c99")]
[COMExport(interfaces="IOrbitQuery16,IOrbitMetadata16",threading="constructing",profile="declarations-v1")]
[GObjectExport(type="OrbitTable16Directory",namespace="OrbitTable16",version="5.3",profile="declarations-v1")]
class Directory {
	private owned OrbitCore16.Resolver engine;
	private owned Row last_entry;
	private bool active;private bool last_found;private int calls;private f64 offset;
	[Foreign]init(){var engine=new OrbitCore16.Resolver();this.engine=move engine;var item=new Row(0,0.0);this.last_entry=move item;this.active=true;this.last_found=false;this.calls=0;this.offset=0.0;}
	[Foreign]property int requests{get{return this.calls;}}
	[Foreign]property bool enabled{get{return this.active;}set(bool value){this.active=value;}}
	[Foreign]property f64 bias{get{return this.offset;}set(f64 value){this.offset=value;}}
	[Foreign(personalities="c,gobject")][ForeignChannel(parameter="result",encoding="utf8-nul")]
	property string description{get{return "Stream query λ";}}
	[Foreign(personalities="c,gobject")][ForeignChannel(parameter="result",nullable="true")]
	property owned Row last{get{if(!this.last_found){return null;}var result=clone_entry(this.last_entry);return move result;}}
	[Foreign(error_domain="16",errors="OrbitCore16.Fault=-1620")]
	OrbitCore16.Selection<f32> scan(OrbitCore16.Probe query)throws OrbitCore16.Fault{
		if(!this.active){throw new OrbitCore16.Fault("record index disabled");}
		var result=this.engine.evaluate(query,this.offset);this.calls=this.calls+1;this.last_found=result.found;
		if(result.found){var item=new Row(result.code,result.score as f64);this.last_entry=move item;}
		emit completed(this.calls,result.found,result.score);
		if(result.found){var item=clone_entry(this.last_entry);emit selected(item,"Stream query λ");}
		return result;
	}
	[Foreign(error_domain="16",errors="OrbitCore16.Fault=-1620",null_status="1")][ForeignChannel(parameter="result",nullable="true")]
	owned Row entry_for(OrbitCore16.Probe query)throws OrbitCore16.Fault{var answer=this.scan(query);if(!answer.found){return null;}var result=new Row(answer.code,answer.score as f64);return move result;}
	[Foreign]u64 population(u32 mask){u64 result=0;if((mask&1)!=0){result=result+1;}if((mask&2)!=0){result=result+1;}if((mask&4)!=0){result=result+1;}return result;}
	[Foreign]int order(borrowed Row left,borrowed Row right){if(left.code==right.code){return 0;}if(left.code<right.code){return -1;}return 1;}
	[Foreign]signal void completed(int requests,bool matched,f32 score);
	[Foreign]signal void selected(borrowed Row item,string description);
	deinit(){OrbitCore16.observe_retirement(2);}
}
[Shared][CExport(name="orbit_row16",profile="declarations-v1")]
[COMExport(interfaces="IOrbitRow16",threading="constructing",profile="declarations-v1")]
[GObjectExport(type="OrbitTable16Row",namespace="OrbitTable16",version="5.3",profile="declarations-v1")]
class Row {
	private i64 identifier;private f64 value;
	[Foreign]init(i64 code,f64 score){this.identifier=code;this.value=score;}
	[Foreign]property i64 code{get{return this.identifier;}}
	[Foreign]property f64 score{get{return this.value;}}
	deinit(){OrbitCore16.observe_retirement(3);}
}
owned Row clone_entry(borrowed Row input){var result=input.clone();return move result;}
