}
class BadInput : Fault { init(string text) : base(text) {} }
class PrivateBadInput : BadInput { init(string text) : base(text) {} }
class OtherFault : Fault { init(string text) : base(text) {} }
void check(int mode) throws Fault {
	if (mode == 1) { throw new Fault("base\0é"); }
	if (mode == 2) { throw new BadInput("bad"); }
	if (mode == 3) { throw new PrivateBadInput("private"); }
	if (mode == 4) { throw new OtherFault("other"); }
}
