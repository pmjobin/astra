namespace OrbitCore16;
[CImport(name="orbit16_retired")]int retired(int kind);

void observe_retirement(int kind){retired(kind);}

[ExceptionRoot]class Fault{readonly string text;

	init(string text){this.text=text;}

	virtual property string message{get{return this.text;}}

	deinit(){retired(4);}}

struct Probe{f32 boost;f64 ceiling;i64 minimum;u64 cap;u32 mask;bool lowest;}

struct Selection<T>{T score;i64 code;u32 matches;bool found;u64 visited;}

bool eligible(u32 mask,u32 bit,i64 code,i64 minimum,f64 score,f64 ceiling){return (mask&bit)!=0 && code>=minimum && score<=ceiling;}

class Resolver {
	init(){}

	Selection<f32> evaluate(Probe query,f64 bias)throws Fault{
		if(query.minimum<0 || !(query.ceiling>=0.0 && query.ceiling<=1.7976931348623157e308) || !(bias>=-1000000.0 && bias<=1000000.0) || !(query.boost>=-1024.0 && query.boost<=1024.0)){
			throw new Fault("invalid record query");
		}
		Selection<f32> result={score=0.0,code=0,matches=0,found=false,visited=0};int index=0;
		while(index<3){
			i64 code=23;f64 weight=3.75;u32 bit=1;
			if(index==1){
				code=47;
				weight=6.25;
				bit=2;
			}if(index==2){
				code=83;
				weight=0.5;
				bit=4;
			}
			f32 score=(weight+bias+(query.boost as f64)) as f32;
			result.visited=result.visited+1;
			if(eligible(query.mask,bit,code,query.minimum,score as f64,query.ceiling) && (query.cap==0 || (result.matches as u64)<query.cap)){
				result.matches=result.matches+1;
				if(!result.found || (query.lowest && score<result.score) || (!query.lowest && score>result.score) || (score==result.score && code<result.code)){
					result.code=code;
					result.score=score;
					result.found=true;
				}
			}
			index=index+1;
		}
		return result;
	}

	deinit(){retired(1);}
}
