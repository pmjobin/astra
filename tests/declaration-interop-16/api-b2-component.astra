namespace Lens16;
owned LensCore16.Fault foreign_fault(int domain,int status){var result=new LensCore16.Fault("foreign query failure");return move result;}

[Shared][CExport(name="catalog16",profile="declarations-v1",bool_abi="c99")]
[COMExport(interfaces="ILensQuery16,ILensMetadata16",threading="constructing",profile="declarations-v1")]
[GObjectExport(type="LensCatalog16Catalog",namespace="LensCatalog16",version="4.9",profile="declarations-v1")]
class Catalog {
	private owned LensCore16.Engine engine;
	private owned Entry last_entry;
	private bool active;private bool last_found;private int calls;private f64 offset;

	[Foreign]init(){var engine=new LensCore16.Engine();this.engine=move engine;var item=new Entry(0,0.0);this.last_entry=move item;this.active=true;this.last_found=false;this.calls=0;this.offset=0.0;}

	[Foreign]property int requests{get{return this.calls;}}

	[Foreign]property bool enabled{get{return this.active;}set(bool value){this.active=value;}}

	[Foreign]property f64 bias{get{return this.offset;}set(f64 value){this.offset=value;}}

	[Foreign(personalities="c,gobject")][ForeignChannel(parameter="result",encoding="utf8-nul")]
	property string description{get{return "Record index λ";}}

	[Foreign(personalities="c,gobject")][ForeignChannel(parameter="result",nullable="true")]
	property owned Entry last{get{if(!this.last_found) return null;var result=clone_entry(this.last_entry);return move result;}}

	[Foreign(error_domain="16",errors="LensCore16.Fault=-1620")]
	LensCore16.Answer<f64> lookup(LensCore16.Query query)throws LensCore16.Fault{
		if(!this.active){
			throw new LensCore16.Fault("record index disabled");
		}
		var result=this.engine.evaluate(query,this.offset);this.calls=this.calls+1;this.last_found=result.found;
		if(result.found){
			var item=new Entry(result.code,result.score);
			this.last_entry=move item;
		}
		emit completed(this.calls,result.found,result.score);
		if(result.found){
			var item=clone_entry(this.last_entry);
			emit selected(item,"Record index λ");
		}
		return result;
	}

	[Foreign(error_domain="16",errors="LensCore16.Fault=-1620",null_status="1")][ForeignChannel(parameter="result",nullable="true")]
	owned Entry resolve(LensCore16.Query query)throws LensCore16.Fault{var answer=this.lookup(query);if(!answer.found) return null;var result=new Entry(answer.code,answer.score);return move result;}

	[Foreign]u64 cardinality(u32 mask){u64 result=0;if((mask&1)!=0) result=result+1;if((mask&2)!=0) result=result+1;if((mask&4)!=0) result=result+1;return result;}

	[Foreign]int rank(borrowed Entry left,borrowed Entry right){if(left.code==right.code) return 0;if(left.code<right.code) return -1;return 1;}

	[Foreign]signal void completed(int requests,bool matched,f64 score);

	[Foreign]signal void selected(borrowed Entry item,string description);

	deinit(){LensCore16.observe_retirement(2);}
}

[Shared][CExport(name="catalog_entry16",profile="declarations-v1")]
[COMExport(interfaces="ILensEntry16",threading="constructing",profile="declarations-v1")]
[GObjectExport(type="LensCatalog16Entry",namespace="LensCatalog16",version="4.9",profile="declarations-v1")]
class Entry {
	private i64 identifier;private f64 value;

	[Foreign]init(i64 code,f64 score){this.identifier=code;this.value=score;}

	[Foreign]property i64 code{get{return this.identifier;}}

	[Foreign]property f64 score{get{return this.value;}}

	deinit(){LensCore16.observe_retirement(3);}
}

owned Entry clone_entry(borrowed Entry input){var result=input.clone();return move result;}
