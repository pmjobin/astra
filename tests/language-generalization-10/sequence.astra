extern(C) void usability_event(int value);

struct Point { int x; int y; }

class Token {
	int id;

	init(int id) { this.id = id; usability_event(id); }

	deinit() { usability_event(0 - this.id); }
}

int sum(borrowed int[] values) {
	int result = 0;
	foreach (var value in values) {
		if (value == 4) continue;
		result = result + value;
	}
	return result;
}

int first(borrowed int[] values) {
	foreach (var value in values) {
		var token = new Token(100 + value);
		return value;
	}
	return 0;
}

void checked(borrowed int[] values) throws Error {
	foreach (var value in values) {
		var token = new Token(200 + value);
		if (value == 4) {
			throw new Error("iteration stop");
		}
	}
}

int main() {
	int[3] values = {2, 4, 6};
	int total = 0;
	foreach (var value in values) {
		if (value == 4) continue;
		total = total + value;
		if (value == 6) break;
	}
	usability_event(total);
	var view = slice(values, 1, 2);
	usability_event(sum(view));
	usability_event(first(view));
	var empty = new int[0];
	foreach (var value in empty) { return 1; }
	usability_event(first(empty));
	try { checked(view); }
	catch (Error error) { usability_event(900); }

	Point[2] points = {{x = 3, y = 5}, {x = 7, y = 11}};
	foreach (var point in points) {
		points[0].x = 99;
		usability_event(point.x + point.y);
		point.x = 0;
	}
	if (points[0].x != 99 || points[1].x != 7) return 2;
	var numbers = new int[3];
	for (int i = 0; i < 3; i = i + 1) numbers[i] = i + 1;
	total = 0;
	foreach (var left in numbers) {
		foreach (var right in values) { total = total + left * right; }
	}
	usability_event(total);
	release numbers;
	return 0;
}
