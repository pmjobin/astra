// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
struct Point { int x; int y; }
class Entry {
	int value;
	owned R resource;
	owned int[] bytes;
	init(int value, owned R resource) {
		this.value = value;
		this.resource = move resource;
		this.bytes = new int[2];
	}
	deinit() { usability_event(0 - this.value); }
}
int inspect(Entry entry) { return entry.value; }
bool present(R value) { return value != null; }
int first(Vector<Point> values) {
	foreach (var point in values) { return point.x; }
	return 0;
}
Point detached() {
	var values = new Vector<Point>(0);
	Point original = {x = 17, y = 19};
	bool added = values.append(original);
	foreach (var point in values) { return point; }
	Point empty = {x = 0, y = 0};
	return empty;
}
int exercise() {
	var standalone = detached();
	if (standalone.x != 17 || standalone.y != 19) { return 5; }
	var points = new Vector<Point>(0);
	try {
		var sequence = new Sequence(4, -1);
		foreach (var value in sequence) {
			Point point = {x = value, y = value + 1};
			if (!points.append(point)) { return 1; }
		}
	}
	catch (Error error) { return 2; }
	int[2] weights = {2, 4};
	var view = slice(weights);
	int sum = 0;
	foreach (var point in points) {
		if (point.x == 3) { continue; }
		foreach (var weight in view) { sum = sum + point.x * weight; }
		point.x = 99;
		if (point.y == 8) { break; }
	}
	usability_event(sum);
	usability_event(first(points));
	var copy = points.entries[0];
	if (copy.x != 1) { return 3; }
	var empty = new Vector<Point>(0);
	foreach (var point in empty) { return 4; }
	try {
		var entries = new Vector<Entry>(0);
		var one = make(1);
		var first_entry = new Entry(11, move one);
		var two = make(2);
		var second_entry = new Entry(12, move two);
		bool a = entries.append(move first_entry);
		bool b = entries.append(move second_entry);
		foreach (var entry in entries) {
			usability_event(inspect(entry));
			var guard = make(3);
			throw new Error("container iteration failure");
		}
	}
	catch (Error error) { usability_event(900); }
	var resources = new Vector<R>(0);
	var resource = make(4);
	var absent = make(0);
	bool a = resources.append(move resource);
	bool b = resources.append(move absent);
	int count = 0;
	foreach (var handle in resources) {
		if (present(handle)) { count = count + 1; }
	}
	usability_event(count);
	return 0;
}
int main() {
	int result = exercise();
	if (result != 0) { return result; }
	return live();
}
