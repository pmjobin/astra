class Entry {
	int value;
	owned R resource;
	init(int value, owned R resource) { this.value = value; this.resource = move resource; }
	deinit() { mark(100 + this.value); }
}
struct Pair { int left; int right; }
struct Packet { owned R resource; owned int[] values; int tag; }
int count_entries(Vector<Entry> values) { return values.count(); }
int count_pairs(Vector<Pair> values) { return values.count(); }
owned Vector<Entry> create(int value) {
	var values = new Vector<Entry>(0);
	var resource = make(value);
	var entry = new Entry(value, move resource);
	bool added = values.append(move entry);
	return move values;
}
int exercise() {
	var groups = new Vector<Vector<Entry>>(0);
	var first = create(1);
	var second = create(2);
	bool a = groups.append(move first);
	bool b = groups.append(move second);
	bool room = groups.reserve(9);
	int sum = 0;
	foreach (var group in groups) { sum = sum + count_entries(group); }
	mark(sum);
	var taken = groups.take(0);
	var replacement = create(3);
	groups.replace(0, move replacement);
	var pairs = new Vector<Pair>(0);
	Pair pair = {left = 7, right = 11};
	bool added = pairs.append(pair);
	var nested_pairs = new Vector<Vector<Pair>>(0);
	bool inserted = nested_pairs.append(move pairs);
	foreach (var group in nested_pairs) { mark(count_pairs(group)); }
	var recovered = nested_pairs.take(0);
	var snapshot = recovered.take(0);
	if (snapshot.left != 7 || snapshot.right != 11) { return 81; }
	var packets = new Vector<Packet>(0);
	var resource = make(4);
	var values = new int[2];
	Packet packet = {resource = move resource, values = move values, tag = 41};
	bool saved = packets.append(move packet);
	var nested_packets = new Vector<Vector<Packet>>(0);
	bool recorded = nested_packets.append(move packets);
	var extracted = nested_packets.take(0);
	var result = extracted.take(0);
	mark(result.tag);
	return 0;
}
int main() { int result = exercise(); if (result != 0) { return result; } return live(); }
