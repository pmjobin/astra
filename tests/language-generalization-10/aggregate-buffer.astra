// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
class Item {
	owned R resource;
	int code;
	init(int code) {
		this.resource = make(code);
		this.code = code;
	}
	deinit() { mark(200 + this.code); }
}
struct Cell {
	owned int[] data;
	owned Other resource;
	owned Item child;
	int tag;
}
struct Document {
	Cell first;
	Cell second;
}
struct OnlyBuffers {
	owned int[] numbers;
	owned u8[] bytes;
}
int stage(int failure, int step) throws Error {
	mark(100 + step);
	if (failure == step) { throw new Error("prefix"); }
	return step;
}
owned int[] numbers(int count) {
	var values = new int[count];
	values[0] = count;
	mark(300 + values[0]);
	return move values;
}
owned Item child(int code) {
	var result = new Item(code);
	return move result;
}
int exercise(int failure) {
	try {
		Document document = {
			second = {
				data = numbers(stage(failure, 1)),
				child = child(stage(failure, 2)),
				resource = make_other(stage(failure, 3)),
				tag = stage(failure, 4)
			},
			first = {
				resource = make_other(stage(failure, 5)),
				data = numbers(stage(failure, 6)),
				child = child(stage(failure, 7)),
				tag = stage(failure, 8)
			}
		};
		var moved = move document;
		mark(moved.first.tag + moved.second.tag);
	} catch (Error error) {
		mark(900 + failure);
	}
	return live();
}
int main() {
	{
		var values = new int[3];
		OnlyBuffers only = {bytes = new u8[5], numbers = move values};
		var moved = move only;
	}
	int total = exercise(0);
	for (int failure = 1; failure <= 8; failure = failure + 1) {
		total = total + exercise(failure);
	}
	for (int i = 0; i < 3; i = i + 1) {
		OnlyBuffers only = {numbers = new int[i], bytes = new u8[2]};
		var moved = move only;
		if (i == 0) { continue; }
		if (i == 1) { break; }
	}
	return total + live();
}
