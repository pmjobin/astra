class MetaReading {
	private int hidden;
	int amount;

	init(int amount) { this.hidden = amount + 20; this.amount = amount; }

	property int doubled { get { return this.amount * 2; } }

	int offset(int value) { return this.amount + value; }
}

struct MetaPoint { int x; int y; }

interface MetaTransform { int invoke(int value); }

class MetaPlus : MetaTransform {
	int amount;

	init(int amount) : base() { this.amount = amount; }

	override int invoke(int value) { return value + this.amount; }
}

class UnselectedNativeValue { int private_to_this_program; }
