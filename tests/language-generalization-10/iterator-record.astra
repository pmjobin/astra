extern(C) void usability_event(int value);

struct Pair { int left; int right; }
class RecordSequence {
	int index;
	int limit;
	int failure;
	init(int limit, int failure) { this.index = -1; this.limit = limit; this.failure = failure; }
	bool advance() { this.index = this.index + 1; return this.index < this.limit; }
	Pair current() throws Error {
		if (this.index == this.failure) { throw new Error("current failure"); }
		Pair value = {left = this.index, right = this.index * this.index};
		return value;
	}
	deinit() { usability_event(-100 - this.limit); }
}

int main() {
	try {
		var sequence = new RecordSequence(4, -1);
		int sum = 0;
		foreach (var value in sequence) { sum = sum + value.left + value.right; }
		usability_event(sum);
	}
	catch (Error error) { return 1; }
	try {
		var sequence = new RecordSequence(3, 1);
		foreach (var value in sequence) { usability_event(value.left + 10); }
	}
	catch (Error error) { usability_event(900); }
	return 0;
}
