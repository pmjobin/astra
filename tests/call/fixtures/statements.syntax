(unit
	(function
		(type "void")
		(name "ping")
		(parameters)
		(block
			(return)
		)
	)
	(function
		(type "int")
		(name "value")
		(parameters)
		(block
			(return (integer "1"))
		)
	)
	(function
		(type "void")
		(name "f")
		(parameters)
		(block
			(call-statement (call "ping" (arguments)))
			(call-statement (call "ping" (arguments)))
			(return)
		)
	)
	(function
		(type "void")
		(name "g")
		(parameters)
		(block
			(call-statement (call "value" (arguments)))
			(call-statement (call "value" (arguments)))
			(return)
		)
	)
)
