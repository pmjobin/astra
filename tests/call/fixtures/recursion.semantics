(program
	(function "recurse" -> int
		(parameters
			(parameter #0 "x" : int)
		)
		(block
			(if
				(condition (binary == : bool (parameter-ref #0 "x" : int) (integer 0 : int)))
				(then
					(block
						(return (integer 0 : int))
					)
				)
				(else
					(block
						(return (call "recurse" -> int (arguments (binary - : int (parameter-ref #0 "x" : int) (integer 1 : int)))))
					)
				)
			)
		)
	)
)
