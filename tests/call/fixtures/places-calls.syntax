(unit
	(function
		(type "int")
		(name "make")
		(parameters)
		(block
			(return (integer "1"))
		)
	)
	(function
		(type "int")
		(name "f")
		(parameters)
		(block
			(local (type "int") (name "x") (call "make" (arguments)))
			(assign (name "x") (call "make" (arguments)))
			(return (binary "+" (call "make" (arguments)) (name "x")))
		)
	)
)
