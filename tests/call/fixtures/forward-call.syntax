(unit
	(function
		(type "int")
		(name "first")
		(parameters
			(parameter (type "int") (name "x"))
		)
		(block
			(return (call "second" (arguments (name "x"))))
		)
	)
	(function
		(type "int")
		(name "second")
		(parameters
			(parameter (type "int") (name "x"))
		)
		(block
			(return (binary "+" (name "x") (integer "1")))
		)
	)
)
