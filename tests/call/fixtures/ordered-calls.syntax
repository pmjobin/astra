(unit
	(function
		(type "int")
		(name "left")
		(parameters)
		(block
			(return (integer "1"))
		)
	)
	(function
		(type "int")
		(name "right")
		(parameters)
		(block
			(return (integer "2"))
		)
	)
	(function
		(type "int")
		(name "ordered_binary")
		(parameters)
		(block
			(return (binary "+" (call "left" (arguments)) (call "right" (arguments))))
		)
	)
)
