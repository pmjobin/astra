(core-program
	(function "identity" -> int
		(parameters
			(parameter #0 "x" : int)
		)
		(block
			(return
				(parameter #0 : int)
			)
		)
	)
	(function "pair" -> int
		(parameters
			(parameter #0 "a" : int)
			(parameter #1 "b" : int)
		)
		(block
			(return
				(binary + : int
					(parameter #0 : int)
					(parameter #1 : int)
				)
			)
		)
	)
	(function "ordered" -> int
		(parameters)
		(block
			(return
				(call "pair" -> int
					(arguments
						(call "identity" -> int
							(arguments
								(integer 1 : int)
							)
						)
						(call "identity" -> int
							(arguments
								(integer 2 : int)
							)
						)
					)
				)
			)
		)
	)
)
