(program
	(function "left" -> int
		(parameters)
		(block
			(return (integer 1 : int))
		)
	)
	(function "right" -> int
		(parameters)
		(block
			(return (integer 2 : int))
		)
	)
	(function "ordered_binary" -> int
		(parameters)
		(block
			(return (binary + : int (call "left" -> int (arguments)) (call "right" -> int (arguments))))
		)
	)
)
