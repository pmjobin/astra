(ssa-program
	(function #0 "left" -> int
		(parameters)
		(entry #0)
		(block #0
			(return (integer 1 : int))
		)
	)
	(function #1 "right" -> int
		(parameters)
		(entry #0)
		(block #0
			(return (integer 2 : int))
		)
	)
	(function #2 "ordered_binary" -> int
		(parameters)
		(entry #0)
		(block #0
			(%0 : int = call #0 "left" -> int (arguments))
			(%1 : int = call #1 "right" -> int (arguments))
			(%2 : int = binary + %0 %1)
			(return %2)
		)
	)
)
