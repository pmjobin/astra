(core-program
	(function "first" -> int
		(parameters
			(parameter #0 "x" : int)
		)
		(block
			(return
				(call "second" -> int
					(arguments
						(parameter #0 : int)
					)
				)
			)
		)
	)
	(function "second" -> int
		(parameters
			(parameter #0 "x" : int)
		)
		(block
			(return
				(binary + : int
					(parameter #0 : int)
					(integer 1 : int)
				)
			)
		)
	)
)
