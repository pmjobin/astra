(ssa-program
	(function #0 "name" -> int
		(parameters
			(%0 "x" : int)
		)
		(entry #0)
		(block #0
			(return %0)
		)
	)
	(function #1 "parameter" -> int
		(parameters
			(%0 "name" : int)
		)
		(entry #0)
		(block #0
			(%1 : int = call #0 "name" -> int (arguments %0))
			(return %1)
		)
	)
	(function #2 "local" -> int
		(parameters)
		(entry #0)
		(block #0
			(%0 : int = call #0 "name" -> int (arguments (integer 1 : int)))
			(%1 : int = call #0 "name" -> int (arguments %0))
			(return %1)
		)
	)
)
