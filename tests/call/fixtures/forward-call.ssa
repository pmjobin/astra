(ssa-program
	(function #0 "first" -> int
		(parameters
			(%0 "x" : int)
		)
		(entry #0)
		(block #0
			(%1 : int = call #1 "second" -> int (arguments %0))
			(return %1)
		)
	)
	(function #1 "second" -> int
		(parameters
			(%0 "x" : int)
		)
		(entry #0)
		(block #0
			(%1 : int = binary + %0 (integer 1 : int))
			(return %1)
		)
	)
)
