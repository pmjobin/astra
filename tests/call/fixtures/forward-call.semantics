(program
	(function "first" -> int
		(parameters
			(parameter #0 "x" : int)
		)
		(block
			(return (call "second" -> int (arguments (parameter-ref #0 "x" : int))))
		)
	)
	(function "second" -> int
		(parameters
			(parameter #0 "x" : int)
		)
		(block
			(return (binary + : int (parameter-ref #0 "x" : int) (integer 1 : int)))
		)
	)
)
