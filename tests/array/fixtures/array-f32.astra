f32 nan_value(f32 zero) { return zero / zero; }
f32 infinity(f32 zero) { return 1.0 / zero; }
bool values(int i) {
	f32[4] a = {0.0, -0.0, 1.401298464324817070923729583289916131280e-45, 2.5};
	if (1.0 / a[1] >= 0.0 || a[2] == 0.0 || a[3] != 2.5) { return false; }
	a[i] = -0.0;
	if (1.0 / a[i] >= 0.0) { return false; }
	a[i] = 1.401298464324817070923729583289916131280e-45;
	if (a[i] != 1.401298464324817070923729583289916131280e-45) { return false; }
	a[i] = nan_value(0.0);
	f32 n = a[i];
	if (n == n) { return false; }
	f32 inf = infinity(0.0);
	a[i] = inf;
	if (a[i] != inf || a[i] <= 3.4028234663852886e38) { return false; }
	a[i] = -inf;
	f32<4> special = {n, inf, 1.401298464324817070923729583289916131280e-45, -0.0};
	f32<4>[1] vectors = {special};
	vectors[0] = vectors[0];
	f32<4> loaded = vectors[0];
	if (loaded[0] == loaded[0] || loaded[1] != inf || loaded[2] == 0.0 || 1.0 / loaded[3] >= 0.0) { return false; }
	return a[i] == -inf;
}
int main() {
	int i = 0;
	while (i < 4) { if (!values(i)) { return 1; } i = i + 1; }
	return 0;
}
