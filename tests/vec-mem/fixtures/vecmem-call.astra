bool matches(i16<4>* p, i16<4> expected) { return all(*p == expected); }

void bias(i16<4>* p, i16<4> amount) { *p = sat_add(*p,amount); }

void store(f32<4>* out, f32<4> value) { *out = value; }

i16<4> replace(i16<4>* p, int* log) {
	*log = *log * 10 + 2;
	*p = splat(9,4);
	return splat(3,4);
}

int ordered(int* log, i16<4>* p, i16<4> before, i16<4> after) {
	*log = *log * 10 + 3;
	if (!all(before == splat(1,4)) || !all(after == splat(3,4))) return 1;
	*p = before + after;
	return 0;
}

int first(int* log) { *log = *log * 10 + 1; return 0; }

int combine(int first_value, int second_value) { return first_value + second_value; }

int main() {
	i16<4> v = {1,2,3,4};
	i16<4> amount = splat(10,4);
	bias(&v,amount);
	i16<4> expected = {11,12,13,14};
	if (!matches(&v,expected)) return 1;
	f32<4> f = splat(0.0,4);
	store(&f,splat(3.5,4));
	if (!all(f == splat(3.5,4))) return 2;
	int log = 0;
	v = splat(1,4);
	i16<4>* p = &v;
	if (combine(first(&log),ordered(&log,p,*p,replace(p,&log))) != 0) return 3;
	if (log != 123 || !all(v == splat(4,4))) return 4;
	// Earlier dereference values survive a later RHS call that mutates memory.
	v = splat(1,4);
	*p = *p + replace(p,&log);
	if (!all(v == splat(4,4))) return 5;
	return 0;
}
