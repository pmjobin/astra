int effect() {
	return 1;
}

int pair(int a, int b) {
	return a + b;
}

int before(int a, int b) {
	return a / b + effect();
}

int argument(int a, int b) {
	return pair(a % b, effect());
}

int nested(int a, int b) {
	return pair(a / b, a % b + effect());
}

int after(int a, int b) {
	return effect() + a / b;
}
