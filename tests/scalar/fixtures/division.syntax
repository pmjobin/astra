(unit
	(function
		(type "int")
		(name "arithmetic")
		(parameters
			(parameter (type "int") (name "a"))
			(parameter (type "int") (name "b"))
		)
		(block
			(return (binary "+" (binary "/" (name "a") (name "b")) (binary "%" (name "a") (name "b"))))
		)
	)
	(function
		(type "int")
		(name "minimum_division")
		(parameters)
		(block
			(return (binary "/" (prefix "-" (integer "2147483648")) (prefix "-" (integer "1"))))
		)
	)
	(function
		(type "int")
		(name "minimum_remainder")
		(parameters)
		(block
			(return (binary "%" (prefix "-" (integer "2147483648")) (prefix "-" (integer "1"))))
		)
	)
	(function
		(type "int")
		(name "zero_division")
		(parameters)
		(block
			(return (binary "/" (integer "1") (integer "0")))
		)
	)
	(function
		(type "int")
		(name "zero_remainder")
		(parameters)
		(block
			(return (binary "%" (integer "1") (integer "0")))
		)
	)
)
