			(local #1 "b" : Token)
		)
		(block
			(owned-local #0 "a" : Resource (region #0) (cleanup "life_destroy") (c-call "create_resource" -> owned Resource (arguments (integer 65 : int))))
			(owned-local #1 "b" : Token (region #0) (cleanup "life_destroy") (c-call "create_token" -> owned Token (arguments (integer 66 : int))))
			(generic-call-statement "dispose" -> void (type-arguments Resource) (arguments (owned-transfer-argument (parameter #0) (move (local-ref #0 "a") : Resource (cleanup "life_destroy")) : Resource (cleanup "life_destroy"))))
			(generic-call-statement "dispose" -> void (type-arguments Token) (arguments (owned-transfer-argument (parameter #0) (move (local-ref #1 "b") : Token (cleanup "life_destroy")) : Token (cleanup "life_destroy"))))
			(return (integer 42 : int))
