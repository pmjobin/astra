	(generic-definition "dispose" checked-once)
	(type-parameter #0 T (transport OWNABLE))
	(requires #0 T Ownable)
	(function "dispose" -> void
		(parameters
			(parameter #0 "value" : T (contract owned-transfer))
		)
		(locals
