		)
		(locals
			(local #0 "value" : T)
		)
		(block
			(ownership-return (generic-call "relay" -> owned T (type-arguments T) (arguments (owned-transfer-argument (parameter #0) (move (owner #0) : T (requires Ownable) (provenance incoming-owner)) : T (requires Ownable)))) : T)
		)
	)
	(function "main" -> int
		(parameters)
		(locals
