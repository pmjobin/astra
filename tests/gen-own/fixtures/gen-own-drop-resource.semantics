	(requires #0 T Ownable)
	(function "relay" -> T
		(result T (contract owned-transfer) (requires Ownable))
		(parameters
			(parameter #0 "value" : T (contract owned-transfer))
		)
		(locals
			(local #0 "value" : T)
		)
		(block
			(ownership-return (move (owner #0) : T (requires Ownable) (provenance incoming-owner)) : T)
		)
	)
	(generic-definition "forward" checked-once)
	(type-parameter #0 T (transport OWNABLE))
	(requires #0 T Ownable)
	(function "forward" -> T
