int scoped() {
	owned Resource a = create_resource(0);
	if (a != null) { return 1; }
	owned Resource b = move a;
	if (b != null || resource_id(b) != 0) { return 2; }
	release b;
	a = create_again(0);
	if (a != null || resource_is_live(a) != 0) { return 3; }
	return 0;
}
int main() {
	resource_reset();
	if (scoped() != 0 || resource_create_count() != 2 || resource_destroy_count() != 0 || resource_live_count() != 0 || resource_error_count() != 0) { return 1; }
	return 0;
}
