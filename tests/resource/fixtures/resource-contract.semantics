	)
	(function "choose" -> Resource
		(parameters
			(parameter #0 "c" : bool)
		)
		(locals
			(local #0 "result" : Resource)
		)
		(block
			(local-init #0 "result" : Resource (null : Resource))
			(if
				(condition (parameter-ref #0 "c" : bool))
				(then
					(block
						(assign (local-ref #0 "result" : Resource) (c-call "lookup_resource" -> Resource (arguments)))
					)
				)
			)
			(return (local-ref #0 "result" : Resource))
		)
	)
	(function "main" -> int
		(parameters)
		(locals
			(local #0 "r" : Resource)
			(local #1 "next" : Resource)
		)
		(block
			(owned-local #0 "r" : Resource (region #0) (cleanup "astra_test_resource_destroy") (c-call "create_resource" -> owned Resource (arguments (integer 1 : int))))
			(c-call-statement "resource_id" -> int (arguments (borrow-owner #0 "r" : Resource)))
			(owned-local #1 "next" : Resource (region #0) (cleanup "astra_test_resource_destroy") (move (local-ref #0 "r") : Resource (cleanup "astra_test_resource_destroy")))
			(ownership-rearm (owner #0 "r") (producer (c-call "create_again" -> owned Resource (arguments (integer 0 : int)))) (cleanup "astra_test_resource_destroy"))
