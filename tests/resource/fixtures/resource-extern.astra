extern(C) owned Resource astra_test_resource_create_a(int id);
extern(C) int astra_test_resource_inspect_extern(borrowed Resource r);
int scoped() {
	owned Resource r = astra_test_resource_create_a(1);
	return astra_test_resource_inspect_extern(r);
}
int main() {
	resource_reset();
	if (scoped() != 1 || resource_destroy_order() != 1 || resource_live_count() != 0 || resource_error_count() != 0) { return 1; }
	return 0;
}
