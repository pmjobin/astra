int main() {
	var object = new Installed(-1);
	try { return relay(object); } catch (DecodeError error) {
		if (error.message != "decode" || object.calls != 1) return 81;
		object.input = 42;
		try {
			if (object.value != 42 || object.value != 42 || object.calls != 2) return 82;
			if (object.ordinary != 42 || object.ordinary != 42 || object.ordinary_calls != 2) return 83;
			if (object.twice != 84 || object.twice != 84) return 84;
			return 42;
		} catch (Error nested) { return 85; }
	}
}
