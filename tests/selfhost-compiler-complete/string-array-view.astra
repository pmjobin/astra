// Hosted argv-backed descriptor input, passed through ordinary source calls.
int string_array_total(string[] values, int start) {
	int total = 0;
	int at = start;
	while (at < len(values)) {
		total = total + values[at].byte_length;
		at = at + 1;
	}
	return total;
}

int string_array_forward(string[] values) {
	return string_array_total(values, 1) + 36;
}
