// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Minimal IDs only; node/slot models and index kernels come from production.
struct SymbolId { int index; }

struct TypeId { int index; }

struct SyntaxNodeId { int index; }

struct SyntaxTokenId { int index; }

extern(C) int physical_capture_count(int graph, int which);

extern(C) int physical_capture_get(int graph, int which, int index, int field);

extern(C) int physical_expected(int graph, int which, int index);

extern(C) void physical_observed(int graph, int nodes, int slots, int declarations);

RecoverCoreNode physical_node(int function, int symbol, int kind) {
	SyntaxNodeId source = {index = 0}; SyntaxTokenId token = {index = 0};
	SymbolId binder = {index = symbol}; TypeId type = {index = 1}; TypeId error = {index = 0};
	RecoverNode row = {kind = kind, function = function, source = source, type = type, token = token, symbol = binder, a = 0, b = 0, c = 0, first = 0, count = 0, handler = 0, caught = 0};
	RecoverCoreNode node = {value = row, error = error, result_role = 0, place = 0, error_owner = 0, borrowed_owner = 0, conditional = false};
	return node;
}

RecoverSlot physical_slot(int function, int symbol, bool parameter) {
	SymbolId binder = {index = symbol}; TypeId type = {index = 1};
	RecoverSlot slot = {symbol = binder, type = type, flags = 0, function = function, scope = 0, parameter = parameter, owner = false};
	return slot;
}

bool physical_fresh(RecoverCoreNode[] nodes, RecoverSlot[] slots, int functions, int symbols) {
	if (!recover_llvm_index_domain(nodes, len(nodes), slots, len(slots), functions, symbols)) return false;
	var index = new RecoverLlvmIndex(len(nodes), len(slots), functions, symbols);
	return recover_llvm_index_build(index, nodes, len(nodes), slots, len(slots)) && recover_llvm_index_verified(index, nodes, len(nodes), slots, len(slots));
}

// Independent scalar discovery mirrors the old per-function/per-local searches.
// Compare each actual member in order, not just group lengths or hash totals.
bool physical_scalar(RecoverLlvmIndex index, RecoverCoreNode[] nodes, RecoverSlot[] slots) {
	int f = 0;
	while (f < len(index.node_heads)) {
		int member = index.node_heads[f]; int n = 0;
		while (n < len(nodes)) {
			if (nodes[n].value.function == f + 1) {
				if (member != n + 1) return false;
				member = index.node_next[n];
			}
			n = n + 1;
		}
		if (member != 0) return false;
		member = index.slot_heads[f]; int place = 0;
		while (place < len(slots)) {
			var slot = slots[place];
			if (slot.function == f + 1) {
				if (member != place + 1) return false;
				member = index.slot_next[place];
				if (!slot.parameter) {
					int stores = 0; int candidate = 0;
					while (candidate < len(nodes)) {
						var local = nodes[candidate].value;
						if (local.kind == 27 && local.symbol.index == slot.symbol.index) {
							stores = stores + 1;
							if (index.declarations[slot.symbol.index] != candidate + 1) return false;
						}
						candidate = candidate + 1;
					}
					if (stores != 1) return false;
				}
			}
			place = place + 1;
		}
		if (member != 0) return false;
		f = f + 1;
	}
	return true;
}

int physical_small() {
	var nodes = new RecoverCoreNode[4]; var slots = new RecoverSlot[3];
	nodes[0] = physical_node(2, 2, 27); nodes[1] = physical_node(1, 0, 1);
	nodes[2] = physical_node(1, 1, 27); nodes[3] = physical_node(2, 3, 2);
	slots[0] = physical_slot(2, 2, false); slots[1] = physical_slot(2, 3, true); slots[2] = physical_slot(1, 1, false);
	var index = new RecoverLlvmIndex(4, 3, 3, 5);
	if (!recover_llvm_index_build(index, nodes, 4, slots, 3) || !recover_llvm_index_verified(index, nodes, 4, slots, 3) || !physical_scalar(index, nodes, slots)) return 10;
	int mutation = 0;
	while (mutation < 16) {
		if (!physical_fresh(nodes, slots, 3, 5) || !recover_llvm_index_verified(index, nodes, 4, slots, 3)) return 11;
		if (mutation == 0) nodes[0] = physical_node(2, 2, 1);
		if (mutation == 1) nodes[1] = physical_node(2, 2, 27);
		if (mutation == 2) nodes[0] = physical_node(1, 2, 27);
		if (mutation == 3) nodes[0] = physical_node(2, 4, 27);
		if (mutation == 4) nodes[0] = physical_node(0, 2, 27);
		if (mutation == 5) nodes[0] = physical_node(4, 2, 27);
		if (mutation == 6) nodes[0] = physical_node(2, 0, 27);
		if (mutation == 7) nodes[0] = physical_node(2, 5, 27);
		if (mutation == 8) slots[0] = physical_slot(1, 2, false);
		if (mutation == 9) slots[0] = physical_slot(2, 1, false);
		if (mutation == 10) slots[0] = physical_slot(2, 2, true);
		if (mutation == 11) slots[1] = physical_slot(2, 3, false);
		if (mutation == 12) slots[0] = physical_slot(0, 2, false);
		if (mutation == 13) slots[0] = physical_slot(4, 2, false);
		if (mutation == 14) slots[0] = physical_slot(2, 0, false);
		if (mutation == 15) slots[0] = physical_slot(2, 5, false);
		if (physical_fresh(nodes, slots, 3, 5) || recover_llvm_index_verified(index, nodes, 4, slots, 3)) return 12;
		nodes[0] = physical_node(2, 2, 27); nodes[1] = physical_node(1, 0, 1);
		slots[0] = physical_slot(2, 2, false); slots[1] = physical_slot(2, 3, true);
		if (!physical_fresh(nodes, slots, 3, 5) || !recover_llvm_index_verified(index, nodes, 4, slots, 3)) return 13;
		mutation = mutation + 1;
	}
	mutation = 0;
	while (mutation < 15) {
		if (!recover_llvm_index_verified(index, nodes, 4, slots, 3)) return 14;
		if (mutation == 0) index.node_heads[0] = 0;
		if (mutation == 1) index.node_heads[0] = 1;
		if (mutation == 2) index.node_next[0] = 1;
		if (mutation == 3) index.node_next[0] = 0;
		if (mutation == 4) index.slot_heads[1] = 0;
		if (mutation == 5) index.slot_heads[1] = 3;
		if (mutation == 6) index.slot_next[0] = 1;
		if (mutation == 7) index.slot_next[0] = 0;
		if (mutation == 8) index.declarations[2] = 0;
		if (mutation == 9) index.declarations[2] = 3;
		if (mutation == 10) index.binders[2] = 0;
		if (mutation == 11) index.binders[2] = 3;
		if (mutation == 12) index.declarations[4] = 1;
		if (mutation == 13) index.declarations[0] = 1;
		if (mutation == 14) index.binders[0] = 1;
		if (recover_llvm_index_verified(index, nodes, 4, slots, 3)) return 15;
		index.node_heads[0] = 2; index.node_next[0] = 4;
		index.slot_heads[1] = 1; index.slot_next[0] = 2;
		index.declarations[2] = 1; index.binders[2] = 1; index.declarations[4] = 0;
		index.declarations[0] = 0; index.binders[0] = 0;
		if (!recover_llvm_index_verified(index, nodes, 4, slots, 3) || !physical_scalar(index, nodes, slots)) return 16;
		mutation = mutation + 1;
	}
	var empty_nodes = new RecoverCoreNode[0]; var empty_slots = new RecoverSlot[0];
	if (!physical_fresh(empty_nodes, empty_slots, 0, 1)) return 17;
	if (recover_llvm_index_domain(nodes, 5, slots, 3, 3, 5) || recover_llvm_index_domain(nodes, 4, slots, 4, 3, 5) || recover_llvm_index_domain(nodes, -1, slots, 3, 3, 5) || recover_llvm_index_domain(nodes, 4, slots, 3, 8000001, 5) || recover_llvm_index_domain(nodes, 4, slots, 3, 3, 0)) return 18;
	physical_observed(-1, 16, 15, 5);
	int code = 0;
	while (code < 256) {
		int rotation = 0;
		while (rotation < 4) {
			var members = new RecoverCoreNode[4]; var places = new RecoverSlot[4];
			int digit = code; int n = 0;
			while (n < 4) {
				int function = digit % 4 + 1; digit = digit / 4;
				bool parameter = n % 2 == 0; int kind = 27; if (parameter) kind = 2;
				members[n] = physical_node(function, n + 1, kind);
				places[(n + rotation) % 4] = physical_slot(function, n + 1, parameter);
				n = n + 1;
			}
			var ordered = new RecoverLlvmIndex(4, 4, 4, 6);
			if (!recover_llvm_index_build(ordered, members, 4, places, 4) || !recover_llvm_index_verified(ordered, members, 4, places, 4) || !physical_scalar(ordered, members, places)) return 19;
			rotation = rotation + 1;
		}
		code = code + 1;
	}
	return 42;
}

int physical_captured(int graph) {
	int count = physical_capture_count(graph, 0); int places = physical_capture_count(graph, 1);
	int functions = physical_capture_count(graph, 2); int symbols = physical_capture_count(graph, 3);
	var nodes = new RecoverCoreNode[count]; var slots = new RecoverSlot[places];
	int n = 0;
	while (n < count) {
		nodes[n] = physical_node(physical_capture_get(graph, 0, n, 1), physical_capture_get(graph, 0, n, 5), physical_capture_get(graph, 0, n, 0));
		n = n + 1;
	}
	int place = 0;
	while (place < places) {
		slots[place] = physical_slot(physical_capture_get(graph, 1, place, 3), physical_capture_get(graph, 1, place, 0), physical_capture_get(graph, 1, place, 5) != 0);
		place = place + 1;
	}
	var index = new RecoverLlvmIndex(count, places, functions, symbols);
	if (!recover_llvm_index_build(index, nodes, count, slots, places) || !recover_llvm_index_verified(index, nodes, count, slots, places)) return 20;
	n = 0;
	while (n < count) {
		if (index.node_next[n] != physical_expected(graph, 0, n)) return 21;
		n = n + 1;
	}
	place = 0;
	while (place < places) {
		if (index.slot_next[place] != physical_expected(graph, 1, place)) return 22;
		place = place + 1;
	}
	int f = 0;
	while (f < functions) {
		if (index.node_heads[f] != physical_expected(graph, 2, f) || index.slot_heads[f] != physical_expected(graph, 3, f)) return 23;
		f = f + 1;
	}
	int symbol = 0; int declarations = 0;
	while (symbol < symbols) {
		if (index.declarations[symbol] != physical_expected(graph, 4, symbol) || index.binders[symbol] != physical_expected(graph, 5, symbol)) return 24;
		if (index.declarations[symbol] != 0) declarations = declarations + 1;
		symbol = symbol + 1;
	}
	physical_observed(graph, count, places, declarations);
	return 42;
}

int main(string[] args) {
	if (len(args) != 2) return 25;
	if (args[1] == "--small") return physical_small();
	if (args[1] == "--original") return physical_captured(0);
	if (args[1] == "--current") return physical_captured(1);
	return 26;
}
