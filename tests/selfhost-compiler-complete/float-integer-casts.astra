// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
int cast_f32_int(f32 value) {
	return value as int;
}

i8 cast_f32_i8(f32 value) {
	return value as i8;
}

u8 cast_f32_u8(f32 value) {
	return value as u8;
}

i16 cast_f32_i16(f32 value) {
	return value as i16;
}

u16 cast_f32_u16(f32 value) {
	return value as u16;
}

u32 cast_f32_u32(f32 value) {
	return value as u32;
}

i64 cast_f32_i64(f32 value) {
	return value as i64;
}

u64 cast_f32_u64(f32 value) {
	return value as u64;
}

isize cast_f32_isize(f32 value) {
	return value as isize;
}

usize cast_f32_usize(f32 value) {
	return value as usize;
}

int cast_f64_int(f64 value) {
	return value as int;
}

i8 cast_f64_i8(f64 value) {
	return value as i8;
}

u8 cast_f64_u8(f64 value) {
	return value as u8;
}

i16 cast_f64_i16(f64 value) {
	return value as i16;
}

u16 cast_f64_u16(f64 value) {
	return value as u16;
}

u32 cast_f64_u32(f64 value) {
	return value as u32;
}

i64 cast_f64_i64(f64 value) {
	return value as i64;
}

u64 cast_f64_u64(f64 value) {
	return value as u64;
}

isize cast_f64_isize(f64 value) {
	return value as isize;
}

usize cast_f64_usize(f64 value) {
	return value as usize;
}

int main() {
	if (cast_f32_int(-42.75f) != -42) return 1;
	if (cast_f32_i8(-42.75f) != -42) return 1;
	if (cast_f32_u8(42.75f) != 42) return 1;
	if (cast_f32_i16(-42.75f) != -42) return 1;
	if (cast_f32_u16(42.75f) != 42) return 1;
	if (cast_f32_u32(42.75f) != 42) return 1;
	if (cast_f32_i64(-42.75f) != -42) return 1;
	if (cast_f32_u64(42.75f) != 42) return 1;
	if (cast_f32_isize(-42.75f) != -42) return 1;
	if (cast_f32_usize(42.75f) != 42) return 1;
	if (cast_f64_int(-42.75d) != -42) return 1;
	if (cast_f64_i8(-42.75d) != -42) return 1;
	if (cast_f64_u8(42.75d) != 42) return 1;
	if (cast_f64_i16(-42.75d) != -42) return 1;
	if (cast_f64_u16(42.75d) != 42) return 1;
	if (cast_f64_u32(42.75d) != 42) return 1;
	if (cast_f64_i64(-42.75d) != -42) return 1;
	if (cast_f64_u64(42.75d) != 42) return 1;
	if (cast_f64_isize(-42.75d) != -42) return 1;
	if (cast_f64_usize(42.75d) != 42) return 1;
	return 42;
}
