				refused = !generic_symbol_keys_verified(checked, plan);
				checked.generic_symbol_keys[plan.symbols + 2] = second;
				if (!refused || !generic_verify(checked)) return false;
				checked.generic_symbol_keys[plan.symbols + 1] = second;
				checked.generic_symbol_keys[plan.symbols + 2] = first;
