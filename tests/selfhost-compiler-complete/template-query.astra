bool template_shared_parameter_controls(CheckedIndex checked) throws Error {
	int s = 1;
	while (s <= checked.bindings.symbol_count) {
		var function = type_symbol(s);
		var plan = checked_source_plan(checked, function);
		if (plan.concrete.index == s && class_storage_initializing(checked, function)) {
			var owner = checked.bindings.symbol(checked.types.row(plan.enclosing).nominal);
			if (checked.bindings.program.arena.token_is(owner.token, "SharedOwnedConstructor")) {
				if (!recover_field_constructor_verified(checked, function)) return false;
				var declaration = checked.bindings.symbol(function);
				var body = checked.bindings.program.arena.get_node_body(declaration.node);
				var statements = checked.bindings.program.arena.get_list_statements(body);
				var statement = checked.bindings.program.arena.node_at(statements, 0);
				var clone = checked.bindings.program.arena.get_node_initializer(statement);
				if (checked_shared_action(checked, clone) != 2) return false;
				var arguments = checked_call_arguments(checked, clone);
				var operand = checked.bindings.program.arena.node_at(arguments, 0);
				var receiver = recover_field_receiver(checked, operand, function);
				if (receiver.index < 1 || receiver.index == class_storage_receiver(checked, function) || checked.bindings.symbol(receiver).kind != 7) return false;
				var initialized = new bool[checked.bindings.symbol_count + 1];
				if (!recover_constructor_value(checked, operand, function, plan.enclosing, initialized, 0)) return false;
				int flags = checked.symbol_flags[receiver.index];
				checked.symbol_flags[receiver.index] = 0;
				bool refused = !recover_constructor_value(checked, operand, function, plan.enclosing, initialized, 0);
				checked.symbol_flags[receiver.index] = flags;
				if (!refused || !recover_field_constructor_verified(checked, function)) return false;
				var root_type = checked.symbol_types[receiver.index];
				checked.symbol_types[receiver.index] = type_id(1);
				refused = !recover_constructor_value(checked, operand, function, plan.enclosing, initialized, 0);
				checked.symbol_types[receiver.index] = root_type;
				if (!refused || !recover_field_constructor_verified(checked, function)) return false;
				var use = checked.uses[operand.index];
				var changed = use;
				changed.type = type_id(13);
				checked.uses[operand.index] = changed;
				refused = !recover_constructor_value(checked, operand, function, plan.enclosing, initialized, 0);
				checked.uses[operand.index] = use;
				if (!refused || !recover_field_constructor_verified(checked, function)) return false;
				var field = checked_target(checked, operand, checked.bindings.program.arena.get_token_field_name(operand));
				int field_flags = checked.symbol_flags[field.index];
				checked.symbol_flags[field.index] = field_flags | 256;
				refused = !recover_constructor_value(checked, operand, function, plan.enclosing, initialized, 0);
				checked.symbol_flags[field.index] = field_flags;
				if (!refused || !recover_field_constructor_verified(checked, function) || !generic_verify(checked)) return false;
				println("SHARED_PARAMETER_CONTROLS root=2 type=1 visibility=1 restored=1");
				return true;
			}
		}
		s = s + 1;
	}
	return false;
}

bool template_match_copy_controls(CheckedIndex checked) throws Error {
	int s = 1;
	while (s <= checked.generic_symbols) {
		var plan = checked.direct_methods[s];
		if (plan.state == 2) {
			SyntaxNodeId match_node = {index = 0};
			SyntaxNodeId arm = {index = 0};
			SyntaxNodeId binding = {index = 0};
			int n = 1;
			while (n <= checked.generic_nodes) {
				SyntaxNodeId original = {index = n};
				if (generic_node(checked, plan, n) != 0) {
					var kind = checked.bindings.program.arena.kind(original);
					if (kind == SyntaxKind.MatchStatementSyntax()) match_node = original;
					if (kind == SyntaxKind.EnumArmSyntax() && checked.bindings.program.arena.get_token_variant(original).index != 0) arm = original;
					if (kind == SyntaxKind.EnumBindingSyntax() && checked.bindings.program.arena.get_token_field(original).index != 0) binding = original;
				}
				n = n + 1;
			}
			if (match_node.index != 0 && arm.index != 0 && binding.index != 0) {
				SyntaxNodeId concrete_match = {index = generic_node(checked, plan, match_node.index)};
				SyntaxNodeId concrete_arm = {index = generic_node(checked, plan, arm.index)};
				SyntaxNodeId concrete_binding = {index = generic_node(checked, plan, binding.index)};
				SyntaxNodeId absent_node = {index = 0};
				SyntaxListId absent_list = {index = 0};
				SyntaxTokenId absent_token = {index = 0};
				var scrutinee = checked.bindings.program.arena.get_node_scrutinee(concrete_match);
				checked.bindings.program.arena.set_node_scrutinee(concrete_match, absent_node);
				bool refused = !generic_check_node(checked, plan, match_node);
				checked.bindings.program.arena.set_node_scrutinee(concrete_match, scrutinee);
				if (!refused || !generic_verify(checked)) return false;
				var arms = checked.bindings.program.arena.get_list_arms(concrete_match);
				checked.bindings.program.arena.set_list_arms(concrete_match, absent_list);
				refused = !generic_check_node(checked, plan, match_node);
				checked.bindings.program.arena.set_list_arms(concrete_match, arms);
				if (!refused || !generic_verify(checked)) return false;
				var body = checked.bindings.program.arena.get_node_body(concrete_arm);
				checked.bindings.program.arena.set_node_body(concrete_arm, absent_node);
				refused = !generic_check_node(checked, plan, arm);
				checked.bindings.program.arena.set_node_body(concrete_arm, body);
				if (!refused || !generic_verify(checked)) return false;
				var variant = checked.bindings.program.arena.get_token_variant(concrete_arm);
				checked.bindings.program.arena.set_token_variant(concrete_arm, absent_token);
				refused = !generic_check_node(checked, plan, arm);
				checked.bindings.program.arena.set_token_variant(concrete_arm, variant);
				if (!refused || !generic_verify(checked)) return false;
				var field = checked.bindings.program.arena.get_token_field(concrete_binding);
				checked.bindings.program.arena.set_token_field(concrete_binding, absent_token);
				refused = !generic_check_node(checked, plan, binding);
				checked.bindings.program.arena.set_token_field(concrete_binding, field);
				if (!refused || !generic_verify(checked)) return false;
				var name = checked.bindings.program.arena.get_token_binding(concrete_binding);
				checked.bindings.program.arena.set_token_binding(concrete_binding, absent_token);
				refused = !generic_check_node(checked, plan, binding);
				checked.bindings.program.arena.set_token_binding(concrete_binding, name);
				if (!refused || !generic_verify(checked)) return false;
				println("MATCH_COPY_CONTROLS edges=3 tokens=3 restored=1");
				return true;
			}
		}
		s = s + 1;
	}
	return false;
}

bool template_enum_source_controls(CheckedIndex checked) throws Error {
	SyntaxNodeId call = {index = 0}; SyntaxNodeId match_node = {index = 0}; TypeId other = {index = 0};
	int n = 1;
	while (n <= checked.generic_nodes) {
		SyntaxNodeId node = {index = n}; var kind = checked.bindings.program.arena.kind(node);
		if (kind == SyntaxKind.CallExpressionSyntax() && checked_kind(checked, checked.uses[n].type) == 32) {
			if (call.index == 0) call = node;
			else {
				if (checked.uses[n].type.index != checked.uses[call.index].type.index) other = checked.uses[n].type;
			}
		}
		if (kind == SyntaxKind.MatchStatementSyntax() && checked.uses[n].type.index == 14) match_node = node;
		n = n + 1;
	}
	if (call.index == 0 || match_node.index == 0 || other.index == 0 || !enum_value_facts_verified(checked)) return false;
	var use = checked.uses[call.index]; int category = 0;
	while (category < 3) {
		var changed = use;
		if (category == 0) changed.type = other;
		if (category == 1) changed.flags = 2;
		if (category == 2) changed.deferred = 17;
		checked.uses[call.index] = changed;
		bool refused = !enum_value_facts_verified(checked);
		checked.uses[call.index] = use;
		if (!refused || !enum_value_facts_verified(checked) || !generic_verify(checked)) return false;
		category = category + 1;
	}
	var arms = checked.bindings.program.arena.get_list_arms(match_node);
	int count = checked.bindings.program.arena.list_count(arms);
	if (count != 3) return false;
	var first = checked.bindings.program.arena.node_at(arms, 0);
	var second = checked.bindings.program.arena.node_at(arms, 1);
	var fallback = checked.bindings.program.arena.node_at(arms, 2);
	var arm_use = checked.uses[first.index]; var wrong = arm_use; wrong.type = use.type;
	checked.uses[first.index] = wrong;
	bool refused = !enum_match_verified(checked, match_node);
	checked.uses[first.index] = arm_use;
	if (!refused || !enum_value_facts_verified(checked)) return false;
	var duplicate = checked.bindings.program.arena.new_list(syntax_kind_code(SyntaxKind.EnumArmSyntax()));
	checked.bindings.program.arena.append_node(duplicate, first);
	checked.bindings.program.arena.append_node(duplicate, first);
	checked.bindings.program.arena.append_node(duplicate, fallback);
	checked.bindings.program.arena.set_list_arms(match_node, duplicate);
	refused = !enum_match_verified(checked, match_node);
	checked.bindings.program.arena.set_list_arms(match_node, arms);
	if (!refused || !enum_value_facts_verified(checked)) return false;
	var reordered = checked.bindings.program.arena.new_list(syntax_kind_code(SyntaxKind.EnumArmSyntax()));
	checked.bindings.program.arena.append_node(reordered, fallback);
	checked.bindings.program.arena.append_node(reordered, first);
	checked.bindings.program.arena.append_node(reordered, second);
	checked.bindings.program.arena.set_list_arms(match_node, reordered);
	refused = !enum_match_verified(checked, match_node);
	checked.bindings.program.arena.set_list_arms(match_node, arms);
	if (!refused || !enum_value_facts_verified(checked) || !generic_verify(checked)) return false;
	println("ENUM_SOURCE_CONTROLS call=3 match=3 restored=1");
	return true;
}

int template_source_obligations(CheckedIndex checked) throws Error {
	int s = 1; int classes = 0; int functions = 0; int rejected_classes = 0; int rejected_functions = 0;
	while (s <= checked.bindings.symbol_count) {
		var symbol = type_symbol(s); var declaration = checked.bindings.symbol(symbol);
		bool report = false; bool accepted = false;
		var output = new Utf8ByteBuilder();
		if (declaration.kind == 4) {
			classes = classes + 1; report = true;
			accepted = recover_class_declaration_source(checked, symbol);
			if (!accepted) rejected_classes = rejected_classes + 1;
			source_append_text(output, "CLASS ");
		} else { if (recover_runtime_function(checked, symbol)) {
				functions = functions + 1; accepted = recover_function_source(checked, symbol);
				if (!accepted) {
					report = true; rejected_functions = rejected_functions + 1;
					source_append_text(output, "FUNCTION ");
				}
			} }
		if (report) {
			var name = checked.bindings.program.arena.token_message(declaration.token);
			append_int(output, s); source_append_text(output, " "); source_append_text(output, name.text);
			int bit = 0; if (accepted) bit = 1; source_append_text(output, " SOURCE "); append_int(output, bit);
			if (declaration.kind == 4) {
				var type = checked.symbol_types[s];
				source_append_text(output, " FIELDS "); append_int(output, checked.bindings.program.arena.list_count(checked.bindings.program.arena.get_list_fields(declaration.node)));
				bit = 0; if (class_storage_fields_verified(checked, type, 0)) bit = 1; source_append_text(output, " FIELD_TYPES "); append_int(output, bit);
				bit = 0; if (class_storage_source_verified(checked, type, false, 0)) bit = 1; source_append_text(output, " LAYOUT_SOURCE "); append_int(output, bit);
			}
			source_append_text(output, " SPAN "); binding_write_span(checked.bindings, checked.bindings.program.arena.header(declaration.node).span, output);
			var text = output.snapshot(); println(text.text);
		}
		s = s + 1;
	}
	var output = new Utf8ByteBuilder(); source_append_text(output, "SOURCE_OBLIGATIONS classes="); append_int(output, classes); source_append_text(output, " refused_classes="); append_int(output, rejected_classes); source_append_text(output, " functions="); append_int(output, functions); source_append_text(output, " refused_functions="); append_int(output, rejected_functions);
	var text = output.snapshot(); println(text.text);
	if (rejected_classes > 0 || rejected_functions > 0) return 3;
	return 0;
}

void template_source_map_usage(CheckedIndex checked) throws Error {
	int direct = 0; int s = 0;
	while (s < len(checked.direct_methods)) {
		if (checked.direct_methods[s].state == 2) direct = direct + 1;
		s = s + 1;
	}
	var output = new Utf8ByteBuilder();
	source_append_text(output, "SOURCE_MAP_USAGE nodes="); append_int(output, checked.generic_node_used);
	source_append_text(output, " symbols="); append_int(output, checked.generic_symbol_used);
	source_append_text(output, " scopes="); append_int(output, checked.generic_scope_used);
	source_append_text(output, " instances="); append_int(output, checked.instance_count);
	source_append_text(output, " direct="); append_int(output, direct);
	var text = output.snapshot(); println(text.text);
}

int main(string[] args) {
	if (len(args) < 3 || args[1] != "--templates" && args[1] != "--flow" && args[1] != "--module-flow" && args[1] != "--obligations" && args[1] != "--direct-method-controls" && args[1] != "--constructor-local-controls" && args[1] != "--shared-constructor-controls" && args[1] != "--shared-parameter-controls" && args[1] != "--symbol-map-controls" && args[1] != "--scope-map-controls" && args[1] != "--enum-source-controls" && args[1] != "--match-copy-controls" && args[1] != "--foreign-source-controls" && args[1] != "--class-layout-controls" && args[1] != "--getter-controls" && args[1] != "--mutations" && args[1] != "--records") return 9;
	try {
		var program = binding_load_program(args, 2); var bindings = binding_index(move program, 0);
		var checked = checked_build_effects_profile(move bindings, 0);
		template_source_map_usage(checked);
		if (checked.failed()) {
			var text = checked_observation(checked);
			print(text.text);
			return 1;
		}
		if (!checked.validate() || !generic_verify(checked) || !enum_value_facts_verified(checked)) {
			var output = new Utf8ByteBuilder(); source_append_text(output, "SOURCE_PLAN_FAILURE "); append_int(output, generic_verify_failure(checked)); var text = output.snapshot(); println(text.text);
			return 8;
		}
		if (args[1] == "--direct-method-controls") {
			if (template_direct_method_controls(move checked)) return 42;
			return 8;
		}
		if (args[1] == "--constructor-local-controls") {
			if (template_constructor_local_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--shared-constructor-controls") {
			if (template_shared_constructor_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--symbol-map-controls") {
			if (template_symbol_map_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--scope-map-controls") {
			if (template_scope_map_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--enum-source-controls") {
			if (template_enum_source_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--shared-parameter-controls") {
			if (template_shared_parameter_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--match-copy-controls") {
			if (template_match_copy_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--foreign-source-controls") {
			if (template_foreign_source_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--class-layout-controls") {
			if (template_class_layout_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--getter-controls") {
			if (template_getter_controls(checked)) return 42;
			return 8;
		}
		if (args[1] == "--records") return record_shape_cli(checked);
		if (args[1] == "--obligations") return template_source_obligations(checked);
		bool complete = true; int count = 0; int s = 1;
		while (s <= checked.generic_symbols) {
			var symbol = type_symbol(s); var declaration = checked.bindings.symbol(symbol);
			if (declaration.kind == 4 && generic_template(checked, symbol)) {
				count = count + 1; var name = checked.bindings.program.arena.token_message(declaration.token);
				bool header = class_storage_template_verified(checked, symbol); bool accepted = recover_slot_template_source(checked, symbol);
				var output = new Utf8ByteBuilder(); source_append_text(output, "TEMPLATE "); source_append_text(output, name.text); source_append_text(output, " "); append_int(output, s);
				int bit = 0; if (header) bit = 1; source_append_text(output, " HEADER "); append_int(output, bit);
				bit = 0; if (accepted) bit = 1; source_append_text(output, " SOURCE "); append_int(output, bit);
				var text = output.snapshot(); println(text.text); complete = complete && accepted;
				if (args[1] == "--flow") template_closed_storage(checked, symbol);
				if (args[1] == "--mutations" && (!accepted || !template_source_controls(checked, symbol))) return 8;
				var members = checked.bindings.program.arena.get_list_members(declaration.node); int m = 0;
				while (m < checked.bindings.program.arena.list_count(members)) {
					var node = checked.bindings.program.arena.node_at(members, m); var kind = checked.bindings.program.arena.kind(node); var member = checked.node_symbols[node.index];
					if (kind == SyntaxKind.FunctionDeclarationSyntax() || kind == SyntaxKind.LifecycleDeclarationSyntax()) {
						var work = new int[1]; work[0] = 8000000; bool valid = false;
						if (kind == SyntaxKind.FunctionDeclarationSyntax()) valid = recover_template_method(checked, symbol, member, work);
						else {
							valid = recover_template_constructor(checked, symbol, node, work);
						}
						var member_declaration = checked.bindings.symbol(member); var member_name = checked.bindings.program.arena.token_message(member_declaration.token);
						var member_output = new Utf8ByteBuilder(); source_append_text(member_output, "MEMBER "); source_append_text(member_output, member_name.text); source_append_text(member_output, " "); append_int(member_output, member.index);
						int member_bit = 0; if (valid) member_bit = 1; source_append_text(member_output, " SOURCE "); append_int(member_output, member_bit);
						var callable = checked.symbol_types[member.index]; source_append_text(member_output, " KIND "); append_int(member_output, checked_kind(checked, callable)); source_append_text(member_output, " CHANNELS "); append_int(member_output, checked.types.row(callable).count);
						var member_text = member_output.snapshot(); println(member_text.text);
					}
					m = m + 1;
				}
			}
			s = s + 1;
		}
		var count_output = new Utf8ByteBuilder(); source_append_text(count_output, "TEMPLATE_COUNT "); append_int(count_output, count); var count_text = count_output.snapshot(); println(count_text.text);
		if (args[1] == "--templates") {
			if (complete) return 0;
			return 3;
		}
		if (args[1] == "--mutations") {
			if (complete && count > 0) return 42;
			return 3;
		}
		var flow = recover_flow_lower_mode(move checked, 8192, args[1] == "--module-flow");
		var details = new Utf8ByteBuilder(); source_append_text(details, "FLOW "); append_int(details, flow.data.status); source_append_text(details, " "); append_int(details, flow.data.boundary.index); source_append_text(details, " "); append_int(details, flow.data.node_count);
		var status = details.snapshot(); println(status.text);
		if (flow.data.boundary.index > 0) {
			var span_output = new Utf8ByteBuilder();
			binding_write_span(flow.checked.bindings, flow.checked.bindings.program.arena.header(flow.data.boundary).span, span_output);
			var span_text = span_output.snapshot();
			println(span_text.text);
		}
		if (flow.data.status != 0 || !recover_flow_verify(flow)) return 2;
		return 42;
	} catch (Error error) { println_stderr(error.message); return 7; }
}
