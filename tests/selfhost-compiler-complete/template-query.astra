			bool valid = recover_child(data, flow.checked, flow.types, body, flow.checked.bindings.program.arena.get_node_body(declaration.node), f + 1, 0, 0, seen, edges, 0) && (flow.data.functions[f].result.index == 14 || !recover_falls(data, body, 0)) && recover_loop_verify(data, body, 0, 0);
			int n = 0;
