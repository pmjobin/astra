				var field = text_storage_verified_projection(flow.checked, member);
				if (field.index < 1) return false;
				int flags = flow.checked.symbol_flags[field.index];
				flow.checked.symbol_flags[field.index] = flags & ~128;
				bool readonly_rejected = !recover_text_views_verified(flow);
				flow.checked.symbol_flags[field.index] = flags;
				var type = flow.checked.symbol_types[field.index];
				flow.checked.symbol_types[field.index] = type_id(1);
				bool type_rejected = !recover_text_views_verified(flow);
				flow.checked.symbol_types[field.index] = type;
				var original = flow.data.nodes[0]; var mutated = original;
				mutated.kind = 10; mutated.symbol = type_symbol(root); flow.data.nodes[0] = mutated;
				bool move_rejected = !recover_text_views_verified(flow);
				mutated.kind = 42; mutated.symbol = row.symbol; flow.data.nodes[0] = mutated;
				bool assignment_rejected = !recover_text_views_verified(flow);
				flow.data.nodes[0] = original;
				int parent = flow.storage.parents[local.scope.index];
				flow.storage.parents[local.scope.index] = 0;
				bool scope_rejected = !recover_text_views_verified(flow);
				flow.storage.parents[local.scope.index] = parent;
				flags = flow.checked.symbol_flags[root]; flow.checked.symbol_flags[root] = 0;
				bool root_rejected = !recover_text_views_verified(flow);
				flow.checked.symbol_flags[root] = flags;
				if (!readonly_rejected || !type_rejected || !move_rejected || !assignment_rejected || !scope_rejected || !root_rejected || !recover_flow_verify(flow)) return false;
				println("TEXT_VIEW_CONTROLS source=2 lifetime=4 restored=1");
				return true;
			}
		}
		n = n + 1;
	}
	return false;
}

bool template_record_initializer_controls(CheckedIndex checked) throws Error {
	int n = 1;
	while (n < len(checked.uses)) {
		SyntaxNodeId node = {index = n};
		if (checked.bindings.program.arena.kind(node) == SyntaxKind.StructInitializerSyntax() && checked.uses[n].type.index > 0) {
			var fields = checked.bindings.program.arena.get_list_fields(node);
			if (checked.bindings.program.arena.list_count(fields) > 0) {
				var field = checked.bindings.program.arena.node_at(fields, 0);
				var original = checked.bindings.program.arena.field_initializer(field);
				var nested = original.f_initializer;
				if (nested.index > 0) {
					var type = checked.uses[n].type;
					if (!recover_record_source(checked, node, type)) return false;
					var inner = checked.bindings.program.arena.get_list_fields(nested);
					if (checked.bindings.program.arena.list_count(inner) < 1) return false;
					var value = checked.bindings.program.arena.node_at(inner, 0);
					var expression = checked.bindings.program.arena.get_node_expression(value);
					if (expression.index < 1) return false;
					var changed = original; changed.f_initializer.index = 0;
					checked.bindings.program.arena.replace_field_initializer(field, changed);
					bool refused = !recover_record_source(checked, node, type);
					checked.bindings.program.arena.replace_field_initializer(field, original);
					if (!refused || !recover_record_source(checked, node, type)) return false;
					changed = original; changed.f_expression = expression;
					checked.bindings.program.arena.replace_field_initializer(field, changed);
					refused = !recover_record_source(checked, node, type);
					checked.bindings.program.arena.replace_field_initializer(field, original);
					if (!refused || !recover_record_source(checked, node, type)) return false;
					var use = checked.uses[nested.index]; var altered = use; altered.type = type_id(1); checked.uses[nested.index] = altered;
					refused = !recover_record_source(checked, node, type); checked.uses[nested.index] = use;
					if (!refused || !recover_record_source(checked, node, type)) return false;
					use = checked.uses[field.index]; altered = use; altered.type = type_id(1); checked.uses[field.index] = altered;
					refused = !recover_record_source(checked, node, type); checked.uses[field.index] = use;
					if (!refused || !recover_record_source(checked, node, type)) return false;
					changed = original; changed.f_name = checked.bindings.program.arena.get_token_name(value);
					checked.bindings.program.arena.replace_field_initializer(field, changed);
					refused = !recover_record_source(checked, node, type);
					checked.bindings.program.arena.replace_field_initializer(field, original);
					if (!refused || !recover_record_source(checked, node, type) || !checked.validate() || !generic_verify(checked)) return false;
					println("RECORD_INITIALIZER_CONTROLS source=5 restored=1");
					return true;
				}
			}
		}
		n = n + 1;
	}
	return false;
}

