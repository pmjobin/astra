SymbolId template_effect_root_reference(CheckedIndex checked) {
	if (checked.generic_symbols < 0 || checked.generic_symbols > checked.bindings.symbol_count) return type_symbol(0);
	var root = type_symbol(0); int s = 1;
	while (s <= checked.generic_symbols) {
