				var acquire = checked.bindings.program.arena.get_node_initializer(second); var moved = checked.bindings.program.arena.get_node_expression(third); var local = checked.node_symbols[second.index];
				if (checked_shared_action(checked, acquire) != 1 || checked.bindings.program.arena.kind(moved) != SyntaxKind.MoveExpressionSyntax()) return false;
				var initialized = new bool[checked.bindings.symbol_count + 1];
				if (recover_constructor_value(checked, acquire, function, plan.enclosing, initialized, 0)) return false;
				if (!recover_constructor_statement(checked, first, function, plan.enclosing, initialized, 0) || !recover_constructor_value(checked, acquire, function, plan.enclosing, initialized, 0)) return false;
				if (recover_constructor_value(checked, moved, function, plan.enclosing, initialized, 0)) return false;
				if (!recover_constructor_statement(checked, second, function, plan.enclosing, initialized, 0) || !initialized[local.index] || !recover_constructor_value(checked, moved, function, plan.enclosing, initialized, 0)) return false;
				initialized[local.index] = false;
				if (recover_constructor_value(checked, moved, function, plan.enclosing, initialized, 0)) return false;
				initialized[local.index] = true;
				var original = checked.uses[acquire.index]; var changed = original; changed.flags = 0; checked.uses[acquire.index] = changed;
				bool refused = !recover_constructor_value(checked, acquire, function, plan.enclosing, initialized, 0); checked.uses[acquire.index] = original;
				if (!refused || !recover_field_constructor_verified(checked, function)) return false;
				changed = original; changed.deferred = 0; checked.uses[acquire.index] = changed;
				refused = !recover_constructor_value(checked, acquire, function, plan.enclosing, initialized, 0); checked.uses[acquire.index] = original;
				if (!refused || !recover_field_constructor_verified(checked, function)) return false;
				int flags = checked.symbol_flags[local.index]; checked.symbol_flags[local.index] = 2;
				refused = !recover_constructor_value(checked, moved, function, plan.enclosing, initialized, 0); checked.symbol_flags[local.index] = flags;
				if (!refused || !recover_field_constructor_verified(checked, function) || !generic_verify(checked)) return false;
