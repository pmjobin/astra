		if (symbol.kind == 4 && checked.bindings.program.arena.get_token_exception_root(symbol.node).index != 0) {
			if (root.index != 0) return type_symbol(0);
			root = type_symbol(s);
		}
		s = s + 1;
	}
	return root;
}

bool template_effect_root_controls(CheckedIndex checked) throws Error {
	var root = checked_effect_root(checked);
	if (root.index < 1 || root.index != template_effect_root_reference(checked).index) return false;
	var declaration = checked.bindings.symbol(root);
	var token = checked.bindings.program.arena.get_token_exception_root(declaration.node);
	var changed = declaration; changed.kind = 3;
	checked.bindings.replace_instance_symbol(root, changed);
	bool refused = checked_effect_root(checked).index == 0 && template_effect_root_reference(checked).index == 0;
	checked.bindings.replace_instance_symbol(root, declaration);
	if (!refused || checked_effect_root(checked).index != root.index) return false;
	SyntaxTokenId absent = {index = 0};
	checked.bindings.program.arena.set_token_exception_root(declaration.node, absent);
	refused = checked_effect_root(checked).index == 0 && template_effect_root_reference(checked).index == 0;
	checked.bindings.program.arena.set_token_exception_root(declaration.node, token);
	if (!refused || checked_effect_root(checked).index != root.index) return false;
	bool duplicate = false; int s = 1;
	while (s <= checked.generic_symbols && !duplicate) {
		var other = checked.bindings.symbol(type_symbol(s));
		if (s != root.index && other.kind == 4) {
			var original = checked.bindings.program.arena.get_token_exception_root(other.node);
			checked.bindings.program.arena.set_token_exception_root(other.node, token);
			refused = checked_effect_root(checked).index == 0 && template_effect_root_reference(checked).index == 0;
			checked.bindings.program.arena.set_token_exception_root(other.node, original);
			if (!refused || checked_effect_root(checked).index != root.index) return false;
			duplicate = true;
		}
		s = s + 1;
	}
	if (!duplicate) return false;
	int maximum = checked.generic_symbols;
	checked.generic_symbols = -1;
	refused = checked_effect_root(checked).index == 0 && template_effect_root_reference(checked).index == 0;
	checked.generic_symbols = maximum;
	if (!refused) return false;
	checked.generic_symbols = checked.bindings.symbol_count + 1;
	refused = checked_effect_root(checked).index == 0 && template_effect_root_reference(checked).index == 0;
	checked.generic_symbols = maximum;
	if (!refused || checked_effect_root(checked).index != root.index || !generic_verify(checked)) return false;
	println("EFFECT_ROOT_CONTROLS kind=1 source=2 bounds=2 reference=1 restored=1");
	return true;
}

