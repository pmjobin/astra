// Focused development host for the complete production pipeline. Regression
// mutation dispatch is separate; this is not a packaged or self-hosted astrac.
bool template_error_cache_controls(RecoverLlvm module, RecoverSsa ssa) throws Error {
	if (!module.check(ssa)) return false;
	var root = checked_effect_root(ssa.cfg.core.flow.checked);
	if (root.index < 1 || module.descriptors[root.index] == null || module.payloads[root.index] == null || module.destroyers[root.index] == null || module.tables[root.index] == null) return false;
	int count = 0; int s = 1;
	while (s <= ssa.cfg.core.flow.checked.bindings.symbol_count) {
		var symbol = type_symbol(s);
		if (recover_slot_template_source(ssa.cfg.core.flow.checked, symbol)) {
			if (recover_storage_class(ssa.cfg.core.flow.checked, ssa.cfg.core.flow.checked.symbol_types[s]) || module.descriptors[s] != null || module.payloads[s] != null || module.destroyers[s] != null || module.tables[s] != null) return false;
			module.descriptors[s] = module.descriptors[root.index];
			bool rejected = llvm12_verify(module.module) == 0 && !module.check(ssa); module.descriptors[s] = null;
			if (!rejected || !module.check(ssa)) return false;
			module.payloads[s] = module.payloads[root.index];
			rejected = llvm12_verify(module.module) == 0 && !module.check(ssa); module.payloads[s] = null;
			if (!rejected || !module.check(ssa)) return false;
			module.destroyers[s] = module.destroyers[root.index];
			rejected = llvm12_verify(module.module) == 0 && !module.check(ssa); module.destroyers[s] = null;
			if (!rejected || !module.check(ssa)) return false;
			module.tables[s] = module.tables[root.index];
			rejected = llvm12_verify(module.module) == 0 && !module.check(ssa); module.tables[s] = null;
			if (!rejected || !module.check(ssa)) return false;
			count = count + 1;
		}
		s = s + 1;
	}
	// These are cache-model perturbations; the unchanged LLVM remains valid.
	// They are not counted as new physical IR mutation categories.
	return count > 0;
}

bool record_value_controls(RecoverLlvm module, RecoverSsa ssa) throws Error {
	if (!module.check(ssa) || !recover_flow_verify(ssa.cfg.core.flow)) return false;
	int count = 0; int source_controls = 0; int n = 0;
	while (n < ssa.cfg.core.flow.data.node_count) {
		var row = ssa.cfg.core.flow.data.nodes[n];
		if (row.kind == 12 && row.a > 0) {
			ssa.cfg.core.flow.data.nodes[n].a = 0;
			bool rejected = !recover_flow_verify(ssa.cfg.core.flow); ssa.cfg.core.flow.data.nodes[n].a = row.a;
			if (!rejected || !recover_flow_verify(ssa.cfg.core.flow)) return false;
			ssa.cfg.core.flow.data.nodes[n].symbol = type_symbol(1);
			rejected = !recover_flow_verify(ssa.cfg.core.flow); ssa.cfg.core.flow.data.nodes[n].symbol = row.symbol;
			if (!rejected || !recover_flow_verify(ssa.cfg.core.flow)) return false;
			source_controls = source_controls + 2;
			var value = module.values[n + 1]; var aggregate = module.values[row.a];
			if (value != null && LLVMIsAInstruction(value) != null && LLVMGetInstructionOpcode(value) == 53 && LLVMIsAInstruction(aggregate) != null) {
				LLVMSetOperand(value, 0, LLVMConstNull(LLVMTypeOf(aggregate)));
				rejected = llvm12_verify(module.module) == 0 && !module.check(ssa); LLVMSetOperand(value, 0, aggregate);
				if (!rejected || !module.check(ssa)) return false;
				count = count + 1;
			}
		}
		if (row.kind == 8 || row.kind == 12 && checked_kind(ssa.cfg.core.flow.checked, row.type) == 30) {
			var record = module.values[n + 1];
			if (record != null && LLVMIsAInstruction(record) != null && LLVMGetInstructionOpcode(record) == 54) {
				var element = LLVMGetOperand(record, 1); var replacement = LLVMConstNull(LLVMTypeOf(element));
				if (element != replacement) {
					LLVMSetOperand(record, 1, replacement);
					bool rejected_record = llvm12_verify(module.module) == 0 && !module.check(ssa); LLVMSetOperand(record, 1, element);
					if (!rejected_record || !module.check(ssa)) return false;
					count = count + 1;
				}
			}
		}
		n = n + 1;
	}
	int block = 0; int memory_controls = 0;
	while (block < ssa.cfg.block_count) {
		var lowered = ssa.cfg.blocks[block];
		if (ssa.data.reachable[block] && lowered.origin > 0) {
			var row = ssa.cfg.core.nodes[lowered.origin - 1].value;
			void* operation = module.operations[block]; int operand = 0; bool selected = false;
			if (lowered.opcode == 17 || lowered.opcode == 44) {
				var fact = ssa.cfg.core.flow.fields.facts[row.source.index];
				var type = ssa.cfg.core.flow.checked.symbol_types[fact.field.index];
				selected = checked_kind(ssa.cfg.core.flow.checked, type) == 30 && !error_storage_class(ssa.cfg.core.flow.checked, fact.aggregate);
			}
			if (lowered.opcode == 9) {
				var element = ssa.cfg.core.flow.checked.types.argument(ssa.cfg.core.flow.checked.types, row.type, 0).type;
				selected = checked_kind(ssa.cfg.core.flow.checked, element) == 30;
				operand = 1;
			}
			if (lowered.opcode == 55 && checked_kind(ssa.cfg.core.flow.checked, row.type) == 30) {
				operation = module.values[lowered.origin];
				selected = true;
			}
			if (lowered.opcode == 61) selected = checked_kind(ssa.cfg.core.flow.checked, ssa.cfg.core.nodes[row.c - 1].value.type) == 30;
			if (selected) {
				if (operation == null || LLVMGetInstructionOpcode(operation) != 45) return false;
				var original = LLVMGetArgOperand(operation, operand);
				var absent = LLVMConstNull(LLVMTypeOf(original));
				if (original == absent) return false;
				LLVMSetOperand(operation, operand, absent);
				bool rejected_memory = LLVMGetArgOperand(operation, operand) == absent && llvm12_verify(module.module) == 0 && !module.check(ssa);
				LLVMSetOperand(operation, operand, original);
				if (!rejected_memory || !module.check(ssa)) return false;
				count = count + 1;
				memory_controls = memory_controls + 1;
			}
		}
		block = block + 1;
	}
	// Source/model controls and LLVM-valid replacements are separately labelled.
	var output = new Utf8ByteBuilder(); source_append_text(output, "RECORD_VALUE_CONTROLS source="); append_int(output, source_controls); source_append_text(output, " physical="); append_int(output, count); source_append_text(output, " memory="); append_int(output, memory_controls); var text = output.snapshot(); println(text.text);
	return count > 0;
}

bool class_finalizer_controls(RecoverLlvm module, RecoverSsa ssa) throws Error {
	if (!module.check(ssa)) return false;
	int count = 0; int source_controls = 0; int s = 1;
	while (s < len(module.class_destroyers)) {
		var destroy = module.class_destroyers[s];
		if (destroy != null) {
			var source = recover_class_deinit_source(ssa.cfg.core.flow.checked, type_symbol(s));
			if (source.index > 0) {
				var original = ssa.cfg.core.flow.checked.node_symbols[source.index];
				ssa.cfg.core.flow.checked.node_symbols[source.index] = type_symbol(0);
				bool refused = !recover_flow_verify(ssa.cfg.core.flow);
				ssa.cfg.core.flow.checked.node_symbols[source.index] = original;
				if (!refused || !module.check(ssa)) return false;
				source_controls = source_controls + 1;
				var body = LLVMGetNextBasicBlock(LLVMGetFirstBasicBlock(destroy));
				var call = LLVMGetFirstInstruction(body);
				if (call == null || LLVMGetInstructionOpcode(call) != 45 || LLVMGetNumOperands(call) != 2) return false;
				var receiver = LLVMGetArgOperand(call, 0); var callee = LLVMGetCalledValue(call);
				if (receiver != LLVMGetParam(destroy, 0) || LLVMGetOperand(call, 1) != callee || callee == destroy) return false;
				LLVMSetOperand(call, 0, LLVMConstNull(LLVMTypeOf(receiver)));
				refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
				LLVMSetOperand(call, 0, receiver);
				if (!refused || llvm12_verify(module.module) != 0 || !module.check(ssa)) return false;
				LLVMSetOperand(call, 1, destroy);
				refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
				LLVMSetOperand(call, 1, callee);
				if (!refused || llvm12_verify(module.module) != 0 || !module.check(ssa)) return false;
				count = count + 2;
			}
		}
		s = s + 1;
	}
	var output = new Utf8ByteBuilder(); source_append_text(output, "FINALIZER_CONTROLS source="); append_int(output, source_controls); source_append_text(output, " physical="); append_int(output, count); var text = output.snapshot(); println(text.text);
	return count > 0;
}

bool mutation_index_controls(RecoverFlow flow) {
	if (!recover_flow_verify(flow)) return false;
	int present = -1; int absent = -1; int s = 1;
	while (s < len(flow.data.mutable_symbols)) {
		if (flow.data.mutable_symbols[s]) present = s;
		else {
			absent = s;
		}
		s = s + 1;
	}
	if (present < 1 || absent < 1) return false;
	flow.data.mutable_symbols[present] = false;
	bool refused = !recover_flow_verify(flow);
	flow.data.mutable_symbols[present] = true;
	if (!refused || !recover_flow_verify(flow)) return false;
	flow.data.mutable_symbols[absent] = true;
	refused = !recover_flow_verify(flow);
	flow.data.mutable_symbols[absent] = false;
	if (!refused || !recover_flow_verify(flow)) return false;
	println("MUTATION_INDEX_CONTROLS missing=1 extra=1 restored=1");
	return true;
}

bool enum_transport_controls(RecoverLlvm module, RecoverSsa ssa) throws Error {
	if (!module.check(ssa)) return false;
	int source_controls = 0; bool literal = false; bool match_node = false; bool arm_node = false; int n = 0;
	while (n < ssa.cfg.core.flow.data.node_count) {
		var row = ssa.cfg.core.flow.data.nodes[n];
		if (row.kind == 71 && !literal) {
			var declaration = ssa.cfg.core.flow.checked.bindings.symbol(ssa.cfg.core.flow.checked.types.row(row.type).nominal);
			var variants = ssa.cfg.core.flow.checked.bindings.program.arena.get_list_variants(declaration.node);
			int count = ssa.cfg.core.flow.checked.bindings.program.arena.list_count(variants);
			if (count < 2) return false;
			int ordinal = enum_value_ordinal(ssa.cfg.core.flow.checked, row.type, row.symbol);
			int next = ordinal + 1; if (next == count) next = 0;
			var variant = ssa.cfg.core.flow.checked.bindings.program.arena.node_at(variants, next);
			ssa.cfg.core.flow.data.nodes[n].symbol = ssa.cfg.core.flow.checked.node_symbols[variant.index];
			bool refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.data.nodes[n].symbol = row.symbol;
			if (!refused || !module.check(ssa)) return false;
			source_controls = source_controls + 1; literal = true;
		}
		if (row.kind == 72 && !match_node) {
			ssa.cfg.core.flow.data.nodes[n].a = 0;
			bool refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.data.nodes[n].a = row.a;
			if (!refused || !module.check(ssa)) return false;
			source_controls = source_controls + 1; match_node = true;
		}
		if (row.kind == 73 && !arm_node) {
			ssa.cfg.core.flow.data.nodes[n].c = 0;
			bool refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.data.nodes[n].c = row.c;
			if (!refused || !module.check(ssa)) return false;
			source_controls = source_controls + 1; arm_node = true;
		}
		n = n + 1;
	}
	int abi_controls = 0; int f = 0;
	while (f < ssa.cfg.core.flow.data.function_count && abi_controls == 0) {
		var function = ssa.cfg.core.flow.data.functions[f];
		if (checked_kind(ssa.cfg.core.flow.checked, function.result) == 32) {
			var plan = new RecoverAbi(ssa.cfg.core.flow.checked, function.symbol);
			if (plan.receiver == 1) {
				if (!recover_abi_verify(plan, ssa.cfg.core.flow.checked) || plan.success != 0 || len(plan.groups) < 1 || plan.groups[0] != 1) return false;
				int category = 0;
				while (category < 4) {
					int receiver = plan.receiver; int success = plan.success; int group = plan.groups[0]; int parameters = plan.parameters;
					if (category == 0) plan.receiver = 0;
					if (category == 1) plan.success = 1;
					if (category == 2) plan.groups[0] = 0;
					if (category == 3) plan.parameters = parameters + 1;
					bool refused = !recover_abi_verify(plan, ssa.cfg.core.flow.checked);
					plan.receiver = receiver; plan.success = success; plan.groups[0] = group; plan.parameters = parameters;
					if (!refused || !recover_abi_verify(plan, ssa.cfg.core.flow.checked)) return false;
					category = category + 1;
				}
				abi_controls = 4;
			}
		}
		f = f + 1;
	}
	int cfg_controls = 0; int physical_controls = 0;
	bool case_guard = false; bool range_guard = false; bool argument = false; bool result = false; int b = 0;
	while (b < ssa.cfg.block_count) {
		var block = ssa.cfg.blocks[b];
		if (ssa.data.reachable[b] && block.origin > 0) {
			var row = ssa.cfg.core.nodes[block.origin - 1].value;
			if (block.opcode == 73 && !case_guard || block.opcode == 74 && !range_guard) {
				var condition = LLVMGetCondition(LLVMGetBasicBlockTerminator(module.blocks[b]));
				if (LLVMIsAInstruction(condition) != null) {
					ssa.cfg.blocks[b].rank = block.rank + 1;
					bool refused = !recover_cfg_verify(ssa.cfg);
					ssa.cfg.blocks[b].rank = block.rank;
					if (!refused || !module.check(ssa)) return false;
					cfg_controls = cfg_controls + 1;
					var constant = LLVMGetOperand(condition, 1);
					LLVMSetOperand(condition, 1, module.int32(block.rank + 1));
					refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
					LLVMSetOperand(condition, 1, constant);
					if (!refused || !module.check(ssa)) return false;
					physical_controls = physical_controls + 1;
					if (block.opcode == 73) case_guard = true;
					else {
						range_guard = true;
					}
				}
			}
			if (block.opcode == 4 && !argument) {
				var plan = new RecoverAbi(ssa.cfg.core.flow.checked, row.symbol); int at = 0;
				while (at < row.count && !argument) {
					int child = ssa.cfg.core.flow.data.edges[row.first + at];
					if (checked_kind(ssa.cfg.core.flow.checked, ssa.cfg.core.nodes[child - 1].value.type) == 32) {
						var call = module.operations[b]; int position = plan.groups[at]; var address = LLVMGetArgOperand(call, position);
						LLVMSetOperand(call, position, LLVMConstNull(module.pointer));
						bool refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
						LLVMSetOperand(call, position, address);
						if (!refused || !module.check(ssa)) return false;
						physical_controls = physical_controls + 1; argument = true;
					}
					at = at + 1;
				}
			}
			if (block.opcode == 22 && !result && checked_kind(ssa.cfg.core.flow.checked, ssa.cfg.core.flow.data.functions[block.function - 1].result) == 32) {
				var store = module.operations[b];
				if (store == null || LLVMGetInstructionOpcode(store) != 28) return false;
				var address = LLVMGetOperand(store, 1);
				LLVMSetOperand(store, 1, LLVMConstNull(module.pointer));
				bool refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
				LLVMSetOperand(store, 1, address);
				if (!refused || !module.check(ssa)) return false;
				physical_controls = physical_controls + 1; result = true;
			}
		}
		b = b + 1;
	}
	if (source_controls != 3 || cfg_controls != 2 || abi_controls != 4 || physical_controls != 4) return false;
	println("ENUM_TRANSPORT_CONTROLS source=3 cfg=2 abi=4 physical=4 restored=1");
	return true;
}

bool record_mutation_controls(RecoverLlvm module, RecoverSsa ssa) throws Error {
	if (!module.check(ssa)) return false;
	int n = 0; int source_controls = 0; int frame_controls = 0;
	while (n < ssa.cfg.core.flow.data.node_count && source_controls == 0) {
		var row = ssa.cfg.core.flow.data.nodes[n];
		if (row.kind == 75) {
			int flags = ssa.cfg.core.flow.checked.symbol_flags[row.symbol.index];
			ssa.cfg.core.flow.checked.symbol_flags[row.symbol.index] = 2;
			bool refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.checked.symbol_flags[row.symbol.index] = flags;
			if (!refused || !module.check(ssa)) return false;
			var declaration = ssa.cfg.core.flow.checked.bindings.symbol(row.symbol);
			var changed = declaration;
			changed.kind = 7;
			ssa.cfg.core.flow.checked.bindings.replace_instance_symbol(row.symbol, changed);
			refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.checked.bindings.replace_instance_symbol(row.symbol, declaration);
			if (!refused || !module.check(ssa)) return false;
			SyntaxTokenId absent = {index = 0};
			ssa.cfg.core.flow.data.nodes[n].token = absent;
			refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.data.nodes[n].token = row.token;
			if (!refused || !module.check(ssa)) return false;
			ssa.cfg.core.flow.data.mutable_symbols[row.symbol.index] = false;
			refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.data.mutable_symbols[row.symbol.index] = true;
			if (!refused || !module.check(ssa)) return false;
			int s = 0;
			while (s < ssa.cfg.core.flow.storage.count && frame_controls == 0) {
				var slot = ssa.cfg.core.flow.storage.slots[s];
				if (slot.function == row.function && slot.symbol.index != row.symbol.index && slot.type.index == ssa.cfg.core.flow.checked.symbol_types[row.symbol.index].index && recover_mutable(ssa.cfg.core.flow.data, slot.symbol)) {
					var address = module.owner_addresses[slot.symbol.index];
					module.owner_addresses[slot.symbol.index] = module.owner_addresses[row.symbol.index];
					refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
					module.owner_addresses[slot.symbol.index] = address;
					if (!refused || !module.check(ssa)) return false;
					frame_controls = 1;
				}
				s = s + 1;
			}
			source_controls = 4;
		}
		n = n + 1;
	}
	int cfg_controls = 0; int physical_controls = 0; bool projection = false; int b = 0;
	while (b < ssa.cfg.block_count) {
		var block = ssa.cfg.blocks[b];
		if (ssa.data.reachable[b] && block.origin > 0) {
			var row = ssa.cfg.core.nodes[block.origin - 1].value;
			if (block.opcode == 75 && cfg_controls == 0) {
				ssa.cfg.blocks[b].opcode = 42;
				bool refused = !recover_cfg_verify(ssa.cfg) && !recover_ssa_verify(ssa);
				ssa.cfg.blocks[b].opcode = block.opcode;
				if (!refused || !module.check(ssa)) return false;
				cfg_controls = 1;
				var store = module.operations[b]; var address = LLVMGetOperand(store, 1);
				LLVMSetOperand(store, 1, LLVMConstNull(module.pointer));
				refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
				LLVMSetOperand(store, 1, address);
				if (!refused || !module.check(ssa)) return false;
				var load = LLVMGetFirstInstruction(module.blocks[b]);
				LLVMSetOperand(load, 0, LLVMConstNull(module.pointer));
				refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
				LLVMSetOperand(load, 0, address);
				if (!refused || !module.check(ssa)) return false;
				var insertion = LLVMGetOperand(store, 0); var previous = LLVMGetOperand(insertion, 0);
				LLVMSetOperand(insertion, 0, LLVMConstNull(LLVMTypeOf(previous)));
				refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
				LLVMSetOperand(insertion, 0, previous);
				if (!refused || !module.check(ssa)) return false;
				physical_controls = physical_controls + 3;
			}
			if (block.opcode == 12 && row.a == 0 && recover_mutable(ssa.cfg.core.flow.data, row.symbol) && !projection) {
				var load = LLVMGetFirstInstruction(module.blocks[b]); var address = LLVMGetOperand(load, 0);
				LLVMSetOperand(load, 0, LLVMConstNull(module.pointer));
				bool refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
				LLVMSetOperand(load, 0, address);
				if (!refused || !module.check(ssa)) return false;
				projection = true; physical_controls = physical_controls + 1;
			}
		}
		b = b + 1;
	}
	if (source_controls != 4 || cfg_controls != 1 || physical_controls != 4 || frame_controls != 1) return false;
	println("RECORD_MUTATION_CONTROLS source=4 cfg=1 physical=4 restored=1 frames=1");
	return true;
}

bool record_array_mutation_controls(RecoverLlvm module, RecoverSsa ssa) throws Error {
	if (!module.check(ssa)) return false;
	int source_controls = 0; int n = 0;
	while (n < ssa.cfg.core.flow.data.node_count && source_controls == 0) {
		var row = ssa.cfg.core.flow.data.nodes[n];
		if (row.kind == 76) {
			ssa.cfg.core.flow.data.nodes[n].b = 0;
			bool refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.data.nodes[n].b = row.b;
			if (!refused || !module.check(ssa)) return false;
			ssa.cfg.core.flow.data.nodes[n].c = 0;
			refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.data.nodes[n].c = row.c;
			if (!refused || !module.check(ssa)) return false;
			SyntaxTokenId absent = {index = 0};
			ssa.cfg.core.flow.data.nodes[n].token = absent;
			refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.data.nodes[n].token = row.token;
			if (!refused || !module.check(ssa)) return false;
			var target = ssa.cfg.core.flow.checked.bindings.program.arena.get_node_target(row.source);
			var field = checked_target(ssa.cfg.core.flow.checked, target, row.token);
			var type = ssa.cfg.core.flow.checked.symbol_types[field.index];
			ssa.cfg.core.flow.checked.symbol_types[field.index] = type_id(14);
			refused = !recover_flow_verify(ssa.cfg.core.flow);
			ssa.cfg.core.flow.checked.symbol_types[field.index] = type;
			if (!refused || !module.check(ssa)) return false;
			source_controls = 4;
		}
		n = n + 1;
	}
	int b = 0;
	while (b < ssa.cfg.block_count) {
		var block = ssa.cfg.blocks[b];
		if (ssa.data.reachable[b] && block.opcode == 76) {
			var row = ssa.cfg.core.nodes[block.origin - 1].value;
			ssa.cfg.blocks[b].opcode = 61;
			bool refused = !recover_cfg_verify(ssa.cfg) && !recover_ssa_verify(ssa);
			ssa.cfg.blocks[b].opcode = block.opcode;
			if (!refused || !module.check(ssa)) return false;
			int guard = ssa.cfg.regions[row.b - 1].next;
			int next = ssa.cfg.blocks[guard - 1].next;
			ssa.cfg.blocks[guard - 1].next = b + 1;
			refused = !recover_cfg_verify(ssa.cfg) && !recover_ssa_verify(ssa);
			ssa.cfg.blocks[guard - 1].next = next;
			if (!refused || !module.check(ssa)) return false;
			var store = module.operations[b]; var address = LLVMGetArgOperand(store, 0);
			LLVMSetOperand(store, 0, LLVMConstNull(module.pointer));
			refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
			LLVMSetOperand(store, 0, address);
			if (!refused || !module.check(ssa)) return false;
			var load = LLVMGetFirstInstruction(module.blocks[b]);
			LLVMSetOperand(load, 0, LLVMConstNull(module.pointer));
			refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
			LLVMSetOperand(load, 0, address);
			if (!refused || !module.check(ssa)) return false;
			var insertion = LLVMGetArgOperand(store, 1); var previous = LLVMGetOperand(insertion, 0);
			LLVMSetOperand(insertion, 0, LLVMConstNull(LLVMTypeOf(previous)));
			refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
			LLVMSetOperand(insertion, 0, previous);
			if (!refused || !module.check(ssa)) return false;
			var call = module.operations[guard - 1]; var index = LLVMGetArgOperand(call, 2);
			u64 replacement = 1;
			if (LLVMIsAConstantInt(index) != null && LLVMConstIntGetZExtValue(index) != 0) replacement = 0;
			LLVMSetOperand(call, 2, LLVMConstInt(LLVMTypeOf(index), replacement, 0));
			refused = llvm12_verify(module.module) == 0 && !module.check(ssa);
			LLVMSetOperand(call, 2, index);
			if (!refused || !module.check(ssa) || source_controls != 4) return false;
			println("RECORD_ARRAY_MUTATION_CONTROLS source=4 cfg=2 physical=4 restored=1");
			return true;
		}
		b = b + 1;
	}
	return false;
}

int main(string[] args) {
	if (len(args) < 3 || args[1] != "--native" && args[1] != "--native-module" && args[1] != "--mutation-index-controls" && args[1] != "--shared-stages" && args[1] != "--template-cache-controls" && args[1] != "--record-value-controls" && args[1] != "--class-finalizer-controls" && args[1] != "--enum-transport-controls" && args[1] != "--record-mutation-controls" && args[1] != "--record-array-mutation-controls") return 9;
	bool library = args[1] == "--native-module";
	if ((args[1] == "--native" || library) && len(args) < 4) return 9;
	try {
		int start = 2; if (args[1] == "--native" || library) start = 3;
		var program = binding_load_program(args, start); var bindings = binding_index(move program, 0);
		var checked = checked_build_effects_profile(move bindings, 0);
		if (checked.failed()) {
			var observation = checked_observation(checked); print(observation.text); return 4;
		}
		var flow = recover_flow_lower_mode(move checked, 8192, library);
		var output = new Utf8ByteBuilder(); source_append_text(output, "RECOVER_FLOW "); append_int(output, flow.data.status); source_append_text(output, " "); append_int(output, flow.data.boundary.index); source_append_text(output, " "); append_int(output, flow.data.node_count);
		var text = output.snapshot(); println(text.text);
		if (flow.data.status != 0) {
			if (flow.data.boundary.index > 0) {
				var span_output = new Utf8ByteBuilder(); binding_write_span(flow.checked.bindings, flow.checked.bindings.program.arena.header(flow.data.boundary).span, span_output);
				var span_text = span_output.snapshot(); println(span_text.text);
			}
			return flow.data.status;
		}
		assert_that(recover_flow_verify(flow));
		if (args[1] == "--mutation-index-controls") {
			if (mutation_index_controls(flow)) return 42;
			return 13;
		}
		var core = recover_core_lower(move flow); if (core.status != 0) {
			println("RECOVER_CORE_INVALID");
			return 6;
		}
		var cfg = recover_cfg_lower(move core, 8192); if (cfg.status != 0) {
			println("RECOVER_CFG_INVALID");
			return 7;
		}
		var ssa = recover_ssa_lower(move cfg, 8000000); if (ssa.data.status != 0) {
			println("RECOVER_SSA_INVALID");
			return 8;
		}
		assert_that(recover_ssa_verify(ssa)); println("RECOVER_SSA_VALID");
		if (args[1] == "--shared-stages") return 42;
		var module = new RecoverLlvm(ssa); module.build(ssa);
		if (args[1] == "--enum-transport-controls") {
			if (enum_transport_controls(module, ssa)) return 42;
			return 14;
		}
		if (args[1] == "--record-array-mutation-controls") {
			if (record_array_mutation_controls(module, ssa)) return 42;
			return 16;
		}
		if (args[1] == "--record-mutation-controls") {
			if (record_mutation_controls(module, ssa)) return 42;
			return 15;
		}
		if (args[1] == "--record-value-controls") {
			if (record_value_controls(module, ssa)) return 42;
			return 11;
		}
		if (args[1] == "--template-cache-controls") {
			if (template_error_cache_controls(module, ssa)) return 42;
			return 10;
		}
		if (args[1] == "--class-finalizer-controls") {
			if (class_finalizer_controls(module, ssa)) return 42;
			return 12;
		}
		module.write(ssa, args[2]);
		println("RECOVER_LLVM_WRITTEN"); return 0;
	} catch (Error error) { println_stderr(error.message); return 5; }
}
