// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
class SparseMethods {
	int bias;

	init(int bias) {
		this.bias = bias;
	}

	int first(int input) {
		int value = input + 1;
		return value + this.bias;
	}

	int second(int input) {
		int value = input + 2;
		return value;
	}
}

int main() {
	var reader = new SparseMethods(0);
	return reader.first(39) + reader.second(0);
}
