// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
struct ConstructorCell {
	int value;
}

class ConstructorInput {
	owned ConstructorCell[] cells;
	private int limit;

	init(int value) {
		this.cells = new ConstructorCell[1];
		this.limit = 1;
		ConstructorCell cell = {value = value};
		this.cells[0] = cell;
	}

	ConstructorCell read(int index) {
		return this.cells[index];
	}

	property int count {
		get { return this.limit; }
	}

	property int doubled {
		get { return this.limit + this.limit; }
	}
}

class ConstructorStorage {
	int value;
	bool active;

	init(int value) {
		this.value = value;
		this.active = true;
	}
}

owned ConstructorStorage constructor_storage(int value) {
	var storage = new ConstructorStorage(value);
	return move storage;
}

bool constructor_check(ConstructorInput input, bool fail) throws Error {
	if (fail) {
		throw new Error("constructor");
	}
	return input.count == 1;
}

class ConstructorChannels {
	owned ConstructorStorage storage;
	ConstructorCell cell;

	init(ConstructorInput input, bool fail) {
		var first = input.cells[0];
		var second = input.read(0);
		bool valid = false;
		try {
			valid = constructor_check(input, fail);
		} catch (Error error) {
			valid = false;
		}
		var storage = constructor_storage(first.value + second.value + input.count + input.doubled);
		storage.active = !valid;
		this.storage = move storage;
		this.cell = first;
	}

	int result() {
		if (this.storage.active) return 3;
		return this.storage.value + this.cell.value;
	}
}

int main() {
	var input = new ConstructorInput(13);
	var channels = new ConstructorChannels(input, false);
	var rejected = new ConstructorChannels(input, true);
	if (rejected.result() != 3) return 4;
	return channels.result();
}
