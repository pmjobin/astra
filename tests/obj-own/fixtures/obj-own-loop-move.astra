extern(C) int life_record(int code, int value);

class Counter {
	int value;

	init(int value) { this.value = value; }

	deinit() { life_record(this.value, 0); }

	void add(int n) { this.value = this.value + n; }
}

void sink(owned Counter c) { c.add(1); }

void consume(owned Counter c) { while (true) {
		sink(move c);
		break;
	} }

int main() { owned Counter c = Counter.init(41); consume(move c); return 42; }
