extern(C) int life_record(int code, int value);
class Counter {
	int value;
	init(int value) { this.value = value; }
	deinit() { life_record(this.value, 0); }
	void add(int n) { this.value = this.value + n; }
}
class Destination {
	int value;
	init(owned Counter source) {
		if (source != null) { this.value = source.value + 1; }
		else { this.value = 78; }
	}
	deinit() { life_record(this.value, 0); }
}
int main() {
	owned Counter source = Counter.init(41);
	owned Destination target = Destination.init(move source);
	owned Destination empty = Destination.init(null);
	return target.value;
}
