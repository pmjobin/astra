extern(C) int life_record(int code, int value);
class Counter {
	int value;
	init(int value) { this.value = value; }
	deinit() { life_record(this.value, 0); }
	void add(int n) { this.value = this.value + n; }
}
int zero() { return 0; }
void consume(owned Counter c) { life_record(84, 0); c.value = 1 / zero(); }
int main() { owned Counter c = Counter.init(42); consume(move c); return 42; }
