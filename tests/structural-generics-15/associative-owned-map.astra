// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
struct OwnedMapKey {
	i64 domain;
	int code;
}

bool same_owned_key(OwnedMapKey left, OwnedMapKey right) {
	return left.domain == right.domain && left.code == right.code;
}

class OwnedMapPayload {
	private owned R first;
	private owned R second;
	private int code;
	init(owned R first, owned R second, int code) {
		this.first = move first;
		this.second = move second;
		this.code = code;
	}
	bool check(int code, int first, int second) {
		return this.code == code && id(this.first) == first && id(this.second) == second;
	}
	deinit() { mark(200 + this.code); }
}

bool read_payload(borrowed OwnedMapPayload value, int code, int first, int second) {
	return value.check(code, first, second);
}

int exercise() {
	var cache = new Cache<OwnedMapKey, Box<OwnedMapPayload>>(same_owned_key);
	for (int index = 0; index < 5; index = index + 1) {
		OwnedMapKey key = {domain = 7000000001, code = index};
		var first = make(121 + index * 2);
		var second = make(122 + index * 2);
		var payload = new OwnedMapPayload(move first, move second, index * 10);
		var value = new Box<OwnedMapPayload>(move payload);
		if (!cache.put(key, move value)) { return 1; }
	}
	OwnedMapKey zero = {domain = 7000000001, code = 0};
	OwnedMapKey two = {domain = 7000000001, code = 2};
	OwnedMapKey other = {domain = 7000000002, code = 2};
	if (!cache.contains(two) || cache.contains(other) || cache.count != 5) { return 2; }
	var first = make(131);
	var second = make(132);
	var payload = new OwnedMapPayload(move first, move second, 99);
	var replacement = new Box<OwnedMapPayload>(move payload);
	if (!cache.put(two, move replacement) || cache.count != 5 || live() != 10) { return 3; }
	var extracted = cache.remove(zero);
	if (extracted == null || extracted.key.code != 0 || !read_payload(extracted.view.view, 0, 121, 122)) { return 4; }
	release extracted;
	var missing = cache.remove(other);
	if (missing != null || cache.count != 4 || cache.hit_count != 1 || cache.miss_count != 1 || cache.revision != 7 || live() != 8) { return 5; }
	return 0;
}

int main() {
	int result = exercise();
	if (result != 0) { return result; }
	return live();
}
