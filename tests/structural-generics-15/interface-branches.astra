// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
interface Category { int classify(int input); }
class Ranges : Category {
	init() : base() {}
	override int classify(int input) {
		if (input >= 65 && input <= 90 || input >= 97 && input <= 122) { return 1; }
		if (input >= 48 && input <= 57) { return 2; }
		return 0;
	}
}
class Configured : Category {
	private int first;
	private int last;
	init(int first, int last) : base() { this.first = first; this.last = last; }
	override int classify(int input) {
		if (input >= this.first && input <= this.last) { return 1; }
		return 0;
	}
}
int evaluate(borrowed Category category, int input) { return category.classify(input); }
class Table : Category {
	private owned int[] values;
	init(owned int[] values) : base() { this.values = move values; }
	override int classify(int input) {
		if (input < 0 || input > 255) { return 0; }
		return this.values[input];
	}
}
int main() {
	var ranges = new Ranges();
	var configured = new Configured(40, 60);
	var values = new int[256];
	for (int input = 0; input < 256; input = input + 1) { values[input] = input % 3; }
	var table = new Table(move values);
	for (int input = -1; input < 257; input = input + 1) {
		int expected = 0;
		if (input >= 65 && input <= 90 || input >= 97 && input <= 122) { expected = 1; }
		else { if (input >= 48 && input <= 57) { expected = 2; } }
		if (evaluate(ranges, input) != expected) { return 1; }
		int configured_expected = 0;
		if (input >= 40 && input <= 60) { configured_expected = 1; }
		if (evaluate(configured, input) != configured_expected) { return 2; }
		int table_expected = 0;
		if (input >= 0 && input < 256) { table_expected = input % 3; }
		if (evaluate(table, input) != table_expected) { return 3; }
	}
	return 0;
}
