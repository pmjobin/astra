// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
class LexicalCell<T, U> {
	owned T payload;
	U tag;
	private int code;
	init(owned T payload, U tag, int code) {
		this.payload = move payload;
		this.tag = tag;
		this.code = code;
	}
	deinit() { mark(this.code); }
}

struct LexicalOwners {
	owned R first;
	owned R second;
	int stamp;
}

class LexicalChild {
	owned R first;
	owned R second;
	init(owned R first, owned R second) {
		this.first = move first;
		this.second = move second;
	}
	deinit() { mark(300); }
}

owned LexicalCell<int, int> construct_number(int value) {
	return LexicalCell<int, int>.init(value, 99, 202);
}

owned LexicalCell<LexicalOwners, bool> construct_owners() {
	var first = make(141);
	var second = make(142);
	LexicalOwners payload = {first = move first, second = move second, stamp = 42};
	return LexicalCell<LexicalOwners, bool>.init(move payload, true, 204);
}

int consume_number(owned LexicalCell<int, int> value) { return value.payload; }

int exercise_construction() {
	var inferred = LexicalCell<int, bool>.init(42, true, 201);
	owned LexicalCell<int, int> returned = construct_number(42);
	owned LexicalCell<int, bool> explicit_value = LexicalCell<int, bool>.init(42, true, 203);
	owned LexicalCell<LexicalOwners, bool> owners = construct_owners();
	var first = make(143);
	var second = make(144);
	var child = new LexicalChild(move first, move second);
	var parent = LexicalCell<LexicalChild, int>.init(move child, 42, 205);
	var heap = new LexicalCell<int, int>(42, 42, 206);
	var outer = LexicalCell<LexicalCell<int, int>, bool>.init(move heap, true, 207);
	if (inferred.payload != 42 || !inferred.tag || returned.payload != 42 || returned.tag != 99) { return 1; }
	if (explicit_value.payload != 42 || owners.payload.stamp != 42 || !owners.tag) { return 2; }
	if (parent.tag != 42 || outer.payload.payload != 42) { return 3; }
	if (consume_number(move returned) != 42) { return 4; }
	return 0;
}

int main() {
	int result = exercise_construction();
	if (result != 0) { return result; }
	return live();
}
