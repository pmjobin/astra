namespace NativeClassResults;

struct Seed<A,B> { A value; B ready; }
class Cargo<A,B> {
	private A seed;
	private B extra;
	private owned R retained;
	private owned int[] samples;
	init(A seed, B extra, int ticket) {
		var retained = make(ticket);
		var samples = new int[2];
		samples[0] = ticket;
		samples[1] = ticket + 10;
		this.seed = seed;
		this.extra = extra;
		this.retained = move retained;
		this.samples = move samples;
	}
	property A state { get { return this.seed; } }
	property B additional { get { return this.extra; } }
	int sample() { return this.samples[1]; }
	deinit() { mark(870); }
}
internal owned Cargo<Seed<int,bool>,int> create(int ticket) {
	Seed<int,bool> seed = {value = ticket, ready = true};
	var value = new Cargo<Seed<int,bool>,int>(seed, ticket + 1, ticket);
	return move value;
}
Fn<owned Cargo<Seed<int,bool>,int>,int> callback() { return create; }
owned Cargo<Seed<int,bool>,int> invoke(Fn<owned Cargo<Seed<int,bool>,int>,int> code, int ticket) {
	var value = code(ticket);
	return move value;
}
