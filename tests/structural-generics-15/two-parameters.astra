class Pair<A,B> {
	A first;
	B second;
	init(A first, B second) {
		this.first = first;
		this.second = second;
	}
	A left() { return this.first; }
	B right() { return this.second; }
}

int main() {
	var pair = new Pair<int,bool>(42, true);
	if (!pair.right()) { return 1; }
	return pair.left() - 42;
}
