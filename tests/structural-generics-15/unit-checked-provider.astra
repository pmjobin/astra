namespace CheckedLibrary;

[ExceptionRoot]
class Error {
	readonly string text;

	init(string message) { this.text = message; }

	virtual property string message { get { return this.text; } }
}

class Failure : Error {
	init(string message) : base(message) {}
}

struct Reply<T> { T value; bool ready; }

Reply<int> analyze(int input, bool fail) throws Error {
	if (fail) {
		throw new Failure("producer failure");
	}
	Reply<int> result = {value = input + 2, ready = true};
	return result;
}

int message_length(borrowed Error value) { return value.message.byte_length; }
