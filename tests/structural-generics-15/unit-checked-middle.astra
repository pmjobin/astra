namespace CheckedMiddle;

CheckedLibrary.Reply<int> analyze(int input, bool fail) throws CheckedLibrary.Error {
	return CheckedLibrary.analyze(input, fail);
}

int message_length(borrowed CheckedLibrary.Error value) {
	return CheckedLibrary.message_length(value);
}
