namespace DeclaredUnits;

struct Stats {
	int count;
	i64 wide;
	bool ready;
}

internal struct ProducerNote<T> { T value; }

struct Coupled<A, B> {
	A first;
	B second;
	bool ready;
}

Coupled<Stats, int> coupled(int value) {
	Stats first = {count = value, wide = 9000000001, ready = true};
	Coupled<Stats, int> result = {first = first, second = value + 50, ready = true};
	return result;
}

Coupled<Coupled<Stats, int>, bool> nested_coupled(int value) {
	var first = coupled(value);
	Coupled<Coupled<Stats, int>, bool> result = {first = first, second = true, ready = true};
	return result;
}

owned PairBox<Coupled<Stats, int>, bool> boxed_coupled(int value) {
	var first = coupled(value);
	var result = new PairBox<Coupled<Stats, int>, bool>(first, true);
	return move result;
}

class PairBox<A, B> {
	private A first;
	private B second;
	private int generation;

	init(A first, B second) {
		this.first = first;
		this.second = second;
		this.generation = 1;
	}

	A read() {
		if (this.generation > 0) return this.first;
		return this.first;
	}

	B other() { return this.second; }

	property A value { get { return this.first; } }

	property B alternative { get { return this.second; } }

	property int version {
		get { return this.generation; }
		set(int value) { this.generation = value; }
	}

	int advance(int amount) {
		this.generation = this.generation + amount;
		return this.generation;
	}
}

owned PairBox<int, bool> number(int value) {
	var result = new PairBox<int, bool>(value + 2, true);
	return move result;
}

owned PairBox<Stats, int> record(int value) {
	Stats first = {count = value, wide = 9000000001, ready = true};
	var result = new PairBox<Stats, int>(first, value + 5);
	return move result;
}

class Leaf {
	private int value;

	init(int value) { this.value = value; }

	int read() { return this.value; }
}

struct Carrier {
	owned Leaf child;
	owned int[] values;
	int tag;
}

class OwnerBox<T> {
	private owned T payload;
	private int tag;

	init(owned T payload, int tag) {
		this.payload = move payload;
		this.tag = tag;
	}

	int tagged() { return this.tag; }

	property borrowed T view { get { return this.payload; } }
}

owned OwnerBox<Leaf> native_owner(int value) {
	var child = new Leaf(value);
	var result = new OwnerBox<Leaf>(move child, value + 10);
	return move result;
}

owned OwnerBox<PairBox<Stats, int>> nested_owner(int value) {
	var child = record(value);
	var result = new OwnerBox<PairBox<Stats, int>>(move child, value + 20);
	return move result;
}

owned OwnerBox<Carrier> record_owner(int value) {
	var child = new Leaf(value);
	var values = new int[3];
	values[0] = value;
	Carrier payload = {child = move child, values = move values, tag = value};
	var result = new OwnerBox<Carrier>(move payload, value + 30);
	return move result;
}

owned Leaf relay_leaf(owned Leaf value) { return move value; }
