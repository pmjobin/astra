namespace NativeGenericConsume;
class Cargo<A, B> {
	private A code;
	private B ready;
	private owned R retained;

	init(A code, B ready, int ticket) {
		var retained = make(ticket);
		this.code = code;
		this.ready = ready;
		this.retained = move retained;
	}

	property A value { get { return this.code; } }

	property B enabled { get { return this.ready; } }

	deinit() { mark(975); }
}

owned Cargo<int, bool> create(int ticket) {
	var result = new Cargo<int, bool>(40, true, ticket);
	return move result;
}

internal int retire(owned Cargo<int, bool> value, int extra) {
	if (!value.enabled) return 0;
	return value.value + extra;
}

internal int retire_resource(owned R value, int extra) { return id(value) + extra; }

Fn<int, owned Cargo<int, bool>, int> callback() { return retire; }

Fn<int, owned R, int> resource_callback() { return retire_resource; }

int invoke(Fn<int, owned Cargo<int, bool>, int> code, owned Cargo<int, bool> value, int extra) { return code(move value, extra); }

int invoke_resource(Fn<int, owned R, int> code, owned R value, int extra) { return code(move value, extra); }
