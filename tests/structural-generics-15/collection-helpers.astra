class HelperItem {
	int code;
	init(int code) { this.code = code; }
	deinit() { mark(this.code); }
}

owned Bag<HelperItem> create_collection() {
	var values = new Bag<HelperItem>();
	return move values;
}

int collection_size<Tag>(Bag<HelperItem> values, Tag ignored) {
	return values.count();
}

void* collection_pointer(Bag<HelperItem> values) { return null; }

bool inspect_item(HelperItem item, int code) { return item.code == code; }

void consume_collection(owned Bag<HelperItem> values) {
	mark(300 + values.count());
}

int main() {
	var values = create_collection();
	if (!values.reserve(2)) { return 1; }
	var first = new HelperItem(10);
	values.append(move first);
	var second = new HelperItem(20);
	values.append(move second);
	var replacement = new HelperItem(30);
	values.replace(0, move replacement);
	if (collection_size<bool>(values, true) != 2 || collection_size<int>(values, 42) != 2) { return 2; }
	if (!inspect_item(values.entries[0], 30) || collection_pointer(values) != null) { return 3; }
	var extracted = values.take(1);
	if (extracted.code != 20) { return 4; }
	release extracted;
	consume_collection(move values);
	return live();
}
