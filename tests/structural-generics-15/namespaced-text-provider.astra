namespace NamespacedText;
[ExceptionRoot]
class Error {
	readonly string text;

	init(string message) { this.text = message; }

	virtual property string message { get { return this.text; } }
}

class Utf8Message {
	readonly string snapshot;

	init(string input) { this.snapshot = input; }

	property string text { get { return this.snapshot; } }
}

class InvalidUtf8 : Error { init() : base("invalid UTF-8") {} }

[Utf8MessageFactory]
owned Utf8Message utf8_message(u8[] bytes) throws InvalidUtf8;
