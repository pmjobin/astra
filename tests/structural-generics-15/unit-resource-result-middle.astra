namespace ResourceResultTransport;

Fn<owned R,int> callback() { return NativeResourceResults.callback(); }

owned R apply(Fn<owned R,int> code, int tag) {
	var value = NativeResourceResults.invoke(code, tag);
	return move value;
}

owned R direct(int tag) {
	Fn<owned R,int> code = NativeResourceResults.callback();
	var value = code(tag);
	return move value;
}
