// Exact declaration-only source from tests/gen-struct/semantic.vala.
struct Box<T>{T value;}struct Pair<T,U>{T first;U second;}struct S{int value;}class C{}class D{Box<int> value;}

class InitializedRecords {
	Box<int> first;
	Pair<int, bool> second;
	Box<Box<i64>> nested;
	init(Box<int> first, Pair<int, bool> second, Box<Box<i64>> nested) {
		this.first = first;
		this.second = second;
		this.nested = nested;
	}
	property Box<int> value { get { return this.first; } }
	property Pair<int, bool> pair { get { return this.second; } }
	property Box<Box<i64>> deep { get { return this.nested; } }
}

int main() {
	Box<int> first = {value=42};
	Pair<int, bool> second = {first=19, second=true};
	Box<Box<i64>> nested = {value={value=73}};
	var stored = new InitializedRecords(first, second, nested);
	first.value = 7;
	Box<int> copy = stored.value;
	copy.value = 99;
	if (stored.value.value != 42 || stored.pair.first != 19 || !stored.pair.second || stored.deep.value.value != (73 as i64)) { return 1; }
	if (first.value != 7 || copy.value != 99) { return 2; }
	return 0;
}
