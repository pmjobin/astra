namespace StructuralOwners;

Composite10.Envelope relay(Composite10.Envelope value) {
	var next = Composite10.relay(move value);
	return move next;
}

int consume(Composite10.Envelope value, int extra) {
	return Composite10.consume(move value, extra);
}
