namespace ReadMiddle;
int inspect(borrowed ReadLibrary.Payload<int> value) {
	var snapshot = value.snapshot;
	return snapshot.value + value.value + snapshot.generation;
}

int mutate(borrowed ReadLibrary.Payload<int> value) {
	value.value = 99;
	return value.value;
}
