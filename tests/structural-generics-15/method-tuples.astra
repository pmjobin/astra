// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
struct Pair {
	int code;
	i64 total;
}

class Box<T, Tag> {
	owned T payload;
	Tag label;

	init(owned T value, Tag label) {
		this.payload = move value;
		this.label = label;
	}

	U choose_value<U, V>(U first, V ignored) { return first; }

	V combine<U, V>(U ignored, V second) { return second; }

	W third<U, V, W>(U first, V second, W last) { return last; }

	int phantom<U, V>() { return 7; }
}

int main() {
	var box = new Box<int, bool>(42, true);
	Pair pair = {code = 17, total = 9000000000};
	int first = box.choose_value<int, bool>(42, false);
	int second = box.choose_value<int, Pair>(8, pair);
	bool chosen = box.choose_value<bool, int>(true, 7);
	Pair copied = box.combine<int, Pair>(0, pair);
	i64 last = box.third<int, bool, i64>(3, false, 9000000000);
	if (first != 42 || second != 8 || !chosen) return 1;
	if (copied.code != 17 || copied.total != last) return 2;
	if (box.phantom<int, Pair>() != box.phantom<int, bool>()) return 3;
	return box.payload - 42;
}
