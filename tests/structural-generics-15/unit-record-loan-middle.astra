namespace RecordLoanTransport;
Fn<int,borrowed NativeRecordLoans.Packet,borrowed R,int> callback() { return NativeRecordLoans.callback(); }
int apply(Fn<int,borrowed NativeRecordLoans.Packet,borrowed R,int> code, borrowed NativeRecordLoans.Packet value, borrowed R token, int extra) { return NativeRecordLoans.invoke(code, value, token, extra); }
