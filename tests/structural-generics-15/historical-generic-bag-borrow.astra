class Item{int value;init(int value){this.value=value;}}
class Other{init(){}}
bool read(Item item,int value){return item.value==value;}
bool inspect(Bag<Item> bag,int index,int value){return read(bag.entries[index],value);}
void loan<T>(borrowed T item) where T:Ownable{}int main(){var bag=new Bag<Item>();loan<Bag<Item>>(bag);return 0;}
