bool middle(i8 start, u32 count) {
	int[8] storage = {0, 1, 2, 3, 4, 5, 6, 7};
	int[] s = slice(storage, start, count);
	if (len(s) != 4) return false;
	int i = 0;
	while (i < len(s)) {
		if (s[i] != i + 2) return false;
		i = i + 1;
	}
	s[0] = 42;
	return storage[2] == 42;
}

int main() { if (!middle(2, 4)) return 1; return 0; }
