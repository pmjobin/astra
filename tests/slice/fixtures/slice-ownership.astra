int scenario(int i) {
	owned Resource r = create_resource(1);
	int[4] a_storage = {1, 2, 3, 4};
	int[] a = slice(a_storage);
	resource_touch(r);
	a[i] = a[i] + 40;
	return a[i];
}

int take_index(owned Resource r) { return 0; }

bool use_prior(bool prior, int value) { return prior && value == 1; }

bool transfer_index(bool argument) {
	owned Resource r = create_resource(1);
	int[1] a_storage = {1};
	int[] a = slice(a_storage);
	if (argument) return use_prior(r != null, a[take_index(move r)]);
	return (r != null) & (a[take_index(move r)] == 1);
}

int take_count(owned Resource r) { return 1; }

bool transfer_range(bool count) {
	owned Resource r = create_resource(1);
	int[2] a = {1, 2};
	if (count) return use_prior(r != null, len(slice(a, 0, take_count(move r))));
	return use_prior(r != null, len(slice(a, take_index(move r), 1)));
}

int main() {
	resource_reset();
	if (scenario(1) != 42) return 1;
	if (resource_destroy_count() != 1 || resource_destroy_order() != 1 || resource_live_count() != 0 || resource_error_count() != 0 || resource_touch_count() != 1) return 2;
	resource_reset();
	if (!transfer_index(false)) return 3;
	if (resource_destroy_count() != 1 || resource_live_count() != 0 || resource_error_count() != 0) return 4;
	resource_reset();
	if (!transfer_index(true)) return 5;
	if (resource_destroy_count() != 1 || resource_live_count() != 0 || resource_error_count() != 0) return 6;
	resource_reset();
	if (!transfer_range(false)) return 7;
	if (resource_destroy_count() != 1 || resource_live_count() != 0 || resource_error_count() != 0) return 8;
	resource_reset();
	if (!transfer_range(true)) return 9;
	if (resource_destroy_count() != 1 || resource_live_count() != 0 || resource_error_count() != 0) return 10;
	resource_reset();
	int[1] storage = {0};
	{
		owned Resource scoped = create_resource(1);
		int[] view = slice(storage);
		view[0] = 42;
		resource_touch(scoped);
	}
	if (storage[0] != 42 || resource_destroy_count() != 1 || resource_live_count() != 0 || resource_error_count() != 0) return 11;
	int i = 0;
	while (i < 2) {
		{
			owned Resource looped = create_resource(1);
			int[] view = slice(storage);
			view[0] = view[0] + 1;
			resource_touch(looped);
			i = i + 1;
			if (i == 1) continue;
			break;
		}
	}
	if (storage[0] != 44 || resource_destroy_count() != 3 || resource_live_count() != 0 || resource_error_count() != 0) return 12;
	return 0;
}
