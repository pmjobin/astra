bool dsp(int i) {
	i8<16> a = splat(-128, 16);
	i8<16> b = splat(127, 16);
	i8<16>[2] blocks_storage = {a, b};
	i8<16>[] blocks = slice(blocks_storage);
	blocks[i] = sat_add(blocks[0], blocks[1]);
	if (!all(blocks[i] == splat(-1, 16))) return false;
	blocks[i] = blocks[i] >> 1;
	i16<8> low = widen_low(blocks[i], i16);
	i16<8> high = widen_high(blocks[i], i16);
	i16<8>[2] wide_storage = {low, high};
	i16<8>[] wide = slice(wide_storage);
	blocks[i] = pack_sat(wide[0], wide[1], i8);
	blocks[i] = interleave_low(blocks[i], splat(1, 16));
	if (blocks[i][0] != -1 || blocks[i][1] != 1) return false;
	blocks[i] = (blocks[i] & splat(15, 16)) ^ splat(3, 16);
	return blocks[i][0] == 12 && blocks[i][1] == 2;
}

void dot_to(f32* out, int i, int j) {
	f32<4> a = {1.0, 2.0, 3.0, 4.0};
	f32<4> b = {5.0, 6.0, 7.0, 8.0};
	f32<4>[2] blocks_storage = {a, b};
	f32<4>[] blocks = slice(blocks_storage);
	*out = dot(blocks[i], blocks[j]);
}

f32 strict(int i) {
	f32<4> a = {16777216.0, 1.0, -16777216.0, 1.0};
	f32<4> b = splat(1.0, 4);
	f32<4>[2] blocks_storage = {a, b};
	f32<4>[] blocks = slice(blocks_storage);
	return dot(blocks[i], blocks[1]);
}

int main() {
	u8[2] bits_storage = {128, 255};
	u8[] bits = slice(bits_storage);
	bits[0] = bits[0] >> 1;
	bits[1] = ((bits[1] & 240) ^ 3) << 1;
	if (bits[0] != 64 || bits[1] != 230) return 5;
	if (!dsp(0) || !dsp(1)) return 1;
	f32 out = 0.0;
	dot_to(&out, 0, 1);
	if (out != 70.0 || strict(0) != 1.0) return 2;
	i16<8> v = splat(2, 8);
	i16<8>[2] a_storage = {v, v};
	i16<8>[] a = slice(a_storage);
	if (dot_wrap(a[0], a[1], int) != 32 || mac_wrap(3, a[0], a[1]) != 35) return 3;
	f32<4> x = splat(2.0, 4);
	f32<4>[1] b_storage = {x};
	f32<4>[] b = slice(b_storage);
	if (mac(3.0, b[0], b[0]) != 19.0) return 4;
	return 0;
}
