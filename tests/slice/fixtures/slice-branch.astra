int choose(bool condition, int start) {
	int[4] a = {1, 2, 3, 4};
	int[8] b = {5, 6, 7, 8, 9, 10, 11, 12};
	int[] s = slice(a);
	if (condition) { s = slice(b, start, 8 - start); }
	return len(s) * 100 + s[0];
}
int main() {
	if (choose(false, 0) != 401 || choose(true, 0) != 805 || choose(true, 2) != 607) { return 1; }
	return 0;
}
