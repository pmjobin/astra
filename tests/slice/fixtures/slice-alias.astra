int main() {
	int[6] storage = {1, 2, 3, 4, 5, 6};
	int[] a = slice(storage, 0, 4);
	int[] b = slice(storage, 2, 4);
	int[] copy = a;
	a[2] = 99;
	if (b[0] != 99 || copy[2] != 99 || storage[2] != 99) return 1;
	b[1] = 77;
	if (a[3] != 77 || copy[3] != 77) return 2;
	{
		int[] inner = copy;
		inner[0] = 42;
	}
	if (a[0] != 42) return 3;
	return 0;
}
