int sum(borrowed int[] values) {
	int result = 0;
	int i = 0;
	while (i < len(values)) {
		result = result + values[i];
		i = i + 1;
	}
	return result;
}
int main() {
	int[4] a = {1,2,3,4};
	int[8] b = {1,2,3,4,5,6,7,8};
	int sa = sum(slice(a));
	int sb = sum(slice(b));
	return sa + sb;
}
