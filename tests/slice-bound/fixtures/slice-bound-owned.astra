int start(borrowed Resource r) { return resource_id(r)-4; }

void consume(owned Resource r, borrowed int[] s, int later) {
	if (resource_is_live(r) != 1 || len(s) != 2 || later != 7) {
		s[0] = -1;
	}
	else {
		s[0] = resource_id(r);
	}
}

void scenario() {
	owned Resource r = create_resource(4);
	int[4] a = {1,2,3,4};
	int[] s = slice(a,start(r),2);
	consume(move r,s,7);
	if (len(s) != 2 || s[0] != 4 || a[0] != 4) create_error();
	r = create_resource(5);
	consume(move r,slice(a,1,2),7);
	if (a[1] != 5) create_error();
}

void create_error() { owned Resource extra = create_resource(9); }

int main() {
	resource_reset();
	scenario();
	if (resource_create_count() != 2 || resource_destroy_count() != 2 || resource_destroy_order() != 45 || resource_live_count() != 0 || resource_error_count() != 0) return 1;
	return 0;
}
