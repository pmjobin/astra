int length(borrowed int[] s) { return len(s); }

int choose(borrowed int[] a, borrowed int[] b, bool pick) {
	int[] local = a;
	if (pick) local = b;
	int result = length(local);
	int i = 0;
	while (i < 3) {
		result = result + length(local) + local[0];
		local = b;
		i = i + 1;
	}
	return result;
}

int main() {
	int[4] a = {1,2,3,4};
	int[8] b = {5,6,7,8,9,10,11,12};
	if (choose(slice(a),slice(b),false) != 35 || choose(slice(a),slice(b),true) != 47) return 1;
	return 0;
}
