// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
owned SourceSet language_sources(string text) throws Error {
	var bytes = new u8[text.byte_length];
	int i = 0;
	while (i < len(bytes)) {
		bytes[i] = astra_host_text_byte(text, i) as u8;
		i = i + 1;
	}
	var buffer = source_buffer("input", move bytes, false);
	var retained = shared_acquire(move buffer);
	var entries = new Vector<SourceEntry>(1);
	var entry = new SourceEntry(move retained);
	assert_that(entries.append(move entry));
	var sources = source_set(move entries);
	return move sources;
}

owned SyntaxProgram language_program(string text) throws Error {
	var sources = language_sources(text);
	var result = syntax_program(move sources);
	return move result;
}

void language_literals() throws Error {
	var hex = syntax_integer_magnitude("0xffff_ffff_ffff_ffff", 18446744073709551615, true);
	assert_that(hex.valid && hex.value == 18446744073709551615);
	var binary = syntax_integer_magnitude("0b1010_1100", 255, true);
	assert_that(binary.valid && binary.value == 172);
	var separated = syntax_integer_magnitude("8_000_000", 8000000, true);
	assert_that(separated.valid && separated.value == 8000000);
	var minimum = syntax_integer_magnitude("0x8000_0000_0000_0000", 9223372036854775808, true);
	assert_that(minimum.valid && minimum.value == 9223372036854775808);
	assert_that(!syntax_integer_magnitude("0x8000_0000_0000_0000", 9223372036854775807, true).valid);
	assert_that(!syntax_integer_magnitude("0x1_0000_0000_0000_0000", 18446744073709551615, true).valid);
	assert_that(!syntax_integer_magnitude("18446744073709551616", 18446744073709551615, true).valid);
	assert_that(!syntax_integer_magnitude("0b2", 255, true).valid);
	assert_that(!syntax_integer_magnitude("0x", 255, true).valid);
	assert_that(!syntax_integer_magnitude("0x_ff", 255, true).valid);
	assert_that(!syntax_integer_magnitude("1__0", 255, true).valid);
	assert_that(!syntax_integer_magnitude("_10", 255, true).valid);
	assert_that(!syntax_integer_magnitude("10_", 255, true).valid);
	assert_that(!syntax_integer_magnitude("1", 0, true).valid);
	assert_that(!syntax_integer_magnitude("", 255, true).valid);
	assert_that(!syntax_integer_magnitude("0xff", 255, false).valid);
	assert_that(!syntax_integer_magnitude("1_0", 255, false).valid);
	var good = language_program("language astra27b; u64 bits() { return 0xffff_ffff_ffff_ffff; } int value() { return 0b10_1010 + 8_000_000; }");
	assert_that(!good.failed() && syntax_program_languages_verified(good));
	var bad_prefix = language_program("language astra27b; int value() { return 0x; }");
	assert_that(bad_prefix.failed());
	var bad_binary = language_program("language astra27b; int value() { return 0b2; }");
	assert_that(bad_binary.failed());
	var bad_adjacent = language_program("language astra27b; int value() { return 1__0; }");
	assert_that(bad_adjacent.failed());
	var bad_suffix = language_program("language astra27b; int value() { return 42u; }");
	assert_that(bad_suffix.failed());
	var bad_float = language_program("language astra27b; f64 value() { return 1_0.5; }");
	assert_that(bad_float.failed());
	var old_hex = language_program("int value() { return 0xff; }");
	assert_that(old_hex.failed());
	var old_separated = language_program("language legacy27a; int value() { return 1_000; }");
	assert_that(old_separated.failed());
	var floats = language_program("language astra27b; f64 value() { return 1.5e+2d; }");
	assert_that(!floats.failed());
	var sources = language_sources("language astra27b; 0b10_1010");
	var backing = sources.source(0);
	var scanner = lexer(move backing);
	var first = scanner.next_token();
	var second = scanner.next_token();
	var third = scanner.next_token();
	assert_that(scanner.modern);
	var fork = scanner.fork();
	var literal = scanner.next_token();
	var fork_literal = fork.next_token();
	var kind = literal.kind();
	assert_that(kind == TokenKind.INTEGER() && literal.spelling.text == "0b10_1010" && literal.span.start == 19 && literal.span.end == 28);
	assert_that(fork_literal.spelling.text == literal.spelling.text && fork_literal.span.start == literal.span.start && fork_literal.span.end == literal.span.end);
}

void language_small_syntax() throws Error {
	var functions = language_program("language astra27b; int add(int x, int y,) => x+y; int value() { return add(20,22,); } void action() { } void concise() => action();");
	assert_that(!functions.failed() && syntax_program_languages_verified(functions));
	var generic = language_program("language astra27b; T identity<T,>(T x,) { return x; } int value() { return identity<int,>(42,); }");
	assert_that(!generic.failed());
	var nested_generic = language_program("language astra27b; class Box<T,> { } Box<Box<int,>,> identity(Box<Box<int,>,> value,) { return value; }");
	assert_that(!nested_generic.failed());
	var initializers = language_program("language astra27b; struct Point { int x; int y; } int value() { Point p = {x = 20, y = 22,}; int[2] a = {20,22,}; return a[0]+p.y; }");
	assert_that(!initializers.failed());
	var properties = language_program("language astra27b; class Count { int content; init(int x,) { this.content = x; } property int length => this.content; property int twice { get => this.content*2; } }");
	assert_that(!properties.failed());
	var elision = language_program("language astra27b; int value() { return add(20,,22); }");
	assert_that(elision.failed());
	var empty_argument = language_program("language astra27b; int value() { return add(,); }");
	assert_that(empty_argument.failed());
	var empty_generic = language_program("language astra27b; int identity<,>(int x) { return x; }");
	assert_that(empty_generic.failed());
	var missing_semicolon = language_program("language astra27b; int value() => 42");
	assert_that(missing_semicolon.failed());
	var statements = language_program("language astra27b; int value() => { return 42; };");
	assert_that(statements.failed());
	var void_value = language_program("language astra27b; void value() => 42;");
	assert_that(void_value.failed());
	var old_body = language_program("int value() => 42;");
	assert_that(old_body.failed());
	var old_parameters = language_program("int value(int x,) { return x; }");
	assert_that(old_parameters.failed());
	var old_call = language_program("int value() { return add(20,22,); }");
	assert_that(old_call.failed());
	var old_initializer = language_program("int value() { int[2] a = {20,22,}; return a[0]; }");
	assert_that(old_initializer.failed());
	var records = language_program("language astra27b; struct Point { int x; int y; } Point point(int y) { return Point {x = 20, y,}; } int value() { return read(Point {x = 20, y = 22}); }");
	assert_that(!records.failed());
	var old_record = language_program("struct Point { int x; int y; } Point point(int y) { return Point {x = 20, y}; }");
	assert_that(old_record.failed());
	var conditional = language_program("language astra27b; int choose(bool c, bool d) { return c || d ? 20+22 : d ? 1 : 2; }");
	assert_that(!conditional.failed());
	var owner_conditional = language_program("language astra27b; Item choose(bool first) { var left = new Item(); var right = new Item(); return first ? move left : move right; }");
	assert_that(!owner_conditional.failed());
	var old_conditional = language_program("int choose(bool c) { return c ? 42 : 0; }");
	assert_that(old_conditional.failed());
	var missing_colon = language_program("language astra27b; int choose(bool c) { return c ? 42; }");
	assert_that(missing_colon.failed());
	var compounds = language_program("language astra27b; int value() { int x = 42; x += 1; x -= 1; x *= 2; x /= 2; x %= 100; x &= 255; x |= 0; x ^= 0; x <<= 1; x >>= 1; return x; }");
	assert_that(!compounds.failed());
	var places = language_program("language astra27b; struct Point { int x; } int value() { int[] a = new int[1]; a[tick()] += tick(); Point p = {x = 1}; p.x += 1; for (int i = 0; i < 2; i += 1) { a[i] += p.x; } return 42; }");
	assert_that(!places.failed());
	var old_compound = language_program("int value() { int x = 42; x += 1; return x; }");
	assert_that(old_compound.failed());
	var elided_compound = language_program("language astra27b; int value() { int x = 42; x + = 1; return x; }");
	assert_that(elided_compound.failed());
}

void language_shared_parameters() throws Error {
	var modern = language_program("language astra27b; class Item { init() { } } void inspect(shared Item value) { } void consume(owned shared Item value) { } weak shared Item observe(weak shared Item value) { return weak_clone(value); }");
	assert_that(!modern.failed());
	int ordinary = 0; int consuming = 0; int observers = 0; int i = 1;
	while (i <= modern.arena.node_count) {
		SyntaxNodeId id = {index = i};
		if (modern.arena.kind(id) == SyntaxKind.ParameterSyntax()) {
			var type = modern.arena.get_node_type_name(id);
			if (modern.arena.kind(type) == SyntaxKind.SharedTypeSyntax()) {
				if (modern.arena.get_token_owned_keyword(id).index == 0) ordinary = ordinary + 1;
				else {
					consuming = consuming + 1;
				}
				if (modern.arena.token_is(modern.arena.get_token_keyword(type), "weak")) observers = observers + 1;
			}
		}
		i = i + 1;
	}
	assert_that(ordinary == 2 && consuming == 1 && observers == 1);
	var stored_borrow = language_program("language astra27b; class Holder { readonly Item root; readonly borrowed Item view; init(owned Item value) { this.root = move value; this.view = this.root; } }");
	assert_that(!stored_borrow.failed());
	var invalid_old_borrow = language_program("class Holder { readonly borrowed Item view; }");
	assert_that(invalid_old_borrow.failed());
	var legacy = language_program("class Item { init() { } } void consume(shared Item value) { }");
	assert_that(!legacy.failed());
	int implicit = 0; i = 1;
	while (i <= legacy.arena.node_count) {
		SyntaxNodeId id = {index = i};
		if (legacy.arena.kind(id) == SyntaxKind.ParameterSyntax() && legacy.arena.get_token_owned_keyword(id).index != 0) implicit = implicit + 1;
		i = i + 1;
	}
	assert_that(implicit == 1);
}

int main() {
	try {
		language_literals();
		language_small_syntax();
		language_shared_parameters();
		var legacy = language_program("int value() { return 42; }");
		assert_that(!legacy.failed());
		SyntaxSourceId source = {index = 1};
		assert_that(syntax_source_language_profile(legacy.arena, source) == 0);
		assert_that(syntax_program_languages_verified(legacy));
		var legacy_dump = syntax_program_dump(legacy);
		assert_that(legacy_dump.text == "(unit\n\t(function\n\t\t(type \"int\")\n\t\t(name \"value\")\n\t\t(parameters)\n\t\t(block\n\t\t\t(return (integer \"42\"))\n\t\t)\n\t)\n)\n");
		var modern = language_program("language astra27b; int value() { return 42; }");
		assert_that(!modern.failed());
		assert_that(syntax_source_language_profile(modern.arena, source) == 1);
		assert_that(syntax_program_languages_verified(modern));
		var modern_dump = syntax_program_dump(modern);
		assert_that(modern_dump.text == "(unit\n\t(language astra27b)\n\t(function\n\t\t(type \"int\")\n\t\t(name \"value\")\n\t\t(parameters)\n\t\t(block\n\t\t\t(return (integer \"42\"))\n\t\t)\n\t)\n)\n");
		var missing_sources = language_sources("language astra27b; int value() { return 42; }");
		var missing = new SyntaxArena(move missing_sources);
		assert_that(!syntax_source_language_verified(missing, source));
		var explicit_legacy = language_program("language legacy27a; int value() { return 42; }");
		assert_that(!explicit_legacy.failed());
		assert_that(syntax_source_language_profile(explicit_legacy.arena, source) == 0);
		assert_that(syntax_program_languages_verified(explicit_legacy));
		var unknown = language_program("language unknown; int value() { return 42; }");
		assert_that(unknown.failed());
		var duplicate = language_program("language astra27b; language legacy27a; int value() { return 42; }");
		assert_that(duplicate.failed());
		var late = language_program("int value() { return 42; } language astra27b;");
		assert_that(late.failed());
		var after_namespace = language_program("namespace Example; language astra27b; int value() { return 42; }");
		assert_that(after_namespace.failed());
		var named = language_program("int language() { return 42; }");
		assert_that(!named.failed() && syntax_program_languages_verified(named));
		var functions = legacy.arena.get_list_functions(legacy.arena.node_at(legacy.units, 0));
		var node = legacy.arena.node_at(functions, 0);
		var span = legacy.arena.header(node).span;
		var key = legacy.arena.generated_token(TokenKind.IDENTIFIER(), span, "language");
		var version = legacy.arena.generated_token(TokenKind.IDENTIFIER(), span, "astra27b");
		var terminator = legacy.arena.generated_token(TokenKind.SEMICOLON(), span, ";");
		SyntaxLanguageDirective forged = {keyword = key, version = version, terminator = terminator};
		assert_that(legacy.arena.set_source_language(source, forged));
		assert_that(!syntax_program_languages_verified(legacy));
		var generated = modern.arena.add_source_text("generated", "language astra27b; int helper() { return 0; }", false);
		var result = syntax_parse(modern.arena, generated);
		assert_that(result.error_message.index != 0);
		return 42;
	} catch (Error error) {
		println_stderr(error.message);
		return 1;
	}
}
