// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Actual production lowering and verifier, without the LLVM/driver closure.
extern(C) int astrac_argument_count();

extern(C) int astrac_argument_length(int index);

extern(C) int astrac_argument_byte(int index, int offset);

owned SyntaxProgram component_load() throws Error {
	int count = astrac_argument_count();
	var entries = new Vector<SourceEntry>(count);
	int i = 1;
	while (i < count) {
		int length = astrac_argument_length(i);
		if (length < 0) {
			throw new Error("invalid component arguments");
		}
		var bytes = new u8[length]; int at = 0;
		while (at < length) {
			int byte = astrac_argument_byte(i, at);
			if (byte < 0) {
				throw new Error("component arguments changed");
			}
			bytes[at] = byte as u8; at = at + 1;
		}
		var path = utf8_message(bytes);
		var file = read_file(path.text);
		var content = new u8[file.byte_count()]; at = 0;
		while (at < len(content)) {
			content[at] = file.byte_at(at) as u8;
			at = at + 1;
		}
		var buffer = source_buffer(path.text, move content, false);
		var retained = shared_acquire(move buffer);
		var entry = new SourceEntry(move retained);
		assert_that(entries.append(move entry));
		i = i + 1;
	}
	var sources = source_set(move entries);
	var program = syntax_program(move sources);
	return move program;
}

int main() {
	try {
		var program = component_load();
		var bindings = binding_index(move program, 0);
		var checked = checked_build_effects_profile(move bindings, 0);
		if (checked.failed()) return 1;
		var flow = recover_flow_lower(move checked, 8192);
		if (flow.data.status != 0) return 2;
		var core = recover_core_lower(move flow);
		if (core.status != 0) return 3;
		var cfg = recover_cfg_lower(move core, 8192);
		if (cfg.status != 0) return 4;
		var ssa = recover_ssa_lower(move cfg, 8000000);
		if (ssa.data.status != 0) return 5;
		var output = new Utf8ByteBuilder();
		source_append_text(output, "CURRENT_PRODUCTION_SSA_VERIFIED_8M");
		flow_number(output, ssa.cfg.core.count);
		flow_number(output, ssa.cfg.block_count);
		source_append_text(output, "\n");
		var text = output.snapshot(); print(text.text);
		return 0;
	} catch (Error error) { println_stderr(error.message); return 6; }
}
