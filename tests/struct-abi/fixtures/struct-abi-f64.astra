struct Lab { f64 l; f64 a; f64 b; }

Lab identity(Lab value) { return value; }

Lab forward(Lab value) { return identity(value); }

int main() { Lab input = { l = -0.0, a = 1.5, b = 3.5 }; Lab output = forward(input); if (output.l != 0.0 || output.a != 1.5 || output.b != 3.5) return 1; return 0; }
