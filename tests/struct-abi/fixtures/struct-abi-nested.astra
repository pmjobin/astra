struct Inner { int x; f64 y; }
struct Outer { Inner inner; i16<8> samples; }
Outer identity(Outer value) { return value; }
Inner subobject(Outer value) { return value.inner; }
int main() {
	Outer a = { inner = { x = 7, y = 3.5 }, samples = splat(9,8) };
	Outer b = identity(a);
	Inner c = subobject(b);
	if (c.x != 7 || c.y != 3.5 || b.samples[7] != 9) { return 1; }
	return 0;
}
