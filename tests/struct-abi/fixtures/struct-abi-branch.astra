// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
struct Pair { int x; f64 y; }
Pair choose(bool condition, Pair a, Pair b) { if (condition) { return a; } return b; }
Pair merge(bool condition, Pair a, Pair b) { Pair result = a; if (condition) { result = b; } return result; }
int main() {
	Pair a = { x = 7, y = 3.5 };
	Pair b = { x = 9, y = 9.5 };
	Pair c = choose(true,a,b);
	Pair d = choose(false,a,b);
	Pair e = merge(true,a,b);
	Pair f = merge(false,a,b);
	if (c.x != 7 || c.y != 3.5 || d.x != 9 || d.y != 9.5 || e.x != 9 || f.x != 7) { return 1; }
	return 0;
}
