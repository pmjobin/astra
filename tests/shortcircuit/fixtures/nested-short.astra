bool and_chain(bool a, bool b, bool c) {
	return a && b && c;
}
bool or_chain(bool a, bool b, bool c) {
	return a || b || c;
}
bool and_or(bool a, bool b, bool c) {
	return a && (b || c);
}
bool or_and(bool a, bool b, bool c) {
	return a || b && c;
}
bool precedence(bool a, bool b, bool c, bool d, bool e) {
	return a == b && c != d || e;
}
