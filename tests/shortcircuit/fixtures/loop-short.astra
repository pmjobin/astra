int count(int n) {
	int i = 0;
	while (i < n && i < 5) {
		i = i + 1;
	}
	return i;
}
bool keep_going(int x) {
	return x < 5;
}
int continue_count(int n) {
	int i = 0;
	while (i < n && keep_going(i)) {
		i = i + 1;
		continue;
	}
	return i;
}
int break_count(int n) {
	int i = 0;
	while (i < n && keep_going(i)) {
		i = i + 1;
		if (i == 3) {
			i = 8;
			break;
		}
	}
	return i;
}
