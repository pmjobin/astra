// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Execute actual source consumers. Deliberate corruptions are restored before
// positive controls; no retained builder result is substituted for verification.
owned CheckedIndex expressive_checked(string text) throws Error {
	var bytes = new u8[text.byte_length]; int at = 0;
	while (at < len(bytes)) {
		bytes[at] = astra_host_text_byte(text, at) as u8;
		at = at + 1;
	}
	var buffer = source_buffer("expressive-semantic-input", move bytes, false);
	var retained = shared_acquire(move buffer);
	var entries = new Vector<SourceEntry>(1);
	var entry = new SourceEntry(move retained); assert_that(entries.append(move entry));
	var sources = source_set(move entries);
	var program = syntax_program(move sources);
	assert_that(!program.failed());
	var bindings = binding_index(move program, 0);
	var checked = checked_build_effects_profile(move bindings, 0);
	assert_that(!checked.failed() && checked.validate() && generic_verify(checked) && enum_value_facts_verified(checked));
	return move checked;
}

void expressive_enum_storage() throws Error {
	var checked = expressive_checked("language astra27b; enum Packet { Empty, Data(owned int[] data, int count) } enum Envelope { Missing, Child(Packet packet, owned int[] tail) } enum Copy { Value(int value), Empty } int main() { return 42; }");
	var packet = no_type(); var envelope = no_type(); var copied = no_type(); SymbolId payload = {index = 0};
	int at = 1;
	while (at <= checked.bindings.symbol_count) {
		var symbol = checked.bindings.symbol(type_symbol(at));
		if (symbol.kind == 5) {
			if (checked.bindings.program.arena.token_is(symbol.token, "Packet")) packet = checked.symbol_types[at];
			if (checked.bindings.program.arena.token_is(symbol.token, "Envelope")) envelope = checked.symbol_types[at];
			if (checked.bindings.program.arena.token_is(symbol.token, "Copy")) copied = checked.symbol_types[at];
		}
		if (symbol.kind == 17 && checked.bindings.program.arena.token_is(symbol.token, "data")) payload = type_symbol(at);
		at = at + 1;
	}
	assert_that(packet.index > 0 && envelope.index > 0 && copied.index > 0 && payload.index > 0);
	assert_that(enum_storage_type_verified(checked, packet) && enum_storage_type_verified(checked, envelope));
	assert_that(enum_storage_owned(checked, packet, 0) && enum_storage_owned(checked, envelope, 0));
	assert_that(!enum_value_type_verified(checked, packet) && !enum_value_type_verified(checked, envelope));
	assert_that(!recover_copy_channel(checked, packet, 0, false) && !recover_copy_channel(checked, envelope, 0, false));
	assert_that(enum_value_type_verified(checked, copied) && !enum_storage_owned(checked, copied, 0));
	assert_that(recover_enum_type_bytes(checked, packet, 0) == 32 && recover_enum_type_bytes(checked, envelope, 0) == 56);
	assert_that(recover_enum_type_alignment(checked, packet, 0) == 8 && recover_enum_type_alignment(checked, envelope, 0) == 8);
	// Native channels preserve intrinsic ownership; an owning sum is not a copy.
	assert_that(recover_storage_channel(checked, packet, 4, false) && recover_storage_channel(checked, packet, 2, false));
	assert_that(!recover_storage_channel(checked, packet, 0, false) && !recover_storage_channel(checked, packet, 2, true));
	var declaration = checked.bindings.symbol(payload);
	int flags = checked.symbol_flags[payload.index];
	checked.symbol_flags[payload.index] = 0;
	assert_that(!enum_storage_type_verified(checked, packet) && !enum_storage_type_verified(checked, envelope));
	checked.symbol_flags[payload.index] = flags;
	assert_that(enum_storage_type_verified(checked, packet) && enum_storage_type_verified(checked, envelope));
	checked.symbol_flags[payload.index] = 2;
	assert_that(!enum_storage_type_verified(checked, packet));
	checked.symbol_flags[payload.index] = flags;
	var token = checked.bindings.program.arena.get_token_owned_keyword(declaration.node);
	SyntaxTokenId absent = {index = 0};
	checked.bindings.program.arena.set_token_owned_keyword(declaration.node, absent);
	assert_that(!enum_storage_type_verified(checked, packet) && !enum_storage_owned(checked, packet, 0));
	checked.bindings.program.arena.set_token_owned_keyword(declaration.node, token);
	assert_that(enum_storage_type_verified(checked, packet) && enum_storage_owned(checked, packet, 0));
	assert_that(!enum_storage_type_depth(checked, packet, 33, true) && !enum_storage_owned(checked, packet, 33));
}

void expressive_pattern_context() throws Error {
	var checked = expressive_checked("language astra27b; enum Bit { Off, On } enum Pair { Both(Bit first, Bit second) } int value(Pair pair) => match (pair) { case Pair.Both(second=Bit.Off(), first=Bit.Off()) => 0; case Pair.Both(Bit.Off(), Bit.On()) => 1; case Pair.Both(Bit.On(), Bit.Off()) => 2; case Pair.Both(Bit.On(), Bit.On()) => 3; }; int other(Pair pair) => match (pair) { case Pair.Both(first, second) => 4; }; int main() { return 42; }");
	SyntaxNodeId first = {index = 0}; SyntaxNodeId other = {index = 0}; SyntaxNodeId nested = {index = 0};
	int at = 1;
	while (at < len(checked.uses)) {
		SyntaxNodeId node = {index = at};
		if (checked.bindings.program.arena.kind(node) == SyntaxKind.MatchExpressionSyntax()) {
			if (first.index == 0) first = node;
			else {
				other = node;
			}
		}
		at = at + 1;
	}
	assert_that(first.index > 0 && other.index > 0);
	var arms = checked.bindings.program.arena.get_list_arms(first);
	var arm = checked.bindings.program.arena.node_at(arms, 0);
	var bindings = checked.bindings.program.arena.get_list_bindings(arm);
	var binding = checked.bindings.program.arena.node_at(bindings, 0);
	nested = checked.bindings.program.arena.get_node_nested_pattern(binding);
	assert_that(nested.index > 0 && enum_pattern_match(checked, nested).index == first.index);
	SyntaxNodeId absent = {index = 0};
	var original = checked.pattern_matches[nested.index];
	checked.pattern_matches[nested.index] = absent;
	assert_that(!enum_match_expression_verified(checked, first));
	checked.pattern_matches[nested.index] = original;
	assert_that(enum_match_expression_verified(checked, first));
	checked.pattern_matches[nested.index] = other;
	assert_that(!enum_match_expression_verified(checked, first) && !enum_value_facts_verified(checked));
	checked.pattern_matches[nested.index] = original;
	assert_that(enum_match_expression_verified(checked, first) && enum_value_facts_verified(checked));
	var saved = checked.pattern_matches[binding.index];
	checked.pattern_matches[binding.index] = other;
	assert_that(!enum_match_expression_verified(checked, first));
	checked.pattern_matches[binding.index] = saved;
	assert_that(enum_match_expression_verified(checked, first));
	var reduced = checked.bindings.program.arena.new_list(syntax_kind_code(SyntaxKind.EnumArmSyntax()));
	at = 0;
	while (at < 3) {
		checked.bindings.program.arena.append_node(reduced, checked.bindings.program.arena.node_at(arms, at));
		at = at + 1;
	}
	checked.bindings.program.arena.set_list_arms(first, reduced);
	assert_that(!enum_match_expression_verified(checked, first));
	checked.bindings.program.arena.set_list_arms(first, arms);
	assert_that(enum_match_expression_verified(checked, first) && enum_value_facts_verified(checked) && generic_verify(checked));
}

void expressive_constructor_match() throws Error {
	var checked = expressive_checked("language astra27b; enum E { First, Last } class Box { int value; init(E mode) { this.value = match (mode) { case E.First() => 20; case E.Last() => 42; }; } } int main() { var box = new Box(E.Last()); return box.value; }");
	var flow = recover_flow_lower(move checked, 8192);
	assert_that(flow.data.status == 0 && recover_flow_verify(flow));
	var invalid = expressive_checked("language astra27b; enum E { First, Last } class Box { int value; init() { this.value = 0; } } int consume(owned Box box) { return 42; } int main() { var box = new Box(); box.value = match (E.First()) { case E.First() => consume(move box); case E.Last() => 42; }; return 42; }");
	var rejected = recover_flow_lower(move invalid, 8192);
	assert_that(rejected.data.status != 0);
}

void expressive_owning_patterns() throws Error {
	var checked = expressive_checked("language astra27b; enum Packet { Empty, Data(owned int[] data, int count) } owned int[] take(Packet value) => match (move value) { case Packet.Empty() => new int[0]; case Packet.Data(data, count) => move data; }; int inspect(Packet value) => match (value) { case Packet.Empty() => 0; case Packet.Data(data, count) => len(data)+count; }; int main() { var state = Packet.Data(new int[13],13); owned int[] values = take(move state); return len(values)+29; }");
	int inspected = 0; int consumed = 0; int at = 1;
	while (at <= checked.bindings.symbol_count) {
		var symbol = type_symbol(at); var declaration = checked.bindings.symbol(symbol);
		if (declaration.kind == 15 && checked.bindings.program.arena.kind(declaration.node) == SyntaxKind.EnumBindingSyntax() && checked.bindings.program.arena.token_is(declaration.token, "data")) {
			var root = enum_pattern_match(checked, declaration.node);
			assert_that(root.index > 0 && enum_match_expression_verified(checked, root));
			int flags = checked.symbol_flags[at];
			if (enum_match_consuming(checked, root)) {
				assert_that(flags == 4); consumed = consumed + 1;
				checked.symbol_flags[at] = 2;
			} else {
				assert_that(flags == 2); inspected = inspected + 1;
				checked.symbol_flags[at] = 4;
			}
			assert_that(!enum_match_expression_verified(checked, root));
			checked.symbol_flags[at] = flags;
			assert_that(enum_match_expression_verified(checked, root));
			var input = checked.bindings.program.arena.get_node_scrutinee(root);
			if (enum_match_consuming(checked, root)) {
				var original = checked.uses[input.index]; var changed = original; changed.flags = 0;
				checked.uses[input.index] = changed;
				assert_that(!enum_match_expression_verified(checked, root));
				checked.uses[input.index] = original;
				assert_that(enum_match_expression_verified(checked, root));
			} else {
				assert_that(checked.uses[input.index].flags == 4 && !enum_match_consuming(checked, root));
			}
		}
		at = at + 1;
	}
	assert_that(inspected == 1 && consumed == 1 && enum_value_facts_verified(checked) && checked.validate() && generic_verify(checked));
}

void expressive_range_values() throws Error {
	var checked = expressive_checked("language astra27b; int main() { Range<int> interval = 20..=80; var other = (1+2)..(20-1); var unsigned = (0 as u64)..=18446744073709551615; return 42; }");
	assert_that(range_value_facts_verified(checked));
	int count = 0; int at = 1;
	while (at < len(checked.uses)) {
		SyntaxNodeId node = {index = at};
		if (range_type_verified(checked.types, checked.uses[at].type) && checked.bindings.program.arena.kind(node) == SyntaxKind.BinaryExpressionSyntax()) {
			count = count + 1;
			var left = checked.bindings.program.arena.get_node_left(node);
			var original = checked.uses[left.index]; var changed = original;
			changed.type = type_id(13); checked.uses[left.index] = changed;
			assert_that(!range_value_facts_verified(checked));
			checked.uses[left.index] = original;
			assert_that(range_value_facts_verified(checked));
			var saved = checked.uses[at]; var owning = saved; owning.flags = 4;
			checked.uses[at] = owning;
			assert_that(!range_value_facts_verified(checked));
			checked.uses[at] = saved;
			assert_that(checked.types.valid() && range_value_facts_verified(checked));
		}
		at = at + 1;
	}
	assert_that(count == 3);
}

void expressive_checked_closure_preserved() throws Error {
	var checked = expressive_checked("language astra27b; class Environment { init() {} } [ExceptionRoot] class Error { readonly string text; init(string message) { this.text=message; } virtual property string message { get { return this.text; } } } int read(borrowed CheckedClosure<Environment,Error,int,int> callback) { return 42; } int main() { return 42; }");
	int count = 0; int at = 1;
	while (at <= checked.bindings.symbol_count) {
		var symbol = checked.bindings.symbol(type_symbol(at));
		if (symbol.kind == 7 && checked.bindings.program.arena.token_is(symbol.token, "callback")) {
			var type = checked.symbol_types[at]; var row = checked.types.row(type);
			assert_that(row.kind == 35 && row.count == 4 && checked.symbol_flags[at] == 2 && !range_type_verified(checked.types, type));
			var name = checked_type_name(checked, type);
			assert_that(name.text == "CheckedClosure<Environment,Error,int,int>");
			count = count + 1;
		}
		at = at + 1;
	}
	assert_that(count == 1 && checked.validate());
}

int main(string[] args) {
	try {
		if (len(args) > 1) {
			if (len(args) < 3 || args[1] != "--source" && args[1] != "--flow") return 2;
			var program = binding_load_program(args, 2);
			var bindings = binding_index(move program, 0);
			var checked = checked_build_effects_profile(move bindings, 0);
			if (checked.failed()) {
				var observation = checked_observation(checked); print(observation.text); return 1;
			}
			if (!checked.validate() || !generic_verify(checked) || !enum_value_facts_verified(checked)) return 3;
			var effect = checked_effect_source_verify(checked);
			if (effect.status != 0) return 4;
			if (args[1] == "--flow") {
				var flow = recover_flow_lower(move checked, 8192);
				if (flow.data.status != 0 || !recover_flow_verify(flow)) {
					var output = new Utf8ByteBuilder(); source_append_text(output, "FLOW_REFUSAL status="); append_int(output, flow.data.status); source_append_text(output, " boundary="); append_int(output, flow.data.boundary.index); var text = output.snapshot(); println(text.text); return 5;
				}
				println("SELECTED_RECOVERED_FLOW_SOURCE_ONLY");
			} else {
				println("SELECTED_TYPED_SOURCE_ONLY");
			}
			return 42;
		}
		expressive_enum_storage();
		expressive_pattern_context();
		expressive_constructor_match();
		expressive_owning_patterns();
		expressive_checked_closure_preserved();
		expressive_range_values();
		return 42;
	} catch (Error error) { println_stderr(error.message); return 1; }
}
