void expressive_format_case(string before) throws Error {
	var program = syntax_format_parse(before); var first = syntax_source_format(program); var reparsed = syntax_format_parse(first.text); var second = syntax_source_format(reparsed);
	assert_that(first.text == second.text);
}

void expressive_formatter_checks() throws Error {
	var program = syntax_format_parse("struct A { int x; }\n// next\nstruct B { int y; }\nint f(int x) { if (x > 0) { return x; } return 0; }\n");
	var output = syntax_source_format(program);
	assert_that(output.text == "struct A { int x; }\n\n// next\nstruct B { int y; }\n\nint f(int x) { if (x > 0) return x; return 0; }\n");
	expressive_format_case(output.text);
	expressive_format_case("int f(int x) { if (x > 0) { int y = x; return y; } else { return 0; } }\n");
	expressive_format_case("int f(int x) { while (x>0) { x=x-1; x=x-1; } return x; }\n");
	expressive_format_case("class A { int x; init() { this.x=0; } property int value { get { return this.x; } } int f() { return this.x; } }\n");
	expressive_format_case("int f() {\r\n    /* exact\n    multiline */\r\n    string text = \"exact \\n literal\"; // keep\r\n    return 42;\r\n}\r\n");
	expressive_format_case("language astra27b; enum E { A, B } int f(int x) => match (E.A()) { case E.A() => x; case E.B() => 0; }; int main() { var values = [for (var i in (20..=80).step_by(5)) => i*i]; return f(x: values.iter().map(i => i+1).sum()); }\n");
	expressive_format_case("language astra27b; int main() { var text = format_text($\"prefix {{ {42} }} suffix\"); return 42; }\n");
	string multiline = "language astra27b; int main() { var text = format_text($\"value {\n    42\n}!\"); return 42; }\n";
	var multiline_program = syntax_format_parse(multiline); var multiline_output = syntax_source_format(multiline_program); assert_that(multiline_output.text == multiline);
	var raw = syntax_format_parse("int f() { /* retain */ return 42; }\n"); SyntaxSourceId id = {index = 1};
	var left = raw.arena.source(id); var cloned = shared_clone(left); var original = syntax_format_scan(move cloned);
	var right_program = syntax_format_parse("int f() { /* retain */ return 43; }\n"); var right = right_program.arena.source(id); var other = shared_clone(right); var candidate = syntax_format_scan(move other); var none = new bool[0];
	assert_that(!syntax_format_preserved(shared_borrow(left), original, shared_borrow(right), candidate, none));
	var commented = syntax_format_parse("int f() { /* changed */ return 42; }\n"); var comment_source = commented.arena.source(id); var comment_clone = shared_clone(comment_source); var comments = syntax_format_scan(move comment_clone);
	assert_that(!syntax_format_preserved(shared_borrow(left), original, shared_borrow(comment_source), comments, none));
	var removed = new bool[syntax_length(shared_borrow(left))+1]; removed[original.tokens[0].start] = true;
	assert_that(!syntax_format_preserved(shared_borrow(left), original, shared_borrow(left), original, removed));
	assert_that(syntax_format_preserved(shared_borrow(left), original, shared_borrow(left), original, none));
}

int main(string[] args) {
	try {
		if (len(args) == 2 && args[1] == "--version") {
			println("astrac 27-C syntax formatter development (format 2)");
			return 0;
		}
		if (len(args) > 1) {
			if (len(args) != 3 || args[1] != "--format" && args[1] != "--dump-syntax") return 2;
			var bytes = read_file(args[2]); var text = bytes.decode(); var program = syntax_format_parse(text.text);
			if (args[1] == "--dump-syntax") {
				var dump = syntax_program_dump(program);
				print(dump.text);
				return 0;
			}
			var output = syntax_source_format(program); print(output.text); return 0;
		}
		expressive_formatter_checks(); return 42;
	} catch (Error error) { println_stderr(error.message); return 1; }
}
