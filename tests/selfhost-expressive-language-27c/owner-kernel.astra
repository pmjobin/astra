// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Exact production helpers with the existing minimal owner containers. These
// controls qualify helper equivalence, never source admission or LLVM output.
bool enum_match_consuming(OwnerKernelChecked checked, SyntaxNodeId source) { return false; }

void dominance_observed(int work) { assert_that(work > 0 && work <= 80000); }

bool kernel_slots(RecoverSsa ssa, bool packed) {
	var work = new RecoverWork(8000000); var index = new RecoverSsaOwnerIndex(ssa.cfg);
	if (!recover_ssa_owner_index(index, ssa.cfg, work)) return false;
	if (packed) return recover_ssa_packed_slots(ssa, index, work);
	int at = 1;
	while (at <= ssa.cfg.core.flow.storage.count) {
		if (!recover_ssa_slot(ssa, at, index, work)) return false;
		at = at + 1;
	}
	return !work.exhausted;
}

owned RecoverSsa kernel_reservations(int moves) {
	int size = moves*2+2; var ssa = new RecoverSsa(size, size, 1, 1, 2, size + 1); ssa.cfg.entries[0] = 1;
	var slot = ssa.cfg.core.flow.storage.slots[0]; slot.owner = true; slot.parameter = true; slot.function = 1; slot.symbol.index = 1; slot.flags = 4; slot.type = type_id(22);
	ssa.cfg.core.flow.storage.slots[0] = slot; ssa.cfg.core.flow.storage.symbols[1] = 1;
	int at = 0;
	while (at < size) {
		var block = ssa.cfg.blocks[at]; block.function = 1; block.origin = at + 1; block.next = at + 2;
		var source = ssa.cfg.core.nodes[at].value; source.function = 1; source.symbol.index = 1; source.type = type_id(22);
		if (at < moves*2) {
			if (at%2 == 0) {
				block.opcode = 10; source.kind = 10; ssa.cfg.core.owners.slots[at] = 1;
				ssa.cfg.regions[at].operation = at + 1;
			} else {
				block.opcode = 37; block.a = at; block.b = 1;
			}
		} else {
			if (at == size - 2) {
				block.opcode = 38; block.a = 1;
			} else {
				block.opcode = 22; block.next = 0;
			}
		}
		ssa.cfg.blocks[at] = block; ssa.cfg.core.nodes[at].value = source;
		at = at + 1;
	}
	return move ssa;
}

bool kernel_slot_controls() {
	int moves = 0;
	while (moves <= 96) {
		var ssa = kernel_reservations(moves);
		if (!kernel_slots(ssa, false) || !kernel_slots(ssa, true)) return false;
		if (moves > 1) {
			var original = ssa.cfg.blocks[1]; var changed = original; changed.a = 3; ssa.cfg.blocks[1] = changed;
			if (kernel_slots(ssa, true) || kernel_slots(ssa, false)) return false;
			ssa.cfg.blocks[1] = original; changed = original; changed.opcode = 0; ssa.cfg.blocks[1] = changed;
			if (kernel_slots(ssa, true) || kernel_slots(ssa, false)) return false;
			ssa.cfg.blocks[1] = original;
			if (!kernel_slots(ssa, true) || !kernel_slots(ssa, false)) return false;
		}
		moves = moves + 1;
	}
	return true;
}

bool kernel_owner_walk(bool retire, bool compressed, int size) {
	var ssa = new RecoverSsa(size, 1, 1, 0, 1, 2); ssa.cfg.entries[0] = size;
	ssa.cfg.core.nodes[0].value.kind = 5; ssa.cfg.core.nodes[0].value.type = type_id(31);
	int at = 0;
	while (at < size) {
		ssa.cfg.blocks[at].function = 1; ssa.cfg.blocks[at].next = at;
		at = at + 1;
	}
	ssa.cfg.blocks[size - 1].opcode = 5; ssa.cfg.blocks[size - 1].origin = 1;
	ssa.cfg.blocks[size/2].opcode = 31; ssa.cfg.blocks[size/2].owner = 1;
	ssa.cfg.blocks[1].opcode = 31; if (retire) ssa.cfg.blocks[1].opcode = 32;
	ssa.cfg.blocks[1].owner = 1; ssa.cfg.blocks[0].opcode = 22;
	RecoverValue definition = {function = 1, block = size, type = {index = 31}, channel = 1, edge = 0};
	ssa.data.values[1] = definition; ssa.data.reachable[size - 1] = true;
	var work = new RecoverWork(8000000);
	if (compressed) {
		work.owner_shortcuts = new int[size + 1]; at = 1;
		while (at <= size) {
			recover_ssa_value_shortcut(ssa, at, work); at = at + 1;
		}
	}
	bool result = recover_ssa_owner(ssa.data, ssa.cfg, 1, work);
	if (work.exhausted || result != retire) return false;
	if (compressed && 8000000 - work.remaining > 4) return false;
	if (!compressed && 8000000 - work.remaining != size - 1) return false;
	return true;
}

bool kernel_physical_binders() {
	var nodes = new RecoverCoreNode[1]; nodes[0].value.kind = 89; nodes[0].value.function = 1; nodes[0].value.symbol.index = 1;
	var slots = new RecoverSlot[1]; slots[0].function = 1; slots[0].symbol.index = 1;
	var index = new RecoverLlvmIndex(1, 1, 1, 2);
	if (!recover_llvm_index_build(index, nodes, 1, slots, 1) || !recover_llvm_index_verified(index, nodes, 1, slots, 1, 1, 2)) return false;
	index.declarations[1] = 0; if (recover_llvm_index_verified(index, nodes, 1, slots, 1, 1, 2)) return false;
	index.declarations[1] = 1; if (!recover_llvm_index_verified(index, nodes, 1, slots, 1, 1, 2)) return false;
	nodes[0].value.kind = 88; if (recover_llvm_index_verified(index, nodes, 1, slots, 1, 1, 2)) return false;
	nodes[0].value.kind = 89; if (!recover_llvm_index_verified(index, nodes, 1, slots, 1, 1, 2)) return false;
	slots[0].parameter = true; return !recover_llvm_index_verified(index, nodes, 1, slots, 1, 1, 2);
}

bool kernel_slot_reference_equal(RecoverSsa ssa, int expected) {
	var setup = new RecoverWork(8000000); var index = new RecoverSsaOwnerIndex(ssa.cfg);
	if (!recover_ssa_owner_index(index, ssa.cfg, setup)) return false;
	var reference = new RecoverWork(8000000); bool accepted = true; int origin = 1;
	// Reservation identity is a common, unchanged precondition. The retained
	// scalar reference independently checks every slot's exact path states.
	while (origin <= len(index.reservation_blocks) && accepted) {
		if (index.reservation_blocks[origin - 1] > 0 && !recover_ssa_reservation_paths(ssa, index, origin, reference)) accepted = false;
		origin = origin + 1;
	}
	int place = 1;
	while (place <= ssa.cfg.core.flow.storage.count && accepted) {
		if (!reference_slot(ssa, place, index, reference)) accepted = false;
		place = place + 1;
	}
	var packed = new RecoverWork(8000000);
	bool actual = recover_ssa_packed_slots(ssa, index, packed);
	return actual == accepted && !reference.exhausted && !packed.exhausted && (expected < 0 || actual && expected == 1 || !actual && expected == 0);
}

owned RecoverSsa kernel_width_slots(int slots) {
	int size = slots*4 + 1; var ssa = new RecoverSsa(size, size, 1, slots, slots + 1, size + 1); ssa.cfg.entries[0] = 1;
	int place = 1;
	while (place <= slots) {
		var slot = ssa.cfg.core.flow.storage.slots[place - 1]; slot.owner = true; slot.parameter = true; slot.function = 1; slot.symbol.index = place; slot.flags = 4; slot.type = type_id(22);
		ssa.cfg.core.flow.storage.slots[place - 1] = slot; ssa.cfg.core.flow.storage.symbols[place] = place;
		place = place + 1;
	}
	int b = 0;
	while (b < size) {
		var row = ssa.cfg.blocks[b]; row.function = 1; row.origin = b + 1; row.next = b + 2;
		var source = ssa.cfg.core.nodes[b].value; source.function = 1;
		if (b + 1 < size) {
			place = b/4 + 1; source.symbol.index = place;
			if (b%4 == 0) {
				row.opcode = 10; source.kind = 10; ssa.cfg.core.owners.slots[b] = place;
			} else {
				if (b%4 == 1) {
					row.opcode = 37; row.a = b; row.b = place;
				} else {
					if (b%4 == 2) row.opcode = 2;
					else {
						row.opcode = 38;
						row.a = place;
					}
				}
			}
		} else {
			row.opcode = 22;
			row.next = 0;
		}
		ssa.cfg.blocks[b] = row; ssa.cfg.core.nodes[b].value = source; ssa.cfg.regions[b].operation = b + 1;
		b = b + 1;
	}
	return move ssa;
}

bool kernel_width_controls() throws Error {
	int[10] sizes = {1,10,11,20,21,22,31,42,43,64}; int at = 0;
	while (at < len(sizes)) {
		int slots = sizes[at]; var ssa = kernel_width_slots(slots);
		if (!kernel_slot_reference_equal(ssa, 1)) return false;
		int last = (slots - 1)*4; var original = ssa.cfg.blocks[last + 3]; var changed = original; changed.opcode = 0;
		ssa.cfg.blocks[last + 3] = changed;
		if (!kernel_slot_reference_equal(ssa, 0)) return false;
		ssa.cfg.blocks[last + 3] = original; original = ssa.cfg.blocks[last + 1]; changed = original; changed.opcode = 36;
		ssa.cfg.blocks[last + 1] = changed;
		if (!kernel_slot_reference_equal(ssa, 0)) return false;
		ssa.cfg.blocks[last + 1] = original;
		if (slots > 1) {
			changed = original; changed.a = 1; ssa.cfg.blocks[last + 1] = changed;
			if (!kernel_slot_reference_equal(ssa, 0)) return false;
			ssa.cfg.blocks[last + 1] = original;
		}
		if (!kernel_slot_reference_equal(ssa, 1)) return false;
		at = at + 1;
	}
	var measured = kernel_width_slots(256); var work = new RecoverWork(8000000); var index = new RecoverSsaOwnerIndex(measured.cfg);
	if (!recover_ssa_owner_index(index, measured.cfg, work)) return false;
	int before = work.remaining;
	if (!recover_ssa_packed_slots(measured, index, work)) return false;
	var output = new Utf8ByteBuilder(); append_text(output, "OWNER_PACK_256 work="); append_int(output, before - work.remaining); var message = output.snapshot(); println(message.text);
	return true;
}

bool kernel_generated_slots() {
	int[9] opcodes = {0,2,10,27,36,37,38,22,23}; int graph = 0; int seed = 731;
	while (graph < 8192) {
		int size = 2 + graph%11; int slots = 1 + graph%64;
		var ssa = new RecoverSsa(size, size, 1, slots, slots + 1, size + 1); ssa.cfg.entries[0] = 1;
		int place = 1;
		while (place <= slots) {
			ssa.cfg.core.flow.storage.slots[place - 1].owner = true; ssa.cfg.core.flow.storage.slots[place - 1].parameter = (graph + place)%3 == 0;
			ssa.cfg.core.flow.storage.slots[place - 1].function = 1; ssa.cfg.core.flow.storage.slots[place - 1].symbol.index = place; ssa.cfg.core.flow.storage.symbols[place] = place;
			place = place + 1;
		}
		int b = 0;
		while (b < size) {
			seed = (seed*109 + 89)%32749; int opcode = opcodes[seed%9];
			seed = (seed*109 + 89)%32749; place = 1 + seed%slots;
			var row = ssa.cfg.blocks[b]; row.function = 1; row.origin = b + 1; row.opcode = opcode; row.a = 1 + seed%size; row.b = place;
			if (opcode == 38) row.a = place;
			seed = (seed*109 + 89)%32749; row.next = seed%(size + 1);
			seed = (seed*109 + 89)%32749; row.other = seed%(size + 1);
			ssa.cfg.blocks[b] = row; ssa.cfg.core.nodes[b].value.symbol.index = place;
			if (opcode == 10) {
				ssa.cfg.core.nodes[b].value.kind = 10;
				ssa.cfg.core.owners.slots[b] = place;
			}
			ssa.cfg.regions[b].operation = b + 1; b = b + 1;
		}
		if (!kernel_slot_reference_equal(ssa, -1)) return false;
		graph = graph + 1;
	}
	return true;
}

bool kernel_sparse_reservations() {
	var ssa = kernel_reservations(2); var work = new RecoverWork(8000000); var index = new RecoverSsaOwnerIndex(ssa.cfg);
	if (!recover_ssa_owner_index(index, ssa.cfg, work) || index.reservation_count != 2 || !recover_ssa_packed_slots(ssa, index, work)) return false;
	int original = index.reservation_origins[1]; index.reservation_origins[1] = index.reservation_origins[0];
	var duplicate = new RecoverWork(8000000); if (recover_ssa_packed_slots(ssa, index, duplicate)) return false;
	index.reservation_origins[1] = original; index.reservation_count = 1;
	var missing = new RecoverWork(8000000); if (recover_ssa_packed_slots(ssa, index, missing)) return false;
	index.reservation_count = 2; index.moves[0] = 1;
	var count = new RecoverWork(8000000); if (recover_ssa_packed_slots(ssa, index, count)) return false;
	index.moves[0] = 2;
	var restored = new RecoverWork(8000000); return recover_ssa_packed_slots(ssa, index, restored);
}

int kernel_graph_word(FileBytes bytes, int offset) throws FileError {
	u32 bits = bytes.byte_at(offset) as u32;
	bits = bits | ((bytes.byte_at(offset + 1) as u32) << 8);
	bits = bits | ((bytes.byte_at(offset + 2) as u32) << 16);
	bits = bits | ((bytes.byte_at(offset + 3) as u32) << 24);
	return bits as int;
}

// Replay only the independently captured physical CFG's exact graph. This
// reports the real dominator work cost, without frontend or owner acceptance.
bool kernel_captured_graph(string block_path, string entry_path) throws Error {
	var block_bytes = read_file(block_path); var entry_bytes = read_file(entry_path);
	if (block_bytes.byte_count() < 40 || block_bytes.byte_count()%40 != 0 || block_bytes.byte_count()/40 > 8000000 || entry_bytes.byte_count() < 4 || entry_bytes.byte_count()%4 != 0) return false;
	int count = block_bytes.byte_count()/40; int functions = entry_bytes.byte_count()/4;
	if (functions > count) return false;
	var blocks = new RecoverBlock[count]; var entries = new int[functions]; int at = 0;
	while (at < count) {
		int offset = at*40;
		RecoverBlock row = {function = kernel_graph_word(block_bytes, offset), origin = kernel_graph_word(block_bytes, offset + 4), opcode = kernel_graph_word(block_bytes, offset + 8), a = kernel_graph_word(block_bytes, offset + 12), b = kernel_graph_word(block_bytes, offset + 16), next = kernel_graph_word(block_bytes, offset + 20), other = kernel_graph_word(block_bytes, offset + 24), owner = kernel_graph_word(block_bytes, offset + 28), carry = kernel_graph_word(block_bytes, offset + 32), rank = kernel_graph_word(block_bytes, offset + 36)};
		blocks[at] = row; at = at + 1;
	}
	at = 0;
	while (at < functions) {
		entries[at] = kernel_graph_word(entry_bytes, at*4); at = at + 1;
	}
	var work = new RecoverWork(8000000);
	bool accepted = recover_ssa_build_dominance(blocks, count, entries, work);
	var output = new Utf8ByteBuilder(); append_text(output, "CAPTURED_CFG_DOMINANCE accepted="); append_bool(output, accepted); append_text(output, " blocks="); append_int(output, count); append_text(output, " functions="); append_int(output, functions); append_text(output, " work="); append_int(output, 8000000 - work.remaining); var message = output.snapshot(); println(message.text);
	return accepted && !work.exhausted;
}

void kernel_owner_observed(string label, bool accepted, int limit, RecoverWork work) throws Error {
	var output = new Utf8ByteBuilder(); append_text(output, label); append_text(output, " accepted="); append_bool(output, accepted); append_text(output, " work="); append_int(output, limit - work.remaining); append_text(output, " remaining="); append_int(output, work.remaining); append_text(output, " exhausted="); append_bool(output, work.exhausted); var message = output.snapshot(); println(message.text);
}

// Decode the retained x86-64 private layouts captured before the actual final
// slot proof. These minimal containers replay only the two exact helper
// versions; they do not replace full-source or generation qualification.
bool kernel_captured_owners(string[] args) throws Error {
	var counts = read_file(args[2]); if (counts.byte_count() != 32) return false;
	int blocks = kernel_graph_word(counts, 0); int nodes = kernel_graph_word(counts, 4); int functions = kernel_graph_word(counts, 8); int slots = kernel_graph_word(counts, 12);
	int values = kernel_graph_word(counts, 16); int symbols = kernel_graph_word(counts, 20); int remaining = kernel_graph_word(counts, 24); int reservations = kernel_graph_word(counts, 28);
	if (blocks < 1 || blocks > 8000000 || nodes < 1 || nodes > 8000000 || functions < 1 || functions > blocks || slots < 0 || slots > 8000000 || values < 1 || values > 8000000 || symbols < 1 || symbols > 8000000 || remaining < 1 || remaining > 8000000 || reservations < 0 || reservations > nodes) return false;
	var block_bytes = read_file(args[3]); var node_bytes = read_file(args[4]); var value_bytes = read_file(args[5]); var slot_bytes = read_file(args[6]); var entry_bytes = read_file(args[7]);
	var owner_bytes = read_file(args[8]); var consumer_bytes = read_file(args[9]); var catch_bytes = read_file(args[10]); var reachable_bytes = read_file(args[11]); var region_bytes = read_file(args[12]);
	if (block_bytes.byte_count() != blocks*40 || node_bytes.byte_count() != nodes*80 || value_bytes.byte_count() != values*20 || slot_bytes.byte_count() != slots*24 || entry_bytes.byte_count() != functions*4 || owner_bytes.byte_count() != nodes*4 || consumer_bytes.byte_count() != nodes*4 || catch_bytes.byte_count() != nodes*4 || reachable_bytes.byte_count() != blocks || region_bytes.byte_count() != nodes*12) return false;
	var ssa = new RecoverSsa(blocks, nodes, functions, slots, symbols, values); int at = 0;
	while (at < blocks) {
		int offset = at*40;
		RecoverBlock row = {function = kernel_graph_word(block_bytes, offset), origin = kernel_graph_word(block_bytes, offset + 4), opcode = kernel_graph_word(block_bytes, offset + 8), a = kernel_graph_word(block_bytes, offset + 12), b = kernel_graph_word(block_bytes, offset + 16), next = kernel_graph_word(block_bytes, offset + 20), other = kernel_graph_word(block_bytes, offset + 24), owner = kernel_graph_word(block_bytes, offset + 28), carry = kernel_graph_word(block_bytes, offset + 32), rank = kernel_graph_word(block_bytes, offset + 36)};
		if (row.function < 1 || row.function > functions || row.origin < 0 || row.origin > nodes || row.next < 0 || row.next > blocks || row.other < 0 || row.other > blocks) return false;
		ssa.cfg.blocks[at] = row; ssa.data.reachable[at] = reachable_bytes.byte_at(at) != 0; at = at + 1;
	}
	at = 0;
	while (at < nodes) {
		int offset = at*80;
		RecoverNode row = {kind = kernel_graph_word(node_bytes, offset), function = kernel_graph_word(node_bytes, offset + 4), source = {index = kernel_graph_word(node_bytes, offset + 8)}, type = {index = kernel_graph_word(node_bytes, offset + 12)}, token = {index = kernel_graph_word(node_bytes, offset + 16)}, symbol = {index = kernel_graph_word(node_bytes, offset + 20)}, a = kernel_graph_word(node_bytes, offset + 24), b = kernel_graph_word(node_bytes, offset + 28), c = kernel_graph_word(node_bytes, offset + 32), first = kernel_graph_word(node_bytes, offset + 36), count = kernel_graph_word(node_bytes, offset + 40), handler = kernel_graph_word(node_bytes, offset + 44), caught = kernel_graph_word(node_bytes, offset + 48), execution = kernel_graph_word(node_bytes, offset + 52)};
		ssa.cfg.core.nodes[at].value = row; ssa.cfg.core.flow.data.nodes[at] = row;
		ssa.cfg.core.nodes[at].error.index = kernel_graph_word(node_bytes, offset + 56); ssa.cfg.core.nodes[at].result_role = kernel_graph_word(node_bytes, offset + 60); ssa.cfg.core.nodes[at].place = kernel_graph_word(node_bytes, offset + 64); ssa.cfg.core.nodes[at].error_owner = kernel_graph_word(node_bytes, offset + 68); ssa.cfg.core.nodes[at].borrowed_owner = kernel_graph_word(node_bytes, offset + 72); ssa.cfg.core.nodes[at].conditional = node_bytes.byte_at(offset + 76) != 0;
		ssa.cfg.core.owners.slots[at] = kernel_graph_word(owner_bytes, at*4); ssa.cfg.core.owners.consumers[at] = kernel_graph_word(consumer_bytes, at*4); ssa.cfg.catch_try[at] = kernel_graph_word(catch_bytes, at*4);
		RecoverRegion region = {entry = kernel_graph_word(region_bytes, at*12), operation = kernel_graph_word(region_bytes, at*12 + 4), next = kernel_graph_word(region_bytes, at*12 + 8)}; ssa.cfg.regions[at] = region;
		at = at + 1;
	}
	at = 0;
	while (at < values) {
		int offset = at*20; RecoverValue row = {function = kernel_graph_word(value_bytes, offset), block = kernel_graph_word(value_bytes, offset + 4), type = {index = kernel_graph_word(value_bytes, offset + 8)}, channel = kernel_graph_word(value_bytes, offset + 12), edge = kernel_graph_word(value_bytes, offset + 16)}; ssa.data.values[at] = row; at = at + 1;
	}
	at = 0;
	while (at < slots) {
		int offset = at*24; RecoverSlot row = {symbol = {index = kernel_graph_word(slot_bytes, offset)}, type = {index = kernel_graph_word(slot_bytes, offset + 4)}, flags = kernel_graph_word(slot_bytes, offset + 8), function = kernel_graph_word(slot_bytes, offset + 12), scope = kernel_graph_word(slot_bytes, offset + 16), parameter = slot_bytes.byte_at(offset + 20) != 0, owner = slot_bytes.byte_at(offset + 21) != 0};
		if (row.symbol.index < 0 || row.symbol.index >= symbols) return false;
		ssa.cfg.core.flow.storage.slots[at] = row; if (row.symbol.index > 0) ssa.cfg.core.flow.storage.symbols[row.symbol.index] = at + 1;
		at = at + 1;
	}
	at = 0;
	while (at < functions) {
		int entry = kernel_graph_word(entry_bytes, at*4); if (entry < 1 || entry > blocks || ssa.cfg.blocks[entry - 1].function != at + 1) return false;
		ssa.cfg.entries[at] = entry; at = at + 1;
	}
	// Setup is measured separately: the actual verifier already constructed its
	// fresh physical index before the captured remaining-budget boundary.
	var setup = new RecoverWork(8000000); var index = new RecoverSsaOwnerIndex(ssa.cfg);
	bool indexed = recover_ssa_owner_index(index, ssa.cfg, setup); kernel_owner_observed("CAPTURED_OWNER_INDEX", indexed, 8000000, setup);
	if (!indexed || setup.exhausted || index.reservation_count != reservations) return false;
	var baseline = new RecoverWork(8000000); bool old_full = baseline_packed_slots(ssa, index, baseline); kernel_owner_observed("CAPTURED_OWNER_BASELINE_FULL", old_full, 8000000, baseline);
	var candidate = new RecoverWork(8000000); bool new_full = recover_ssa_packed_slots(ssa, index, candidate); kernel_owner_observed("CAPTURED_OWNER_CANDIDATE_FULL", new_full, 8000000, candidate);
	var old_budget = new RecoverWork(remaining); bool old_actual = baseline_packed_slots(ssa, index, old_budget); kernel_owner_observed("CAPTURED_OWNER_BASELINE_ACTUAL", old_actual, remaining, old_budget);
	var new_budget = new RecoverWork(remaining); bool new_actual = recover_ssa_packed_slots(ssa, index, new_budget); kernel_owner_observed("CAPTURED_OWNER_CANDIDATE_ACTUAL", new_actual, remaining, new_budget);
	return old_full && new_full && new_actual && !candidate.exhausted && !new_budget.exhausted && candidate.remaining > baseline.remaining;
}

int main(string[] args) {
	if (len(args) > 1) {
		try {
			if (len(args) == 4 && args[1] == "--graph") {
				if (kernel_captured_graph(args[2], args[3])) return 42;
				return 1;
			}
			if (len(args) == 13 && args[1] == "--owner-graph") {
				if (kernel_captured_owners(args)) return 42;
				return 1;
			}
			return 2;
		} catch (Error error) { println_stderr(error.message); return 3; }
	}
	if (!kernel_slot_controls()) return 1;
	if (!kernel_owner_walk(true, true, 2048) || !kernel_owner_walk(true, false, 2048)) return 2;
	if (!kernel_owner_walk(false, true, 2048) || !kernel_owner_walk(false, false, 2048)) return 3;
	if (!kernel_physical_binders()) return 4;
	if (dominance_exhaustive() != 42 || dominance_generated() != 42 || dominance_chain() != 42) return 5;
	try {
		if (!kernel_width_controls()) return 6;
	} catch (Error error) { println_stderr(error.message); return 8; }
	if (!kernel_generated_slots()) return 7;
	if (!kernel_sparse_reservations()) return 9;
	return 42;
}
