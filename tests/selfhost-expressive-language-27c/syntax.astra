owned SyntaxProgram expressive_program(string text) throws Error {
	var bytes = new u8[text.byte_length];
	int i = 0;
	while (i < len(bytes)) {
		bytes[i] = astra_host_text_byte(text, i) as u8;
		i = i + 1;
	}
	var buffer = source_buffer("expressive-input", move bytes, false);
	var retained = shared_acquire(move buffer);
	var entries = new Vector<SourceEntry>(1);
	var entry = new SourceEntry(move retained);
	assert_that(entries.append(move entry));
	var sources = source_set(move entries);
	var program = syntax_program(move sources);
	return move program;
}

void expressive_argument_labels() throws Error {
	var program = expressive_program("language astra27b; int pick(int first, int last) { return first; } int main() { return pick(last: 22, first: 20); }");
	assert_that(!program.failed() && syntax_program_languages_verified(program));
	int calls = 0;
	int i = 1;
	while (i <= program.arena.node_count) {
		SyntaxNodeId node = {index = i};
		if (program.arena.kind(node) == SyntaxKind.CallExpressionSyntax()) {
			assert_that(syntax_call_labels_verified(program.arena, node));
			var names = program.arena.get_list_argument_names(node);
			var colons = program.arena.get_list_argument_colons(node);
			var arguments = program.arena.get_list_arguments(node);
			assert_that(program.arena.list_count(names) == 2 && program.arena.list_count(colons) == 2 && program.arena.list_count(arguments) == 2);
			assert_that(program.arena.token_is(program.arena.token_at(names, 0), "last"));
			assert_that(program.arena.token_is(program.arena.token_at(names, 1), "first"));
			assert_that(program.arena.token_is(program.arena.token_at(colons, 0), ":"));
			assert_that(program.arena.token_is(program.arena.get_token_literal(program.arena.node_at(arguments, 0)), "22"));
			assert_that(program.arena.token_is(program.arena.get_token_literal(program.arena.node_at(arguments, 1)), "20"));
			SyntaxListId absent = {index = 0};
			program.arena.set_argument_labels(node, absent, absent);
			assert_that(!syntax_call_labels_verified(program.arena, node));
			program.arena.set_argument_labels(node, names, colons);
			assert_that(syntax_call_labels_verified(program.arena, node));
			var reversed = program.arena.new_list(-1);
			program.arena.append_token(reversed, program.arena.token_at(names, 1));
			program.arena.append_token(reversed, program.arena.token_at(names, 0));
			program.arena.set_argument_labels(node, reversed, colons);
			assert_that(!syntax_call_labels_verified(program.arena, node));
			program.arena.set_argument_labels(node, names, colons);
			assert_that(syntax_call_labels_verified(program.arena, node));
			calls = calls + 1;
		}
		i = i + 1;
	}
	assert_that(calls == 1);
	var construction = expressive_program("language astra27b; class Item { init(int first, int last) {} } int main() { var value = new Item(last: 22, first: 20); return 42; }");
	assert_that(!construction.failed());
	int heaps = 0;
	i = 1;
	while (i <= construction.arena.node_count) {
		SyntaxNodeId node = {index = i};
		if (construction.arena.kind(node) == SyntaxKind.HeapObjectConstructionSyntax()) {
			assert_that(construction.arena.list_count(construction.arena.get_list_argument_names(node)) == 2);
			assert_that(syntax_call_labels_verified(construction.arena, node));
			heaps = heaps + 1;
		}
		i = i + 1;
	}
	assert_that(heaps == 1);
	var mixed = expressive_program("language astra27b; int main() { return choose(1, last: 2, middle: 3,); }");
	assert_that(!mixed.failed());
	var generic = expressive_program("language astra27b; int main() { return identity<int>(value: 42); }");
	assert_that(!generic.failed());
	var duplicate = expressive_program("language astra27b; int main() { return choose(first: 1, first: 2); }");
	assert_that(duplicate.failed());
	var positional = expressive_program("language astra27b; int main() { return choose(first: 1, 2); }");
	assert_that(positional.failed());
	var missing = expressive_program("language astra27b; int main() { return choose(first:); }");
	assert_that(missing.failed());
	var legacy = expressive_program("language legacy27a; int main() { return choose(first: 42); }");
	assert_that(legacy.failed());
}

void expressive_match_patterns() throws Error {
	var program = expressive_program("language astra27b; enum Problem { NotFound, Decode(int code) } enum Result { Success(int value), Failure(Problem problem) } int status(Result result) => match (result) { case Result.Success(value) => value; case Result.Failure(Problem.NotFound()) => 1; case Result.Failure(Problem.Decode(code)) => code+2; };");
	assert_that(!program.failed() && syntax_program_languages_verified(program));
	int matches = 0;
	int i = 1;
	while (i <= program.arena.node_count) {
		SyntaxNodeId node = {index = i};
		if (program.arena.kind(node) == SyntaxKind.MatchExpressionSyntax()) {
			var data = program.arena.match_expression(node);
			assert_that(program.arena.list_count(data.f_arms) == 3 && data.f_scrutinee.index != 0);
			var first = program.arena.node_at(data.f_arms, 0);
			var last = program.arena.node_at(data.f_arms, 2);
			assert_that(program.arena.get_node_body(first).index == 0 && program.arena.get_node_expression(first).index != 0);
			assert_that(program.arena.token_is(program.arena.get_token_match_arrow(first), "=>"));
			var bindings = program.arena.get_list_bindings(last);
			assert_that(program.arena.list_count(bindings) == 1);
			var binding = program.arena.node_at(bindings, 0);
			var nested = program.arena.get_node_nested_pattern(binding);
			assert_that(nested.index != 0 && program.arena.token_is(program.arena.get_token_variant(nested), "Decode"));
			assert_that(program.arena.get_node_expression(nested).index == 0 && program.arena.get_node_body(nested).index == 0);
			var leaf_bindings = program.arena.get_list_bindings(nested);
			assert_that(program.arena.list_count(leaf_bindings) == 1);
			var leaf = program.arena.node_at(leaf_bindings, 0);
			assert_that(program.arena.token_is(program.arena.get_token_binding(leaf), "code"));
			matches = matches + 1;
		}
		i = i + 1;
	}
	assert_that(matches == 1);
	var observation = syntax_program_dump(program);
	var projection = syntax_projection(program);
	assert_that(observation.text.byte_length > 0 && projection.text.byte_length > 0);
	var missing_semicolon = expressive_program("language astra27b; int main() { return match (value) { case Mode.One() => 42 }; }");
	assert_that(missing_semicolon.failed());
	var malformed_pattern = expressive_program("language astra27b; int main() { return match (value) { case Mode.One => 42; }; }");
	assert_that(malformed_pattern.failed());
	var fallback = expressive_program("language astra27b; int main() { return match (value) { else => 42; }; }");
	assert_that(fallback.failed());
	var empty = expressive_program("language astra27b; int main() { return match (value) {}; }");
	assert_that(empty.failed());
	var legacy = expressive_program("language legacy27a; int main() { return match (value) { case Mode.One() => 42; }; }");
	assert_that(legacy.failed());
}

void expressive_token_sequence(string text, string expected) throws Error {
	var bytes = new u8[text.byte_length]; int at = 0;
	while (at < len(bytes)) {
		bytes[at] = astra_host_text_byte(text, at) as u8; at = at + 1;
	}
	var source = source_buffer("expressive-token-input", move bytes, false);
	var retained = shared_acquire(move source);
	var scanner = lexer(move retained); at = 0;
	assert_that(expected.byte_length % 3 == 2);
	while (at < expected.byte_length) {
		int code = (astra_host_text_byte(expected, at)-48)*10+astra_host_text_byte(expected, at+1)-48;
		var token = scanner.next_token();
		assert_that(!scanner.failed && token_kind_code(token.kind()) == code);
		if (token.kind() == TokenKind.RANGE()) assert_that(token.spelling.text == ".." && token.span.end - token.span.start == 2);
		if (token.kind() == TokenKind.RANGE_INCLUSIVE()) assert_that(token.spelling.text == "..=" && token.span.end - token.span.start == 3);
		at = at + 3;
	}
	var end = scanner.next_token(); assert_that(!scanner.failed && end.kind() == TokenKind.EOF());
}

void expressive_range_tokens() throws Error {
	// Header tokens are identifiers, identifiers and semicolon in both profiles.
	expressive_token_sequence("language astra27b; 20..80 20..=80", "01 01 69 24 95 24 24 96 24");
	expressive_token_sequence("language astra27b; 1...2 value.field 1.0..2.0", "01 01 69 24 39 39 39 24 01 39 01 25 95 25");
	expressive_token_sequence("language legacy27a; 20..=80", "01 01 69 24 39 39 70 24");
	expressive_token_sequence("language astra27b; 0xff..=0x100 a<b", "01 01 69 24 96 24 01 83 01");
	expressive_token_sequence("language astra27b; ....", "01 01 69 39 39 39 39");
	assert_that(token_kind_from_code(94) == TokenKind.COMPOUND_ASSIGNMENT() && token_kind_from_code(95) == TokenKind.RANGE() && token_kind_from_code(96) == TokenKind.RANGE_INCLUSIVE());
}

void expressive_compound_receivers() throws Error {
	var program = expressive_program("language astra27b; int main() { var values = (20..=80).step_by(5).collect_array(); if ((20..80).contains(42)) return 42; return 1; }");
	assert_that(!program.failed() && syntax_program_languages_verified(program));
	int calls = 0; int at = 1;
	while (at <= program.arena.node_count) {
		SyntaxNodeId node = {index = at};
		if (program.arena.kind(node) == SyntaxKind.CallExpressionSyntax()) {
			var receiver = program.arena.get_node_receiver_place(node);
			assert_that(receiver.index > 0 && syntax_call_labels_verified(program.arena, node));
			assert_that(program.arena.header(node).span.start == program.arena.header(receiver).span.start);
			calls = calls + 1;
		}
		at = at + 1;
	}
	assert_that(calls == 3);
	var legacy = expressive_program("language legacy27a; int main() { return (value).contains(42); }");
	assert_that(legacy.failed());
}

void expressive_lambda_syntax() throws Error {
	var program = expressive_program("language astra27b; int main() { var values = (0..100).map(i => i*i).filter(value => value>0); return values.sum(); }");
	assert_that(!program.failed() && syntax_program_languages_verified(program));
	int lambdas = 0; int at = 1;
	while (at <= program.arena.node_count) {
		SyntaxNodeId node = {index = at};
		if (program.arena.kind(node) == SyntaxKind.LambdaExpressionSyntax()) {
			var data = program.arena.lambda_expression(node); lambdas = lambdas + 1;
			assert_that(program.arena.token_kind(data.f_binding) == TokenKind.IDENTIFIER() && program.arena.token_kind(data.f_arrow) == TokenKind.FAT_ARROW());
			assert_that(data.f_expression.index > 0 && program.arena.header(node).span.start == program.arena.token_span(data.f_binding).start && program.arena.header(node).span.end == program.arena.header(data.f_expression).span.end);
		}
		at = at + 1;
	}
	assert_that(lambdas == 2);
	var projection = syntax_projection(program); var observation = syntax_program_dump(program);
	assert_that(projection.text.byte_length > 0 && observation.text.byte_length > 0);
	var legacy = expressive_program("language legacy27a; int main() { return apply(i => i*i); }"); assert_that(legacy.failed());
	var missing = expressive_program("language astra27b; int main() { return apply(i => ); }"); assert_that(missing.failed());
}

void expressive_interpolation_syntax() throws Error {
	var program = expressive_program("language astra27b; int main() { format_into(builder, $\"{{offset}} {offset}, count {size(1, 2)}; \\u00e9\"); format_text($\"{42}\"); format_text($\"\"); return 42; }");
	assert_that(!program.failed() && syntax_program_languages_verified(program)); int plans = 0; int at = 1;
	while (at <= program.arena.node_count) {
		SyntaxNodeId node = {index = at};
		if (program.arena.kind(node) == SyntaxKind.InterpolationExpressionSyntax()) {
			assert_that(syntax_interpolation_verified(program.arena, node)); var original = program.arena.interpolation_expression(node);
			SyntaxListId absent = {index = 0}; var changed = original; changed.f_parts = absent; program.arena.replace_interpolation_expression(node, changed);
			assert_that(!syntax_interpolation_verified(program.arena, node)); program.arena.replace_interpolation_expression(node, original); assert_that(syntax_interpolation_verified(program.arena, node));
			if (plans == 0) {
				var text = program.arena.payload_message(program.arena.token_at(original.f_parts, 0));
				assert_that(text.text == "{offset} ");
				assert_that(program.arena.list_count(original.f_arguments) == 2);
			}
			plans = plans + 1;
		}
		at = at + 1;
	}
	assert_that(plans == 3);
	var legacy = expressive_program("language legacy27a; int main() { format_text($\"value {42}\"); return 42; }"); assert_that(legacy.failed());
	var unclosed = expressive_program("language astra27b; int main() { format_text($\"value {42\"); return 42; }"); assert_that(unclosed.failed());
	var empty = expressive_program("language astra27b; int main() { format_text($\"value {}\"); return 42; }"); assert_that(empty.failed());
	var brace = expressive_program("language astra27b; int main() { format_text($\"value }\"); return 42; }"); assert_that(brace.failed());
	var nested = expressive_program("language astra27b; int main() { format_text($\"{format_text($\"nested\")}\"); return 42; }"); assert_that(nested.failed());
}

void expressive_comprehension_syntax() throws Error {
	var program = expressive_program("language astra27b; int main() { var values = [for (var i in 0..100) => i*i]; var nested = [for (var j in (20..=80).step_by(5)) => j+1]; return 42; }");
	assert_that(!program.failed()); int count = 0; int at = 1;
	while (at <= program.arena.node_count) {
		SyntaxNodeId node = {index = at};
		if (program.arena.kind(node) == SyntaxKind.ComprehensionExpressionSyntax()) {
			assert_that(syntax_kind_code(program.arena.kind(node)) == 100 && syntax_comprehension_verified(program.arena, node));
			var original = program.arena.comprehension_expression(node); var changed = original; changed.f_arrow = original.f_in_keyword;
			program.arena.replace_comprehension_expression(node, changed); assert_that(!syntax_comprehension_verified(program.arena, node));
			program.arena.replace_comprehension_expression(node, original); assert_that(syntax_comprehension_verified(program.arena, node));
			changed = original; changed.f_collection = original.f_expression; program.arena.replace_comprehension_expression(node, changed); assert_that(!syntax_comprehension_verified(program.arena, node));
			program.arena.replace_comprehension_expression(node, original); assert_that(syntax_comprehension_verified(program.arena, node)); count = count + 1;
		}
		at = at + 1;
	}
	assert_that(count == 2); var projection = syntax_projection(program); var observation = syntax_program_dump(program); assert_that(projection.text.byte_length > 0 && observation.text.byte_length > 0);
	var legacy = expressive_program("language legacy27a; int main() { var values = [for (var i in 0..3) => i]; return 42; }"); assert_that(legacy.failed());
	var missing_binding = expressive_program("language astra27b; int main() { var values = [for (var in 0..3) => 1]; return 42; }"); assert_that(missing_binding.failed());
	var missing_element = expressive_program("language astra27b; int main() { var values = [for (var i in 0..3) => ]; return 42; }"); assert_that(missing_element.failed());
	var missing_close = expressive_program("language astra27b; int main() { var values = [for (var i in 0..3) => i; return 42; }"); assert_that(missing_close.failed());
	var unqualified_filter = expressive_program("language astra27b; int main() { var values = [for (var i in 0..3) if (i>0) => i]; return 42; }"); assert_that(unqualified_filter.failed());
}

void expressive_checkpoint_extensions() throws Error {
	var program = expressive_program("language astra27b; int main() { apply(i => i+1); format_text($\"value {42}\"); var data = [for (var i in 0..3) => i*i]; return 42; }"); assert_that(!program.failed());
	int count = program.arena.node_count; int at = 1; int families = 0;
	while (at <= count) {
		SyntaxNodeId node = {index = at}; var kind = program.arena.kind(node);
		if (kind == SyntaxKind.LambdaExpressionSyntax() || kind == SyntaxKind.InterpolationExpressionSyntax() || kind == SyntaxKind.ComprehensionExpressionSyntax()) {
			var header = program.arena.header(node); int attempt = 0;
			while (attempt < 16) {
				var before = program.arena.checkpoint(); var added = syntax_no_node();
				if (kind == SyntaxKind.LambdaExpressionSyntax()) added = program.arena.add_lambda_expression(program.arena.lambda_expression(node), header.span, header.depth);
				if (kind == SyntaxKind.InterpolationExpressionSyntax()) added = program.arena.add_interpolation_expression(program.arena.interpolation_expression(node), header.span, header.depth);
				if (kind == SyntaxKind.ComprehensionExpressionSyntax()) added = program.arena.add_comprehension_expression(program.arena.comprehension_expression(node), header.span, header.depth);
				var during = program.arena.checkpoint(); assert_that(added.index == count+1 && during.used == before.used+1);
				if (kind == SyntaxKind.LambdaExpressionSyntax()) assert_that(during.lambda_expression_used == before.lambda_expression_used+1);
				if (kind == SyntaxKind.InterpolationExpressionSyntax()) assert_that(during.interpolation_expression_used == before.interpolation_expression_used+1);
				if (kind == SyntaxKind.ComprehensionExpressionSyntax()) assert_that(during.comprehension_expression_used == before.comprehension_expression_used+1);
				program.arena.rewind(before); var after = program.arena.checkpoint();
				assert_that(after.used == before.used && after.lambda_expression_used == before.lambda_expression_used && after.interpolation_expression_used == before.interpolation_expression_used && after.comprehension_expression_used == before.comprehension_expression_used && program.arena.node_count == count);
				attempt = attempt+1;
			}
			families = families+1;
		}
		at = at+1;
	}
	assert_that(families == 3);
}

int main() {
	try {
		expressive_argument_labels();
		expressive_match_patterns();
		expressive_range_tokens();
		expressive_compound_receivers();
		expressive_lambda_syntax();
		expressive_interpolation_syntax();
		expressive_comprehension_syntax();
		expressive_checkpoint_extensions();
		return 42;
	} catch (Error error) {
		return 1;
	}
}
