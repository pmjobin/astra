// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Real source lowering with independently consumed owner/CFG/SSA mutations.
owned RecoverSsa expressive_ssa(string text) throws Error {
	var source = new Utf8ByteBuilder(); source_append_text(source, text);
	source_append_text(source, "\n[ExceptionRoot] class Error { readonly string text; init(string message) { this.text = message; } virtual property string message { get { return this.text; } } }\n");
	var complete = source.snapshot();
	var bytes = new u8[complete.text.byte_length]; int at = 0;
	while (at < len(bytes)) {
		bytes[at] = astra_host_text_byte(complete.text, at) as u8;
		at = at + 1;
	}
	var buffer = source_buffer("expressive-ssa-input", move bytes, false);
	var retained = shared_acquire(move buffer);
	var entries = new Vector<SourceEntry>(1);
	var entry = new SourceEntry(move retained); assert_that(entries.append(move entry));
	var sources = source_set(move entries);
	var program = syntax_program(move sources);
	var bindings = binding_index(move program, 0);
	var checked = checked_build_effects_profile(move bindings, 0);
	assert_that(!checked.failed() && checked.validate() && generic_verify(checked));
	var flow = recover_flow_lower(move checked, 8192);
	assert_that(flow.data.status == 0 && recover_flow_verify(flow));
	var core = recover_core_lower(move flow);
	assert_that(core.status == 0 && recover_core_verify(core));
	var cfg = recover_cfg_lower(move core, 8192);
	assert_that(cfg.status == 0 && recover_cfg_verify(cfg));
	var ssa = recover_ssa_lower(move cfg, 8000000);
	assert_that(ssa.data.status == 0 && recover_ssa_verify(ssa));
	return move ssa;
}

void expressive_abort_count(RecoverOwners owners, int count) { owners.abort_count = count; }

void expressive_abort_mutations(RecoverSsa ssa, int count) {
	assert_that(ssa.cfg.core.owners.abort_count == count);
	int at = 0;
	while (at < count) {
		var original = ssa.cfg.core.owners.aborts[at];
		var changed = original; changed.reservation = original.operation;
		ssa.cfg.core.owners.aborts[at] = changed;
		assert_that(!recover_owners_verify(ssa.cfg.core.owners, ssa.cfg.core.flow));
		ssa.cfg.core.owners.aborts[at] = original;
		assert_that(recover_owners_verify(ssa.cfg.core.owners, ssa.cfg.core.flow));
		at = at + 1;
	}
	int original_count = ssa.cfg.core.owners.abort_count;
	expressive_abort_count(ssa.cfg.core.owners, count - 1);
	assert_that(!recover_owners_verify(ssa.cfg.core.owners, ssa.cfg.core.flow));
	expressive_abort_count(ssa.cfg.core.owners, original_count);
	assert_that(recover_core_verify(ssa.cfg.core));
	int retired = 0; at = 0;
	while (at < ssa.cfg.block_count) {
		var original = ssa.cfg.blocks[at];
		if (original.opcode == 84) {
			retired = retired + 1;
			var changed = original; changed.opcode = 37;
			ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg));
			changed = original; changed.a = original.origin;
			ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg));
			changed = original; changed.rank = 0;
			ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg));
			ssa.cfg.blocks[at] = original;
			assert_that(recover_cfg_verify(ssa.cfg) && recover_ssa_verify(ssa));
			var value = ssa.data.values[original.a];
			assert_that(value.channel == 4);
			var wrong = value; wrong.channel = 0;
			ssa.data.values[original.a] = wrong;
			assert_that(!recover_ssa_verify(ssa));
			ssa.data.values[original.a] = value;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(retired == count);
}

void expressive_owning_match() throws Error {
	var ssa = expressive_ssa("language astra27b; enum Packet { Empty, Data(owned int[] data, int count) } enum Envelope { Missing, Child(Packet packet, owned int[] tail) } owned int[] take(Packet value) => match (move value) { case Packet.Empty() => new int[0]; case Packet.Data(data, count) => move data; }; int inspect(Packet value) => match (value) { case Packet.Empty() => 0; case Packet.Data(data, count) => len(data)+count; }; int nested(Envelope value) => match (move value) { case Envelope.Missing() => 0; case Envelope.Child(Packet.Empty(), tail) => len(tail); case Envelope.Child(Packet.Data(data, count), tail) => len(data)+count+len(tail); }; int marker(bool fail) throws Error { if (fail) { throw new Error(\"arm failure\"); } return 29; } int consume(Packet value, bool fail) throws Error => match (move value) { case Packet.Empty() => 0; case Packet.Data(data, count) => len(data)+marker(fail); }; int main() { var state = Packet.Data(new int[13],13); owned int[] values = take(move state); var pending = Envelope.Child(Packet.Data(new int[7],7),new int[5]); return nested(move pending)+len(values)+10; }");
	int captures = 0; int publications = 0; int residuals = 0; int at = 0;
	while (at < ssa.cfg.block_count) {
		var original = ssa.cfg.blocks[at];
		if (original.opcode == 85 || original.opcode == 86 || original.opcode == 87) {
			if (original.opcode == 85) captures = captures + 1;
			if (original.opcode == 86) publications = publications + 1;
			if (original.opcode == 87) residuals = residuals + 1;
			var changed = original; changed.opcode = 37;
			ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg));
			ssa.cfg.blocks[at] = original;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(captures == 4 && publications == 10 && residuals == 7);
}

int main() {
	try {
		var nested = expressive_ssa("language astra27b; class Item { int value; init(int value) { this.value = value; } } int marker(bool fail) throws Error { if (fail) { throw new Error(\"operand failure\"); } return 0; } owned Item forward(owned Item item, int marker) { return move item; } int eat(owned Item left, owned Item right, int marker) { return left.value+right.value+marker; } int attempt(bool fail) { try { return eat(right: new Item(22), left: forward(item: new Item(20), marker: marker(fail)), marker: 0); } catch (Error error) { return 42; } } int main() { return attempt(true); }");
		expressive_abort_mutations(nested, 2);
		var first = nested.cfg.core.owners.aborts[0]; var second = nested.cfg.core.owners.aborts[1];
		nested.cfg.core.owners.aborts[0] = second; nested.cfg.core.owners.aborts[1] = first;
		assert_that(!recover_owners_verify(nested.cfg.core.owners, nested.cfg.core.flow));
		nested.cfg.core.owners.aborts[0] = first; nested.cfg.core.owners.aborts[1] = second;
		assert_that(recover_ssa_verify(nested));
		var buffer = expressive_ssa("language astra27b; int marker(bool fail) throws Error { if (fail) { throw new Error(\"operand failure\"); } return 29; } int eat(owned int[] values, int marker) { return len(values)+marker; } int attempt(bool fail) { try { return eat(values: new int[13], marker: marker(fail)); } catch (Error error) { return 42; } } int main() { return attempt(true); }");
		expressive_abort_mutations(buffer, 1);
		var conditional = expressive_ssa("language astra27b; class Item { int value; init(int value) { this.value = value; } } int marker(bool fail) throws Error { if (fail) { throw new Error(\"operand failure\"); } return 0; } int eat(owned Item left, owned Item right, int marker) { return left.value+right.value+marker; } int attempt(bool fail) { try { return eat(right: fail ? new Item(22) : new Item(22), left: new Item(20), marker: marker(fail)); } catch (Error error) { return 42; } } int main() { return attempt(true); }");
		expressive_abort_mutations(conditional, 2);
		var matched = expressive_ssa("language astra27b; enum Choice { First, Last } class Item { int value; init(int value) { this.value = value; } } int marker(bool fail) throws Error { if (fail) { throw new Error(\"operand failure\"); } return 0; } int eat(owned Item left, owned Item right, int marker) { return left.value+right.value+marker; } int attempt(bool fail) { try { return eat(right: match (Choice.Last()) { case Choice.First() => new Item(1); case Choice.Last() => new Item(22); }, left: new Item(20), marker: marker(fail)); } catch (Error error) { return 42; } } int main() { return attempt(true); }");
		expressive_abort_mutations(matched, 2);
		expressive_owning_match();
		return 42;
	} catch (Error error) { println_stderr(error.message); return 1; }
}
