// Real source lowering with independently consumed owner/CFG/SSA mutations.
owned RecoverSsa expressive_ssa(string text) throws Error {
	var source = new Utf8ByteBuilder(); source_append_text(source, text);
	source_append_text(source, "\n[ExceptionRoot] class Error { readonly string text; init(string message) { this.text = message; } virtual property string message { get { return this.text; } } }\n");
	var complete = source.snapshot();
	var bytes = new u8[complete.text.byte_length]; int at = 0;
	while (at < len(bytes)) {
		bytes[at] = astra_host_text_byte(complete.text, at) as u8;
		at = at + 1;
	}
	var buffer = source_buffer("expressive-ssa-input", move bytes, false);
	var retained = shared_acquire(move buffer);
	var entries = new Vector<SourceEntry>(1);
	var entry = new SourceEntry(move retained); assert_that(entries.append(move entry));
	var sources = source_set(move entries);
	var program = syntax_program(move sources);
	var bindings = binding_index(move program, 0);
	var checked = checked_build_effects_profile(move bindings, 0);
	if (checked.failed()) {
		var observation = checked_observation(checked); print(observation.text);
	}
	assert_that(!checked.failed() && checked.validate() && generic_verify(checked));
	var flow = recover_flow_lower(move checked, 8192);
	assert_that(flow.data.status == 0 && recover_flow_verify(flow));
	var core = recover_core_lower(move flow);
	assert_that(core.status == 0 && recover_core_verify(core));
	var cfg = recover_cfg_lower(move core, 8192);
	assert_that(cfg.status == 0 && recover_cfg_verify(cfg));
	var ssa = recover_ssa_lower(move cfg, 8000000);
	assert_that(ssa.data.status == 0 && recover_ssa_verify(ssa));
	return move ssa;
}

void expressive_abort_count(RecoverOwners owners, int count) { owners.abort_count = count; }

void expressive_abort_mutations(RecoverSsa ssa, int count) {
	assert_that(ssa.cfg.core.owners.abort_count == count);
	int at = 0;
	while (at < count) {
		var original = ssa.cfg.core.owners.aborts[at];
		var changed = original; changed.reservation = original.operation;
		ssa.cfg.core.owners.aborts[at] = changed;
		assert_that(!recover_owners_verify(ssa.cfg.core.owners, ssa.cfg.core.flow));
		ssa.cfg.core.owners.aborts[at] = original;
		assert_that(recover_owners_verify(ssa.cfg.core.owners, ssa.cfg.core.flow));
		at = at + 1;
	}
	int original_count = ssa.cfg.core.owners.abort_count;
	expressive_abort_count(ssa.cfg.core.owners, count - 1);
	assert_that(!recover_owners_verify(ssa.cfg.core.owners, ssa.cfg.core.flow));
	expressive_abort_count(ssa.cfg.core.owners, original_count);
	assert_that(recover_core_verify(ssa.cfg.core));
	int retired = 0; at = 0;
	while (at < ssa.cfg.block_count) {
		var original = ssa.cfg.blocks[at];
		if (original.opcode == 84) {
			retired = retired + 1;
			var changed = original; changed.opcode = 37;
			ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg));
			changed = original; changed.a = original.origin;
			ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg));
			changed = original; changed.rank = 0;
			ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg));
			ssa.cfg.blocks[at] = original;
			assert_that(recover_cfg_verify(ssa.cfg) && recover_ssa_verify(ssa));
			var value = ssa.data.values[original.a];
			assert_that(value.channel == 4);
			var wrong = value; wrong.channel = 0;
			ssa.data.values[original.a] = wrong;
			assert_that(!recover_ssa_verify(ssa));
			ssa.data.values[original.a] = value;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(retired == count);
}

void expressive_owning_match() throws Error {
	var ssa = expressive_ssa("language astra27b; enum Packet { Empty, Data(owned int[] data, int count) } enum Envelope { Missing, Child(Packet packet, owned int[] tail) } owned int[] take(Packet value) => match (move value) { case Packet.Empty() => new int[0]; case Packet.Data(data, count) => move data; }; int inspect(Packet value) => match (value) { case Packet.Empty() => 0; case Packet.Data(data, count) => len(data)+count; }; int nested(Envelope value) => match (move value) { case Envelope.Missing() => 0; case Envelope.Child(Packet.Empty(), tail) => len(tail); case Envelope.Child(Packet.Data(data, count), tail) => len(data)+count+len(tail); }; int marker(bool fail) throws Error { if (fail) { throw new Error(\"arm failure\"); } return 29; } int consume(Packet value, bool fail) throws Error => match (move value) { case Packet.Empty() => 0; case Packet.Data(data, count) => len(data)+marker(fail); }; int main() { var state = Packet.Data(new int[13],13); owned int[] values = take(move state); var pending = Envelope.Child(Packet.Data(new int[7],7),new int[5]); return nested(move pending)+len(values)+10; }");
	int captures = 0; int publications = 0; int residuals = 0; int at = 0;
	while (at < ssa.cfg.block_count) {
		var original = ssa.cfg.blocks[at];
		if (original.opcode == 85 || original.opcode == 86 || original.opcode == 87) {
			if (original.opcode == 85) captures = captures + 1;
			if (original.opcode == 86) publications = publications + 1;
			if (original.opcode == 87) residuals = residuals + 1;
			var changed = original; changed.opcode = 37;
			ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg));
			ssa.cfg.blocks[at] = original;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(captures == 4 && publications == 10 && residuals == 7);
}

void expressive_ranges() throws Error {
	var ssa = expressive_ssa("language astra27b; Range<int> interval(int first, int last) { return first..=last; } int measure(Range<int> value) { if (value.is_empty()) return 0; if (!value.contains(value.start)) return 1; return value.end-value.start; } int main() { var values = interval(20,62); var copied = values; values = 30..72; return measure(values)+measure(copied)-42; }");
	int bounds = 0; int ranges = 0; int queries = 0; int at = 0;
	while (at < ssa.cfg.core.flow.data.node_count) {
		var original = ssa.cfg.core.flow.data.nodes[at];
		var receiver = no_type();
		if (original.kind == 12) receiver = range_receiver_type(ssa.cfg.core.flow.checked, original.source);
		if (original.kind == 12 && range_type_verified(ssa.cfg.core.flow.checked.types, receiver)) {
			bounds = bounds + 1;
			var changed = original; changed.token = ssa.cfg.core.flow.checked.bindings.program.arena.get_token_identifier(original.source);
			ssa.cfg.core.flow.data.nodes[at] = changed;
			assert_that(!recover_flow_verify(ssa.cfg.core.flow));
			ssa.cfg.core.flow.data.nodes[at] = original;
			assert_that(recover_ssa_verify(ssa));
		}
		if (original.kind == 88) {
			queries = queries + 1;
			var changed = original; changed.symbol = type_symbol(0);
			ssa.cfg.core.flow.data.nodes[at] = changed;
			assert_that(!recover_flow_verify(ssa.cfg.core.flow));
			ssa.cfg.core.flow.data.nodes[at] = original;
			assert_that(recover_ssa_verify(ssa));
		}
		if (original.kind == 3 && range_type_verified(ssa.cfg.core.flow.checked.types, original.type)) {
			ranges = ranges + 1;
			var changed = original; changed.b = original.a;
			ssa.cfg.core.flow.data.nodes[at] = changed;
			assert_that(!recover_flow_verify(ssa.cfg.core.flow));
			ssa.cfg.core.flow.data.nodes[at] = original;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(bounds == 3 && ranges == 2 && queries == 2);
}

void expressive_range_iteration() throws Error {
	var ssa = expressive_ssa("language astra27b; int iterate(int count) { int total = 0; foreach (var item in 0..count) { if (item == 2) continue; if (item == 8) break; total = total+item; } return total; } int edge() { i64 last = 9223372036854775807; foreach (var item in last..=last) { if (item != last) return 1; } return 42; } int unsigned_edge() { u64 last = 18446744073709551615; int count = 0; foreach (var item in last..=last) { count = count+1; } return count; } int main() { return iterate(10)+edge()-unsigned_edge()-25; }");
	int loops = 0; int conditions = 0; int at = 0;
	while (at < ssa.cfg.block_count) {
		var original = ssa.cfg.blocks[at];
		if (original.opcode == 89) loops = loops + 1;
		if (original.opcode == 90 || original.opcode == 91) {
			conditions = conditions + 1;
			var changed = original; changed.next = original.other; ssa.cfg.blocks[at] = changed;
			assert_that(!recover_cfg_verify(ssa.cfg)); ssa.cfg.blocks[at] = original;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(loops == 3 && conditions == 6);
}

void expressive_range_stride() throws Error {
	var ssa = expressive_ssa("language astra27b; RangeSequence<int> steps(int first, int last, int stride) { return (first..=last).step_by(stride); } int total(RangeSequence<int> sequence) { int sum = 0; foreach (var item in sequence) { sum = sum+item; } return sum; } int main() { var sequence = steps(20,80,5); int count = 0; foreach (var item in sequence) { count = count+1; } u64 last = 18446744073709551615; u64 first = last-6; u64 stride = 4; foreach (var item in (first..=last).step_by(stride)) { count = count+1; } return total(sequence)+count-623; }");
	int strides = 0; int loops = 0; int at = 0;
	while (at < ssa.cfg.core.flow.data.node_count) {
		var original = ssa.cfg.core.flow.data.nodes[at];
		if (original.kind == 93) {
			strides = strides + 1;
			var changed = original; changed.b = 0; ssa.cfg.core.flow.data.nodes[at] = changed;
			assert_that(!recover_flow_verify(ssa.cfg.core.flow)); ssa.cfg.core.flow.data.nodes[at] = original;
			assert_that(recover_ssa_verify(ssa));
		}
		if (original.kind == 89) loops = loops + 1;
		at = at + 1;
	}
	assert_that(strides == 2 && loops == 3);
}

void expressive_range_slices() throws Error {
	var ssa = expressive_ssa("language astra27b; int read(borrowed int[] values) { return len(values)+values[0]; } int main() { owned int[] data = new int[13]; data[0] = 20; data[12] = 22; return len(data[0..13])+data[0..1][0]+read(data[12..13])+len(data[0..13][1..12])+len(data[13..13])-25; }");
	int slices = 0; int at = 0;
	while (at < ssa.cfg.core.count) {
		var original = ssa.cfg.core.nodes[at];
		if (original.value.kind == 56) {
			slices = slices + 1; var changed = original; changed.borrowed_owner = 0; ssa.cfg.core.nodes[at] = changed;
			assert_that(!recover_core_verify(ssa.cfg.core)); ssa.cfg.core.nodes[at] = original;
			assert_that(recover_ssa_verify(ssa));
			int edge = original.value.first+2; int bound = ssa.cfg.core.flow.data.edges[edge];
			ssa.cfg.core.flow.data.edges[edge] = ssa.cfg.core.flow.data.edges[original.value.first+1];
			assert_that(!recover_flow_verify(ssa.cfg.core.flow)); ssa.cfg.core.flow.data.edges[edge] = bound;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(slices == 6);
}

void expressive_range_collect() throws Error {
	var ssa = expressive_ssa("language astra27b; owned int[] values(int first, int last) { return (first..=last).step_by(5).collect_array(); } int marker(bool fail) throws Error { if (fail) { throw new Error(\"collection operand failure\"); } return 29; } int eat(owned int[] data, int marker) { return len(data)+marker; } int attempt(bool fail) { try { return eat(data: (20..=80).step_by(5).collect_array(), marker: marker(fail)); } catch (Error error) { return 42; } } int main() { var data = values(20,80); data = (20..=80).step_by(5).collect_array(); return len(data)+attempt(true)-13; }");
	int collections = 0; int at = 0;
	while (at < ssa.cfg.core.count) {
		var original = ssa.cfg.core.nodes[at];
		if (original.value.kind == 94) {
			collections = collections + 1; var changed = original; changed.result_role = 1; ssa.cfg.core.nodes[at] = changed;
			assert_that(!recover_core_verify(ssa.cfg.core)); ssa.cfg.core.nodes[at] = original;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(collections == 3); expressive_abort_mutations(ssa, 1);
}

void expressive_range_fixed() throws Error {
	var ssa = expressive_ssa("language astra27b; int main() { int[13] values = (20..=80).step_by(5).collect_fixed(); int[5] signed_values = (-10..=10).step_by(5).collect_fixed(); return values[0]+values[12]+len(signed_values)-63; }");
	int collections = 0; int at = 0;
	while (at < ssa.cfg.core.count) {
		var original = ssa.cfg.core.nodes[at];
		if (original.value.kind == 95) {
			collections = collections + 1; var changed = original; changed.result_role = 4; ssa.cfg.core.nodes[at] = changed;
			assert_that(!recover_core_verify(ssa.cfg.core)); ssa.cfg.core.nodes[at] = original;
			var source = original.value.source; var use = ssa.cfg.core.flow.checked.uses[source.index]; var corrupt = use; corrupt.flags = 4;
			ssa.cfg.core.flow.checked.uses[source.index] = corrupt; assert_that(!range_fixed_verified(ssa.cfg.core.flow.checked, source));
			ssa.cfg.core.flow.checked.uses[source.index] = use;
			assert_that(recover_ssa_verify(ssa));
		}
		at = at + 1;
	}
	assert_that(collections == 2);
}

int main(string[] args) {
	try {
		if (len(args) > 1) {
			if (len(args) < 3 || args[1] != "--source") return 2;
			var program = binding_load_program(args, 2); var bindings = binding_index(move program, 0);
			var checked = checked_build_effects_profile(move bindings, 0);
			if (checked.failed()) {
				var observation = checked_observation(checked); print(observation.text); return 3;
			}
			if (!checked.validate() || !generic_verify(checked)) return 3;
			var flow = recover_flow_lower(move checked, 8192); if (flow.data.status != 0 || !recover_flow_verify(flow)) return 4;
			var core = recover_core_lower(move flow); if (core.status != 0 || !recover_core_verify(core)) return 5;
			var cfg = recover_cfg_lower(move core, 8192); if (cfg.status != 0 || !recover_cfg_verify(cfg)) return 6;
			// Construct definitions separately so a failed proof remains available
			// to the independent detailed consumer instead of being relabelled.
			var ssa = new RecoverSsa(move cfg, 8000000); var work = new RecoverWork(8000000);
			recover_ssa_define(ssa.data, ssa.cfg, work); var detail = new int[4];
			bool valid = ssa.data.status == 0 && recover_ssa_verify_details(ssa, detail);
			var output = new Utf8ByteBuilder(); source_append_text(output, "SSA_SOURCE status="); append_int(output, ssa.data.status);
			source_append_text(output, " phase="); append_int(output, detail[0]); source_append_text(output, " item="); append_int(output, detail[1]); source_append_text(output, " remaining="); append_int(output, detail[2]); source_append_text(output, " exhausted="); append_int(output, detail[3]);
			if (!valid && detail[1] > 0) {
				int function = 0;
				if (detail[0] == 3 || detail[0] == 5) function = ssa.cfg.blocks[detail[1] - 1].function;
				if (detail[0] == 6) function = ssa.data.values[detail[1]].function;
				if (function > 0) {
					var declaration = ssa.cfg.core.flow.checked.bindings.symbol(ssa.cfg.core.flow.data.functions[function - 1].symbol);
					var name = ssa.cfg.core.flow.checked.bindings.program.arena.token_message(declaration.token);
					source_append_text(output, " function=");
					source_append_text(output, name.text);
				}
			}
			var text = output.snapshot(); println(text.text);
			if (valid) return 42; return 7;
		}
		expressive_ranges();
		expressive_range_iteration();
		expressive_range_stride();
		expressive_range_slices();
		expressive_range_collect();
		expressive_range_fixed();
		var nested = expressive_ssa("language astra27b; class Item { int value; init(int value) { this.value = value; } } int marker(bool fail) throws Error { if (fail) { throw new Error(\"operand failure\"); } return 0; } owned Item forward(owned Item item, int marker) { return move item; } int eat(owned Item left, owned Item right, int marker) { return left.value+right.value+marker; } int attempt(bool fail) { try { return eat(right: new Item(22), left: forward(item: new Item(20), marker: marker(fail)), marker: 0); } catch (Error error) { return 42; } } int main() { return attempt(true); }");
		expressive_abort_mutations(nested, 2);
		var first = nested.cfg.core.owners.aborts[0]; var second = nested.cfg.core.owners.aborts[1];
		nested.cfg.core.owners.aborts[0] = second; nested.cfg.core.owners.aborts[1] = first;
		assert_that(!recover_owners_verify(nested.cfg.core.owners, nested.cfg.core.flow));
		nested.cfg.core.owners.aborts[0] = first; nested.cfg.core.owners.aborts[1] = second;
		assert_that(recover_ssa_verify(nested));
		var buffer = expressive_ssa("language astra27b; int marker(bool fail) throws Error { if (fail) { throw new Error(\"operand failure\"); } return 29; } int eat(owned int[] values, int marker) { return len(values)+marker; } int attempt(bool fail) { try { return eat(values: new int[13], marker: marker(fail)); } catch (Error error) { return 42; } } int main() { return attempt(true); }");
		expressive_abort_mutations(buffer, 1);
		var conditional = expressive_ssa("language astra27b; class Item { int value; init(int value) { this.value = value; } } int marker(bool fail) throws Error { if (fail) { throw new Error(\"operand failure\"); } return 0; } int eat(owned Item left, owned Item right, int marker) { return left.value+right.value+marker; } int attempt(bool fail) { try { return eat(right: fail ? new Item(22) : new Item(22), left: new Item(20), marker: marker(fail)); } catch (Error error) { return 42; } } int main() { return attempt(true); }");
		expressive_abort_mutations(conditional, 2);
		var matched = expressive_ssa("language astra27b; enum Choice { First, Last } class Item { int value; init(int value) { this.value = value; } } int marker(bool fail) throws Error { if (fail) { throw new Error(\"operand failure\"); } return 0; } int eat(owned Item left, owned Item right, int marker) { return left.value+right.value+marker; } int attempt(bool fail) { try { return eat(right: match (Choice.Last()) { case Choice.First() => new Item(1); case Choice.Last() => new Item(22); }, left: new Item(20), marker: marker(fail)); } catch (Error error) { return 42; } } int main() { return attempt(true); }");
		expressive_abort_mutations(matched, 2);
		expressive_owning_match();
		return 42;
	} catch (Error error) { println_stderr(error.message); return 1; }
}
