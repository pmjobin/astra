void initialize(f64[] values) {
	int i = 0; while (i < len(values)) { values[i] = (i as f64) + 1.0d; i = i + 1; }
}
int process(CadState state) {
	initialize(state.weights);
	Vec2 point = { x = 1.0d, y = 2.0d }; SymMat2 matrix = { xx = 1.0d, xy = 0.0d, yy = 1.0d };
	Lab color = { l = 3.0d, a = 0.0d, b = 0.0d }; var transformed = transform(color);
	int i = 0; var count = state.count;
	while (i < count) { state.scratch[i] = state.weights[i] * quadratic(point, matrix); i = i + 1; }
	if (state.scratch[count - 1] != 20.0d || color.l != 3.0d || transformed.l != 6.0d) { return 1; }
	return 0;
}
