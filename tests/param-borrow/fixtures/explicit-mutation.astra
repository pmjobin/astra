class C { int value; init(int n) { this.value = n; } deinit() { mark(this.value); } }
int aliases(borrowed C a, borrowed C b) { if (a != b) { return 0; } a.value = 1; b.value = 42; return a.value; }
int mutate(borrowed R a, borrowed R b) { if (a != b) { return 0; } touch(a); return value(b); }
int main() {
	var object = C.init(0); var handle = resource(1);
	if (aliases(object, object) != 42 || object.value != 42 || mutate(handle, handle) != 2 || value(handle) != 2) { return 1; }
	return 0;
}
