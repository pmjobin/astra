class C { int value;

	init(int n) { this.value = n; }

	deinit() { mark(this.value); } }

void inspect(borrowed R handle, borrowed C object, borrowed f64[] values) { mark(id(handle) + object.value + len(values)); }

void consume(owned R handle, owned C object, owned f64[] values) {}

int main() {
	var handle = resource(1); var object = C.init(2); var values = new f64[3]; inspect(handle, object, values);
	handle = resource(2); values = new f64[1]; inspect(handle, object, values);
	release handle; handle = resource(3); consume(move handle, move object, move values);
	return 0;
}
