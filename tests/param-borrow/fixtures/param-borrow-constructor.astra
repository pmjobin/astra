class C { int value; init(int n) { this.value = n; } }
class View { int value; init(C source, R handle, f64[] values) { source.value = source.value + id(handle); values[0] = 2.0; this.value = source.value; } }
int main() {
	var handle = resource(1); var source = C.init(7); var values = new f64[1];
	var view = View.init(source, handle, values);
	if (view.value != 8 || source.value != 8 || values[0] != 2.0 || id(handle) != 1) { return 1; }
	return 0;
}
