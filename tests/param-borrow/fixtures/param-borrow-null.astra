class C { int value; }
bool resource_null(R value) { return value == null; }
bool object_null(C value) { return value == null; }
bool empty(f64[] value) { return len(value) == 0; }
int main() { var values = new f64[0]; if (!resource_null(null) || !object_null(null) || !empty(values)) { return 1; } return 0; }
