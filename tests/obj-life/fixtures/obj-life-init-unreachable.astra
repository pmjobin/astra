class Counter {
	int value;
	init(bool choose) {
		if (false) { int unused = this.value; }
		bool short_circuit = false && this.value == 0;
		bool other_short_circuit = true || this.value == 0;
		if (choose) { while (true) {} }
		this.value = 42;
	}
}
int main() {
	Counter c = Counter.init(false);
	return c.value;
}
