extern(C) int life_record(int code, int value);

class Counter {
	int value;

	init(int value) { this.value = value; }

	deinit() { life_record(this.value, 0); }

	void set(int value) { this.value = value; }
}

void scenario() {
	owned Resource r1 = create_resource(65);
	Counter c1 = Counter.init(66);
	owned Resource r3 = create_resource(67);
	Counter c2 = Counter.init(68);
	{
		Counter c3 = Counter.init(69);
		Counter c4 = Counter.init(70);
	}
}

int main() {
	scenario();
	if (resource_live() != 0) return 1;
	return 42;
}
