extern(C) int life_record(int code, int value);
class Consumer {
	int value;
	init(owned Resource first, int later) { this.value = later; life_record(73, 0); }
	deinit() { life_record(68, 0); }
}
int zero() { return 0; }
int main() {
	owned Resource r = create_resource(82);
	Consumer c = Consumer.init(move r, life_record(65, 42) / zero());
	return c.value;
}
