# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

project('astra', ['vala', 'c'], version: '0.0.3', meson_version: '>=1.11.0', license: 'Apache-2.0 WITH LLVM-exception', default_options: ['c_std=c11', 'warning_level=2'])

# Formatting remains an explicit developer action. The ordinary test registry
# includes its read-only checks; build/install/distribution never apply edits.
format_python = find_program('python3')
format_driver = files('tools/format/source.py')
run_target('format-check', command: [format_python, format_driver, '--check'])
run_target('format-apply', command: [format_python, format_driver, '--apply'])
test('source-format-guards', format_python, args: [files('tools/format/test_format.py')], timeout: 60)
test('source-format-check', format_python, args: [format_driver, '--check'], timeout: 600, is_parallel: false)

host_dependencies = [dependency('glib-2.0'), dependency('gobject-2.0')]
fs = import('fs')

config = configuration_data()
config.set_quoted('ASTRA_VERSION', meson.project_version())
current_milestone = 'ASTRA-OPTIMIZER-HARDENING-RC2-18'
config.set_quoted('ASTRA_MILESTONE', current_milestone)
configure_file(output: 'astra-config.h', configuration: config)

text_sources = files('bootstrap/source/text-bytes.vala', 'bootstrap/source/text-origins.vala', 'bootstrap/source/code-origins.vala')
runtime_lifetime_sources = files('bootstrap/source/runtime-lifetimes.vala', 'bootstrap/source/runtime-lifetime-contracts.vala')
enum_identity_sources = files('bootstrap/source/enum-identity.vala')
enum_identity_sources += runtime_lifetime_sources
enum_identity_sources += files('bootstrap/source/task-identity.vala')
enum_identity_sources += files('bootstrap/source/generic-class-identity.vala')
enum_identity_sources += files('bootstrap/source/generic-class-structure.vala')
enum_identity_sources += files('bootstrap/source/generic-capability-rules.vala')
enum_identity_sources += files('bootstrap/source/optimizer-contracts.vala')
enum_identity_sources += files('bootstrap/source/allocation-policy.vala', 'bootstrap/source/pod-representation.vala', 'bootstrap/source/concurrency-policy.vala')
enum_identity_sources += files('bootstrap/source/declaration-policy.vala')
foreign_schema_sources = files('bootstrap/source/foreign-class-policy.vala', 'bootstrap/source/foreign-schema.vala')
enum_identity_sources += foreign_schema_sources
source_sources = text_sources + enum_identity_sources + files('bootstrap/source/source-file.vala', 'bootstrap/source/source-span.vala', 'bootstrap/source/diagnostic.vala')
frontend_sources = source_sources + files('bootstrap/syntax/text-syntax.vala', 'bootstrap/syntax/c-code-syntax.vala', 'bootstrap/syntax/caller-information-syntax.vala', 'bootstrap/source/source-set.vala', 'bootstrap/syntax/syntax-program.vala', 'bootstrap/syntax/constant-syntax.vala', 'bootstrap/syntax/token.vala', 'bootstrap/syntax/lexer.vala', 'bootstrap/syntax/nodes.vala', 'bootstrap/syntax/exception-syntax.vala', 'bootstrap/syntax/enum-syntax.vala', 'bootstrap/syntax/property-syntax.vala', 'bootstrap/syntax/array-syntax.vala', 'bootstrap/syntax/slice-syntax.vala', 'bootstrap/syntax/buffer-syntax.vala', 'bootstrap/syntax/parser.vala', 'bootstrap/syntax/syntax-dump.vala')
