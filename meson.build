nabi_model_sources += files('bootstrap/nabi/native-async-frames.vala')
nabi_model_sources += files('bootstrap/nabi/native-generic-structure.vala')
nabi_model_sources += files('bootstrap/nabi/native-foreign-api.vala')
# Canonical callback input contracts are neutral objects, with no upstream IR.
nabi_model_sources += files('bootstrap/source/code-origins.vala')
nabi_provenance_sources = files('bootstrap/source/source-file.vala', 'bootstrap/source/source-span.vala', 'bootstrap/source/diagnostic.vala')
nabi_sources = nabi_model_sources + files('bootstrap/nabi/native-continuation-builder.vala', 'bootstrap/nabi/native-entry-builder.vala', 'bootstrap/nabi/native-type-mapper.vala', 'bootstrap/nabi/native-builder.vala', 'bootstrap/nabi/native-validator.vala', 'bootstrap/nabi/native-sum-validator.vala')
