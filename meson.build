nabi_dependency = declare_dependency(sources: nabi_sources, dependencies: ssa_dependency)

cabi_model_sources = parameter_contract_sources + foreign_metadata_sources + files('bootstrap/cabi/cabi-model.vala', 'bootstrap/cabi/cabi-verifier.vala', 'bootstrap/cabi/cabi-dump.vala')
# Detached physical CABI includes its neutral native callback-view descriptors.
cabi_model_sources += nabi_model_sources + files('bootstrap/cabi/cabi-class-adapter.vala')
cabi_model_sources += files('bootstrap/source/pod-representation.vala', 'bootstrap/source/allocation-policy.vala')
