cfg_dependency = declare_dependency(sources: cfg_sources, dependencies: core_dependency)

ssa_model_sources = files('bootstrap/ssa/ssa-text.vala', 'bootstrap/ssa/ssa-exceptions.vala') + files('bootstrap/ssa/ssa-nodes.vala', 'bootstrap/ssa/ssa-buffers.vala', 'bootstrap/ssa/ssa-buffer-flow.vala', 'bootstrap/ssa/ssa-methods.vala', 'bootstrap/ssa/ssa-properties.vala', 'bootstrap/ssa/ssa-objects.vala', 'bootstrap/ssa/ssa-object-results.vala', 'bootstrap/ssa/ssa-lifecycle.vala', 'bootstrap/ssa/ssa-constructor-initialization.vala', 'bootstrap/ssa/ssa-lifecycle-flow.vala', 'bootstrap/ssa/ssa-array-places.vala', 'bootstrap/ssa/ssa-slices.vala', 'bootstrap/ssa/ssa-handles.vala', 'bootstrap/ssa/ssa-memory.vala', 'bootstrap/ssa/ssa-struct-values.vala', 'bootstrap/ssa/ssa-enums.vala', 'bootstrap/ssa/ssa-enum-verifier.vala', 'bootstrap/ssa/ssa-verifier.vala', 'bootstrap/ssa/ssa-dump.vala')
continuation_contract_sources = files('bootstrap/ssa/continuation-contract.vala')
ir_authority_sources += continuation_contract_sources + files('bootstrap/semantic/enum-value-contract.vala', 'bootstrap/semantic/enum-initialization.vala')
ssa_model_sources += continuation_contract_sources + files('bootstrap/ssa/ssa-continuations.vala')
ssa_model_sources += files('bootstrap/ssa/ssa-async.vala', 'bootstrap/ssa/ssa-shared.vala', 'bootstrap/ssa/ssa-closures.vala', 'bootstrap/ssa/ssa-retained.vala')
ssa_analysis_sources = files('bootstrap/ssa/dominance.vala')
ssa_model_sources += files('bootstrap/ssa/ssa-nonnull.vala')
ssa_model_sources += files('bootstrap/ssa/ssa-runtime-lifetimes.vala')
ssa_model_sources += files('bootstrap/ssa/ssa-foreign-api.vala')
ssa_sources = ssa_model_sources + ssa_analysis_sources + files('bootstrap/ssa/ssa-builder.vala')
ssa_model_sources += files('bootstrap/ssa/ssa-effects.vala', 'bootstrap/ssa/ssa-code-origins.vala')
ssa_sources += files('bootstrap/ssa/ssa-effects.vala', 'bootstrap/ssa/ssa-code-origins.vala')
ssa_model_sources += files('bootstrap/ssa/ssa-formal-effect-verifier.vala')
ssa_sources += files('bootstrap/ssa/ssa-formal-effect-verifier.vala')
ssa_model_sources += files('bootstrap/ssa/ssa-stack-objects.vala', 'bootstrap/ssa/ssa-stack-object-verifier.vala')
