cabi_dependency = declare_dependency(sources: cabi_sources, dependencies: nabi_dependency)

# Match the selected host GLib's type-initialization API. Vala still checks
# unused source locals; GCC's unused diagnostics here concern generated C.
glib_version = host_dependencies[0].version().split('.')
frontend_vala_args = ['--target-glib=@0@.@1@'.format(glib_version[0], glib_version[1])]
frontend_c_args = ['-DVALA_STRICT_C', '-Wno-unused-parameter', '-Wno-unused-variable', '-Wno-unused-but-set-variable']

stage0_overrides = []
if get_option('stage0_optimization') != 'inherit'
	stage0_overrides = ['optimization=' + get_option('stage0_optimization')]
endif
numeric_oracle_overrides = []
if get_option('numeric_oracle_optimization') != 'inherit'
	numeric_oracle_overrides = ['optimization=' + get_option('numeric_oracle_optimization')]
endif

subdir('bootstrap/backend/llvm')
subdir('bootstrap/driver')
# Production diagnostics are fatal independently of detached helper settings.
# Source-isolated test models intentionally omit consumers of internal methods;
# their ordinary project-level warning policy remains separately configurable.
astrac = executable('astrac', ['bootstrap/main.vala', 'bootstrap/config.vapi'], include_directories: include_directories('.'), dependencies: [execution_dependency, vapi_dependency], vala_args: frontend_vala_args, c_args: frontend_c_args, override_options: stage0_overrides + ['werror=true'], install: true)
