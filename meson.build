semantic_type_sources += files('bootstrap/semantic/owned-child-composition.vala')
semantic_type_sources += source_sources + parameter_contract_sources + files('bootstrap/semantic/async-contract.vala')
semantic_type_sources += files('bootstrap/semantic/generic-class-types.vala', 'bootstrap/semantic/shared-types.vala', 'bootstrap/semantic/closure-types.vala', 'bootstrap/semantic/retained-contract.vala')
semantic_type_sources += files('bootstrap/semantic/owning-record-contracts.vala')
semantic_type_sources += files('bootstrap/semantic/c-plain-records.vala')
semantic_type_sources += files('bootstrap/semantic/volatile-access.vala', 'bootstrap/semantic/floating-policy.vala', 'bootstrap/semantic/vector-memory.vala')
generic_ownership_flow_sources = files('bootstrap/semantic/generic-ownership-flow.vala')
floating_authority_sources = files('bootstrap/semantic/binary-float-format.vala', 'bootstrap/semantic/binary-float-value.vala')
f32_authority_sources = floating_authority_sources + files('bootstrap/semantic/f32-value.vala')
scalar_value_sources = files('bootstrap/semantic/int-value.vala', 'bootstrap/semantic/integer-value.vala') + f32_authority_sources
vector_primitive_sources = files('bootstrap/semantic/vector-primitives.vala', 'bootstrap/semantic/vector-dsp.vala', 'bootstrap/semantic/vector-dot.vala')
integer_conversion_sources = files('bootstrap/semantic/integer-conversion.vala')
floating_conversion_sources = files('bootstrap/semantic/floating-conversion.vala', 'bootstrap/semantic/numeric-conversion.vala')
semantic_sources = files('bootstrap/semantic/semantic-text.vala', 'bootstrap/semantic/semantic-exceptions.vala', 'bootstrap/semantic/caller-information.vala') + generic_ownership_flow_sources + floating_conversion_sources + integer_conversion_sources + vector_primitive_sources + parameter_contract_sources + foreign_metadata_sources + files('bootstrap/semantic/foreign-abi.vala', 'bootstrap/semantic/foreign-declaration-input.vala', 'bootstrap/semantic/operators.vala', 'bootstrap/semantic/symbols.vala', 'bootstrap/semantic/semantic-generics.vala', 'bootstrap/semantic/semantic-methods.vala', 'bootstrap/semantic/semantic-properties.vala', 'bootstrap/semantic/semantic-objects.vala', 'bootstrap/semantic/semantic-object-results.vala', 'bootstrap/semantic/semantic-lifecycle.vala', 'bootstrap/semantic/lexical-region.vala', 'bootstrap/semantic/checked-nodes.vala', 'bootstrap/semantic/semantic-array-places.vala', 'bootstrap/semantic/semantic-slices.vala', 'bootstrap/semantic/semantic-buffers.vala', 'bootstrap/semantic/constant-value.vala', 'bootstrap/semantic/constant-float.vala', 'bootstrap/semantic/constant-evaluator.vala', 'bootstrap/semantic/analyzer.vala', 'bootstrap/semantic/semantic-dump.vala') + semantic_type_sources + scalar_value_sources
semantic_sources += files('bootstrap/semantic/enum-value-contract.vala', 'bootstrap/semantic/enum-initialization.vala')
semantic_sources += files('bootstrap/semantic/semantic-async.vala')
semantic_sources += files('bootstrap/semantic/readonly-inspection.vala', 'bootstrap/semantic/readonly-code-origins.vala', 'bootstrap/semantic/semantic-nonnull.vala')
semantic_sources += files('bootstrap/semantic/semantic-runtime-lifetimes.vala')
semantic_sources += files('bootstrap/semantic/tooling-index.vala')
semantic_sources += files('bootstrap/semantic/native-declaration-registry.vala')
semantic_sources += files('bootstrap/semantic/owned-resource-fields.vala', 'bootstrap/semantic/semantic-generic-structs.vala', 'bootstrap/semantic/semantic-struct-values.vala')
semantic_sources += files('bootstrap/semantic/foreign-api-admission.vala')
semantic_sources += files('bootstrap/semantic/generic-call-inference.vala', 'bootstrap/semantic/semantic-enums.vala')
semantic_sources += files('bootstrap/semantic/semantic-generic-classes.vala', 'bootstrap/semantic/semantic-shared.vala', 'bootstrap/semantic/semantic-closures.vala', 'bootstrap/semantic/semantic-retained.vala')
semantic_dependency = declare_dependency(sources: semantic_sources, dependencies: frontend_dependency)

vapi_frontend_sources = files('bootstrap/vapi/vapi-token.vala', 'bootstrap/vapi/vapi-lexer.vala', 'bootstrap/vapi/vapi-syntax.vala', 'bootstrap/vapi/vapi-parser.vala')
vapi_frontend_dependency = declare_dependency(sources: source_sources + vapi_frontend_sources, dependencies: host_dependencies)
vapi_dependency = declare_dependency(sources: files('bootstrap/vapi/vapi-normalizer.vala'), dependencies: [vapi_frontend_dependency, semantic_dependency])

core_model_sources = files('bootstrap/core/core-text.vala', 'bootstrap/core/core-exceptions.vala') + generic_ownership_flow_sources + files('bootstrap/core/core-nodes.vala', 'bootstrap/core/core-generics.vala', 'bootstrap/core/generic-monomorphizer.vala', 'bootstrap/core/core-methods.vala', 'bootstrap/core/core-properties.vala', 'bootstrap/core/core-objects.vala', 'bootstrap/core/core-object-results.vala', 'bootstrap/core/core-lifecycle.vala', 'bootstrap/core/core-array-places.vala', 'bootstrap/core/core-slices.vala', 'bootstrap/core/core-buffers.vala', 'bootstrap/core/core-handles.vala', 'bootstrap/core/core-structs.vala', 'bootstrap/core/core-struct-copy.vala', 'bootstrap/core/core-struct-values.vala', 'bootstrap/core/core-enums.vala', 'bootstrap/core/verifier.vala', 'bootstrap/core/core-dump.vala')
ir_authority_sources = text_sources + enum_identity_sources + floating_conversion_sources + integer_conversion_sources + vector_primitive_sources + parameter_contract_sources + foreign_metadata_sources + files('bootstrap/source/source-file.vala', 'bootstrap/source/source-span.vala', 'bootstrap/source/diagnostic.vala', 'bootstrap/semantic/foreign-abi.vala', 'bootstrap/semantic/operators.vala') + semantic_type_sources + scalar_value_sources
core_model_sources += files('bootstrap/core/core-owned-fields.vala', 'bootstrap/core/core-generic-structs.vala')
core_model_sources += files('bootstrap/core/core-code-origins.vala')
core_model_sources += files('bootstrap/core/core-runtime-lifetimes.vala')
core_model_sources += files('bootstrap/core/core-generic-classes.vala', 'bootstrap/core/core-nonnull.vala')
core_model_sources += files('bootstrap/core/core-async.vala', 'bootstrap/core/core-shared.vala', 'bootstrap/core/core-closures.vala', 'bootstrap/core/core-retained.vala')
core_model_sources += files('bootstrap/core/core-foreign-api.vala')
core_sources = core_model_sources + files('bootstrap/core/builder.vala')
core_dependency = declare_dependency(sources: core_sources, dependencies: semantic_dependency)

cfg_model_sources = files('bootstrap/cfg/cfg-text.vala', 'bootstrap/cfg/cfg-exceptions.vala') + files('bootstrap/cfg/cfg-nodes.vala', 'bootstrap/cfg/cfg-methods.vala', 'bootstrap/cfg/cfg-properties.vala', 'bootstrap/cfg/cfg-objects.vala', 'bootstrap/cfg/cfg-object-results.vala', 'bootstrap/cfg/cfg-lifecycle.vala', 'bootstrap/cfg/cfg-constructor-initialization.vala', 'bootstrap/cfg/cfg-lifecycle-flow.vala', 'bootstrap/cfg/cfg-array-places.vala', 'bootstrap/cfg/cfg-slices.vala', 'bootstrap/cfg/cfg-buffers.vala', 'bootstrap/cfg/cfg-handles.vala', 'bootstrap/cfg/cfg-structs.vala', 'bootstrap/cfg/cfg-struct-values.vala', 'bootstrap/cfg/cfg-enums.vala', 'bootstrap/cfg/cfg-enum-verifier.vala', 'bootstrap/cfg/cfg-verifier.vala', 'bootstrap/cfg/reachability.vala', 'bootstrap/cfg/predecessors.vala', 'bootstrap/cfg/ownership-flow.vala', 'bootstrap/cfg/flow-checker.vala', 'bootstrap/cfg/cfg-dump.vala')
