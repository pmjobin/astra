frontend_sources += files('bootstrap/syntax/source-formatter.vala')
frontend_dependency = declare_dependency(sources: frontend_sources, dependencies: host_dependencies)

parameter_contract_sources = files('bootstrap/semantic/pointer-parameter-contract.vala', 'bootstrap/semantic/nonnull-facts.vala')
foreign_metadata_sources = files('bootstrap/foreign/c-foreign-metadata.vala')
foreign_metadata_sources += files('bootstrap/source/declaration-policy.vala')
field_initialization_sources = files('bootstrap/semantic/field-initialization.vala')
semantic_type_sources = field_initialization_sources + enum_identity_sources + files('bootstrap/semantic/enum-type.vala') + files('bootstrap/semantic/ownership-state.vala', 'bootstrap/semantic/object-result-provenance.vala', 'bootstrap/semantic/types.vala', 'bootstrap/semantic/copyability.vala', 'bootstrap/semantic/buffer-elements.vala', 'bootstrap/semantic/struct-value-contract.vala', 'bootstrap/semantic/generic-capabilities.vala', 'bootstrap/semantic/data-pointer-provenance.vala')
