nabi_model_sources = enum_identity_sources + files('bootstrap/nabi/native-text.vala', 'bootstrap/nabi/native-text-slice.vala', 'bootstrap/nabi/native-record-elements.vala', 'bootstrap/nabi/native-entry.vala') + files('bootstrap/nabi/native-model.vala', 'bootstrap/nabi/native-classes.vala', 'bootstrap/nabi/native-sum-values.vala', 'bootstrap/nabi/native-buffer-values.vala', 'bootstrap/nabi/native-struct-values.vala', 'bootstrap/nabi/native-verifier.vala', 'bootstrap/nabi/native-dump.vala')
