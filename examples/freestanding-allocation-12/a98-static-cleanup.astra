using Pc;
class BootLocal {
	int letter;

	init(int letter) { this.letter = letter; write_byte(letter); }

	deinit() { write_byte(this.letter + 32); }
}

int stack_checksum() {
	int[8] samples = {1, 2, 3, 4, 5, 6, 7, 14};
	int sum = 0;
	for (int i = 0; i < len(samples); i = i + 1) sum = sum + samples[i];
	{
		BootLocal first = BootLocal.init(65);
		BootLocal second = BootLocal.init(66);
		if (first.letter + second.letter != 131) return -1;
	}
	return sum;
}

export(C) int astra_entry(int index, int initialized, int zeroed) {
	if (index != 0) return 0;
	if (initialized != 324508639 || zeroed != 0) return 33;
	int sum = stack_checksum();
	write_byte(58);
	write_byte(48 + sum / 10);
	write_byte(48 + sum % 10);
	write_byte(10);
	return 0;
}
