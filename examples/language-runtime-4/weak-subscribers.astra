extern(C) int shared_app_event(int stage, int value);

class Subject {
	int sequence;

	init(int sequence) { this.sequence=sequence; shared_app_event(1,sequence); }

	deinit() { shared_app_event(2,this.sequence); }
}

int sequence(borrowed Subject subject) { return subject.sequence; }

int notify(borrowed Weak<Subject> subscription, int offset) {
	var live=weak_upgrade(subscription);
	if (live == null) return -1;
	return sequence(shared_borrow(live)) + offset;
}

int main() {
	var subject=new Subject(42);
	var owner=shared_acquire(move subject);
	var first=shared_downgrade(owner);
	var second=weak_clone(first);
	shared_app_event(3,notify(first,1));
	shared_app_event(4,notify(second,2));
	release owner;
	shared_app_event(5,notify(first,1));
	shared_app_event(6,notify(second,2));
	release second;
	release first;
	return 0;
}
