int main() {
	var samples = make_samples(4);
	Vec2 point = { x = 3.0d, y = 4.0d };
	var result = measure(samples, point);
	assert_code(len(samples.values) == 4, 301);
	assert_equal_f64(result.l, 5.0d, 302);
	assert_equal_f64(result.a, 0.75d, 303);
	assert_equal_f64(result.b, 0.75d, 304);
	return 0;
}
