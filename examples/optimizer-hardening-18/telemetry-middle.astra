namespace TelemetryMiddle18;
using TelemetryLeaf18;

f64 selected_gain(WindowMetadata metadata, bool primary) {
	if (primary) { return metadata_gain(metadata); }
	return metadata.scale;
}
f64 balanced_scalar(f64 value) { return value * 0.5 + 0.25; }
