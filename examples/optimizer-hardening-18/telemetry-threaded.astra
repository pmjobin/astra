int main() {
	telemetry18_prepare();
	var context = concurrent_allocator(1, 262144, 32, 64);
	var frames = concurrent_allocator(2, 262144, 32, 64);
	if (context == null || frames == null) { return 1; }
	try {
		var executor = ThreadedExecutor.open(telemetry18_workers());
		var status = executor.run(telemetry18_execute(move context, move frames, telemetry18_granularity()));
		match (status) { case ThreadedStatus.Completed(): {} else: { return 2; } }
	} catch (Error error) { return 3; }
	return telemetry18_finish();
}
