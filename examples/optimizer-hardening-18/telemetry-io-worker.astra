extern(C) void telemetry18_io_worker(int sequence);

[Allocator(kind="context",context="owned-concurrent")]
class TelemetryIoJob18 {
	owned ContextBytes<ConcurrentAllocator> bytes;
	int start;
	int count;
	int sequence;

	init(owned ContextBytes<ConcurrentAllocator> bytes, int start, int count, int sequence) {
		this.bytes = move bytes; this.start = start; this.count = count; this.sequence = sequence;
	}

	int run() {
		telemetry18_io_worker(this.sequence);
		owned f64[] input = new f64[this.count];
		owned f64[] output = new f64[this.count];
		for (int index = 0; index < this.count; index = index + 1) {
			int sample = (this.bytes[index * 2] as int) + (this.bytes[index * 2 + 1] as int) * 256;
			if (sample >= 32768) sample = sample - 65536;
			input[index] = (sample as f64) / 32768.0;
		}
		var reports = new Vector<WindowSummary18>(1);
		if (!telemetry18_transform(reports, input, output, this.start, this.count, this.sequence)) return 1;
		return telemetry18_drain(reports);
	}
}
