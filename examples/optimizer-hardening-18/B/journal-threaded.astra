// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
async int journal18_calculate(owned JournalJob18 job) throws Error { return job.run(); }
async void journal18_execute(owned ConcurrentAllocator context, owned ConcurrentAllocator frames) throws Error {
	var job0 = journal18_job(context, 0);
	var job1 = journal18_job(context, 1);
	var job2 = journal18_job(context, 2);
	var job3 = journal18_job(context, 3);
	var first = checked_task_in(frames, journal18_calculate(move job0));
	var second = checked_task_in(frames, journal18_calculate(move job1));
	var third = checked_task_in(frames, journal18_calculate(move job2));
	var fourth = checked_task_in(frames, journal18_calculate(move job3));
	try { start(first); start(second); start(third); start(fourth); }
	catch (Error error) {
		cancel(first); cancel(second); cancel(third); cancel(fourth);
		await cancel_and_join(move first); await cancel_and_join(move second);
		await cancel_and_join(move third); await cancel_and_join(move fourth); throw;
	}
	int total = 0;
	try { total = await move first; }
	catch (Error error) { await cancel_and_join(move second); await cancel_and_join(move third); await cancel_and_join(move fourth); throw; }
	try { total = total + await move second; }
	catch (Error error) { await cancel_and_join(move third); await cancel_and_join(move fourth); throw; }
	try { total = total + await move third; }
	catch (Error error) { await cancel_and_join(move fourth); throw; }
	total = total + await move fourth;
	if (journal18_context_done(context, 1) != 0 || journal18_context_done(frames, 2) != 0 || journal18_finish(total) != 0) { throw new Error("journal retirement/output"); }
}
int main(string[] args) {
	if (len(args) != 3) { return 64; }
	if (journal18_prepare(args[1], args[2]) != 0) { return 65; }
	var context = concurrent_allocator(1, 2097152, 64, 64);
	var frames = concurrent_allocator(2, 262144, 32, 64);
	if (context == null || frames == null) { journal18_abort(); return 2; }
	try {
		var executor = ThreadedExecutor.open(journal18_workers());
		var status = executor.run(journal18_execute(move context, move frames));
		match (status) { case ThreadedStatus.Completed(): {} else: { journal18_abort(); return 4; } }
	} catch (Error error) { journal18_abort(); return 3; }
	return 0;
}
