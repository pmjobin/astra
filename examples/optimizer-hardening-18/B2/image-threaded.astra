async int image2_calculate(owned ImageJob18 job) throws Error { return job.run(); }
async void image2_execute(owned ConcurrentAllocator context, owned ConcurrentAllocator frames) throws Error {
	var job0 = image2_job(context, 0); var job1 = image2_job(context, 1);
	var job2 = image2_job(context, 2); var job3 = image2_job(context, 3);
	var first = checked_task_in(frames, image2_calculate(move job0));
	var second = checked_task_in(frames, image2_calculate(move job1));
	var third = checked_task_in(frames, image2_calculate(move job2));
	var fourth = checked_task_in(frames, image2_calculate(move job3));
	try { start(first); start(second); start(third); start(fourth); }
	catch (Error error) {
		cancel(first); cancel(second); cancel(third); cancel(fourth);
		await cancel_and_join(move first); await cancel_and_join(move second);
		await cancel_and_join(move third); await cancel_and_join(move fourth); throw;
	}
	int foreground = 0;
	try { foreground = await move first; }
	catch (Error error) { await cancel_and_join(move second); await cancel_and_join(move third); await cancel_and_join(move fourth); throw; }
	try { foreground = foreground + await move second; }
	catch (Error error) { await cancel_and_join(move third); await cancel_and_join(move fourth); throw; }
	try { foreground = foreground + await move third; }
	catch (Error error) { await cancel_and_join(move fourth); throw; }
	foreground = foreground + await move fourth;
	int components = image2_merge();
	if (image2_context_done(context, 1) != 0 || image2_context_done(frames, 2) != 0 || image2_finish(components, foreground) != 0) {
		throw new Error("image retirement/output");
	}
}
int main(string[] args) {
	if (len(args) != 3) { return 64; }
	if (image2_prepare(args[1], args[2]) != 0) { return 65; }
	var context = concurrent_allocator(1, 2097152, 64, 64);
	var frames = concurrent_allocator(2, 262144, 32, 64);
	if (context == null || frames == null) { image2_abort(); return 2; }
	try {
		var executor = ThreadedExecutor.open(image2_workers());
		var status = executor.run(image2_execute(move context, move frames));
		match (status) { case ThreadedStatus.Completed(): {} else: { image2_abort(); return 4; } }
	} catch (Error error) { image2_abort(); return 3; }
	return 0;
}
