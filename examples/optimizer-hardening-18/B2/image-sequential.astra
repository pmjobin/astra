int main(string[] args) {
	if (len(args) != 3) return 64;
	if (image2_prepare(args[1], args[2]) != 0) return 65;
	var context = concurrent_allocator(1, 2097152, 64, 64);
	if (context == null) {
		image2_abort();
		return 2;
	}
	try {
		int foreground = 0;
		for (int lane = 0; lane < 4; lane = lane + 1) {
			var job = image2_job(context, lane);
			foreground = foreground + job.run();
		}
		int components = image2_merge();
		if (image2_context_done(context, 1) != 0 || image2_finish(components, foreground) != 0) {
			image2_abort();
			return 4;
		}
	} catch (Error error) { image2_abort(); return 3; }
	return 0;
}
