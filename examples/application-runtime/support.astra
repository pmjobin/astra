// Finite Bag indexed loans end with this synchronous nonthrowing call.
bool emit_message(Utf8Message message) { return println(message.text); }
bool render_message(Utf8Message message, Utf8ByteBuilder output) {
	return append_text(output, message.text) && append_text(output, "\n");
}
bool message_equals(Utf8Message message, string expected) { return message.text == expected; }
