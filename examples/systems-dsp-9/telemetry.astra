// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Reusable by both hosted and Linux no-libc entry paths.
int telemetry(int input) {
	f64 value = input as f64;
	f64<2> samples = {value, -value};
	f64<2> weights = {2.0, 0.5};
	f64<2> output = samples * weights;
	i64<2> counters = {40, 9223372036854775807};
	i64<2> increments = {2, 1};
	i64<2> result = sat_add(counters, increments);
	u32[1] status = {0};
	volatile_store(status[0], result[0] as u32);
	if (output[0] != 24.0 || output[1] != -6.0 || result[1] != counters[1]) return 72;
	if (volatile_load(status[0]) != 42) return 73;
	return 42;
}
