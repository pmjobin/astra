language astra27b;
namespace ConfigParsing;
using ConfigData;
class ConfigError : Error { init() : base("invalid config") {} }

// Every nonempty record is key=signed-i32; the sum is exact signed i64.
public owned Config parse(owned Utf8Message original) throws Error {
	int entries = 0; i64 total = 0;
	{
		int start = 0;
		while (start < original.text.byte_length) {
			int end = text_find(original.text, "\n", start); if (end < 0) end = original.text.byte_length;
			if (end > start) {
				int separator = text_find(original.text, "=", start);
				if (separator <= start || separator >= end) {
					throw new ConfigError();
				}
				var value_text = text_segment(original.text, separator + 1, end - separator - 1);
				int value = parse_int(value_text.text); total += value as i64; entries += 1;
			}
			if (end == original.text.byte_length) break; start = end + 1;
		}
	}
	var result = new Config(original: move original, entries: entries, total: total); return move result;
}
