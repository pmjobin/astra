using ReportMath;
class ReportScope {
	init() { println("report acquired"); }

	deinit() { println("report released"); }
}

int systems_report(string input, string destination) throws Error {
	var scope = new ReportScope();
	var bytes = read_file(input);
	u64 count = bytes.byte_count() as u64;
	u64 digest = checksum(bytes);
	var rows = new Bag<Utf8Message>();
	if (!rows.reserve(2)) return 70;
	var builder = new Utf8ByteBuilder();
	require_text(append_text(builder, "bytes=")); require_text(append_u64(builder, count));
	var count_row = builder.snapshot(); rows.append(move count_row);
	var digest_builder = new Utf8ByteBuilder();
	require_text(append_text(digest_builder, "fnv64=")); require_text(append_u64(digest_builder, digest));
	var digest_row = digest_builder.snapshot(); rows.append(move digest_row);
	var output = new Utf8ByteBuilder();
	int i = 0;
	while (i < rows.count()) {
		require_text(render_message(rows.entries[i], output));
		i = i + 1;
	}
	var report = output.snapshot(); write_text_file(destination, report.text);
	return 0;
}

int main(string[] args) {
	if (len(args) != 3) return 64;
	try { return systems_report(args[1], args[2]); }
	catch (FileError error) { println_stderr("file I/O"); return 2; }
	catch (Error error) { return 3; }
}
