language astra27b;
using ReportMath;
class ReportScope {
	readonly int identity;

	init() { this.identity = 0; println("report acquired"); }

	deinit() { println("report released"); }
}

bool systems_render_message(borrowed Utf8Message message, borrowed Utf8ByteBuilder output) {
	return append_text(output, message.text) && append_text(output, "\n");
}

int systems_report(string input, string destination) throws Error {
	var scope = new ReportScope();
	var bytes = read_file(input);
	u64 count = bytes.byte_count() as u64;
	u64 digest = checksum(bytes);
	var rows = new Bag<Utf8Message>();
	if (!rows.reserve(2)) return 70;
	var builder = new Utf8ByteBuilder();
	require_text(format_into(builder, $"bytes={count}"));
	var count_row = builder.snapshot(); rows.append(move count_row);
	var digest_builder = new Utf8ByteBuilder();
	require_text(format_into(digest_builder, $"fnv64={digest}"));
	var digest_row = digest_builder.snapshot(); rows.append(move digest_row);
	var output = new Utf8ByteBuilder();
	foreach (var i in 0..rows.count()) {
		require_text(systems_render_message(rows.entries[i], output));
	}
	var report = output.snapshot(); write_text_file(destination, report.text);
	return 0;
}

int main() {
	if (!systems_arguments_valid()) return 2;
	if (astrac_argument_count() != 3) return 64;
	try {
		var input = systems_argument(1); var destination = systems_argument(2);
		return systems_report(input.text, destination.text);
	}
	catch (FileError error) { println_stderr("file I/O"); return 2; }
	catch (Error error) { return 3; }
}
