using ConfigParsing;
int main() {
	if (!systems_arguments_valid()) return 2;
	if (astrac_argument_count() != 3) return 64;
	try {
		var input = systems_argument(1); var destination = systems_argument(2);
		var bytes = read_file(input.text); var original = bytes.decode();
		var config = parse(move original); var report = ConfigRendering.render(config);
		write_text_file(destination.text, report.text); return 0;
	} catch (FileError error) { return 2; }
	catch (Error error) { return 3; }
}
