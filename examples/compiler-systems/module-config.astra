using ConfigParsing;
int main(string[] args) {
	if (len(args) != 3) { return 64; }
	try {
		var bytes = read_file(args[1]); var original = bytes.decode();
		var config = parse(move original); var report = ConfigRendering.render(config);
		write_text_file(args[2], report.text); return 0;
	} catch (FileError error) { return 2; }
	catch (Error error) { return 3; }
}
