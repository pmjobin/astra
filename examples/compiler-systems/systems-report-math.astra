namespace ReportMath;
public u64 checksum(FileBytes bytes) throws FileError {
	u64 hash = 14695981039346656037;
	int i = 0;
	while (i < bytes.byte_count()) {
		hash = (hash ^ (bytes.byte_at(i) as u64)) * 1099511628211;
		i = i + 1;
	}
	return hash;
}

internal u64 private_seed() { return 14695981039346656037; }
