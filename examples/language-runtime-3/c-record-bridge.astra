int main(string[] args) {
	if (len(args) != 3) { return 64; }
	try {
		int price = parse_int(args[1]); int count = parse_int(args[2]);
		i64 total = surge_shipment_total(price, count);
		if (total < 0) { return 64; }
		report_number("shipment=", total); return 0;
	} catch (Error error) { return 2; }
}
