namespace Analyzer8;
int classify(int byte) {
	int category = 0;
	int* address = &category;
	if ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)) category = 1;
	if (byte >= 48 && byte <= 57) category = 2;
	if (byte == 9) category = 3;
	if (byte == 10) category = 4;
	return *address;
}
