using Analyzer8;
int main(string[] args) {
	if (len(args) != 2) return 64;
	try {
		var source = read_file(args[1]);
		int letters = 0;
		int digits = 0;
		int tabs = 0;
		int lines = 0;
		int offset = 0;
		while (offset < source.byte_count()) {
			int category = classify(source.byte_at(offset));
			if (category == 1) letters = letters + 1;
			if (category == 2) digits = digits + 1;
			if (category == 3) tabs = tabs + 1;
			if (category == 4) lines = lines + 1;
			offset = offset + 1;
		}
		var report = new Utf8ByteBuilder();
		report_value(report, "letters=", letters);
		report_value(report, "digits=", digits);
		report_value(report, "tabs=", tabs);
		report_value(report, "lines=", lines);
		var text = report.snapshot();
		write_text_file("analysis.txt", text.text);
		print(text.text);
		return 0;
	} catch (Error error) { println_stderr(error.message); return 70; }
}
