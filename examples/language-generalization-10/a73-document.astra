// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
int document_label_bytes(Utf8Message value) { return value.text.byte_length; }
class DocumentNote {
	owned Utf8Message label;
	int code;
	init(string label, int code) {
		var snapshot = new Utf8Message(label);
		this.label = move snapshot;
		this.code = code;
	}
	int fingerprint() { return this.code * 17 + document_label_bytes(this.label); }
	deinit() { event(1000 + this.code); }
}
struct DocumentLeaf { owned Lease lease; owned DocumentNote note; owned int[] samples; int kind; }
struct DocumentBranch { DocumentLeaf leaf; owned OtherLease marker; int weight; }
struct OwnedDocument { DocumentBranch selected; DocumentBranch discarded; int version; }
int document_stage(int value, bool fail) throws Error {
	if (fail) { throw new Error("document stage"); }
	return value;
}
owned Lease document_lease(int code, bool fail) throws Error {
	int checked = document_stage(code, fail);
	var value = open_lease(checked);
	return move value;
}
owned OtherLease document_marker(int code, bool fail) throws Error {
	int checked = document_stage(code, fail);
	var value = open_other(checked);
	return move value;
}
owned DocumentNote document_note(string label, int code, bool fail) throws Error {
	int checked = document_stage(code, fail);
	var value = new DocumentNote(label, checked);
	return move value;
}
owned int[] document_samples(int code, bool fail) throws Error {
	int checked = document_stage(code, fail);
	var values = new int[3];
	int index = 0;
	while (index < 3) { values[index] = checked + index; index = index + 1; }
	return move values;
}
OwnedDocument create_document(int left, string left_label, int right, string right_label, int fail) throws Error {
	OwnedDocument value = {
		selected = {
			leaf = {
				lease = document_lease(left, fail == 0),
				note = document_note(left_label, left, fail == 1),
				samples = document_samples(left, fail == 2),
				kind = document_stage(left + 1, fail == 3)
			},
			marker = document_marker(left + 100, fail == 4),
			weight = document_stage(left + 2, fail == 5)
		},
		discarded = {
			leaf = {
				lease = document_lease(right, fail == 6),
				note = document_note(right_label, right, fail == 7),
				samples = document_samples(right, fail == 8),
				kind = document_stage(right + 1, fail == 9)
			},
			marker = document_marker(right + 100, fail == 10),
			weight = document_stage(right + 2, fail == 11)
		},
		version = document_stage(left * 3 + right * 5, fail == 12)
	};
	document_stage(0, fail == 13);
	return move value;
}
DocumentLeaf select_subtree(OwnedDocument document) {
	var lease = move document.selected.leaf.lease;
	var note = move document.selected.leaf.note;
	var samples = move document.selected.leaf.samples;
	DocumentLeaf result = {lease = move lease, note = move note, samples = move samples, kind = document.selected.leaf.kind};
	return move result;
}
void document_cli(string input, int fail) throws Error {
	var fields = text_split_owned(input, "/");
	if (fields.count() != 4) { throw new Error("document needs id/name/id/name"); }
	var left_id = fields.take(0);
	var left_label = fields.take(0);
	var right_id = fields.take(0);
	var right_label = fields.take(0);
	int left = parse_int(left_id.text);
	int right = parse_int(right_id.text);
	if (left < 1 || left > 40 || right < 41 || right > 80 || fail < -1 || fail > 13) { throw new Error("document range"); }
	var document = create_document(left, left_label.text, right, right_label.text, fail);
	number(document.version);
	var selected = select_subtree(move document);
	var lease = move selected.lease;
	var note = move selected.note;
	var samples = move selected.samples;
	int total = lease_id(lease) + note.fingerprint() + selected.kind;
	foreach (var sample in samples) { total = total + sample; }
	number(total);
}
int main(string[] args) {
	if (len(args) != 3) { return 81; }
	int result = 0;
	try { document_cli(args[1], parse_int(args[2])); }
	catch(Error error) { if (!println(error.message)) { return 82; } result = 2; }
	number(live_leases());
	if (live_leases() != 0) { return 83; }
	return result;
}
