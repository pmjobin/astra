using Depot10;
void run_depot(int seed, int count, int quantity) throws Error {
	if (seed < 1 || seed > 20 || count < 3 || count > 6 || quantity < 1 || quantity > 5) {
		throw new Error("depot range");
	}
	var opened = open_depot(seed, count, quantity);
	var depot = transfer_depot(move opened);
	bool grown = depot.reserve(count + 9);
	number(depot.count());
	var dispatched = depot.take(1);
	number(order_receipt(move dispatched));
	var replacement = build_order(seed + 40, quantity + 1);
	depot.replace(0, move replacement);
	number(depot.count());
	int total = 0;
	int ordinal = 1;
	while (depot.count() > 0) {
		var order = depot.take(0);
		int receipt = order_receipt(move order);
		number(receipt);
		total = total + receipt * ordinal;
		ordinal = ordinal + 1;
	}
	number(total);
}

int main(string[] args) {
	if (len(args) != 4) return 81;
	int result = 0;
	try { run_depot(parse_int(args[1]), parse_int(args[2]), parse_int(args[3])); }
	catch(Error error) { if (!println(error.message)) return 82; result = 2; }
	number(live_leases());
	return result;
}
