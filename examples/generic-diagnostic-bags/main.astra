// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Select model.astra, collections/bag.astra and the ordinary hosted text libs.
bool inspect_diagnostic(Bag<Diagnostic> bag, int index, int tag, string expected) {
	return diagnostic_is(bag.entries[index], tag, expected);
}
bool inspect_message(Bag<Utf8Message> bag, int index, string expected) {
	return message_is(bag.entries[index], expected);
}
bool diagnostic_identity(Bag<Diagnostic> bag) {
	return distinct_diagnostics(bag.entries[0], bag.entries[1]);
}
bool message_identity(Bag<Utf8Message> bag) {
	return distinct_messages(bag.entries[0], bag.entries[1]);
}
int exercise(int wanted, bool early, bool fail) throws InvalidUtf8 {
	var diagnostics = new Bag<Diagnostic>();
	var messages = new Bag<Utf8Message>();
	if (diagnostics.count() != 0 || messages.count() != 0 || diagnostics.capacity() != 0 || messages.capacity() != 0 || !diagnostics.reserve(0) || !messages.reserve(0)) { return 81; }
	if (wanted == 0) { if (!println("empty")) { return 82; } return 0; }
	if (!diagnostics.reserve(2) || !messages.reserve(2)) { return 83; }
	u8[5] cafe = {99, 97, 102, 195, 169};
	u8[3] nul = {97, 0, 98};
	var first = make_diagnostic(1, slice(cafe));
	var first_message = utf8_message(slice(nul));
	cafe[0] = 255; nul[0] = 255;
	diagnostics.append(move first); messages.append(move first_message);
	if (!inspect_diagnostic(diagnostics, 0, 1, "café") || !inspect_message(messages, 0, "a\0b")) { return 84; }
	if (wanted > 1) {
		u8[6] combining = {99, 97, 102, 101, 204, 129};
		var second = make_diagnostic(2, slice(combining));
		var second_message = utf8_message(slice(combining));
		combining[0] = 255;
		diagnostics.append(move second); messages.append(move second_message);
		if (!diagnostic_identity(diagnostics) || !message_identity(messages)) { return 85; }
	}
	if (wanted == 3) {
		if (!diagnostics.reserve(3) || !messages.reserve(3) || diagnostics.count() != 2 || messages.count() != 2 || diagnostics.capacity() != 3 || messages.capacity() != 3 || !diagnostic_identity(diagnostics) || !message_identity(messages)) { return 86; }
		if (fail) {
			u8[1] malformed = {255};
			var unpublished = utf8_message(slice(malformed));
			return 87;
		}
		u8[4] heart = {240, 159, 150, 164};
		var third = make_diagnostic(3, slice(heart));
		var third_message = utf8_message(slice(heart));
		heart[0] = 255;
		diagnostics.append(move third); messages.append(move third_message);
		if (!inspect_diagnostic(diagnostics, 2, 3, "🖤") || !inspect_message(messages, 2, "🖤")) { return 88; }
	}
	if (wanted > 1 && (!inspect_diagnostic(diagnostics, 1, 2, "cafe\u0301") || !inspect_message(messages, 1, "cafe\u0301"))) { return 89; }
	if (diagnostics.count() != wanted || messages.count() != wanted || diagnostics.reserve(-1) || messages.reserve(-2147483648) || !diagnostics.reserve(1) || !messages.reserve(1)) { return 90; }
	if (early) { if (!println("early")) { return 91; } return 0; }
	if (!println("checked")) { return 92; }
	return 0;
}
int main(string[] args) {
	var wanted = 3; var early = false; var fail = false;
	if (len(args) > 1) {
		if (args[1] == "empty") { wanted = 0; }
		else { if (args[1] == "one") { wanted = 1; } else { if (args[1] == "two") { wanted = 2; } } }
		early = args[1] == "early"; fail = args[1] == "error";
	}
	try { return exercise(wanted, early, fail); }
	catch (InvalidUtf8 error) { if (fail && error.message == "invalid UTF-8" && println("caught")) { return 0; } }
	return 93;
}
