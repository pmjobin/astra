using Numerics;
extern(C) f64 numerical_sample(int i);
extern(C) int numerical_observe(int i,f64 value);
extern(C) int numerical_finish(int wanted);
int main(){
	Matrix2 matrix={m00=0.75,m01=0.25,m10=-0.5,m11=1.25};
	owned f64[] input=new f64[48001];owned f64[] output=new f64[48000];
	for(int i=0;i<24000;i=i+1){input[2*i+1]=numerical_sample(i);input[2*i+2]=numerical_sample(i+7);}
	for(int i=0;i<24000;i=i+1){store_f64x2(output,2*i,matrix.transform(load_f64x2(input,2*i+1)));}
	for(int i=0;i<48000;i=i+1){if(numerical_observe(i,output[i])!=0){return 1;}}
	return numerical_finish(48000);
}
