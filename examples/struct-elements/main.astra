// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
const int kernel_count = 2 * 2;
int main(string[] args) {
	assert_that(len(args) >= 1);
	assert_that(args[0].byte_length > 0);
	owned State state = State.init(kernel_count);
	var saved = state.pick(0);
	assert_that(state.evaluate() == 16.0d);
	state.scale_first();
	state.verify_first();
	assert_that(saved.weight == 0.5d);
	assert_that(state.evaluate() == 17.0d);
	Kernel[2] selected = {saved, {right=3, left=1, shape={bias=0.0d, gain=2.0d}, weight=0.5d}};
	selected[1] = selected[0];
	selected[0].scale(2.0d);
	assert_that(selected[1].weight == 0.5d);
	selected[0].demand(selected[0].weight == 1.0d);
	if (len(args) > 1) { assert_message(selected[0].weight == 0.5d, "forced record result failure"); }
	if (!println("record kernels: 16 -> 17; snapshot preserved")) { return 2; }
	return 0;
}
