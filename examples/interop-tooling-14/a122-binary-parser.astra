// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// A122: parse real file bytes through a separately compiled C provider.
[Repr(layout="C-tagged-union",members="integer:i64,bits:u64",active="integer",tag="1")]
struct SignedPacket { i64 tag; i64 integer; }
[Repr(layout="C-tagged-union",members="integer:i64,bits:u64",active="bits",tag="2")]
struct UnsignedPacket { i64 tag; u64 bits; }
[Repr(layout="C")]
struct ParseStats { i64 total; int count; int last; }

[CImport(name="a122_open",header="a122-packets.h")]
owned PacketReader open_packets();
[CImport(name="a122_header",header="a122-packets.h",pointer_abi="i32-noescape")]
int packet_header(borrowed PacketReader reader, borrowed int* magic, borrowed int* count);
[CImport(name="a122_kind",header="a122-packets.h")]
int packet_kind(borrowed PacketReader reader);
[CImport(name="a122_signed",header="a122-packets.h",record_abi="value-lp64")]
SignedPacket signed_packet(borrowed PacketReader reader);
[CImport(name="a122_unsigned",header="a122-packets.h",record_abi="value-lp64")]
UnsignedPacket unsigned_packet(borrowed PacketReader reader);
[CImport(name="a122_status",header="a122-packets.h")]
int packet_status(borrowed PacketReader reader);
[CImport(name="a122_complete",header="a122-packets.h",bool_abi="c99")]
bool packet_complete(borrowed PacketReader reader);
[CImport(name="a122_apply",header="a122-packets.h",record_abi="natural-lp64",callback="record_packet",callback_abi="i32-context-i32-sync")]
int apply_packet(borrowed ParseStats* stats, int ordinal);
[CImport(name="a122_finish",header="a122-packets.h")]
int finish(int result);

int record_packet(borrowed ParseStats* stats, int ordinal) {
	stats->total = stats->total + (ordinal as i64);
	stats->count = stats->count + 1;
	stats->last = ordinal;
	return stats->count;
}

int parse_packets() {
	owned PacketReader reader = open_packets();
	if (reader == null) { return 10; }
	int magic = -1;
	int count = -1;
	if (packet_header(reader, null, &count) != -1 || count != -1) { return 20; }
	if (packet_header(reader, &magic, &count) != 0) { return 11; }
	if (magic != Header_magic || header_magic() != Header_magic) { return 12; }
	if (count <= 0 || count > Header_limit || header_limit() != Header_limit) { return 13; }
	ParseStats stats = { total = 0 as i64, count = 0, last = 0 };
	i64 signed_total = 0 as i64;
	u64 unsigned_total = 0 as u64;
	int signed_count = 0;
	int unsigned_count = 0;
	for (int i = 0; i < count; i = i + 1) {
		int kind = packet_kind(reader);
		if (kind == 1) {
			SignedPacket packet = signed_packet(reader);
			if (packet_status(reader) != 0) { return 15; }
			if (i == 0 && packet.integer != -1234567890123) { return 16; }
			if (i == 2 && packet.integer != (123 as i64)) { return 16; }
			signed_total = signed_total + packet.integer;
			signed_count = signed_count + 1;
		} else { if (kind == 2) {
				UnsignedPacket packet = unsigned_packet(reader);
				if (packet_status(reader) != 0) { return 15; }
				if (i == 1 && packet.bits != 9000000000000000000) { return 16; }
				if (i == 3 && packet.bits != (31 as u64)) { return 16; }
				unsigned_total = unsigned_total + packet.bits;
				unsigned_count = unsigned_count + 1;
			} else { return 14; } }
		if (apply_packet(&stats, i + 1) != i + 1) { return 17; }
	}
	if (!packet_complete(reader)) { return 18; }
	if (signed_count != 2 || unsigned_count != 2 || signed_total != -1234567890000 || unsigned_total != 9000000000000000031) { return 16; }
	if (stats.count != 4 || stats.last != 4 || stats.total != (10 as i64)) { return 19; }
	return 0;
}

int main() {
	int result = parse_packets();
	// The Resource owner has retired on every return before this independent audit.
	return finish(result);
}
