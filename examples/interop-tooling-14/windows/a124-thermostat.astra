[CImport(name="a124_constructed")] int constructed(int temperature);

[CImport(name="a124_closed")] int closed(int temperature, int adjustments);

[COMExport(value_iid="849ad154-8d1e-4c63-9ea2-14329b022001",scale_iid="849ad154-8d1e-4c63-9ea2-14329b022002",threading="constructing")]
[Shared]
[CExport(name="a124_thermostat",property="value")]
class Thermostat {
	private int temperature;
	private int adjustments;

	init(int initial) {
		this.temperature = clamp(initial);
		this.adjustments = 0;
		constructed(this.temperature);
	}

	property int value {
		get { return this.temperature; }
		set(int request) {
			int next = clamp(request);
			if (next != this.temperature) {
				this.adjustments = this.adjustments + 1;
				this.temperature = next;
			}
		}
	}

	deinit() { closed(this.temperature, this.adjustments); }
}

int clamp(int value) {
	if (value < 10) return 10;
	if (value > 30) return 30;
	return value;
}
