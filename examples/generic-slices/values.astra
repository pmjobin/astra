T element_at<T>(T[] values, int index) { return values[index]; }

T save<T>(T[] values, T input, string label, string[] arguments, [CallerFilePath] string file, [CallerLineNumber] int line, [CallerArgumentExpression("input")] string expression, [CallerArgumentExpression("values")] string view_expression) {
	assert_that(label.byte_length > 0, file, line, expression);
	assert_that(len(arguments) >= 1 && view_expression.byte_length > 0 && label.byte_length != 4, file, line, view_expression);
	T saved = input;
	return saved;
}
