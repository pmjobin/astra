// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
const int count = 2 + 2;
int main(string[] args) {
	var kernels = new Kernel[count];
	var snapshots = new Box<Kernel>[count];
	Kernel prototype = {index=7,gain=0.5d};
	process(kernels, snapshots, prototype);
	var saved = save(kernels, kernels[1], "kernel", args);
	var boxed = element_at<Box<Kernel>>(snapshots, 0);
	Kernel[1] fixed = {prototype};
	fill<Kernel>(slice(fixed), prototype);
	var array_copy = element_at(slice(fixed), 0);
	kernels[1].index = 123;
	snapshots[0].value.gain = 3.5d;
	release kernels; release snapshots;
	assert_that(saved.index == 7 && saved.gain == 0.5d);
	assert_that(boxed.value.index == 7 && boxed.value.gain == 0.5d && array_copy.index == 7);
	if (len(args) > 2) {
		var view_failure = save(slice(fixed), fixed[0], "view", args);
	}
	if (len(args) > 1) {
		var failure = save(slice(fixed), fixed[0], "", args);
	}
	if (!println("generic slices: 7; snapshots independent")) return 2;
	return 0;
}
