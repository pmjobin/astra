// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// A111: a numeric record stays ordinary until its Class is explicitly boxed.
extern(C) int thread_oracle_arrive(int expected);

extern(C) int thread_oracle_destroy();

extern(C) int thread_oracle_finish(int expected);

extern(C) int app_sample(int app, int tag, int value);

extern(C) int app_drop(int app, int tag);

extern(C) int app_finish(int app);

struct Reading {
	int count;
	f64 weight;

}

[Monitor]
class Snapshot {

	private owned Reading[] readings;

	init(Reading reading) {
		this.readings = new Reading[1];
		this.readings[0] = reading;

	}

	int read() {
		if (this.readings[0].weight != 0.5) {
			return -1;

		}
		return this.readings[0].count;

	}

	deinit() {
		app_drop(111, 0);

	}

}

int read(borrowed Snapshot snapshot) {
	return snapshot.read();

}

class Request {

	owned shared Snapshot snapshot;

	int id;

	init(owned shared Snapshot snapshot, int id) {
		this.snapshot = move snapshot;
		this.id = id;

	}

	deinit() {
		thread_oracle_destroy();

	}

}

int evaluate(borrowed Request request, int unused) {

	var snapshot = shared_clone(request.snapshot);

	thread_oracle_arrive(4);

	return app_sample(111, request.id, read(shared_borrow(snapshot)));

}

int main() {

	Reading reading = {
		count = 17, weight = 0.5
	};

	{
		var ordinary = new Snapshot(reading);
		if (ordinary.read() != 17) {
			return 81;

		}

	}

	var unique = new Snapshot(reading);
	shared Snapshot root = shared_acquire(move unique);

	var a = root.clone();
	var e0 = new Request(move a, 0);
	var t0 = thread_bind(move e0, evaluate);

	var b = root.clone();
	var e1 = new Request(move b, 1);
	var t1 = thread_bind(move e1, evaluate);

	var c = root.clone();
	var e2 = new Request(move c, 2);
	var t2 = thread_bind(move e2, evaluate);

	var d = root.clone();
	var e3 = new Request(move d, 3);
	var t3 = thread_bind(move e3, evaluate);

	if (thread_start(t0, 0) != 0 || thread_start(t1, 0) != 0 || thread_start(t2, 0) != 0 || thread_start(t3, 0) != 0) {
		return 82;

	}

	if (thread_join(t0) != 0 || thread_join(t1) != 0 || thread_join(t2) != 0 || thread_join(t3) != 0) {
		return 83;

	}

	release t0;
	release t1;
	release t2;
	release t3;
	release root;

	if (thread_oracle_finish(4) != 0) {
		return 84;

	}

	return app_finish(111);

}
