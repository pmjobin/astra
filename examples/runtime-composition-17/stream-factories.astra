namespace StreamSetup;
owned Stream.Queue create_queue(borrowed ConcurrentAllocator context, int limit) {
	var queue = new(context)Stream.Queue(limit); return move queue;
}

owned Stream.Progress create_progress(borrowed ConcurrentAllocator context) {
	var progress = new(context)Stream.Progress(); return move progress;
}
