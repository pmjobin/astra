int main() {
	if (header_status(validate_header(42, 7, 4)) != 74) { return 1; }
	if (header_status(validate_header(0, 7, 4)) != 2) { return 2; }
	if (header_status(validate_header(42, 5, 4)) != 8) { return 3; }
	if (header_status(validate_header(42, 7, 2)) != 6) { return 4; }
	if (header_status(HeaderResult.Failed(LoadError.Missing())) != 1) { return 5; }
	return 0;
}
