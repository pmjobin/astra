// Select text/utf8-message.astra, base/errors.astra and hosted/text.astra.
class Diagnostic {
	int tag;
	owned Utf8Message message;

	init(int tag, owned Utf8Message message) {
		this.tag = tag;
		this.message = move message;
	}

	deinit() {
		if (this.tag == 1) {
			println("drop 1");
		}
		else {
			if (this.tag == 2) {
				println("drop 2");
			}
			else {
				println("drop 3");
			}
		}
	}
}

owned Diagnostic make_diagnostic(int tag, u8[] bytes) throws InvalidUtf8 {
	var message = utf8_message(bytes);
	var entry = new Diagnostic(tag, move message);
	return move entry;
}

bool different(Diagnostic first, Diagnostic second) {
	return first != second && first.tag != second.tag;
}

bool render_message(Utf8Message message, int tag) {
	var text = message.text;
	if (tag == 1) return text == "café" && text.byte_length == 5 && print("1: ") && println(text);
	if (tag == 2) return text == "cafe\u0301" && text.byte_length == 6 && print("2: ") && println(text);
	return text == "🖤" && text.byte_length == 4 && print("3: ") && println(text);
}

bool render_diagnostic(Diagnostic entry) { return render_message(entry.message, entry.tag); }

class Diagnostics {
	owned Diagnostic[slots] entries;

	init() { this.entries = new Diagnostic[slots]; }

	bool reserve(int requested) { return this.entries.reserve(requested); }

	void append(owned Diagnostic entry) { this.entries.append(move entry); }

	int count() { return len(this.entries); }

	int capacity() { return this.entries.capacity; }

	bool distinct() {
		if (len(this.entries) > 1 && !different(this.entries[0], this.entries[1])) return false;
		if (len(this.entries) > 2 && (!different(this.entries[0], this.entries[2]) || !different(this.entries[1], this.entries[2]))) return false;
		return true;
	}

	bool render() {
		var index = 0;
		while (index < len(this.entries)) {
			if (!render_diagnostic(this.entries[index])) return false;
			index = index + 1;
		}
		return true;
	}

	deinit() { println("drop diagnostics"); }
}

int main(string[] args) {
	var wanted = 3;
	if (len(args) > 1) {
		if (args[1] == "empty") {
			wanted = 0;
		}
		else {
			if (args[1] == "one") {
				wanted = 1;
			}
			else {
				if (args[1] == "two") wanted = 2;
			}
		}
	}
	var bag = new Diagnostics();
	if (bag.count() != 0 || bag.capacity() != 0 || !bag.reserve(0)) return 81;
	if (wanted == 0) {
		if (!bag.render() || !println("empty")) return 82;
		return 0;
	}
	if (!bag.reserve(2) || bag.capacity() != 2) return 83;
	try {
		var bytes = new u8[5];
		bytes[0] = 99; bytes[1] = 97; bytes[2] = 102; bytes[3] = 195; bytes[4] = 169;
		var first = make_diagnostic(1, bytes);
		bytes[0] = 255;
		release bytes;
		bag.append(move first);
		if (wanted > 1) {
			u8[6] combining = {99, 97, 102, 101, 204, 129};
			var second = make_diagnostic(2, slice(combining));
			combining[0] = 255;
			bag.append(move second);
		}
		if (bag.reserve(-1) || !bag.reserve(1) || !bag.reserve(2) || bag.capacity() != 2 || (bag.count() != wanted && wanted < 3) || !bag.distinct()) return 84;
		if (wanted == 3) {
			if (bag.count() != 2 || !bag.reserve(3) || bag.capacity() != 3 || bag.count() != 2 || !bag.distinct()) return 85;
			u8[4] heart = {240, 159, 150, 164};
			var third = make_diagnostic(3, slice(heart));
			heart[0] = 255;
			bag.append(move third);
			if (bag.count() != 3 || !bag.reserve(3) || !bag.distinct()) return 86;
		}
		if (len(args) > 1 && args[1] == "early") return 0;
		if (!bag.render()) return 87;
	} catch (InvalidUtf8 error) { return 88; }
	return 0;
}
