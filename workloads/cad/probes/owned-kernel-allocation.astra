// Required state-allocation slice from CAD f415381, not a downscaler.
// Kernel fields: src/algorithm.astra:23; maximum case: tests/test_cad.py:345.
// The original Errors.test_allocation_failure requires exit 2 and "failure 3".
struct Kernel { f64 mx; f64 my; f64 xx; f64 xy; f64 yy; f64 l; f64 a; f64 b; f64 sigma; }

int main(string[] args) {
	int count = 2048 * 2048;
	if (len(args) == 2 && args[1] == "small") { count = 12; }
	owned Kernel[] state = new Kernel[count];
	var first = state[0];
	var last = first;
	last.sigma = 1.0d;
	state[count - 1] = last;
	if (first.sigma != 0.0d || state[0].sigma != 0.0d || state[count - 1].sigma != 1.0d) { return 1; }
	return 0;
}
