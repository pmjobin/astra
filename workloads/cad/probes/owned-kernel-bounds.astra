// Same Kernel shape as CAD f415381 src/algorithm.astra:23.
// Control: a bounds failure has the same process signal as native OOM.
struct Kernel { f64 mx; f64 my; f64 xx; f64 xy; f64 yy; f64 l; f64 a; f64 b; f64 sigma; }

int main(string[] args) {
	owned Kernel[] state = new Kernel[1];
	if (state[len(args)].sigma != 0.0d) return 1;
	return 0;
}
