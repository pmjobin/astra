# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
option('linux_async', type: 'boolean', value: false, description: 'Build the explicit Linux io_uring timer/file provider (matching liburing >=2.15)')
option('hosted_concurrency', type: 'boolean', value: false, description: 'Build optional GNU Linux x86-64 pthread, threaded task and loopback socket support objects; never autolink')
option('stage0_optimization', type: 'combo', choices: ['inherit', '0', '1', '2', '3'], value: 'inherit', description: 'Native C optimization of the compiler implementation; public Astra O0/O1/O2 routes are unchanged')
option('numeric_oracle_optimization', type: 'combo', choices: ['inherit', '0', '1', '2', '3'], value: 'inherit', description: 'Native C optimization of exhaustive exact-number helper executables; assertions and cases are unchanged')
option('qualification_runtime', type: 'string', value: '', description: 'External directory for M18 task-only receipts and scratch; defaults to the build directory for ordinary developer tests')
