float ceil_f32(float value);
[CCode (cname = "ceil", cheader_filename = "math.h")]
double ceil_f64(double value);
[CCode (cname = "truncf", cheader_filename = "math.h")]
float trunc_f32(float value);
[CCode (cname = "trunc", cheader_filename = "math.h")]
double trunc_f64(double value);
