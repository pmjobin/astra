// Fixed, compiler-checked operations for the selected no-OS PC profile.
// The C declaration spelling supplies scalar ABI shape, not a C provider.
namespace Pc;

[CCode(cname="astra_pc_uart_tx8",device="pc-uart-tx8")]
extern(C) int write_byte(int value);
[CCode(cname="astra_pc_edu_read32",device="pc-edu-read32")]
extern(C) int read_liveness();
[CCode(cname="astra_pc_edu_write32",device="pc-edu-write32")]
extern(C) int write_liveness(int value);
[CCode(cname="astra_pc_breakpoint",device="pc-breakpoint")]
extern(C) int breakpoint(int value);
[CCode(cname="astra_pc_atomic_load_acquire",device="pc-atomic-load-acquire")]
extern(C) int load_acquire();
[CCode(cname="astra_pc_atomic_store_release",device="pc-atomic-store-release")]
extern(C) int store_release(int value);
[CCode(cname="astra_pc_atomic_add_seq_cst",device="pc-atomic-add-seq-cst")]
extern(C) int add_seq_cst(int value);
[CCode(cname="astra_pc_atomic_load_relaxed",device="pc-atomic-load-relaxed")]
extern(C) int load_relaxed();
[CCode(cname="astra_pc_atomic_load_seq_cst",device="pc-atomic-load-seq-cst")]
extern(C) int load_seq_cst();
[CCode(cname="astra_pc_atomic_store_relaxed",device="pc-atomic-store-relaxed")]
extern(C) int store_relaxed(int value);
[CCode(cname="astra_pc_atomic_store_seq_cst",device="pc-atomic-store-seq-cst")]
extern(C) int store_seq_cst(int value);
[CCode(cname="astra_pc_atomic_add_relaxed",device="pc-atomic-add-relaxed")]
extern(C) int add_relaxed(int value);
[CCode(cname="astra_pc_atomic_add_acq_rel",device="pc-atomic-add-acq-rel")]
extern(C) int add_acq_rel(int value);
