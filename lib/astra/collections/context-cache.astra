// Cache bookkeeping composes an explicitly supplied context-backed Map.
[Allocator(kind="context",context="owned-concurrent")]
class ContextCache<K, V> {
	private owned ContextMap<K, V> values;
	private int hits;
	private int misses;
	private int changes;

	init(owned ContextMap<K, V> values) {
		this.values = move values;
		this.hits = 0;
		this.misses = 0;
		this.changes = 0;
	}

	property int count { get { return this.values.count; } }

	property int capacity { get { return this.values.capacity; } }

	bool reserve(int requested) { return this.values.reserve(requested); }

	property int hit_count { get { return this.hits; } }

	property int miss_count { get { return this.misses; } }

	property int revision { get { return this.changes; } }

	bool contains(K key) {
		if (this.values.contains(key)) {
			this.hits = this.hits + 1;
			return true;
		}
		this.misses = this.misses + 1;
		return false;
	}

	Result lookup<Result>(K key, Fn<Result, borrowed V> query, Result missing) {
		if (this.values.contains(key)) {
			this.hits = this.hits + 1;
			return this.values.lookup<Result>(key, query, missing);
		}
		this.misses = this.misses + 1;
		return missing;
	}

	Result lookup_with<Context, Result>(K key, Context context,
		Fn<Result, borrowed V, Context> query, Result missing) {
		if (this.values.contains(key)) {
			this.hits = this.hits + 1;
			return this.values.lookup_with<Context, Result>(key, context, query, missing);
		}
		this.misses = this.misses + 1;
		return missing;
	}

	bool put(K key, owned V value) {
		if (!this.values.put(key, move value)) return false;
		this.changes = this.changes + 1;
		return true;
	}

	owned ContextMapEntry<K, V> remove(K key) {
		var entry = this.values.remove(key);
		if (entry != null) this.changes = this.changes + 1;
		return move entry;
	}
}
