bool is_nan_f32(f32 value) { return value != value; }

bool is_nan_f64(f64 value) { return value != value; }

bool is_finite_f32(f32 value) {
	return value >= -340282346638528859811704183484516925440.0f && value <= 340282346638528859811704183484516925440.0f;
}

bool is_finite_f64(f64 value) {
	return value >= -.0d && value <= .0d;
}

bool is_infinite_f32(f32 value) { return !is_nan_f32(value) && !is_finite_f32(value); }

bool is_infinite_f64(f64 value) { return !is_nan_f64(value) && !is_finite_f64(value); }
