// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Statically select exactly one provider. Contract: this call never returns.
extern(C) void astra_base_fail(int kind, int code);

void assert(bool condition) {
	if (!condition) astra_base_fail(1, 0);
}

void assert_code(bool condition, int code) {
	if (!condition) astra_base_fail(1, code);
}
