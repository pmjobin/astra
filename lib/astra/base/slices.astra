void fill<T>(T[] values, T value) {
	var index = 0;
	while (index < len(values)) {
		values[index] = value;
		index = index + 1;
	}
}

void swap_elements<T>(T[] values, int first, int second) {
	T left = values[first];
	T right = values[second];
	values[first] = right;
	values[second] = left;
}
