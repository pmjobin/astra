// Stable selection: propagate the first NaN, and select a on ordered ties.
T min<T>(T a, T b) where T : Ordered {
	if (!(a <= a)) { return a; }
	if (!(b <= b)) { return b; }
	if (b < a) { return b; }
	return a;
}

T max<T>(T a, T b) where T : Ordered {
	if (!(a <= a)) { return a; }
	if (!(b <= b)) { return b; }
	if (a < b) { return b; }
	return a;
}
