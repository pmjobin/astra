// Select together with contracts.astra and exactly one failure provider.
T clamp<T>(T value, T lower, T upper) where T : Ordered {
	if (!(lower <= upper)) { astra_base_fail(2, 0); }
	if (value < lower) { return lower; }
	if (upper < value) { return upper; }
	return value;
}
