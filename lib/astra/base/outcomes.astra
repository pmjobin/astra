// Optional value outcomes. Select this source explicitly; the names have no
// compiler meaning and introduce no error or async control flow.
enum Result<T,E> {
	Success(T value),
	Error(E error)
}

enum VoidResult<E> {
	Success,
	Error(E error)
}

enum ArrayResult<T,E> {
	Success(owned T[] value),
	Error(E error)
}
