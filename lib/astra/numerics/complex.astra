namespace Numerics;

struct Complex64 {
	f64 real;
	f64 imag;

	Complex64 add(Complex64 other) {
		Complex64 result = {real=this.real+other.real, imag=this.imag+other.imag};
		return result;
	}

	Complex64 subtract(Complex64 other) {
		Complex64 result = {real=this.real-other.real, imag=this.imag-other.imag};
		return result;
	}

	Complex64 multiply(Complex64 other) {
		Complex64 result = {real=this.real*other.real-this.imag*other.imag, imag=this.real*other.imag+this.imag*other.real};
		return result;
	}

	f64 norm_squared() { return this.real*this.real + this.imag*this.imag; }
}

struct Matrix2 {
	f64 m00;
	f64 m01;
	f64 m10;
	f64 m11;

	f64<2> transform(f64<2> point) {
		f64<2> result = {this.m00*point[0]+this.m01*point[1], this.m10*point[0]+this.m11*point[1]};
		return result;
	}

	Matrix2 multiply(Matrix2 other) {
		Matrix2 result = {m00=this.m00*other.m00+this.m01*other.m10,
			m01=this.m00*other.m01+this.m01*other.m11,
			m10=this.m10*other.m00+this.m11*other.m10,
			m11=this.m10*other.m01+this.m11*other.m11};
		return result;
	}
}
