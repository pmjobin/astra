namespace Numerics;

// Strict direct-form II transposed state. Coefficients use a0=1; callers
// select stable coefficients. Reset is explicit and preserves coefficients.
struct Biquad64 {
	f64 b0;
	f64 b1;
	f64 b2;
	f64 a1;
	f64 a2;
	f64 z1;
	f64 z2;
	f64 process(f64 sample) {
		f64 result = this.b0*sample + this.z1;
		this.z1 = (this.b1*sample - this.a1*result) + this.z2;
		this.z2 = this.b2*sample - this.a2*result;
		return result;
	}
	void reset() { this.z1 = 0.0; this.z2 = 0.0; }
}
