# Deliberately scoped: no global trimming of fixtures, payloads or evidence.
root = true

[{src,lib,tools,examples,workloads,tests}/**.{vala,vapi,c,h,cpp,hpp,py,astra,sh,js}]
indent_style = tab
indent_size = 4
tab_width = 4

[**/meson.build]
indent_style = tab
indent_size = 4
tab_width = 4

[meson.options]
indent_style = tab
indent_size = 4
tab_width = 4
